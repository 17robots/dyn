module "main";

use "std:io";
use "std:heap";
use "std:sync";
use test "testLib";

main = () {
  primitives();
  optionals();
  pointers();
  arrays();
  if_statements();
  match_statements();
  defer_statements();
  loops();
  functions();
  enums();
  errors();
  structs();
  metaprogramming();
  memory();
  concurrency();
}

primitives = () {
	x: i2 = 0; // all vars must have a value, and can only be undefined if mut
	y: u5 = 1;
	single_precision: f32 = 1.0;
	double_precision: f64 = 1.0001;
	char = 'a'; // u8
	boolean = false; // u1
	/*
		defaults
		int: i64,
		float: f64,
		fn result: what the type of the fn is
	*/
}

optionals = () {
	optional_val: ?i32 = 100;
	mut optional_val_2: ?i32 = null;

	io.print("Optional val: {}", if optional_val |v| v else "null");
	io.print("Optional val: {}", optional_val.?);
	a = optional_val_2 else 4;
	optional_val_2 = 4;
	b = optional_val_2 else 0;
}

pointers = () {
	x: i32 = 1;
	mut y: i32 = 1;
	a: *i32 = &x;
	mut b: *i32 = undefined;
	io.print("x == dereferenced a? {}", x == a.*);
	b = &y; // doable because mut
	b.* = 5; // doable because y is mut
}

arrays = () {
	mut nums: []i32 = .[1,2,3,4,5];
	nums[0] *= 2;
	mut [5]i32 nums2;
    nums[0] = 0;
    nums[1] = 1;
    nums[2] = 2;
    nums[3] = 3;
    nums[4] = 4;
}

if_statements = () {
	yes = true;
	if yes {
		io.print("This should print\n");
	} else {
		io.print("This should not print\n");
	}
	no = false;
	if no { io.print("oops\n"); } else { io.print("Everything's ok!\n"); }
}

match_statements = () {
	x = 100;
	match x {
		1: io.println("This shouldnt run\n"),
		2: io.println("This shouldnt run\n"),
		4..90:  io.println("This shouldnt run\n"),
		_: io.println("This default should run\n"),
	}
}

defer_statements = () {
    defer io.println("This executes last");
    defer io.println("This executes second");
    defer {
      io.println("This executes first");
    }
}

loops = () {
	while true {
	    io.println("infinite loop, needs broken");
	    break;
	}

	for 1..100 |i| io.print("{}\n", i);

	items: []u8 = [1,2,3,4,5];
	for items |i| io.print("{}\n", i);
}

functions = () {
	mut local: i32 = 0;
	mut state: i32 = 0;
	mut result: i32 = undefined;
	internal_fn = () {
		io.print("{} {}", local, state);
	}
	internal_fn();
	some_number = () i32 { return 100; } 
	some_number2 = () i32 => 100; 
    some_math = (x: i32, y: i32) i32 => x + y;
    some_math_2 = (x, y: i32) i32 => x + y;
    manipulate_numbers = (result: *i32, x, y: i32) => result.* = x + y;
	() {
		io.print("Calling an anonymous funciton");
	}();
}

enums = () {
	MyEnum = enum {
		SOME,
		THING,
		HERE
	};

	PartneredEnum = enum {
		SOME: i32,
		THING: struct { info: i32 },
		HERE: f32
	};

	x: MyEnum = .SOME;
	y: PartneredEnum = .SOME(4);
	match x {
		.SOME: io.print("SOME"),
		.THING: io.print("THING"),
		.HERE: io.print("HERE"),
	}
	match y {
		.SOME: |n| io.print("SOME, {}", n),
		.HERE: |n| io.print("HERE, {}", n),
		_: io.print("Default")
	}
}

errors = () {
	DivideErrors = error {
		DivideByZero,
	};

	PartneredDivideErrors = error {
		DivideByZero: i32,
	};

	div = (x, y: f32) f32!DivideError {
		return if y == 0 DivideError.DivideByZero else x / y;
	}
	div2 = (x, y: f32) f32!PartneredDivideError => if y == 0 PartneredDivideError.DivideByZero(4) else x / y;
	defer |e| {} // error capture
	defer {}
	div(1,0) catch |e| { io.print("{} was thrown\n", e); };
	div(0,1) catch unreachable;
	// try div(1,0) signature will return e
}

structs = () {
	X = struct {
		a: i32,
		b: i32,
		c: i32,
		x, y, z: f32,
	};
	Y = struct {
		a,b,c: f32,
		x, y, z: i32,
	};
	x = X{ a: 1, b: 2, c: 3, x: 1.0, y: 2.0, z: 3.0 };
	y: Y = .{ x: 1, y: 2, z: 3, a: 1.0, b: 2.0, c: 3.0 };
	MethodExample = struct {
		a: i32 = 0,
		init = () MethodExample => .{}; // a is 0 by default
		get_double = (s: MethodExample) i32 => s.a * 2;
	};
}

metaprogramming = () {
	List = (T: comp type) type => struct {
		this = $this();
		member: T[],
		init() this => .{ members: [] }
	};
	print_thing_at_comptime = () { io.print("We are a thing\n"); }
	comp print_thing_at_comptime();
	return_pi = () f32 => 3.14;
	pi = comp return_pi(); // sets the val at comptime
	inline for(0..12) |i| io.print("Woah\n"); // unravel this at comp time
	inline_fn = inline () { io.print("This fn gets written out in place of each call");}
	inline_fn(); // will be replaced with io.print("This fn gets written out in place of each call");
}

memory = () {
	mut gpa = heap.GeneralPurposeAllocator(.{}).init(.{});
	alloc: = gpa.alloc();
	defer if gpa.deinit() == .leak $panic("We leaked\n");
	p = try alloc.allocOne(i32); // p: *i32
	p2 = try alloc.alloc(i32, 2); // p2: []i32
	defer alloc.free(p);
	defer alloc.free(p2);
}

AddFn: fn = (i32,i32)i32; // fn type
voidFn: fn = (i32,i32); // fn type
doAddOp = (a: AddFn, x,y: i32) i32 => a(x,y);
