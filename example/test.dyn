module main;

getType := () type => i32;

AStruct := struct {
  items, here i32,
  other []i32,
  ptr *i32,
  uh []?*getType(),
  new := () AStruct => { items: 0, here: 0, other: [] },
  aThing := (s: AStruct) void {},
};

List: type = (comp type)!;
something := (x, y: i32, func: List) {};
Uh := (x: i32) {};
