module "build"

use "std/build"

void build(build.Builder *b) {
    // Define the main executable
    mut build.Executable exe = b.addExecutable("all_in_one", "src/main.dyn");

    // Set build mode (debug/release)
    exe.setBuildMode(.Debug);

    // Set the target
    exe.setTarget(.{
        .cpu = .x86_64,
        .os = .linux,
        .abi = .gnu
    });

    // Add standard library packages
    // std already added by default
    /*
      exe.addPackage("std/io", b.package("std/io", "path/to/std/io"));
      exe.addPackage("std/heap", b.package("std/heap", "path/to/std/heap"));
      exe.addPackage("std/sync", b.package("std/sync", "path/to/std/sync"));
      exe.addPackage("std/math", b.package("std/math", "path/to/std/math"));
    */

    // Create install step
    b.*.install(exe);

    // Create run step
    mut build.Step run_step = b.*.step("run", "Run the application");
    mut build.RunArtifact run_cmd = b.*.addRunArtifact(exe);
    run_step.dependOn(run_cmd);

    // Create test step
    mut build.Step test_step = b.step("test", "Run unit tests");
    mut build.TestArtifact unit_tests = b.*.addTest("src/main.dyn");
    // Add the same packages to the test artifact
    unit_tests.addPackage("std/io", b.package("std/io", "path/to/std/io"));
    unit_tests.addPackage("std/heap", b.package("std/heap", "path/to/std/heap"));
    unit_tests.addPackage("std/sync", b.package("std/sync", "path/to/std/sync"));
    unit_tests.addPackage("std/math", b.package("std/math", "path/to/std/math"));
    test_step.dependOn(b.addRunArtifact(unit_tests));
}
