add := (x: i32, y: i32) i32 { return x + y }
add2 := (x, y: i32) i32 { return x + y }
add3 := (x, y: i32) i32 => x + y
add4 := (x,y: i32 = 0) i32 => x + y
DivideError1 := enum {
  UhOh
}
DivideError2 := enum {
  DivideByZero
}
divide := (x,y: f32) f32!DivideError1,DivideError2 => if y == 0 .DivideByZero else x / y

List := (T: type) type => struct {
  items: []T,
  init := () $self() => .{ items: [] }
}
List2 := (T: comp type) type => struct { // comptime known type
  items: []T,
  init := () $self() => .{ items: [] }
}
IntList := List(i32)
inline_fn := inline () i32 => 1

hmm_type := get_type(){}
hmm := hmm_type.vals.?.*.current_val or hmm_type.vals.?.*.other_vals[1]

get_type := () type {
  return struct {
    vals: ?*struct {
      current_val: ?*type,
      other_vals: []*type
    },
  }
}


