  {
    v := "only valid here"
  }
  // v no longer valid

  mut total = 0
  for 0..10: |v| {
    total += v
  }
  for 0..10: |v| total += i // only one line of thing
  for k: |v| total += v
  for total > 10 total += 1
  for total < 0 {
    total -= 1
  }
  for {
    break // please break infinite loops
  }
  if total == 10 {} else if total == 9 {} else {}
  if q: |val| {
    // do something with val
  }
  if q: |_| {
    // do something if q not null
  }
  w := if total % 2 == 0 total / 2 else (total - 1) / 2
  match total {
    0..1: {},
    2..10: {},
    _: {}
  }
  x := match total {
    1: 1,
    _: null
  }
  res := t.variant4(.inner3("hello"))
  match res {
    .variant1: {},
    .variant3: |i| {},
    .variant4: |v| match v {
      .inner1: {},
      .inner2: |thing| {},
      .inner3: |thing| {}
    },
    _: {}
  }
  y := add4(add3(add2(add1(1,1), add1(1,1)), add2(add1(1,1), add1(1,1))),add3(add2(add1(1,1), add1(1,1)), add2(add1(1,1), add1(1,1))))
  internal_fn := () {
    // print y
  }
