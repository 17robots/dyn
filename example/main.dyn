  A := divide(1,0) or 0
  B := divide(1,1).!
  C := divide(1,0) or {
    // something
    break 2
  }
  D := divide(1,0) or |e| {
    // something with e
    break 3
  }
  E := q or {
    // do something
    break 1
  }
  F := q.?
  G := q or 1
  H := IntList.init()
  use_f64 := true
  calc_pi := () comp if use_f64 f64 else f32 => 3.14
  pi := calc_pi()
  pi2 := comp calc_pi()
  inline for 0..10: |i| {
      // do something and it will unroll with i being passed in as the val to it
  }
  inline_fn() // will have its contents replaced here

  for 0..10: |v| blk: {
