from "std" import { io, arr };

pub void statements() {
    if_statements();
	match_statements();
    defer_statements();
	loops();
}

void if_statements() {
    // if [condition] { stuff }
    bool yes = true;
    if yes {
        io.println("This should print");
    } else {
        io.println("If this runs then oops");
    }

    bool no = false;
    if no {
        io.println("If this runs then oops");
    } else if yes {
        io.println("This should print");
    } else {
        io.println("If this runs then we really messed up");
    }

}
void match_statements() {
    i32 x = 100;
    match x {
        1: {
            io.println("This shouldnt run");
        },
        2: {
            io.println("This shouldnt run");
        },
        4..90: {
            io.println("This shouldnt run");
        },
        _ if x > 90: {
            io.println("This shouldnt run");
        },
        _: {
            io.println("This is the default and also shouldnt run");
        }
    }
}
void defer_statements() {
    // the defer statement is called when cleaning up the current scope that it's being used in (like a fn or a block
    // defers work in reverse order of when they are called
    // defers also only work on objects created within the same scope (so no freeing vars outside of the scope)
    defer io.println("This executes last");
    defer io.println("This executes second");
    defer io.println("This executes first");
}
void loops() {
    loop {
        io.println("This is an infinite loop);
        break;
    }

    mut i32 x = 100;

    while x < 101 {
        io.println("This will print once");
        x += 1;
    }

    for i in 1..100 {
        io.println(i);
    }

    u8[] items = [1,2,3,4,5];

    for mut i = 0; i < arr.len(items); ++i {
        io.println(arr[i]);
    }

    for i in 0..arr.len(items); {
        io.println(arr[i]);
    }
}
