// all in one stuff - this is a comment
/*
  or
  multiline
  comment
*/

use {
  "std:io"
  "std:heap"
  "std:sync"
}

void main() {
  primitives();
  optionals();
  pointers();
  arrays();
  if_statements();
  match_statements();
  defer_statements();
  loops();
  functions();
  enums();
  unions();
  errors();
  structs();
  metaprogramming();
  memory();
  concurrency();
}

void primitives() {
  // vars immutable by default
  // use mut before type to declare var that can change
  i2 x = 0; // ints can be any size (signed will always be size + 1 for sign bit)
  u5 y = 1; // unsigned
  // floats cannot be nonstandard
  f32 single_precision = 1.0;
  f64 double_precision = 1.00001;
  u8 char = 'a';
  u1 boolean = false;
}

void optionals() {
  i32? optional_value = 100;
  mut i32? optional_value_2 = null; // null isnt a type its just a placeholder like undefined

  // check if null or not null
  if optional_value != null {
    io.println(`Optional value: {optional_value.?}`); // use .? to access the value
  } else {
    io.println(`Optional value: null`); // use .? to access the value
  }

  // can also if and capture
  if optional_value_2 |x| {
    io.println(`Optional value 2: {x}`); // not mutable
  }
  if optional_value_2 |*x| { // var has to be mutable to use pointer capture and mutate
    x.* = 4;
  } else { optional_value_2 = 4; }

  i32 y = optional_value_2 else 4; // use default value if null

  // optionals can be returned as values from fns
}
void pointers() {
  i32 x = 1;
  mut i32 y = 1;
  i32* a = &x;
  mut i32* b = a;

  io.println(`x == dereferenced a? { x == a.*}`);

  // pointers can modify values they point to if the values are mutable
  // mutable pointers can change where they point to
  // b.* = 5; - doesnt work since x (which it points to because it points to the address that a points to, which is x) and x is immutable
  b = &y; // change where it points
  b.* = 5; // this works

  // pointers can be returned as values from fns
}

void arrays() {
  // arrs are fixed sizes of similarly typed pieces of data
  mut i32[] nums = [1,2,3,4,5]; // size known at comptime
  nums[0] *= 2;
  mut i32[5] nums2; // initialized to undefined for each
  nums[0] = 0;
  nums[1] = 1;
  nums[2] = 2;
  nums[3] = 3;
  nums[4] = 4;
}

void if_statements() {
  u1 yes = true;
  if yes {
    io.println("This should print");
  } else {
    io.println("If this runs then oops");
  }

  u1 no = false;
  if no { io.println("if this runs then oops"); } else if yes { std.io.println("This should run"); } else { std.io.println("This should not run"); }

  // ifs can also return values so vars can be set to them but they need an else clause
}

void match_statements() {
  i32 x = 100;
  match x {
    1: { io.println("This shouldnt run"); },
    2: { io.println("This shouldnt run"); },
    4..90: { io.println("This shouldnt run"); },
    _ if x > 90: { io.println("This shouldnt run"); },
    _: { io.println("This is the default so this should run"); },
  }

  // matches can also return values so vars can be set to them but they need a default case
}

void defer_statements() {
  defer io.println("This executes last");
  defer io.println("This executes second");
  defer {
    // done in a block
    io.println("This executes first");
  }
}

void loops() {
  loop {
    io.println("infinite loop, needs broken");
    break;
  }

  for 1..100 |i| { io.println(i); }

  u8[] items = [1,2,3,4,5];
  for items |i| { io.println(i); }
  for 0..std.arr.len(items) |i|: (i += 2) { io.println(items[i]); }
}

void functions() {
  // fn syntax <type> <name> (<args,..>) { <block> } where type is primitive or user defined
  mut i32 local, state = 0;
  mut i32 result = undefined;
  void internal_fn() {
    // has access to state of scope
    io.println(local, state);
  }(); // could also be called separately with internal_fn();
  i32 some_number() { return 100; }
  i32 some_number_2() => 100; // one liner
  i32 some_math(i32 x, i32 y) => x + y;
  i32 some_math_2(i32 x, y) => x + y;
  // void statements can also be used as => values
  void manipulate_numbers(i32* result, i32 x, y) => result.* = x + y; // works because pointers can have the value they point to changed but the value must be mutable
  i32 x = 4;
  mut i32 y = 5;
  // manipulate_numbers(&x, local, state); - errors because x is not mutable
  manipulate_numbers(&y, local, state); // works because y is mutable, more on pointers later
  io.println(`String interpolated values {some_math(1, 2)}`);
}

void enums() {
  enum MyEnum {
    SOME,
    THING,
    HERE
  }

  MyEnum x = .SOME;

  // matches on enums need to cover each possibility
  match x {
    .SOME: { io.println("SOME"); }
    .THING: { io.println("THING"); }
    .HERE: { io.println("HERE"); }
  }
  match x {
    .SOME: { io.println("SOME"); }
    _: { io.println("Default"); }
  }
}

void errors() {
  // errors are just sets
  error DivideErrors {
    DivideByZero
  }

  f32!DivideErrors div(f32 x, y) => if y == 0 { DivideErrors.DivideByZero } else { x / y };

  // you can capture errors in defer blocks as well
  defer |e| {} // this block will only run if theres an error and will capture the error
  defer {} // this will run regardless of if there's an error or not

  // try and catch
  void! try_me() {
    return DivideErrors.DivideByZero;
  }

  try_me() catch |e| {
    io.println(`{e} was thrown`);
    return; // err defers and defers will still run
  }

  try try_me(); // shorthand for x() catch |e| { return e; }
}

void unions() {
  union Something {
    i32 x,
    u8 y,
    f32 z,
  }

  Something x = { x = 1 };
  Something y = { y = 1 };
  Something z = { z = 1.0 };

  io.println(x.x);
  io.println(y.y);
  io.println(z.z);
}

void structs() {
  struct X {
    i32 a,b,c,
    f32 x,y,x
  }

  type Y = struct {
    f32 a,b,c,
    i32 x,y,x
  }; // allow for anonymous structs too


  X x = { a = 1, b = 2, c = 3, x = 1.0, y = 1.0, z = 1.0 };
  Y y = { a = 1.0, b = 2.0, c = 3.0, x = 1, y = 1, z = 1 };
  io.println(`{x.a}, {x.b}, {x.c}, {x.x}, {x.y}, {x.z}`);
  io.println(`{y.a}, {y.b}, {y.c}, {y.x}, {y.y}, {y.z}`);

  void printX(X x) => io.println(`{x.a}, {x.b}, {x.c}, {x.x}, {x.y}, {x.z}`);
  void printY(Y y) => io.println(`{y.a}, {y.b}, {y.c}, {y.x}, {y.y}, {y.z}`);

  // use pointer to modify struct
  void updateX(X* x) => x.*.a = x.*.a + 1;

  i32?!DivideError otherExample => null; // shows how to return a nullable that could error but this isnt too practical since you could just return null. could also not specify the error

  struct MethodExample {
    i32 a = 0, // default value can be added
    MethodExample init(i32 a) => { a = a };
    void print(s: MethodExample) => io.println(`{s.a}`);
    void setADouble(s: *MethodExample) => s.*.a = s.*.a * 2;
  }
}

void metaprogramming() {
  /*
    several keywords
    - type: represents a type keyword (ex i32, a struct name, etc to be used with metaprogramming)
    - comp: defines a variable is known at compile time
    - inline: used for loops to iterate during compilation
    - anytype:
    - any:
    - error: used when any error could be returned, can also leave blank

    there are also some std lib fns that help with this
    - typeOf(): returns the category and metainformation of each type
    - cast(): casts type to something
    - align()
    - bitSize()
    - compError()
  */

  // basic example
  type List(comp type T) => struct {
    T[] members,
    type this = This(); // can define items here for ease of use
    this init() {
      inline for 0..5 |_| {
        io.println("hi");
      }
      return this{ members = [] };
    };
  }

  void printType(comp type T) {
    std.meta.Type t = @typeOf(T);
    match t.Type {
      .Int: |int| { io.println(`integer {t.name}, {int.bits}, {bool(int.signed)}`); },
      _: @compError("issue here, we need int type");
    }
  }
}

void memory() {
  heap.GeneralPurposeAllocator gpa = heap.GeneralPurposeAllocator.init({});
  defer {if gpa.deinit() == .leak { panic("we leaked"); } }
  *i32 p = try gpa.allocOne(i32);
  defer gpa.free(p);
  *i32 p1 = try gpa.allocOne(i32, 1);
  defer gpa.free(p1);
  i32[] p2 = try gpa.allocMany(i32, 2);
  defer gpa.free(p2);

  heap.ArenaAllocator aa = heap.ArenaAllocator.init({});
  defer aa.deinit();

  i32* p3 = aa.allocOne(i32);
  i32[] p3 = aa.allocMany(i32, 2);
}

void concurrency() {
  void printStuff() => io.println("thread stuff");

  sync.Thread t1 = sync.spawn(printStuff());

  t1.join();
}
