import io;

void main() {
  // different control flow statements

  // if statement
  i32 three = 3;

  // statements can only be bools
  if(three == 3) {
    // code in block executed
    io::print("three is ${three}");
  }

  // if block is 1 line, {} not needed
  // above example becomes
  if(three == 3) io::print("three is ${three}"); // can be on separate line with indent

  // can also do else if
  if(three == 1)
      io::println("woah");
  else if(three == 2)
      io::println("woahx2");
  else
      io::println("Welp"); // default branch in case others fail, not necessary
}
