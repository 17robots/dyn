use "std/mem" mem
use "std/enums"
use "std/io" io
pub const Nanosecond: i64 = 1
pub const Microsecond: i64 = 1000
pub const Millisecond: i64 = 1000000
pub const Second: i64 = 1000000000
pub const Minute: i64 = 60000000000
pub const Hour: i64 = 3600000000000

pub struct Instant { seconds: i64, nanoseconds: i64 }
pub type DurationResult = io.Result(i64)
pub struct Deadline { at: Instant }
pub struct DateTime {
  year: i32, month: u8, day: u8,
  hour: u8, minute: u8, second: u8,
  nanosecond: u32,
}

pub fn checked_add(a, b: i64) DurationResult {
  if b > 0 && a > 9223372036854775807 - b {
    return DurationResult{ failure: io.Failure{ kind: io.Kind.Overflow } }
  }
  if b < 0 && a < -9223372036854775807 - 1 - b {
    return DurationResult{ failure: io.Failure{ kind: io.Kind.Overflow } }
  }
  return DurationResult{ value: a + b }
}
pub fn checked_sub(a, b: i64) DurationResult {
  if b == -9223372036854775807 - 1 {
    if a >= 0 {
      return DurationResult{ failure: io.Failure{ kind: io.Kind.Overflow } }
    }
    return DurationResult{ value: a - b }
  }
  return checked_add(a, 0 - b)
}
pub fn elapsed(start, end: Instant) DurationResult {
  seconds := checked_sub(end.seconds, start.seconds)
  if io.failed(seconds.failure) {
    return DurationResult{ failure: io.Failure{ kind: io.Kind.Overflow } }
  }
  scaled: i64 = 0
  if seconds.value > 9223372036 || seconds.value < -9223372036 {
    return DurationResult{ failure: io.Failure{ kind: io.Kind.Overflow } }
  }
  scaled = seconds.value * Second
  nanos := checked_sub(end.nanoseconds, start.nanoseconds)
  if io.failed(nanos.failure) {
    return DurationResult{ failure: io.Failure{ kind: io.Kind.Overflow } }
  }
  return checked_add(scaled, nanos.value)
}

pub type ClockResult = io.Result(Instant)
pub struct SleepResult { failure: io.Failure }
pub type DeadlineResult = io.Result(Deadline)
pub type ExpiredResult = io.Result(bool)
// Monotonic instants are for elapsed time/deadlines; realtime instants use Unix epoch.
pub fn monotonic_now() ClockResult {
  return native_clock(true)
}
pub fn realtime_now() ClockResult {
  return native_clock(false)
}
pub fn sleep(duration: i64) SleepResult {
  if duration <= 0 {
    return SleepResult{}
  }
  return native_sleep(duration)
}
pub fn deadline_after(duration: i64) DeadlineResult {
  now := monotonic_now()
  if io.failed(now.failure) {
    return DeadlineResult{ failure: io.Failure{ kind: now.failure.kind, native: now.failure.native } }
  }
  seconds := duration / Second
  nanos := now.value.nanoseconds + duration % Second
  if nanos >= Second {
    seconds += 1
    nanos -= Second
  }
  if nanos < 0 {
    seconds -= 1
    nanos += Second
  }
  sum := checked_add(now.value.seconds, seconds)
  if io.failed(sum.failure) {
    return DeadlineResult{ failure: io.Failure{ kind: io.Kind.Overflow } }
  }
  return DeadlineResult{ value: Deadline{ at: Instant{ seconds: sum.value, nanoseconds: nanos } } }
}
pub fn deadline_expired(deadline: *const Deadline) ExpiredResult {
  if deadline == nil {
    return ExpiredResult{ failure: io.Failure{ kind: io.Kind.InvalidInput } }
  }
  now := monotonic_now()
  if io.failed(now.failure) {
    return ExpiredResult{ failure: io.Failure{ kind: now.failure.kind, native: now.failure.native } }
  }
  return ExpiredResult{ value: now.value.seconds > deadline.at.seconds ||
      (now.value.seconds == deadline.at.seconds && now.value.nanoseconds >= deadline.at.nanoseconds) }
}
pub fn deadline_remaining(deadline: *const Deadline) DurationResult {
  if deadline == nil {
    return DurationResult{ failure: io.Failure{ kind: io.Kind.InvalidInput } }
  }
  now := monotonic_now()
  if io.failed(now.failure) {
    return DurationResult{ failure: io.Failure{ kind: now.failure.kind, native: now.failure.native } }
  }
  if now.value.seconds > deadline.at.seconds ||
    (now.value.seconds == deadline.at.seconds && now.value.nanoseconds >= deadline.at.nanoseconds) {
    return DurationResult{}
  }
  result := elapsed(now.value, deadline.at)
  if io.failed(result.failure) {
    return DurationResult{ failure: io.Failure{ kind: io.Kind.Overflow } }
  }
  return result
}

fn leap_year(year: i32) bool {
  return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}
pub fn valid(value: *const DateTime) bool {
  if value.month < 1 || value.month > 12 || value.day < 1 || value.hour > 23 ||
    value.minute > 59 || value.second > 60 || value.nanosecond >= 1000000000 {
    return false
  }
  days: [12]u8 = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
  maximum := days[#cast(usize, value.month) - 1]
  if value.month == 2 && leap_year(value.year) {
    maximum = 29
  }
  return value.day <= maximum
}
fn write_two(destination: []u8, at: usize, value: u8) {
  destination[at] = '0' + value / 10
  destination[at + 1] = '0' + value % 10
}
fn format_iso8601_into(destination: []u8, value: *const DateTime) []u8 {
  if #len(destination) < 20 || !valid(value) || value.year < 0 || value.year > 9999 {
    return destination[..0]
  }
  year := #cast(u32, value.year)
  destination[0] = '0' + #cast(u8, (year / 1000))
  destination[1] = '0' + #cast(u8, ((year / 100) % 10))
  destination[2] = '0' + #cast(u8, ((year / 10) % 10))
  destination[3] = '0' + #cast(u8, (year % 10))
  destination[4] = '-'
  write_two(destination, 5, value.month)
  destination[7] = '-'
  write_two(destination, 8, value.day)
  destination[10] = 'T'
  write_two(destination, 11, value.hour)
  destination[13] = ':'
  write_two(destination, 14, value.minute)
  destination[16] = ':'
  write_two(destination, 17, value.second)
  destination[19] = 'Z'
  return destination[..20]
}
fn decimal(byte: u8) bool {
  return byte >= '0' && byte <= '9'
}
fn read_two(input: []const u8, at: usize) u8 {
  return (input[at] - '0') * 10 + input[at + 1] - '0'
}
pub struct Parsed { value: DateTime, valid: bool }

// Parses YYYY-MM-DDTHH:MM:SSZ. ok is false, with a zero value, for anything else.
pub fn parse_iso8601(input: []const u8) Parsed {
  value: DateTime
  if !parse_iso8601_into(input, &value) {
    return Parsed{}
  }
  return Parsed{ value: value, valid: true }
}

fn parse_iso8601_into(input: []const u8, output: *DateTime) bool {
  if #len(input) != 20 || input[4] != '-' || input[7] != '-' || input[10] != 'T' ||
    input[13] != ':' || input[16] != ':' || input[19] != 'Z' {
    return false
  }
  positions: [14]u8 = [0, 1, 2, 3, 5, 6, 8, 9, 11, 12, 14, 15, 17, 18]
  for i in 0..#len(positions) {
    if !decimal(input[positions[i]]) {
      return false
    }
  }
  output.* = DateTime{
    year: #cast(i32, ((#cast(u32, (input[0] - '0'))) * 1000 + (#cast(u32, (input[1] - '0'))) * 100 + (#cast(u32, (input[2] - '0'))) * 10 + #cast(u32, (input[3] - '0')))),
    month: read_two(input, 5), day: read_two(input, 8), hour: read_two(input, 11),
    minute: read_two(input, 14), second: read_two(input, 17), nanosecond: 0,
  }
  return valid(output)
}

// value as YYYY-MM-DDTHH:MM:SSZ in arena, or "" when value is not a valid
// date in years 0 through 9999.
pub fn format_iso8601(arena: *mem.Arena, value: *const DateTime) []u8 {
  mark := mem.arena_mark(arena)
  space := mem.push_bytes_uninit(arena, 20)
  text := format_iso8601_into(space, value)
  mem.arena_rewind(arena, mark + #len(text))
  return text
}

pub enum Weekday { Sunday, Monday, Tuesday, Wednesday, Thursday, Friday, Saturday }

// Days since 1970-01-01 for a proleptic Gregorian date (Hinnant's
// days_from_civil). Valid for any i32 year.
pub fn days_from_civil(year: i32, month: u8, day: u8) i64 {
  y := #cast(i64, year)
  if month <= 2 {
    y -= 1
  }
  era := y / 400
  if y < 0 && y % 400 != 0 {
    era = (y - 399) / 400
  }
  year_of_era := y - era * 400
  shifted := #cast(i64, month) + 9
  if month > 2 {
    shifted = #cast(i64, month) - 3
  }
  day_of_year := (153 * shifted + 2) / 5 + day - 1
  day_of_era := year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year
  return era * 146097 + day_of_era - 719468
}

// The calendar date of a day count from 1970-01-01 (Hinnant's civil_from_days).
pub fn civil_from_days(days: i64) DateTime {
  z := days + 719468
  era := z / 146097
  if z < 0 && z % 146097 != 0 {
    era = (z - 146096) / 146097
  }
  day_of_era := z - era * 146097
  year_of_era := (day_of_era - day_of_era / 1460 + day_of_era / 36524 - day_of_era / 146096) / 365
  day_of_year := day_of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100)
  shifted := (5 * day_of_year + 2) / 153
  day := day_of_year - (153 * shifted + 2) / 5 + 1
  month := shifted + 3
  if shifted >= 10 {
    month = shifted - 9
  }
  year := year_of_era + era * 400
  if month <= 2 {
    year += 1
  }
  return DateTime{ year: #cast(i32, year), month: #cast(u8, month), day: #cast(u8, day) }
}

fn floor_divide(value: i64, divisor: i64) i64 {
  quotient := value / divisor
  if value % divisor != 0 && (value < 0) != (divisor < 0) {
    quotient -= 1
  }
  return quotient
}

// The UTC calendar time of an instant, shifted by offset seconds east of UTC.
// Use offset 0 for UTC, or a zone offset from std/time/zone.
pub fn date_time(instant: Instant, offset: i64) DateTime {
  seconds := instant.seconds + offset
  days := floor_divide(seconds, 86400)
  rest := seconds - days * 86400
  value := civil_from_days(days)
  value.hour = #cast(u8, rest / 3600)
  value.minute = #cast(u8, rest / 60 % 60)
  value.second = #cast(u8, rest % 60)
  value.nanosecond = #cast(u32, instant.nanoseconds)
  return value
}

// The instant of a calendar time that is offset seconds east of UTC. A leap
// second (second 60) maps to the following second.
pub fn instant_of(value: *const DateTime, offset: i64) Instant {
  days := days_from_civil(value.year, value.month, value.day)
  seconds := days * 86400 + #cast(i64, value.hour) * 3600 + #cast(i64, value.minute) * 60 + value.second - offset
  return Instant{ seconds: seconds, nanoseconds: value.nanosecond }
}

pub fn weekday(value: *const DateTime) Weekday {
  days := days_from_civil(value.year, value.month, value.day)
  index := floor_divide(days + 4, 7)
  return enums.from_int(Weekday, #cast(u64, days + 4 - index * 7))
}

// Day of the year, from 1 for January 1.
pub fn day_of_year(value: *const DateTime) u16 {
  return #cast(u16, days_from_civil(value.year, value.month, value.day) - days_from_civil(value.year, 1, 1) + 1)
}
