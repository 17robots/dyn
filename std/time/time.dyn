pub struct Timespec {
  seconds: i64,
  nanoseconds: i64,
}
pub struct DurationResult { value: i64, ok: bool }
pub struct DateTime { year: i32, month: u8, day: u8, hour: u8, minute: u8, second: u8, nanosecond: u32 }
pub struct Deadline { at: Timespec }

pub const Nanosecond: i64 = 1
pub const Microsecond: i64 = 1000
pub const Millisecond: i64 = 1000000
pub const Second: i64 = 1000000000
pub const Minute: i64 = 60000000000
pub const Hour: i64 = 3600000000000

pub fn duration_nanoseconds(value: Timespec) i64 {
  return value.seconds * Second + value.nanoseconds
}

pub fn elapsed_nanoseconds(start: Timespec, end: Timespec) i64 {
  return duration_nanoseconds(end) - duration_nanoseconds(start)
}

pub fn checked_add(left: i64, right: i64) DurationResult {
  if right > 0 && left > 9223372036854775807 - right { return DurationResult{} }
  if right < 0 && left < -9223372036854775807 - 1 - right { return DurationResult{} }
  return DurationResult{ value: left + right, ok: true }
}

pub fn checked_sub(left: i64, right: i64) DurationResult {
  if right == -9223372036854775807 - 1 {
    if left >= 0 { return DurationResult{} }
    return DurationResult{ value: left - right, ok: true }
  }
  return checked_add(left, 0 - right)
}

pub fn deadline_after(duration: i64) Deadline {
  now := monotonic_now()
  seconds := duration / Second
  nanos := duration % Second
  at := Timespec{ seconds: now.seconds + seconds, nanoseconds: now.nanoseconds + nanos }
  if at.nanoseconds >= Second { at.seconds += 1
    at.nanoseconds -= Second
  }
  if at.nanoseconds < 0 { at.seconds -= 1
    at.nanoseconds += Second
  }
  return Deadline{ at: at }
}

pub fn deadline_expired(value: *const Deadline) bool {
  now := monotonic_now()
  return now.seconds > value.at.seconds || (now.seconds == value.at.seconds && now.nanoseconds >= value.at.nanoseconds)
}

pub fn deadline_remaining(value: *const Deadline) i64 {
  now := monotonic_now()
  remaining := elapsed_nanoseconds(now, value.at)
  if remaining < 0 { return 0 }
  return remaining
}

fn leap(year: i32) bool { return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) }
pub fn valid_date(value: *const DateTime) bool {
  if value.month < 1 || value.month > 12 || value.day < 1 || value.hour > 23 || value.minute > 59 || value.second > 60 || value.nanosecond >= 1000000000 { return false }
  days: [12]u8 = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
  maximum := days[#cast(usize) value.month - 1]
  if value.month == 2 && leap(value.year) { maximum = 29 }
  return value.day <= maximum
}

fn two(destination: []u8, at: usize, value: u8) {
  destination[at] = '0' + value / 10
  destination[at + 1] = '0' + value % 10
}

// UTC ISO-8601 seconds form. Caller supplies at least 20 bytes.
pub fn format_iso8601(destination: []u8, value: *const DateTime) []u8 {
  if #len(destination) < 20 || !valid_date(value) || value.year < 0 || value.year > 9999 { return destination[..0] }
  year := #cast(u32) value.year
  destination[0] = '0' + #cast(u8) (year / 1000)
  destination[1] = '0' + #cast(u8) ((year / 100) % 10)
  destination[2] = '0' + #cast(u8) ((year / 10) % 10)
  destination[3] = '0' + #cast(u8) (year % 10)
  destination[4] = '-'
  two(destination, 5, value.month)
  destination[7] = '-'
  two(destination, 8, value.day)
  destination[10] = 'T'
  two(destination, 11, value.hour)
  destination[13] = ':'
  two(destination, 14, value.minute)
  destination[16] = ':'
  two(destination, 17, value.second)
  destination[19] = 'Z'
  return destination[..20]
}

fn digit(value: u8) bool { return value >= '0' && value <= '9' }
fn decimal2(input: []const u8, at: usize) u8 { return (input[at] - '0') * 10 + input[at + 1] - '0' }
pub fn parse_iso8601(input: []const u8, output: *DateTime) bool {
  if #len(input) != 20 || input[4] != '-' || input[7] != '-' || input[10] != 'T' || input[13] != ':' || input[16] != ':' || input[19] != 'Z' { return false }
  positions: [14]u8 = [0, 1, 2, 3, 5, 6, 8, 9, 11, 12, 14, 15, 17, 18]
  i: usize = 0
  for i < 14 { if !digit(input[#cast(usize) positions[i]]) { return false }
    i += 1
  }
  output.* = DateTime{
    year: #cast(i32) ((#cast(u32) (input[0] - '0')) * 1000 + (#cast(u32) (input[1] - '0')) * 100 + (#cast(u32) (input[2] - '0')) * 10 + #cast(u32) (input[3] - '0')),
    month: decimal2(input, 5), day: decimal2(input, 8), hour: decimal2(input, 11), minute: decimal2(input, 14), second: decimal2(input, 17), nanosecond: 0,
  }
  return valid_date(output)
}

pub fn sleep(duration: i64) {
  if duration <= 0 { return }
  request := Timespec{
    seconds: duration / Second,
    nanoseconds: duration % Second,
  }
  remaining := Timespec{ seconds: 0, nanoseconds: 0 }
  result := #syscall(35, &request, &remaining)
  for result == -4 {
    request = remaining
    result = #syscall(35, &request, &remaining)
  }
  if result != 0 { #panic("sleep failed") }
}

pub fn monotonic_now() Timespec {
  value := Timespec{ seconds: 0, nanoseconds: 0 }
  result := #syscall(228, 1, &value)
  if result != 0 { #panic("clock_gettime failed") }
  return value
}

pub fn realtime_now() Timespec {
  value := Timespec{ seconds: 0, nanoseconds: 0 }
  result := #syscall(228, 0, &value)
  if result != 0 { #panic("clock_gettime failed") }
  return value
}
