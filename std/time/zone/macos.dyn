#target(kernel: darwin)

const zoneinfo_root: []const u8 = "/usr/share/zoneinfo"

// readlink(path, storage); path ends in a zero byte.
fn read_link(path: []const u8, storage: []u8) isize {
  return #syscall(58, &path[0], &storage[0], #len(storage))
}

fn platform_load(arena: *mem.Arena, name: []const u8) ZoneResult {
  return posix_load(arena, name)
}

fn platform_system(arena: *mem.Arena) ZoneResult {
  return posix_system(arena)
}
