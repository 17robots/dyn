use fs "std/fs"
use io "std/io"
use process "std/process"

// Zone files are small; a larger file is not a zone.
const tzif_limit: usize = 1048576

fn read_zone(arena: *mem.Arena, name: []const u8, path: []const u8) Zone!io.IoErr {
  mark := mem.arena_mark(arena)
  data := try fs.read_all(arena, path, tzif_limit)
  parsed := parse_tzif(arena, name, data) catch {
    mem.arena_rewind(arena, mark)
    fail .InvalidInput
  }
  return parsed
}

fn posix_load(arena: *mem.Arena, name: []const u8) Zone!io.IoErr {
  mark := mem.arena_mark(arena)
  path := mem.push_bytes(arena, zoneinfo_root.len + 1 + name.len)
  _ = mem.copy(path, zoneinfo_root)
  path[zoneinfo_root.len] = '/'
  _ = mem.copy(path[zoneinfo_root.len + 1..], name)
  loaded := read_zone(arena, name, path) catch err {
    mem.arena_rewind(arena, mark)
    fail err
  }
  return loaded
}

// The zone name of /etc/localtime, from its symbolic link target when it is
// one ("/usr/share/zoneinfo/Europe/Berlin" names "Europe/Berlin").
fn local_name(arena: *mem.Arena) []const u8 {
  storage: [4096]u8
  length := read_link("/etc/localtime\x00", storage[..])
  if length > 0 {
    target := storage[..#cast(usize, length)]
    marker := "zoneinfo/"
    at := bytes.find(target, marker)
    if at != target.len { return strings.clone(arena, target[at + marker.len..]) }
  }
  return "localtime"
}

fn posix_system(arena: *mem.Arena) Zone!io.IoErr {
  text := process.environment_or(arena, "TZ", "")
  if text.len != 0 {
    if text[0] == ':' {
      text = text[1..]
    }
    if text.len != 0 && text[0] == '/' { return try read_zone(arena, text, text) }
    // A zone name, else a POSIX rule.
    loaded := load(arena, text) catch {
      rule := parse_posix(arena, text) catch { fail .InvalidInput }
      return rule
    }
    return loaded
  }
  loaded := read_zone(arena, local_name(arena), "/etc/localtime") catch err {
    case err {
      .NotFound => { return utc() }
      _ => { fail err }
    }
  }
  return loaded
}
