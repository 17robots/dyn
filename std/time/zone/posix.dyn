use "std/fail"
use "std/fs" fs
use "std/process" process

// Zone files are small; a larger file is not a zone.
const tzif_limit: usize = 1048576

fn read_zone(arena: *mem.Arena, status: *fail.Status, name: []const u8, path: []const u8) Zone {
  mark := mem.arena_mark(arena)
  data := fs.read_all(arena, status, path, tzif_limit)
  parsed := parse_tzif(arena, status, name, data)
  if status.failed {
    mem.arena_rewind(arena, mark)
  }
  return parsed
}

fn posix_load(arena: *mem.Arena, status: *fail.Status, name: []const u8) Zone {
  mark := mem.arena_mark(arena)
  path := mem.push_bytes(arena, #len(zoneinfo_root) + 1 + #len(name))
  _ = mem.copy(path, zoneinfo_root)
  path[#len(zoneinfo_root)] = '/'
  _ = mem.copy(path[#len(zoneinfo_root) + 1..], name)
  loaded := read_zone(arena, status, name, path)
  if status.failed {
    mem.arena_rewind(arena, mark)
  }
  return loaded
}

// The zone name of /etc/localtime, from its symbolic link target when it is
// one ("/usr/share/zoneinfo/Europe/Berlin" names "Europe/Berlin").
fn local_name(arena: *mem.Arena) []const u8 {
  storage: [4096]u8
  length := read_link("/etc/localtime\x00", storage[..])
  if length > 0 {
    target := storage[..#cast(usize, length)]
    marker := "zoneinfo/"
    at := bytes.find(target, marker)
    if at != #len(target) { return strings.clone(arena, target[at + #len(marker)..]) }
  }
  return "localtime"
}

fn posix_system(arena: *mem.Arena, status: *fail.Status) Zone {
  text := process.environment_or(arena, "TZ", "")
  if #len(text) != 0 {
    if text[0] == ':' {
      text = text[1..]
    }
    if #len(text) != 0 && text[0] == '/' { return read_zone(arena, status, text, text) }
    // A zone name, else a POSIX rule.
    named: fail.Status
    loaded := load(arena, &named, text)
    if !named.failed { return loaded }
    return parse_posix(arena, status, text)
  }
  local: fail.Status
  loaded := read_zone(arena, &local, local_name(arena), "/etc/localtime")
  if local.failed && local.failure.kind == fail.Kind.NotFound { return utc() }
  fail.set(status, local.failure)
  return loaded
}
