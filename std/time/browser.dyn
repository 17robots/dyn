use "std/io" io
#target(kernel: browser)
fn native_clock(monotonic: bool) ClockResult {
  _ = monotonic
  return ClockResult{ failure: io.Failure{ kind: io.Kind.Unsupported } }
}
fn native_sleep(duration: i64) SleepResult {
  _ = duration
  return SleepResult{ failure: io.Failure{ kind: io.Kind.Unsupported } }
}
