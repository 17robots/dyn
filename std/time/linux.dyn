use "std/io" io
#target(kernel: linux)
fn native_clock(monotonic: bool) ClockResult {
  value := Instant{}
  clock: isize = 0
  if monotonic {
    clock = 1
  }
  code := #syscall(228, clock, &value)
  if code < 0 {
    return ClockResult{ failure: io.Failure{ kind: io.linux(code), native: code } }
  }
  return ClockResult{ value: value }
}
fn native_sleep(duration: i64) SleepResult {
  request := Instant{ seconds: duration / Second, nanoseconds: duration % Second }
  remaining := Instant{}
  code := #syscall(35, &request, &remaining)
  for code == -4 {
    request = remaining
    code = #syscall(35, &request, &remaining)
  }
  if code < 0 {
    return SleepResult{ failure: io.Failure{ kind: io.linux(code), native: code } }
  }
  return SleepResult{}
}
