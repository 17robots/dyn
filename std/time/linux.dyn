use "std/os/linux/sys"
#target(kernel: linux)
fn native_clock(monotonic: bool) Instant {
  value := Instant{}
  clock: isize = 0
  if monotonic {
    clock = 1
  }
  code := #syscall(sys.ClockGettime, clock, &value)
  if code < 0 { return Instant{} }
  return value
}
fn native_sleep(duration: i64) {
  request := Instant{ seconds: duration / Second, nanoseconds: duration % Second }
  remaining := Instant{}
  code := #syscall(sys.Nanosleep, &request, &remaining)
  for code == -4 {
    request = remaining
    code = #syscall(sys.Nanosleep, &request, &remaining)
  }
}
