use "std/io" io
#target(kernel: wasi)
extern fn clock_read "dyn_time_wasi_clock"(clock: u32, precision: u64, value: *u64) u32
fn native_clock(monotonic: bool) ClockResult {
  value: u64 = 0
  clock: u32 = 0
  if monotonic {
    clock = 1
  }
  code := clock_read(clock, 1, &value)
  if code != 0 {
    return ClockResult{ failure: io.Failure{ kind: errors.wasi(#cast(isize, code)), native: 0 - #cast(isize, code) } }
  }
  return ClockResult{ value: Instant{ seconds: #cast(i64, (value / 1000000000)), nanoseconds: #cast(i64, (value % 1000000000)) } }
}
fn native_sleep(duration: i64) SleepResult {
  _ = duration
  return SleepResult{ failure: io.Failure{ kind: errors.Kind.Unsupported } }
}
