#target(arch: x86_64, kernel: windows)
extern fn clock_counter "dyn_time_counter"(value: *i64) i32
extern fn clock_frequency "dyn_time_frequency"(value: *i64) i32
extern fn clock_realtime "dyn_time_realtime"(value: *u64)
extern fn clock_sleep "dyn_time_sleep"(milliseconds: u32)
fn native_clock(monotonic: bool) ClockResult {
  if monotonic {
    counter: i64 = 0 frequency: i64 = 0
    if clock_counter(&counter) == 0 || clock_frequency(&frequency) == 0 || frequency <= 0 || counter < 0 {
      return ClockResult{ kind: errors.Kind.System }
    }
    // Divide before scaling; double conversion bounds the remainder without integer overflow.
    remainder := counter % frequency
    nanos := #cast(i64) ((#cast(f64) remainder / #cast(f64) frequency) * 1000000000.0)
    if nanos >= Second { nanos = Second - 1 }
    return ClockResult{ value: Instant{ seconds: counter / frequency, nanoseconds: nanos }, ok: true }
  }
  ticks: u64 = 0 clock_realtime(&ticks)
  seconds := #cast(i64) (ticks / 10000000) - 11644473600
  return ClockResult{ value: Instant{ seconds: seconds, nanoseconds: #cast(i64) (ticks % 10000000) * 100 }, ok: true }
}
fn native_sleep(duration: i64) SleepResult {
  milliseconds := #cast(u64) (duration / Millisecond)
  if duration % Millisecond != 0 { milliseconds += 1 }
  for milliseconds > 4294967294 { clock_sleep(4294967294) milliseconds -= 4294967294 }
  clock_sleep(#cast(u32) milliseconds)
  return SleepResult{ ok: true }
}
