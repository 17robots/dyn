use "std/mem" mem
use "std/compress/deflate" deflate
use "std/hash" hashing
use "std/io" stream
use "std/fail"
pub struct Entry {
  name: []const u8,
  payload: []const u8,
  method: u16,
  flags: u16,
  checksum: u32,
  compressed_size: usize,
  uncompressed_size: usize,
  directory: bool,
}
// After a failure a reader stays failed: next fails the same way again.
pub struct ArchiveReader { source: []const u8, offset: usize, indexed: bool, directory_start: usize, directory_end: usize, remaining: usize, failed: bool, failure: fail.Failure }
// An entry, found false at the end of the archive; offset is the reader's
// position after it.
pub struct Next { value: Entry, offset: usize, found: bool }
pub struct StreamReader {
  source_reader: stream.Reader,
  header_storage: []u8,
  name_storage: []u8,
  payload_storage: []u8,
  ended: bool,
  offset: usize,
  failed: bool,
  failure: fail.Failure,
}

// The three storages must not overlap; if they do, the first next fails with
// InvalidInput.
pub fn stream_reader(input: stream.Reader, header_storage: []u8, name_storage: []u8,
  payload_storage: []u8) StreamReader {
  if bytes.overlaps(header_storage, name_storage) || bytes.overlaps(header_storage, payload_storage) || bytes.overlaps(name_storage, payload_storage) {
    return StreamReader{ failed: true, failure: fail.make(fail.Kind.InvalidInput, "read ZIP", "", "the storages overlap") }
  }
  return StreamReader{ source_reader: input, header_storage: header_storage,
    name_storage: name_storage, payload_storage: payload_storage }
}

fn message_of(kind: fail.Kind) []const u8 {
  if kind == fail.Kind.Capacity { return "an entry does not fit the storage" }
  if kind == fail.Kind.Unsupported { return "unsupported ZIP feature" }
  if kind == fail.Kind.Overflow { return "the archive is too large" }
  return "malformed ZIP"
}
fn located(kind: fail.Kind, offset: usize) fail.Failure {
  failure := fail.make(kind, "read ZIP", "", message_of(kind))
  failure.offset = offset
  failure.has_offset = true
  return failure
}
// Records the first failure on the reader and reports it.
fn stream_failed(status: *fail.Status, state: *StreamReader, kind: fail.Kind) Next {
  if !state.failed {
    state.failed = true
    state.failure = located(kind, state.offset)
  }
  fail.set(status, state.failure)
  return Next{ offset: state.offset }
}
fn archive_failed(status: *fail.Status, state: *ArchiveReader, kind: fail.Kind) Next {
  if !state.failed {
    state.failed = true
    state.failure = located(kind, state.offset)
  }
  fail.set(status, state.failure)
  return Next{ offset: state.offset }
}
// Fills destination; the count read, short only at the end of the stream. A
// stream failure is kept on the reader.
fn stream_read(state: *StreamReader, destination: []u8) usize {
  total: usize = 0
  for total < #len(destination) {
    reading: fail.Status
    count := stream.read(&reading, state.source_reader, destination[total..])
    if reading.failed {
      state.failed = true
      state.failure = reading.failure
      return total
    }
    if count == 0 { return total }
    if count > #max(usize) - state.offset {
      state.failed = true
      state.failure = located(fail.Kind.Overflow, state.offset)
      return total
    }
    state.offset += count
    total += count
  }
  return total
}
fn stream_exact(state: *StreamReader, destination: []u8) bool {
  count := stream_read(state, destination)
  if state.failed { return false }
  if count != #len(destination) {
    state.failed = true
    state.failure = located(fail.Kind.InvalidInput, state.offset)
    return false
  }
  return true
}

fn stream_discard(state: *StreamReader, amount: usize) bool {
  left := amount
  for left > 0 {
    take := left
    if take > #len(state.header_storage) {
      take = #len(state.header_storage)
    }
    if take == 0 || !stream_exact(state, state.header_storage[..take]) { return false }
    left -= take
  }
  return true
}

// Reads one local-file entry from a stream. Name and payload borrow caller
// storage. Malformed input fails with InvalidInput, an entry larger than the
// storage with Capacity, encryption or data descriptors with Unsupported.
pub fn next_stream(status: *fail.Status, state: *StreamReader) Next {
  if status.failed { return Next{ offset: state.offset } }
  if state.failed { return stream_failed(status, state, fail.Kind.InvalidInput) }
  if state.ended { return Next{ offset: state.offset } }
  if #len(state.header_storage) < 30 { return stream_failed(status, state, fail.Kind.Capacity) }
  first := stream_read(state, state.header_storage[..4])
  if state.failed { return stream_failed(status, state, fail.Kind.InvalidInput) }
  if first == 0 {
    state.ended = true
    return Next{ offset: state.offset }
  }
  if first != 4 { return stream_failed(status, state, fail.Kind.InvalidInput) }
  signature := u32le(state.header_storage, 0)
  if signature == 33639248 {
    state.ended = true
    return Next{ offset: state.offset }
  }
  if signature == 101010256 {
    if !stream_exact(state, state.header_storage[4..22]) {
      return stream_failed(status, state, fail.Kind.InvalidInput)
    }
    error := end_record(state.header_storage[..22])
    if error != fail.Kind.Ok { return stream_failed(status, state, error) }
    if !stream_discard(state, u16le(state.header_storage, 20)) {
      return stream_failed(status, state, fail.Kind.InvalidInput)
    }
    state.ended = true
    return Next{ offset: state.offset }
  }
  if signature != 67324752 || !stream_exact(state, state.header_storage[4..30]) {
    return stream_failed(status, state, fail.Kind.InvalidInput)
  }
  header := state.header_storage[..30]
  flags := u16le(header, 6)
  method := u16le(header, 8)
  checksum := u32le(header, 14)
  if (flags & 1) != 0 || (flags & 8) != 0 { return stream_failed(status, state, fail.Kind.Unsupported) }
  compressed_size := #cast(usize, u32le(header, 18))
  uncompressed_size := #cast(usize, u32le(header, 22))
  name_length := #cast(usize, u16le(header, 26))
  extra_length := #cast(usize, u16le(header, 28))
  if name_length > #len(state.name_storage) || compressed_size > #len(state.payload_storage) {
    return stream_failed(status, state, fail.Kind.Capacity)
  }
  if !stream_exact(state, state.name_storage[..name_length]) || !stream_discard(state, extra_length) ||
    !stream_exact(state, state.payload_storage[..compressed_size]) {
    return stream_failed(status, state, fail.Kind.InvalidInput)
  }
  name := state.name_storage[..name_length]
  return Next{ value: Entry{ name: name, payload: state.payload_storage[..compressed_size], method: method,
    flags: flags, checksum: checksum, compressed_size: compressed_size,
    uncompressed_size: uncompressed_size, directory: name_length > 0 && name[name_length - 1] == '/' }, offset: state.offset, found: true }
}

fn u16le(source: []const u8, at: usize) u16 {
  return #cast(u16, source[at]) | (#cast(u16, source[at + 1]) << 8)
}
fn u32le(source: []const u8, at: usize) u32 {
  return #cast(u32, source[at]) | (#cast(u32, source[at + 1]) << 8) |
    (#cast(u32, source[at + 2]) << 16) | (#cast(u32, source[at + 3]) << 24)
}
fn end_record(source: []const u8) fail.Kind {
  if #len(source) < 22 { return fail.Kind.InvalidInput }
  if u16le(source, 4) != 0 || u16le(source, 6) != 0 || u16le(source, 8) != u16le(source, 10) || u16le(source, 10) == 65535 {
    return fail.Kind.Unsupported
  }
  return fail.Kind.Ok
}
pub fn open(source: []const u8) ArchiveReader {
  return ArchiveReader{ source: source }
}

// Reads the next entry of an archive in memory, with the same failures as
// next_stream.
pub fn next(status: *fail.Status, state: *ArchiveReader) Next {
  if status.failed { return Next{ offset: state.offset } }
  if state.failed { return archive_failed(status, state, fail.Kind.InvalidInput) }
  if #len(state.source) > (#max(usize) >> 1) { return archive_failed(status, state, fail.Kind.Overflow) }
  if state.indexed { return next_indexed(status, state) }
  if state.offset == #len(state.source) { return Next{ offset: state.offset } }
  if state.offset <= #len(state.source) && #len(state.source) - state.offset >= 4 && u32le(state.source, state.offset) == 33639248 {
    return Next{ offset: state.offset }
  }
  start := state.offset
  if start <= #len(state.source) && #len(state.source) - start >= 4 && u32le(state.source, start) == 101010256 {
    remaining := state.source[start..]
    error := end_record(remaining)
    if error != fail.Kind.Ok { return archive_failed(status, state, error) }
    if #cast(usize, u16le(remaining, 20)) > #len(remaining) - 22 {
      return archive_failed(status, state, fail.Kind.InvalidInput)
    }
    state.offset = start + 22 + u16le(remaining, 20)
    return Next{ offset: state.offset }
  }
  if start > #len(state.source) || #len(state.source) - start < 30 || u32le(state.source, start) != 67324752 {
    return archive_failed(status, state, fail.Kind.InvalidInput)
  }
  flags := u16le(state.source, start + 6)
  method := u16le(state.source, start + 8)
  if (flags & 1) != 0 || (flags & 8) != 0 { return archive_failed(status, state, fail.Kind.Unsupported) }
  compressed_size := #cast(usize, u32le(state.source, start + 18))
  uncompressed_size := #cast(usize, u32le(state.source, start + 22))
  name_length := #cast(usize, u16le(state.source, start + 26))
  extra_length := #cast(usize, u16le(state.source, start + 28))
  data_start := start + 30
  if name_length > #len(state.source) - data_start {
    return archive_failed(status, state, fail.Kind.InvalidInput)
  }
  payload_start := data_start + name_length
  if extra_length > #len(state.source) - payload_start {
    return archive_failed(status, state, fail.Kind.InvalidInput)
  }
  payload_start += extra_length
  if compressed_size > #len(state.source) - payload_start {
    return archive_failed(status, state, fail.Kind.InvalidInput)
  }
  payload_end := payload_start + compressed_size
  name := state.source[data_start..data_start + name_length]
  directory := #len(name) > 0 && name[#len(name) - 1] == '/'
  state.offset = payload_end
  return Next{ value: Entry{
    name: name, payload: state.source[payload_start..payload_end], method: method, flags: flags,
    checksum: u32le(state.source, start + 14), compressed_size: compressed_size,
    uncompressed_size: uncompressed_size, directory: directory,
  }, offset: state.offset, found: true }
}

// The entry's bytes, decompressed and checksum-verified, in arena. Malformed
// data or a checksum mismatch fails with InvalidInput, a method other than
// stored or deflate with Unsupported. Failure pushes nothing. Source must
// remain immutable.
pub fn extract(arena: *mem.Arena, status: *fail.Status, archive_entry: Entry) []u8 {
  empty: []u8
  if status.failed { return empty }
  if #len(archive_entry.payload) > (#max(usize) >> 1) || archive_entry.uncompressed_size > (#max(usize) >> 1) {
    fail.set(status, fail.make(fail.Kind.Overflow, "extract ZIP entry", archive_entry.name, "the entry is too large"))
    return empty
  }
  if #len(archive_entry.payload) != archive_entry.compressed_size {
    fail.invalid(status, "extract ZIP entry", archive_entry.name, "the payload does not match its size")
    return empty
  }
  mark := mem.arena_mark(arena)
  output := extract_into(status, mem.push_bytes(arena, archive_entry.uncompressed_size), archive_entry)
  if status.failed {
    mem.arena_rewind(arena, mark)
  }
  return output
}

fn extract_into(status: *fail.Status, destination: []u8, archive_entry: Entry) []u8 {
  empty: []u8
  if bytes.overlaps(destination, archive_entry.payload) {
    fail.invalid(status, "extract ZIP entry", archive_entry.name, "the payload lies in the arena's free space")
    return empty
  }
  written: usize = 0
  if archive_entry.method == 0 {
    if archive_entry.compressed_size != archive_entry.uncompressed_size {
      fail.invalid(status, "extract ZIP entry", archive_entry.name, "a stored entry changes size")
      return empty
    }
    i: usize = 0
    for i < archive_entry.uncompressed_size {
      destination[i] = archive_entry.payload[i]
      i += 1
    }
    written = archive_entry.uncompressed_size
  } else if archive_entry.method == 8 {
    inflater := deflate.InflateState{}
    result := deflate.resume(&inflater, destination[..archive_entry.uncompressed_size], archive_entry.payload)
    if !result.done || result.written != archive_entry.uncompressed_size || result.consumed != archive_entry.compressed_size {
      failure := fail.make(fail.Kind.InvalidInput, "extract ZIP entry", archive_entry.name, "malformed deflate data")
      failure.offset = result.consumed
      failure.has_offset = true
      fail.set(status, failure)
      return empty
    }
    written = result.written
  } else {
    fail.set(status, fail.make(fail.Kind.Unsupported, "extract ZIP entry", archive_entry.name, "unsupported compression method"))
    return empty
  }
  output := destination[..written]
  if hashing.crc32(output) != archive_entry.checksum {
    fail.invalid(status, "extract ZIP entry", archive_entry.name, "checksum mismatch")
    return empty
  }
  return output
}
