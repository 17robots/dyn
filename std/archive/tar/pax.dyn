use parse "std/parse"
use bytes "std/bytes"

struct Overrides { path: []const u8, link: []const u8, size: u64, has_path: bool, has_link: bool, has_size: bool, delete_size: bool }
// offset is the position after the last entry. ended turns true when next
// returns no entry, at the end of the archive or after a failure.
pub struct ArchiveReader { source: []const u8, offset: usize, defaults: Overrides, ended: bool }
pub fn reader(source: []const u8) ArchiveReader {
  return ArchiveReader{ source: source }
}
fn decimal(source: []const u8, output: *u64) bool {
  if source.len == 0 { return false }
  value: u64 = 0
  for byte in source {
    if byte < '0' || byte > '9' || value > (18446744073709551615 - #cast(u64, (byte - '0'))) / 10 {
      return false
    }
    value = value * 10 + (byte - '0')
  }
  output.* = value
  return true
}
fn pax(source: []const u8, values: *Overrides, global: bool) bool {
  at: usize = 0
  for at < source.len {
    space := at
    for space < source.len && source[space] != ' ' {
      space += 1
    }
    if space == source.len { return false }
    length: u64 = 0
    if !decimal(source[at..space], &length) || length > (source.len - at) || length <= (space - at + 2) {
      return false
    }
    end := at + #cast(usize, length)
    if source[end - 1] != '\n' { return false }
    equal := space + 1
    for equal < end - 1 && source[equal] != '=' {
      equal += 1
    }
    if equal == end - 1 || equal == space + 1 { return false }
    key := source[space + 1..equal]
    value := source[equal + 1..end - 1]
    for byte in value {
      if byte == 0 { return false }
    }
    if bytes.equal(key, "path") {
      values.path = value
      values.has_path = !global || value.len > 0
    } else if bytes.equal(key, "linkpath") {
      values.link = value
      values.has_link = !global || value.len > 0
    } else if bytes.equal(key, "size") {
      values.has_size = !global || value.len > 0
      values.delete_size = value.len == 0
      if value.len > 0 && !decimal(value, &values.size) { return false }
    }
    // Sparse payloads need a different extraction model; never expose them as ordinary files.
    else if key.len >= 10 && bytes.equal(key[..10], "GNU.sparse") { return false }
    at = end
  }
  return true
}
fn combined_overrides(global: Overrides, local: Overrides) Overrides {
  result := global
  if local.has_path {
    result.path = local.path
    result.has_path = local.path.len > 0
  }
  if local.has_link {
    result.link = local.link
    result.has_link = local.link.len > 0
  }
  if local.has_size {
    result.size = local.size
    result.has_size = !local.delete_size
  }
  return result
}
fn apply_overrides(entry: *Entry, values: Overrides) {
  if values.has_path {
    entry.name = values.path
    entry.prefix = values.path[..0]
  }
  if values.has_link {
    entry.link_name = values.link
  }
  if values.has_size {
    entry.size = values.size
  }
}

// Names and payload borrow source. Metadata records are consumed internally.
// A failed call leaves both offset and persistent PAX defaults unchanged, so
// it fails again the same way. Malformed or truncated input fails with
// Invalid at the offending header (or the end, for truncation).
pub fn next(state: *ArchiveReader) Entry!parse.ParseErr {
  cursor := state.offset
  global := state.defaults
  local := Overrides{}
  pending: bool = false
  for {
    record_start := cursor
    if cursor > state.source.len { fail malformed(state, cursor) }
    if cursor == state.source.len {
      if pending { fail malformed(state, state.source.len) }
      return archive_ended(state)
    }
    if state.source.len - cursor < 512 { fail malformed(state, state.source.len) }
    header := parse_header(state.source[cursor..cursor + 512])
    if !header.ok { fail malformed(state, record_start) }
    if header.ended {
      if pending { fail malformed(state, record_start) }
      return archive_ended(state)
    }
    entry := header.entry
    extension := entry.kind == 'x' || entry.kind == 'g' || entry.kind == 'L' || entry.kind == 'K'
    if !extension {
      apply_overrides(&entry, combined_overrides(global, local))
    }
    start := cursor + 512
    if entry.size > (state.source.len - start) { fail malformed(state, state.source.len) }
    size := #cast(usize, entry.size)
    padding: usize = (512 - size % 512) % 512
    if padding > state.source.len - start - size { fail malformed(state, state.source.len) }
    entry.data = state.source[start..start + size]
    cursor = start + size + padding
    if !extension {
      state.offset = cursor
      state.defaults = global
      return entry
    }
    pending = true
    if entry.kind == 'x' {
      if !pax(entry.data, &local, false) { fail malformed(state, record_start) }
    } else if entry.kind == 'g' {
      if !pax(entry.data, &global, true) { fail malformed(state, record_start) }
    } else {
      if size == 0 || entry.data[size - 1] != 0 { fail malformed(state, record_start) }
      value := entry.data[..size - 1]
      for byte in value {
        if byte == 0 { fail malformed(state, record_start) }
      }
      if entry.kind == 'L' {
        local.path = value
        local.has_path = true
      } else {
        local.link = value
        local.has_link = true
      }
    }
  }
  fail malformed(state, cursor)
}
fn malformed(state: *ArchiveReader, offset: usize) parse.ParseErr {
  _ = archive_ended(state)
  return parse.ParseErr.Invalid(offset)
}
fn archive_ended(state: *ArchiveReader) Entry {
  state.ended = true
  return Entry{}
}
