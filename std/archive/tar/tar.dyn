use "std/io" stream
use "std/parse" parse
pub struct Entry {
  name: []const u8,
  prefix: []const u8,
  link_name: []const u8,
  size: u64,
  kind: u8,
  data: []const u8,
}

pub struct StreamReader {
  source_reader: stream.Reader,
  metadata: []u8,
  spare: []u8,
  metadata_used: usize,
  defaults: Overrides,
  header_storage: []u8,
  remaining: usize,
  padding: usize,
  active: bool,
  ended: bool,
  offset: usize,
  failed: bool,
  failure: parse.StreamFailure,
}

// typeflag is the TAR protocol byte.
// offset counts source bytes consumed, including partial reads on failure.
pub struct StreamEntry {
  name: []const u8,
  prefix: []const u8,
  link_name: []const u8,
  size: u64,
  typeflag: u8,
  offset: usize,
  found: bool,
  failure: parse.StreamFailure,
}

pub fn stream_reader(input: stream.Reader, header_storage: []u8, metadata: []u8) StreamReader {
  if bytes.overlaps(header_storage, metadata) {
    return StreamReader{ failed: true, failure: parse.parse_failure(parse.Kind.Overlap, 0, "") }
  }
  half := #len(metadata) / 2
  return StreamReader{ source_reader: input, header_storage: header_storage, metadata: metadata[..half], spare: metadata[half..half * 2] }
}

struct Header { entry: Entry, ended: bool, ok: bool }
fn parse_header(header: []const u8) Header {
  if #len(header) < 512 {
    return Header{}
  }
  all_zero := true
  for byte in header[..512] {
    if byte != 0 {
      all_zero = false
      break
    }
  }
  if all_zero {
    return Header{ ended: true, ok: true }
  }
  expected: u64 = 0
  size: u64 = 0
  checksum: u64 = 0
  if !octal(header[148..156], &expected) || !octal(header[124..136], &size) {
    return Header{}
  }
  for i in 0..512 {
    if i >= 148 && i < 156 {
      checksum += 32
    } else {
      checksum += #cast(u64, header[i])
    }
  }
  if checksum != expected || size > 18446744073709551104 {
    return Header{}
  }
  prefix := header[..0]
  if header[257] == 'u' && header[258] == 's' && header[259] == 't' && header[260] == 'a' && header[261] == 'r' && header[262] == 0 {
    prefix = header[345..345 + string_end(header[345..500])]
  }
  return Header{ entry: Entry{ name: header[..string_end(header[..100])], prefix: prefix,
    link_name: header[157..157 + string_end(header[157..257])], size: size, kind: header[156] }, ok: true }
}

// Every read contributes to the absolute input cursor, including partial errors.
// The failed flag, rather than a native-code sentinel, preserves native zero.
fn stream_failure(state: *StreamReader, failure: parse.StreamFailure) StreamEntry {
  if !state.failed {
    state.failed = true
    state.failure = failure
  }
  return StreamEntry{ offset: state.offset, failure: state.failure }
}
fn syntax_failure(state: *StreamReader, kind: parse.Kind, message: []const u8) StreamEntry {
  return stream_failure(state, parse.parse_failure(kind, state.offset, message))
}
// Payload reads speak stream.Result, so parse failures map to the nearest io kind.
fn failed_read(state: *StreamReader, transferred: usize) stream.Result {
  kind := stream.Kind.InvalidInput
  if state.failure.kind == parse.StreamKind.Io {
    kind = state.failure.io.kind
  } else if state.failure.parse.kind == parse.Kind.Capacity {
    kind = stream.Kind.Capacity
  } else if state.failure.parse.kind == parse.Kind.Overflow {
    kind = stream.Kind.Overflow
  }
  return stream.Result{ transferred: transferred, error: state.failure.io.native, kind: kind, status: stream.Status.Error }
}
fn read_exact(state: *StreamReader, destination: []u8) stream.Result {
  if state.failed {
    return failed_read(state, 0)
  }
  result := stream.read_exact(state.source_reader, destination)
  if result.status == stream.Status.Error {
    _ = stream_failure(state, parse.io_failure(result.kind, result.error))
  }
  if result.transferred > (~#cast(usize, 0)) - state.offset {
    _ = syntax_failure(state, parse.Kind.Overflow, "invalid offset")
    return failed_read(state, result.transferred)
  }
  state.offset += result.transferred
  return result
}
fn discard(state: *StreamReader, amount: usize) bool {
  left := amount
  for left > 0 {
    take := left
    if take > #len(state.header_storage) {
      take = #len(state.header_storage)
    }
    result := read_exact(state, state.header_storage[..take])
    if result.status != stream.Status.Complete {
      _ = syntax_failure(state, parse.Kind.Truncated, "")
      return false
    }
    left -= take
  }
  return true
}

// Metadata is split into two equal banks. Compact only live global/local names
// after each extension, so usage depends on live metadata, not archive length.
fn retain_name(destination: []u8, used: *usize, source: []const u8) []const u8 {
  start := used.*
  for byte in source {
    destination[used.*] = byte
    used.* += 1
  }
  return destination[start..used.*]
}
fn compact_metadata(state: *StreamReader, local: *Overrides) bool {
  required := #len(state.defaults.path) + #len(state.defaults.link) + #len(local.path) + #len(local.link)
  if required > #len(state.spare) {
    _ = syntax_failure(state, parse.Kind.Capacity, "")
    return false
  }
  used: usize = 0
  state.defaults.path = retain_name(state.spare, &used, state.defaults.path)
  state.defaults.link = retain_name(state.spare, &used, state.defaults.link)
  local.path = retain_name(state.spare, &used, local.path)
  local.link = retain_name(state.spare, &used, local.link)
  previous := state.metadata
  state.metadata = state.spare
  state.spare = previous
  state.metadata_used = used
  return true
}
// Input, header, and metadata storage must be disjoint. All returned names borrow
// header/metadata storage until next_stream. Each metadata half must fit live
// names plus the next extension payload. Empty metadata accepts plain TAR only.
pub fn next_stream(state: *StreamReader) StreamEntry {
  if state.failed {
    return StreamEntry{ offset: state.offset, failure: state.failure }
  }
  if state.ended {
    return StreamEntry{ offset: state.offset }
  }
  if #len(state.header_storage) < 512 {
    return syntax_failure(state, parse.Kind.Capacity, "")
  }
  if state.active {
    if !discard(state, state.remaining + state.padding) {
      return StreamEntry{ offset: state.offset, failure: state.failure }
    }
    state.active = false
  }
  local := Overrides{}
  pending: bool = false
  if !compact_metadata(state, &local) {
    return StreamEntry{ offset: state.offset, failure: state.failure }
  }
  for {
    header_result := read_exact(state, state.header_storage[..512])
    if header_result.status == stream.Status.End && header_result.transferred == 0 && !pending {
      state.ended = true
      return StreamEntry{ offset: state.offset }
    }
    if header_result.status != stream.Status.Complete {
      return syntax_failure(state, parse.Kind.Truncated, "")
    }
    parsed := parse_header(state.header_storage[..512])
    if !parsed.ok {
      return syntax_failure(state, parse.Kind.Syntax, "invalid header")
    }
    if parsed.ended {
      if pending {
        return syntax_failure(state, parse.Kind.Syntax, "invalid header")
      }
      state.ended = true
      return StreamEntry{ offset: state.offset }
    }
    entry := parsed.entry
    extension := entry.kind == 'x' || entry.kind == 'g' || entry.kind == 'L' || entry.kind == 'K'
    if !extension {
      apply_overrides(&entry, combined_overrides(state.defaults, local))
    }
    if entry.size > 18446744073709551104 {
      return syntax_failure(state, parse.Kind.Syntax, "invalid header")
    }
    state.remaining = #cast(usize, entry.size)
    state.padding = (512 - state.remaining % 512) % 512
    if !extension {
      state.active = true
      return StreamEntry{ name: entry.name, prefix: entry.prefix, link_name: entry.link_name,
        size: entry.size, typeflag: entry.kind, offset: state.offset, found: true }
    }
    pending = true
    if state.remaining > #len(state.metadata) - state.metadata_used {
      return syntax_failure(state, parse.Kind.Capacity, "")
    }
    payload := state.metadata[state.metadata_used..state.metadata_used + state.remaining]
    loaded := read_exact(state, payload)
    if loaded.status != stream.Status.Complete {
      return syntax_failure(state, parse.Kind.Truncated, "")
    }
    if !discard(state, state.padding) {
      return StreamEntry{ offset: state.offset, failure: state.failure }
    }
    if entry.kind == 'x' {
      if !pax(payload, &local, false) {
        return syntax_failure(state, parse.Kind.Syntax, "invalid header")
      }
    }
    else if entry.kind == 'g' {
      if !pax(payload, &state.defaults, true) {
        return syntax_failure(state, parse.Kind.Syntax, "invalid header")
      }
    }
    else {
      if #len(payload) == 0 || payload[#len(payload) - 1] != 0 {
        return syntax_failure(state, parse.Kind.Syntax, "invalid header")
      }
      value := payload[..#len(payload) - 1]
      for byte in value {
        if byte == 0 {
          return syntax_failure(state, parse.Kind.Syntax, "invalid header")
        }
      }
      if entry.kind == 'L' {
        local.path = value
        local.has_path = true
      }
      else {
        local.link = value
        local.has_link = true
      }
    }
    if !compact_metadata(state, &local) {
      return StreamEntry{ offset: state.offset, failure: state.failure }
    }
  }
  return syntax_failure(state, parse.Kind.Syntax, "invalid header")
}

// Reads entry payload incrementally. End means this entry is complete, not archive EOF.
pub fn read_stream(state: *StreamReader, destination: []u8) stream.Result {
  if state.failed {
    return failed_read(state, 0)
  }
  if !state.active {
    _ = stream_failure(state, parse.io_failure(stream.Kind.InvalidState, 0))
    return failed_read(state, 0)
  }
  if #len(destination) == 0 {
    return stream.Result{}
  }
  take := state.remaining
  if take > #len(destination) {
    take = #len(destination)
  }
  if take == 0 {
    return stream.Result{ status: stream.Status.End }
  }
  result := read_exact(state, destination[..take])
  if result.status != stream.Status.Complete {
    _ = syntax_failure(state, parse.Kind.Truncated, "")
    return failed_read(state, result.transferred)
  }
  state.remaining -= take
  status := stream.Status.Complete
  if state.remaining == 0 {
    status = stream.Status.End
  }
  return stream.Result{ transferred: take, status: status }
}

fn string_end(bytes: []const u8) usize {
  i: usize = 0
  for i < #len(bytes) && bytes[i] != 0 {
    i += 1
  }
  return i
}

fn octal(bytes: []const u8, output: *u64) bool {
  value: u64 = 0
  found := false
  for byte in bytes {
    if byte == 0 || byte == ' ' {
      if found {
        break
      } else {
        continue
      }
    }
    if byte < '0' || byte > '7' {
      return false
    }
    if value > (18446744073709551615 - #cast(u64, (byte - '0'))) / 8 {
      return false
    }
    value = value * 8 + #cast(u64, (byte - '0'))
    found = true
  }
  output.* = value
  return found
}

// Slices borrow archive. End and Error leave offset unchanged, so both repeat.
// Buffered parser errors retain their module category in detail. offset is the
// absolute offending header (or first missing byte for truncation).
pub struct Result { entry: Entry, offset: usize, found: bool, failure: parse.Failure }
