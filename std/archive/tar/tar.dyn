use "std/io" stream
use "std/fail"
pub struct Entry {
  name: []const u8,
  prefix: []const u8,
  link_name: []const u8,
  size: u64,
  kind: u8,
  data: []const u8,
}

pub struct StreamReader {
  source_reader: stream.Reader,
  metadata: []u8,
  spare: []u8,
  metadata_used: usize,
  defaults: Overrides,
  header_storage: []u8,
  remaining: usize,
  padding: usize,
  active: bool,
  // Turns true when next_stream returns no entry, at the end of the archive
  // or after a failure.
  ended: bool,
  offset: usize,
  failed: bool,
  failure: fail.Failure,
}

// typeflag is the TAR protocol byte. offset counts source bytes consumed.
pub struct StreamEntry {
  name: []const u8,
  prefix: []const u8,
  link_name: []const u8,
  size: u64,
  typeflag: u8,
  offset: usize,
}

// Header and metadata storage must not overlap; if they do, the first
// next_stream fails with InvalidInput.
pub fn stream_reader(input: stream.Reader, header_storage: []u8, metadata: []u8) StreamReader {
  if bytes.overlaps(header_storage, metadata) {
    return StreamReader{ failed: true, failure: fail.make(fail.Kind.InvalidInput, "read TAR", "", "the storages overlap") }
  }
  half := #len(metadata) / 2
  return StreamReader{ source_reader: input, header_storage: header_storage, metadata: metadata[..half], spare: metadata[half..half * 2] }
}

struct Header { entry: Entry, ended: bool, ok: bool }
fn parse_header(header: []const u8) Header {
  if #len(header) < 512 { return Header{} }
  all_zero := true
  for byte in header[..512] {
    if byte != 0 {
      all_zero = false
      break
    }
  }
  if all_zero { return Header{ ended: true, ok: true } }
  expected: u64 = 0
  size: u64 = 0
  checksum: u64 = 0
  if !octal(header[148..156], &expected) || !octal(header[124..136], &size) { return Header{} }
  for i in 0..512 {
    if i >= 148 && i < 156 { checksum += 32 } else { checksum += header[i] }
  }
  if checksum != expected || size > 18446744073709551104 { return Header{} }
  prefix := header[..0]
  if header[257] == 'u' && header[258] == 's' && header[259] == 't' && header[260] == 'a' && header[261] == 'r' && header[262] == 0 {
    prefix = header[345..345 + string_end(header[345..500])]
  }
  return Header{ entry: Entry{ name: header[..string_end(header[..100])], prefix: prefix,
    link_name: header[157..157 + string_end(header[157..257])], size: size, kind: header[156] }, ok: true }
}

fn located(kind: fail.Kind, offset: usize) fail.Failure {
  message: []const u8 = "malformed TAR"
  if kind == fail.Kind.Capacity {
    message = "the metadata does not fit the storage"
  } else if kind == fail.Kind.Overflow {
    message = "the archive is too large"
  }
  failure := fail.make(kind, "read TAR", "", message)
  failure.offset = offset
  failure.has_offset = true
  return failure
}
// Every read contributes to the absolute input cursor. The first failure stays
// on the reader.
fn mark_failed(state: *StreamReader, kind: fail.Kind) {
  if state.failed { return }
  state.failed = true
  state.failure = located(kind, state.offset)
}
fn stream_failed(status: *fail.Status, state: *StreamReader, kind: fail.Kind) StreamEntry {
  mark_failed(state, kind)
  fail.set(status, state.failure)
  state.ended = true
  return StreamEntry{ offset: state.offset }
}
// Fills destination; the count read, short only at the end of the stream.
fn read_exact(state: *StreamReader, destination: []u8) usize {
  total: usize = 0
  for !state.failed && total < #len(destination) {
    reading: fail.Status
    count := stream.read(&reading, state.source_reader, destination[total..])
    if reading.failed {
      state.failed = true
      state.failure = reading.failure
      return total
    }
    if count == 0 { return total }
    if count > #max(usize) - state.offset {
      mark_failed(state, fail.Kind.Overflow)
      return total
    }
    state.offset += count
    total += count
  }
  return total
}
// Reads all of destination; a short read is a truncated archive.
fn read_all(state: *StreamReader, destination: []u8) bool {
  count := read_exact(state, destination)
  if !state.failed && count != #len(destination) {
    mark_failed(state, fail.Kind.InvalidInput)
  }
  return !state.failed
}
fn discard(state: *StreamReader, amount: usize) bool {
  left := amount
  for left > 0 {
    take := left
    if take > #len(state.header_storage) {
      take = #len(state.header_storage)
    }
    if !read_all(state, state.header_storage[..take]) { return false }
    left -= take
  }
  return true
}

// Metadata is split into two equal banks. Compact only live global/local names
// after each extension, so usage depends on live metadata, not archive length.
fn retain_name(destination: []u8, used: *usize, source: []const u8) []const u8 {
  start := used.*
  for byte in source {
    destination[used.*] = byte
    used.* += 1
  }
  return destination[start..used.*]
}
fn compact_metadata(state: *StreamReader, local: *Overrides) bool {
  required := #len(state.defaults.path) + #len(state.defaults.link) + #len(local.path) + #len(local.link)
  if required > #len(state.spare) {
    mark_failed(state, fail.Kind.Capacity)
    return false
  }
  used: usize = 0
  state.defaults.path = retain_name(state.spare, &used, state.defaults.path)
  state.defaults.link = retain_name(state.spare, &used, state.defaults.link)
  local.path = retain_name(state.spare, &used, local.path)
  local.link = retain_name(state.spare, &used, local.link)
  previous := state.metadata
  state.metadata = state.spare
  state.spare = previous
  state.metadata_used = used
  return true
}
// Input, header, and metadata storage must be disjoint. All returned names borrow
// header/metadata storage until next_stream. Each metadata half must fit live
// names plus the next extension payload. Empty metadata accepts plain TAR only.
// Malformed or truncated input fails with InvalidInput, metadata larger than
// its storage with Capacity. A failed reader stays failed.
pub fn next_stream(status: *fail.Status, state: *StreamReader) StreamEntry {
  if status.failed {
    state.ended = true
    return StreamEntry{ offset: state.offset }
  }
  if state.failed { return stream_failed(status, state, fail.Kind.InvalidInput) }
  if state.ended { return StreamEntry{ offset: state.offset } }
  if #len(state.header_storage) < 512 { return stream_failed(status, state, fail.Kind.Capacity) }
  if state.active {
    if !discard(state, state.remaining + state.padding) {
      return stream_failed(status, state, fail.Kind.InvalidInput)
    }
    state.active = false
  }
  local := Overrides{}
  pending: bool = false
  if !compact_metadata(state, &local) {
    return stream_failed(status, state, fail.Kind.InvalidInput)
  }
  for {
    header_count := read_exact(state, state.header_storage[..512])
    if !state.failed && header_count == 0 && !pending {
      state.ended = true
      return StreamEntry{ offset: state.offset }
    }
    if state.failed || header_count != 512 {
      return stream_failed(status, state, fail.Kind.InvalidInput)
    }
    parsed := parse_header(state.header_storage[..512])
    if !parsed.ok { return stream_failed(status, state, fail.Kind.InvalidInput) }
    if parsed.ended {
      if pending { return stream_failed(status, state, fail.Kind.InvalidInput) }
      state.ended = true
      return StreamEntry{ offset: state.offset }
    }
    entry := parsed.entry
    extension := entry.kind == 'x' || entry.kind == 'g' || entry.kind == 'L' || entry.kind == 'K'
    if !extension {
      apply_overrides(&entry, combined_overrides(state.defaults, local))
    }
    if entry.size > 18446744073709551104 {
      return stream_failed(status, state, fail.Kind.InvalidInput)
    }
    state.remaining = #cast(usize, entry.size)
    state.padding = (512 - state.remaining % 512) % 512
    if !extension {
      state.active = true
      return StreamEntry{ name: entry.name, prefix: entry.prefix, link_name: entry.link_name,
        size: entry.size, typeflag: entry.kind, offset: state.offset }
    }
    pending = true
    if state.remaining > #len(state.metadata) - state.metadata_used {
      return stream_failed(status, state, fail.Kind.Capacity)
    }
    payload := state.metadata[state.metadata_used..state.metadata_used + state.remaining]
    if !read_all(state, payload) { return stream_failed(status, state, fail.Kind.InvalidInput) }
    if !discard(state, state.padding) {
      return stream_failed(status, state, fail.Kind.InvalidInput)
    }
    if entry.kind == 'x' {
      if !pax(payload, &local, false) {
        return stream_failed(status, state, fail.Kind.InvalidInput)
      }
    } else if entry.kind == 'g' {
      if !pax(payload, &state.defaults, true) {
        return stream_failed(status, state, fail.Kind.InvalidInput)
      }
    } else {
      if #len(payload) == 0 || payload[#len(payload) - 1] != 0 {
        return stream_failed(status, state, fail.Kind.InvalidInput)
      }
      value := payload[..#len(payload) - 1]
      for byte in value {
        if byte == 0 { return stream_failed(status, state, fail.Kind.InvalidInput) }
      }
      if entry.kind == 'L' {
        local.path = value
        local.has_path = true
      } else {
        local.link = value
        local.has_link = true
      }
    }
    if !compact_metadata(state, &local) {
      return stream_failed(status, state, fail.Kind.InvalidInput)
    }
  }
  return stream_failed(status, state, fail.Kind.InvalidInput)
}

// Reads the current entry's payload incrementally; zero once the entry is
// complete (not the end of the archive). Without a current entry, fails with
// InvalidState.
pub fn read_stream(status: *fail.Status, state: *StreamReader, destination: []u8) usize {
  if status.failed { return 0 }
  if state.failed {
    fail.set(status, state.failure)
    return 0
  }
  if !state.active {
    fail.set(status, fail.make(fail.Kind.InvalidState, "read TAR", "", "no entry is open"))
    return 0
  }
  take := state.remaining
  if take > #len(destination) {
    take = #len(destination)
  }
  if take == 0 { return 0 }
  if !read_all(state, destination[..take]) {
    fail.set(status, state.failure)
    return 0
  }
  state.remaining -= take
  return take
}

fn string_end(data: []const u8) usize {
  i: usize = 0
  for i < #len(data) && data[i] != 0 {
    i += 1
  }
  return i
}

fn octal(data: []const u8, output: *u64) bool {
  value: u64 = 0
  found := false
  for byte in data {
    if byte == 0 || byte == ' ' {
      if found { break } else { continue }
    }
    if byte < '0' || byte > '7' { return false }
    if value > (18446744073709551615 - #cast(u64, (byte - '0'))) / 8 { return false }
    value = value * 8 + (byte - '0')
    found = true
  }
  output.* = value
  return found
}

