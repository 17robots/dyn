module mem

rt_copy := extern fn(dst: usize, src: usize, size: usize) u32 = "dynrt_mem_copy"
rt_move := extern fn(dst: usize, src: usize, size: usize) u32 = "dynrt_mem_move"
rt_set := extern fn(dst: usize, byte_value: u32, size: usize) u32 = "dynrt_mem_set"
rt_eq := extern fn(lhs: usize, rhs: usize, size: usize) u32 = "dynrt_mem_eq"

pub copy := (dst: usize, src: usize, size: usize) u32 => rt_copy(dst, src, size)
pub move := (dst: usize, src: usize, size: usize) u32 => rt_move(dst, src, size)
pub set := (dst: usize, byte_value: u32, size: usize) u32 => rt_set(dst, byte_value, size)
pub eq := (lhs: usize, rhs: usize, size: usize) u32 => rt_eq(lhs, rhs, size)
