module fmt

bytes_mod := use "std/bytes"

pub i32 := (value: i32) []u8 => $fmt_i32(value)

pub u64 := (value: u64) []u8 => $fmt_u64(value)

pub usize := (value: usize) []u8 => $fmt_usize(value)

pub join2 := (a: []u8, b: []u8) []u8 => bytes_mod.concat(a, b)

pub join3 := (a: []u8, b: []u8, c: []u8) []u8 => bytes_mod.concat3(a, b, c)
