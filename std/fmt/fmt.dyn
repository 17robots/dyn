pub fn u64_to_bytes(destination: []u8, value: u64) []u8 {
  digits: usize = 1
  remaining := value
  for remaining >= 10 {
    remaining /= 10
    digits += 1
  }
  if #len(destination) < digits { #panic("format destination too small") }
  index := digits
  remaining = value
  for index > 0 {
    index -= 1
    digit: u8 = #cast(u8) (remaining % 10)
    destination[index] = digit + 48
    remaining /= 10
  }
  return destination[..digits]
}

pub fn i64_to_bytes(destination: []u8, value: i64) []u8 {
  negative := value < 0
  magnitude: u64 = 0
  if negative {
    magnitude = #cast(u64) (-(value + 1))
    magnitude += 1
  }
  else { magnitude = #cast(u64) value }
  if !negative { return u64_to_bytes(destination, magnitude) }
  if #len(destination) == 0 { #panic("format destination too small") }
  destination[0] = '-'
  digits := u64_to_bytes(destination[1..], magnitude)
  return destination[..#len(digits) + 1]
}
