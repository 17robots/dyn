// Formatting. Buffer writes into bounded caller-owned storage and rolls back
// failed compound writes; the free functions return text in an arena.

use "std/mem" mem

// failed records the first write that did not fit; later writes do nothing,
// so callers write freely and check failed once at the end. A write that does
// not fit leaves the buffer as it was before that write.
pub struct Buffer { data: []u8, length: usize, failed: bool }
pub fn buffer(storage: []u8) Buffer {
  return Buffer{ data: storage, length: 0 }
}
pub fn bytes(state: *const Buffer) []const u8 {
  return state.data[..state.length]
}
pub fn remaining(state: *const Buffer) usize {
  if state.length > #len(state.data) {
    return 0
  }
  return #len(state.data) - state.length
}
// Empties the buffer and clears failed.
pub fn clear(state: *Buffer) {
  state.length = 0
  state.failed = false
}

fn put(state: *Buffer, value: []const u8) bool {
  if state.failed || state.length > #len(state.data) || #len(value) > #len(state.data) - state.length {
    state.failed = true
    return false
  }
  // Give the copy loop an exact-length local slice. This keeps descriptor
  // loads and redundant destination checks out of the per-byte loop.
  destination := state.data[state.length..]
  destination = destination[..#len(value)]
  for i in 0..#len(value) {
    destination[i] = value[i]
  }
  state.length += #len(value)
  return true
}

fn put_byte(state: *Buffer, value: u8) bool {
  if state.failed || state.length >= #len(state.data) {
    state.failed = true
    return false
  }
  state.data[state.length] = value
  state.length += 1
  return true
}

fn u64_base_into(destination: []u8, value: u64, base: u8, uppercase: bool) []u8 {
  if base < 2 || base > 36 {
    #panic("format base must be between 2 and 36")
  }
  radix := #cast(u64, base)
  digit_count: usize = 1
  remaining_value := value
  for remaining_value >= radix {
    remaining_value /= radix
    digit_count += 1
  }
  if #len(destination) < digit_count {
    return destination[..0]
  }
  at := digit_count
  remaining_value = value
  for at > 0 {
    at -= 1
    digit := #cast(u8, (remaining_value % radix))
    if digit < 10 {
      destination[at] = digit + '0'
    } else if uppercase {
      destination[at] = digit - 10 + 'A'
    } else {
      destination[at] = digit - 10 + 'a'
    }
    remaining_value /= radix
  }
  return destination[..digit_count]
}

fn u64_decimal_into(destination: []u8, value: u64) []u8 {
  // Keep the radix constant so the backend can reduce division by ten.
  digit_count: usize = 1
  remaining_value := value
  for remaining_value >= 10 {
    remaining_value /= 10
    digit_count += 1
  }
  if #len(destination) < digit_count {
    return destination[..0]
  }
  at := digit_count
  remaining_value = value
  for at > 0 {
    at -= 1
    quotient := remaining_value / 10
    digit := remaining_value - quotient * 10
    destination[at] = #cast(u8, digit) + '0'
    remaining_value = quotient
  }
  return destination[..digit_count]
}

fn i64_decimal_into(destination: []u8, value: i64) []u8 {
  negative := value < 0
  magnitude: u64 = 0
  if negative {
    magnitude = #cast(u64, (-(value + 1)))
    magnitude += 1
  } else {
    magnitude = #cast(u64, value)
  }
  if !negative {
    return u64_decimal_into(destination, magnitude)
  }
  if #len(destination) == 0 {
    return destination[..0]
  }
  destination[0] = '-'
  digits := u64_decimal_into(destination[1..], magnitude)
  if #len(digits) == 0 {
    return destination[..0]
  }
  return destination[..#len(digits) + 1]
}

fn put_u64(state: *Buffer, value: u64) bool {
  storage: [20]u8
  return put(state, u64_decimal_into(storage[..], value))
}

fn put_i64(state: *Buffer, value: i64) bool {
  storage: [20]u8
  return put(state, i64_decimal_into(storage[..], value))
}

fn put_bool(state: *Buffer, value: bool) bool {
  if value {
    return put(state, "true")
  }
  return put(state, "false")
}

fn put_padding(state: *Buffer, byte: u8, amount: usize) bool {
  if state.failed || state.length > #len(state.data) || amount > remaining(state) {
    state.failed = true
    return false
  }
  for i in 0..amount {
    state.data[state.length + i] = byte
  }
  state.length += amount
  return true
}

fn put_quoted(state: *Buffer, value: []const u8) bool {
  start := state.length
  if !put_byte(state, '"') {
    return false
  }
  for byte in value {
    escaped: u8 = 0
    if byte == '"' {
      escaped = '"'
    } else if byte == '\\' {
      escaped = '\\'
    } else if byte == 10 {
      escaped = 'n'
    } else if byte == 13 {
      escaped = 'r'
    } else if byte == 9 {
      escaped = 't'
    }
    if escaped != 0 {
      if !put_byte(state, '\\') || !put_byte(state, escaped) {
        state.length = start
        return false
      }
    } else if byte < 32 {
      if !put(state, "\\u00") {
        state.length = start
        return false
      }
      high := byte / 16
      low := byte % 16
      if !put_byte(state, if_hex(high)) || !put_byte(state, if_hex(low)) {
        state.length = start
        return false
      }
    } else if !put_byte(state, byte) {
      state.length = start
      return false
    }
  }
  if !put_byte(state, '"') {
    state.length = start
    return false
  }
  return true
}

fn if_hex(value: u8) u8 {
  if value < 10 {
    return value + '0'
  }
  return value - 10 + 'a'
}

fn put_arguments(state: *Buffer, arguments: []const any) bool {
  start := state.length
  for argument in arguments {
    ok := false
    case argument {
      f32 value => {
        ok = put_f64(state, value)
      }
      f64 value => {
        ok = put_f64(state, value)
      }
      bool value => {
        ok = put_bool(state, value)
      }
      i8 value => {
        ok = put_i64(state, value)
      }
      i16 value => {
        ok = put_i64(state, value)
      }
      i32 value => {
        ok = put_i64(state, value)
      }
      i64 value => {
        ok = put_i64(state, value)
      }
      isize value => {
        ok = put_i64(state, value)
      }
      u8 value => {
        ok = put_u64(state, value)
      }
      u16 value => {
        ok = put_u64(state, value)
      }
      u32 value => {
        ok = put_u64(state, value)
      }
      u64 value => {
        ok = put_u64(state, value)
      }
      usize value => {
        ok = put_u64(state, value)
      }
      []const u8 value => {
        ok = put(state, value)
      }
      []u8 value => {
        ok = put(state, value)
      }
      _ => {
        ok = false
      }
    }
    if !ok {
      state.length = start
      return false
    }
  }
  return true
}

fn put_values(state: *Buffer, values: ...any) bool {
  return put_arguments(state, values)
}

// Rounded decimal formatting, not a shortest-roundtrip serialization format.
// Up to 15 fractional digits; trailing zeroes are removed. Very small/large
// magnitudes use a decimal exponent. Failure returns an empty slice.
fn f64_decimal_into(destination: []u8, value: f64, precision: usize) []u8 {
  if precision > 15 {
    return destination[..0]
  }
  scratch: [64]u8
  state := buffer(scratch[..])
  bits := #bitcast(u64, value)
  negative := (bits >> 63) != 0
  exponent_bits := (bits >> 52) & 2047
  fraction_bits := bits & 4503599627370495
  if exponent_bits == 2047 && fraction_bits != 0 {
    _ = put(&state, "nan")
  } else {
    if negative {
      _ = put_byte(&state, '-')
    }
    if exponent_bits == 2047 {
      _ = put(&state, "inf")
    } else {
      magnitude := value
      if negative {
        magnitude = -magnitude
      }
      scale: u64 = 1
      for i in 0..precision {
        scale *= 10
      }
      scientific := magnitude != 0.0 && (magnitude < 0.000001 || magnitude * #cast(f64, scale) >= 1000000000000000000.0)
      exponent: i64 = 0
      if scientific {
        for magnitude >= 10.0 {
          magnitude /= 10.0
          exponent += 1
        }
        for magnitude < 1.0 {
          magnitude *= 10.0
          exponent -= 1
        }
      }
      scaled := magnitude * #cast(f64, scale)
      rounded := #cast(u64, scaled)
      if scaled - #cast(f64, rounded) >= 0.5 {
        rounded += 1
      }
      if scientific && rounded >= 10 * scale {
        rounded /= 10
        exponent += 1
      }
      _ = put_u64(&state, rounded / scale)
      fraction := rounded % scale
      if fraction != 0 {
        digits := precision
        for fraction % 10 == 0 {
          fraction /= 10
          digits -= 1
        }
        fraction_storage: [20]u8
        rendered := u64_decimal_into(fraction_storage[..], fraction)
        _ = put_byte(&state, '.')
        _ = put_padding(&state, '0', digits - #len(rendered))
        _ = put(&state, rendered)
      }
      if scientific {
        _ = put_byte(&state, 'e')
        _ = put_i64(&state, exponent)
      }
    }
  }
  if state.length > #len(destination) {
    return destination[..0]
  }
  index: usize = 0
  for index < state.length {
    destination[index] = scratch[index]
    index += 1
  }
  return destination[..state.length]
}

fn put_f64(state: *Buffer, value: f64) bool {
  storage: [64]u8
  return put(state, f64_decimal_into(storage[..], value, 6))
}

fn put_u64_width(state: *Buffer, value: u64, width: usize, padding: u8) bool {
  storage: [20]u8
  rendered := u64_decimal_into(storage[..], value)
  length := #len(rendered)
  if width > length {
    length = width
  }
  if state.failed || state.length > #len(state.data) || length > remaining(state) {
    state.failed = true
    return false
  }
  _ = put_padding(state, padding, length - #len(rendered))
  return put(state, rendered)
}

fn copy_out(arena: *mem.Arena, text: []const u8) []u8 {
  output := mem.push_bytes_uninit(arena, #len(text))
  _ = mem.copy(output, text)
  return output
}

// value in base 2 through 36. Panics on another base.
pub fn u64_base(arena: *mem.Arena, value: u64, base: u8, uppercase: bool) []u8 {
  storage: [64]u8
  return copy_out(arena, u64_base_into(storage[..], value, base, uppercase))
}

pub fn u64_decimal(arena: *mem.Arena, value: u64) []u8 {
  storage: [20]u8
  return copy_out(arena, u64_decimal_into(storage[..], value))
}

pub fn i64_decimal(arena: *mem.Arena, value: i64) []u8 {
  storage: [20]u8
  return copy_out(arena, i64_decimal_into(storage[..], value))
}

// Rounded decimal with up to 15 fractional digits; trailing zeroes are
// removed. Very small or large magnitudes use a decimal exponent. Not a
// shortest-roundtrip format. Panics when precision is above 15.
pub fn f64_decimal(arena: *mem.Arena, value: f64, precision: usize) []u8 {
  if precision > 15 {
    #panic("fmt.f64_decimal: precision above 15")
  }
  storage: [64]u8
  return copy_out(arena, f64_decimal_into(storage[..], value, precision))
}

// Sticky writes: each does nothing once the buffer has failed, and a value
// that does not fit sets failed and leaves the buffer as it was.
pub fn write(state: *Buffer, value: []const u8) {
  _ = put(state, value)
}
pub fn write_byte(state: *Buffer, value: u8) {
  _ = put_byte(state, value)
}
pub fn write_u64(state: *Buffer, value: u64) {
  _ = put_u64(state, value)
}
pub fn write_i64(state: *Buffer, value: i64) {
  _ = put_i64(state, value)
}
pub fn write_bool(state: *Buffer, value: bool) {
  _ = put_bool(state, value)
}
pub fn write_f64(state: *Buffer, value: f64) {
  _ = put_f64(state, value)
}
pub fn write_f64_shortest(state: *Buffer, value: f64) {
  _ = put_f64_shortest(state, value)
}
pub fn write_padding(state: *Buffer, byte: u8, amount: usize) {
  _ = put_padding(state, byte, amount)
}
pub fn write_quoted(state: *Buffer, value: []const u8) {
  _ = put_quoted(state, value)
}
pub fn write_u64_width(state: *Buffer, value: u64, width: usize, padding: u8) {
  _ = put_u64_width(state, value, width, padding)
}
// Each value in turn, as print would insert it; a value with no text form
// fails the write.
pub fn write_values(state: *Buffer, values: ...any) {
  _ = put_arguments(state, values)
}

// Formats template into the buffer: {} inserts the next argument, {{ and }}
// write braces. A literal template is checked by the compiler; a run-time
// template that does not match prints {?} for a missing value and {+value}
// for an extra one, as io.print does. Sticky like the other writes.
pub fn print(state: *Buffer, template: []const u8, arguments: ...any) {
  print_arguments(state, template, arguments)
}

pub fn print_arguments(state: *Buffer, template: []const u8, arguments: []const any) {
  if state.failed {
    return
  }
  start := state.length
  next_argument: usize = 0
  index: usize = 0
  span_start: usize = 0
  ok := true
  for ok && index < #len(template) {
    byte := template[index]
    if byte != '{' && byte != '}' {
      index += 1
      continue
    }
    ok = put(state, template[span_start..index])
    following: u8 = 0
    if index + 1 < #len(template) {
      following = template[index + 1]
    }
    step: usize = 1
    if byte == '{' && following == '}' {
      step = 2
      if next_argument < #len(arguments) {
        ok = ok && put_value(state, arguments[next_argument])
        next_argument += 1
      } else {
        ok = ok && put(state, "{?}")
      }
    } else {
      if following == byte {
        step = 2
      }
      ok = ok && put(state, template[index..index + 1])
    }
    index += step
    span_start = index
  }
  if ok && span_start < #len(template) {
    ok = put(state, template[span_start..])
  }
  for ok && next_argument < #len(arguments) {
    ok = put(state, " {+") && put_value(state, arguments[next_argument]) && put(state, "}")
    next_argument += 1
  }
  if !ok {
    state.length = start
    state.failed = true
  }
}

fn put_value(state: *Buffer, value: any) bool {
  one: [1]any = [value]
  if put_arguments(state, one[..]) {
    return true
  }
  // put_arguments rolled back; a type with no text form prints a marker.
  return !state.failed && put(state, "{?}")
}
