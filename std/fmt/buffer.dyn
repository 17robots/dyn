pub struct Buffer {
  data: []u8,
  length: usize,
}

pub fn buffer(destination: []u8) Buffer {
  return Buffer{ data: destination, length: 0 }
}

pub fn buffer_remaining(state: *const Buffer) usize {
  if state.length > #len(state.data) { return 0 }
  return #len(state.data) - state.length
}
pub fn buffer_clear(state: *Buffer) { state.length = 0 }

pub fn buffer_append(state: *Buffer, value: []const u8) bool {
  if state.length > #len(state.data) || #len(value) > #len(state.data) - state.length { return false }
  i: usize = 0
  for i < #len(value) {
    state.data[state.length + i] = value[i]
    i += 1
  }
  state.length += #len(value)
  return true
}

fn append_count(state: *Buffer, value: []const u8) isize {
  if !buffer_append(state, value) { return -1 }
  return #cast(isize) #len(value)
}

pub fn buffer_bytes(state: *const Buffer) []const u8 {
  return state.data[..state.length]
}
