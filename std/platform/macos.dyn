module macos

linux := use "std/platform/linux"
Allocator := (use "std/mem").Allocator
ns_get_argc := extern () *i32 = "_NSGetArgc"
ns_get_argv := extern () ***u8 = "_NSGetArgv"

pub open_readonly := (path: *any) i32 => linux.open_readonly(path)
pub close := (fd: i32) i32 => linux.close(fd)
pub read := (fd: i32, buf: *any, len: usize) isize => linux.read(fd, buf, len)
pub write := (fd: i32, buf: *any, len: usize) isize => linux.write(fd, buf, len)
pub getenv := (name: *any) ?*any => linux.getenv(name)
pub fork := () i32 => linux.fork()
pub execvp := (file: *any, argv: *any) i32 => linux.execvp(file, argv)
pub waitpid := (pid: i32, status: *i32, options: i32) i32 => linux.waitpid(pid, status, options)
pub exit := (code: i32) { linux.exit(code); return }
pub wexitstatus := (status: i32) i32 => linux.wexitstatus(status)
pub spawn_process := (file: *any, argv: *any) i32 => linux.spawn_process(file, argv)
pub path_sep := () u8 => linux.path_sep()
pub path_is_abs := (path: []u8) u1 => linux.path_is_abs(path)
pub path_dirname := (path: []u8) []u8 => linux.path_dirname(path)
pub path_basename := (path: []u8) []u8 => linux.path_basename(path)
pub path_join := (base: []u8, part: []u8, alloc: Allocator) ?[]u8 => linux.path_join(base, part, alloc)
pub process_args := (alloc: Allocator) ?[][]u8 {
    argc_ptr := ns_get_argc()
    argv_ptr_ptr := ns_get_argv()
    argc := argc_ptr.*
    if argc <= 0 {
        return .{ ptr: $as(*[]u8, $as(usize, 1)), len: 0 }
    }

    argv := argv_ptr_ptr.*
    count := $as(usize, argc)
    bytes := count * $as(usize, $sizeof([]u8))
    raw_parts := alloc.alloc(bytes, $as(usize, $alignof([]u8))) or return null
    out: [][]u8 = .{ ptr: $as(*[]u8, raw_parts), len: count }

    mut i: usize = 0
    for i < count: {
        arg_ptr := argv[i]
        mut len: usize = 0
        for arg_ptr[len] != 0: {
            len += 1
        }
        raw_part := alloc.alloc(len, $as(usize, $alignof(u8))) or return null
        part: []u8 = .{ ptr: $as(*u8, raw_part), len: len }
        mut j: usize = 0
        for j < len: {
            part[j] = arg_ptr[j]
            j += 1
        }
        out[i] = part
        i += 1
    }
    return out
}
