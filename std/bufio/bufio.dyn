use "std/io"
// The first error is sticky; later writes and flushes transfer nothing.
pub struct Writer {
  destination: io.Writer,
  storage: []u8,
  used: usize,
  error: isize,
  kind: io.Kind,
}

pub fn writer(destination: io.Writer, storage: []u8) Writer {
  return Writer{ destination: destination, storage: storage }
}

pub fn writer_buffered(state: *const Writer) usize {
  return state.used
}

pub fn writer_flush(state: *Writer) io.Transfer {
  if state.kind != io.Kind.Ok {
    return io.Transfer{ transferred: 0, failure: io.Failure{ kind: state.kind, native: state.error } }
  }
  if state.used > #len(state.storage) {
    state.error = -22
    state.kind = io.Kind.InvalidInput
    return io.Transfer{ failure: io.Failure{ kind: state.kind, native: state.error } }
  }
  if state.used == 0 {
    return io.Transfer{ transferred: 0, status: io.Status.Complete, failure: io.Failure{ native: 0 } }
  }
  result := io.write_all(state.destination, state.storage[..state.used])
  if io.failed(result.failure) {
    state.error = result.failure.native
    state.kind = result.failure.kind
    pending := state.used - result.transferred
    for i in 0..pending {
      state.storage[i] = state.storage[result.transferred + i]
    }
    state.used = pending
    return result
  }
  state.used = 0
  return result
}

fn writer_write(data: rawptr, source: []const u8) io.Transfer {
  state := #cast(*Writer, data)
  if state.kind != io.Kind.Ok {
    return io.Transfer{ transferred: 0, failure: io.Failure{ kind: state.kind, native: state.error } }
  }
  if state.used > #len(state.storage) {
    state.error = -22
    state.kind = io.Kind.InvalidInput
    return io.Transfer{ failure: io.Failure{ kind: state.kind, native: state.error } }
  }
  if #len(state.storage) == 0 {
    result := io.write_all(state.destination, source)
    if io.failed(result.failure) {
      state.error = result.failure.native
      state.kind = result.failure.kind
    }
    return result
  }
  total: usize = 0
  for total < #len(source) {
    if state.used == #len(state.storage) {
      flushed := writer_flush(state)
      if io.failed(flushed.failure) {
        return io.Transfer{ transferred: total, failure: io.Failure{ kind: flushed.failure.kind, native: flushed.failure.native } }
      }
    }
    // Large writes need no staging copy when the buffer is empty. Preserve the
    // final partial/full tail so the buffered byte count stays unchanged.
    if state.used == 0 && #len(source) - total > #len(state.storage) {
      amount := ((#len(source) - total - 1) / #len(state.storage)) * #len(state.storage)
      direct := io.write_all(state.destination, source[total..total + amount])
      total += direct.transferred
      if io.failed(direct.failure) {
        state.error = direct.failure.native
        state.kind = direct.failure.kind
        return io.Transfer{ transferred: total, failure: io.Failure{ kind: direct.failure.kind, native: direct.failure.native } }
      }
    }
    available := #len(state.storage) - state.used
    amount := #len(source) - total
    if amount > available {
      amount = available
    }
    for i in 0..amount {
      state.storage[state.used + i] = source[total + i]
    }
    state.used += amount
    total += amount
  }
  return io.Transfer{ transferred: total, status: io.Status.Complete, failure: io.Failure{ native: 0 } }
}

pub fn writer_adapter(state: *Writer) io.Writer {
  return io.Writer{ data: state, write: writer_write }
}

// Storage and the underlying source are borrowed; both must outlive Reader.
// The first error is sticky; later reads consume nothing, including buffered bytes.
pub struct Reader {
  source: io.Reader,
  storage: []u8,
  start: usize,
  end: usize,
  ended: bool,
  error: isize,
  kind: io.Kind,
  pending: [2]u8,
  pending_count: usize,
}

pub fn reader(source: io.Reader, storage: []u8) Reader {
  return Reader{ source: source, storage: storage }
}

fn reader_read(data: rawptr, destination: []u8) io.Transfer {
  state := #cast(*Reader, data)
  if state.kind != io.Kind.Ok {
    return io.Transfer{ failure: io.Failure{ kind: state.kind, native: state.error } }
  }
  if state.start > state.end || state.end > #len(state.storage) || state.pending_count > 2 {
    state.kind = io.Kind.InvalidState
    return io.Transfer{ failure: io.Failure{ kind: state.kind, native: state.error } }
  }
  total: usize = 0
  for total < #len(destination) {
    if state.pending_count > 0 {
      destination[total] = state.pending[0]
      state.pending[0] = state.pending[1]
      state.pending_count -= 1
      total += 1
      continue
    }
    if state.start == state.end {
      if state.kind != io.Kind.Ok {
        return io.Transfer{ transferred: total, failure: io.Failure{ kind: state.kind, native: state.error } }
      }
      if state.ended {
        return io.Transfer{ transferred: total, status: io.Status.End }
      }
      if #len(state.storage) == 0 {
        direct := io.read(state.source, destination[total..])
        if (direct.status == io.Status.Complete && !io.failed(direct.failure)) && direct.transferred == 0 {
          direct.failure.kind = io.Kind.System
        }
        if io.failed(direct.failure) {
          state.error = direct.failure.native
          state.kind = direct.failure.kind
        }
        if direct.status == io.Status.End {
          state.ended = true
        }
        direct.transferred += total
        return direct
      }
      input := io.read(state.source, state.storage)
      state.start = 0
      state.end = input.transferred
      if io.failed(input.failure) {
        state.error = input.failure.native
        state.kind = input.failure.kind
      }
      if input.status == io.Status.End {
        state.ended = true
      }
      if input.transferred == 0 && (input.status == io.Status.Complete && !io.failed(input.failure)) {
        state.kind = io.Kind.System
      }
      continue
    }
    available := state.end - state.start
    amount := #len(destination) - total
    if amount > available {
      amount = available
    }
    for i in 0..amount {
      destination[total + i] = state.storage[state.start + i]
    }
    state.start += amount
    total += amount
  }
  return io.Transfer{ transferred: total, status: io.Status.Complete }
}

pub fn reader_adapter(state: *Reader) io.Reader {
  return io.Reader{ data: state, read: reader_read }
}

// More means the record continues past destination; failure is separate.
pub enum ReadStatus { Complete, End, More }
pub struct ReadResult {
  transferred: usize,
  failure: io.Failure,
  status: ReadStatus,
}

fn unread(state: *Reader, byte: u8) {
  state.pending[1] = state.pending[0]
  state.pending[0] = byte
  state.pending_count += 1
}

fn read_record(state: *Reader, destination: []u8, delimiter: u8, line: bool) ReadResult {
  if state.kind != io.Kind.Ok {
    return ReadResult{ failure: io.Failure{ kind: state.kind, native: state.error } }
  }
  if #len(destination) == 0 {
    return ReadResult{ status: ReadStatus.More }
  }
  total: usize = 0
  byte: [1]u8
  for {
    input := io.read(reader_adapter(state), byte[..])
    if input.transferred == 0 {
      if io.failed(input.failure) {
        return ReadResult{ transferred: total, failure: input.failure }
      }
      return ReadResult{ transferred: total, status: ReadStatus.End }
    }
    // A source may return bytes alongside an error or EOF. This call may
    // consume returned bytes; a sticky error stops subsequent reads.
    if byte[0] == delimiter {
      return ReadResult{ transferred: total, status: ReadStatus.Complete }
    }
    if line && byte[0] == 13 {
      next: [1]u8
      peek := io.read(reader_adapter(state), next[..])
      if peek.transferred > 0 {
        if next[0] == 10 {
          return ReadResult{ transferred: total, status: ReadStatus.Complete }
        }
        unread(state, next[0])
      }
    }
    if total == #len(destination) {
      unread(state, byte[0])
      return ReadResult{ transferred: total, status: ReadStatus.More }
    }
    destination[total] = byte[0]
    total += 1
  }
  return ReadResult{ transferred: total, failure: io.Failure{ kind: io.Kind.System } }
}

// Consume and exclude delimiter. More means continue this same record with
// another buffer; End may include a final unterminated fragment. No allocation.
pub fn read_until(state: *Reader, destination: []u8, delimiter: u8) ReadResult {
  return read_record(state, destination, delimiter, false)
}

// Accept LF and CRLF; preserve lone CR. A zero-length destination returns More
// without consuming input unless an earlier error is being reported.
// Returned bytes live in the caller's destination.
pub fn read_line(state: *Reader, destination: []u8) ReadResult {
  return read_record(state, destination, 10, true)
}
