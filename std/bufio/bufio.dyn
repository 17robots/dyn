use "std/io"
use "std/fail"
// Buffered streams. Failures go in the caller's *fail.Status, like every
// call that can fail; the buffers keep no failure of their own, so a fresh
// status can retry a flush whose bytes are still buffered.

// Collects small writes in storage and passes them on in large ones. Call
// writer_flush when done; what is still buffered is not written.
pub struct Writer {
  destination: io.Writer,
  storage: []u8,
  used: usize,
}

pub fn writer(destination: io.Writer, storage: []u8) Writer {
  return Writer{ destination: destination, storage: storage }
}

pub fn writer_buffered(state: *const Writer) usize {
  return state.used
}

// Writes everything buffered. On a failure the bytes stay buffered.
pub fn writer_flush(status: *fail.Status, state: *Writer) {
  if status == nil {
    writer_flush(&fail.Status{}, state)
    return
  }
  if status.failed || state.used == 0 { return }
  if state.used > state.storage.len {
    fail.set(status, fail.make(fail.Kind.InvalidState, "flush", "", "buffered count is past the storage"))
    return
  }
  io.write_status(status, state.destination, state.storage[..state.used])
  if !status.failed {
    state.used = 0
  }
}

fn writer_write(data: rawptr, source: []const u8) usize!io.IoErr {
  status: fail.Status
  count := writer_write_status(data, &status, source)
  try io.check_status(&status)
  return count
}
fn writer_write_status(data: rawptr, status: *fail.Status, source: []const u8) usize {
  state := #cast(*Writer, data)
  if state.used > state.storage.len {
    fail.set(status, fail.make(fail.Kind.InvalidState, "write", "", "buffered count is past the storage"))
    return 0
  }
  if state.storage.len == 0 {
    io.write_status(status, state.destination, source)
    if status.failed { return 0 }
    return source.len
  }
  total: usize = 0
  for total < source.len {
    if state.used == state.storage.len {
      writer_flush(status, state)
      if status.failed { return total }
    }
    // Large writes need no staging copy when the buffer is empty. Keep the
    // final partial or full tail buffered so the buffered count stays the same.
    if state.used == 0 && source.len - total > state.storage.len {
      amount := ((source.len - total - 1) / state.storage.len) * state.storage.len
      io.write_status(status, state.destination, source[total..total + amount])
      if status.failed { return total }
      total += amount
    }
    available := state.storage.len - state.used
    amount := source.len - total
    if amount > available {
      amount = available
    }
    for i in 0..amount {
      state.storage[state.used + i] = source[total + i]
    }
    state.used += amount
    total += amount
  }
  return total
}

pub fn writer_adapter(state: *Writer) io.Writer {
  return io.Writer{ data: state, write: writer_write }
}

// Reads source a buffer at a time. Storage and the source are borrowed; both
// must outlive the Reader.
pub struct Reader {
  source: io.Reader,
  storage: []u8,
  start: usize,
  end: usize,
  // The source reported its end.
  input_done: bool,
  pending: [2]u8,
  pending_count: usize,
  // Set by a read_line call that returns no line: at the end of the input,
  // or after a failure.
  ended: bool,
  // read_line is dropping the rest of a line too long for storage.
  skipping: bool,
}

pub fn reader(source: io.Reader, storage: []u8) Reader {
  return Reader{ source: source, storage: storage }
}

fn reader_read(data: rawptr, destination: []u8) usize!io.IoErr {
  status: fail.Status
  count := reader_read_status(data, &status, destination)
  try io.check_status(&status)
  return count
}
fn reader_read_status(data: rawptr, status: *fail.Status, destination: []u8) usize {
  state := #cast(*Reader, data)
  if state.start > state.end || state.end > state.storage.len || state.pending_count > 2 {
    fail.set(status, fail.make(fail.Kind.InvalidState, "read", "", "buffer positions are out of range"))
    return 0
  }
  total: usize = 0
  for total < destination.len {
    if state.pending_count > 0 {
      destination[total] = state.pending[0]
      state.pending[0] = state.pending[1]
      state.pending_count -= 1
      total += 1
      continue
    }
    if state.start == state.end {
      if state.input_done || status.failed { return total }
      // With bytes in hand, return them rather than wait for more.
      if total > 0 { return total }
      if state.storage.len == 0 {
        count := io.read_status(status, state.source, destination[total..])
        if count == 0 {
          state.input_done = !status.failed
        }
        return total + count
      }
      count := io.read_status(status, state.source, state.storage)
      state.start = 0
      state.end = count
      if count == 0 {
        state.input_done = !status.failed
      }
      continue
    }
    available := state.end - state.start
    amount := destination.len - total
    if amount > available {
      amount = available
    }
    for i in 0..amount {
      destination[total + i] = state.storage[state.start + i]
    }
    state.start += amount
    total += amount
  }
  return total
}

pub fn reader_adapter(state: *Reader) io.Reader {
  return io.Reader{ data: state, read: reader_read }
}

// How a record read ended: at its delimiter (Complete), at the end of the
// input (End, possibly with a final unterminated fragment), or because
// destination filled first (More: continue the same record with another
// buffer).
pub enum ReadStatus { Complete, End, More }
pub struct ReadResult {
  transferred: usize,
  status: ReadStatus,
}

fn unread(state: *Reader, byte: u8) {
  state.pending[1] = state.pending[0]
  state.pending[0] = byte
  state.pending_count += 1
}

fn read_record(status: *fail.Status, state: *Reader, destination: []u8, delimiter: u8) ReadResult {
  if status.failed { return ReadResult{ status: ReadStatus.End } }
  if destination.len == 0 { return ReadResult{ status: ReadStatus.More } }
  total: usize = 0
  byte: [1]u8
  for {
    if io.read_status(status, reader_adapter(state), byte[..]) == 0 {
      return ReadResult{ transferred: total, status: ReadStatus.End }
    }
    if byte[0] == delimiter { return ReadResult{ transferred: total, status: ReadStatus.Complete } }
    if total == destination.len {
      unread(state, byte[0])
      return ReadResult{ transferred: total, status: ReadStatus.More }
    }
    destination[total] = byte[0]
    total += 1
  }
  return ReadResult{ transferred: total, status: ReadStatus.End }
}

// Reads up to delimiter, which is consumed and left out. More means continue
// this same record with another buffer; End may include a final unterminated
// fragment, and also comes after a failure. No allocation.
pub fn read_until(status: *fail.Status, state: *Reader, destination: []u8, delimiter: u8) ReadResult {
  if status == nil { return read_until(&fail.Status{}, state, destination, delimiter) }
  return read_record(status, state, destination, delimiter)
}

// The next line, without its LF or CRLF; a lone CR is kept. The line borrows
// the reader's storage until the next read. At the end of the input, and
// after a failure, it sets state.ended and returns "". A final line without
// a line break is still returned. A line longer than the storage fails with
// Capacity, and the next call, given a fresh status, continues after it.
pub fn read_line(status: *fail.Status, state: *Reader) []const u8 {
  if status == nil { return read_line(&fail.Status{}, state) }
  state.ended = false
  if status.failed { return line_ended(state) }
  if state.start > state.end || state.end > state.storage.len || state.pending_count > 2 {
    fail.set(status, fail.make(fail.Kind.InvalidState, "read line", "", "buffer positions are out of range"))
    return line_ended(state)
  }
  if state.storage.len == 0 {
    fail.set(status, fail.make(fail.Kind.InvalidInput, "read line", "", "the reader has no storage"))
    return line_ended(state)
  }
  if state.pending_count > 0 {
    // Bytes read_until put back go in front of the buffered ones.
    compact(state)
    if state.end + state.pending_count > state.storage.len { return line_too_long(status, state) }
    at := state.end
    for at > 0 {
      at -= 1
      state.storage[at + state.pending_count] = state.storage[at]
    }
    for i in 0..state.pending_count {
      state.storage[i] = state.pending[i]
    }
    state.end += state.pending_count
    state.pending_count = 0
  }
  scanned := state.start
  for {
    for state.skipping && state.start < state.end {
      if state.storage[state.start] == 10 {
        state.skipping = false
      }
      state.start += 1
      scanned = state.start
    }
    for !state.skipping && scanned < state.end {
      if state.storage[scanned] == 10 {
        line_end := scanned
        if line_end > state.start && state.storage[line_end - 1] == 13 {
          line_end -= 1
        }
        line := state.storage[state.start..line_end]
        state.start = scanned + 1
        return line
      }
      scanned += 1
    }
    if state.input_done {
      if state.skipping || state.start == state.end { return line_ended(state) }
      last := state.storage[state.start..state.end]
      state.start = state.end
      return last
    }
    scanned -= state.start
    compact(state)
    if state.end == state.storage.len { return line_too_long(status, state) }
    count := io.read_status(status, state.source, state.storage[state.end..])
    if status.failed { return line_ended(state) }
    if count == 0 {
      state.input_done = true
    }
    state.end += count
  }
  return line_ended(state)
}

fn line_ended(state: *Reader) []const u8 {
  state.ended = true
  return ""
}

fn line_too_long(status: *fail.Status, state: *Reader) []const u8 {
  state.start = state.end
  state.skipping = true
  fail.set(status, fail.make(fail.Kind.Capacity, "read line", "", "the line is longer than the reader's storage"))
  return line_ended(state)
}

// Moves the buffered bytes to the front of storage.
fn compact(state: *Reader) {
  if state.start == 0 { return }
  count := state.end - state.start
  for i in 0..count {
    state.storage[i] = state.storage[state.start + i]
  }
  state.start = 0
  state.end = count
}
