use "std/io"
// Buffered streams. Calls fail with io.IoErr; the buffers keep no failure of
// their own, so a flush whose bytes are still buffered can be retried.
// Positions past the storage are a bug and panic.

// Collects small writes in storage and passes them on in large ones. Call
// writer_flush when done; what is still buffered is not written.
pub struct Writer {
  destination: io.Writer,
  storage: []u8,
  used: usize,
}

pub fn writer(destination: io.Writer, storage: []u8) Writer {
  return Writer{ destination: destination, storage: storage }
}

pub fn writer_buffered(state: *const Writer) usize {
  return state.used
}

// Writes everything buffered. On a failure the bytes stay buffered.
pub fn writer_flush(state: *Writer) !io.IoErr {
  if state.used == 0 { return }
  if state.used > state.storage.len { #panic("bufio: buffered count is past the storage") }
  try io.write(state.destination, state.storage[..state.used])
  state.used = 0
}

fn writer_write(data: rawptr, source: []const u8) usize!io.IoErr {
  state := #cast(*Writer, data)
  if state.used > state.storage.len { #panic("bufio: buffered count is past the storage") }
  if state.storage.len == 0 {
    try io.write(state.destination, source)
    return source.len
  }
  total: usize = 0
  for total < source.len {
    if state.used == state.storage.len {
      try writer_flush(state)
    }
    // Large writes need no staging copy when the buffer is empty. Keep the
    // final partial or full tail buffered so the buffered count stays the same.
    if state.used == 0 && source.len - total > state.storage.len {
      amount := ((source.len - total - 1) / state.storage.len) * state.storage.len
      try io.write(state.destination, source[total..total + amount])
      total += amount
    }
    available := state.storage.len - state.used
    amount := source.len - total
    if amount > available {
      amount = available
    }
    for i in 0..amount {
      state.storage[state.used + i] = source[total + i]
    }
    state.used += amount
    total += amount
  }
  return total
}

pub fn writer_adapter(state: *Writer) io.Writer {
  return io.Writer{ data: state, write: writer_write }
}

// Reads source a buffer at a time. Storage and the source are borrowed; both
// must outlive the Reader.
pub struct Reader {
  source: io.Reader,
  storage: []u8,
  start: usize,
  end: usize,
  // The source reported its end.
  input_done: bool,
  pending: [2]u8,
  pending_count: usize,
  // Set by a read_line call that returns no line: at the end of the input,
  // or after a failure.
  ended: bool,
  // read_line is dropping the rest of a line too long for storage.
  skipping: bool,
}

pub fn reader(source: io.Reader, storage: []u8) Reader {
  return Reader{ source: source, storage: storage }
}

fn check_positions(state: *const Reader) {
  if state.start > state.end || state.end > state.storage.len || state.pending_count > 2 {
    #panic("bufio: buffer positions are out of range")
  }
}

fn reader_read(data: rawptr, destination: []u8) usize!io.IoErr {
  state := #cast(*Reader, data)
  check_positions(state)
  total: usize = 0
  for total < destination.len {
    if state.pending_count > 0 {
      destination[total] = state.pending[0]
      state.pending[0] = state.pending[1]
      state.pending_count -= 1
      total += 1
      continue
    }
    if state.start == state.end {
      if state.input_done { return total }
      // With bytes in hand, return them rather than wait for more.
      if total > 0 { return total }
      if state.storage.len == 0 {
        count := try io.read(state.source, destination[total..])
        if count == 0 {
          state.input_done = true
        }
        return total + count
      }
      count := try io.read(state.source, state.storage)
      state.start = 0
      state.end = count
      if count == 0 {
        state.input_done = true
      }
      continue
    }
    available := state.end - state.start
    amount := destination.len - total
    if amount > available {
      amount = available
    }
    for i in 0..amount {
      destination[total + i] = state.storage[state.start + i]
    }
    state.start += amount
    total += amount
  }
  return total
}

pub fn reader_adapter(state: *Reader) io.Reader {
  return io.Reader{ data: state, read: reader_read }
}

// How a record read ended: at its delimiter (Complete), at the end of the
// input (End, possibly with a final unterminated fragment), or because
// destination filled first (More: continue the same record with another
// buffer).
pub enum ReadStatus { Complete, End, More }
pub struct ReadResult {
  transferred: usize,
  status: ReadStatus,
}

fn unread(state: *Reader, byte: u8) {
  state.pending[1] = state.pending[0]
  state.pending[0] = byte
  state.pending_count += 1
}

fn read_record(state: *Reader, destination: []u8, delimiter: u8) ReadResult!io.IoErr {
  if destination.len == 0 { return ReadResult{ status: ReadStatus.More } }
  total: usize = 0
  byte: [1]u8
  for {
    if try io.read(reader_adapter(state), byte[..]) == 0 {
      return ReadResult{ transferred: total, status: ReadStatus.End }
    }
    if byte[0] == delimiter { return ReadResult{ transferred: total, status: ReadStatus.Complete } }
    if total == destination.len {
      unread(state, byte[0])
      return ReadResult{ transferred: total, status: ReadStatus.More }
    }
    destination[total] = byte[0]
    total += 1
  }
  return ReadResult{ transferred: total, status: ReadStatus.End }
}

// Reads up to delimiter, which is consumed and left out. More means continue
// this same record with another buffer; End may include a final unterminated
// fragment. No allocation.
pub fn read_until(state: *Reader, destination: []u8, delimiter: u8) ReadResult!io.IoErr {
  return try read_record(state, destination, delimiter)
}

// The next line, without its LF or CRLF; a lone CR is kept. The line borrows
// the reader's storage until the next read. At the end of the input it sets
// state.ended and returns "". A final line without a line break is still
// returned. A line longer than the storage fails with Capacity, and the next
// call continues after it. A reader with no storage fails with InvalidInput.
pub fn read_line(state: *Reader) []const u8!io.IoErr {
  state.ended = false
  check_positions(state)
  if state.storage.len == 0 { fail .InvalidInput }
  if state.pending_count > 0 {
    // Bytes read_until put back go in front of the buffered ones.
    compact(state)
    if state.end + state.pending_count > state.storage.len { fail line_too_long(state) }
    at := state.end
    for at > 0 {
      at -= 1
      state.storage[at + state.pending_count] = state.storage[at]
    }
    for i in 0..state.pending_count {
      state.storage[i] = state.pending[i]
    }
    state.end += state.pending_count
    state.pending_count = 0
  }
  scanned := state.start
  for {
    for state.skipping && state.start < state.end {
      if state.storage[state.start] == 10 {
        state.skipping = false
      }
      state.start += 1
      scanned = state.start
    }
    for !state.skipping && scanned < state.end {
      if state.storage[scanned] == 10 {
        line_end := scanned
        if line_end > state.start && state.storage[line_end - 1] == 13 {
          line_end -= 1
        }
        line := state.storage[state.start..line_end]
        state.start = scanned + 1
        return line
      }
      scanned += 1
    }
    if state.input_done {
      if state.skipping || state.start == state.end { return line_ended(state) }
      last := state.storage[state.start..state.end]
      state.start = state.end
      return last
    }
    scanned -= state.start
    compact(state)
    if state.end == state.storage.len { fail line_too_long(state) }
    count := try io.read(state.source, state.storage[state.end..])
    if count == 0 {
      state.input_done = true
    }
    state.end += count
  }
  return line_ended(state)
}

fn line_ended(state: *Reader) []const u8 {
  state.ended = true
  return ""
}

// Drops the rest of a line longer than the storage.
fn line_too_long(state: *Reader) io.IoErr {
  state.start = state.end
  state.skipping = true
  return io.IoErr.Capacity
}

// Moves the buffered bytes to the front of storage.
fn compact(state: *Reader) {
  if state.start == 0 { return }
  count := state.end - state.start
  for i in 0..count {
    state.storage[i] = state.storage[state.start + i]
  }
  state.start = 0
  state.end = count
}
