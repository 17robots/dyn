use "std/time"

pub enum LogLevel { Debug, Info, Warning, Error }

pub struct Logger { minimum: LogLevel, timestamps: bool }

pub fn logger(minimum: LogLevel) Logger {
  return Logger{ minimum: minimum, timestamps: false }
}

pub fn logger_timestamps(minimum: LogLevel) Logger {
  return Logger{ minimum: minimum, timestamps: true }
}

fn level_name(level: LogLevel) []const u8 {
  if level == LogLevel.Debug { return "debug" }
  if level == LogLevel.Info { return "info" }
  if level == LogLevel.Warning { return "warning" }
  return "error"
}

fn level_enabled(level: LogLevel, minimum: LogLevel) bool {
  if minimum == LogLevel.Debug { return true }
  if minimum == LogLevel.Info { return level != LogLevel.Debug }
  if minimum == LogLevel.Warning { return level == LogLevel.Warning || level == LogLevel.Error }
  return level == LogLevel.Error
}

pub fn log(target: *Logger, level: LogLevel, arguments: ...any) isize {
  if !level_enabled(level, target.minimum) { return 0 }
  total: isize = 0
  result: isize = 0
  if target.timestamps {
    now := time.realtime_now()
    result = write("[")
    if result < 0 { return result }
    total += result
    storage: [20]u8 = []
    result = write(fmt.i64_to_bytes(storage[..], now.seconds))
    if result < 0 { return result }
    total += result
    result = write("] ")
    if result < 0 { return result }
    total += result
  }
  result = write(level_name(level))
  if result < 0 { return result }
  total += result
  result = write(": ")
  if result < 0 { return result }
  total += result
  result = print_arguments(1, arguments)
  if result < 0 { return result }
  total += result
  result = write("\n")
  if result < 0 { return result }
  return total + result
}

pub fn info(message: []const u8) {
  print("info: ")
  println(message)
}

pub fn error(message: []const u8) {
  _ = write_error("error: ")
  _ = write_error(message)
  _ = write_error("\n")
}
