pub struct Reader {
  descriptor: isize,
  storage: []u8,
  start: usize,
  end: usize,
  error: isize,
  eof: bool,
}

pub struct LineResult {
  length: usize,
  error: isize,
  ok: bool,
  eof: bool,
}

pub struct Writer {
  descriptor: isize,
  storage: []u8,
  length: usize,
  error: isize,
}

pub fn reader(descriptor: isize, storage: []u8) Reader {
  if #len(storage) == 0 { #panic("reader requires storage") }
  return Reader{ descriptor: descriptor, storage: storage, start: 0, end: 0, error: 0, eof: false }
}

fn reader_fill(state: *Reader) bool {
  if state.start < state.end { return true }
  if state.eof || state.error != 0 { return false }
  result := read_descriptor(state.descriptor, state.storage)
  state.start = 0
  state.end = 0
  if result < 0 { state.error = result return false }
  if result == 0 { state.eof = true return false }
  state.end = #cast(usize) result
  return true
}

pub fn read_byte(state: *Reader, output: *u8) bool {
  if !reader_fill(state) { return false }
  output.* = state.storage[state.start]
  state.start += 1
  return true
}

pub fn reader_read_exact(state: *Reader, destination: []u8) LineResult {
  length: usize = 0
  for length < #len(destination) {
    if !reader_fill(state) {
      return LineResult{ length: length, error: state.error, ok: false, eof: state.eof }
    }
    available := state.end - state.start
    take := #len(destination) - length
    if take > available { take = available }
    i: usize = 0
    for i < take { destination[length + i] = state.storage[state.start + i] i += 1 }
    state.start += take
    length += take
  }
  return LineResult{ length: length, error: 0, ok: true, eof: false }
}

// Delimiter is consumed, not copied. Same capacity/error contract as read_line.
pub fn read_until(state: *Reader, destination: []u8, delimiter: u8) LineResult {
  length: usize = 0
  for {
    byte: u8 = 0
    if !read_byte(state, &byte) {
      return LineResult{ length: length, error: state.error, ok: length > 0 && state.error == 0, eof: state.eof }
    }
    if byte == delimiter { return LineResult{ length: length, error: 0, ok: true, eof: false } }
    if length == #len(destination) { return LineResult{ length: length, error: -28, ok: false, eof: false } }
    destination[length] = byte
    length += 1
  }
  return LineResult{ length: length, error: 0, ok: false, eof: true }
}

// Newline is consumed, not copied. ok=false means error or destination full.
pub fn read_line(state: *Reader, destination: []u8) LineResult {
  length: usize = 0
  for {
    if length == #len(destination) {
      if !reader_fill(state) {
        if state.error != 0 { return LineResult{ length: length, error: state.error, ok: false, eof: false } }
        return LineResult{ length: length, error: 0, ok: true, eof: true }
      }
      if state.storage[state.start] == 10 {
        state.start += 1
        return LineResult{ length: length, error: 0, ok: true, eof: false }
      }
      return LineResult{ length: length, error: -28, ok: false, eof: false }
    }
    byte: u8 = 0
    if !read_byte(state, &byte) {
      if state.error != 0 { return LineResult{ length: length, error: state.error, ok: false, eof: false } }
      return LineResult{ length: length, error: 0, ok: length > 0, eof: true }
    }
    if byte == 10 { return LineResult{ length: length, error: 0, ok: true, eof: false } }
    destination[length] = byte
    length += 1
  }
  return LineResult{ length: length, error: 0, ok: false, eof: true }
}

pub fn writer(descriptor: isize, storage: []u8) Writer {
  if #len(storage) == 0 { #panic("writer requires storage") }
  return Writer{ descriptor: descriptor, storage: storage, length: 0, error: 0 }
}

pub fn writer_bytes(state: *const Writer) []const u8 { return state.storage[..state.length] }

pub fn writer_append(state: *Writer, bytes: []const u8) bool {
  if state.error != 0 || state.length > #len(state.storage) || #len(bytes) > #len(state.storage) - state.length { return false }
  i: usize = 0
  for i < #len(bytes) {
    state.storage[state.length + i] = bytes[i]
    i += 1
  }
  state.length += #len(bytes)
  return true
}

pub fn writer_flush(state: *Writer) bool {
  if state.error != 0 || state.length > #len(state.storage) { return false }
  result := write_descriptor(state.descriptor, state.storage[..state.length])
  if result < 0 { state.error = result return false }
  state.length = 0
  return true
}

pub fn copy_descriptors(source: isize, destination: isize, scratch: []u8) isize {
  if #len(scratch) == 0 { return -22 }
  total: isize = 0
  for {
    count := read_descriptor(source, scratch)
    if count < 0 { return count }
    if count == 0 { return total }
    result := write_descriptor(destination, scratch[..#cast(usize) count])
    if result < 0 { return result }
    total += result
  }
  return total
}
