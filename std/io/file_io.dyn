pub fn read_descriptor(descriptor: isize, destination: []u8) isize {
  if #len(destination) == 0 { return 0 }
  result := #syscall(0, descriptor, &destination[0], #len(destination))
  for result == -4 {
    result = #syscall(0, descriptor, &destination[0], #len(destination))
  }
  return result
}

pub fn write_descriptor(descriptor: isize, source: []const u8) isize {
  if #len(source) == 0 { return 0 }
  written: usize = 0
  for written < #len(source) {
    result := #syscall(1, descriptor, &source[written], #len(source) - written)
    if result != -4 {
      if result <= 0 { return result }
      written += #cast(usize) result
    }
  }
  return #cast(isize) written
}

pub fn close_descriptor(descriptor: isize) isize { return #syscall(3, descriptor) }

pub fn seek_descriptor(descriptor: isize, offset: isize, origin: isize) isize {
  return #syscall(8, descriptor, offset, origin)
}

pub fn duplicate_descriptor(descriptor: isize) isize { return #syscall(32, descriptor) }

pub fn read_exact(descriptor: isize, destination: []u8) isize {
  read: usize = 0
  for read < #len(destination) {
    result := read_descriptor(descriptor, destination[read..])
    if result < 0 { return result }
    if result == 0 { return #cast(isize) read }
    read += #cast(usize) result
  }
  return #cast(isize) read
}
