module io

str := use "std/str"

pub Writer := struct {
    ctx: *any,
    write_fn: (ctx: *any, buf: []u8) usize,
}

pub write_uint := (w: Writer, n: u64) {
    buf: [32]u8 = [0]
    text := str.uint_to_buf(n, buf[..])
    _ = w.write_all(text)
    return
}

pub write_int := (w: Writer, n: i64) {
    buf: [32]u8 = [0]
    text := str.int_to_buf(n, buf[..])
    _ = w.write_all(text)
    return
}

pub write_float := (w: Writer, n: f64) {
    buf: [64]u8 = [0]
    text := str.float_to_buf(n, buf[..])
    _ = w.write_all(text)
    return
}

pub write_hex := (w: Writer, n: u64) {
    buf: [32]u8 = [0]
    text := str.uint_to_hex_buf(n, buf[..])
    _ = w.write_all(text)
    return
}

pub write_hex_upper := (w: Writer, n: u64) {
    buf: [32]u8 = [0]
    text := str.uint_to_hex_buf(n, buf[..])
    mut i: usize = 0
    for i < text.len: {
        ch := text[i]
        if ch >= 'a' && ch <= 'f' {
            text[i] = $as(u8, $as(u64, ch) - $as(u64, 'a') + $as(u64, 'A'))
        }
        i += 1
    }
    _ = w.write_all(text)
    return
}

pub Writer.write_byte := (self: Writer, byte: u8) usize {
    buf: [1]u8 = [byte]
    return self.write_fn(self.ctx, buf[..])
}

pub Writer.write_all := (self: Writer, buf: []u8) usize {
    return self.write_fn(self.ctx, buf)
}

pub Writer.print := (self: Writer, v: any) {
    _v := v
    self.write_all("<value>")
    return
}

pub Writer.println := (self: Writer, v: any) {
    self.print(v)
    self.write_byte('\n')
    return
}
