#target(kernel: linux)

// Borrow the process standard descriptors; callers do not own or close them.
fn stdin_read(data: rawptr, destination: []u8) Result {
  _ = data
  if #len(destination) == 0 {
    return Result{ transferred: 0, error: 0, status: Status.Complete }
  }
  value := #syscall(0, 0, &destination[0], #len(destination))
  for value == -4 { value = #syscall(0, 0, &destination[0], #len(destination)) }
  if value < 0 { return Result{ transferred: 0, error: value, kind: errors.linux(value), status: Status.Error } }
  status := Status.Complete
  if value == 0 { status = Status.End }
  return Result{ transferred: #cast(usize) value, error: 0, status: status }
}

fn write_descriptor(descriptor: isize, source: []const u8) Result {
  written: usize = 0
  for written < #len(source) {
    value := #syscall(1, descriptor, &source[written], #len(source) - written)
    if value == -4 { }
    else if value <= 0 {
      if value == 0 { value = -5 }
      return Result{ transferred: written, error: value, kind: errors.linux(value), status: Status.Error }
    }
    else { written += #cast(usize) value }
  }
  return Result{ transferred: written, error: 0, status: Status.Complete }
}
fn stdout_write(data: rawptr, source: []const u8) Result {
  _ = data
  return write_descriptor(1, source)
}

fn stderr_write(data: rawptr, source: []const u8) Result {
  _ = data
  return write_descriptor(2, source)
}

pub fn stdin() Reader { return Reader{ data: nil, read: &stdin_read } }
pub fn stdout() Writer { return Writer{ data: nil, write: &stdout_write } }
pub fn stderr() Writer { return Writer{ data: nil, write: &stderr_write } }

