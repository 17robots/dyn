#target(kernel: linux)
use "std/fail"
use "std/os/linux/sys"

// Borrow the process standard descriptors; callers do not own or close them.
pub fn stdin() Reader {
  return Reader{ data: nil, read: stdin_stream }
}
pub fn stdout() Writer {
  return Writer{ data: nil, write: stdout_stream }
}
pub fn stderr() Writer {
  return Writer{ data: nil, write: stderr_stream }
}

fn stdin_stream(_data: rawptr, status: *fail.Status, destination: []u8) usize {
  if status.failed || destination.len == 0 { return 0 }
  value := #syscall(sys.Read, 0, &destination[0], destination.len)
  for value == -4 {
    value = #syscall(sys.Read, 0, &destination[0], destination.len)
  }
  if value < 0 {
    fail.set(status, from_linux("read", "standard input", value))
    return 0
  }
  return #cast(usize, value)
}

fn write_descriptor(status: *fail.Status, descriptor: isize, path: []const u8, source: []const u8) usize {
  if status.failed { return 0 }
  written: usize = 0
  for written < source.len {
    value := #syscall(sys.Write, descriptor, &source[written], source.len - written)
    if value == -4 { } else if value <= 0 {
      if value == 0 {
        value = -5
      }
      fail.set(status, from_linux("write", path, value))
      return written
    } else {
      written += #cast(usize, value)
    }
  }
  return written
}
fn stdout_stream(_data: rawptr, status: *fail.Status, source: []const u8) usize {
  return write_descriptor(status, 1, "standard output", source)
}
fn stderr_stream(_data: rawptr, status: *fail.Status, source: []const u8) usize {
  return write_descriptor(status, 2, "standard error", source)
}
