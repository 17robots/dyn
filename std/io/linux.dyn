#target(kernel: linux)
use "std/os/linux/sys"

// Borrow the process standard descriptors; callers do not own or close them.
fn stdin_read(_data: rawptr, destination: []u8) Transfer {
  if #len(destination) == 0 {
    return Transfer{ transferred: 0, status: Status.Complete, failure: Failure{ native: 0 } }
  }
  value := #syscall(sys.Read, 0, &destination[0], #len(destination))
  for value == -4 {
    value = #syscall(sys.Read, 0, &destination[0], #len(destination))
  }
  if value < 0 {
    return Transfer{ transferred: 0, failure: Failure{ kind: linux(value), native: value } }
  }
  status := Status.Complete
  if value == 0 {
    status = Status.End
  }
  return Transfer{ transferred: #cast(usize, value), status: status, failure: Failure{ native: 0 } }
}

fn write_descriptor(descriptor: isize, source: []const u8) Transfer {
  written: usize = 0
  for written < #len(source) {
    value := #syscall(sys.Write, descriptor, &source[written], #len(source) - written)
    if value == -4 { } else if value <= 0 {
      if value == 0 {
        value = -5
      }
      return Transfer{ transferred: written, failure: Failure{ kind: linux(value), native: value } }
    } else {
      written += #cast(usize, value)
    }
  }
  return Transfer{ transferred: written, status: Status.Complete, failure: Failure{ native: 0 } }
}
fn stdout_write(_data: rawptr, source: []const u8) Transfer {
  return write_descriptor(1, source)
}

fn stderr_write(_data: rawptr, source: []const u8) Transfer {
  return write_descriptor(2, source)
}

pub fn stdin() Reader {
  return Reader{ data: nil, read: stdin_read }
}
pub fn stdout() Writer {
  return Writer{ data: nil, write: stdout_write }
}
pub fn stderr() Writer {
  return Writer{ data: nil, write: stderr_write }
}

// Terminal output. These ignore write failures, such as a closed pipe, so a
// call needs no `_ =`; use print_to or println_to to check the result.



