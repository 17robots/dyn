#target(kernel: linux)
use "std/os/linux/sys"

// Borrow the process standard descriptors; callers do not own or close them.
pub fn stdin() Reader {
  return Reader{ data: nil, read: stdin_stream }
}
pub fn stdout() Writer {
  return Writer{ data: nil, write: stdout_stream }
}
pub fn stderr() Writer {
  return Writer{ data: nil, write: stderr_stream }
}

fn stdin_stream(_data: rawptr, destination: []u8) usize!IoErr {
  if destination.len == 0 { return 0 }
  value := #syscall(sys.Read, 0, &destination[0], destination.len)
  for value == -4 {
    value = #syscall(sys.Read, 0, &destination[0], destination.len)
  }
  if value < 0 { fail linux_err(value) }
  return #cast(usize, value)
}

// Partial progress before an error is lost: the call fails.
fn write_descriptor(descriptor: isize, source: []const u8) usize!IoErr {
  written: usize = 0
  for written < source.len {
    value := #syscall(sys.Write, descriptor, &source[written], source.len - written)
    if value == -4 { } else if value <= 0 {
      if value == 0 {
        value = -5
      }
      fail linux_err(value)
    } else {
      written += #cast(usize, value)
    }
  }
  return written
}
fn stdout_stream(_data: rawptr, source: []const u8) usize!IoErr {
  return try write_descriptor(1, source)
}
fn stderr_stream(_data: rawptr, source: []const u8) usize!IoErr {
  return try write_descriptor(2, source)
}

fn system_text(code: isize) []const u8 {
  return linux_text(code)
}
