// Portable categories accompany (and never replace) the original native code.
// A library validation failure may have no native code. Test kind/ok/status first.
pub struct Failure { kind: Kind, native: isize }
// A value and how getting it went. value is always safe to read: zero or a
// documented partial result on failure.
pub struct Result(T) { value: T, failure: Failure }
pub type Bytes = Result([]u8)
pub type Count = Result(usize)

pub enum Kind { Ok, InvalidInput, InvalidState, NotFound, PermissionDenied, AlreadyExists, Capacity, Overflow, Interrupted, WouldBlock, Unsupported, System }

// Whether a step failed. Kind.Ok is the zero value, so a zero Failure succeeded.
pub fn failed(failure: Failure) bool {
  return failure.kind != Kind.Ok
}
// For APIs that only say whether they worked: Kind.System when failed, zero
// otherwise. Keep any native code the API gave in a field of its own.
pub fn failure_if(failed: bool) Failure {
  if failed {
    return Failure{ kind: Kind.System }
  }
  return Failure{}
}
// A native error code with its portable kind; 0 is success.
pub fn linux_failure(code: isize) Failure {
  return Failure{ kind: linux(code), native: code }
}
pub fn darwin_failure(code: isize) Failure {
  return Failure{ kind: darwin(code), native: code }
}
pub fn windows_failure(code: isize) Failure {
  return Failure{ kind: windows(code), native: code }
}
pub fn wasi_failure(code: isize) Failure {
  return Failure{ kind: wasi(code), native: code }
}

pub fn linux(code: isize) Kind {
  if code == 0 {
    return Kind.Ok
  }
  value := code
  if value == #min(isize) {
    return Kind.System
  }
  if value < 0 {
    value = 0 - value
  }
  if value == 2 || value == 20 {
    return Kind.NotFound
  }
  if value == 1 || value == 13 {
    return Kind.PermissionDenied
  }
  if value == 17 {
    return Kind.AlreadyExists
  }
  if value == 9 {
    return Kind.InvalidState
  }
  if value == 22 || value == 36 {
    return Kind.InvalidInput
  }
  if value == 12 || value == 28 {
    return Kind.Capacity
  }
  if value == 27 || value == 75 {
    return Kind.Overflow
  }
  if value == 4 {
    return Kind.Interrupted
  }
  if value == 11 {
    return Kind.WouldBlock
  }
  if value == 38 || value == 95 {
    return Kind.Unsupported
  }
  return Kind.System
}
pub fn windows(code: isize) Kind {
  if code == 0 {
    return Kind.Ok
  }
  value := code
  if value == #min(isize) {
    return Kind.System
  }
  if value < 0 {
    value = 0 - value
  }
  if value == 2 || value == 3 {
    return Kind.NotFound
  }
  if value == 5 || value == 32 || value == 33 {
    return Kind.PermissionDenied
  }
  if value == 80 || value == 183 {
    return Kind.AlreadyExists
  }
  if value == 6 {
    return Kind.InvalidState
  }
  if value == 87 || value == 123 || value == 206 || value == 1113 {
    return Kind.InvalidInput
  }
  if value == 8 || value == 14 || value == 112 || value == 122 {
    return Kind.Capacity
  }
  if value == 534 {
    return Kind.Overflow
  }
  if value == 995 {
    return Kind.Interrupted
  }
  if value == 232 || value == 997 {
    return Kind.WouldBlock
  }
  if value == 1 || value == 50 || value == 120 {
    return Kind.Unsupported
  }
  return Kind.System
}
pub fn wasi(code: isize) Kind {
  if code == 0 {
    return Kind.Ok
  }
  value := code
  if value == #min(isize) {
    return Kind.System
  }
  if value < 0 {
    value = 0 - value
  }
  if value == 44 || value == 54 {
    return Kind.NotFound
  }
  if value == 2 || value == 63 || value == 76 {
    return Kind.PermissionDenied
  }
  if value == 20 {
    return Kind.AlreadyExists
  }
  if value == 8 {
    return Kind.InvalidState
  }
  if value == 28 || value == 37 {
    return Kind.InvalidInput
  }
  if value == 48 || value == 51 {
    return Kind.Capacity
  }
  if value == 22 || value == 61 {
    return Kind.Overflow
  }
  if value == 27 {
    return Kind.Interrupted
  }
  if value == 6 {
    return Kind.WouldBlock
  }
  if value == 52 || value == 58 {
    return Kind.Unsupported
  }
  return Kind.System
}

pub fn darwin(code: isize) Kind {
  value := code
  if value == #min(isize) {
    return Kind.System
  }
  if value < 0 {
    value = 0 - value
  }
  if value == 35 || value == 36 {
    return Kind.WouldBlock
  }
  if value == 45 || value == 78 {
    return Kind.Unsupported
  }
  if value == 63 {
    return Kind.InvalidInput
  }
  if value == 84 {
    return Kind.Overflow
  }
  // Other common categories have the same values as Linux's base errno set.
  if value == 11 || value == 38 || value == 75 || value == 95 {
    return Kind.System
  }
  return linux(code)
}
