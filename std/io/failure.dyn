use "std/fail"
// A failure always fails: a native code of zero (as GetLastError or errno can
// report) is a System failure.
fn failed_kind(kind: fail.Kind) fail.Kind {
  if kind == fail.Kind.Ok { return fail.Kind.System }
  return kind
}
// A fail.Failure for a native error code: its portable kind, the code in
// native, and the system's text for it as the message. operation and path
// say what was being done, as in fail.make.
pub fn from_linux(operation: []const u8, path: []const u8, code: isize) fail.Failure {
  failure := fail.make(failed_kind(linux(code)), operation, path, linux_text(code))
  failure.native = code
  return failure
}
pub fn from_darwin(operation: []const u8, path: []const u8, code: isize) fail.Failure {
  failure := fail.make(failed_kind(darwin(code)), operation, path, darwin_text(code))
  failure.native = code
  return failure
}
pub fn from_windows(operation: []const u8, path: []const u8, code: isize) fail.Failure {
  failure := fail.make(failed_kind(windows(code)), operation, path, windows_text(code))
  failure.native = code
  return failure
}
pub fn from_wasi(operation: []const u8, path: []const u8, code: isize) fail.Failure {
  failure := fail.make(failed_kind(wasi(code)), operation, path, wasi_text(code))
  failure.native = code
  return failure
}

pub fn linux(code: isize) fail.Kind {
  if code == 0 { return fail.Kind.Ok }
  value := code
  if value == #min(isize) { return fail.Kind.System }
  if value < 0 {
    value = 0 - value
  }
  if value == 2 || value == 20 { return fail.Kind.NotFound }
  if value == 1 || value == 13 { return fail.Kind.PermissionDenied }
  if value == 17 { return fail.Kind.AlreadyExists }
  if value == 9 { return fail.Kind.InvalidState }
  if value == 22 || value == 36 { return fail.Kind.InvalidInput }
  if value == 12 || value == 28 { return fail.Kind.Capacity }
  if value == 27 || value == 75 { return fail.Kind.Overflow }
  if value == 4 { return fail.Kind.Interrupted }
  if value == 11 { return fail.Kind.WouldBlock }
  if value == 38 || value == 95 { return fail.Kind.Unsupported }
  return fail.Kind.System
}
pub fn windows(code: isize) fail.Kind {
  if code == 0 { return fail.Kind.Ok }
  value := code
  if value == #min(isize) { return fail.Kind.System }
  if value < 0 {
    value = 0 - value
  }
  if value == 2 || value == 3 { return fail.Kind.NotFound }
  if value == 5 || value == 32 || value == 33 { return fail.Kind.PermissionDenied }
  if value == 80 || value == 183 { return fail.Kind.AlreadyExists }
  if value == 6 { return fail.Kind.InvalidState }
  if value == 87 || value == 123 || value == 206 || value == 1113 { return fail.Kind.InvalidInput }
  if value == 8 || value == 14 || value == 112 || value == 122 { return fail.Kind.Capacity }
  if value == 534 { return fail.Kind.Overflow }
  if value == 995 { return fail.Kind.Interrupted }
  if value == 232 || value == 997 { return fail.Kind.WouldBlock }
  if value == 1 || value == 50 || value == 120 { return fail.Kind.Unsupported }
  return fail.Kind.System
}
pub fn wasi(code: isize) fail.Kind {
  if code == 0 { return fail.Kind.Ok }
  value := code
  if value == #min(isize) { return fail.Kind.System }
  if value < 0 {
    value = 0 - value
  }
  if value == 44 || value == 54 { return fail.Kind.NotFound }
  if value == 2 || value == 63 || value == 76 { return fail.Kind.PermissionDenied }
  if value == 20 { return fail.Kind.AlreadyExists }
  if value == 8 { return fail.Kind.InvalidState }
  if value == 28 || value == 37 { return fail.Kind.InvalidInput }
  if value == 48 || value == 51 { return fail.Kind.Capacity }
  if value == 22 || value == 61 { return fail.Kind.Overflow }
  if value == 27 { return fail.Kind.Interrupted }
  if value == 6 { return fail.Kind.WouldBlock }
  if value == 52 || value == 58 { return fail.Kind.Unsupported }
  return fail.Kind.System
}

pub fn darwin(code: isize) fail.Kind {
  value := code
  if value == #min(isize) { return fail.Kind.System }
  if value < 0 {
    value = 0 - value
  }
  if value == 35 || value == 36 { return fail.Kind.WouldBlock }
  if value == 45 || value == 78 { return fail.Kind.Unsupported }
  if value == 63 { return fail.Kind.InvalidInput }
  if value == 84 { return fail.Kind.Overflow }
  // Other common categories have the same values as Linux's base errno set.
  if value == 11 || value == 38 || value == 75 || value == 95 { return fail.Kind.System }
  return linux(code)
}

// The system's own reason for a native code, such as "is a directory" for
// Linux's -21; empty when the portable kind says enough.
pub fn linux_text(code: isize) []const u8 {
  case magnitude(code) {
    1 => { return "operation not permitted" }
    2 => { return "no such file or directory" }
    5 => { return "input/output error" }
    9 => { return "bad file descriptor" }
    12 => { return "out of memory" }
    13 => { return "permission denied" }
    16 => { return "device or resource busy" }
    17 => { return "already exists" }
    18 => { return "cross-device link" }
    20 => { return "not a directory" }
    21 => { return "is a directory" }
    22 => { return "invalid argument" }
    24 => { return "too many open files" }
    27 => { return "file too large" }
    28 => { return "no space left on device" }
    30 => { return "read-only file system" }
    32 => { return "broken pipe" }
    36 => { return "file name too long" }
    39 => { return "directory not empty" }
    40 => { return "too many levels of symbolic links" }
    98 => { return "address already in use" }
    101 => { return "network is unreachable" }
    104 => { return "connection reset" }
    110 => { return "timed out" }
    111 => { return "connection refused" }
    113 => { return "no route to host" }
    _ => { return "" }
  }
}
pub fn darwin_text(code: isize) []const u8 {
  value := magnitude(code)
  if value <= 34 { return linux_text(code) }
  case value {
    35 => { return "resource temporarily unavailable" }
    48 => { return "address already in use" }
    51 => { return "network is unreachable" }
    54 => { return "connection reset" }
    60 => { return "timed out" }
    61 => { return "connection refused" }
    62 => { return "too many levels of symbolic links" }
    63 => { return "file name too long" }
    65 => { return "no route to host" }
    66 => { return "directory not empty" }
    _ => { return "" }
  }
}
pub fn windows_text(code: isize) []const u8 {
  case magnitude(code) {
    2 => { return "no such file or directory" }
    3 => { return "no such file or directory" }
    5 => { return "permission denied" }
    32 => { return "file is in use" }
    80 => { return "already exists" }
    112 => { return "no space left on device" }
    145 => { return "directory not empty" }
    183 => { return "already exists" }
    206 => { return "file name too long" }
    267 => { return "not a directory" }
    10048 => { return "address already in use" }
    10054 => { return "connection reset" }
    10060 => { return "timed out" }
    10061 => { return "connection refused" }
    _ => { return "" }
  }
}
pub fn wasi_text(code: isize) []const u8 {
  case magnitude(code) {
    2 => { return "permission denied" }
    20 => { return "already exists" }
    31 => { return "is a directory" }
    37 => { return "file name too long" }
    44 => { return "no such file or directory" }
    51 => { return "no space left on device" }
    54 => { return "not a directory" }
    55 => { return "directory not empty" }
    63 => { return "operation not permitted" }
    69 => { return "read-only file system" }
    _ => { return "" }
  }
}
fn magnitude(code: isize) isize {
  if code == #min(isize) { return 0 }
  if code < 0 { return 0 - code }
  return code
}
