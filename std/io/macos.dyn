#target(kernel: darwin)
use "std/os/macos/sys"

// Darwin syscall shim returns negative errno, including EINTR (-4).
// Borrow the process standard descriptors; callers do not own or close them.
fn stdin_read(_data: rawptr, destination: []u8) Transfer {
  if #len(destination) == 0 {
    return Transfer{ transferred: 0, error: 0, status: Status.Complete }
  }
  value := #syscall(sys.Read, 0, &destination[0], #len(destination))
  for value == -4 {
    value = #syscall(sys.Read, 0, &destination[0], #len(destination))
  }
  if value < 0 {
    return Transfer{ transferred: 0, error: value, kind: darwin(value), status: Status.Error }
  }
  status := Status.Complete
  if value == 0 {
    status = Status.End
  }
  return Transfer{ transferred: #cast(usize, value), error: 0, status: status }
}

fn write_descriptor(descriptor: isize, source: []const u8) Transfer {
  written: usize = 0
  for written < #len(source) {
    value := #syscall(sys.Write, descriptor, &source[written], #len(source) - written)
    if value == -4 { } else if value <= 0 {
      if value == 0 {
        value = -5
      }
      return Transfer{ transferred: written, error: value, kind: darwin(value), status: Status.Error }
    } else {
      written += #cast(usize, value)
    }
  }
  return Transfer{ transferred: written, error: 0, status: Status.Complete }
}
fn stdout_write(_data: rawptr, source: []const u8) Transfer {
  return write_descriptor(1, source)
}

fn stderr_write(_data: rawptr, source: []const u8) Transfer {
  return write_descriptor(2, source)
}

pub fn stdin() Reader {
  return Reader{ data: nil, read: stdin_read }
}
pub fn stdout() Writer {
  return Writer{ data: nil, write: stdout_write }
}
pub fn stderr() Writer {
  return Writer{ data: nil, write: stderr_write }
}

// Terminal output. These ignore write failures, such as a closed pipe, so a
// call needs no `_ =`; use print_to or println_to to check the result.
pub fn print(template: []const u8, arguments: ...any) {
  _ = print_arguments(stdout(), template, arguments)
}

pub fn println(template: []const u8, arguments: ...any) {
  _ = println_arguments(stdout(), template, arguments)
}

pub fn eprint(template: []const u8, arguments: ...any) {
  _ = print_arguments(stderr(), template, arguments)
}

pub fn eprintln(template: []const u8, arguments: ...any) {
  _ = println_arguments(stderr(), template, arguments)
}
