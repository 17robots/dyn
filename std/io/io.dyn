use "std/fail"
use memory "std/mem"
use format "std/fmt"
// Byte streams. A Reader or Writer is a data pointer and one function; the
// function takes the caller's *fail.Status and records any failure there,
// like every call that can fail. Adapters borrow their state and never own
// or close it.
//
// A read returns how many bytes it put in destination. Zero means the end of
// the stream, and also comes after a failure: status.failed says which.
pub struct Reader {
  data: rawptr,
  read: fn(rawptr, *fail.Status, []u8) usize,
}
// A write returns how many bytes of source it took, possibly fewer than all;
// io.write keeps calling until everything is written.
pub struct Writer {
  data: rawptr,
  write: fn(rawptr, *fail.Status, []const u8) usize,
}

// Structured I/O error enum for T!IoErr APIs.
pub enum IoErr {
  EndOfStream,
  InvalidState,
  InvalidInput,
  BrokenPipe,
  System(isize),
}

// Reads into destination; the count read, zero at the end of the stream and
// after a failure.
pub fn read(status: *fail.Status, reader: Reader, destination: []u8) usize {
  if status == nil { return read(&fail.Status{}, reader, destination) }
  if status.failed || destination.len == 0 { return 0 }
  if reader.read == nil {
    fail.set(status, fail.make(fail.Kind.InvalidState, "read", "", "reader has no read function"))
    return 0
  }
  count := reader.read(reader.data, status, destination)
  if count > destination.len {
    failure := fail.make(fail.Kind.System, "read", "", "reader returned more bytes than asked for")
    failure.native = -5
    fail.set(status, failure)
    return 0
  }
  return count
}

// Fills destination. Returns #len(destination), or 0 when the stream was
// already at its end; a stream that ends partway is a failure.
pub fn read_exact(status: *fail.Status, reader: Reader, destination: []u8) usize {
  if status == nil { return read_exact(&fail.Status{}, reader, destination) }
  total: usize = 0
  for total < destination.len {
    count := read(status, reader, destination[total..])
    if status.failed { return 0 }
    if count == 0 {
      if total == 0 { return 0 }
      fail.set(status, fail.make(fail.Kind.InvalidInput, "read", "", "stream ended early"))
      return 0
    }
    total += count
  }
  return total
}

// Writes all of source.
pub fn write(status: *fail.Status, writer: Writer, source: []const u8) {
  if status == nil {
    write(&fail.Status{}, writer, source)
    return
  }
  if status.failed || source.len == 0 { return }
  if writer.write == nil {
    fail.set(status, fail.make(fail.Kind.InvalidState, "write", "", "writer has no write function"))
    return
  }
  total: usize = 0
  for total < source.len {
    count := writer.write(writer.data, status, source[total..])
    if status.failed { return }
    if count == 0 || count > source.len - total {
      message: []const u8 = "writer made no progress"
      if count != 0 {
        message = "writer reported more bytes than it was given"
      }
      failure := fail.make(fail.Kind.System, "write", "", message)
      failure.native = -5
      fail.set(status, failure)
      return
    }
    total += count
  }
}

fn print_value(status: *fail.Status, writer: Writer, value: any) {
  storage: [64 + memory.ArenaBufferOverhead]u8
  scratch := memory.arena_from_buffer(storage[..])
  case value {
    f32(item) => {
      write(status, writer, format.f64_decimal(scratch, item, 6))
    }
    f64(item) => {
      write(status, writer, format.f64_decimal(scratch, item, 6))
    }
    bool(item) => {
      if item {
        write(status, writer, "true")
      } else {
        write(status, writer, "false")
      }
    }
    i8(item) => {
      write(status, writer, format.i64_decimal(scratch, item))
    }
    i16(item) => {
      write(status, writer, format.i64_decimal(scratch, item))
    }
    i32(item) => {
      write(status, writer, format.i64_decimal(scratch, item))
    }
    i64(item) => {
      write(status, writer, format.i64_decimal(scratch, item))
    }
    isize(item) => {
      write(status, writer, format.i64_decimal(scratch, item))
    }
    u8(item) => {
      write(status, writer, format.u64_decimal(scratch, item))
    }
    u16(item) => {
      write(status, writer, format.u64_decimal(scratch, item))
    }
    u32(item) => {
      write(status, writer, format.u64_decimal(scratch, item))
    }
    u64(item) => {
      write(status, writer, format.u64_decimal(scratch, item))
    }
    usize(item) => {
      write(status, writer, format.u64_decimal(scratch, item))
    }
    []u8(item) => {
      write(status, writer, item)
    }
    []const u8(item) => {
      write(status, writer, item)
    }
    _ => {
      // Structs and plain enums print through fmt, which reads their
      // TypeInfo; a type with no text form prints as a marker rather than
      // ending the line.
      text: [1024]u8
      rendering: fail.Status
      rendered := format.buffer(&rendering, text[..])
      format.write_value(&rendered, value)
      if rendering.failed || format.bytes(&rendered).len == 0 {
        write(status, writer, "{?}")
      } else {
        write(status, writer, format.bytes(&rendered))
      }
    }
  }
}

// print_arguments is the non-variadic entry point used by forwarding wrappers.
// The format language is intentionally small: {} inserts a value; {{ and }}
// write literal braces. dyn vet checks a literal template's {} count. A
// template made at run time that does not match its arguments still prints:
// a {} with no argument prints {?}, a lone brace prints as itself, and each
// extra argument prints at the end as {+value}. The result then reports
// InvalidInput with everything that was written.
pub fn print_arguments(status: *fail.Status, writer: Writer, template: []const u8, arguments: []const any) {
  if status == nil {
    print_arguments(&fail.Status{}, writer, template, arguments)
    return
  }
  if status.failed { return }
  argument_index: usize = 0
  mismatch := false
  span_start: usize = 0
  index: usize = 0
  for index < template.len {
    byte := template[index]
    if byte != '{' && byte != '}' {
      index += 1
      continue
    }
    if span_start < index {
      write(status, writer, template[span_start..index])
    }
    next: u8 = 0
    if index + 1 < template.len {
      next = template[index + 1]
    }
    piece := template[index..index + 1]
    step: usize = 1
    if byte == '{' && next == '}' {
      step = 2
      if argument_index < arguments.len {
        print_value(status, writer, arguments[argument_index])
        argument_index += 1
        piece = ""
      } else {
        mismatch = true
        piece = "{?}"
      }
    } else if next == byte {
      step = 2
    } else {
      mismatch = true
    }
    if piece.len > 0 {
      write(status, writer, piece)
    }
    index += step
    span_start = index
  }
  if span_start < template.len {
    write(status, writer, template[span_start..])
  }
  for argument_index < arguments.len {
    mismatch = true
    write(status, writer, " {+")
    print_value(status, writer, arguments[argument_index])
    write(status, writer, "}")
    argument_index += 1
  }
  if mismatch {
    fail.set(status, fail.make(fail.Kind.InvalidInput, "print", "", "template does not match its arguments"))
  }
}

// Checked formatting to any writer: {} takes the next argument.
pub fn print_to(status: *fail.Status, writer: Writer, template: []const u8, arguments: ...any) {
  print_arguments(status, writer, template, arguments)
}

// Terminal output, print/println/eprint/eprintln, lives with stdout() in each
// platform file; targets without standard streams have neither.

// Like print_arguments, then a newline. A template that did not match its
// arguments still prints its line before the failure is recorded.
pub fn println_arguments(status: *fail.Status, writer: Writer, template: []const u8, arguments: []const any) {
  if status == nil {
    println_arguments(&fail.Status{}, writer, template, arguments)
    return
  }
  if status.failed { return }
  line: fail.Status
  print_arguments(&line, writer, template, arguments)
  if line.failed && line.failure.kind != fail.Kind.InvalidInput {
    fail.set(status, line.failure)
    return
  }
  write(status, writer, "\n")
  fail.set(status, line.failure)
}

pub fn println_to(status: *fail.Status, writer: Writer, template: []const u8, arguments: ...any) {
  println_arguments(status, writer, template, arguments)
}

// Copies reader to writer until the end of the reader, through scratch;
// the count copied.
pub fn copy(status: *fail.Status, writer: Writer, reader: Reader, scratch: []u8) usize {
  if status == nil { return copy(&fail.Status{}, writer, reader, scratch) }
  if status.failed { return 0 }
  if scratch.len == 0 {
    fail.set(status, fail.make(fail.Kind.InvalidInput, "copy", "", "scratch buffer is empty"))
    return 0
  }
  total: usize = 0
  for {
    count := read(status, reader, scratch)
    if count == 0 { break }
    write(status, writer, scratch[..count])
    if status.failed { break }
    total += count
  }
  if status.failed { return 0 }
  return total
}

// Copies exactly amount bytes; a reader that ends first is a failure.
pub fn copy_n(status: *fail.Status, writer: Writer, reader: Reader, amount: usize, scratch: []u8) {
  if status == nil {
    copy_n(&fail.Status{}, writer, reader, amount, scratch)
    return
  }
  if status.failed || amount == 0 { return }
  if scratch.len == 0 {
    fail.set(status, fail.make(fail.Kind.InvalidInput, "copy", "", "scratch buffer is empty"))
    return
  }
  total: usize = 0
  for total < amount && !status.failed {
    take := amount - total
    if take > scratch.len {
      take = scratch.len
    }
    count := read_exact(status, reader, scratch[..take])
    if count == 0 && !status.failed {
      fail.set(status, fail.make(fail.Kind.InvalidInput, "copy", "", "stream ended early"))
    }
    write(status, writer, scratch[..count])
    total += count
  }
}

pub struct Cursor {
  data: []const u8,
  offset: usize,
}

pub fn cursor(data: []const u8) Cursor {
  return Cursor{ data: data, offset: 0 }
}

fn cursor_read(data: rawptr, status: *fail.Status, destination: []u8) usize {
  state := #cast(*Cursor, data)
  if state.offset > state.data.len {
    fail.set(status, fail.make(fail.Kind.InvalidState, "read", "", "cursor offset is past its data"))
    return 0
  }
  remaining := state.data.len - state.offset
  take := remaining
  if destination.len < take {
    take = destination.len
  }
  for i in 0..take {
    destination[i] = state.data[state.offset + i]
  }
  state.offset += take
  return take
}

pub fn cursor_reader(state: *Cursor) Reader {
  return Reader{ data: state, read: cursor_read }
}

pub struct BufferWriter {
  data: []u8,
  length: usize,
}

pub fn buffer_writer(storage: []u8) BufferWriter {
  return BufferWriter{ data: storage, length: 0 }
}

pub fn buffer_writer_bytes(state: *const BufferWriter) []const u8 {
  return state.data[..state.length]
}

pub fn buffer_writer_reset(state: *BufferWriter) {
  state.length = 0
}

fn buffer_write(data: rawptr, status: *fail.Status, source: []const u8) usize {
  state := #cast(*BufferWriter, data)
  if state.length > state.data.len {
    fail.set(status, fail.make(fail.Kind.InvalidState, "write", "", "buffer length is past its storage"))
    return 0
  }
  remaining := state.data.len - state.length
  take := source.len
  if remaining < take {
    take = remaining
  }
  for i in 0..take {
    state.data[state.length + i] = source[i]
  }
  state.length += take
  if take != source.len {
    fail.set(status, fail.make(fail.Kind.Capacity, "write", "", "buffer is full"))
  }
  return take
}

pub fn buffer_writer_adapter(state: *BufferWriter) Writer {
  return Writer{ data: state, write: buffer_write }
}
