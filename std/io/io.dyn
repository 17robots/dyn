use "std/fail"
use memory "std/mem"
use format "std/fmt"
// Byte streams. A Reader or Writer is a data pointer and one function that
// fails with an IoErr. Adapters borrow their state and never own or close it.
//
// A read returns how many bytes it put in destination. Zero means the end of
// the stream.
pub struct Reader {
  data: rawptr,
  read: fn(rawptr, []u8) usize!IoErr,
}
// A write returns how many bytes of source it took, possibly fewer than all;
// io.write keeps calling until everything is written.
pub struct Writer {
  data: rawptr,
  write: fn(rawptr, []const u8) usize!IoErr,
}

// Why an I/O call failed, shared by std/io, std/fs, std/net and
// std/process. System carries the system's own code when no other variant
// fits; it is negative (the errno, or the Windows error, negated).
pub enum IoErr {
  NotFound,
  PermissionDenied,
  AlreadyExists,
  InvalidInput,
  WouldBlock,
  Interrupted,
  Unsupported,
  Capacity,
  System(isize),
}

// What err means, such as "not found"; for System, the system's own text
// for its code when there is one.
pub fn text(err: IoErr) []const u8 {
  case err {
    .NotFound => { return "not found" }
    .PermissionDenied => { return "permission denied" }
    .AlreadyExists => { return "already exists" }
    .InvalidInput => { return "invalid input" }
    .WouldBlock => { return "would block" }
    .Interrupted => { return "interrupted" }
    .Unsupported => { return "unsupported" }
    .Capacity => { return "too large or out of space" }
    .System(code) => {
      reason := system_text(code)
      if reason.len == 0 { return "system error" }
      return reason
    }
  }
}

// Reads into destination; the count read, zero at the end of the stream.
// A zero Reader fails with InvalidInput.
pub fn read(reader: Reader, destination: []u8) usize!IoErr {
  if destination.len == 0 { return 0 }
  // A zero Reader has no read function.
  if reader.read == nil { fail .InvalidInput }
  count := try reader.read(reader.data, destination)
  // A reader that claims more than it was given is broken: EIO.
  if count > destination.len { fail IoErr.System(-5) }
  return count
}

// Fills destination. Returns destination.len, or 0 when the stream was
// already at its end; a stream that ends partway fails with InvalidInput.
pub fn read_exact(reader: Reader, destination: []u8) usize!IoErr {
  total: usize = 0
  for total < destination.len {
    count := try read(reader, destination[total..])
    if count == 0 {
      if total == 0 { return 0 }
      fail .InvalidInput
    }
    total += count
  }
  return total
}

// Writes all of source. A zero Writer fails with InvalidInput.
pub fn write(writer: Writer, source: []const u8) !IoErr {
  if source.len == 0 { return }
  // A zero Writer has no write function.
  if writer.write == nil { fail .InvalidInput }
  total: usize = 0
  for total < source.len {
    count := try writer.write(writer.data, source[total..])
    // No progress, or more than it was given: EIO.
    if count == 0 || count > source.len - total { fail IoErr.System(-5) }
    total += count
  }
}

fn print_value(writer: Writer, value: any) !IoErr {
  storage: [64 + memory.ArenaBufferOverhead]u8
  scratch := memory.arena_from_buffer(storage[..])
  case value {
    f32(item) => { try write(writer, format.f64_decimal(scratch, item, 6)) }
    f64(item) => { try write(writer, format.f64_decimal(scratch, item, 6)) }
    bool(item) => {
      if item {
        try write(writer, "true")
      } else {
        try write(writer, "false")
      }
    }
    i8(item) => { try write(writer, format.i64_decimal(scratch, item)) }
    i16(item) => { try write(writer, format.i64_decimal(scratch, item)) }
    i32(item) => { try write(writer, format.i64_decimal(scratch, item)) }
    i64(item) => { try write(writer, format.i64_decimal(scratch, item)) }
    isize(item) => { try write(writer, format.i64_decimal(scratch, item)) }
    u8(item) => { try write(writer, format.u64_decimal(scratch, item)) }
    u16(item) => { try write(writer, format.u64_decimal(scratch, item)) }
    u32(item) => { try write(writer, format.u64_decimal(scratch, item)) }
    u64(item) => { try write(writer, format.u64_decimal(scratch, item)) }
    usize(item) => { try write(writer, format.u64_decimal(scratch, item)) }
    []u8(item) => { try write(writer, item) }
    []const u8(item) => { try write(writer, item) }
    IoErr(item) => { try write(writer, text(item)) }
    _ => {
      // Structs and plain enums print through fmt, which reads their
      // TypeInfo; a type with no text form prints as a marker rather than
      // ending the line.
      text: [1024]u8
      rendering: fail.Status
      rendered := format.buffer(&rendering, text[..])
      format.write_value(&rendered, value)
      if rendering.failed || format.bytes(&rendered).len == 0 {
        try write(writer, "{?}")
      } else {
        try write(writer, format.bytes(&rendered))
      }
    }
  }
}

// print_arguments is the non-variadic entry point used by forwarding wrappers.
// The format language is intentionally small: {} inserts a value; {{ and }}
// write literal braces. dyn vet checks a literal template's {} count. A
// template made at run time that does not match its arguments still prints:
// a {} with no argument prints {?}, a lone brace prints as itself, and each
// extra argument prints at the end as {+value}. The call then fails with
// InvalidInput after everything is written.
pub fn print_arguments(writer: Writer, template: []const u8, arguments: []const any) !IoErr {
  argument_index: usize = 0
  mismatch := false
  span_start: usize = 0
  index: usize = 0
  for index < template.len {
    byte := template[index]
    if byte != '{' && byte != '}' {
      index += 1
      continue
    }
    if span_start < index {
      try write(writer, template[span_start..index])
    }
    next: u8 = 0
    if index + 1 < template.len {
      next = template[index + 1]
    }
    piece := template[index..index + 1]
    step: usize = 1
    if byte == '{' && next == '}' {
      step = 2
      if argument_index < arguments.len {
        try print_value(writer, arguments[argument_index])
        argument_index += 1
        piece = ""
      } else {
        mismatch = true
        piece = "{?}"
      }
    } else if next == byte {
      step = 2
    } else {
      mismatch = true
    }
    if piece.len > 0 {
      try write(writer, piece)
    }
    index += step
    span_start = index
  }
  if span_start < template.len {
    try write(writer, template[span_start..])
  }
  for argument_index < arguments.len {
    mismatch = true
    try write(writer, " {+")
    try print_value(writer, arguments[argument_index])
    try write(writer, "}")
    argument_index += 1
  }
  if mismatch { fail .InvalidInput }
}

// Checked formatting to any writer: {} takes the next argument.
pub fn print_to(writer: Writer, template: []const u8, arguments: ...any) !IoErr {
  try print_arguments(writer, template, arguments)
}

// Terminal output, print/println/eprint/eprintln, lives with stdout() in each
// platform file; targets without standard streams have neither.

// Like print_arguments, then a newline. A template that did not match its
// arguments still prints its line before failing with InvalidInput.
pub fn println_arguments(writer: Writer, template: []const u8, arguments: []const any) !IoErr {
  mismatch := false
  print_arguments(writer, template, arguments) catch err {
    case err {
      .InvalidInput => { mismatch = true }
      _ => { fail err }
    }
  }
  try write(writer, "\n")
  if mismatch { fail .InvalidInput }
}

pub fn println_to(writer: Writer, template: []const u8, arguments: ...any) !IoErr {
  try println_arguments(writer, template, arguments)
}

// Copies reader to writer until the end of the reader, through scratch;
// the count copied. An empty scratch fails with InvalidInput.
pub fn copy(writer: Writer, reader: Reader, scratch: []u8) usize!IoErr {
  if scratch.len == 0 { fail .InvalidInput }
  total: usize = 0
  for {
    count := try read(reader, scratch)
    if count == 0 { break }
    try write(writer, scratch[..count])
    total += count
  }
  return total
}

// Copies exactly amount bytes; a reader that ends first fails with
// InvalidInput.
pub fn copy_n(writer: Writer, reader: Reader, amount: usize, scratch: []u8) !IoErr {
  if amount == 0 { return }
  if scratch.len == 0 { fail .InvalidInput }
  total: usize = 0
  for total < amount {
    take := amount - total
    if take > scratch.len {
      take = scratch.len
    }
    count := try read_exact(reader, scratch[..take])
    if count == 0 { fail .InvalidInput }
    try write(writer, scratch[..count])
    total += count
  }
}

pub struct Cursor {
  data: []const u8,
  offset: usize,
}

pub fn cursor(data: []const u8) Cursor {
  return Cursor{ data: data, offset: 0 }
}

fn cursor_read(data: rawptr, destination: []u8) usize!IoErr {
  state := #cast(*Cursor, data)
  if state.offset > state.data.len { fail .InvalidInput }
  remaining := state.data.len - state.offset
  take := remaining
  if destination.len < take {
    take = destination.len
  }
  for i in 0..take {
    destination[i] = state.data[state.offset + i]
  }
  state.offset += take
  return take
}

pub fn cursor_reader(state: *Cursor) Reader {
  return Reader{ data: state, read: cursor_read }
}

pub struct BufferWriter {
  data: []u8,
  length: usize,
}

pub fn buffer_writer(storage: []u8) BufferWriter {
  return BufferWriter{ data: storage, length: 0 }
}

pub fn buffer_writer_bytes(state: *const BufferWriter) []const u8 {
  return state.data[..state.length]
}

pub fn buffer_writer_reset(state: *BufferWriter) {
  state.length = 0
}

// Takes what fits; fails with Capacity only when nothing fits.
fn buffer_write(data: rawptr, source: []const u8) usize!IoErr {
  state := #cast(*BufferWriter, data)
  if state.length > state.data.len { fail .InvalidInput }
  remaining := state.data.len - state.length
  take := source.len
  if remaining < take {
    take = remaining
  }
  for i in 0..take {
    state.data[state.length + i] = source[i]
  }
  if take == 0 && source.len != 0 { fail .Capacity }
  state.length += take
  return take
}

pub fn buffer_writer_adapter(state: *BufferWriter) Writer {
  return Writer{ data: state, write: buffer_write }
}
