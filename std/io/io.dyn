use "std/mem" memory
use "std/fmt" format
// Minimal composable I/O seams. Adapters borrow state and never own or close it.

// A transfer either completed or reached the end. Whether it failed is the
// separate failure, zero on success; bytes may arrive with a failure.
pub enum Status { Complete, End }

pub struct Transfer {
  transferred: usize,
  failure: Failure,
  status: Status,
}

pub struct Reader {
  data: rawptr,
  read: fn(rawptr, []u8) Transfer,
}

pub struct Writer {
  data: rawptr,
  write: fn(rawptr, []const u8) Transfer,
}

// Callback results are bounded by the supplied slice. Errors always have a
// native code when supplied by the OS; readers may return bytes with End or Error.
fn checked(result: Transfer, capacity: usize) Transfer {
  if result.transferred > capacity {
    return Transfer{ failure: Failure{ kind: Kind.System, native: -5 } }
  }
  if failed(result.failure) && result.failure.kind == Kind.Ok {
    return Transfer{ transferred: result.transferred, failure: Failure{ kind: Kind.System, native: result.failure.native } }
  }
  return result
}

// Whether a transfer finished without reaching the end and without failing.
pub fn complete(transfer: Transfer) bool {
  return transfer.status == Status.Complete && !failed(transfer.failure)
}

pub fn read(reader: Reader, destination: []u8) Transfer {
  if #len(destination) == 0 {
    return Transfer{}
  }
  if reader.read == nil {
    return Transfer{ failure: Failure{ kind: Kind.InvalidInput, native: -22 } }
  }
  return checked(reader.read(reader.data, destination), #len(destination))
}

pub fn write(writer: Writer, source: []const u8) Transfer {
  if #len(source) == 0 {
    return Transfer{}
  }
  if writer.write == nil {
    return Transfer{ failure: Failure{ kind: Kind.InvalidInput, native: -22 } }
  }
  callback := writer.write
  result := checked(callback(writer.data, source), #len(source))
  if result.status == Status.End {
    return Transfer{ transferred: result.transferred, failure: Failure{ kind: Kind.System, native: -5 } }
  }
  return result
}

pub fn read_exact(reader: Reader, destination: []u8) Transfer {
  total: usize = 0
  for total < #len(destination) {
    result := read(reader, destination[total..])
    total += result.transferred
    if failed(result.failure) {
      return Transfer{ transferred: total, failure: Failure{ kind: result.failure.kind, native: result.failure.native } }
    }
    if total == #len(destination) {
      return Transfer{ transferred: total, status: Status.Complete, failure: Failure{ native: 0 } }
    }
    if result.status == Status.End {
      return Transfer{ transferred: total, status: Status.End, failure: Failure{ native: 0 } }
    }
    if result.transferred == 0 {
      return Transfer{ transferred: total, failure: Failure{ kind: Kind.System, native: -5 } }
    }
  }
  return Transfer{ transferred: total, status: Status.Complete, failure: Failure{ native: 0 } }
}

pub fn write_all(writer: Writer, source: []const u8) Transfer {
  total: usize = 0
  for total < #len(source) {
    result := write(writer, source[total..])
    total += result.transferred
    if failed(result.failure) {
      return Transfer{ transferred: total, failure: Failure{ kind: result.failure.kind, native: result.failure.native } }
    }
    if result.transferred == 0 {
      return Transfer{ transferred: total, failure: Failure{ kind: Kind.System, native: -5 } }
    }
  }
  return Transfer{ transferred: total, status: Status.Complete, failure: Failure{ native: 0 } }
}

fn print_value(writer: Writer, value: any) Transfer {
  storage: [64 + memory.ArenaBufferOverhead]u8
  scratch := memory.arena_from_buffer(storage[..])
  case value {
    f32 item => {
      return write_all(writer, format.f64_decimal(scratch, item, 6))
    }
    f64 item => {
      return write_all(writer, format.f64_decimal(scratch, item, 6))
    }
    bool item => {
      if item {
        return write_all(writer, "true")
      }
      return write_all(writer, "false")
    }
    i8 item => {
      return write_all(writer, format.i64_decimal(scratch, item))
    }
    i16 item => {
      return write_all(writer, format.i64_decimal(scratch, item))
    }
    i32 item => {
      return write_all(writer, format.i64_decimal(scratch, item))
    }
    i64 item => {
      return write_all(writer, format.i64_decimal(scratch, item))
    }
    isize item => {
      return write_all(writer, format.i64_decimal(scratch, item))
    }
    u8 item => {
      return write_all(writer, format.u64_decimal(scratch, item))
    }
    u16 item => {
      return write_all(writer, format.u64_decimal(scratch, item))
    }
    u32 item => {
      return write_all(writer, format.u64_decimal(scratch, item))
    }
    u64 item => {
      return write_all(writer, format.u64_decimal(scratch, item))
    }
    usize item => {
      return write_all(writer, format.u64_decimal(scratch, item))
    }
    []u8 item => {
      return write_all(writer, item)
    }
    []const u8 item => {
      return write_all(writer, item)
    }
    _ => {
      // A type with no text form prints as a marker rather than ending the line.
      return write_all(writer, "{?}")
    }
  }
}

// print_arguments is the non-variadic entry point used by forwarding wrappers.
// The format language is intentionally small: {} inserts a value; {{ and }}
// write literal braces. A literal template is checked by the compiler. A
// template made at run time that does not match its arguments still prints:
// a {} with no argument prints {?}, a lone brace prints as itself, and each
// extra argument prints at the end as {+value}. The result then reports
// InvalidInput with everything that was written.
pub fn print_arguments(writer: Writer, template: []const u8, arguments: []const any) Transfer {
  total: usize = 0
  argument_index: usize = 0
  mismatch := false
  span_start: usize = 0
  index: usize = 0
  for index < #len(template) {
    byte := template[index]
    if byte != '{' && byte != '}' {
      index += 1
      continue
    }
    if span_start < index {
      literal := write_all(writer, template[span_start..index])
      total += literal.transferred
      if failed(literal.failure) {
        return Transfer{ transferred: total, failure: Failure{ kind: literal.failure.kind, native: literal.failure.native } }
      }
    }
    next: u8 = 0
    if index + 1 < #len(template) {
      next = template[index + 1]
    }
    piece := template[index..index + 1]
    step: usize = 1
    if byte == '{' && next == '}' {
      step = 2
      if argument_index < #len(arguments) {
        inserted := print_value(writer, arguments[argument_index])
        total += inserted.transferred
        if failed(inserted.failure) {
          return Transfer{ transferred: total, failure: Failure{ kind: inserted.failure.kind, native: inserted.failure.native } }
        }
        argument_index += 1
        piece = ""
      } else {
        mismatch = true
        piece = "{?}"
      }
    } else if next == byte {
      step = 2
    } else {
      mismatch = true
    }
    if #len(piece) > 0 {
      brace := write_all(writer, piece)
      total += brace.transferred
      if failed(brace.failure) {
        return Transfer{ transferred: total, failure: Failure{ kind: brace.failure.kind, native: brace.failure.native } }
      }
    }
    index += step
    span_start = index
  }
  if span_start < #len(template) {
    tail := write_all(writer, template[span_start..])
    total += tail.transferred
    if failed(tail.failure) {
      return Transfer{ transferred: total, failure: Failure{ kind: tail.failure.kind, native: tail.failure.native } }
    }
  }
  for argument_index < #len(arguments) {
    mismatch = true
    open := write_all(writer, " {+")
    inserted := print_value(writer, arguments[argument_index])
    close := write_all(writer, "}")
    total += open.transferred + inserted.transferred + close.transferred
    if failed(open.failure) || failed(inserted.failure) || failed(close.failure) {
      return Transfer{ transferred: total, failure: Failure{ kind: Kind.InvalidInput, native: -22 } }
    }
    argument_index += 1
  }
  if mismatch {
    return Transfer{ transferred: total, failure: Failure{ kind: Kind.InvalidInput, native: -22 } }
  }
  return Transfer{ transferred: total, status: Status.Complete, failure: Failure{ native: 0 } }
}

// Checked formatting to any writer: {} takes the next argument.
pub fn print_to(writer: Writer, template: []const u8, arguments: ...any) Transfer {
  return print_arguments(writer, template, arguments)
}

// Terminal output, print/println/eprint/eprintln, lives with stdout() in each
// platform file; targets without standard streams have neither.

pub fn println_arguments(writer: Writer, template: []const u8, arguments: []const any) Transfer {
  result := print_arguments(writer, template, arguments)
  // A template that did not match its arguments still printed; end its line.
  if failed(result.failure) && result.failure.kind != Kind.InvalidInput {
    return result
  }
  newline := write_all(writer, "\n")
  if failed(newline.failure) {
    return Transfer{ transferred: result.transferred + newline.transferred, failure: Failure{ kind: newline.failure.kind, native: newline.failure.native } }
  }
  return Transfer{ transferred: result.transferred + newline.transferred, status: result.status, failure: Failure{ kind: result.failure.kind, native: result.failure.native } }
}

pub fn println_to(writer: Writer, template: []const u8, arguments: ...any) Transfer {
  return println_arguments(writer, template, arguments)
}

pub fn copy(writer: Writer, reader: Reader, scratch: []u8) Transfer {
  if #len(scratch) == 0 {
    return Transfer{ transferred: 0, failure: Failure{ kind: Kind.InvalidInput, native: -22 } }
  }
  total: usize = 0
  for {
    input := read(reader, scratch)
    if input.transferred > #len(scratch) {
      return Transfer{ transferred: total, failure: Failure{ kind: Kind.System, native: -5 } }
    }
    if input.transferred > 0 {
      output := write_all(writer, scratch[..input.transferred])
      total += output.transferred
      if failed(output.failure) {
        return Transfer{ transferred: total, failure: Failure{ kind: output.failure.kind, native: output.failure.native } }
      }
    }
    if failed(input.failure) {
      return Transfer{ transferred: total, failure: Failure{ kind: input.failure.kind, native: input.failure.native } }
    }
    if input.status == Status.End {
      return Transfer{ transferred: total, status: Status.Complete, failure: Failure{ native: 0 } }
    }
    if input.transferred == 0 {
      return Transfer{ transferred: total, failure: Failure{ kind: Kind.System, native: -5 } }
    }
  }
  return Transfer{ transferred: total, status: Status.Complete, failure: Failure{ native: 0 } }
}

pub fn copy_n(writer: Writer, reader: Reader, amount: usize, scratch: []u8) Transfer {
  if #len(scratch) == 0 && amount != 0 {
    return Transfer{ transferred: 0, failure: Failure{ kind: Kind.InvalidInput, native: -22 } }
  }
  total: usize = 0
  for total < amount {
    take := amount - total
    if take > #len(scratch) {
      take = #len(scratch)
    }
    input := read_exact(reader, scratch[..take])
    if input.transferred > 0 {
      output := write_all(writer, scratch[..input.transferred])
      total += output.transferred
      if failed(output.failure) {
        return Transfer{ transferred: total, failure: Failure{ kind: output.failure.kind, native: output.failure.native } }
      }
    }
    if (input.status != Status.Complete || failed(input.failure)) {
      return Transfer{ transferred: total, status: input.status, failure: Failure{ kind: input.failure.kind, native: input.failure.native } }
    }
  }
  return Transfer{ transferred: total, status: Status.Complete, failure: Failure{ native: 0 } }
}

pub struct Cursor {
  data: []const u8,
  offset: usize,
}

pub fn cursor(data: []const u8) Cursor {
  return Cursor{ data: data, offset: 0 }
}

fn cursor_read(data: rawptr, destination: []u8) Transfer {
  state := #cast(*Cursor, data)
  if state.offset > #len(state.data) {
    return Transfer{ failure: Failure{ kind: Kind.InvalidInput, native: -22 } }
  }
  remaining := #len(state.data) - state.offset
  take := remaining
  if #len(destination) < take {
    take = #len(destination)
  }
  for i in 0..take {
    destination[i] = state.data[state.offset + i]
  }
  state.offset += take
  status := Status.Complete
  if state.offset == #len(state.data) {
    status = Status.End
  }
  return Transfer{ transferred: take, status: status, failure: Failure{ native: 0 } }
}

pub fn cursor_reader(state: *Cursor) Reader {
  return Reader{ data: state, read: cursor_read }
}

pub struct BufferWriter {
  data: []u8,
  length: usize,
}

pub fn buffer_writer(storage: []u8) BufferWriter {
  return BufferWriter{ data: storage, length: 0 }
}

pub fn buffer_writer_bytes(state: *const BufferWriter) []const u8 {
  return state.data[..state.length]
}

pub fn buffer_writer_reset(state: *BufferWriter) {
  state.length = 0
}

fn buffer_write(data: rawptr, source: []const u8) Transfer {
  state := #cast(*BufferWriter, data)
  if state.length > #len(state.data) {
    return Transfer{ failure: Failure{ kind: Kind.InvalidInput, native: -22 } }
  }
  remaining := #len(state.data) - state.length
  take := #len(source)
  if remaining < take {
    take = remaining
  }
  for i in 0..take {
    state.data[state.length + i] = source[i]
  }
  state.length += take
  if take != #len(source) {
    return Transfer{ transferred: take, failure: Failure{ kind: Kind.Capacity, native: -28 } }
  }
  return Transfer{ transferred: take, status: Status.Complete, failure: Failure{ native: 0 } }
}

pub fn buffer_writer_adapter(state: *BufferWriter) Writer {
  return Writer{ data: state, write: buffer_write }
}
