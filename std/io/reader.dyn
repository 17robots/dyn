module io

Allocator := (use "std/mem").Allocator

pub Reader := struct {
    ctx: *any,
    read_fn: (ctx: *any, buf: []u8) usize,
}

pub Reader.read_byte := (self: Reader) ?u8 {
    buf: [1]u8 = [0]
    if !self.read_exact(buf[..]) return null
    return buf[0]
}

pub Reader.read_exact := (self: Reader, buf: []u8) u1 {
    mut used: usize = 0
    for used < buf.len: {
        got := self.read_fn(self.ctx, buf[used..])
        if got == 0 return false
        used += got
    }
    return true
}

pub Reader.read_all := (self: Reader, alloc: Allocator) ?[]u8 {
    buf := alloc.create_many(u8, 4096) or return null
    got := self.read_fn(self.ctx, buf[..])
    return alloc.resize_many(u8, buf, got)
}
