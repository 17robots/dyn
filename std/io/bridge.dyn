use "std/fail"
// Transitional: fail.Status forms of the stream calls, for std modules that
// still report through a status. Each records the first failure on status
// and does nothing once status has failed. They go away with std/fail.

pub fn read_status(status: *fail.Status, reader: Reader, destination: []u8) usize {
  if status == nil { return read_status(&fail.Status{}, reader, destination) }
  if status.failed { return 0 }
  count := read(reader, destination) catch err {
    fail.set(status, failure_of(err, "read", ""))
    return 0
  }
  return count
}

pub fn read_exact_status(status: *fail.Status, reader: Reader, destination: []u8) usize {
  if status == nil { return read_exact_status(&fail.Status{}, reader, destination) }
  if status.failed { return 0 }
  count := read_exact(reader, destination) catch err {
    fail.set(status, failure_of(err, "read", ""))
    return 0
  }
  return count
}

pub fn write_status(status: *fail.Status, writer: Writer, source: []const u8) {
  if status == nil {
    write_status(&fail.Status{}, writer, source)
    return
  }
  if status.failed { return }
  write(writer, source) catch err { fail.set(status, failure_of(err, "write", "")) }
}

pub fn print_status(status: *fail.Status, writer: Writer, template: []const u8, arguments: []const any) {
  if status == nil {
    print_status(&fail.Status{}, writer, template, arguments)
    return
  }
  if status.failed { return }
  print_arguments(writer, template, arguments) catch err { fail.set(status, failure_of(err, "print", "")) }
}

pub fn println_status(status: *fail.Status, writer: Writer, template: []const u8, arguments: []const any) {
  if status == nil {
    println_status(&fail.Status{}, writer, template, arguments)
    return
  }
  if status.failed { return }
  println_arguments(writer, template, arguments) catch err { fail.set(status, failure_of(err, "print", "")) }
}

pub fn copy_status(status: *fail.Status, writer: Writer, reader: Reader, scratch: []u8) usize {
  if status == nil { return copy_status(&fail.Status{}, writer, reader, scratch) }
  if status.failed { return 0 }
  count := copy(writer, reader, scratch) catch err {
    fail.set(status, failure_of(err, "copy", ""))
    return 0
  }
  return count
}

// Fails with the IoErr for a status failure; for adapters whose state still
// reports through a status.
pub fn check_status(status: *const fail.Status) !IoErr {
  if status.failed { fail err_of(status.failure) }
}
