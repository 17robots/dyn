module io

/// Print a format string with positional {} placeholders to a Writer.
/// Each {} is replaced by the corresponding argument.
///
/// Example:
///   io.fprint(w, "name: {}, age: {}", .{ name, age })
pub fprint := (w: Writer, fmt: []u8, args: any) {
    mut pos := 0
    inline for args: |v| {
        mut i := pos
        for i + 1 < fmt.len: {
            if fmt[i] == '{' and fmt[i+1] == '}' {
                w.write_all(fmt[pos..i])
                w.print(v)
                pos = i + 2
                break
            }
            i += 1
        }
    }
    w.write_all(fmt[pos..])
}
/// Print a format string to a Writer followed by a newline.
pub fprintln := (w: Writer, fmt: []u8, args: any) {
    fprint(w, fmt, args)
    w.write_byte('\n')
}
