pub fn write(bytes: []const u8) isize {
  if #len(bytes) == 0 { return 0 }
  return #syscall(1, 1, &bytes[0], #len(bytes))
}

pub fn write_error(bytes: []const u8) isize {
  if #len(bytes) == 0 { return 0 }
  return #syscall(1, 2, &bytes[0], #len(bytes))
}

pub fn print(bytes: []const u8) {
  _ = write(bytes)
}

pub fn println(bytes: []const u8) {
  _ = write(bytes)
  _ = write("\n")
}
