#target(kernel: windows)
use "std/fail"

pub extern fn standard_handle "dyn_stdio_handle"(kind: u32) rawptr
extern fn standard_read "dyn_stdio_read"(handle: rawptr, bytes: *u8, count: u32, received: *u32, overlapped: rawptr) i32
extern fn standard_write "dyn_stdio_write"(handle: rawptr, bytes: *const u8, count: u32, written: *u32, overlapped: rawptr) i32
extern fn standard_error "dyn_stdio_error"() u32

fn valid_handle(handle: rawptr) bool {
  return handle != nil && #cast(usize, handle) != 18446744073709551615
}
fn transfer_limit(size: usize) u32 {
  if size > 4294967295 { return 4294967295 }
  return #cast(u32, size)
}
fn stream_failed(status: *fail.Status, operation: []const u8, path: []const u8, code: u32) {
  fail.set(status, from_windows(operation, path, 0 - #cast(isize, code)))
}

// Borrow current standard handles. Bytes are not transcoded or newline-translated.
pub fn stdin() Reader {
  return Reader{ read: stdin_stream }
}
pub fn stdout() Writer {
  return Writer{ write: stdout_stream }
}
pub fn stderr() Writer {
  return Writer{ write: stderr_stream }
}

fn stdin_stream(_data: rawptr, status: *fail.Status, destination: []u8) usize {
  if status.failed || destination.len == 0 { return 0 }
  handle := standard_handle(4294967286) // STD_INPUT_HANDLE (-10)
  if !valid_handle(handle) {
    stream_failed(status, "read", "standard input", 6)
    return 0
  }
  count: u32 = 0
  if standard_read(handle, &destination[0], transfer_limit(destination.len), &count, nil) == 0 {
    error := standard_error()
    // A closed pipe and a file at EOF both end the byte stream.
    if error == 109 || error == 38 { return count }
    // A message-mode pipe may return a partial message with ERROR_MORE_DATA.
    if error == 234 && count > 0 { return count }
    stream_failed(status, "read", "standard input", error)
    return 0
  }
  return count
}
fn write_standard(status: *fail.Status, kind: u32, path: []const u8, source: []const u8) usize {
  if status.failed || source.len == 0 { return 0 }
  handle := standard_handle(kind)
  if !valid_handle(handle) {
    stream_failed(status, "write", path, 6)
    return 0
  }
  count: u32 = 0
  if standard_write(handle, &source[0], transfer_limit(source.len), &count, nil) == 0 {
    stream_failed(status, "write", path, standard_error())
    return count
  }
  if count == 0 { stream_failed(status, "write", path, 5) }
  return count
}
fn stdout_stream(_data: rawptr, status: *fail.Status, source: []const u8) usize {
  return write_standard(status, 4294967285, "standard output", source)
}
fn stderr_stream(_data: rawptr, status: *fail.Status, source: []const u8) usize {
  return write_standard(status, 4294967284, "standard error", source)
}
