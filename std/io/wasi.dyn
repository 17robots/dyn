#target(kernel: wasi)
use "std/os/wasi/raw" wasi_raw

fn stdin_read(data: rawptr, destination: []u8) Transfer {
  _ = data
  if #len(destination) == 0 {
    return Transfer{ status: Status.Complete }
  }
  count: usize = 0
  error := wasi_raw.read(0, &destination[0], #len(destination), &count)
  if error != 0 {
    return Transfer{ transferred: count, error: 0 - #cast(isize, error), kind: wasi(0 - #cast(isize, error)), status: Status.Error }
  }
  if count == 0 {
    return Transfer{ status: Status.End }
  }
  return Transfer{ transferred: count, status: Status.Complete }
}

fn write_descriptor(descriptor: u32, source: []const u8) Transfer {
  if #len(source) == 0 {
    return Transfer{ status: Status.Complete }
  }
  count: usize = 0
  error := wasi_raw.write(descriptor, #cast(rawptr, &source[0]), #len(source), &count)
  if error != 0 {
    return Transfer{ transferred: count, error: 0 - #cast(isize, error), kind: wasi(0 - #cast(isize, error)), status: Status.Error }
  }
  return Transfer{ transferred: count, status: Status.Complete }
}
fn stdout_write(data: rawptr, source: []const u8) Transfer {
  _ = data
  return write_descriptor(1, source)
}
fn stderr_write(data: rawptr, source: []const u8) Transfer {
  _ = data
  return write_descriptor(2, source)
}

// Borrow the process standard descriptors; callers do not own or close them.
pub fn stdin() Reader {
  return Reader{ read: stdin_read }
}
pub fn stdout() Writer {
  return Writer{ write: stdout_write }
}
pub fn stderr() Writer {
  return Writer{ write: stderr_write }
}

// Terminal output. These ignore write failures, such as a closed pipe, so a
// call needs no `_ =`; use print_to or println_to to check the result.
pub fn print(template: []const u8, arguments: ...any) {
  _ = print_arguments(stdout(), template, arguments)
}

pub fn println(template: []const u8, arguments: ...any) {
  _ = println_arguments(stdout(), template, arguments)
}

pub fn eprint(template: []const u8, arguments: ...any) {
  _ = print_arguments(stderr(), template, arguments)
}

pub fn eprintln(template: []const u8, arguments: ...any) {
  _ = println_arguments(stderr(), template, arguments)
}
