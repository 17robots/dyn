#target(kernel: wasi)
use "std/fail"
use "std/os/wasi/raw" wasi_raw

// Borrow the process standard descriptors; callers do not own or close them.
pub fn stdin() Reader {
  return Reader{ read: stdin_stream }
}
pub fn stdout() Writer {
  return Writer{ write: stdout_stream }
}
pub fn stderr() Writer {
  return Writer{ write: stderr_stream }
}

fn stdin_stream(_data: rawptr, status: *fail.Status, destination: []u8) usize {
  if status.failed || #len(destination) == 0 { return 0 }
  count: usize = 0
  error := wasi_raw.read(0, &destination[0], #len(destination), &count)
  if error != 0 {
    fail.set(status, from_wasi("read", "standard input", 0 - #cast(isize, error)))
    return 0
  }
  return count
}

fn write_descriptor(status: *fail.Status, descriptor: u32, path: []const u8, source: []const u8) usize {
  if status.failed || #len(source) == 0 { return 0 }
  count: usize = 0
  error := wasi_raw.write(descriptor, #cast(rawptr, &source[0]), #len(source), &count)
  if error != 0 {
    fail.set(status, from_wasi("write", path, 0 - #cast(isize, error)))
  }
  return count
}
fn stdout_stream(_data: rawptr, status: *fail.Status, source: []const u8) usize {
  return write_descriptor(status, 1, "standard output", source)
}
fn stderr_stream(_data: rawptr, status: *fail.Status, source: []const u8) usize {
  return write_descriptor(status, 2, "standard error", source)
}
