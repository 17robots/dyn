#target(kernel: wasi)
use wasi_raw "std/os/wasi/raw"

// Borrow the process standard descriptors; callers do not own or close them.
pub fn stdin() Reader {
  return Reader{ read: stdin_stream }
}
pub fn stdout() Writer {
  return Writer{ write: stdout_stream }
}
pub fn stderr() Writer {
  return Writer{ write: stderr_stream }
}

fn stdin_stream(_data: rawptr, destination: []u8) usize!IoErr {
  if destination.len == 0 { return 0 }
  count: usize = 0
  error := wasi_raw.read(0, &destination[0], destination.len, &count)
  if error != 0 { fail wasi_err(0 - #cast(isize, error)) }
  return count
}

fn write_descriptor(descriptor: u32, source: []const u8) usize!IoErr {
  if source.len == 0 { return 0 }
  count: usize = 0
  error := wasi_raw.write(descriptor, #cast(rawptr, &source[0]), source.len, &count)
  if error != 0 { fail wasi_err(0 - #cast(isize, error)) }
  return count
}
fn stdout_stream(_data: rawptr, source: []const u8) usize!IoErr {
  return try write_descriptor(1, source)
}
fn stderr_stream(_data: rawptr, source: []const u8) usize!IoErr {
  return try write_descriptor(2, source)
}

fn system_text(code: isize) []const u8 {
  return wasi_text(code)
}
