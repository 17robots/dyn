#target(kernel: wasi)
use "std/os/wasi/raw" wasi_raw

fn stdin_read(data: rawptr, destination: []u8) Result {
  _ = data
  if #len(destination) == 0 {
    return Result{ status: Status.Complete }
  }
  count: usize = 0
  error := wasi_raw.read(0, #cast(rawptr) &destination[0], #len(destination), &count)
  if error != 0 {
    return Result{ transferred: count, error: 0 - #cast(isize) error, kind: errors.wasi(0 - #cast(isize) error), status: Status.Error }
  }
  if count == 0 {
    return Result{ status: Status.End }
  }
  return Result{ transferred: count, status: Status.Complete }
}

fn write_descriptor(descriptor: u32, source: []const u8) Result {
  if #len(source) == 0 {
    return Result{ status: Status.Complete }
  }
  count: usize = 0
  error := wasi_raw.write(descriptor, #cast(rawptr) &source[0], #len(source), &count)
  if error != 0 {
    return Result{ transferred: count, error: 0 - #cast(isize) error, kind: errors.wasi(0 - #cast(isize) error), status: Status.Error }
  }
  return Result{ transferred: count, status: Status.Complete }
}
fn stdout_write(data: rawptr, source: []const u8) Result {
  _ = data
  return write_descriptor(1, source)
}
fn stderr_write(data: rawptr, source: []const u8) Result {
  _ = data
  return write_descriptor(2, source)
}

// Borrow the process standard descriptors; callers do not own or close them.
pub fn stdin() Reader {
  return Reader{ read: &stdin_read }
}
pub fn stdout() Writer {
  return Writer{ write: &stdout_write }
}
pub fn stderr() Writer {
  return Writer{ write: &stderr_write }
}
