#target(kernel: none)
use "std/fail"
// Bare metal: standard output and error both go to the board console. There is
// no input, so stdin reports end of input.
extern fn console_write "dyn_console_write"(data: *const u8, size: u64)

pub fn stdin() Reader {
  return Reader{ data: nil, read: stdin_stream }
}
pub fn stdout() Writer {
  return Writer{ data: nil, write: console_stream }
}
pub fn stderr() Writer {
  return Writer{ data: nil, write: console_stream }
}

fn stdin_stream(_data: rawptr, status: *fail.Status, destination: []u8) usize {
  return 0
}
fn console_stream(_data: rawptr, status: *fail.Status, source: []const u8) usize {
  if status.failed { return 0 }
  if #len(source) != 0 {
    console_write(&source[0], #len(source))
  }
  return #len(source)
}
