#target(kernel: none)
// Bare metal: standard output and error both go to the board console. There is
// no input, so stdin reports end of input.
extern fn console_write "dyn_console_write"(data: *const u8, size: u64)

fn stdin_read(_data: rawptr, destination: []u8) Transfer {
  return Transfer{ transferred: 0, error: 0, status: Status.End }
}

fn console_writer_write(_data: rawptr, source: []const u8) Transfer {
  if #len(source) != 0 {
    console_write(&source[0], #len(source))
  }
  return Transfer{ transferred: #len(source), error: 0, status: Status.Complete }
}

pub fn stdin() Reader {
  return Reader{ data: nil, read: stdin_read }
}
pub fn stdout() Writer {
  return Writer{ data: nil, write: console_writer_write }
}
pub fn stderr() Writer {
  return Writer{ data: nil, write: console_writer_write }
}

// Terminal output. These ignore write failures, such as a closed pipe, so a
// call needs no `_ =`; use print_to or println_to to check the result.
pub fn print(template: []const u8, arguments: ...any) {
  _ = print_arguments(stdout(), template, arguments)
}

pub fn println(template: []const u8, arguments: ...any) {
  _ = println_arguments(stdout(), template, arguments)
}

pub fn eprint(template: []const u8, arguments: ...any) {
  _ = print_arguments(stderr(), template, arguments)
}

pub fn eprintln(template: []const u8, arguments: ...any) {
  _ = println_arguments(stderr(), template, arguments)
}
