#target(kernel: none)
// Bare metal: standard output and error both go to the board console. There is
// no input, so stdin reports end of input.
extern fn console_write "dyn_console_write"(data: *const u8, size: u64)

fn stdin_read(data: rawptr, destination: []u8) Result {
  _ = data
  return Result{ transferred: 0, error: 0, status: Status.End }
}

fn console_writer_write(data: rawptr, source: []const u8) Result {
  _ = data
  if #len(source) != 0 {
    console_write(&source[0], #cast(u64, #len(source)))
  }
  return Result{ transferred: #len(source), error: 0, status: Status.Complete }
}

pub fn stdin() Reader {
  return Reader{ data: nil, read: stdin_read }
}
pub fn stdout() Writer {
  return Writer{ data: nil, write: console_writer_write }
}
pub fn stderr() Writer {
  return Writer{ data: nil, write: console_writer_write }
}
