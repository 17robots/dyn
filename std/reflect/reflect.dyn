// Stable public categories. Compiler-private identity remains hidden.
pub enum Kind {
  Invalid,
  None,
  Bool,
  Integer,
  Float,
  Pointer,
  Array,
  Slice,
  Struct,
  Enum,
  Function,
}

// Bridge existing compiler metadata into public reflection vocabulary.
pub fn kind(info: TypeInfo) Kind {
  case info.kind {
    TypeKind.Void => { return Kind.None },
    TypeKind.Bool => { return Kind.Bool },
    TypeKind.Integer => { return Kind.Integer },
    TypeKind.Float => { return Kind.Float },
    TypeKind.Pointer => { return Kind.Pointer },
    TypeKind.Array => { return Kind.Array },
    TypeKind.Slice => { return Kind.Slice },
    TypeKind.Struct => { return Kind.Struct },
    TypeKind.Enum => { return Kind.Enum },
    TypeKind.Function => { return Kind.Function },
    _ => { return Kind.Invalid },
  }
}
