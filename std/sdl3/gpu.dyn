pub type GpuDevice = rawptr
pub type GpuCommandBuffer = rawptr
pub type GpuTexture = rawptr
pub type GpuRenderPass = rawptr
pub type GpuShader = rawptr
pub type GpuBuffer = rawptr
pub const ShaderSpirv: u32 = 2
pub const ShaderDxbc: u32 = 4
pub const ShaderDxil: u32 = 8
pub const ShaderMsl: u32 = 16
pub const ShaderMetallib: u32 = 32
pub const ShaderStageVertex: i32 = 0
pub const ShaderStageFragment: i32 = 1
pub const BufferVertex: u32 = 1
pub const BufferIndex: u32 = 2
pub const TextureSampler: u32 = 1
pub const TextureColorTarget: u32 = 2
pub struct GpuDeviceResult { value: GpuDevice, ok: bool }
pub struct GpuSwapchainResult { texture: GpuTexture, width: u32, height: u32, ok: bool }
pub struct FColor { red: f32, green: f32, blue: f32, alpha: f32 }
pub struct GpuColorTargetInfo {
  texture: GpuTexture, mip_level: u32, layer_or_depth_plane: u32, clear_color: FColor,
  load_op: i32, store_op: i32, resolve_texture: GpuTexture, resolve_mip_level: u32,
  resolve_layer: u32, cycle: bool, cycle_resolve_texture: bool, padding1: u8, padding2: u8,
}
pub struct GpuShaderInfo {
  code_size: usize, code: *const u8, entrypoint: c.string, format: u32, stage: i32,
  samplers: u32, storage_textures: u32, storage_buffers: u32, uniform_buffers: u32, properties: u32,
}
pub struct GpuTextureInfo {
  kind: i32, format: i32, usage: u32, width: u32, height: u32, layers_or_depth: u32,
  levels: u32, samples: i32, properties: u32,
}
pub struct GpuBufferInfo { usage: u32, size: u32, properties: u32 }

extern fn native_gpu_create "SDL_CreateGPUDevice"(formats: u32, debug: bool, name: c.string) GpuDevice
extern fn native_gpu_destroy "SDL_DestroyGPUDevice"(device: GpuDevice)
extern fn native_gpu_claim_window "SDL_ClaimWindowForGPUDevice"(device: GpuDevice, window: Window) bool
extern fn native_gpu_release_window "SDL_ReleaseWindowFromGPUDevice"(device: GpuDevice, window: Window)
extern fn native_gpu_acquire "SDL_AcquireGPUCommandBuffer"(device: GpuDevice) GpuCommandBuffer
extern fn native_gpu_swapchain "SDL_WaitAndAcquireGPUSwapchainTexture"(commands: GpuCommandBuffer, window: Window, texture: *GpuTexture, width: *u32, height: *u32) bool
extern fn native_gpu_submit "SDL_SubmitGPUCommandBuffer"(commands: GpuCommandBuffer) bool
extern fn native_gpu_begin_render "SDL_BeginGPURenderPass"(commands: GpuCommandBuffer, colors: *const GpuColorTargetInfo, count: u32, depth: rawptr) GpuRenderPass
extern fn native_gpu_end_render "SDL_EndGPURenderPass"(render_pass: GpuRenderPass)
extern fn native_gpu_shader_create "SDL_CreateGPUShader"(device: GpuDevice, info: *const GpuShaderInfo) GpuShader
extern fn native_gpu_shader_release "SDL_ReleaseGPUShader"(device: GpuDevice, shader: GpuShader)
extern fn native_gpu_texture_create "SDL_CreateGPUTexture"(device: GpuDevice, info: *const GpuTextureInfo) GpuTexture
extern fn native_gpu_texture_release "SDL_ReleaseGPUTexture"(device: GpuDevice, texture: GpuTexture)
extern fn native_gpu_buffer_create "SDL_CreateGPUBuffer"(device: GpuDevice, info: *const GpuBufferInfo) GpuBuffer
extern fn native_gpu_buffer_release "SDL_ReleaseGPUBuffer"(device: GpuDevice, buffer: GpuBuffer)

pub fn gpu_create_default_owned(formats: u32, debug: bool) GpuDeviceResult {
  value := native_gpu_create(formats, debug, nil)
  return GpuDeviceResult{ value: value, ok: value != nil }
}
pub fn gpu_destroy_owned(device: GpuDevice) { if device != nil { native_gpu_destroy(device) } }
pub fn gpu_claim_window(device: GpuDevice, window: Window) bool { return device != nil && window != nil && native_gpu_claim_window(device, window) }
pub fn gpu_release_window(device: GpuDevice, window: Window) { if device != nil && window != nil { native_gpu_release_window(device, window) } }
pub fn gpu_commands(device: GpuDevice) GpuCommandBuffer { if device == nil { return nil } return native_gpu_acquire(device) }
pub fn gpu_wait_swapchain(commands: GpuCommandBuffer, window: Window) GpuSwapchainResult {
  texture: GpuTexture = nil width: u32 = 0 height: u32 = 0
  ok := commands != nil && window != nil && native_gpu_swapchain(commands, window, &texture, &width, &height)
  return GpuSwapchainResult{ texture: texture, width: width, height: height, ok: ok }
}
// Submission consumes the command buffer regardless of success.
pub fn gpu_submit(commands: GpuCommandBuffer) bool { return commands != nil && native_gpu_submit(commands) }
pub fn gpu_shader_create_owned(device: GpuDevice, info: *const GpuShaderInfo) GpuShader { if device == nil || info == nil { return nil } return native_gpu_shader_create(device, info) }
pub fn gpu_shader_release_owned(device: GpuDevice, shader: GpuShader) { if device != nil && shader != nil { native_gpu_shader_release(device, shader) } }
pub fn gpu_texture_create_owned(device: GpuDevice, info: *const GpuTextureInfo) GpuTexture { if device == nil || info == nil { return nil } return native_gpu_texture_create(device, info) }
pub fn gpu_texture_release_owned(device: GpuDevice, texture: GpuTexture) { if device != nil && texture != nil { native_gpu_texture_release(device, texture) } }
pub fn gpu_buffer_create_owned(device: GpuDevice, info: *const GpuBufferInfo) GpuBuffer { if device == nil || info == nil { return nil } return native_gpu_buffer_create(device, info) }
pub fn gpu_buffer_release_owned(device: GpuDevice, buffer: GpuBuffer) { if device != nil && buffer != nil { native_gpu_buffer_release(device, buffer) } }

// Clears and presents one swapchain frame. Useful as the minimal real GPU lifecycle.
pub fn gpu_clear_swapchain(commands: GpuCommandBuffer, window: Window, color: FColor) bool {
  acquired := gpu_wait_swapchain(commands, window) if !acquired.ok || acquired.texture == nil { return false }
  target := GpuColorTargetInfo{ texture: acquired.texture, clear_color: color, load_op: 1, store_op: 0 }
  render_pass := native_gpu_begin_render(commands, &target, 1, nil) if render_pass == nil { return false }
  native_gpu_end_render(render_pass)
  return gpu_submit(commands)
}
