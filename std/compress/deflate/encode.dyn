// DEFLATE encoder (RFC 1951): LZ77 over hash chains with lazy matching, then
// for each block the smallest of stored, fixed-Huffman and dynamic-Huffman
// coding, with length-limited Huffman codes built from the block's symbol
// counts. Levels follow zlib's search parameters, so output sizes are close to
// zlib at the same level. All memory is the caller's: an Encoder workspace
// (about 400 KiB) and the destination.

pub const MinLevel: u8 = 1
pub const MaxLevel: u8 = 9
pub const DefaultLevel: u8 = 6

const WindowSize: usize = 32768
const WindowMask: usize = 32767
const HashSize: usize = 32768
const MinMatch: usize = 3
const MaxMatch: usize = 258
// Symbols per block before it is flushed, as in zlib's lit_bufsize.
const BlockSymbols: usize = 16384
const LiteralCodes: usize = 286
// The fixed code defines 288 literal/length symbols; 286 and 287 are never
// sent, but their 8-bit codes come before every 9-bit one.
const FixedLiteralCodes: usize = 288
const DistanceCodes: usize = 30
const LengthCodeCodes: usize = 19
const EndOfBlock: usize = 256

// Workspace for deflate. Reusable, and needs no zeroing: each call starts it
// afresh. Large, so put it in an arena (mem.push_uninit or mem.push), not on
// a stack.
pub struct Encoder {
  head: [HashSize]u32,
  previous: [WindowSize]u32,
  // Block symbols: length 0 is a literal byte in value, otherwise a match of
  // length bytes at distance value.
  lengths: [BlockSymbols]u16,
  values: [BlockSymbols]u16,
  symbol_count: usize,
  // Small inputs use fewer hash bits: less table to clear per call.
  hash_shift: u32,
  literal_counts: [LiteralCodes]u32,
  distance_counts: [DistanceCodes]u32,
  literal_lengths: [LiteralCodes]u8,
  distance_lengths: [DistanceCodes]u8,
  literal_codes: [LiteralCodes]u16,
  distance_codes: [DistanceCodes]u16,
  length_symbol: [MaxMatch + 1]u8,
  distance_symbol: [512]u8,
  // Huffman construction scratch, for up to LiteralCodes leaves.
  order: [LiteralCodes]u16,
  weights: [2 * LiteralCodes]u32,
  parents: [2 * LiteralCodes]u16,
  depths: [2 * LiteralCodes]u8,
}


struct Level { good: usize, lazy: usize, nice: usize, chain: usize }

fn level_parameters(level: u8) Level {
  case level {
    1 => { return Level{ good: 4, lazy: 0, nice: 8, chain: 4 } }
    2 => { return Level{ good: 4, lazy: 0, nice: 16, chain: 8 } }
    3 => { return Level{ good: 4, lazy: 0, nice: 32, chain: 32 } }
    4 => { return Level{ good: 4, lazy: 4, nice: 16, chain: 16 } }
    5 => { return Level{ good: 8, lazy: 16, nice: 32, chain: 32 } }
    6 => { return Level{ good: 8, lazy: 16, nice: 128, chain: 128 } }
    7 => { return Level{ good: 8, lazy: 32, nice: 128, chain: 256 } }
    8 => { return Level{ good: 32, lazy: 128, nice: 258, chain: 1024 } }
    _ => { return Level{ good: 32, lazy: 258, nice: 258, chain: 4096 } }
  }
}

// Bytes enough for any input of size bytes at any level: stored blocks of
// at most 65535 bytes, five bytes of header each, plus one block's slack.
pub fn deflate_bound(size: usize) usize {
  return size + 5 * (size / 16383 + 2) + 64
}

// Fast bit writer: little-endian bit order, 64-bit accumulator.
struct OutputBits { destination: []u8, written: usize, value: u64, count: u32, ok: bool }

fn put_bits(bits: *OutputBits, value: u32, count: u32) {
  bits.value |= #cast(u64, value) << bits.count
  bits.count += count
  if bits.count >= 32 {
    if #len(bits.destination) - bits.written < 4 {
      bits.ok = false
      bits.count = 0
      return
    }
    bits.destination[bits.written] = #cast(u8, bits.value)
    bits.destination[bits.written + 1] = #cast(u8, bits.value >> 8)
    bits.destination[bits.written + 2] = #cast(u8, bits.value >> 16)
    bits.destination[bits.written + 3] = #cast(u8, bits.value >> 24)
    bits.written += 4
    bits.value >>= 32
    bits.count -= 32
  }
}

// Writes whole pending bytes and pads the last partial byte with zero bits.
fn align_bits(bits: *OutputBits) {
  for bits.count > 0 {
    if bits.written == #len(bits.destination) {
      bits.ok = false
      return
    }
    bits.destination[bits.written] = #cast(u8, bits.value)
    bits.written += 1
    bits.value >>= 8
    if bits.count <= 8 {
      bits.count = 0
    } else {
      bits.count -= 8
    }
  }
  bits.value = 0
}

fn reverse_bits(value: u32, count: u32) u32 {
  result: u32 = 0
  rest := value
  for i in 0..count {
    result = (result << 1) | (rest & 1)
    rest >>= 1
  }
  return result
}

fn build_symbol_tables(encoder: *Encoder) {
  for code in 0..29 {
    first := #cast(usize, LengthBase[code])
    last := MaxMatch
    if code < 28 {
      last = #cast(usize, LengthBase[code + 1]) - 1
    }
    for length in first..last + 1 {
      encoder.length_symbol[length] = #cast(u8, code)
    }
  }
  encoder.length_symbol[MaxMatch] = 28
  // Distances 1..256 index directly; larger ones by (distance - 1) >> 7,
  // since every code past 15 covers whole 128-distance steps.
  for code in 0..DistanceCodes {
    first := #cast(usize, DistanceBase[code])
    last: usize = 32768
    if code < 29 {
      last = #cast(usize, DistanceBase[code + 1]) - 1
    }
    if last <= 256 {
      for distance in first..last + 1 {
        encoder.distance_symbol[distance - 1] = #cast(u8, code)
      }
    } else {
      for slot in (first - 1) >> 7..((last - 1) >> 7) + 1 {
        encoder.distance_symbol[256 + slot] = #cast(u8, code)
      }
    }
  }
}

fn distance_code(encoder: *const Encoder, distance: usize) usize {
  if distance <= 256 { return (encoder.distance_symbol[distance - 1]) }
  return (encoder.distance_symbol[256 + ((distance - 1) >> 7)])
}

// Huffman code lengths for counts, none longer than limit; zero counts get
// length 0. At least two symbols get codes, as zlib does, so every decoder
// accepts the tree.
fn build_lengths(encoder: *Encoder, counts: []u32, lengths: []u8, limit: u32) {
  n := #len(counts)
  for i in 0..n {
    lengths[i] = 0
  }
  used: usize = 0
  for i in 0..n {
    if counts[i] > 0 {
      used += 1
    }
  }
  if used < 2 {
    for i in 0..n {
      if counts[i] == 0 && used < 2 {
        counts[i] = 1
        used += 1
      }
    }
  }
  // Leaves sorted by count, then symbol (insertion sort: at most 286).
  leaves: usize = 0
  for i in 0..n {
    if counts[i] == 0 { continue }
    at := leaves
    for at > 0 && counts[encoder.order[at - 1]] > counts[i] {
      encoder.order[at] = encoder.order[at - 1]
      at -= 1
    }
    encoder.order[at] = #cast(u16, i)
    leaves += 1
  }
  // Two-queue Huffman: leaves 0..leaves, internal nodes from leaves up.
  for i in 0..leaves {
    encoder.weights[i] = counts[encoder.order[i]]
  }
  next_leaf: usize = 0
  next_node := leaves
  nodes := leaves
  for nodes < 2 * leaves - 1 {
    pick: [2]usize
    for p in 0..2 {
      if next_leaf < leaves && (next_node == nodes || encoder.weights[next_leaf] <= encoder.weights[next_node]) {
        pick[p] = next_leaf
        next_leaf += 1
      } else {
        pick[p] = next_node
        next_node += 1
      }
    }
    encoder.weights[nodes] = encoder.weights[pick[0]] + encoder.weights[pick[1]]
    encoder.parents[pick[0]] = #cast(u16, nodes)
    encoder.parents[pick[1]] = #cast(u16, nodes)
    nodes += 1
  }
  // Depths from the root down (parents always have higher indices), each
  // clamped to limit before its children use it. As in zlib's gen_bitlen,
  // every clamped node counts as overflow, internal ones too: the repair
  // below needs that count to make the code complete again.
  root := nodes - 1
  encoder.depths[root] = 0
  overflow: u32 = 0
  at := root
  for at > 0 {
    at -= 1
    depth := #cast(u32, encoder.depths[encoder.parents[at]]) + 1
    if depth > limit {
      depth = limit
      overflow += 1
    }
    encoder.depths[at] = #cast(u8, depth)
  }
  per_length: [17]u32
  for i in 0..leaves {
    per_length[encoder.depths[i]] += 1
  }
  for overflow > 0 {
    bits := limit - 1
    for per_length[bits] == 0 {
      bits -= 1
    }
    per_length[bits] -= 1
    per_length[bits + 1] += 2
    per_length[limit] -= 1
    if overflow >= 2 {
      overflow -= 2
    } else {
      overflow = 0
    }
  }
  // Longest codes to the least frequent leaves.
  leaf: usize = 0
  bits := limit
  for bits > 0 {
    for k in 0..per_length[bits] {
      lengths[encoder.order[leaf]] = #cast(u8, bits)
      leaf += 1
    }
    bits -= 1
  }
}

// Canonical codes for lengths (RFC 1951 3.2.2), bit-reversed for writing.
fn build_codes(lengths: []const u8, codes: []u16) {
  per_length: [16]u32
  for length in lengths {
    per_length[length] += 1
  }
  per_length[0] = 0
  next: [16]u32
  code: u32 = 0
  for bits in 1..16 {
    code = (code + per_length[bits - 1]) << 1
    next[bits] = code
  }
  for i in 0..#len(lengths) {
    length := #cast(u32, lengths[i])
    if length != 0 {
      codes[i] = #cast(u16, reverse_bits(next[length], length))
      next[length] += 1
    }
  }
}

fn fixed_tables(literal_lengths: []u8, distance_lengths: []u8) {
  for i in 0..#len(literal_lengths) {
    if i < 144 {
      literal_lengths[i] = 8
    } else if i < 256 {
      literal_lengths[i] = 9
    } else if i < 280 {
      literal_lengths[i] = 7
    } else {
      literal_lengths[i] = 8
    }
  }
  for i in 0..DistanceCodes {
    distance_lengths[i] = 5
  }
}

// Run-length codes for the concatenated code lengths (16, 17, 18).
struct LengthRuns { symbols: [LiteralCodes + DistanceCodes]u8, extras: [LiteralCodes + DistanceCodes]u8, count: usize }

fn length_runs(lengths: []const u8, runs: *LengthRuns) {
  runs.count = 0
  i: usize = 0
  for i < #len(lengths) {
    value := lengths[i]
    run: usize = 1
    for i + run < #len(lengths) && lengths[i + run] == value {
      run += 1
    }
    i += run
    if value == 0 {
      for run >= 11 {
        take := run
        if take > 138 {
          take = 138
        }
        runs.symbols[runs.count] = 18
        runs.extras[runs.count] = #cast(u8, take - 11)
        runs.count += 1
        run -= take
      }
      if run >= 3 {
        runs.symbols[runs.count] = 17
        runs.extras[runs.count] = #cast(u8, run - 3)
        runs.count += 1
        run = 0
      }
    } else {
      runs.symbols[runs.count] = value
      runs.count += 1
      run -= 1
      for run >= 3 {
        take := run
        if take > 6 {
          take = 6
        }
        runs.symbols[runs.count] = 16
        runs.extras[runs.count] = #cast(u8, take - 3)
        runs.count += 1
        run -= take
      }
    }
    for k in 0..run {
      runs.symbols[runs.count] = value
      runs.count += 1
    }
  }
}

const LengthOrder: [19]u8 = [16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15]

fn extra_bits_of(symbol: u8) u32 {
  if symbol == 16 { return 2 }
  if symbol == 17 { return 3 }
  if symbol == 18 { return 7 }
  return 0
}

// OutputBits for the block's symbols under the given lengths, without headers.
fn symbol_bits(encoder: *const Encoder, literal_lengths: []const u8, distance_lengths: []const u8) u64 {
  total: u64 = 0
  for i in 0..LiteralCodes {
    extra: u64 = 0
    if i >= 257 {
      extra = (LengthExtra[i - 257])
    }
    total += encoder.literal_counts[i] * (literal_lengths[i] + extra)
  }
  for i in 0..DistanceCodes {
    total += #cast(u64, encoder.distance_counts[i]) * (#cast(u64, distance_lengths[i]) + #cast(u64, DistanceExtra[i]))
  }
  return total
}

fn write_symbols(encoder: *const Encoder, bits: *OutputBits, literal_lengths: []const u8, literal_codes: []const u16,
  distance_lengths: []const u8, distance_codes: []const u16) {
  for i in 0..encoder.symbol_count {
    length := #cast(usize, encoder.lengths[i])
    value := #cast(usize, encoder.values[i])
    if length == 0 {
      put_bits(bits, literal_codes[value], literal_lengths[value])
      continue
    }
    code := #cast(usize, encoder.length_symbol[length])
    put_bits(bits, (literal_codes[257 + code]), (literal_lengths[257 + code]))
    extra := #cast(u32, LengthExtra[code])
    if extra > 0 {
      put_bits(bits, #cast(u32, length - LengthBase[code]), extra)
    }
    distance := distance_code(encoder, value)
    put_bits(bits, distance_codes[distance], distance_lengths[distance])
    distance_extra := #cast(u32, DistanceExtra[distance])
    if distance_extra > 0 {
      put_bits(bits, #cast(u32, value - DistanceBase[distance]), distance_extra)
    }
  }
  put_bits(bits, literal_codes[EndOfBlock], literal_lengths[EndOfBlock])
}

fn write_stored(bits: *OutputBits, raw: []const u8, final: bool) {
  at: usize = 0
  for true {
    take := #len(raw) - at
    if take > 65535 {
      take = 65535
    }
    last := final && at + take == #len(raw)
    if last {
      put_bits(bits, 1, 3)
    } else {
      put_bits(bits, 0, 3)
    }
    align_bits(bits)
    if !bits.ok || #len(bits.destination) - bits.written < 4 + take {
      bits.ok = false
      return
    }
    size := #cast(u32, take)
    bits.destination[bits.written] = #cast(u8, size)
    bits.destination[bits.written + 1] = #cast(u8, size >> 8)
    bits.destination[bits.written + 2] = #cast(u8, ~size)
    bits.destination[bits.written + 3] = #cast(u8, (~size) >> 8)
    bits.written += 4
    for k in 0..take {
      bits.destination[bits.written + k] = raw[at + k]
    }
    bits.written += take
    at += take
    if at == #len(raw) { return }
  }
}

// Emits the buffered symbols as one block, coding raw (the block's input
// bytes) stored when that is smallest.
fn flush_block(encoder: *Encoder, bits: *OutputBits, raw: []const u8, final: bool) {
  encoder.literal_counts[EndOfBlock] = 1
  build_lengths(encoder, encoder.literal_counts[..], encoder.literal_lengths[..], 15)
  build_lengths(encoder, encoder.distance_counts[..], encoder.distance_lengths[..], 15)
  // build_lengths may raise unused counts to 1; their cost is negligible.
  literal_used: usize = 257
  for i in 257..LiteralCodes {
    if encoder.literal_lengths[i] != 0 {
      literal_used = i + 1
    }
  }
  distance_used: usize = 1
  for i in 0..DistanceCodes {
    if encoder.distance_lengths[i] != 0 {
      distance_used = i + 1
    }
  }
  joined: [LiteralCodes + DistanceCodes]u8
  for i in 0..literal_used {
    joined[i] = encoder.literal_lengths[i]
  }
  for i in 0..distance_used {
    joined[literal_used + i] = encoder.distance_lengths[i]
  }
  runs := LengthRuns{}
  length_runs(joined[..literal_used + distance_used], &runs)
  run_counts: [LengthCodeCodes]u32
  for i in 0..runs.count {
    run_counts[runs.symbols[i]] += 1
  }
  run_lengths: [LengthCodeCodes]u8
  build_lengths(encoder, run_counts[..], run_lengths[..], 7)
  run_codes: [LengthCodeCodes]u16
  build_codes(run_lengths[..], run_codes[..])
  order_used: usize = 4
  for i in 0..LengthCodeCodes {
    if run_lengths[LengthOrder[i]] != 0 && i + 1 > order_used {
      order_used = i + 1
    }
  }
  dynamic_bits: u64 = 3 + 14 + 3 * #cast(u64, order_used)
  for i in 0..runs.count {
    symbol := runs.symbols[i]
    dynamic_bits += #cast(u64, run_lengths[symbol]) + #cast(u64, extra_bits_of(symbol))
  }
  dynamic_bits += symbol_bits(encoder, encoder.literal_lengths[..], encoder.distance_lengths[..])
  fixed_literal: [FixedLiteralCodes]u8
  fixed_distance: [DistanceCodes]u8
  fixed_tables(fixed_literal[..], fixed_distance[..])
  fixed_bits := 3 + symbol_bits(encoder, fixed_literal[..], fixed_distance[..])
  stored_bits := (#cast(u64, #len(raw)) + 5 * (#cast(u64, #len(raw)) / 65535 + 1)) * 8 + 7
  if stored_bits <= fixed_bits && stored_bits <= dynamic_bits {
    write_stored(bits, raw, final)
  } else if fixed_bits <= dynamic_bits {
    header: u32 = 2
    if final {
      header = 3
    }
    put_bits(bits, header, 3)
    fixed_literal_codes: [FixedLiteralCodes]u16
    fixed_distance_codes: [DistanceCodes]u16
    build_codes(fixed_literal[..], fixed_literal_codes[..])
    build_codes(fixed_distance[..], fixed_distance_codes[..])
    write_symbols(encoder, bits, fixed_literal[..], fixed_literal_codes[..], fixed_distance[..], fixed_distance_codes[..])
  } else {
    header: u32 = 4
    if final {
      header = 5
    }
    put_bits(bits, header, 3)
    put_bits(bits, #cast(u32, literal_used - 257), 5)
    put_bits(bits, #cast(u32, distance_used - 1), 5)
    put_bits(bits, #cast(u32, order_used - 4), 4)
    for i in 0..order_used {
      put_bits(bits, run_lengths[LengthOrder[i]], 3)
    }
    for i in 0..runs.count {
      symbol := runs.symbols[i]
      put_bits(bits, run_codes[symbol], run_lengths[symbol])
      extra := extra_bits_of(symbol)
      if extra > 0 {
        put_bits(bits, runs.extras[i], extra)
      }
    }
    build_codes(encoder.literal_lengths[..], encoder.literal_codes[..])
    build_codes(encoder.distance_lengths[..], encoder.distance_codes[..])
    write_symbols(encoder, bits, encoder.literal_lengths[..], encoder.literal_codes[..], encoder.distance_lengths[..],
      encoder.distance_codes[..])
  }
  encoder.symbol_count = 0
  for i in 0..LiteralCodes {
    encoder.literal_counts[i] = 0
  }
  for i in 0..DistanceCodes {
    encoder.distance_counts[i] = 0
  }
}

fn hash_at(source: []const u8, at: usize, shift: u32) usize {
  value := (#cast(u32, source[at]) << 16) | (#cast(u32, source[at + 1]) << 8) | #cast(u32, source[at + 2])
  // Multiplicative hashing wraps in 32 bits.
  hashed: u32 = #wrapping(value * 2654435761)
  return hashed >> shift
}

fn insert(encoder: *Encoder, source: []const u8, at: usize) usize {
  hash := hash_at(source, at, encoder.hash_shift)
  candidate := encoder.head[hash]
  encoder.previous[at & WindowMask] = candidate
  encoder.head[hash] = #cast(u32, at + 1)
  return candidate
}

struct Match { length: usize, distance: usize }

// Longest match for at along the chain starting at candidate (position + 1).
fn longest(encoder: *const Encoder, source: []const u8, at: usize, first: usize, previous_length: usize, level: Level) Match {
  best := Match{ length: previous_length }
  chain := level.chain
  if previous_length >= level.good {
    chain >>= 2
  }
  limit := #len(source) - at
  if limit > MaxMatch {
    limit = MaxMatch
  }
  candidate := first
  for candidate != 0 && chain > 0 {
    position := candidate - 1
    distance := at - position
    if distance > WindowSize || distance == 0 { break }
    if best.length < limit && source[position + best.length] == source[at + best.length] && source[position] == source[at] {
      length: usize = 0
      for length < limit && source[position + length] == source[at + length] {
        length += 1
      }
      if length > best.length {
        best = Match{ length: length, distance: distance }
        if length >= level.nice || length == limit { break }
      }
    }
    next := #cast(usize, encoder.previous[position & WindowMask])
    // Chains only go back; an entry at or past position is from an older
    // window slot reuse.
    if next == 0 || next - 1 >= position { break }
    candidate = next
    chain -= 1
  }
  if best.length < MinMatch || best.distance == 0 { return Match{} }
  return best
}

fn add_literal(encoder: *Encoder, byte: u8) {
  encoder.lengths[encoder.symbol_count] = 0
  encoder.values[encoder.symbol_count] = byte
  encoder.symbol_count += 1
  encoder.literal_counts[byte] += 1
}

fn add_match(encoder: *Encoder, length: usize, distance: usize) {
  encoder.lengths[encoder.symbol_count] = #cast(u16, length)
  encoder.values[encoder.symbol_count] = #cast(u16, distance)
  encoder.symbol_count += 1
  encoder.literal_counts[257 + #cast(usize, encoder.length_symbol[length])] += 1
  encoder.distance_counts[distance_code(encoder, distance)] += 1
}

// Raw DEFLATE stream of source into destination at level (1-9; others
// clamp). Fails with Capacity when destination is too small; deflate_bound
// always suffices.
// Compresses source into destination; the bytes written. Too small a
// destination fails with Capacity (deflate_bound always suffices).
pub fn deflate(status: *fail.Status, destination: []u8, source: []const u8, level: u8, encoder: *Encoder) []u8 {
  if status == nil { return deflate(&fail.Status{}, destination, source, level, encoder) }
  if status.failed { return destination[..0] }
  clamped := level
  if clamped < MinLevel {
    clamped = MinLevel
  }
  if clamped > MaxLevel {
    clamped = MaxLevel
  }
  parameters := level_parameters(clamped)
  hash_bits: u32 = 10
  for hash_bits < 15 && (#cast(usize, 1) << hash_bits) < #len(source) {
    hash_bits += 1
  }
  encoder.hash_shift = 32 - hash_bits
  for i in 0..#cast(usize, 1) << hash_bits {
    encoder.head[i] = 0
  }
  encoder.symbol_count = 0
  for i in 0..LiteralCodes {
    encoder.literal_counts[i] = 0
  }
  for i in 0..DistanceCodes {
    encoder.distance_counts[i] = 0
  }
  build_symbol_tables(encoder)
  bits := OutputBits{ destination: destination, ok: true }
  block_start: usize = 0
  at: usize = 0
  // Lazy matching: a match found at at waits one byte to see whether at + 1
  // has a longer one.
  waiting := false
  waiting_match := Match{}
  for at < #len(source) {
    first: usize = 0
    if #len(source) - at >= MinMatch {
      first = insert(encoder, source, at)
    }
    found := Match{}
    if first != 0 && (!waiting || waiting_match.length < parameters.lazy) {
      shortest := MinMatch - 1
      if waiting {
        shortest = waiting_match.length
      }
      found = longest(encoder, source, at, first, shortest, parameters)
      // A three-byte match far away costs more than three literals.
      if found.length == MinMatch && found.distance > 4096 {
        found = Match{}
      }
    }
    if parameters.lazy == 0 {
      if found.length >= MinMatch {
        add_match(encoder, found.length, found.distance)
        for k in 1..found.length {
          if #len(source) - (at + k) >= MinMatch {
            _ = insert(encoder, source, at + k)
          }
        }
        at += found.length
      } else {
        add_literal(encoder, source[at])
        at += 1
      }
    } else if waiting && found.length <= waiting_match.length {
      // The previous position's match wins; it began at at - 1.
      add_match(encoder, waiting_match.length, waiting_match.distance)
      end := at - 1 + waiting_match.length
      for k in at + 1..end {
        if #len(source) - k >= MinMatch {
          _ = insert(encoder, source, k)
        }
      }
      at = end
      waiting = false
    } else {
      if waiting {
        add_literal(encoder, source[at - 1])
      }
      if found.length >= MinMatch {
        waiting = true
        waiting_match = found
        at += 1
      } else {
        waiting = false
        add_literal(encoder, source[at])
        at += 1
      }
    }
    if encoder.symbol_count >= BlockSymbols - 2 {
      boundary := at
      if waiting {
        // The literal at at - 1 is still undecided: leave it to the next block.
        add_literal(encoder, source[at - 1])
        waiting = false
      }
      flush_block(encoder, &bits, source[block_start..boundary], false)
      block_start = boundary
    }
  }
  if waiting {
    add_match(encoder, waiting_match.length, waiting_match.distance)
  }
  flush_block(encoder, &bits, source[block_start..], true)
  align_bits(&bits)
  if !bits.ok {
    fail.set(status, fail.make(fail.Kind.Capacity, "compress", "", "the output does not fit destination"))
    return destination[..0]
  }
  return destination[..bits.written]
}
