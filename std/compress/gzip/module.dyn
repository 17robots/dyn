use "std/compress/deflate" deflate
use "std/io" stream

pub struct Result { written: usize, consumed: usize, ok: bool }
pub struct Decoder {
  source_reader: stream.Reader,
  compressed_storage: []u8,
  output_storage: []u8,
  compressed_used: usize,
  decompressed_used: usize,
  offset: usize,
  source_ended: bool,
  finished: bool,
  error: isize,
}

pub fn decompress(destination: []u8, source: []const u8) Result {
  result := deflate.gunzip_internal(destination, source)
  return Result{ written: result.written, consumed: result.consumed, ok: result.ok }
}

pub fn decoder(input: stream.Reader, compressed_bytes: []u8, output_bytes: []u8) Decoder {
  return Decoder{ source_reader: input, compressed_storage: compressed_bytes, output_storage: output_bytes }
}

fn decoder_read(data: rawptr, destination: []u8) stream.Result {
  state := #cast(*Decoder) data
  for state.offset == state.decompressed_used && !state.finished && state.error == 0 {
    if state.source_ended { state.error = -74 break }
    if state.compressed_used == #len(state.compressed_storage) { state.error = -28 break }
    input_result := stream.read(state.source_reader, state.compressed_storage[state.compressed_used..])
    if input_result.transferred > #len(state.compressed_storage) - state.compressed_used { state.error = -5 break }
    state.compressed_used += input_result.transferred
    if input_result.status == stream.Status.Error { state.error = input_result.error break }
    if input_result.status == stream.Status.End || input_result.transferred == 0 { state.source_ended = true }
    result := decompress(state.output_storage, state.compressed_storage[..state.compressed_used])
    if result.written < state.decompressed_used { state.error = -74 break }
    state.decompressed_used = result.written
    if result.ok { state.finished = true }
    else if state.source_ended { state.error = -74 }
  }
  if state.error != 0 { return stream.Result{ error: state.error, status: stream.Status.Error } }
  remaining := state.decompressed_used - state.offset
  amount := remaining
  if amount > #len(destination) { amount = #len(destination) }
  i: usize = 0 for i < amount { destination[i] = state.output_storage[state.offset + i] i += 1 }
  state.offset += amount
  status := stream.Status.Complete
  if state.finished && state.offset == state.decompressed_used { status = stream.Status.End }
  return stream.Result{ transferred: amount, status: status }
}

pub fn decoder_reader(state: *Decoder) stream.Reader {
  return stream.Reader{ data: #cast(rawptr) state, read: &decoder_read }
}
