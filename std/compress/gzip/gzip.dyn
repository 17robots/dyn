use mem "std/mem"
use deflate "std/compress/deflate"
use stream "std/io"
use hash "std/hash"
use parse "std/parse"

pub type Result = deflate.Result
pub type Decoder = deflate.Decoder

pub type Inflated = deflate.Inflated

// One member, into arena; consumed identifies the next member or trailing data.
pub fn decompress(arena: *mem.Arena, source: []const u8) Inflated!parse.ParseErr {
  return try deflate.gunzip(arena, source)
}
// Reads concatenated members through EOF, verifying every header/trailer.
// Buffers borrow caller storage. 1024 input + 33026 history bytes suffice.
// Returned output remains provisional until the reader reaches the end.
pub fn decoder(input: stream.Reader, compressed_bytes: []u8, history: []u8) Decoder {
  state := deflate.decoder(input, compressed_bytes, history)
  state.gzip = true
  return state
}
pub fn decoder_reader(state: *Decoder) stream.Reader {
  return deflate.decoder_reader(state)
}

pub type Encoder = deflate.Encoder

// Destination bytes that always hold write's output for size bytes.
pub fn compress_bound(size: usize) usize {
  return deflate.deflate_bound(size) + 18
}

// One gzip member (RFC 1952) holding source, compressed at level (1-9, see
// std/compress/deflate) into destination; the bytes written. Fails when
// destination is shorter than needed; compress_bound always suffices.
pub fn write(destination: []u8, source: []const u8, level: u8, encoder: *Encoder) []u8! {
  if destination.len < 18 { fail }
  header: [10]u8 = [0x1f, 0x8b, 8, 0, 0, 0, 0, 0, 0, 255]
  if level >= 9 {
    header[8] = 2
  } else if level <= 1 {
    header[8] = 4
  }
  for i in 0..10 {
    destination[i] = header[i]
  }
  body := try deflate.deflate(destination[10..destination.len - 8], source, level, encoder)
  at := 10 + body.len
  crc := hash.crc32(source)
  size := #cast(u32, source.len)
  for i in 0..4 {
    destination[at + i] = #cast(u8, crc >> #cast(u32, 8 * i))
    destination[at + 4 + i] = #cast(u8, size >> #cast(u32, 8 * i))
  }
  return destination[..at + 8]
}

// write with output in arena. The encoder workspace is taken from
// arena and given back; only the output stays. It cannot fail: the output
// is sized by compress_bound.
pub fn compress(arena: *mem.Arena, source: []const u8, level: u8) []u8 {
  output := mem.push_bytes(arena, compress_bound(source.len))
  mark := mem.arena_mark(arena)
  encoder := mem.push<Encoder>(arena)
  encoded := write(output, source, level, encoder) catch { #panic("gzip.compress: output sized by compress_bound") }
  mem.arena_rewind(arena, mark)
  return encoded
}
