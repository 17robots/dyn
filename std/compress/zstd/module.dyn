use "vendor/zstd" provider
use "std/io" stream
use "std/mem" memory
pub type Result = provider.Result
pub type SizeResult = provider.SizeResult
pub struct BufferResult { value: []u8, provider_code: usize, ok: bool }
pub struct Decoder {
  source_reader: stream.Reader,
  compressed_storage: []u8,
  output_storage: []u8,
  compressed_used: usize,
  output_used: usize,
  offset: usize,
  prepared: bool,
  error: isize,
}
pub fn version() u32 { return provider.version() }
pub fn compress_bound(source_size: usize) usize { return provider.compress_bound(source_size) }
pub fn compress_into(destination: []u8, source: []const u8, level: i32) Result { return provider.compress(destination, source, level) }
pub fn decompress_into(destination: []u8, source: []const u8) Result { return provider.decompress(destination, source) }
pub fn compress(arena: *memory.Arena, source: []const u8, level: i32) BufferResult {
  capacity := compress_bound(#len(source)) allocation := memory.arena_try_push_uninit(arena, capacity, 1)
  if !allocation.ok { return BufferResult{} }
  result := provider.compress(allocation.memory[..capacity], source, level)
  if !result.ok { return BufferResult{ provider_code: result.provider_code } }
  return BufferResult{ value: allocation.memory[..result.written], provider_code: result.provider_code, ok: true }
}
pub fn decompress(arena: *memory.Arena, source: []const u8) BufferResult {
  size := frame_size(source)
  if !size.ok || !size.known || size.size > 18446744073709551615 { return BufferResult{} }
  capacity := #cast(usize) size.size allocation := memory.arena_try_push_uninit(arena, capacity, 1)
  if !allocation.ok { return BufferResult{} }
  result := provider.decompress(allocation.memory[..capacity], source)
  if !result.ok { return BufferResult{ provider_code: result.provider_code } }
  return BufferResult{ value: allocation.memory[..result.written], provider_code: result.provider_code, ok: true }
}
pub fn frame_size(source: []const u8) SizeResult { return provider.frame_size(source) }
pub fn error_name(code: usize, maximum: usize) []const u8 { return provider.error_name(code, maximum) }

pub fn decoder(input: stream.Reader, compressed_bytes: []u8, output_bytes: []u8) Decoder {
  return Decoder{ source_reader: input, compressed_storage: compressed_bytes, output_storage: output_bytes }
}

fn decoder_read(data: rawptr, destination: []u8) stream.Result {
  state := #cast(*Decoder) data
  if !state.prepared {
    state.prepared = true
    for state.compressed_used < #len(state.compressed_storage) {
      input_result := stream.read(state.source_reader, state.compressed_storage[state.compressed_used..])
      if input_result.transferred > #len(state.compressed_storage) - state.compressed_used { state.error = -5 break }
      state.compressed_used += input_result.transferred
      if input_result.status == stream.Status.Error { state.error = input_result.error break }
      if input_result.status == stream.Status.End { break }
      if input_result.transferred == 0 { state.error = -5 break }
    }
    if state.error == 0 && state.compressed_used == #len(state.compressed_storage) { state.error = -28 }
    if state.error == 0 {
      decoded := provider.decompress(state.output_storage, state.compressed_storage[..state.compressed_used])
      if !decoded.ok { state.error = -74 } else { state.output_used = decoded.written }
    }
  }
  if state.error != 0 { return stream.Result{ error: state.error, status: stream.Status.Error } }
  remaining := state.output_used - state.offset
  amount := remaining
  if amount > #len(destination) { amount = #len(destination) }
  i: usize = 0 for i < amount { destination[i] = state.output_storage[state.offset + i] i += 1 }
  state.offset += amount
  status := stream.Status.Complete
  if state.offset == state.output_used { status = stream.Status.End }
  return stream.Result{ transferred: amount, status: status }
}

pub fn decoder_reader(state: *Decoder) stream.Reader {
  return stream.Reader{ data: #cast(rawptr) state, read: &decoder_read }
}
