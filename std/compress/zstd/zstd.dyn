use provider "vendor/zstd"
use stream "std/io"
use memory "std/mem"
// A frame's decompressed size, when the frame header records it.
pub struct FrameSize { size: u64, known: bool }
// A failed decoder stays failed: later reads report the same failure.
pub struct Decoder {
  source_reader: stream.Reader,
  compressed_storage: []u8,
  context: provider.StreamContext,
  used: usize,
  offset: usize,
  source_ended: bool,
  frame_ended: bool,
  saw_frame: bool,
  finished: bool,
  failed: bool,
  failure: stream.IoErr,
}
pub fn version() u32 {
  return provider.version()
}
pub fn compress_bound(source_size: usize) usize {
  return provider.compress_bound(source_size)
}
// Compresses source into arena at level.
pub fn compress(arena: *memory.Arena, source: []const u8, level: i32) []u8!stream.IoErr {
  mark := memory.arena_mark(arena)
  capacity := compress_bound(source.len)
  allocation := memory.push_bytes(arena, capacity)
  written := provider.compress(allocation, source, level) catch err {
    memory.arena_rewind(arena, mark)
    fail err
  }
  return allocation[..written]
}
// One frame whose header records its size, into arena. A frame without a
// recorded size fails with Unsupported: use the streaming decoder. A frame
// larger than memory fails with Capacity, malformed data with InvalidInput.
pub fn decompress(arena: *memory.Arena, source: []const u8) []u8!stream.IoErr {
  mark := memory.arena_mark(arena)
  size := try frame_size(source)
  if !size.known { fail .Unsupported }
  if size.size > #max(usize) { fail .Capacity }
  capacity := #cast(usize, size.size)
  allocation := memory.push_bytes(arena, capacity)
  written := provider.decompress(allocation, source) catch err {
    memory.arena_rewind(arena, mark)
    fail err
  }
  return allocation[..written]
}
pub fn frame_size(source: []const u8) FrameSize!stream.IoErr {
  size := try provider.frame_size(source)
  return FrameSize{ size: size.size, known: size.known }
}
pub fn error_name(code: usize, maximum: usize) []const u8 {
  return provider.error_name(code, maximum)
}

// Workspace and input storage must remain alive and disjoint from output.
// window_log bounds native history to 2^window_log bytes; no hidden heap
// allocation. Too small a workspace or no compressed storage fails the
// first read with Capacity.
pub fn decoder_workspace_size(window_log: u32) usize {
  return provider.stream_workspace_size(window_log)
}
pub fn decoder(input: stream.Reader, compressed_bytes: []u8, workspace: []u8, window_log: u32) Decoder {
  state := Decoder{ source_reader: input, compressed_storage: compressed_bytes }
  context := provider.stream_context(workspace, window_log) catch err {
    state.failed = true
    state.failure = err
    return state
  }
  state.context = context
  if compressed_bytes.len == 0 {
    state.failed = true
    state.failure = stream.IoErr.Capacity
  }
  return state
}
// Stops the decoder for good and returns err for the caller to fail with.
fn decoder_failed(state: *Decoder, err: stream.IoErr) stream.IoErr {
  state.failed = true
  state.failure = err
  return err
}
fn decoder_read(data: rawptr, destination: []u8) usize!stream.IoErr {
  state := #cast(*Decoder, data)
  if state.failed { fail state.failure }
  if state.offset > state.used || state.used > state.compressed_storage.len {
    #panic("zstd: decoder positions are out of range")
  }
  if destination.len == 0 || state.finished { return 0 }
  for {
    // First flush provider output, even with no new input. Reading the next chunk
    // before doing so would stall a caller while output is already available.
    decoded := provider.stream_decode(&state.context, destination, state.compressed_storage[state.offset..state.used]) catch err {
      fail decoder_failed(state, err)
    }
    state.offset += decoded.consumed
    if decoded.ended {
      state.frame_ended = true
      state.saw_frame = true
    } else if decoded.consumed != 0 || decoded.written != 0 {
      state.frame_ended = false
    }
    if decoded.written != 0 { return decoded.written }
    if state.offset < state.used {
      // The decoder made no progress.
      if decoded.consumed == 0 { fail decoder_failed(state, stream.IoErr.System(0)) }
      continue
    }
    if state.source_ended {
      if state.saw_frame && state.frame_ended {
        state.finished = true
        return 0
      }
      // The input ends inside a frame.
      fail decoder_failed(state, stream.IoErr.InvalidInput)
    }
    count := stream.read(state.source_reader, state.compressed_storage) catch err {
      fail decoder_failed(state, err)
    }
    state.offset = 0
    state.used = count
    if count == 0 {
      state.source_ended = true
    }
  }
  return 0
}
pub fn decoder_reader(state: *Decoder) stream.Reader {
  return stream.Reader{ data: state, read: decoder_read }
}
