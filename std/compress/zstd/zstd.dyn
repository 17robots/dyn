use "vendor/zstd" provider
use "std/fail"
use "std/io" stream
use "std/mem" memory
// A frame's decompressed size, when the frame header records it.
pub struct FrameSize { size: u64, known: bool }
// A failed decoder stays failed: later reads report the same failure.
pub struct Decoder {
  source_reader: stream.Reader,
  compressed_storage: []u8,
  context: provider.StreamContext,
  used: usize,
  offset: usize,
  source_ended: bool,
  frame_ended: bool,
  saw_frame: bool,
  finished: bool,
  failed: bool,
  failure: fail.Failure,
}
pub fn version() u32 {
  return provider.version()
}
pub fn compress_bound(source_size: usize) usize {
  return provider.compress_bound(source_size)
}
// Compresses source into arena at level.
pub fn compress(arena: *memory.Arena, status: *fail.Status, source: []const u8, level: i32) []u8 {
  empty: []u8
  if status.failed { return empty }
  mark := memory.arena_mark(arena)
  capacity := compress_bound(#len(source))
  allocation := memory.push_bytes(arena, capacity)
  written := provider.compress(status, allocation, source, level)
  if status.failed {
    memory.arena_rewind(arena, mark)
    return empty
  }
  return allocation[..written]
}
// One frame whose header records its size, into arena. A frame without a
// recorded size fails with Unsupported: use the streaming decoder.
pub fn decompress(arena: *memory.Arena, status: *fail.Status, source: []const u8) []u8 {
  empty: []u8
  if status.failed { return empty }
  mark := memory.arena_mark(arena)
  size := frame_size(status, source)
  if status.failed { return empty }
  if !size.known {
    fail.set(status, fail.make(fail.Kind.Unsupported, "decompress", "", "the frame does not record its size"))
    return empty
  }
  if size.size > #max(usize) {
    fail.set(status, fail.make(fail.Kind.Overflow, "decompress", "", "the frame is too large"))
    return empty
  }
  capacity := #cast(usize, size.size)
  allocation := memory.push_bytes(arena, capacity)
  written := provider.decompress(status, allocation, source)
  if status.failed {
    memory.arena_rewind(arena, mark)
    return empty
  }
  return allocation[..written]
}
pub fn frame_size(status: *fail.Status, source: []const u8) FrameSize {
  size := provider.frame_size(status, source)
  return FrameSize{ size: size.size, known: size.known }
}
pub fn error_name(code: usize, maximum: usize) []const u8 {
  return provider.error_name(code, maximum)
}

// Workspace and input storage must remain alive and disjoint from output.
// window_log bounds native history to 2^window_log bytes; no hidden heap
// allocation. Too small a workspace or no compressed storage fails the
// first read with Capacity.
pub fn decoder_workspace_size(window_log: u32) usize {
  return provider.stream_workspace_size(window_log)
}
pub fn decoder(input: stream.Reader, compressed_bytes: []u8, workspace: []u8, window_log: u32) Decoder {
  starting: fail.Status
  context := provider.stream_context(&starting, workspace, window_log)
  state := Decoder{ source_reader: input, compressed_storage: compressed_bytes, context: context }
  if starting.failed {
    state.failed = true
    state.failure = starting.failure
  } else if #len(compressed_bytes) == 0 {
    state.failed = true
    state.failure = fail.make(fail.Kind.Capacity, "decompress", "", "no input storage")
  }
  return state
}
fn decoder_failed(status: *fail.Status, state: *Decoder) usize {
  state.failed = true
  state.failure = status.failure
  return 0
}
fn decoder_read(data: rawptr, status: *fail.Status, destination: []u8) usize {
  state := #cast(*Decoder, data)
  if status.failed { return 0 }
  if state.failed {
    fail.set(status, state.failure)
    return 0
  }
  if state.offset > state.used || state.used > #len(state.compressed_storage) {
    fail.set(status, fail.make(fail.Kind.InvalidState, "decompress", "", "the decoder positions are out of range"))
    return decoder_failed(status, state)
  }
  if #len(destination) == 0 || state.finished { return 0 }
  for {
    // First flush provider output, even with no new input. Reading the next chunk
    // before doing so would stall a caller while output is already available.
    decoded := provider.stream_decode(status, &state.context, destination, state.compressed_storage[state.offset..state.used])
    if status.failed {
      status.failure.offset = state.offset
      status.failure.has_offset = true
      return decoder_failed(status, state)
    }
    state.offset += decoded.consumed
    if decoded.ended {
      state.frame_ended = true
      state.saw_frame = true
    } else if decoded.consumed != 0 || decoded.written != 0 {
      state.frame_ended = false
    }
    if decoded.written != 0 { return decoded.written }
    if state.offset < state.used {
      if decoded.consumed == 0 {
        fail.set(status, fail.make(fail.Kind.System, "decompress", "", "the decoder made no progress"))
        return decoder_failed(status, state)
      }
      continue
    }
    if state.source_ended {
      if state.saw_frame && state.frame_ended {
        state.finished = true
        return 0
      }
      fail.at(status, fail.Kind.InvalidInput, "decompress", "the input ends inside a frame", state.offset)
      return decoder_failed(status, state)
    }
    count := stream.read(status, state.source_reader, state.compressed_storage)
    state.offset = 0
    state.used = count
    if status.failed { return decoder_failed(status, state) }
    if count == 0 {
      state.source_ended = true
    }
  }
  return 0
}
pub fn decoder_reader(state: *Decoder) stream.Reader {
  return stream.Reader{ data: state, read: decoder_read }
}
