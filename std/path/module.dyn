// Slash-separated lexical paths. Operations do not access filesystem.
pub struct Result { value: []u8, ok: bool }

pub fn basename(path: []const u8) []const u8 {
  end := #len(path)
  for end > 1 && path[end - 1] == '/' { end -= 1 }
  if end == 1 && path[0] == '/' { return path[..1] }
  start := end
  for start > 0 && path[start - 1] != '/' { start -= 1 }
  return path[start..end]
}
pub fn dirname(path: []const u8) []const u8 {
  end := #len(path)
  for end > 1 && path[end - 1] == '/' { end -= 1 }
  for end > 0 && path[end - 1] != '/' { end -= 1 }
  for end > 1 && path[end - 1] == '/' { end -= 1 }
  if end == 0 { return "." }
  return path[..end]
}
pub fn extension(path: []const u8) []const u8 {
  name := basename(path)
  i := #len(name)
  for i > 0 { i -= 1 if name[i] == '.' { if i == 0 { return "" } return name[i..] } }
  return ""
}
pub fn is_absolute(path: []const u8) bool { return #len(path) > 0 && path[0] == '/' }

pub fn join(destination: []u8, left: []const u8, right: []const u8) Result {
  separator := #len(left) > 0 && left[#len(left) - 1] != '/' && #len(right) > 0 && right[0] != '/'
  maximum: usize = 18446744073709551615
  if #len(left) > maximum - #len(right) { return Result{ value: destination[..0], ok: false } }
  needed := #len(left) + #len(right)
  if separator { if needed == maximum { return Result{ value: destination[..0], ok: false } } needed += 1 }
  if needed > #len(destination) { return Result{ value: destination[..0], ok: false } }
  at: usize = 0
  for left_byte in left { destination[at] = left_byte at += 1 }
  if separator { destination[at] = '/' at += 1 }
  for right_byte in right { destination[at] = right_byte at += 1 }
  return Result{ value: destination[..at], ok: true }
}

pub fn clean(destination: []u8, path: []const u8) Result {
  if #len(destination) == 0 { return Result{ value: destination[..0], ok: false } }
  absolute := is_absolute(path)
  at: usize = 0
  if absolute { destination[at] = '/' at += 1 }
  i: usize = 0
  for i < #len(path) {
    for i < #len(path) && path[i] == '/' { i += 1 }
    start := i
    for i < #len(path) && path[i] != '/' { i += 1 }
    length := i - start
    if length == 0 || (length == 1 && path[start] == '.') { }
    else if length == 2 && path[start] == '.' && path[start + 1] == '.' {
      floor: usize = 0
      if absolute { floor = 1 }
      if at > floor {
        if destination[at - 1] == '/' { at -= 1 }
        for at > floor && destination[at - 1] != '/' { at -= 1 }
      } else if !absolute {
        if at > 0 { if at == #len(destination) { return Result{ value: destination[..0], ok: false } } destination[at] = '/' at += 1 }
        if at + 2 > #len(destination) { return Result{ value: destination[..0], ok: false } }
        destination[at] = '.' destination[at + 1] = '.' at += 2
      }
    } else {
      if at > 0 && destination[at - 1] != '/' {
        if at == #len(destination) { return Result{ value: destination[..0], ok: false } }
        destination[at] = '/' at += 1
      }
      if length > #len(destination) - at { return Result{ value: destination[..0], ok: false } }
      j: usize = 0
      for j < length { destination[at] = path[start + j] at += 1 j += 1 }
    }
  }
  if at == 0 { destination[0] = '.' at = 1 }
  return Result{ value: destination[..at], ok: true }
}

pub fn safe_join(destination: []u8, root: []const u8, child: []const u8) Result {
  if is_absolute(child) { return Result{ value: destination[..0], ok: false } }
  temporary: [4096]u8 = [] root_storage: [4096]u8 = []
  combined := join(temporary[..], root, child)
  if !combined.ok { return Result{ value: destination[..0], ok: false } }
  normalized := clean(destination, combined.value)
  normalized_root := clean(root_storage[..], root)
  if !normalized.ok || !normalized_root.ok || #len(normalized.value) < #len(normalized_root.value) {
    return Result{ value: destination[..0], ok: false }
  }
  i: usize = 0
  for i < #len(normalized_root.value) {
    if normalized.value[i] != normalized_root.value[i] { return Result{ value: destination[..0], ok: false } }
    i += 1
  }
  if #len(normalized.value) > #len(normalized_root.value) &&
    normalized_root.value[#len(normalized_root.value) - 1] != '/' &&
    normalized.value[#len(normalized_root.value)] != '/' {
    return Result{ value: destination[..0], ok: false }
  }
  return normalized
}
