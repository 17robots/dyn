use mem "std/mem"
use "std/bytes"

// Slash-separated lexical paths. Operations do not access filesystem.
// A bounded producer's output; valid is false when it did not fit or the
// input was rejected.
struct Built { value: []u8, valid: bool }

pub fn basename(path: []const u8) []const u8 {
  end := path.len
  for end > 1 && path[end - 1] == '/' {
    end -= 1
  }
  if end == 1 && path[0] == '/' { return path[..1] }
  start := end
  for start > 0 && path[start - 1] != '/' {
    start -= 1
  }
  return path[start..end]
}
pub fn dirname(path: []const u8) []const u8 {
  end := path.len
  for end > 1 && path[end - 1] == '/' {
    end -= 1
  }
  for end > 0 && path[end - 1] != '/' {
    end -= 1
  }
  for end > 1 && path[end - 1] == '/' {
    end -= 1
  }
  if end == 0 { return "." }
  return path[..end]
}
pub fn extension(path: []const u8) []const u8 {
  name := basename(path)
  i := name.len
  for i > 0 {
    i -= 1
    if name[i] == '.' {
      if i == 0 { return "" }
      return name[i..]
    }
  }
  return ""
}
pub fn is_absolute(path: []const u8) bool {
  return path.len > 0 && path[0] == '/'
}

fn join_into(destination: []u8, left: []const u8, right: []const u8) Built {
  separator := left.len > 0 && left[left.len - 1] != '/' && right.len > 0 && right[0] != '/'
  maximum := #max(usize)
  if left.len > maximum - right.len { return Built{ value: destination[..0], valid: false } }
  needed := left.len + right.len
  if separator {
    if needed == maximum { return Built{ value: destination[..0], valid: false } }
    needed += 1
  }
  if needed > destination.len { return Built{ value: destination[..0], valid: false } }
  at: usize = 0
  for left_byte in left {
    destination[at] = left_byte
    at += 1
  }
  if separator {
    destination[at] = '/'
    at += 1
  }
  for right_byte in right {
    destination[at] = right_byte
    at += 1
  }
  return Built{ value: destination[..at], valid: true }
}

fn clean_into(destination: []u8, path: []const u8) Built {
  if destination.len == 0 { return Built{ value: destination[..0], valid: false } }
  absolute := is_absolute(path)
  at: usize = 0
  if absolute {
    destination[at] = '/'
    at += 1
  }
  i: usize = 0
  for i < path.len {
    for i < path.len && path[i] == '/' {
      i += 1
    }
    start := i
    for i < path.len && path[i] != '/' {
      i += 1
    }
    length := i - start
    if length == 0 || (length == 1 && path[start] == '.') { } else if length == 2 && path[start] == '.' && path[start + 1] == '.' {
      floor: usize = 0
      if absolute {
        floor = 1
      }
      previous := at
      for previous > floor && destination[previous - 1] != '/' {
        previous -= 1
      }
      parent := at - previous == 2 && destination[previous] == '.' && destination[previous + 1] == '.'
      if at > floor && !parent {
        at = previous
        if at > floor {
          at -= 1
        }
      } else if !absolute {
        if at > 0 {
          if at == destination.len { return Built{ value: destination[..0], valid: false } }
          destination[at] = '/'
          at += 1
        }
        if at + 2 > destination.len { return Built{ value: destination[..0], valid: false } }
        destination[at] = '.'
        destination[at + 1] = '.'
        at += 2
      }
    } else {
      if at > 0 && destination[at - 1] != '/' {
        if at == destination.len { return Built{ value: destination[..0], valid: false } }
        destination[at] = '/'
        at += 1
      }
      if length > destination.len - at { return Built{ value: destination[..0], valid: false } }
      for j in 0..length {
        destination[at] = path[start + j]
        at += 1
      }
    }
  }
  if at == 0 {
    destination[0] = '.'
    at = 1
  }
  return Built{ value: destination[..at], valid: true }
}

fn safe_join_into(destination: []u8, root: []const u8, child: []const u8) Built {
  if is_absolute(child) { return Built{ value: destination[..0], valid: false } }
  temporary: [4096]u8
  root_storage: [4096]u8
  combined := join_into(temporary[..], root, child)
  if !combined.valid { return Built{ value: destination[..0], valid: false } }
  normalized := clean_into(destination, combined.value)
  normalized_root := clean_into(root_storage[..], root)
  if !normalized.valid || !normalized_root.valid || normalized.value.len < normalized_root.value.len {
    return Built{ value: destination[..0], valid: false }
  }
  if bytes.equal(normalized_root.value, ".") {
    if bytes.equal(normalized.value, "..") || (normalized.value.len >= 3 && bytes.equal(normalized.value[..3], "../")) {
      return Built{ value: destination[..0] }
    }
    return normalized
  }
  i: usize = 0
  for i < normalized_root.value.len {
    if normalized.value[i] != normalized_root.value[i] {
      return Built{ value: destination[..0], valid: false }
    }
    i += 1
  }
  if normalized.value.len > normalized_root.value.len &&
    normalized_root.value[normalized_root.value.len - 1] != '/' &&
    normalized.value[normalized_root.value.len] != '/' {
    return Built{ value: destination[..0], valid: false }
  }
  return normalized
}

// start is where the last component returned begins. ended turns true when
// component_next finds no component left; that call returns "".
pub struct Components { text: []const u8, offset: usize, start: usize, ended: bool }
pub fn components(text: []const u8) Components {
  return Components{ text: text }
}
pub fn component_next(state: *Components) []const u8 {
  for state.offset < state.text.len && state.text[state.offset] == '/' {
    state.offset += 1
  }
  start := state.offset
  for state.offset < state.text.len && state.text[state.offset] != '/' {
    state.offset += 1
  }
  if start == state.offset {
    state.ended = true
    return ""
  }
  state.start = start
  return state.text[start..state.offset]
}

// Lexical relative path, for normalized inputs up to 4096 bytes each.
// Absolute and relative roots cannot be mixed. No filesystem access occurs.
fn relative_into(destination: []u8, base: []const u8, target: []const u8) Built {
  base_storage: [4096]u8
  target_storage: [4096]u8
  left := clean_into(base_storage[..], base)
  right := clean_into(target_storage[..], target)
  if !left.valid || !right.valid || is_absolute(left.value) != is_absolute(right.value) {
    return Built{ value: destination[..0] }
  }
  left_text: []const u8 = left.value
  right_text: []const u8 = right.value
  if bytes.equal(left_text, ".") {
    left_text = ""
  }
  if bytes.equal(right_text, ".") {
    right_text = ""
  }
  left_parts := components(left_text)
  right_parts := components(right_text)
  parents: usize = 0
  remainder: []const u8 = ""
  for {
    left_part := component_next(&left_parts)
    right_part := component_next(&right_parts)
    if !left_parts.ended && !right_parts.ended && bytes.equal(left_part, right_part) { continue }
    if !left_parts.ended && bytes.equal(left_part, "..") { return Built{ value: destination[..0] } }
    if !left_parts.ended {
      parents = 1
      for {
        _ = component_next(&left_parts)
        if left_parts.ended { break }
        parents += 1
      }
    }
    if !right_parts.ended {
      remainder = right_text[right_parts.start..]
    }
    break
  }
  needed := parents * 3 + remainder.len
  if parents > 0 && remainder.len == 0 {
    needed -= 1
  }
  if needed == 0 {
    needed = 1
  }
  if needed > destination.len { return Built{ value: destination[..0] } }
  at: usize = 0
  for i in 0..parents {
    destination[at] = '.'
    destination[at + 1] = '.'
    at += 2
    if i + 1 < parents || remainder.len > 0 {
      destination[at] = '/'
      at += 1
    }
  }
  for byte in remainder {
    destination[at] = byte
    at += 1
  }
  if at == 0 {
    destination[at] = '.'
    at += 1
  }
  return Built{ value: destination[..at], valid: true }
}

// Keeps only the bytes a bounded producer used, or nothing on failure.
fn finish(arena: *mem.Arena, mark: usize, result: Built) Built {
  if !result.valid {
    mem.arena_rewind(arena, mark)
    return Built{}
  }
  mem.arena_rewind(arena, mark + result.value.len)
  return result
}

// left and right joined by one slash, in arena.
pub fn join(arena: *mem.Arena, left: []const u8, right: []const u8) []u8 {
  mark := mem.arena_mark(arena)
  space := mem.push_bytes(arena, left.len + right.len + 1)
  // The space fits any join, so join_into cannot fail here.
  return finish(arena, mark, join_into(space, left, right)).value
}

// path with . and .. resolved and repeated slashes removed, in arena.
pub fn clean(arena: *mem.Arena, path: []const u8) []u8 {
  mark := mem.arena_mark(arena)
  space := mem.push_bytes(arena, path.len + 1)
  // The space fits any cleaned path, so clean_into cannot fail here.
  return finish(arena, mark, clean_into(space, path)).value
}

// root joined with a relative child that cannot climb out of root, in arena.
// A child that is absolute or escapes root fails, pushing nothing.
pub fn safe_join(arena: *mem.Arena, root: []const u8, child: []const u8) []u8! {
  mark := mem.arena_mark(arena)
  space := mem.push_bytes(arena, root.len + child.len + 2)
  joined := finish(arena, mark, safe_join_into(space, root, child))
  if !joined.valid { fail }
  return joined.value
}

// The path from base to target, in arena. Both must be absolute or both
// relative, and at most 4096 bytes; anything else fails, pushing nothing.
pub fn relative(arena: *mem.Arena, base: []const u8, target: []const u8) []u8! {
  mark := mem.arena_mark(arena)
  space := mem.push_bytes(arena, 3 * base.len + target.len + 2)
  result := finish(arena, mark, relative_into(space, base, target))
  if !result.valid { fail }
  return result.value
}
