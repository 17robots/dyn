use "std/fail"
use "std/io" io
use "std/mem" memory
use "std/text/template" core

pub type Template = core.Template
pub type Field = core.Field

pub fn parse(arena: *memory.Arena, status: *fail.Status, source: []const u8) Template {
  return core.parse(arena, status, source)
}

fn write_escaped(status: *fail.Status, destination: io.Writer, source: []const u8) {
  start: usize = 0
  for i in 0..#len(source) {
    replacement: []const u8 = ""
    if source[i] == '&' {
      replacement = "&amp;"
    } else if source[i] == '<' {
      replacement = "&lt;"
    } else if source[i] == '>' {
      replacement = "&gt;"
    } else if source[i] == '"' {
      replacement = "&quot;"
    } else if source[i] == 39 {
      replacement = "&#39;"
    }
    if #len(replacement) > 0 {
      if i > start {
        io.write(status, destination, source[start..i])
      }
      io.write(status, destination, replacement)
      if status.failed { return }
      start = i + 1
    }
  }
  if start < #len(source) {
    io.write(status, destination, source[start..])
  }
}

// Escapes text and quoted attribute values. Not a JS/CSS/URL-context sanitizer.
pub fn render(status: *fail.Status, destination: io.Writer, template: *const Template, fields: []const Field) {
  core.render_with(status, destination, template, fields, write_escaped)
}
