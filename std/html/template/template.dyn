use parse "std/parse"
use io "std/io"
use memory "std/mem"
use core "std/text/template"

pub type Template = core.Template
pub type Field = core.Field

pub fn parse(arena: *memory.Arena, source: []const u8) Template!parse.ParseErr {
  return try core.parse(arena, source)
}

fn write_escaped(destination: io.Writer, source: []const u8) !io.IoErr {
  start: usize = 0
  for i in 0..source.len {
    replacement: []const u8 = ""
    if source[i] == '&' {
      replacement = "&amp;"
    } else if source[i] == '<' {
      replacement = "&lt;"
    } else if source[i] == '>' {
      replacement = "&gt;"
    } else if source[i] == '"' {
      replacement = "&quot;"
    } else if source[i] == 39 {
      replacement = "&#39;"
    }
    if replacement.len > 0 {
      if i > start {
        try io.write(destination, source[start..i])
      }
      try io.write(destination, replacement)
      start = i + 1
    }
  }
  if start < source.len {
    try io.write(destination, source[start..])
  }
}

// Escapes text and quoted attribute values. Not a JS/CSS/URL-context sanitizer.
pub fn render(destination: io.Writer, template: *const Template, fields: []const Field) !io.IoErr {
  try core.render_with(destination, template, fields, write_escaped)
}
