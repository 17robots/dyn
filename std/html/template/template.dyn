use "std/fail"
use io "std/io"
use memory "std/mem"
use core "std/text/template"

pub type Template = core.Template
pub type Field = core.Field

pub fn parse(arena: *memory.Arena, status: *fail.Status, source: []const u8) Template {
  if status == nil { return parse(arena, &fail.Status{}, source) }
  return core.parse(arena, status, source)
}

fn write_escaped(status: *fail.Status, destination: io.Writer, source: []const u8) {
  start: usize = 0
  for i in 0..source.len {
    replacement: []const u8 = ""
    if source[i] == '&' {
      replacement = "&amp;"
    } else if source[i] == '<' {
      replacement = "&lt;"
    } else if source[i] == '>' {
      replacement = "&gt;"
    } else if source[i] == '"' {
      replacement = "&quot;"
    } else if source[i] == 39 {
      replacement = "&#39;"
    }
    if replacement.len > 0 {
      if i > start {
        io.write_status(status, destination, source[start..i])
      }
      io.write_status(status, destination, replacement)
      if status.failed { return }
      start = i + 1
    }
  }
  if start < source.len {
    io.write_status(status, destination, source[start..])
  }
}

// Escapes text and quoted attribute values. Not a JS/CSS/URL-context sanitizer.
pub fn render(status: *fail.Status, destination: io.Writer, template: *const Template, fields: []const Field) {
  if status == nil {
    render(&fail.Status{}, destination, template, fields)
    return
  }
  core.render_with(status, destination, template, fields, write_escaped)
}
