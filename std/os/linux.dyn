module linux

sysnums := use "std/os/linux/syscall"
runtime := use "std/os/runtime"

pub SysError := enum {
    PermissionDenied,
    NotFound,
    Interrupted,
    Io,
    BadFd,
    Again,
    NoMemory,
    AccessDenied,
    Invalid,
    NotImplemented,
    Unknown,
}

pub sys_read := () isize => sysnums.read()
pub sys_write := () isize => sysnums.write()
pub sys_openat := () isize => sysnums.openat()
pub sys_close := () isize => sysnums.close()
pub sys_getpid := () isize => sysnums.getpid()
pub sys_exit := () isize => sysnums.exit()
pub at_fdcwd := () isize => $as(isize, -100)
pub o_rdonly := () isize => 0
pub o_wronly := () isize => 1
pub o_rdwr := () isize => 2
pub o_creat := () isize => 64
pub o_trunc := () isize => 512

rt_linux_syscall0 := extern fn(number: isize) isize = "dynrt_linux_syscall0"
rt_linux_syscall1 := extern fn(number: isize, arg0: isize) isize = "dynrt_linux_syscall1"
rt_linux_syscall2 := extern fn(number: isize, arg0: isize, arg1: isize) isize = "dynrt_linux_syscall2"
rt_linux_syscall3 :=
    extern fn(number: isize, arg0: isize, arg1: isize, arg2: isize) isize = "dynrt_linux_syscall3"
rt_linux_syscall4 :=
    extern fn(number: isize, arg0: isize, arg1: isize, arg2: isize, arg3: isize) isize = "dynrt_linux_syscall4"
rt_linux_syscall5 := extern fn(number: isize, arg0: isize, arg1: isize, arg2: isize, arg3: isize, arg4: isize) isize = "dynrt_linux_syscall5"
rt_linux_syscall6 := extern fn(number: isize, arg0: isize, arg1: isize, arg2: isize, arg3: isize, arg4: isize, arg5: isize) isize = "dynrt_linux_syscall6"
rt_linux_errno := extern fn() isize = "dynrt_linux_errno"

pub syscall0 := (number: isize) isize => rt_linux_syscall0(number)
pub syscall1 := (number: isize, arg0: isize) isize => rt_linux_syscall1(number, arg0)
pub syscall2 := (number: isize, arg0: isize, arg1: isize) isize => rt_linux_syscall2(number, arg0, arg1)
pub syscall3 := (number: isize, arg0: isize, arg1: isize, arg2: isize) isize => rt_linux_syscall3(number, arg0, arg1, arg2)
pub syscall4 := (number: isize, arg0: isize, arg1: isize, arg2: isize, arg3: isize) isize => rt_linux_syscall4(number, arg0, arg1, arg2, arg3)
pub syscall5 := (
    number: isize,
    arg0: isize,
    arg1: isize,
    arg2: isize,
    arg3: isize,
    arg4: isize,
) isize => rt_linux_syscall5(number, arg0, arg1, arg2, arg3, arg4)
pub syscall6 := (
    number: isize,
    arg0: isize,
    arg1: isize,
    arg2: isize,
    arg3: isize,
    arg4: isize,
    arg5: isize,
) isize => rt_linux_syscall6(number, arg0, arg1, arg2, arg3, arg4, arg5)
pub errno := () isize => rt_linux_errno()
pub errno_to_error := (code: isize) SysError {
    if code == 1 return .PermissionDenied
    if code == 2 return .NotFound
    if code == 4 return .Interrupted
    if code == 5 return .Io
    if code == 9 return .BadFd
    if code == 11 return .Again
    if code == 12 return .NoMemory
    if code == 13 return .AccessDenied
    if code == 22 return .Invalid
    if code == 38 return .NotImplemented
    return .Unknown
}
pub syscall_result := (rc: isize) isize!SysError {
    if rc >= 0 return rc
    return errno_to_error(errno())
}
pub syscall0_checked := (number: isize) isize!SysError => syscall_result(syscall0(number))
pub syscall1_checked := (number: isize, arg0: isize) isize!SysError => syscall_result(syscall1(number, arg0))
pub syscall2_checked := (number: isize, arg0: isize, arg1: isize) isize!SysError => syscall_result(syscall2(number, arg0, arg1))
pub syscall3_checked := (number: isize, arg0: isize, arg1: isize, arg2: isize) isize!SysError => syscall_result(syscall3(number, arg0, arg1, arg2))
pub syscall4_checked := (
    number: isize,
    arg0: isize,
    arg1: isize,
    arg2: isize,
    arg3: isize,
) isize!SysError => syscall_result(syscall4(number, arg0, arg1, arg2, arg3))

pub syscall5_checked := (
    number: isize,
    arg0: isize,
    arg1: isize,
    arg2: isize,
    arg3: isize,
    arg4: isize,
) isize!SysError => syscall_result(syscall5(number, arg0, arg1, arg2, arg3, arg4))
pub syscall6_checked := (
    number: isize,
    arg0: isize,
    arg1: isize,
    arg2: isize,
    arg3: isize,
    arg4: isize,
    arg5: isize,
) isize!SysError => syscall_result(syscall6(number, arg0, arg1, arg2, arg3, arg4, arg5))
pub openat_raw := (
    dirfd: isize,
    path_ptr: isize,
    flags: isize,
    mode: isize,
) isize => syscall4(sys_openat(), dirfd, path_ptr, flags, mode)
pub openat_checked := (
    dirfd: isize,
    path_ptr: isize,
    flags: isize,
    mode: isize,
) isize!SysError => syscall4_checked(sys_openat(), dirfd, path_ptr, flags, mode)
pub openat_z := (
    dirfd: isize,
    path_z: []u8,
    flags: isize,
    mode: isize,
) isize!SysError {
    path_ptr := $as(isize, $as(usize, path_z))
    return openat_checked(dirfd, path_ptr, flags, mode)
}
pub fd_read_raw := (fd: isize, buf_ptr: isize, len: isize) isize => syscall3(sys_read(), fd, buf_ptr, len)
pub fd_read_checked := (fd: isize, buf_ptr: isize, len: isize) isize!SysError => syscall3_checked(sys_read(), fd, buf_ptr, len)
pub fd_close_raw := (fd: isize) isize => syscall1(sys_close(), fd)
pub fd_close_checked := (fd: isize) isize!SysError => syscall1_checked(sys_close(), fd)
pub fd_write_raw := (fd: isize, value: []u8) isize {
    ptr := $as(isize, $as(usize, value))
    len := $as(isize, runtime.bytes_len(value))
    return fd_write_ptr_raw(fd, ptr, len)
}
pub fd_write_ptr_raw := (fd: isize, ptr: isize, len: isize) isize => syscall3(sys_write(), fd, ptr, len)
pub fd_write_ptr_checked := (fd: isize, ptr: isize, len: isize) isize!SysError {
    if len == 0 return $as(isize, 0)
    return syscall3_checked(sys_write(), fd, ptr, len)
}
pub fd_write_checked := (fd: isize, value: []u8) isize!SysError {
    ptr := $as(isize, $as(usize, value))
    len := $as(isize, runtime.bytes_len(value))
    return fd_write_ptr_checked(fd, ptr, len)
}
pub fd_write := (fd: isize, value: []u8) isize => fd_write_raw(fd, value)
status_u32 := (ok: u1) u32 => if ok $as(u32, 1) else $as(u32, 0)

pub io_write_syscall := (value: []u8, newline: u32) u32 {
    len := $as(isize, runtime.bytes_len(value))
    wrote := if len == 0 $as(isize, 0) else fd_write(1, value)
    body_ok := status_u32(len == 0 || wrote == len)
    wrote_nl := if newline == 0 $as(isize, 1) else fd_write(1, "\n")
    nl_ok := status_u32(newline == 0 || wrote_nl == 1)
    return status_u32(body_ok == $as(u32, 1) && nl_ok == $as(u32, 1))
}

pub io_write := (value: []u8, newline: u32) u32 => io_write_syscall(value, newline)

pub io_write_i32 := (value: i32, newline: u32) u32 => runtime.io_write_i32(value, newline)

pub env_argc := () usize => runtime.env_argc()

pub env_argv := (index: usize) []u8 => runtime.env_argv(index)

pub env_get := (name: []u8) []u8 => runtime.env_get(name)

pub env_cwd := () []u8 => runtime.env_cwd()

pub fs_exists := (path: []u8) u32 => runtime.fs_exists(path)

pub fs_is_dir := (path: []u8) u32 => runtime.fs_is_dir(path)

pub fs_read_all := (path: []u8) []u8 => runtime.fs_read_all(path)

pub fs_write_all := (path: []u8, data: []u8) u32 => runtime.fs_write_all(path, data)

pub fs_mkdir_all := (path: []u8) u32 => runtime.fs_mkdir_all(path)

pub fs_list_dir := (path: []u8) []u8 => runtime.fs_list_dir(path)

pub path_join := (lhs: []u8, rhs: []u8) []u8 => runtime.path_join(lhs, rhs)

pub path_normalize := (value: []u8) []u8 => runtime.path_normalize(value)

pub path_dirname := (value: []u8) []u8 => runtime.path_dirname(value)

pub path_basename := (value: []u8) []u8 => runtime.path_basename(value)

pub path_extension := (value: []u8) []u8 => runtime.path_extension(value)

pub path_is_abs := (value: []u8) u32 => runtime.path_is_abs(value)
