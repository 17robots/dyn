#target(kernel: linux)

pub struct TerminalState { bytes: [60]u8 }
pub struct TerminalSize { columns: usize, rows: usize, ok: bool }

pub fn terminal_state(descriptor: isize, state: *TerminalState) bool {
  return #syscall(16, descriptor, 21505, &state.bytes[0]) >= 0
}

pub fn terminal_restore(descriptor: isize, state: *const TerminalState) bool {
  return #syscall(16, descriptor, 21506, &state.bytes[0]) >= 0
}

pub fn terminal_is_attached(descriptor: isize) bool {
  state: TerminalState = TerminalState{ bytes: [] }
  return terminal_state(descriptor, &state)
}

// Applies a small cfmakeraw-equivalent while preserving a caller-restorable copy.
pub fn terminal_raw(descriptor: isize, previous: *TerminalState) bool {
  if !terminal_state(descriptor, previous) { return false }
  changed: TerminalState = TerminalState{ bytes: [] }
  i: usize = 0
  for i < #len(changed.bytes) {
    changed.bytes[i] = previous.bytes[i]
    i += 1
  }
  changed.bytes[0] = changed.bytes[0] & 252
  changed.bytes[1] = changed.bytes[1] & 250
  changed.bytes[3] = changed.bytes[3] & 245
  changed.bytes[12] = changed.bytes[12] & 160
  changed.bytes[22] = 0
  changed.bytes[23] = 1
  return terminal_restore(descriptor, &changed)
}

pub fn terminal_size(descriptor: isize) TerminalSize {
  bytes: [8]u8 = []
  if #syscall(16, descriptor, 21523, &bytes[0]) < 0 { return TerminalSize{ columns: 0, rows: 0, ok: false } }
  rows := (#cast(usize) bytes[0]) + (#cast(usize) bytes[1]) * 256
  columns := (#cast(usize) bytes[2]) + (#cast(usize) bytes[3]) * 256
  return TerminalSize{ columns: columns, rows: rows, ok: true }
}

pub enum KeyKind { Text, Enter, Escape, Backspace, Tab, Up, Down, Right, Left, Unknown }
pub struct Key { kind: KeyKind, byte: u8, consumed: usize }

// Decodes one common terminal key without buffering or allocation.
pub fn key_decode(input: []const u8) Key {
  if #len(input) == 0 { return Key{ kind: KeyKind.Unknown, byte: 0, consumed: 0 } }
  byte := input[0]
  if byte == 13 || byte == 10 { return Key{ kind: KeyKind.Enter, byte: byte, consumed: 1 } }
  if byte == 9 { return Key{ kind: KeyKind.Tab, byte: byte, consumed: 1 } }
  if byte == 127 || byte == 8 { return Key{ kind: KeyKind.Backspace, byte: byte, consumed: 1 } }
  if byte == 27 {
    if #len(input) >= 3 && input[1] == '[' {
      if input[2] == 'A' { return Key{ kind: KeyKind.Up, byte: 0, consumed: 3 } }
      if input[2] == 'B' { return Key{ kind: KeyKind.Down, byte: 0, consumed: 3 } }
      if input[2] == 'C' { return Key{ kind: KeyKind.Right, byte: 0, consumed: 3 } }
      if input[2] == 'D' { return Key{ kind: KeyKind.Left, byte: 0, consumed: 3 } }
    }
    return Key{ kind: KeyKind.Escape, byte: byte, consumed: 1 }
  }
  return Key{ kind: KeyKind.Text, byte: byte, consumed: 1 }
}

pub fn ansi_clear_screen() []const u8 { return "\x1b[2J" }
pub fn ansi_cursor_home() []const u8 { return "\x1b[H" }
pub fn ansi_cursor_hide() []const u8 { return "\x1b[?25l" }
pub fn ansi_cursor_show() []const u8 { return "\x1b[?25h" }
pub fn ansi_reset() []const u8 { return "\x1b[0m" }
pub fn terminal_supports_ansi(descriptor: isize) bool { return terminal_is_attached(descriptor) }

// Opens PTY master. `unlock_pty` makes its slave available; callers query name via ioctl if needed.
pub fn open_pty_master() isize {
  result := open("/dev/ptmx", 258, 0)
  return result.value
}
pub fn unlock_pty(descriptor: isize) bool {
  unlock: i32 = 0
  return #syscall(16, descriptor, 1074025521, &unlock) >= 0
}
#target(kernel: linux)
#target(kernel: linux)
