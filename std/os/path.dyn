pub fn basename(path: []const u8) []const u8 {
  end := #len(path)
  for end > 1 && path[end - 1] == '/' { end -= 1 }
  if end == 1 && path[0] == '/' { return path[..1] }
  start := end
  for start > 0 && path[start - 1] != '/' { start -= 1 }
  return path[start..end]
}

pub fn dirname(path: []const u8) []const u8 {
  end := #len(path)
  for end > 1 && path[end - 1] == '/' { end -= 1 }
  for end > 0 && path[end - 1] != '/' { end -= 1 }
  for end > 1 && path[end - 1] == '/' { end -= 1 }
  if end == 0 { return "." }
  return path[..end]
}

pub fn extension(path: []const u8) []const u8 {
  name := basename(path)
  i := #len(name)
  for i > 0 {
    i -= 1
    if name[i] == '.' {
      if i == 0 { return "" }
      return name[i..]
    }
  }
  return ""
}

pub fn is_absolute(path: []const u8) bool { return #len(path) > 0 && path[0] == '/' }

pub fn join(destination: []u8, left: []const u8, right: []const u8) []u8 {
  separator := #len(left) > 0 && left[#len(left) - 1] != '/' && #len(right) > 0 && right[0] != '/'
  needed := #len(left) + #len(right)
  if separator { needed += 1 }
  if needed > #len(destination) { return destination[..0] }
  at: usize = 0
  for byte in left {
    destination[at] = byte
    at += 1
  }
  if separator {
    destination[at] = '/'
    at += 1
  }
  for right_byte in right {
    destination[at] = right_byte
    at += 1
  }
  return destination[..at]
}

// Lexically normalizes a Linux path. No filesystem access or allocation.
pub fn clean(destination: []u8, path: []const u8) []u8 {
  if #len(destination) == 0 { return destination[..0] }
  absolute := is_absolute(path)
  at: usize = 0
  if absolute {
    destination[at] = '/'
    at += 1
  }
  i: usize = 0
  for i < #len(path) {
    for i < #len(path) && path[i] == '/' { i += 1 }
    start := i
    for i < #len(path) && path[i] != '/' { i += 1 }
    length := i - start
    if length == 0 || (length == 1 && path[start] == '.') { }
    else if length == 2 && path[start] == '.' && path[start + 1] == '.' {
      floor: usize = 0
      if absolute { floor = 1 }
      if at > floor {
        if at > floor && destination[at - 1] == '/' { at -= 1 }
        for at > floor && destination[at - 1] != '/' { at -= 1 }
      } else if !absolute {
        if at > 0 {
          if at == #len(destination) { return destination[..0] }
          destination[at] = '/'
          at += 1
        }
        if at + 2 > #len(destination) { return destination[..0] }
        destination[at] = '.'
        destination[at + 1] = '.'
        at += 2
      }
    } else {
      if at > 0 && destination[at - 1] != '/' {
        if at == #len(destination) { return destination[..0] }
        destination[at] = '/'
        at += 1
      }
      if length > #len(destination) - at { return destination[..0] }
      j: usize = 0
      for j < length {
        destination[at] = path[start + j]
        at += 1
        j += 1
      }
    }
  }
  if at == 0 {
    destination[0] = '.'
    at = 1
  }
  return destination[..at]
}

// Joins then rejects lexical escape outside root. Empty result means failure.
pub fn safe_join(destination: []u8, root: []const u8, child: []const u8) []u8 {
  if is_absolute(child) { return destination[..0] }
  temporary: [4096]u8 = []
  combined := join(temporary[..], root, child)
  if #len(combined) == 0 { return destination[..0] }
  normalized := clean(destination, combined)
  root_storage: [4096]u8 = []
  normalized_root := clean(root_storage[..], root)
  if #len(normalized) < #len(normalized_root) { return destination[..0] }
  i: usize = 0
  for i < #len(normalized_root) {
    if normalized[i] != normalized_root[i] { return destination[..0] }
    i += 1
  }
  if #len(normalized) > #len(normalized_root) && normalized_root[#len(normalized_root) - 1] != '/' && normalized[#len(normalized_root)] != '/' { return destination[..0] }
  return normalized
}

pub struct ComponentIterator { path: []const u8, offset: usize }
pub struct Component { value: []const u8, found: bool }
pub fn components(path: []const u8) ComponentIterator { return ComponentIterator{ path: path, offset: 0 } }
pub fn component_next(iterator: *ComponentIterator) Component {
  for iterator.offset < #len(iterator.path) && iterator.path[iterator.offset] == '/' { iterator.offset += 1 }
  if iterator.offset == #len(iterator.path) { return Component{ value: "", found: false } }
  start := iterator.offset
  for iterator.offset < #len(iterator.path) && iterator.path[iterator.offset] != '/' { iterator.offset += 1 }
  return Component{ value: iterator.path[start..iterator.offset], found: true }
}

// Computes lexical relative path when roots match. Caller owns destination.
pub fn relative(destination: []u8, base: []const u8, target: []const u8) []u8 {
  left_storage: [4096]u8 = []
  right_storage: [4096]u8 = []
  left := clean(left_storage[..], base)
  right := clean(right_storage[..], target)
  if is_absolute(left) != is_absolute(right) { return destination[..0] }
  common: usize = 0
  boundary: usize = 0
  for common < #len(left) && common < #len(right) && left[common] == right[common] {
    if left[common] == '/' { boundary = common + 1 }
    common += 1
  }
  if common == #len(left) && (common == #len(right) || right[common] == '/') { boundary = common }
  at: usize = 0
  i := boundary
  for i < #len(left) {
    for i < #len(left) && left[i] == '/' { i += 1 }
    if i < #len(left) {
      if at > 0 {
        if at == #len(destination) { return destination[..0] }
        destination[at] = '/'
        at += 1
      }
      if at + 2 > #len(destination) { return destination[..0] }
      destination[at] = '.'
      destination[at + 1] = '.'
      at += 2
      for i < #len(left) && left[i] != '/' { i += 1 }
    }
  }
  i = boundary
  for i < #len(right) && right[i] == '/' { i += 1 }
  if i < #len(right) {
    if at > 0 {
      if at == #len(destination) { return destination[..0] }
      destination[at] = '/'
      at += 1
    }
    if #len(right) - i > #len(destination) - at { return destination[..0] }
    for i < #len(right) {
      destination[at] = right[i]
      at += 1
      i += 1
    }
  }
  if at == 0 {
    if #len(destination) == 0 { return destination[..0] }
    destination[0] = '.'
    at = 1
  }
  return destination[..at]
}
