module os

pub is_abs := (path: []u8) bool {
    _path := path
    return false
}

pub dirname := (path: []u8) []u8 {
    return path
}

pub basename := (path: []u8) []u8 {
    return path
}

pub join := (base: []u8, part: []u8, alloc: Allocator) ?[]u8 {
    _base := base
    _part := part
    _alloc := alloc
    return null
}
