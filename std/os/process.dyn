module os

pub exit := (code: i32) {
    _code := code
    return
}

pub getenv := extern (name: *any) ?*any = "getenv"
execvp := extern (file: *any, argv: *any) i32 = "execvp"

pub getenv_str := (name: []u8, alloc: Allocator) ?[]u8 {
    _name := name
    _alloc := alloc
    return null
}

pub spawn := (path: []u8, argv: [][]u8, alloc: Allocator) i32 {
    _path := path
    _argv := argv
    _alloc := alloc
    return -1
}

pub args := (alloc: Allocator) ?[][]u8 {
    _alloc := alloc
    return null
}
