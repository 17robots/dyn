#target(kernel: wasi)
use "std/os/wasi/raw" wasi_raw
use "std/io" io
use "std/fail"
use "std/mem" mem
pub extern fn close "dyn_wasi_close"(fd: u32) u32
extern fn native_sizes "dyn_wasi_args_sizes"(count: *usize, bytes: *usize) u32
extern fn native_args "dyn_wasi_args"(pointers: rawptr, bytes: rawptr) u32
extern fn native_open "dyn_wasi_open_read"(directory: u32, path: *const u8, length: usize, fd: *u32) u32
extern fn native_random "dyn_wasi_random"(data: rawptr, length: usize) u32
pub extern fn clock_time "dyn_wasi_clock"(clock: u32, precision: u64, time: *u64) u32

fn wasi_failed(status: *fail.Status, operation: []const u8, path: []const u8, error: u32) {
  fail.set(status, io.from_wasi(operation, path, 0 - #cast(isize, error)))
}

// The count written; failures carry the negative WASI errno.
pub fn write(status: *fail.Status, fd: u32, bytes: []const u8) usize {
  if status.failed || #len(bytes) == 0 { return 0 }
  count: usize = 0
  error := wasi_raw.write(fd, #cast(rawptr, &bytes[0]), #len(bytes), &count)
  if error != 0 { wasi_failed(status, "write", "", error) }
  return count
}
// The count read; 0 at the end.
pub fn read(status: *fail.Status, fd: u32, bytes: []u8) usize {
  if status.failed || #len(bytes) == 0 { return 0 }
  count: usize = 0
  error := wasi_raw.read(fd, &bytes[0], #len(bytes), &count)
  if error != 0 {
    wasi_failed(status, "read", "", error)
    return 0
  }
  return count
}
// Relative to a directory descriptor granted by the host. No implicit preopens.
pub fn open_read(status: *fail.Status, directory: u32, path: []const u8) u32 {
  if status.failed { return 0 }
  if #len(path) == 0 {
    wasi_failed(status, "open", path, 28)
    return 0
  }
  fd: u32 = 0
  error := native_open(directory, &path[0], #len(path), &fd)
  if error != 0 { wasi_failed(status, "open", path, error) }
  return fd
}
pub fn random(bytes: []u8) u32 {
  if #len(bytes) == 0 { return 0 }
  return native_random(&bytes[0], #len(bytes))
}
// Both strings and slice descriptors belong to the supplied arena. Failure rewinds.
pub fn arguments(arena: *mem.Arena, status: *fail.Status) [][]const u8 {
  empty: [][]const u8
  if status.failed { return empty }
  count: usize = 0
  size: usize = 0
  error := native_sizes(&count, &size)
  if error != 0 { return arguments_failed(status, error) }
  if count == 0 { return empty }
  maximum := #max(usize)
  if count > maximum / #sizeof([]const u8) || count > maximum / #sizeof(*u8) || size == 0 {
    return arguments_failed(status, 48)
  }
  mark := mem.arena_mark(arena)
  raw := mem.push_array(*u8, arena, count)
  storage := mem.push_bytes(arena, size)
  bytes := &storage[0]
  values := mem.push_array([]const u8, arena, count)
  error = native_args(#cast(*u8, &raw[0]), bytes)
  if error != 0 {
    mem.arena_rewind(arena, mark)
    return arguments_failed(status, error)
  }
  i: usize = 0
  for i < count {
    offset := #cast(usize, raw[i]) - #cast(usize, bytes)
    if offset >= size {
      mem.arena_rewind(arena, mark)
      return arguments_failed(status, 28)
    }
    tail := #slice(raw[i], size - offset)
    length: usize = 0
    for length < #len(tail) && tail[length] != 0 {
      length += 1
    }
    if length == #len(tail) {
      mem.arena_rewind(arena, mark)
      return arguments_failed(status, 28)
    }
    values[i] = tail[..length]
    i += 1
  }
  return values
}

fn arguments_failed(status: *fail.Status, error: u32) [][]const u8 {
  wasi_failed(status, "read arguments", "", error)
  empty: [][]const u8
  return empty
}
