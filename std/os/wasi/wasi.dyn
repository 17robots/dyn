#target(kernel: wasi)
use "std/os/wasi/raw" wasi_raw
use "std/io" io
use "std/mem" mem
pub extern fn close "dyn_wasi_close"(fd: u32) u32
extern fn native_sizes "dyn_wasi_args_sizes"(count: *usize, bytes: *usize) u32
extern fn native_args "dyn_wasi_args"(pointers: rawptr, bytes: rawptr) u32
extern fn native_open "dyn_wasi_open_read"(directory: u32, path: *const u8, length: usize, fd: *u32) u32
extern fn native_random "dyn_wasi_random"(data: rawptr, length: usize) u32
pub extern fn clock_time "dyn_wasi_clock"(clock: u32, precision: u64, time: *u64) u32

// Errors are WASI errno values; stream adapters expose their negative value.
pub fn write(fd: u32, bytes: []const u8) io.Transfer {
  if #len(bytes) == 0 {
    return io.Transfer{ status: io.Status.Complete }
  }
  count: usize = 0
  error := wasi_raw.write(fd, #cast(rawptr, &bytes[0]), #len(bytes), &count)
  if error != 0 {
    return io.Transfer{ transferred: count, failure: io.Failure{ kind: io.Kind.System, native: 0 - #cast(isize, error) } }
  }
  return io.Transfer{ transferred: count, status: io.Status.Complete }
}
pub fn read(fd: u32, bytes: []u8) io.Transfer {
  if #len(bytes) == 0 {
    return io.Transfer{ status: io.Status.Complete }
  }
  count: usize = 0
  error := wasi_raw.read(fd, &bytes[0], #len(bytes), &count)
  if error != 0 {
    return io.Transfer{ transferred: count, failure: io.Failure{ kind: io.Kind.System, native: 0 - #cast(isize, error) } }
  }
  if count == 0 {
    return io.Transfer{ status: io.Status.End }
  }
  return io.Transfer{ transferred: count, status: io.Status.Complete }
}
pub struct OpenResult { fd: u32, failure: io.Failure }
// Relative to a directory descriptor granted by the host. No implicit preopens.
pub fn open_read(directory: u32, path: []const u8) OpenResult {
  if #len(path) == 0 {
    return OpenResult{ failure: io.wasi_failure(#cast(isize, 28)) }
  }
  result := OpenResult{}
  error := native_open(directory, &path[0], #len(path), &result.fd)
  if error != 0 {
    result.failure = io.wasi_failure(#cast(isize, error))
  }
  return result
}
pub fn random(bytes: []u8) u32 {
  if #len(bytes) == 0 {
    return 0
  }
  return native_random(&bytes[0], #len(bytes))
}
pub struct Arguments { values: [][]const u8, failure: io.Failure }
// Both strings and slice descriptors belong to the supplied arena. Failure rewinds.
pub fn arguments(arena: *mem.Arena) Arguments {
  count: usize = 0
  size: usize = 0
  error := native_sizes(&count, &size)
  if error != 0 {
    return Arguments{ failure: io.wasi_failure(#cast(isize, error)) }
  }
  if count == 0 {
    return Arguments{}
  }
  maximum := #max(usize)
  if count > maximum / #sizeof([]const u8) || count > maximum / #sizeof(*u8) {
    return Arguments{ failure: io.wasi_failure(#cast(isize, 48)) }
  }
  mark := mem.arena_mark(arena)
  pointer_allocation := mem.arena_try_push(arena, count * #sizeof(*u8), #alignof(*u8))
  byte_allocation := mem.arena_try_push(arena, size, 1)
  slice_allocation := mem.arena_try_push(arena, count * #sizeof([]const u8), #alignof([]const u8))
  if !pointer_allocation.ok || !byte_allocation.ok || !slice_allocation.ok {
    mem.arena_rewind(arena, mark)
    return Arguments{ failure: io.wasi_failure(#cast(isize, 48)) }
  }
  pointers := pointer_allocation.memory
  bytes := byte_allocation.memory
  slices := slice_allocation.memory
  error = native_args(pointers, bytes)
  if error != 0 {
    mem.arena_rewind(arena, mark)
    return Arguments{ failure: io.wasi_failure(#cast(isize, error)) }
  }
  raw := #slice(#cast(**u8, pointers), count)
  values := #slice(#cast(*[]const u8, slices), count)
  i: usize = 0
  for i < count {
    offset := #cast(usize, raw[i]) - #cast(usize, bytes)
    if offset >= size {
      mem.arena_rewind(arena, mark)
      return Arguments{ failure: io.wasi_failure(#cast(isize, 28)) }
    }
    tail := #slice(raw[i], size - offset)
    length: usize = 0
    for length < #len(tail) && tail[length] != 0 {
      length += 1
    }
    if length == #len(tail) {
      mem.arena_rewind(arena, mark)
      return Arguments{ failure: io.wasi_failure(#cast(isize, 28)) }
    }
    values[i] = tail[..length]
    i += 1
  }
  return Arguments{ values: values }
}
