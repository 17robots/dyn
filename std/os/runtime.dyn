module runtime

rt_bytes_len := extern fn(value: []u8) usize = "dynrt_bytes_len"
rt_io_write := extern fn(value: []u8, newline: u32) u32 = "dynrt_io_write"
rt_io_write_i32 := extern fn(value: i32, newline: u32) u32 = "dynrt_io_write_i32"
rt_env_argc := extern fn() usize = "dynrt_env_argc"
rt_env_argv := extern fn(index: usize) []u8 = "dynrt_env_argv"
rt_env_get := extern fn(name: []u8) []u8 = "dynrt_env_get"
rt_env_cwd := extern fn() []u8 = "dynrt_env_cwd"
rt_fs_exists := extern fn(path: []u8) u32 = "dynrt_fs_exists"
rt_fs_is_dir := extern fn(path: []u8) u32 = "dynrt_fs_is_dir"
rt_fs_read_all := extern fn(path: []u8) []u8 = "dynrt_fs_read_all"
rt_fs_write_all := extern fn(path: []u8, data: []u8) u32 = "dynrt_fs_write_all"
rt_fs_mkdir_all := extern fn(path: []u8) u32 = "dynrt_fs_mkdir_all"
rt_fs_list_dir := extern fn(path: []u8) []u8 = "dynrt_fs_list_dir"
rt_path_join := extern fn(lhs: []u8, rhs: []u8) []u8 = "dynrt_path_join"
rt_path_normalize := extern fn(value: []u8) []u8 = "dynrt_path_normalize"
rt_path_dirname := extern fn(value: []u8) []u8 = "dynrt_path_dirname"
rt_path_basename := extern fn(value: []u8) []u8 = "dynrt_path_basename"
rt_path_extension := extern fn(value: []u8) []u8 = "dynrt_path_extension"
rt_path_is_abs := extern fn(value: []u8) u32 = "dynrt_path_is_abs"

pub bytes_len := (value: []u8) usize => rt_bytes_len(value)
pub io_write := (value: []u8, newline: u32) u32 => rt_io_write(value, newline)
pub io_write_i32 := (value: i32, newline: u32) u32 => rt_io_write_i32(value, newline)
pub env_argc := () usize => rt_env_argc()
pub env_argv := (index: usize) []u8 => rt_env_argv(index)
pub env_get := (name: []u8) []u8 => rt_env_get(name)
pub env_cwd := () []u8 => rt_env_cwd()
pub fs_exists := (path: []u8) u32 => rt_fs_exists(path)
pub fs_is_dir := (path: []u8) u32 => rt_fs_is_dir(path)
pub fs_read_all := (path: []u8) []u8 => rt_fs_read_all(path)
pub fs_write_all := (path: []u8, data: []u8) u32 => rt_fs_write_all(path, data)
pub fs_mkdir_all := (path: []u8) u32 => rt_fs_mkdir_all(path)
pub fs_list_dir := (path: []u8) []u8 => rt_fs_list_dir(path)
pub path_join := (lhs: []u8, rhs: []u8) []u8 => rt_path_join(lhs, rhs)
pub path_normalize := (value: []u8) []u8 => rt_path_normalize(value)
pub path_dirname := (value: []u8) []u8 => rt_path_dirname(value)
pub path_basename := (value: []u8) []u8 => rt_path_basename(value)
pub path_extension := (value: []u8) []u8 => rt_path_extension(value)
pub path_is_abs := (value: []u8) u32 => rt_path_is_abs(value)
