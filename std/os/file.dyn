module os

io := use "std/io"

pub File := struct {
    fd: i32,
}

file_write := (ctx: *any, buf: []u8) usize {
    _ctx := ctx
    _buf := buf
    return 0
}

file_read := (ctx: *any, buf: []u8) usize {
    _ctx := ctx
    _buf := buf
    return 0
}

pub File.writer := (self: File) io.Writer {
    return .{
        ctx: $as(*any, $as(usize, self.fd)),
        write_fn: file_write,
    }
}

pub File.reader := (self: File) io.Reader {
    return .{
        ctx: $as(*any, $as(usize, self.fd)),
        read_fn: file_read,
    }
}

pub stdout := File{ fd: 1 }
pub stderr := File{ fd: 2 }
pub stdin := File{ fd: 0 }

pub write := (buf: []u8) {
    _buf := buf
    return
}

pub writeln := (buf: []u8) {
    _buf := buf
    return
}

pub ewrite := (buf: []u8) {
    _buf := buf
    return
}

pub ewriteln := (buf: []u8) {
    _buf := buf
    return
}

pub print := (v: any) {
    _v := v
    return
}

pub println := (v: any) {
    _v := v
    return
}

pub eprint := (v: any) {
    _v := v
    return
}

pub eprintln := (v: any) {
    _v := v
    return
}

pub printf1 := (fmt: []u8, a0: any) {
    _fmt := fmt
    _a0 := a0
    return
}

pub eprintf := (fmt: []u8, a0: any) {
    _fmt := fmt
    _a0 := a0
    return
}

pub printf := (fmt: []u8, a0: any, a1: any) {
    _fmt := fmt
    _a0 := a0
    _a1 := a1
    return
}
