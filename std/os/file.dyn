module os

io := use "std/io"
host_file_platform := use "std/platform/host"
host_read_fn := host_file_platform.read
host_write_fn := host_file_platform.write

pub File := struct {
    fd: i32,
}

file_write := (ctx: *any, buf: []u8) usize {
    fd := $as(i32, $as(usize, ctx))
    wrote := host_write_fn(fd, $as(*any, buf.ptr), buf.len)
    if wrote < 0 return 0
    return $as(usize, wrote)
}

file_read := (ctx: *any, buf: []u8) usize {
    fd := $as(i32, $as(usize, ctx))
    got := host_read_fn(fd, $as(*any, buf.ptr), buf.len)
    if got < 0 return 0
    return $as(usize, got)
}

pub File.writer := (self: File) io.Writer {
    return .{
        ctx: $as(*any, $as(usize, self.fd)),
        write_fn: file_write,
    }
}

pub File.reader := (self: File) io.Reader {
    return .{
        ctx: $as(*any, $as(usize, self.fd)),
        read_fn: file_read,
    }
}

pub stdout := File{ fd: 1 }
pub stderr := File{ fd: 2 }
pub stdin := File{ fd: 0 }

pub write := (buf: []u8) {
    _ = stdout.writer().write_all(buf)
    return
}

pub writeln := (buf: []u8) {
    _ = stdout.writer().write_all(buf)
    _ = stdout.writer().write_byte('\n')
    return
}

pub ewrite := (buf: []u8) {
    _ = stderr.writer().write_all(buf)
    return
}

pub ewriteln := (buf: []u8) {
    _ = stderr.writer().write_all(buf)
    _ = stderr.writer().write_byte('\n')
    return
}

pub print := (v: any) {
    stdout.writer().print(v)
    return
}

pub println := (v: any) {
    stdout.writer().println(v)
    return
}

pub eprint := (v: any) {
    stderr.writer().print(v)
    return
}

pub eprintln := (v: any) {
    stderr.writer().println(v)
    return
}

pub printf1 := (fmt: []u8, a0: any) {
    stdout.writer().write_all(fmt)
    stdout.writer().print(a0)
    return
}

pub eprintf := (fmt: []u8, a0: any) {
    stderr.writer().write_all(fmt)
    stderr.writer().print(a0)
    return
}

pub printf := (fmt: []u8, a0: any, a1: any) {
    stdout.writer().write_all(fmt)
    stdout.writer().print(a0)
    stdout.writer().print(a1)
    return
}
