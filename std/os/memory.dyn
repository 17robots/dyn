pub fn page_allocate(size: usize) []u8 {
  if size == 0 { #panic("page allocation size must be non-zero") }
  address := #syscall(9, 0, size, 3, 34, -1, 0)
  if address < 0 { #panic("page allocation failed") }
  return (#cast(*u8) address)[..size]
}

pub fn page_release(memory: []u8) {
  if #len(memory) == 0 { return }
  result := #syscall(11, &memory[0], #len(memory))
  if result != 0 { #panic("page release failed") }
}
