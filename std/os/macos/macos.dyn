#target(kernel: darwin)

use mem "std/mem"
use cstrings "std/c"
use "std/os/macos/sys"
use "std/io"

// libSystem has no BSD yield call; sched_yield wraps the swtch_pri Mach trap.
extern fn native_yield "sched_yield"() i32

pub struct PollDescriptor { descriptor: i32, events: i16, returned: i16 }
pub const has_native_threads: bool = false
fn checked(value: isize) isize!io.IoErr {
  if value < 0 { fail io.darwin_err(value) }
  return value
}
fn terminated(path: []const u8, storage: []u8) *const u8 {
  if path.len == 0 { return nil }
  return cstrings.string_into(storage, path) catch nil
}
pub fn file_open(path: []const u8, write_access: bool, create: bool) isize!io.IoErr {
  storage: [4096 + mem.ArenaBufferOverhead]u8
  name := terminated(path, storage[..])
  if name == nil { fail io.darwin_err(-63) }
  flags: usize = 0
  if write_access {
    flags = 2
  }
  if create {
    flags = flags | 512
  }
  return try checked(#syscall(sys.Open, name, flags, 420))
}
pub fn file_close(handle: isize) !io.IoErr {
  _ = try checked(#syscall(sys.Close, handle))
}
pub fn thread_yield() {
  _ = native_yield()
}
// A socket, or the negative system error code.
pub fn socket_open(family: i32, kind: i32, protocol: i32) isize {
  return #syscall(sys.Socket, family, kind, protocol)
}
pub fn socket_close(socket: usize) bool {
  return #syscall(sys.Close, socket) == 0
}
pub fn socket_connect(socket: usize, address: []const u8) bool {
  if address.len == 0 { return false }
  return #syscall(sys.Connect, socket, &address[0], address.len) == 0
}
pub fn event_poll(items: []PollDescriptor, milliseconds: i32) isize {
  if items.len == 0 { return 0 }
  return #syscall(sys.Poll, &items[0], items.len, milliseconds)
}
