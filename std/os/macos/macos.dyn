use "std/parse" parse
#target(kernel: darwin)

use "std/mem" mem
use "std/c" cstrings
use "std/os/macos/sys"
use "std/io"

// libSystem has no BSD yield call; sched_yield wraps the swtch_pri Mach trap.
extern fn native_yield "sched_yield"() i32

pub struct IoResult { value: isize, failure: io.Failure }
pub struct PollDescriptor { descriptor: i32, events: i16, returned: i16 }
pub const has_native_threads: bool = false
pub fn io_value(result: *const IoResult) isize {
  return result.value
}
fn io_result(value: isize) IoResult {
  if value < 0 {
    return IoResult{ value: value, failure: io.darwin_failure(value) }
  }
  return IoResult{ value: value }
}
fn terminated(path: []const u8, storage: []u8) *const u8 {
  if #len(path) == 0 {
    return nil
  }
  result := cstrings.string_into(storage, path)
  if result.failure.kind != parse.Kind.Ok {
    return nil
  }
  return result.value
}
pub fn file_open(path: []const u8, write_access: bool, create: bool) IoResult {
  storage: [4096 + mem.ArenaBufferOverhead]u8
  name := terminated(path, storage[..])
  if name == nil {
    return IoResult{ value: -1, failure: io.darwin_failure(-63) }
  }
  flags: usize = 0
  if write_access {
    flags = 2
  }
  if create {
    flags = flags | 512
  }
  return io_result(#syscall(sys.Open, name, flags, 420))
}
pub fn file_close(handle: isize) IoResult {
  return io_result(#syscall(sys.Close, handle))
}
pub fn thread_yield() {
  _ = native_yield()
}
pub fn socket_open(family: i32, kind: i32, protocol: i32) IoResult {
  return io_result(#syscall(sys.Socket, family, kind, protocol))
}
pub fn socket_close(socket: usize) bool {
  return #syscall(sys.Close, socket) == 0
}
pub fn socket_connect(socket: usize, address: []const u8) bool {
  if #len(address) == 0 {
    return false
  }
  return #syscall(sys.Connect, socket, &address[0], #len(address)) == 0
}
pub fn event_poll(items: []PollDescriptor, milliseconds: i32) isize {
  if #len(items) == 0 {
    return 0
  }
  return #syscall(sys.Poll, &items[0], #len(items), milliseconds)
}
