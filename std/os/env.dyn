pub struct EnvironmentValue {
  value: []const u8,
  found: bool,
}

pub fn environment(arena: *mem.Arena) [][]const u8 {
  byte_capacity: usize = 65536
  entry_capacity: usize = 1024
  read_bytes := read_stream_with_capacity(arena, "/proc/self/environ", byte_capacity + 1)
  if #len(read_bytes) > byte_capacity { #panic("environment byte capacity exceeded") }
  bytes := read_bytes[..]
  raw := #cast(*[]const u8) mem.arena_push(
    arena,
    entry_capacity * #sizeof([]const u8),
    #alignof([]const u8),
  )
  entries := raw[..entry_capacity]
  count: usize = 0
  start: usize = 0
  i: usize = 0
  for i < #len(bytes) {
    if bytes[i] == 0 {
      if count == entry_capacity { #panic("environment entry capacity exceeded") }
      entries[count] = bytes[start..i]
      count += 1
      start = i + 1
    }
    i += 1
  }
  if start < #len(bytes) {
    if count == entry_capacity { #panic("environment entry capacity exceeded") }
    entries[count] = bytes[start..]
    count += 1
  }
  return entries[..count]
}

pub fn environment_get(arena: *mem.Arena, name: []const u8) EnvironmentValue {
  entries := environment(arena)
  for entry in entries {
    if #len(entry) > #len(name) && entry[#len(name)] == '=' {
      equal := true
      i: usize = 0
      for i < #len(name) {
        if entry[i] != name[i] { equal = false }
        i += 1
      }
      if equal {
        return EnvironmentValue{ value: entry[#len(name) + 1..], found: true }
      }
    }
  }
  return EnvironmentValue{ value: "", found: false }
}

pub fn current_directory(destination: []u8) EnvironmentValue {
  if #len(destination) == 0 { return EnvironmentValue{ value: "", found: false } }
  result := #syscall(79, &destination[0], #len(destination))
  if result < 0 { return EnvironmentValue{ value: "", found: false } }
  length: usize = 0
  for length < #len(destination) && destination[length] != 0 { length += 1 }
  return EnvironmentValue{ value: destination[..length], found: true }
}

pub fn change_directory(path: []const u8) isize {
  bytes: [4096]u8 = []
  if #len(path) >= #len(bytes) { return -36 }
  i: usize = 0
  for i < #len(path) {
    bytes[i] = path[i]
    i += 1
  }
  return #syscall(80, &bytes[0])
}
