#target(kernel: linux)

use "std/mem" memory
use "std/os/linux/sys"
use "std/io"
use "std/fail"

// Records a negative system result as a failure of operation; returns value.
fn check(status: *fail.Status, operation: []const u8, value: isize) isize {
  if value < 0 {
    fail.set(status, io.from_linux(operation, "", value))
  }
  return value
}

fn no_arguments() [][]const u8 {
  pointer: *[]const u8 = nil
  return #slice(pointer, 0)
}

// Linux exposes argv as NUL-separated bytes through procfs. Returned slices live
// in the caller arena. Limits are explicit and intentionally modest for tools.
pub fn process_arguments(arena: *memory.Arena) [][]const u8 {
  temporary: [16385]u8
  path: [19]u8
  source: []const u8 = "/proc/self/cmdline"
  i: usize = 0
  for i < #len(source) {
    path[i] = source[i]
    i += 1
  }
  descriptor := #syscall(sys.Openat, -100, &path[0], 0, 0)
  if descriptor < 0 { return no_arguments() }
  value := #syscall(sys.Read, descriptor, &temporary[0], #len(temporary))
  _ = #syscall(sys.Close, descriptor)
  if value < 0 || #cast(usize, value) == #len(temporary) { return no_arguments() }
  used := #cast(usize, value)
  count: usize = 0
  i = 0
  for i < used {
    if temporary[i] == 0 {
      count += 1
    }
    i += 1
  }
  if used > 0 && temporary[used - 1] != 0 {
    count += 1
  }

  bytes := memory.push_bytes(arena, used)
  _ = memory.copy(bytes, temporary[..used])
  arguments := memory.push_array([]const u8, arena, count)
  start: usize = 0
  at: usize = 0
  i = 0
  for i < used {
    if bytes[i] == 0 {
      arguments[at] = bytes[start..i]
      at += 1
      start = i + 1
    }
    i += 1
  }
  if start < used {
    arguments[at] = bytes[start..]
  }
  return arguments
}

pub fn process_id() isize {
  return #syscall(sys.Getpid)
}
pub fn parent_process_id() isize {
  return #syscall(sys.Getppid)
}
pub fn thread_id() isize {
  return #syscall(sys.Gettid)
}
pub fn yield_thread() {
  _ = #syscall(sys.SchedYield)
}

pub struct Pipe { input: isize, output: isize }
// wait_status is the raw status; read it with exited, exit_status, signaled
// and termination_signal.
pub struct Waited { process: isize, wait_status: i32 }
pub struct SpawnOptions { input: isize, output: isize, error: isize, directory: []const u8 }
struct CStringPointer { value: *u8 }

pub fn pipe(status: *fail.Status) Pipe {
  if status.failed { return Pipe{ input: -1, output: -1 } }
  descriptors: [2]i32
  value := #syscall(sys.Pipe2, &descriptors[0], 0)
  if check(status, "pipe", value) < 0 { return Pipe{ input: -1, output: -1 } }
  return Pipe{ input: descriptors[0], output: descriptors[1] }
}
// Closes descriptor. Never retry a failed close: the descriptor may already
// be reused.
pub fn close_descriptor(status: *fail.Status, descriptor: isize) {
  _ = check(status, "close", #syscall(sys.Close, descriptor))
}
pub fn duplicate_to(status: *fail.Status, descriptor: isize, target: isize) isize {
  if status.failed { return -1 }
  if descriptor == target { return check(status, "duplicate", #syscall(sys.Fcntl, descriptor, 1, 0)) }
  value := #syscall(sys.Dup2, descriptor, target, 0)
  for value == -4 {
    value = #syscall(sys.Dup2, descriptor, target, 0)
  }
  return check(status, "duplicate", value)
}
pub fn send_signal(status: *fail.Status, process: isize, signal: usize) {
  if status.failed { return }
  _ = check(status, "signal", #syscall(sys.Kill, process, signal))
}
// fork: 0 in the child, the child's id in the parent.
pub fn fork_process(status: *fail.Status) isize {
  if status.failed { return -1 }
  return check(status, "fork", fork_native())
}

fn terminate(arena: *memory.Arena, text: []const u8) *u8 {
  bytes := memory.push_bytes(arena, #len(text) + 1)
  for i in 0..#len(text) {
    bytes[i] = text[i]
  }
  bytes[#len(text)] = 0
  return &bytes[0]
}

pub fn execute(arena: *memory.Arena, path: []const u8, arguments: [][]const u8) isize {
  mark := memory.arena_mark(arena)
  defer memory.arena_rewind(arena, mark)
  if #len(path) == 0 { return -22 }
  for byte in path {
    if byte == 0 { return -22 }
  }
  for argument in arguments {
    for argument_byte in argument {
      if argument_byte == 0 { return -22 }
    }
  }
  path_raw := terminate(arena, path)
  if path_raw == nil { return -28 }
  length := #len(arguments)
  pointers := memory.push_array(CStringPointer, arena, length + 1)
  for i in 0..length {
    pointers[i] = CStringPointer{ value: terminate(arena, arguments[i]) }
    if pointers[i].value == nil { return -28 }
  }
  pointers[length] = CStringPointer{ value: nil }
  value := #syscall(sys.Execve, path_raw, &pointers[0], &pointers[length])
  return value
}

pub fn spawn_environment(
  arena: *memory.Arena,
  status: *fail.Status,
  path: []const u8,
  arguments: [][]const u8,
  environment: [][]const u8,
  options: SpawnOptions,
) isize {
  if status.failed { return -1 }
  mark := memory.arena_mark(arena)
  defer memory.arena_rewind(arena, mark)
  if #len(path) == 0 { return spawn_failed(status, -22) }
  for byte in path {
    if byte == 0 { return spawn_failed(status, -22) }
  }
  for argument in arguments {
    for argument_byte in argument {
      if argument_byte == 0 { return spawn_failed(status, -22) }
    }
  }
  path_raw := terminate(arena, path)
  if path_raw == nil { return spawn_failed(status, -28) }
  directory_raw: *const u8 = nil
  if #len(options.directory) > 0 {
    for directory_byte in options.directory {
      if directory_byte == 0 { return spawn_failed(status, -22) }
    }
    directory_raw = terminate(arena, options.directory)
    if directory_raw == nil { return spawn_failed(status, -28) }
  }
  count := #len(arguments)
  pointers := memory.push_array(CStringPointer, arena, count + 1)
  for index in 0..count {
    pointers[index].value = terminate(arena, arguments[index])
    if pointers[index].value == nil { return spawn_failed(status, -28) }
  }
  pointers[count].value = nil
  environment_pointers := memory.push_array(CStringPointer, arena, #len(environment) + 1)
  env_index: usize = 0
  for env_index < #len(environment) {
    for env_byte in environment[env_index] {
      if env_byte == 0 { return spawn_failed(status, -22) }
    }
    environment_pointers[env_index].value = terminate(arena, environment[env_index])
    if environment_pointers[env_index].value == nil { return spawn_failed(status, -28) }
    env_index += 1
  }
  environment_pointers[env_index].value = nil
  sources: [3]isize = [options.input, options.output, options.error]
  redirected_sources: [3]isize = [-1, -1, -1]
  defer {
    for duplicate in redirected_sources {
      if duplicate >= 0 {
        _ = #syscall(sys.Close, duplicate)
      }
    }
  }
  for source_index in 0..3 {
    if sources[source_index] >= 0 {
      copied := #syscall(sys.Fcntl, sources[source_index], 1030, 3)
      if copied < 0 { return spawn_failed(status, copied) }
      redirected_sources[source_index] = copied
    }
  }
  descriptors: [2]i32
  channel := #syscall(sys.Pipe2, &descriptors[0], 524288)
  if channel < 0 { return spawn_failed(status, channel) }
  // Keep the error pipe out of the standard-descriptor range even if stdin/out/err
  // were closed by the parent; redirection must not overwrite the reporting pipe.
  input := #syscall(sys.Fcntl, descriptors[0], 1030, 3)
  output := #syscall(sys.Fcntl, descriptors[1], 1030, 3)
  _ = #syscall(sys.Close, descriptors[0])
  _ = #syscall(sys.Close, descriptors[1])
  if input < 0 || output < 0 {
    if input >= 0 {
      _ = #syscall(sys.Close, input)
    }
    if output >= 0 {
      _ = #syscall(sys.Close, output)
    }
    return spawn_failed(status, -24)
  }
  child := fork_native()
  if child < 0 {
    _ = #syscall(sys.Close, input)
    _ = #syscall(sys.Close, output)
    return spawn_failed(status, child)
  }
  if child == 0 {
    // In the child only raw system calls: the failure goes back to the parent.
    _ = #syscall(sys.Close, input)
    failure: isize = 0
    for stream in 0..3 {
      if failure == 0 && redirected_sources[stream] >= 0 {
        failure = raw_duplicate(redirected_sources[stream], #cast(isize, stream))
      }
    }
    if failure == 0 && directory_raw != nil {
      failure = #syscall(sys.Chdir, directory_raw)
    }
    if failure == 0 {
      failure = #syscall(sys.Execve, path_raw, &pointers[0], &environment_pointers[0])
    }
    _ = #syscall(sys.Write, output, &failure, #sizeof(isize))
    exit_process(127)
  }
  _ = #syscall(sys.Close, output)
  reported: isize = 0
  received := #syscall(sys.Read, input, &reported, #sizeof(isize))
  for received == -4 {
    received = #syscall(sys.Read, input, &reported, #sizeof(isize))
  }
  _ = #syscall(sys.Close, input)
  if received != 0 {
    cleanup: fail.Status
    send_signal(&cleanup, child, 9)
    _ = wait(&cleanup, child, false)
    if received < 0 {
      reported = received
    } else if received != #cast(isize, #sizeof(isize)) {
      reported = -5
    }
    return spawn_failed(status, reported)
  }
  return child
}

fn spawn_failed(status: *fail.Status, code: isize) isize {
  fail.set(status, io.from_linux("spawn", "", code))
  return -1
}

// dup2 for the forked child: 0 or a negative code.
fn raw_duplicate(descriptor: isize, target: isize) isize {
  if descriptor == target {
    value := #syscall(sys.Fcntl, descriptor, 1, 0)
    if value < 0 { return value }
    return 0
  }
  value := #syscall(sys.Dup2, descriptor, target, 0)
  for value == -4 {
    value = #syscall(sys.Dup2, descriptor, target, 0)
  }
  if value < 0 { return value }
  return 0
}

// Waits for process to end. nonblocking returns process 0 when it is
// still running.
pub fn wait(status: *fail.Status, process: isize, nonblocking: bool) Waited {
  if status.failed { return Waited{} }
  wait_status: i32 = 0
  options: usize = 0
  if nonblocking {
    options = 1
  }
  value := #syscall(sys.Wait4, process, &wait_status, options, 0)
  for value == -4 {
    value = #syscall(sys.Wait4, process, &wait_status, options, 0)
  }
  if check(status, "wait", value) < 0 { return Waited{} }
  return Waited{ process: value, wait_status: wait_status }
}
pub fn exited(status: i32) bool {
  return (status & 127) == 0
}
pub fn exit_status(status: i32) u8 {
  return ((status >> 8) & 255)
}
pub fn signaled(status: i32) bool {
  return (status & 127) != 0 && (status & 127) != 127
}
pub fn termination_signal(status: i32) u8 {
  return (status & 127)
}

// Ends the whole process: exit_group, so other threads end with it.
pub fn exit_process(status: u8) {
  _ = #syscall(sys.ExitGroup, status)
  #panic("exit syscall returned")
}

// Reads the process's initial environment. Values are copied into caller
// storage. NotFound when the variable is unset; Capacity when the value does
// not fit destination.
pub fn environment_get(status: *fail.Status, name: []const u8, destination: []u8) []u8 {
  if status.failed { return destination[..0] }
  if #len(name) == 0 {
    fail.invalid(status, "read environment", name, "empty variable name")
    return destination[..0]
  }
  for name_byte in name {
    if name_byte == 0 || name_byte == '=' {
      fail.invalid(status, "read environment", name, "variable names cannot hold '=' or NUL")
      return destination[..0]
    }
  }
  path := "/proc/self/environ\0"
  descriptor := #syscall(sys.Openat, -100, &path[0], 0, 0)
  if descriptor < 0 {
    fail.set(status, io.from_linux("read environment", "/proc/self/environ", descriptor))
    return destination[..0]
  }
  defer _ = #syscall(sys.Close, descriptor)
  scratch: [4096]u8
  position: usize = 0
  used: usize = 0
  matching := true
  in_value := false
  selected := false
  for {
    count := #syscall(sys.Read, descriptor, &scratch[0], #len(scratch))
    if count == -4 { continue }
    if count < 0 {
      fail.set(status, io.from_linux("read environment", "/proc/self/environ", count))
      return destination[..0]
    }
    if count == 0 {
      if selected {
        fail.set(status, fail.make(fail.Kind.System, "read environment", "/proc/self/environ", "the last entry has no end"))
      } else {
        fail.set(status, fail.make(fail.Kind.NotFound, "read environment", name, "not set"))
      }
      return destination[..0]
    }
    for byte in scratch[..#cast(usize, count)] {
      if byte == 0 {
        if selected { return destination[..used] }
        position = 0
        used = 0
        matching = true
        in_value = false
        selected = false
      } else if !in_value {
        if byte == '=' {
          in_value = true
          selected = matching && position == #len(name)
        } else {
          if position >= #len(name) || byte != name[position] {
            matching = false
          }
          position += 1
        }
      } else if selected {
        if used == #len(destination) {
          failure := fail.make(fail.Kind.Capacity, "read environment", name, "the value does not fit the storage")
          failure.native = -28
          fail.set(status, failure)
          return destination[..0]
        }
        destination[used] = byte
        used += 1
      }
    }
  }
  return destination[..0]
}

// The working directory, in destination.
pub fn current_directory(status: *fail.Status, destination: []u8) []u8 {
  if status.failed { return destination[..0] }
  if #len(destination) == 0 {
    fail.set(status, io.from_linux("current directory", "", -34))
    return destination[..0]
  }
  count := #syscall(sys.Getcwd, &destination[0], #len(destination))
  if check(status, "current directory", count) < 0 { return destination[..0] }
  if count == 0 {
    fail.set(status, io.from_linux("current directory", "", -5))
    return destination[..0]
  }
  return destination[..#cast(usize, count) - 1]
}

struct SignalDisposition { handler: usize, flags: usize, restorer: usize, mask: u64 }
fn signal_disposition(status: *fail.Status, signal: usize, handler: usize) {
  if status.failed { return }
  action := SignalDisposition{ handler: handler }
  _ = check(status, "set signal action", #syscall(sys.RtSigaction, signal, &action, 0, 8))
}
pub fn signal_ignore(status: *fail.Status, signal: usize) {
  signal_disposition(status, signal, 1)
}
pub fn signal_default(status: *fail.Status, signal: usize) {
  signal_disposition(status, signal, 0)
}

pub fn spawn(arena: *memory.Arena, status: *fail.Status, path: []const u8, arguments: [][]const u8, options: SpawnOptions) isize {
  empty: [0][]const u8
  return spawn_environment(arena, status, path, arguments, empty[..], options)
}
