#target(kernel: linux)

use memory "std/mem"
use "std/os/linux/sys"
use "std/io"

// value, or its failure when it is a negative system result.
fn check(value: isize) isize!io.IoErr {
  if value < 0 { fail io.linux_err(value) }
  return value
}

fn no_arguments() [][]const u8 {
  pointer: *[]const u8 = nil
  return #slice(pointer, 0)
}

// Linux exposes argv as NUL-separated bytes through procfs. Returned slices live
// in the caller arena. Limits are explicit and intentionally modest for tools.
pub fn process_arguments(arena: *memory.Arena) [][]const u8 {
  temporary: [16385]u8
  path: [19]u8
  source: []const u8 = "/proc/self/cmdline"
  i: usize = 0
  for i < source.len {
    path[i] = source[i]
    i += 1
  }
  descriptor := #syscall(sys.Openat, -100, &path[0], 0, 0)
  if descriptor < 0 { return no_arguments() }
  value := #syscall(sys.Read, descriptor, &temporary[0], temporary.len)
  _ = #syscall(sys.Close, descriptor)
  if value < 0 || #cast(usize, value) == temporary.len { return no_arguments() }
  used := #cast(usize, value)
  count: usize = 0
  i = 0
  for i < used {
    if temporary[i] == 0 {
      count += 1
    }
    i += 1
  }
  if used > 0 && temporary[used - 1] != 0 {
    count += 1
  }

  bytes := memory.push_bytes(arena, used)
  _ = memory.copy(bytes, temporary[..used])
  arguments := memory.push_array<[]const u8>(arena, count)
  start: usize = 0
  at: usize = 0
  i = 0
  for i < used {
    if bytes[i] == 0 {
      arguments[at] = bytes[start..i]
      at += 1
      start = i + 1
    }
    i += 1
  }
  if start < used {
    arguments[at] = bytes[start..]
  }
  return arguments
}

pub fn process_id() isize {
  return #syscall(sys.Getpid)
}
pub fn parent_process_id() isize {
  return #syscall(sys.Getppid)
}
pub fn thread_id() isize {
  return #syscall(sys.Gettid)
}
pub fn yield_thread() {
  _ = #syscall(sys.SchedYield)
}

pub struct Pipe { input: isize, output: isize }
// wait_status is the raw status; read it with exited, exit_status, signaled
// and termination_signal.
pub struct Waited { process: isize, wait_status: i32 }
// group makes the child the leader of a new process group (setpgid(0, 0)
// before exec), so that send_signal(-child, signal) reaches its descendants.
pub struct SpawnOptions { input: isize, output: isize, error: isize, directory: []const u8, group: bool }
struct CStringPointer { value: *u8 }

pub fn pipe() Pipe!io.IoErr {
  descriptors: [2]i32
  _ = try check(#syscall(sys.Pipe2, &descriptors[0], 0))
  return Pipe{ input: descriptors[0], output: descriptors[1] }
}
// Closes descriptor. Never retry a failed close: the descriptor may already
// be reused.
pub fn close_descriptor(descriptor: isize) !io.IoErr {
  _ = try check(#syscall(sys.Close, descriptor))
}
pub fn duplicate_to(descriptor: isize, target: isize) isize!io.IoErr {
  if descriptor == target { return try check(#syscall(sys.Fcntl, descriptor, 1, 0)) }
  value := #syscall(sys.Dup2, descriptor, target, 0)
  for value == -4 {
    value = #syscall(sys.Dup2, descriptor, target, 0)
  }
  return try check(value)
}
pub fn send_signal(process: isize, signal: usize) !io.IoErr {
  _ = try check(#syscall(sys.Kill, process, signal))
}
// fork: 0 in the child, the child's id in the parent.
pub fn fork_process() isize!io.IoErr {
  return try check(fork_native())
}

fn terminate(arena: *memory.Arena, text: []const u8) *u8 {
  bytes := memory.push_bytes(arena, text.len + 1)
  for i in 0..text.len {
    bytes[i] = text[i]
  }
  bytes[text.len] = 0
  return &bytes[0]
}

pub fn execute(arena: *memory.Arena, path: []const u8, arguments: [][]const u8) isize {
  mark := memory.arena_mark(arena)
  defer memory.arena_rewind(arena, mark)
  if path.len == 0 { return -22 }
  for byte in path {
    if byte == 0 { return -22 }
  }
  for argument in arguments {
    for argument_byte in argument {
      if argument_byte == 0 { return -22 }
    }
  }
  path_raw := terminate(arena, path)
  if path_raw == nil { return -28 }
  length := arguments.len
  pointers := memory.push_array<CStringPointer>(arena, length + 1)
  for i in 0..length {
    pointers[i] = CStringPointer{ value: terminate(arena, arguments[i]) }
    if pointers[i].value == nil { return -28 }
  }
  pointers[length] = CStringPointer{ value: nil }
  value := #syscall(sys.Execve, path_raw, &pointers[0], &pointers[length])
  return value
}

pub fn spawn_environment(
  arena: *memory.Arena,
  path: []const u8,
  arguments: [][]const u8,
  environment: [][]const u8,
  options: SpawnOptions,
) isize!io.IoErr {
  mark := memory.arena_mark(arena)
  defer memory.arena_rewind(arena, mark)
  if path.len == 0 { fail io.linux_err(-22) }
  for byte in path {
    if byte == 0 { fail io.linux_err(-22) }
  }
  for argument in arguments {
    for argument_byte in argument {
      if argument_byte == 0 { fail io.linux_err(-22) }
    }
  }
  path_raw := terminate(arena, path)
  if path_raw == nil { fail io.linux_err(-28) }
  directory_raw: *const u8 = nil
  if options.directory.len > 0 {
    for directory_byte in options.directory {
      if directory_byte == 0 { fail io.linux_err(-22) }
    }
    directory_raw = terminate(arena, options.directory)
    if directory_raw == nil { fail io.linux_err(-28) }
  }
  count := arguments.len
  pointers := memory.push_array<CStringPointer>(arena, count + 1)
  for index in 0..count {
    pointers[index].value = terminate(arena, arguments[index])
    if pointers[index].value == nil { fail io.linux_err(-28) }
  }
  pointers[count].value = nil
  environment_pointers := memory.push_array<CStringPointer>(arena, environment.len + 1)
  env_index: usize = 0
  for env_index < environment.len {
    for env_byte in environment[env_index] {
      if env_byte == 0 { fail io.linux_err(-22) }
    }
    environment_pointers[env_index].value = terminate(arena, environment[env_index])
    if environment_pointers[env_index].value == nil { fail io.linux_err(-28) }
    env_index += 1
  }
  environment_pointers[env_index].value = nil
  sources: [3]isize = [options.input, options.output, options.error]
  redirected_sources: [3]isize = [-1, -1, -1]
  defer {
    for duplicate in redirected_sources {
      if duplicate >= 0 {
        _ = #syscall(sys.Close, duplicate)
      }
    }
  }
  for source_index in 0..3 {
    if sources[source_index] >= 0 {
      copied := #syscall(sys.Fcntl, sources[source_index], 1030, 3)
      if copied < 0 { fail io.linux_err(copied) }
      redirected_sources[source_index] = copied
    }
  }
  descriptors: [2]i32
  channel := #syscall(sys.Pipe2, &descriptors[0], 524288)
  if channel < 0 { fail io.linux_err(channel) }
  // Keep the error pipe out of the standard-descriptor range even if stdin/out/err
  // were closed by the parent; redirection must not overwrite the reporting pipe.
  input := #syscall(sys.Fcntl, descriptors[0], 1030, 3)
  output := #syscall(sys.Fcntl, descriptors[1], 1030, 3)
  _ = #syscall(sys.Close, descriptors[0])
  _ = #syscall(sys.Close, descriptors[1])
  if input < 0 || output < 0 {
    if input >= 0 {
      _ = #syscall(sys.Close, input)
    }
    if output >= 0 {
      _ = #syscall(sys.Close, output)
    }
    fail io.linux_err(-24)
  }
  child := fork_native()
  if child < 0 {
    _ = #syscall(sys.Close, input)
    _ = #syscall(sys.Close, output)
    fail io.linux_err(child)
  }
  if child == 0 {
    // In the child only raw system calls: the failure goes back to the parent.
    _ = #syscall(sys.Close, input)
    failure: isize = 0
    if options.group {
      failure = #syscall(sys.Setpgid, 0, 0)
    }
    for stream in 0..3 {
      if failure == 0 && redirected_sources[stream] >= 0 {
        failure = raw_duplicate(redirected_sources[stream], #cast(isize, stream))
      }
    }
    if failure == 0 && directory_raw != nil {
      failure = #syscall(sys.Chdir, directory_raw)
    }
    if failure == 0 {
      failure = #syscall(sys.Execve, path_raw, &pointers[0], &environment_pointers[0])
    }
    _ = #syscall(sys.Write, output, &failure, #sizeof(isize))
    exit_process(127)
  }
  _ = #syscall(sys.Close, output)
  reported: isize = 0
  received := #syscall(sys.Read, input, &reported, #sizeof(isize))
  for received == -4 {
    received = #syscall(sys.Read, input, &reported, #sizeof(isize))
  }
  _ = #syscall(sys.Close, input)
  if received != 0 {
    send_signal(child, 9) catch {}
    reap(child)
    if received < 0 {
      reported = received
    } else if received != #cast(isize, #sizeof(isize)) {
      reported = -5
    }
    fail io.linux_err(reported)
  }
  return child
}

// Waits for child, which is ending anyway; its failure changes nothing.
fn reap(child: isize) {
  _ = wait(child, false) catch { return }
}

// dup2 for the forked child: 0 or a negative code.
fn raw_duplicate(descriptor: isize, target: isize) isize {
  if descriptor == target {
    value := #syscall(sys.Fcntl, descriptor, 1, 0)
    if value < 0 { return value }
    return 0
  }
  value := #syscall(sys.Dup2, descriptor, target, 0)
  for value == -4 {
    value = #syscall(sys.Dup2, descriptor, target, 0)
  }
  if value < 0 { return value }
  return 0
}

// Waits for process to end. nonblocking returns process 0 when it is
// still running.
pub fn wait(process: isize, nonblocking: bool) Waited!io.IoErr {
  wait_status: i32 = 0
  options: usize = 0
  if nonblocking {
    options = 1
  }
  value := #syscall(sys.Wait4, process, &wait_status, options, 0)
  for value == -4 {
    value = #syscall(sys.Wait4, process, &wait_status, options, 0)
  }
  _ = try check(value)
  return Waited{ process: value, wait_status: wait_status }
}
pub fn exited(status: i32) bool {
  return (status & 127) == 0
}
pub fn exit_status(status: i32) u8 {
  return ((status >> 8) & 255)
}
pub fn signaled(status: i32) bool {
  return (status & 127) != 0 && (status & 127) != 127
}
pub fn termination_signal(status: i32) u8 {
  return (status & 127)
}

// Ends the whole process: exit_group, so other threads end with it.
pub fn exit_process(status: u8) {
  _ = #syscall(sys.ExitGroup, status)
  #panic("exit syscall returned")
}

// Reads the process's initial environment. Values are copied into caller
// storage. NotFound when the variable is unset; Capacity when the value does
// not fit destination.
pub fn environment_get(name: []const u8, destination: []u8) []u8!io.IoErr {
  // An empty name, or one holding '=' or NUL, is InvalidInput.
  if name.len == 0 { fail .InvalidInput }
  for name_byte in name {
    if name_byte == 0 || name_byte == '=' { fail .InvalidInput }
  }
  path := "/proc/self/environ\0"
  descriptor := try check(#syscall(sys.Openat, -100, &path[0], 0, 0))
  defer _ = #syscall(sys.Close, descriptor)
  scratch: [4096]u8
  position: usize = 0
  used: usize = 0
  matching := true
  in_value := false
  selected := false
  for {
    count := #syscall(sys.Read, descriptor, &scratch[0], scratch.len)
    if count == -4 { continue }
    _ = try check(count)
    if count == 0 {
      // The last entry has no end: EIO.
      if selected { fail io.linux_err(-5) }
      fail .NotFound
    }
    for byte in scratch[..#cast(usize, count)] {
      if byte == 0 {
        if selected { return destination[..used] }
        position = 0
        used = 0
        matching = true
        in_value = false
        selected = false
      } else if !in_value {
        if byte == '=' {
          in_value = true
          selected = matching && position == name.len
        } else {
          if position >= name.len || byte != name[position] {
            matching = false
          }
          position += 1
        }
      } else if selected {
        if used == destination.len { fail .Capacity }
        destination[used] = byte
        used += 1
      }
    }
  }
  return destination[..0]
}

// The working directory, in destination.
pub fn current_directory(destination: []u8) []u8!io.IoErr {
  if destination.len == 0 { fail io.linux_err(-34) }
  count := try check(#syscall(sys.Getcwd, &destination[0], destination.len))
  if count == 0 { fail io.linux_err(-5) }
  return destination[..#cast(usize, count) - 1]
}

struct SignalDisposition { handler: usize, flags: usize, restorer: usize, mask: u64 }
fn signal_disposition(signal: usize, handler: usize) !io.IoErr {
  action := SignalDisposition{ handler: handler }
  _ = try check(#syscall(sys.RtSigaction, signal, &action, 0, 8))
}
pub fn signal_ignore(signal: usize) !io.IoErr {
  try signal_disposition(signal, 1)
}
pub fn signal_default(signal: usize) !io.IoErr {
  try signal_disposition(signal, 0)
}

pub fn spawn(arena: *memory.Arena, path: []const u8, arguments: [][]const u8, options: SpawnOptions) isize!io.IoErr {
  empty: [0][]const u8
  return try spawn_environment(arena, path, arguments, empty[..], options)
}
