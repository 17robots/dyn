#target(kernel: linux)

use "std/mem" memory

pub struct Result { value: isize, error: isize, ok: bool }
pub struct MappingResult { memory: []u8, error: isize, ok: bool }

fn result(value: isize) Result {
  if value < 0 { return Result{ value: value, error: value, ok: false } }
  return Result{ value: value, error: 0, ok: true }
}

fn no_arguments() [][]const u8 {
  pointer: *[]const u8 = nil
  return pointer[..0]
}

// Linux exposes argv as NUL-separated bytes through procfs. Returned slices live
// in the caller arena. Limits are explicit and intentionally modest for tools.
pub fn process_arguments(arena: *memory.Arena) [][]const u8 {
  temporary: [16385]u8 = []
  path: [19]u8 = []
  source: []const u8 = "/proc/self/cmdline"
  i: usize = 0
  for i < #len(source) { path[i] = source[i] i += 1 }
  descriptor := #syscall(257, -100, &path[0], 0, 0)
  if descriptor < 0 { return no_arguments() }
  value := #syscall(0, descriptor, &temporary[0], #len(temporary))
  _ = #syscall(3, descriptor)
  if value < 0 || #cast(usize) value == #len(temporary) { return no_arguments() }
  used := #cast(usize) value
  count: usize = 0
  i = 0
  for i < used { if temporary[i] == 0 { count += 1 } i += 1 }
  if used > 0 && temporary[used - 1] != 0 { count += 1 }

  bytes_allocation := memory.arena_try_push_uninit(arena, used, 1)
  slots_allocation := memory.arena_try_push_uninit(arena, count * #sizeof([]const u8), #alignof([]const u8))
  if !bytes_allocation.ok || !slots_allocation.ok { #panic("argument arena exhausted") }
  bytes := bytes_allocation.memory[..used]
  _ = memory.copy(bytes, temporary[..used])
  arguments := (#cast(*[]const u8) slots_allocation.memory)[..count]
  start: usize = 0
  at: usize = 0
  i = 0
  for i < used {
    if bytes[i] == 0 { arguments[at] = bytes[start..i] at += 1 start = i + 1 }
    i += 1
  }
  if start < used { arguments[at] = bytes[start..] }
  return arguments
}

pub fn page_allocate(size: usize) MappingResult {
  if size == 0 { return MappingResult{ error: -22, ok: false } }
  address := #syscall(9, 0, size, 3, 34, -1, 0)
  if address < 0 { return MappingResult{ error: address, ok: false } }
  return MappingResult{ memory: (#cast(*u8) address)[..size], error: 0, ok: true }
}

pub fn page_release(memory: []u8) Result {
  if #len(memory) == 0 { return Result{ value: 0, error: 0, ok: true } }
  return result(#syscall(11, &memory[0], #len(memory)))
}

pub fn process_id() isize { return #syscall(39) }
pub fn parent_process_id() isize { return #syscall(110) }
pub fn thread_id() isize { return #syscall(186) }
pub fn yield_thread() { _ = #syscall(24) }

pub struct PipeResult { input: isize, output: isize, error: isize, ok: bool }
pub struct WaitResult { process: isize, status: i32, error: isize, ok: bool }
pub struct SpawnResult { process: isize, error: isize, ok: bool }
pub struct SpawnOptions { input: isize, output: isize, error: isize }
struct CStringPointer { value: *u8 }

pub fn pipe() PipeResult {
  descriptors: [2]i32 = []
  value := #syscall(293, &descriptors[0], 0)
  if value < 0 { return PipeResult{ input: -1, output: -1, error: value, ok: false } }
  return PipeResult{ input: #cast(isize) descriptors[0], output: #cast(isize) descriptors[1], ok: true }
}
pub fn close_descriptor(descriptor: isize) Result { return result(#syscall(3, descriptor)) }
pub fn duplicate_to(descriptor: isize, target: isize) Result {
  value := #syscall(33, descriptor, target)
  for value == -4 { value = #syscall(33, descriptor, target) }
  return result(value)
}
pub fn send_signal(process: isize, signal: usize) Result { return result(#syscall(62, process, signal)) }
pub fn fork_process() Result { return result(#syscall(57)) }

fn terminate(arena: *memory.Arena, text: []const u8) *u8 {
  raw := memory.arena_push(arena, #len(text) + 1, 1)
  bytes := raw[..#len(text) + 1]
  i: usize = 0
  for i < #len(text) { bytes[i] = text[i] i += 1 }
  bytes[#len(text)] = 0
  return raw
}

pub fn execute(arena: *memory.Arena, path: []const u8, arguments: [][]const u8) isize {
  mark := memory.arena_mark(arena)
  path_raw := terminate(arena, path)
  length := #len(arguments)
  raw := #cast(*CStringPointer) memory.arena_push(
    arena, (length + 1) * #sizeof(CStringPointer), #alignof(CStringPointer),
  )
  pointers := raw[..length + 1]
  i: usize = 0
  for i < length { pointers[i] = CStringPointer{ value: terminate(arena, arguments[i]) } i += 1 }
  pointers[length] = CStringPointer{ value: nil }
  value := #syscall(59, path_raw, &pointers[0], &pointers[length])
  memory.arena_rewind(arena, mark)
  return value
}

pub fn spawn(
  arena: *memory.Arena,
  path: []const u8,
  arguments: [][]const u8,
  options: SpawnOptions,
) SpawnResult {
  child := fork_process()
  if !child.ok { return SpawnResult{ process: -1, error: child.error, ok: false } }
  if child.value == 0 {
    if options.input >= 0 && !duplicate_to(options.input, 0).ok { exit_process(126) }
    if options.output >= 0 && !duplicate_to(options.output, 1).ok { exit_process(126) }
    if options.error >= 0 && !duplicate_to(options.error, 2).ok { exit_process(126) }
    _ = execute(arena, path, arguments)
    exit_process(127)
  }
  return SpawnResult{ process: child.value, error: 0, ok: true }
}

pub fn wait(process: isize, nonblocking: bool) WaitResult {
  status: i32 = 0
  options: usize = 0
  if nonblocking { options = 1 }
  value := #syscall(61, process, &status, options, 0)
  for value == -4 { value = #syscall(61, process, &status, options, 0) }
  if value < 0 { return WaitResult{ process: value, status: status, error: value, ok: false } }
  return WaitResult{ process: value, status: status, error: 0, ok: true }
}
pub fn exited(status: i32) bool { return (status & 127) == 0 }
pub fn exit_status(status: i32) u8 { return #cast(u8) ((status >> 8) & 255) }
pub fn signaled(status: i32) bool { return (status & 127) != 0 && (status & 127) != 127 }
pub fn termination_signal(status: i32) u8 { return #cast(u8) (status & 127) }

pub fn exit_process(status: u8) {
  _ = #syscall(60, status)
  #panic("exit syscall returned")
}
