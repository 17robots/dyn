// Allocator callbacks return uninitialized storage. Allocation builtins provide
// default zeroing and checked typed sizing. Failures use the compiler-defined AllocError categories.
fn fixed_allocate(context: rawptr, size: usize, alignment: usize, error: *AllocError) rawptr {
  allocation := arena_push_uninit(#cast(*Arena) context, size, alignment)
  error.* = allocator_error(allocation.error)
  return allocation.memory
}

fn growing_allocate(context: rawptr, size: usize, alignment: usize, error: *AllocError) rawptr {
  allocation := growing_push_uninit(#cast(*GrowingArena) context, size, alignment)
  error.* = allocator_error(allocation.error)
  return allocation.memory
}

// Ownership: handle borrows the arena descriptor; copying shares its state.
// Invalidation: keep the descriptor at the same address while using this handle.
// Allocation: construction allocates no storage; requests use fixed capacity.
// Thread safety: caller synchronizes shared access.
pub fn arena_allocator(arena: *Arena) Allocator {
  return #allocator(arena, &fixed_allocate)
}

// Ownership: handle borrows the growing arena descriptor; copying shares state.
// Invalidation: reset invalidates payloads, not the handle; release invalidates payloads.
// Allocation: construction allocates nothing; requests obey the owner's growth limit.
// Thread safety: caller synchronizes shared access.
pub fn growing_allocator(arena: *GrowingArena) Allocator {
  return #allocator(arena, &growing_allocate)
}

fn allocator_error(error: ErrorKind) AllocError {
  case error {
    ErrorKind.None => { return AllocError.None },
    ErrorKind.InvalidAlignment => { return AllocError.InvalidAlignment },
    ErrorKind.Capacity => { return AllocError.Capacity },
    ErrorKind.InvalidState => { return AllocError.InvalidState },
    ErrorKind.Overflow => { return AllocError.Overflow },
    ErrorKind.System => { return AllocError.System },
  }
}
