#target(kernel: linux)
use "std/os/linux/sys"
// Address space each arena block reserves by default. Only touched pages cost memory.
const DefaultBlock: usize = 64 * GiB
fn mapping_allocate(size: usize) Mapping {
  address := #syscall(sys.Mmap, 0, size, 3, 16418, -1, 0)
  if address < 0 { return Mapping{ error: address } }
  // With transparent huge pages set to "always", the first touch of a large
  // aligned reservation faults a whole 2 MiB page, so every small arena would
  // cost 2 MiB resident. Opt only the leading 2 MiB out; bigger arenas still
  // get huge pages for the rest. Advice failure only loses the saving.
  head := size
  if head > 2 * MiB {
    head = 2 * MiB
  }
  _ = #syscall(sys.Madvise, address, head, 15)
  return Mapping{ bytes: #slice(#cast(*u8, address), size), committed: size, ok: true, zeroed: true }
}
fn mapping_release(bytes: []u8) isize {
  return #syscall(sys.Munmap, &bytes[0], bytes.len)
}
// The whole mapping is committed at creation.
fn mapping_commit(bytes: []u8, from: usize, to: usize) bool {
  return true
}

// Huge pages off for the whole pages inside bytes (MADV_NOHUGEPAGE).
fn mapping_sparse(bytes: []u8) {
  if bytes.len == 0 { return }
  start := (#cast(usize, &bytes[0]) + 4095) & ~#cast(usize, 4095)
  end := (#cast(usize, &bytes[0]) + bytes.len) & ~#cast(usize, 4095)
  if end > start {
    _ = #syscall(sys.Madvise, start, end - start, 15)
  }
}

extern fn rt_lifetime_checks "dyn_lifetime_checks_enabled"() bool

fn mapping_protect(bytes: []u8, from: usize, to: usize, accessible: bool) bool {
  if bytes.len == 0 || to <= from || to > bytes.len { return true }
  base := #cast(usize, &bytes[0])
  start := base + from
  end := base + to
  if accessible {
    pstart := start & ~#cast(usize, 4095)
    pend := (end + 4095) & ~#cast(usize, 4095)
    limit := base + bytes.len
    if pend > limit { pend = limit }
    if pend <= pstart { return true }
    return #syscall(sys.Mprotect, pstart, pend - pstart, 3) == 0
  }
  pstart := (start + 4095) & ~#cast(usize, 4095)
  pend := (end + 4095) & ~#cast(usize, 4095)
  limit := base + bytes.len
  if pend > limit { pend = limit }
  if pend <= pstart { return true }
  return #syscall(sys.Mprotect, pstart, pend - pstart, 0) == 0
}

fn mapping_thread_id() u64 {
  return #cast(u64, #syscall(sys.Gettid))
}

fn mapping_check_lifetimes() bool {
  return rt_lifetime_checks()
}
