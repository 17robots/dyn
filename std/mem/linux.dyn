#target(kernel: linux)
// Address space each arena block reserves by default. Only touched pages cost memory.
const DefaultBlock: usize = 64 * GiB
fn mapping_allocate(size: usize) Mapping {
  address := #syscall(9, 0, size, 3, 16418, -1, 0)
  if address < 0 {
    return Mapping{ error: address }
  }
  // With transparent huge pages set to "always", the first touch of a large
  // aligned reservation faults a whole 2 MiB page, so every small arena would
  // cost 2 MiB resident. Opt only the leading 2 MiB out; bigger arenas still
  // get huge pages for the rest. Advice failure only loses the saving.
  head := size
  if head > 2 * MiB {
    head = 2 * MiB
  }
  _ = #syscall(28, address, head, 15)
  return Mapping{ bytes: (#cast(*u8, address))[..size], committed: size, ok: true }
}
fn mapping_release(bytes: []u8) isize {
  return #syscall(11, &bytes[0], #len(bytes))
}
// The whole mapping is committed at creation.
fn mapping_commit(bytes: []u8, from: usize, to: usize) bool {
  return true
}
