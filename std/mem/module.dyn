// Bounded arena and fixed-slot reuse primitives.
//
// Arena borrows its backing slice. Reset or rewind invalidates affected allocations.
// FreeList borrows one fixed region, commonly carved from an arena. Returning a slot
// recycles it inside the list; it does not return memory to the arena.

pub struct Allocation {
  memory: *u8,
  size: usize,
  ok: bool,
}

pub struct Arena {
  data: []u8,
  offset: usize,
}

pub fn arena_init(backing: []u8) Arena {
  return Arena{ data: backing, offset: 0 }
}

// Preferred constructor name. Backing may be a stack array, mapped memory, or
// memory carved from another arena; allocation policy stays outside callers.
pub fn arena_from_buffer(backing: []u8) Arena { return arena_init(backing) }

pub fn arena_capacity(arena: *const Arena) usize { return #len(arena.data) }
pub fn arena_used(arena: *const Arena) usize { return arena.offset }
pub fn arena_remaining(arena: *const Arena) usize { return #len(arena.data) - arena.offset }
pub fn arena_mark(arena: *const Arena) usize { return arena.offset }

pub fn arena_reset(arena: *Arena) {
  arena.offset = 0
}

pub fn arena_rewind(arena: *Arena, mark: usize) {
  if mark > arena.offset { #panic("arena mark is ahead of current position") }
  arena.offset = mark
}

pub fn arena_reset_to(arena: *Arena, mark: usize) { arena_rewind(arena, mark) }

fn valid_alignment(alignment: usize) bool {
  return alignment != 0 && (alignment & (alignment - 1)) == 0
}

fn arena_try_push_impl(arena: *Arena, size: usize, alignment: usize, zero_memory: bool) Allocation {
  if !valid_alignment(alignment) { return Allocation{ memory: nil, size: 0, ok: false } }
  if size == 0 { return Allocation{ memory: nil, size: 0, ok: true } }
  if arena.offset > #len(arena.data) { return Allocation{ memory: nil, size: 0, ok: false } }

  available := arena.data[arena.offset..]
  if #len(available) == 0 { return Allocation{ memory: nil, size: 0, ok: false } }

  address := #cast(usize) &available[0]
  remainder := address & (alignment - 1)
  padding: usize = 0
  if remainder != 0 { padding = alignment - remainder }
  if padding > #len(available) { return Allocation{ memory: nil, size: 0, ok: false } }
  if size > #len(available) - padding { return Allocation{ memory: nil, size: 0, ok: false } }

  memory := &available[padding]
  arena.offset += padding + size
  if zero_memory { zero(memory[..size]) }
  return Allocation{ memory: memory, size: size, ok: true }
}

pub fn arena_try_push(arena: *Arena, size: usize, alignment: usize) Allocation {
  return arena_try_push_impl(arena, size, alignment, true)
}

pub fn arena_try_push_uninit(arena: *Arena, size: usize, alignment: usize) Allocation {
  return arena_try_push_impl(arena, size, alignment, false)
}

pub fn arena_push(arena: *Arena, size: usize, alignment: usize) *u8 {
  allocation := arena_try_push(arena, size, alignment)
  if !allocation.ok { #panic("arena exhausted or alignment invalid") }
  return allocation.memory
}

pub fn arena_push_uninit(arena: *Arena, size: usize, alignment: usize) *u8 {
  allocation := arena_try_push_uninit(arena, size, alignment)
  if !allocation.ok { #panic("arena exhausted or alignment invalid") }
  return allocation.memory
}

// Returned arena borrows storage consumed from parent. Rewind/reset of parent
// invalidates child and all allocations made through it.
pub fn arena_try_sub(parent: *Arena, capacity: usize) Arena {
  allocation := arena_try_push_uninit(parent, capacity, 1)
  if !allocation.ok { return Arena{ data: parent.data[0..0], offset: 0 } }
  if capacity == 0 { return Arena{ data: parent.data[0..0], offset: 0 } }
  return arena_init(allocation.memory[..capacity])
}

pub fn arena_sub(parent: *Arena, capacity: usize) Arena {
  child := arena_try_sub(parent, capacity)
  if capacity != 0 && #len(child.data) == 0 { #panic("parent arena exhausted") }
  return child
}

pub fn arena_child(parent: *Arena, capacity: usize) Arena { return arena_sub(parent, capacity) }

pub struct Scratch {
  arena: *Arena,
  mark: usize,
  active: bool,
}

// Chooses first unless it conflicts with a live caller arena. Scratch does not
// own either arena and must end before either arena is reset or released.
pub fn scratch_begin(first: *Arena, second: *Arena, conflict: *const Arena) Scratch {
  selected := first
  if conflict == first { selected = second }
  if selected == nil { #panic("scratch requires a non-conflicting arena") }
  return Scratch{ arena: selected, mark: arena_mark(selected), active: true }
}

pub fn scratch_end(scratch: *Scratch) {
  if !scratch.active { #panic("scratch scope already ended") }
  arena_rewind(scratch.arena, scratch.mark)
  scratch.active = false
}

struct FreeListNode { next: *FreeListNode }

pub struct FreeList {
  backing: []u8,
  slot_size: usize,
  slot_count: usize,
  free_count: usize,
  free_head: *FreeListNode,
}

fn align_size(size: usize, alignment: usize) usize {
  remainder := size & (alignment - 1)
  if remainder == 0 { return size }
  padding := alignment - remainder
  maximum: usize = 18446744073709551615
  if size > maximum - padding { return 0 }
  return size + padding
}

pub fn free_list_init(backing: []u8, requested_slot_size: usize, alignment: usize) FreeList {
  if !valid_alignment(alignment) { #panic("free-list alignment must be non-zero power of two") }
  slot_size := requested_slot_size
  if slot_size < #sizeof(FreeListNode) { slot_size = #sizeof(FreeListNode) }
  slot_size = align_size(slot_size, alignment)
  if slot_size == 0 || #len(backing) < slot_size { #panic("free list requires at least one slot") }
  if #len(backing) > 0 && (#cast(usize) &backing[0] & (alignment - 1)) != 0 {
    #panic("free-list backing has wrong alignment")
  }

  count := #len(backing) / slot_size
  i: usize = 0
  for i < count {
    node := #cast(*FreeListNode) &backing[i * slot_size]
    if i + 1 < count { node.next = #cast(*FreeListNode) &backing[(i + 1) * slot_size] }
    else { node.next = nil }
    i += 1
  }
  return FreeList{
    backing: backing,
    slot_size: slot_size,
    slot_count: count,
    free_count: count,
    free_head: #cast(*FreeListNode) &backing[0],
  }
}

pub fn free_list_from_arena(
  arena: *Arena,
  slot_count: usize,
  slot_size: usize,
  alignment: usize,
) FreeList {
  if slot_count == 0 { #panic("free list requires at least one slot") }
  actual := slot_size
  if actual < #sizeof(FreeListNode) { actual = #sizeof(FreeListNode) }
  actual = align_size(actual, alignment)
  maximum: usize = 18446744073709551615
  if actual == 0 || slot_count > maximum / actual { #panic("free-list capacity overflow") }
  size := slot_count * actual
  memory := arena_push_uninit(arena, size, alignment)
  return free_list_init(memory[..size], actual, alignment)
}

pub fn free_list_try_alloc(list: *FreeList) rawptr {
  if list.free_head == nil { return nil }
  node := list.free_head
  list.free_head = node.next
  list.free_count -= 1
  return #cast(rawptr) node
}

pub fn free_list_alloc(list: *FreeList) rawptr {
  memory := free_list_try_alloc(list)
  if memory == nil { #panic("free list exhausted") }
  return memory
}

pub fn free_list_free(list: *FreeList, memory: rawptr) {
  if memory == nil { return }
  address := #cast(usize) memory
  start := #cast(usize) &list.backing[0]
  end := start + list.slot_count * list.slot_size
  if address < start || address >= end || (address - start) % list.slot_size != 0 {
    #panic("pointer does not belong to free list")
  }
  node := #cast(*FreeListNode) memory
  existing := list.free_head
  for existing != nil {
    if existing == node { #panic("free-list double free") }
    existing = existing.next
  }
  node.next = list.free_head
  list.free_head = node
  list.free_count += 1
  if list.free_count > list.slot_count { #panic("free-list double free") }
}

// Arena-backed fixed-size object storage. Pool is the ordinary reuse interface;
// FreeList remains available when callers need its lower-level accounting.
pub struct Pool { list: FreeList }

pub fn pool_init(
  arena: *Arena,
  slot_count: usize,
  slot_size: usize,
  alignment: usize,
) Pool {
  return Pool{ list: free_list_from_arena(arena, slot_count, slot_size, alignment) }
}

pub fn pool_capacity(pool: *const Pool) usize { return pool.list.slot_count }
pub fn pool_available(pool: *const Pool) usize { return pool.list.free_count }
pub fn pool_try_acquire(pool: *Pool) rawptr { return free_list_try_alloc(&pool.list) }
pub fn pool_acquire(pool: *Pool) rawptr { return free_list_alloc(&pool.list) }
pub fn pool_release(pool: *Pool, memory: rawptr) { free_list_free(&pool.list, memory) }

pub fn copy(destination: []u8, source: []const u8) usize {
  if #len(destination) < #len(source) { #panic("copy destination too small") }
  i: usize = 0
  for i < #len(source) {
    destination[i] = source[i]
    i += 1
  }
  return #len(source)
}

pub fn move(destination: []u8, source: []const u8) usize {
  if #len(destination) < #len(source) { #panic("move destination too small") }
  if #len(source) == 0 { return 0 }
  destination_address := #cast(usize) &destination[0]
  source_address := #cast(usize) &source[0]
  i: usize = 0
  if destination_address > source_address && destination_address < source_address + #len(source) {
    i = #len(source)
    for i > 0 {
      i -= 1
      destination[i] = source[i]
    }
  } else {
    for i < #len(source) {
      destination[i] = source[i]
      i += 1
    }
  }
  return #len(source)
}

pub fn zero(bytes: []u8) {
  i: usize = 0
  for i < #len(bytes) {
    bytes[i] = 0
    i += 1
  }
}

pub fn compare(left: []const u8, right: []const u8) i32 {
  count := #len(left)
  if #len(right) < count { count = #len(right) }
  i: usize = 0
  for i < count {
    if left[i] < right[i] { return -1 }
    if left[i] > right[i] { return 1 }
    i += 1
  }
  if #len(left) < #len(right) { return -1 }
  if #len(left) > #len(right) { return 1 }
  return 0
}
