pub struct ByteBuffer {
  data: []u8,
  length: usize,
}

pub fn byte_buffer_init(arena: *Arena, capacity: usize) ByteBuffer {
  allocation := arena_try_push(arena, capacity, 1)
  if !allocation.ok { return ByteBuffer{ data: arena.data[0..0], length: 0 } }
  return ByteBuffer{ data: allocation.memory[..capacity], length: 0 }
}

pub fn byte_buffer_remaining(buffer: *const ByteBuffer) usize { return #len(buffer.data) - buffer.length }
pub fn byte_buffer_written(buffer: *const ByteBuffer) []const u8 { return buffer.data[..buffer.length] }

pub fn byte_buffer_push(buffer: *ByteBuffer, bytes: []const u8) bool {
  if #len(bytes) > byte_buffer_remaining(buffer) { return false }
  i: usize = 0
  for i < #len(bytes) {
    buffer.data[buffer.length + i] = bytes[i]
    i += 1
  }
  buffer.length += #len(bytes)
  return true
}

pub fn byte_buffer_push_byte(buffer: *ByteBuffer, byte: u8) bool {
  if buffer.length == #len(buffer.data) { return false }
  buffer.data[buffer.length] = byte
  buffer.length += 1
  return true
}

pub fn byte_buffer_clear(buffer: *ByteBuffer) { buffer.length = 0 }
