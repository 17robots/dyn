pub struct Arena {
  data: []u8,
  offset: usize,
  owns_data: bool,
}

pub struct Allocation {
  memory: *u8,
  ok: bool,
}

struct ArenaBlock {
  arena: Arena,
  next: *ArenaBlock,
}

pub struct ChainedArena {
  first: *ArenaBlock,
  current: *ArenaBlock,
  block_capacity: usize,
}

pub fn arena_init(backing: []u8) Arena {
  return Arena{ data: backing, offset: 0, owns_data: false }
}

pub fn arena_make(memory_capacity_bytes: usize) Arena {
  address := #syscall(9, 0, memory_capacity_bytes, 3, 34, -1, 0)
  if address >= 0 {
    return Arena{ data: (#cast(*u8) address)[..memory_capacity_bytes], offset: 0, owns_data: true }
  }
  #panic("page allocation failed")
}
pub fn arena_capacity(arena: *const Arena) usize { return #len(arena.data) }
pub fn arena_remaining(arena: *const Arena) usize { return #len(arena.data) - arena.offset }
pub fn arena_mark(arena: *const Arena) usize { return arena.offset }
pub fn arena_reset(arena: *Arena) { arena.offset = 0 }

// Returned arena borrows storage from parent. Reset/rewind/release of parent
// invalidates every allocation from child.
pub fn arena_sub(parent: *Arena, capacity: usize) Arena {
  if capacity == 0 { return Arena{ data: parent.data[0..0], offset: 0, owns_data: false } }
  allocation := arena_try_push(parent, capacity, 1)
  if !allocation.ok { #panic("parent arena exhausted") }
  return arena_init(allocation.memory[..capacity])
}

// Selects one of two caller-owned scratch arenas. A live borrow from conflict
// prevents selecting that arena. Caller marks/rewinds selected scratch.
pub fn scratch_select(first: *Arena, second: *Arena, conflict: *const Arena) *Arena {
  if conflict == first { return second }
  return first
}

pub fn arena_rewind(arena: *Arena, mark: usize) {
  if mark > arena.offset { #panic("arena mark is ahead of current position") }
  arena.offset = mark
}

pub fn arena_release(arena: *Arena) {
  if arena.owns_data && #len(arena.data) > 0 {
    result := #syscall(11, &arena.data[0], #len(arena.data))
    if result != 0 { #panic("page release failed") }
  }
  arena.offset = 0
  arena.data = arena.data[0..0]
  arena.owns_data = false
}

fn arena_fits(arena: *const Arena, size: usize, alignment: usize) bool {
  fits := true
  if alignment == 0 || (alignment & (alignment - 1)) != 0 {
    fits = false
  } else if size == 0 {
    fits = true
  } else if #len(arena.data) == 0 {
    fits = false
  } else {
    if arena.offset > #len(arena.data) { return false }
    base := #cast(usize) &arena.data[0]
    address := base + arena.offset
    remainder := address & (alignment - 1)
    padding: usize = 0
    if remainder != 0 { padding = alignment - remainder }
    if padding > #len(arena.data) - arena.offset {
      fits = false
    } else if size > #len(arena.data) - arena.offset - padding {
      fits = false
    }
  }
  return fits
}

pub fn arena_try_push(arena: *Arena, allocation_size_bytes: usize, alignment_bytes: usize) Allocation {
  if alignment_bytes == 0 || (alignment_bytes & (alignment_bytes - 1)) != 0 {
    return Allocation{ memory: nil, ok: false }
  }
  if allocation_size_bytes == 0 { return Allocation{ memory: nil, ok: true } }
  if #len(arena.data) == 0 || arena.offset > #len(arena.data) {
    return Allocation{ memory: nil, ok: false }
  }
  available := arena.data[arena.offset..]
  if #len(available) == 0 { return Allocation{ memory: nil, ok: false } }
  address := #cast(usize) &available[0]
  remainder := address & (alignment_bytes - 1)
  padding: usize = 0
  if remainder != 0 { padding = alignment_bytes - remainder }
  if padding > #len(available) {
    return Allocation{ memory: nil, ok: false }
  }
  aligned := available[padding..]
  if allocation_size_bytes > #len(aligned) { return Allocation{ memory: nil, ok: false } }
  arena.offset += padding + allocation_size_bytes
  result: *u8 = &aligned[0]
  bytes := result[..allocation_size_bytes]
  i: usize = 0
  for i < allocation_size_bytes {
    bytes[i] = 0
    i += 1
  }
  return Allocation{ memory: result, ok: true }
}

pub fn arena_push(arena: *Arena, allocation_size_bytes: usize, alignment_bytes: usize) *u8 {
  allocation := arena_try_push(arena, allocation_size_bytes, alignment_bytes)
  if !allocation.ok { #panic("arena exhausted or invalid alignment") }
  return allocation.memory
}

fn arena_block_make(capacity: usize) *ArenaBlock {
  mapping_size: usize = 4096
  address: isize = #syscall(9, 0, mapping_size, 3, 34, -1, 0)
  if address < 0 { #panic("arena block allocation failed") }
  block: *ArenaBlock = #cast(*ArenaBlock) address
  block.arena = arena_make(capacity)
  block.next = nil
  return block
}

pub fn chained_arena_init(block_capacity: usize) ChainedArena {
  if block_capacity == 0 { #panic("chained arena block capacity must be non-zero") }
  return ChainedArena{ first: nil, current: nil, block_capacity: block_capacity }
}

pub fn chained_arena_push(chain: *ChainedArena, size: usize, alignment: usize) *u8 {
  if alignment == 0 || (alignment & (alignment - 1)) != 0 { #panic("arena alignment must be a non-zero power of two") }
  maximum: usize = 18446744073709551615
  if size > maximum - (alignment - 1) { #panic("arena allocation size overflow") }
  if chain.current == nil {
    capacity: usize = chain.block_capacity
    if capacity < size + alignment { capacity = size + alignment }
    block: *ArenaBlock = arena_block_make(capacity)
    chain.first = block
    chain.current = block
  }
  for !arena_fits(&chain.current.arena, size, alignment) {
    if chain.current.next != nil { chain.current = chain.current.next }
    else {
      next_capacity: usize = chain.block_capacity
      if next_capacity < size + alignment { next_capacity = size + alignment }
      next_block: *ArenaBlock = arena_block_make(next_capacity)
      chain.current.next = next_block
      chain.current = next_block
    }
  }
  return arena_push(&chain.current.arena, size, alignment)
}

pub fn chained_arena_reset(chain: *ChainedArena) {
  block: *ArenaBlock = chain.first
  for block != nil {
    arena_reset(&block.arena)
    block = block.next
  }
  chain.current = chain.first
}

pub fn chained_arena_release(chain: *ChainedArena) {
  block: *ArenaBlock = chain.first
  for block != nil {
    next: *ArenaBlock = block.next
    arena_release(&block.arena)
    result := #syscall(11, block, 4096)
    if result != 0 { #panic("arena block release failed") }
    block = next
  }
  chain.first = nil
  chain.current = nil
}
