use "std/observe" observe

// Arenas and typed pushes.
//
// An arena owns chained OS blocks or lives in a caller buffer; handles are *Arena.
// Reset or rewind invalidates affected allocations.
// Reuse of individual objects is intrusive: see std/container/list free lists.

pub enum ErrorKind { None, InvalidAlignment, Capacity, InvalidState, Overflow, System }

pub struct Allocation {
  error: ErrorKind,
  code: isize,
  memory: *u8,
  size: usize,
  ok: bool,
}

// An arena is a chain of blocks. Each block starts with an Arena header, so a
// *Arena refers to its backing header. Do not copy the public header or use
// an owning handle after release. The first
// block's header is the handle: it records the newest block and the
// arena-wide settings and statistics. A position is a byte offset in the
// arena's position space, where each block begins where the previous one
// ended; marks are positions.
pub struct Arena {
  // First block only: the newest block, where pushes go.
  current: *Arena,
  // The block before this one; nil for the first block.
  previous: *Arena,
  // This block's bytes, header included.
  data: []u8,
  // Position of data[0].
  base: usize,
  // Bytes used in this block, header included.
  offset: usize,
  // Bytes of this block the OS has committed. Only Windows commits on demand.
  committed: usize,
  // This block is an OS mapping that release returns.
  owns_memory: bool,
  // First block only. Never add blocks: set for arena_from_buffer.
  fixed_buffer: bool,
  // First block only: preferred size of each new block.
  block_size: usize,
  // First block only: cap on backing bytes across all blocks; zero means none.
  limit: usize,
  // First block only: backing bytes across all blocks.
  backing: usize,
  // First block only. Opt-in diagnostic scribble; does not make expired pointers safe.
  poison_on_rewind: bool,
  peak_used: usize,
  allocation_failures: usize,
  // First block only. Optional borrowed event sink; keep it alive until release.
  events: *observe.Log,
  event_resource: u64,
}

struct Mapping { bytes: []u8, committed: usize, error: isize, ok: bool }
struct Growth { error: ErrorKind, code: isize }

// Bytes the arena header takes at the start of each block, and of every
// arena_from_buffer buffer. See ArenaBufferOverhead for unaligned caller buffers.
pub const ArenaHeader: usize = 144
// Maximum bytes consumed by the header and aligning arbitrary caller storage.
// A buffer of payload + ArenaBufferOverhead bytes guarantees payload capacity.
pub const ArenaBufferOverhead: usize = ArenaHeader + 15

fn header_size() usize {
  if #sizeof(Arena) > ArenaHeader {
    #panic("ArenaHeader is smaller than Arena")
  }
  return ArenaHeader
}

// Reserve and commit enough bytes for the header before storing into it.
// Windows mappings initially reserve address space without writable pages.
fn mapping_with_header(size: usize) Mapping {
  mapping := mapping_allocate(size)
  if !mapping.ok {
    return mapping
  }
  if mapping.committed < header_size() {
    if !mapping_commit(mapping.bytes, 0, header_size()) {
      _ = mapping_release(mapping.bytes)
      return Mapping{error: -12}
    }
    mapping.committed = header_size()
  }
  return mapping
}

// Puts a block header at the start of bytes.
fn block_init(bytes: []u8, base: usize, owns_memory: bool, committed: usize) *Arena {
  block := #cast(*Arena, &bytes[0])
  block.* = Arena{ data: bytes, base: base, offset: header_size(), owns_memory: owns_memory, committed: committed }
  return block
}

// Places an arena in caller storage. The header takes the first ArenaHeader
// bytes of backing (plus up to 15 to align it), and the arena never grows past
// backing. Panics when backing
// cannot hold the header. Release clears it; reuse the storage by calling this
// again.
pub fn arena_from_buffer(backing: []u8) *Arena {
  if #len(backing) == 0 {
    #panic("arena buffer cannot hold the arena header")
  }
  address := #cast(usize, &backing[0])
  skip := align_size(address, 16) - address
  if skip > #len(backing) || #len(backing) - skip < header_size() {
    #panic("arena buffer cannot hold the arena header")
  }
  arena := block_init(backing[skip..], 0, false, 0)
  arena.current = arena
  arena.fixed_buffer = true
  arena.backing = #len(arena.data)
  return arena
}

// Creates an owning arena. block_size is the reservation for each block; zero
// picks the target default (64 GiB of address space on 64-bit hosts, where only
// touched pages cost memory). When a block fills up, the arena adds another, so
// earlier allocations never move. Panics when the OS refuses the reservation.
// Release with arena_release.
pub fn arena_create(block_size: usize) *Arena {
  return arena_create_bounded(block_size, 0)
}

// Like arena_create, with a cap on backing bytes across all blocks, headers
// included. Pushes that would pass it fail like an exhausted fixed arena. A zero
// limit means no cap.
pub fn arena_create_bounded(block_size: usize, limit: usize) *Arena {
  if limit != 0 && limit < header_size() {
    #panic("arena backing limit cannot hold the header")
  }
  size := block_size
  if size == 0 {
    size = DefaultBlock
  }
  if limit != 0 && size > limit {
    size = limit
  }
  if size < header_size() {
    size = header_size()
  }
  mapping := mapping_with_header(size)
  if !mapping.ok {
    #panic("cannot reserve arena memory")
  }
  arena := block_init(mapping.bytes, 0, true, mapping.committed)
  arena.current = arena
  arena.block_size = size
  arena.limit = limit
  arena.backing = size
  return arena
}

// Frees every block that is not the first. Release with the newest first, so a
// bare-metal region is returned in order.
fn release_blocks_after(arena: *Arena, keep: *Arena) {
  for arena.current != nil && arena.current != keep {
    block := arena.current
    arena.current = block.previous
    arena.backing -= #len(block.data)
    bytes := block.data
    if block.owns_memory && mapping_release(bytes) != 0 {
      #panic("cannot release arena memory")
    }
  }
}

// Returns owned blocks to the OS. A buffer arena is cleared and its storage is
// left to the caller. Releasing nil does nothing, so zero-valued owners can be
// released. Invalidation: everything pushed, and the arena itself.
pub fn arena_release(arena: *Arena) {
  if arena == nil {
    return
  }
  arena_event(arena, observe.Kind.Released, arena_used(arena))
  release_blocks_after(arena, arena)
  if arena.owns_memory {
    bytes := arena.data
    if mapping_release(bytes) != 0 {
      #panic("cannot release arena memory")
    }
    return
  }
  arena.* = Arena{}
}

const CommitStep: usize = 1048576

// Commits a block's backing through end, in CommitStep pieces. Windows only in practice.
fn arena_commit(block: *Arena, end: usize) {
  target := align_size(end, CommitStep)
  if target > #len(block.data) || target < end {
    target = #len(block.data)
  }
  if !mapping_commit(block.data, block.committed, target) {
    #panic("cannot commit arena memory")
  }
  block.committed = target
}

// Bytes the arena can hold without adding a block: everything in its blocks
// except headers.
pub fn arena_capacity(arena: *const Arena) usize {
  return arena.backing - arena_blocks(arena) * header_size()
}
// Bytes pushed, padding included, headers excluded.
pub fn arena_used(arena: *const Arena) usize {
  total: usize = 0
  block := arena.current
  for block != nil {
    total += block.offset - header_size()
    block = block.previous
  }
  return total
}
// Bytes left in the newest block. An owning arena adds blocks past this.
pub fn arena_remaining(arena: *const Arena) usize {
  return #len(arena.current.data) - arena.current.offset
}
// Reports whether source borrows unused backing in any block. These bytes are
// not live allocations and must not be used as producer inputs on this arena.
// Allocation: none. Cost: linear in the number of arena blocks.
pub fn arena_overlaps_unallocated(arena: *const Arena, source: []const u8) bool {
  if arena == nil || #len(source) == 0 {
    return false
  }
  input := #cast(usize, &source[0])
  block := arena.current
  for block != nil {
    if block.offset < #len(block.data) {
      tail := #cast(usize, &block.data[block.offset])
      count := #len(block.data) - block.offset
      if input <= tail {
        if tail - input < #len(source) {
          return true
        }
      } else if input - tail < count {
        return true
      }
    }
    block = block.previous
  }
  return false
}

pub fn arena_mark(arena: *const Arena) usize {
  return arena.current.base + arena.current.offset
}
fn arena_blocks(arena: *const Arena) usize {
  count: usize = 0
  block := arena.current
  for block != nil {
    count += 1
    block = block.previous
  }
  return count
}

pub struct ArenaSnapshot {
  capacity: usize, used: usize, remaining: usize, blocks: usize, owns_memory: bool,
  poison_on_rewind: bool, peak_used: usize, allocation_failures: usize,
}

// Allocation-free value snapshot. Contains no borrowed pointers and survives reset/release.
// Includes peak usage and allocation failures since creation. No synchronization.
pub fn arena_snapshot(arena: *const Arena) ArenaSnapshot {
  return ArenaSnapshot{ capacity: arena_capacity(arena), used: arena_used(arena),
    remaining: arena_remaining(arena), blocks: arena_blocks(arena), owns_memory: arena.owns_memory,
    poison_on_rewind: arena.poison_on_rewind, peak_used: arena.peak_used,
    allocation_failures: arena.allocation_failures }
}

pub fn arena_reset(arena: *Arena) {
  arena_rewind(arena, arena_start(arena))
}

// The mark of an empty arena.
pub fn arena_start(arena: *const Arena) usize {
  return header_size()
}

// Frees the blocks added after mark and returns the newest remaining block to it.
pub fn arena_rewind(arena: *Arena, mark: usize) {
  if mark > arena_mark(arena) {
    #panic("arena mark is ahead of current position")
  }
  // Marks below the start, such as 0, rewind to the start.
  target := mark
  if target < header_size() {
    target = header_size()
  }
  reclaimed := arena_mark(arena) - target
  for arena.current != arena && target <= arena.current.base + header_size() {
    block := arena.current
    arena.current = block.previous
    arena.backing -= #len(block.data)
    if block.owns_memory && mapping_release(block.data) != 0 {
      #panic("cannot release arena memory")
    }
  }
  block := arena.current
  at := target - block.base
  if arena.poison_on_rewind {
    i := at
    for i < block.offset {
      block.data[i] = 221
      i += 1
    }
  }
  block.offset = at
  arena_event(arena, observe.Kind.Reclaimed, reclaimed)
}

fn align_size(size: usize, alignment: usize) usize {
  remainder := size & (alignment - 1)
  if remainder == 0 {
    return size
  }
  padding := alignment - remainder
  maximum := ~#cast(usize, 0)
  if size > maximum - padding {
    return 0
  }
  return size + padding
}

fn valid_alignment(alignment: usize) bool {
  return alignment != 0 && (alignment & (alignment - 1)) == 0
}

fn arena_event(arena: *Arena, kind: observe.Kind, value: usize) {
  if arena.events != nil {
    _ = observe.record(arena.events, observe.Event{kind: kind, resource: arena.event_resource,
      value: #cast(u64, value), source: "std/mem"})
  }
}
fn arena_failure(arena: *Arena, error: ErrorKind) Allocation {
  if arena.allocation_failures < #cast(usize, -1) {
    arena.allocation_failures += 1
  }
  arena_event(arena, observe.Kind.AllocationFailed, arena_mark(arena))
  return Allocation{error: error}
}

// Zero only payload bytes: align with scalar stores, then use bounded machine words.
fn zero_bytes_fast(items: []u8) {
  i: usize = 0
  for i < #len(items) && (#cast(usize, &items[i]) & (#sizeof(usize) - 1)) != 0 {
    items[i] = 0
    i += 1
  }
  for #len(items) - i >= #sizeof(usize) {
    (#cast(*usize, &items[i])).* = 0
    i += #sizeof(usize)
  }
  for i < #len(items) {
    items[i] = 0
    i += 1
  }
}

// Adds a block large enough for size bytes at alignment.
fn arena_grow(arena: *Arena, size: usize, alignment: usize) Growth {
  if arena.fixed_buffer || arena.block_size == 0 {
    return Growth{error: ErrorKind.Capacity}
  }
  maximum := ~#cast(usize, 0)
  // Worst-case alignment padding is alignment - 1, not alignment.
  if alignment - 1 > maximum - header_size() {
    return Growth{error: ErrorKind.Overflow}
  }
  overhead := header_size() + alignment - 1
  if size > maximum - overhead {
    return Growth{error: ErrorKind.Overflow}
  }
  wanted := arena.block_size
  if wanted < size + overhead {
    wanted = size + overhead
  }
  if arena.limit != 0 {
    if arena.backing > arena.limit {
      return Growth{error: ErrorKind.Capacity}
    }
    remaining := arena.limit - arena.backing
    if wanted > remaining {
      wanted = remaining
    }
    // The actual mapping may need less padding than the worst-case plan.
    if wanted < size + header_size() {
      return Growth{error: ErrorKind.Capacity}
    }
  }
  if wanted > maximum - arena.backing {
    return Growth{error: ErrorKind.Overflow}
  }
  mapping := mapping_with_header(wanted)
  if !mapping.ok {
    return Growth{error: ErrorKind.System, code: mapping.error}
  }
  payload := #cast(usize, &mapping.bytes[header_size()])
  remainder := payload & (alignment - 1)
  padding: usize = 0
  if remainder != 0 {
    padding = alignment - remainder
  }
  if padding > wanted - header_size() || size > wanted - header_size() - padding {
    _ = mapping_release(mapping.bytes)
    return Growth{error: ErrorKind.Capacity}
  }
  block := block_init(mapping.bytes, arena_mark(arena) - header_size(), true, mapping.committed)
  block.previous = arena.current
  arena.current = block
  arena.backing += wanted
  return Growth{error: ErrorKind.None}
}

fn arena_try_push_impl(arena: *Arena, size: usize, alignment: usize, zero_memory: bool) Allocation {
  if !valid_alignment(alignment) {
    return arena_failure(arena, ErrorKind.InvalidAlignment)
  }
  if size == 0 {
    return Allocation{ memory: nil, size: 0, ok: true }
  }
  grew := false
  for {
    block := arena.current
    available := block.data[block.offset..]
    if #len(available) != 0 {
      address := #cast(usize, &available[0])
      remainder := address & (alignment - 1)
      padding: usize = 0
      if remainder != 0 {
        padding = alignment - remainder
      }
      if padding <= #len(available) && size <= #len(available) - padding {
        end := block.offset + padding + size
        if block.owns_memory && end > block.committed {
          arena_commit(block, end)
        }
        memory := &available[padding]
        block.offset = end
        used := block.base + end - header_size()
        if used > arena.peak_used {
          arena.peak_used = used
        }
        arena_event(arena, observe.Kind.Allocated, size)
        if zero_memory {
          zero_bytes_fast(memory[..size])
        }
        return Allocation{ memory: memory, size: size, ok: true }
      }
    }
    // Retry once after growth, preserving the failure result if it still lacks room.
    if grew {
      return Allocation{error: ErrorKind.Capacity}
    }
    grown := arena_grow(arena, size, alignment)
    if grown.error != ErrorKind.None {
      failed := arena_failure(arena, grown.error)
      failed.code = grown.code
      return failed
    }
    grew = true
  }
  #panic("unreachable arena push exit")
}

// Grows the newest allocation in place: when the size bytes at memory end at
// the arena's current position, adds extra zeroed bytes after them and returns
// true. Returns false, changing nothing, when memory is not the newest
// allocation or its block lacks room. Costs no copy.
pub fn arena_try_extend(arena: *Arena, memory: *u8, size: usize, extra: usize) bool {
  block := arena.current
  if memory == nil {
    return false
  }
  base := #cast(usize, &block.data[0])
  start := #cast(usize, memory)
  if start < base || start - base > block.offset || block.offset - (start - base) != size {
    return false
  }
  if extra > #len(block.data) - block.offset {
    return false
  }
  end := block.offset + extra
  if block.owns_memory && end > block.committed {
    arena_commit(block, end)
  }
  zero_bytes_fast(block.data[block.offset..end])
  block.offset = end
  used := block.base + end - header_size()
  if used > arena.peak_used {
    arena.peak_used = used
  }
  arena_event(arena, observe.Kind.Allocated, extra)
  return true
}

// Ownership: result borrows arena backing; zero size returns nil.
// Invalidation: applicable rewind, reset, or release.
// Allocation: zeroes the payload bytes; an owning arena adds a block when full.
// Failure: panics when a buffer or bounded arena is exhausted or the alignment is invalid.
// Thread safety: caller synchronizes access to the arena.
pub fn arena_push(arena: *Arena, size: usize, alignment: usize) *u8 {
  return arena_must(arena_try_push_impl(arena, size, alignment, true))
}

// Ownership: result borrows arena backing; cast memory to the requested element type.
// Invalidation: applicable rewind, reset, or release.
// Allocation: checked count * element_size, aligned and zeroed; no heap fallback.
// Failure: panics like arena_push, and when the size overflows.
// Thread safety: caller synchronizes access to the arena.
pub fn arena_push_array(arena: *Arena, count: usize, element_size: usize, alignment: usize) *u8 {
  size := size_for(count, element_size)
  if !size.ok {
    #panic("arena size overflow")
  }
  return arena_push(arena, size.bytes, alignment)
}

// Like arena_push, without zeroing, for bytes that are overwritten right away.
pub fn arena_push_uninit(arena: *Arena, size: usize, alignment: usize) *u8 {
  return arena_must(arena_try_push_impl(arena, size, alignment, false))
}

// The one fallible push, for code with a strict budget.
// Failure leaves the position and existing bytes unchanged.
pub fn arena_try_push(arena: *Arena, size: usize, alignment: usize) Allocation {
  return arena_try_push_impl(arena, size, alignment, true)
}

// Pushes one zeroed T. Panics when the arena is exhausted.
pub fn push($T: type, arena: *Arena) *T {
  return #cast(*T, arena_push(arena, #sizeof(T), #alignof(T)))
}

// Pushes count zeroed elements. Panics when the arena is exhausted or the size overflows.
pub fn push_array($T: type, arena: *Arena, count: usize) []T {
  if count == 0 {
    empty: []T
    return empty
  }
  size := size_for(count, #sizeof(T))
  if !size.ok {
    #panic("arena size overflow")
  }
  return (#cast(*T, arena_push(arena, size.bytes, #alignof(T))))[..count]
}

// Pushes one zeroed T, or returns nil when the arena is exhausted. Never panics
// on exhaustion; on failure the offset and existing bytes are unchanged.
pub fn try_push($T: type, arena: *Arena) *T {
  allocation := arena_try_push(arena, #sizeof(T), #alignof(T))
  if !allocation.ok {
    return nil
  }
  return #cast(*T, allocation.memory)
}

// Pushes count zeroed elements, or returns an empty slice when the arena is
// exhausted or the size overflows. A nonzero count with an empty result is failure.
pub fn try_push_array($T: type, arena: *Arena, count: usize) []T {
  empty: []T
  size := size_for(count, #sizeof(T))
  if count == 0 || !size.ok {
    return empty
  }
  allocation := arena_try_push(arena, size.bytes, #alignof(T))
  if !allocation.ok {
    return empty
  }
  return (#cast(*T, allocation.memory))[..count]
}

// Appends value to items, a slice that owns the rest of arena: its elements
// must be the newest allocation on arena, so give each growing list its own
// arena. The new element goes directly after the last one, so nothing is copied
// and element addresses stay put until the list outgrows its block; then the
// list moves to a new block once. The default block reserves 64 GiB of address
// space on 64-bit hosts, so one arena per list is cheap. Returns the new element.
// Panics when something else was pushed onto arena after items, or when a
// buffer or bounded arena is exhausted.
pub fn append(arena: *Arena, items: *[]$T, value: T) *T {
  count := #len(items.*)
  if count == 0 {
    items.* = push_array(T, arena, 1)
  } else if !arena_try_extend(arena, #cast(*u8, &items.*[0]), count * #sizeof(T), #sizeof(T)) {
    append_check_newest(arena, #cast(*u8, &items.*[0]), count * #sizeof(T))
    moved := push_array(T, arena, count + 1)
    _ = copy(moved, items.*)
    items.* = moved
  } else {
    items.* = (&items.*[0])[..count + 1]
  }
  slot := &items.*[count]
  slot.* = value
  return slot
}

// Appends every element of values to items, under the same rules as append.
pub fn append_many(arena: *Arena, items: *[]$T, values: []const T) {
  count := #len(items.*)
  extra := #len(values)
  if extra == 0 {
    return
  }
  if count == 0 {
    items.* = push_array(T, arena, extra)
  } else if !arena_try_extend(arena, #cast(*u8, &items.*[0]), count * #sizeof(T), extra * #sizeof(T)) {
    append_check_newest(arena, #cast(*u8, &items.*[0]), count * #sizeof(T))
    moved := push_array(T, arena, count + extra)
    _ = copy(moved, items.*)
    items.* = moved
  } else {
    items.* = (&items.*[0])[..count + extra]
  }
  for i in 0..extra {
    items.*[count + i] = values[i]
  }
}

fn append_check_newest(arena: *Arena, memory: *u8, size: usize) {
  block := arena.current
  base := #cast(usize, &block.data[0])
  start := #cast(usize, memory)
  if start < base || start - base + size != block.offset {
    #panic("append: items are not the newest allocation on this arena; give the list its own arena")
  }
}

// For producers that cannot know their output size in advance: they push a
// trial block, write into it, and on overflow rewind and try a bigger one.
// trial_size gives the first block size, capped at what a fixed-buffer arena
// has left. trial_next gives the next size, or panics when a fixed-buffer
// arena cannot give more.
pub fn trial_size(arena: *const Arena, wanted: usize) usize {
  if arena.fixed_buffer && wanted > arena_remaining(arena) {
    return arena_remaining(arena)
  }
  return wanted
}

pub fn trial_next(arena: *const Arena, current: usize) usize {
  if arena.fixed_buffer {
    if current >= arena_remaining(arena) {
      #panic("arena exhausted")
    }
    return trial_size(arena, current * 2 + 1)
  }
  if current > ~#cast(usize, 0) / 4 {
    #panic("output size overflows")
  }
  return current * 2 + 1
}

// Pushes count uninitialized bytes, for buffers that are overwritten right away.
// Panics when the arena is exhausted.
pub fn push_bytes_uninit(arena: *Arena, count: usize) []u8 {
  if count == 0 {
    empty: []u8
    return empty
  }
  return arena_push_uninit(arena, count, 1)[..count]
}

fn arena_must(allocation: Allocation) *u8 {
  if !allocation.ok {
    #panic("arena exhausted or alignment invalid")
  }
  return allocation.memory
}

// A fixed arena placed in capacity bytes pushed from parent, header included.
// Rewind/reset of parent invalidates the child and everything pushed into it.
// Panics when the parent is exhausted or capacity cannot hold the header.
pub fn arena_sub(parent: *Arena, capacity: usize) *Arena {
  return arena_from_buffer((#cast(*u8, arena_push_uninit(parent, capacity, 16)))[..capacity])
}

pub struct Scratch {
  arena: *Arena,
  mark: usize,
  active: bool,
}

// Chooses first unless its backing overlaps a live caller arena. Scratch does not
// own either arena and must end before either arena is reset or released.
fn arena_conflicts(candidate: *const Arena, conflict: *const Arena) bool {
  if candidate == nil {
    return true
  }
  if conflict == nil {
    return false
  }
  if candidate == conflict {
    return true
  }
  // Any overlap between a block of one and a block of the other, which also
  // catches a child placed inside the other arena.
  left := candidate.current
  for left != nil {
    right := conflict.current
    for right != nil {
      if blocks_overlap(left, right) {
        return true
      }
      right = right.previous
    }
    left = left.previous
  }
  return false
}
fn blocks_overlap(left: *const Arena, right: *const Arena) bool {
  if #len(left.data) == 0 || #len(right.data) == 0 {
    return false
  }
  a := #cast(usize, &left.data[0])
  b := #cast(usize, &right.data[0])
  if a <= b {
    return b - a < #len(left.data)
  }
  return a - b < #len(right.data)
}
// Ownership: borrows a non-conflicting arena and records its current mark.
// Invalidation: scratch_end expires allocations made after that mark.
// Allocation: none; no implicit thread-local arena or heap fallback.
// Failure: panics if neither candidate has non-conflicting backing.
// Thread safety: candidates must be exclusively accessible for the scratch scope.
pub fn scratch_begin(first: *Arena, second: *Arena, conflict: *const Arena) Scratch {
  selected := first
  if arena_conflicts(selected, conflict) {
    selected = second
  }
  if arena_conflicts(selected, conflict) {
    #panic("scratch requires a non-conflicting arena")
  }
  return Scratch{ arena: selected, mark: arena_mark(selected), active: true }
}

pub fn scratch_end(scratch: *Scratch) {
  if !scratch.active {
    #panic("scratch scope already ended")
  }
  arena_rewind(scratch.arena, scratch.mark)
  scratch.active = false
}

// Two arenas swapped by frame_advance. Data pushed during frame N stays
// readable during frame N + 1 through frame_previous, then is reset.
pub struct Frames {
  arenas: [2]*Arena,
  index: usize,
}

// Ownership: returns two owning arenas reserving capacity bytes each.
// Panics like arena_create.
pub fn frames_create(capacity: usize) Frames {
  return Frames{ arenas: [arena_create(capacity), arena_create(capacity)] }
}

pub fn frame_current(frames: *Frames) *Arena {
  return frames.arenas[frames.index]
}

pub fn frame_previous(frames: *Frames) *Arena {
  return frames.arenas[frames.index ^ 1]
}

// Invalidation: resets the arena that held the frame before the previous one.
pub fn frame_advance(frames: *Frames) {
  frames.index ^= 1
  arena_reset(frames.arenas[frames.index])
}

pub fn frames_release(frames: *Frames) {
  for i in 0..2 {
    arena_release(frames.arenas[i])
  }
}

// Copies source into the start of destination and returns the element count.
// Panics if destination is shorter than source. Use move for overlapping ranges.
pub fn copy(destination: []$T, source: []const T) usize {
  if #len(destination) < #len(source) {
    #panic("copy destination too small")
  }
  for i in 0..#len(source) {
    destination[i] = source[i]
  }
  return #len(source)
}

// Like copy, but source and destination may overlap.
pub fn move(destination: []$T, source: []const T) usize {
  if #len(destination) < #len(source) {
    #panic("move destination too small")
  }
  if #len(source) == 0 {
    return 0
  }
  destination_address := #cast(usize, &destination[0])
  source_address := #cast(usize, &source[0])
  i: usize = 0
  if destination_address > source_address && destination_address < source_address + #len(source) * #sizeof(T) {
    i = #len(source)
    for i > 0 {
      i -= 1
      destination[i] = source[i]
    }
  } else {
    for i < #len(source) {
      destination[i] = source[i]
      i += 1
    }
  }
  return #len(source)
}

// Sets every element to its zero value.
pub fn zero(items: []$T) {
  empty: T
  for *item in items {
    item.* = empty
  }
}

// Zeroes the value behind a pointer byte by byte, without a temporary copy,
// so it is safe for structs too large for the stack.
pub fn clear(value: *$T) {
  zero((#cast(*u8, value))[..#sizeof(T)])
}

pub fn fill(items: []$T, value: T) {
  for *item in items {
    item.* = value
  }
}

pub fn swap(a, b: *$T) {
  t := a.*
  a.* = b.*
  b.* = t
}

// Elementwise ==. Elements must support ==.
pub fn equal(left, right: []const $T) bool {
  if #len(left) != #len(right) {
    return false
  }
  for i in 0..#len(left) {
    if left[i] != right[i] {
      return false
    }
  }
  return true
}

pub fn compare(left: []const u8, right: []const u8) i32 {
  count := #len(left)
  if #len(right) < count {
    count = #len(right)
  }
  for i in 0..count {
    if left[i] < right[i] {
      return -1
    }
    if left[i] > right[i] {
      return 1
    }
  }
  if #len(left) < #len(right) {
    return -1
  }
  if #len(left) > #len(right) {
    return 1
  }
  return 0
}
