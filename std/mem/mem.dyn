use "std/observe" observe

// Arenas and fixed-slot reuse primitives.
//
// Arena owns heap backing or borrows a caller slice. Reset or rewind invalidates affected allocations.
// FreeList borrows one fixed region, commonly carved from an arena. Returning a slot
// recycles it inside the list; it does not return memory to the arena.

pub enum ErrorKind { None, InvalidAlignment, Capacity, InvalidState, Overflow, System }

pub struct Allocation {
  error: ErrorKind,
  code: isize,
  memory: *u8,
  size: usize,
  ok: bool,
}

pub struct Arena {
  data: []u8,
  offset: usize,
  // Set only by arena_create; caller buffers are never freed.
  owns_memory: bool,
  // Bytes of owned backing the OS has committed. Only Windows commits on demand;
  // other targets commit the whole reservation at creation.
  committed: usize,
  // Opt-in diagnostic scribble; does not make expired raw pointers safe.
  poison_on_rewind: bool,
  peak_used: usize,
  allocation_failures: usize,
  // Optional borrowed event sink. Keep it outside this arena and alive until release.
  events: *observe.Log,
  event_resource: u64,
}

pub fn arena_from_buffer(backing: []u8) Arena {
  return Arena{ data: backing, offset: 0 }
}

// Reserves capacity bytes of address space for an owning arena. Pages cost
// memory only once pushes reach them, so reserve generously: a GiB or more is
// normal on 64-bit targets. wasm32 has no reservation and backs it right away.
// Panics when the OS refuses the reservation or capacity is zero; there is
// nothing useful to do when address space is gone.
pub fn arena_create(capacity: usize) Arena {
  if capacity == 0 {
    #panic("arena capacity must be nonzero")
  }
  mapping := mapping_allocate(capacity)
  if !mapping.ok {
    #panic("cannot reserve arena memory")
  }
  return Arena{ data: mapping.bytes, owns_memory: true, committed: mapping.committed }
}
struct Mapping { bytes: []u8, committed: usize, error: isize, ok: bool }
// Releases owned backing, or clears a borrowed arena without freeing its storage.
// Invalidation: all payload views. Releasing a cleared arena again does nothing.
pub fn arena_release(arena: *Arena) {
  if arena.owns_memory && #len(arena.data) != 0 {
    if mapping_release(arena.data) != 0 {
      #panic("cannot release arena memory")
    }
  }
  arena_event(arena, observe.Kind.Released, arena.offset)
  arena.* = Arena{}
}

const CommitStep: usize = 1048576

// Commits owned backing through end, in CommitStep pieces. Windows only in practice.
fn arena_commit(arena: *Arena, end: usize) {
  target := align_size(end, CommitStep)
  if target > #len(arena.data) || target < end {
    target = #len(arena.data)
  }
  if !mapping_commit(arena.data, arena.committed, target) {
    #panic("cannot commit arena memory")
  }
  arena.committed = target
}

pub fn arena_capacity(arena: *const Arena) usize {
  return #len(arena.data)
}

// Ownership: transfers the descriptor and clears its old slot. No allocation.
// Existing payload pointers remain valid; pointers to the old Arena do not retarget.
// Do not transfer an arena whose descriptor address is retained by another object.
pub fn arena_take(arena: *Arena) Arena {
  result := arena.*
  arena.* = Arena{}
  return result
}
pub fn arena_used(arena: *const Arena) usize {
  return arena.offset
}
pub fn arena_remaining(arena: *const Arena) usize {
  return #len(arena.data) - arena.offset
}
pub fn arena_mark(arena: *const Arena) usize {
  return arena.offset
}

pub struct ArenaSnapshot {
  capacity: usize, used: usize, remaining: usize, owns_memory: bool, poison_on_rewind: bool,
  peak_used: usize, allocation_failures: usize,
}

// Allocation-free value snapshot. Contains no borrowed pointers and survives reset/release.
// Includes peak usage and allocation failures since initialization. No synchronization.
pub fn arena_snapshot(arena: *const Arena) ArenaSnapshot {
  if arena.offset > #len(arena.data) {
    #panic("invalid arena offset")
  }
  return ArenaSnapshot{ capacity: #len(arena.data), used: arena.offset,
    remaining: #len(arena.data) - arena.offset, owns_memory: arena.owns_memory,
    poison_on_rewind: arena.poison_on_rewind, peak_used: arena.peak_used,
    allocation_failures: arena.allocation_failures }
}


pub fn arena_reset(arena: *Arena) {
  arena_rewind(arena, 0)
}

pub fn arena_rewind(arena: *Arena, mark: usize) {
  if arena.offset > #len(arena.data) {
    #panic("invalid arena offset")
  }
  if mark > arena.offset {
    #panic("arena mark is ahead of current position")
  }
  if arena.poison_on_rewind {
    i := mark
    for i < arena.offset {
      arena.data[i] = 221
      i += 1
    }
  }
  arena_event(arena, observe.Kind.Reclaimed, arena.offset - mark)
  arena.offset = mark
}

fn valid_alignment(alignment: usize) bool {
  return alignment != 0 && (alignment & (alignment - 1)) == 0
}

fn arena_event(arena: *Arena, kind: observe.Kind, value: usize) {
  if arena.events != nil {
    _ = observe.record(arena.events, observe.Event{kind: kind, resource: arena.event_resource,
      value: #cast(u64) value, source: "std/mem"})
  }
}
fn arena_failure(arena: *Arena, error: ErrorKind) Allocation {
  if arena.allocation_failures < #cast(usize) -1 {
    arena.allocation_failures += 1
  }
  arena_event(arena, observe.Kind.AllocationFailed, arena.offset)
  return Allocation{error: error}
}

fn arena_try_push_impl(arena: *Arena, size: usize, alignment: usize, zero_memory: bool) Allocation {
  if !valid_alignment(alignment) {
    return arena_failure(arena, ErrorKind.InvalidAlignment)
  }
  if arena.offset > #len(arena.data) {
    return arena_failure(arena, ErrorKind.InvalidState)
  }
  if size == 0 {
    return Allocation{ memory: nil, size: 0, ok: true }
  }

  available := arena.data[arena.offset..]
  if #len(available) == 0 {
    return arena_failure(arena, ErrorKind.Capacity)
  }

  address := #cast(usize) &available[0]
  remainder := address & (alignment - 1)
  padding: usize = 0
  if remainder != 0 {
    padding = alignment - remainder
  }
  if padding > #len(available) {
    return arena_failure(arena, ErrorKind.Capacity)
  }
  if size > #len(available) - padding {
    return arena_failure(arena, ErrorKind.Capacity)
  }

  end := arena.offset + padding + size
  if arena.owns_memory && end > arena.committed {
    arena_commit(arena, end)
  }
  memory := &available[padding]
  arena.offset = end
  if arena.offset > arena.peak_used {
    arena.peak_used = arena.offset
  }
  arena_event(arena, observe.Kind.Allocated, size)
  if zero_memory {
    zero(memory[..size])
  }
  return Allocation{ memory: memory, size: size, ok: true }
}

// Ownership: result borrows arena backing; zero-size success has nil memory.
// Invalidation: applicable rewind, reset, or release.
// Allocation: consumes fixed arena capacity and zeroes successful payload bytes.
// Failure: offset and payload bytes are unchanged; diagnostic counters may change.
// Thread safety: caller synchronizes access to the arena.
pub fn arena_push(arena: *Arena, size: usize, alignment: usize) Allocation {
  return arena_try_push_impl(arena, size, alignment, true)
}

// Ownership: result borrows arena backing; cast memory to the requested element type.
// Invalidation: applicable rewind, reset, or release.
// Allocation: checked count * element_size, aligned and zeroed; no heap fallback.
// Failure: overflow/capacity/alignment failure preserves offset and existing bytes.
// Thread safety: caller synchronizes access to the arena.
pub fn arena_push_array(arena: *Arena, count: usize, element_size: usize, alignment: usize) Allocation {
  size := size_for(count, element_size)
  if !size.ok { return arena_failure(arena, ErrorKind.Overflow) }
  return arena_push(arena, size.bytes, alignment)
}

// Pushes one zeroed T. Panics when the arena is exhausted.
pub fn push($T: type, arena: *Arena) *T {
  return #cast(*T) arena_push_or_panic(arena, #sizeof(T), #alignof(T))
}

// Pushes count zeroed elements. Panics when the arena is exhausted or the size overflows.
pub fn push_array($T: type, arena: *Arena, count: usize) []T {
  if count == 0 {
    empty: []T
    return empty
  }
  allocation := arena_push_array(arena, count, #sizeof(T), #alignof(T))
  if !allocation.ok {
    #panic("arena exhausted or size overflow")
  }
  return (#cast(*T) allocation.memory)[..count]
}

// Pushes count uninitialized bytes, for buffers that are overwritten right away.
// Panics when the arena is exhausted.
pub fn push_bytes_uninit(arena: *Arena, count: usize) []u8 {
  if count == 0 {
    return arena.data[..0]
  }
  return arena_push_uninit_or_panic(arena, count, 1)[..count]
}

pub fn arena_push_uninit(arena: *Arena, size: usize, alignment: usize) Allocation {
  return arena_try_push_impl(arena, size, alignment, false)
}

pub fn arena_push_or_panic(arena: *Arena, size: usize, alignment: usize) *u8 {
  allocation := arena_push(arena, size, alignment)
  if !allocation.ok {
    #panic("arena exhausted or alignment invalid")
  }
  return allocation.memory
}

pub fn arena_push_uninit_or_panic(arena: *Arena, size: usize, alignment: usize) *u8 {
  allocation := arena_push_uninit(arena, size, alignment)
  if !allocation.ok {
    #panic("arena exhausted or alignment invalid")
  }
  return allocation.memory
}

// Returned arena borrows storage consumed from parent. Rewind/reset of parent
// invalidates child and all allocations made through it. Panics when the parent
// is exhausted.
pub fn arena_sub(parent: *Arena, capacity: usize) Arena {
  if capacity == 0 {
    return arena_from_buffer(parent.data[..0])
  }
  return arena_from_buffer(push_bytes_uninit(parent, capacity))
}

pub struct Scratch {
  arena: *Arena,
  mark: usize,
  active: bool,
}

// Chooses first unless its backing overlaps a live caller arena. Scratch does not
// own either arena and must end before either arena is reset or released.
fn arena_conflicts(candidate: *const Arena, conflict: *const Arena) bool {
  if candidate == nil {
    return true
  }
  if conflict == nil {
    return false
  }
  if candidate == conflict {
    return true
  }
  if #len(candidate.data) == 0 || #len(conflict.data) == 0 {
    return false
  }
  left := #cast(usize) &candidate.data[0]
  right := #cast(usize) &conflict.data[0]
  if left <= right {
    return right - left < #len(candidate.data)
  }
  return left - right < #len(conflict.data)
}
// Ownership: borrows a non-conflicting arena and records its current mark.
// Invalidation: scratch_end expires allocations made after that mark.
// Allocation: none; no implicit thread-local arena or heap fallback.
// Failure: panics if neither candidate has non-conflicting backing.
// Thread safety: candidates must be exclusively accessible for the scratch scope.
pub fn scratch_begin(first: *Arena, second: *Arena, conflict: *const Arena) Scratch {
  selected := first
  if arena_conflicts(selected, conflict) {
    selected = second
  }
  if arena_conflicts(selected, conflict) {
    #panic("scratch requires a non-conflicting arena")
  }
  return Scratch{ arena: selected, mark: arena_mark(selected), active: true }
}

pub fn scratch_end(scratch: *Scratch) {
  if !scratch.active {
    #panic("scratch scope already ended")
  }
  arena_rewind(scratch.arena, scratch.mark)
  scratch.active = false
}

// Two arenas swapped by frame_advance. Data pushed during frame N stays
// readable during frame N + 1 through frame_previous, then is reset.
pub struct Frames {
  arenas: [2]Arena,
  index: usize,
}

// Ownership: returns two owning arenas reserving capacity bytes each.
// Panics like arena_create.
pub fn frames_create(capacity: usize) Frames {
  return Frames{ arenas: [arena_create(capacity), arena_create(capacity)] }
}

pub fn frame_current(frames: *Frames) *Arena {
  return &frames.arenas[frames.index]
}

pub fn frame_previous(frames: *Frames) *Arena {
  return &frames.arenas[frames.index ^ 1]
}

// Invalidation: resets the arena that held the frame before the previous one.
pub fn frame_advance(frames: *Frames) {
  frames.index ^= 1
  arena_reset(&frames.arenas[frames.index])
}

pub fn frames_release(frames: *Frames) {
  for i in 0..2 {
    arena_release(&frames.arenas[i])
  }
}

struct FreeListNode { next: *FreeListNode }

pub struct FreeList {
  backing: []u8,
  slot_size: usize,
  slot_count: usize,
  free_count: usize,
  free_head: *FreeListNode,
  // One bit per slot, set while allocated; empty when metadata is unavailable.
  occupied: []u8,
}

fn align_size(size: usize, alignment: usize) usize {
  remainder := size & (alignment - 1)
  if remainder == 0 {
    return size
  }
  padding := alignment - remainder
  maximum := ~#cast(usize) 0
  if size > maximum - padding {
    return 0
  }
  return size + padding
}

fn free_list_alignment(requested: usize) usize {
  if !valid_alignment(requested) {
    #panic("free-list alignment must be non-zero power of two")
  }
  if requested < #alignof(FreeListNode) {
    return #alignof(FreeListNode)
  }
  return requested
}

// Slots include an internal pointer link. Effective alignment is at least pointer
// alignment, even for byte-sized objects. Backing must satisfy that alignment;
// slot stride is rounded up. Storage is borrowed and must outlive the free list.
// All complete slots remain usable; without separate metadata, release scans
// the free chain to detect double frees.
pub fn free_list_init(backing: []u8, requested_slot_size: usize, alignment: usize) FreeList {
  effective_alignment := free_list_alignment(alignment)
  slot_size := requested_slot_size
  if slot_size < #sizeof(FreeListNode) {
    slot_size = #sizeof(FreeListNode)
  }
  slot_size = align_size(slot_size, effective_alignment)
  if slot_size == 0 || #len(backing) < slot_size {
    #panic("free list requires at least one slot")
  }
  if #len(backing) > 0 && (#cast(usize) &backing[0] & (effective_alignment - 1)) != 0 {
    #panic("free-list backing has wrong alignment")
  }

  count := #len(backing) / slot_size
  for i in 0..count {
    node := #cast(*FreeListNode) &backing[i * slot_size]
    if i + 1 < count {
      node.next = #cast(*FreeListNode) &backing[(i + 1) * slot_size]
    }
    else {
      node.next = nil
    }
  }
  return FreeList{
    backing: backing,
    slot_size: slot_size,
    slot_count: count,
    free_count: count,
    free_head: #cast(*FreeListNode) &backing[0],
  }
}

// Reserves slot storage, plus ceil(slot_count / 8) zeroed metadata bytes when
// the arena has room. The optional bitmap makes allocation and release constant
// time; otherwise release scans the free chain. Exact slot capacity still works.
// Ownership: slots and optional bitmap borrow the arena; descriptor is a single owner.
// Invalidation: backing rewind/reset/release; individual free permits slot reuse.
// Panics on invalid alignment, zero slots, size overflow or an exhausted arena.
// Thread safety: caller synchronized.
pub fn free_list_from_arena(arena: *Arena, slot_count: usize, slot_size: usize, alignment: usize) FreeList {
  if !valid_alignment(alignment) { #panic("free-list alignment must be a power of two") }
  if slot_count == 0 { #panic("free list needs at least one slot") }
  effective_alignment := free_list_alignment(alignment)
  actual := slot_size
  if actual < #sizeof(FreeListNode) { actual = #sizeof(FreeListNode) }
  actual = align_size(actual, effective_alignment)
  maximum := ~#cast(usize) 0
  if actual == 0 || slot_count > maximum / actual {
    #panic("free-list size overflow")
  }
  size := slot_count * actual
  memory := arena_push_uninit_or_panic(arena, size, effective_alignment)
  list := free_list_init(memory[..size], actual, effective_alignment)
  bitmap_size := slot_count / 8
  if slot_count % 8 != 0 { bitmap_size += 1 }
  if arena_remaining(arena) >= bitmap_size {
    bitmap := arena_push_or_panic(arena, bitmap_size, 1)
    list.occupied = bitmap[..bitmap_size]
  }
  return list
}

pub fn free_list_alloc(list: *FreeList) rawptr {
  if list.free_head == nil {
    return nil
  }
  node := list.free_head
  list.free_head = node.next
  list.free_count -= 1
  if #len(list.occupied) != 0 {
    slot := (#cast(usize) node - #cast(usize) &list.backing[0]) / list.slot_size
    mask: u8 = 1
    mask = mask << (slot % 8)
    list.occupied[slot / 8] |= mask
  }
  return node
}

pub fn free_list_alloc_or_panic(list: *FreeList) rawptr {
  memory := free_list_alloc(list)
  if memory == nil {
    #panic("free list exhausted")
  }
  return memory
}

pub fn free_list_free(list: *FreeList, memory: rawptr) {
  if memory == nil {
    return
  }
  address := #cast(usize) memory
  start := #cast(usize) &list.backing[0]
  end := start + list.slot_count * list.slot_size
  if address < start || address >= end || (address - start) % list.slot_size != 0 {
    #panic("pointer does not belong to free list")
  }
  node := #cast(*FreeListNode) memory
  if #len(list.occupied) != 0 {
    slot := (address - start) / list.slot_size
    mask: u8 = 1
    mask = mask << (slot % 8)
    if (list.occupied[slot / 8] & mask) == 0 {
      #panic("free-list double free")
    }
    list.occupied[slot / 8] &= ~mask
  }
  else {
    existing := list.free_head
    for existing != nil {
      if existing == node {
        #panic("free-list double free")
      }
      existing = existing.next
    }
  }
  node.next = list.free_head
  list.free_head = node
  list.free_count += 1
  if list.free_count > list.slot_count {
    #panic("free-list double free")
  }
}

// Arena-backed fixed-size object storage. Pool is the ordinary reuse interface;
// FreeList remains available when callers need its lower-level accounting.
pub struct Pool { list: FreeList }

// Ownership: pool borrows arena backing; do not independently mutate descriptor copies.
// Invalidation: release reuses a slot; arena rewind/reset/release invalidates the pool.
// Allocation: fixed arena slots with optional occupancy bitmap.
// Panics like free_list_from_arena.
// Thread safety: caller synchronized.
pub fn pool_init(arena: *Arena, slot_count: usize, slot_size: usize, alignment: usize) Pool {
  return Pool{ list: free_list_from_arena(arena, slot_count, slot_size, alignment) }
}

pub fn pool_capacity(pool: *const Pool) usize {
  return pool.list.slot_count
}
pub fn pool_available(pool: *const Pool) usize {
  return pool.list.free_count
}
// Returns nil when exhausted. Reused slot bytes are uninitialized.
// Retained pointers must not be used after pool_release; use generation handles
// (std/container/slot_map) when references can outlive individual deletion.
pub fn pool_acquire(pool: *Pool) rawptr {
  return free_list_alloc(&pool.list)
}
pub fn pool_acquire_or_panic(pool: *Pool) rawptr {
  return free_list_alloc_or_panic(&pool.list)
}
pub fn pool_release(pool: *Pool, memory: rawptr) {
  free_list_free(&pool.list, memory)
}

// Copies source into the start of destination and returns the element count.
// Panics if destination is shorter than source. Use move for overlapping ranges.
pub fn copy(destination: []$T, source: []const T) usize {
  if #len(destination) < #len(source) {
    #panic("copy destination too small")
  }
  for i in 0..#len(source) {
    destination[i] = source[i]
  }
  return #len(source)
}

// Like copy, but source and destination may overlap.
pub fn move(destination: []$T, source: []const T) usize {
  if #len(destination) < #len(source) {
    #panic("move destination too small")
  }
  if #len(source) == 0 {
    return 0
  }
  destination_address := #cast(usize) &destination[0]
  source_address := #cast(usize) &source[0]
  i: usize = 0
  if destination_address > source_address && destination_address < source_address + #len(source) * #sizeof(T) {
    i = #len(source)
    for i > 0 {
      i -= 1
      destination[i] = source[i]
    }
  } else {
    for i < #len(source) {
      destination[i] = source[i]
      i += 1
    }
  }
  return #len(source)
}

// Sets every element to its zero value.
pub fn zero(items: []$T) {
  empty: T
  for *item in items {
    item.* = empty
  }
}

// Zeroes the value behind a pointer byte by byte, without a temporary copy,
// so it is safe for structs too large for the stack.
pub fn clear(value: *$T) {
  zero((#cast(*u8) value)[..#sizeof(T)])
}

pub fn fill(items: []$T, value: T) {
  for *item in items {
    item.* = value
  }
}

pub fn swap(a, b: *$T) {
  t := a.*
  a.* = b.*
  b.* = t
}

// Elementwise ==. Elements must support ==.
pub fn equal(left, right: []const $T) bool {
  if #len(left) != #len(right) {
    return false
  }
  for i in 0..#len(left) {
    if left[i] != right[i] {
      return false
    }
  }
  return true
}

pub fn compare(left: []const u8, right: []const u8) i32 {
  count := #len(left)
  if #len(right) < count {
    count = #len(right)
  }
  for i in 0..count {
    if left[i] < right[i] {
      return -1
    }
    if left[i] > right[i] {
      return 1
    }
  }
  if #len(left) < #len(right) {
    return -1
  }
  if #len(left) > #len(right) {
    return 1
  }
  return 0
}

struct Block { next: *Block, arena: Arena, start: usize }
// Blocks never move. Reset retains them for reuse; release invalidates all borrows.
// Thread confined and not independently copyable by convention, like Arena.
pub struct GrowingArena {
  first: *Block, current: *Block, block_size: usize,
  capacity_limit: usize = #cast(usize) -1,
  // Maintained by growth/trim/release so enforcing the cap does not scan all blocks.
  backing_bytes: usize,
}
// Explicitly opts into growth. block_size is a preferred payload size, not a cap.
// Allocation: none until the first push. Ownership: caller owns the returned arena.
pub fn growing_create(block_size: usize) GrowingArena {
  return GrowingArena{ block_size: block_size }
}

// Explicit growth with a cap on total requested backing bytes, including block
// headers and alignment allowance. This is not an RSS or OS page commitment cap.
// A block must fit in full; zero limit permits only zero-size allocations.
pub fn growing_create_bounded(block_size: usize, capacity_limit: usize) GrowingArena {
  return GrowingArena{ block_size: block_size, capacity_limit: capacity_limit }
}

pub struct GrowingSnapshot { backing_bytes: usize, used: usize, blocks: usize }

// Ownership: pointer-free value, safe to retain after backing expires.
// Allocation: none; scans the retained block chain.
// Thread safety: caller synchronized.
// used includes payload alignment padding, but excludes each block's header.
pub fn growing_snapshot(arena: *const GrowingArena) GrowingSnapshot {
  snapshot := GrowingSnapshot{}
  block := arena.first
  for block != nil {
    snapshot.backing_bytes += arena_capacity(&block.arena)
    snapshot.used += arena_used(&block.arena) - block.start
    snapshot.blocks += 1
    block = block.next
  }
  return snapshot
}

// Ownership: result borrows arena storage.
// Invalidation: reset/release, not growth.
// Failure: existing allocations and chain remain intact. Zero size returns nil.
fn growing_push_impl(arena: *GrowingArena, size: usize, alignment: usize, zero_memory: bool) Allocation {
  if !valid_alignment(alignment) {
    return Allocation{ error: ErrorKind.InvalidAlignment }
  }
  if size == 0 {
    return Allocation{ ok: true }
  }
  block := arena.current
  last: *Block = nil
  for block != nil {
    reused := arena_try_push_impl(&block.arena, size, alignment, zero_memory)
    if reused.ok {
      arena.current = block
      return reused
    }
    last = block
    block = block.next
  }
  capacity := arena.block_size
  if capacity < size {
    capacity = size
  }
  maximum := #cast(usize) -1
  overhead := #sizeof(Block) + #alignof(Block) - 1
  if capacity > maximum - overhead {
    return Allocation{ error: ErrorKind.Overflow }
  }
  capacity += overhead
  if alignment - 1 > maximum - capacity {
    return Allocation{ error: ErrorKind.Overflow }
  }
  capacity += alignment - 1
  retained := arena.backing_bytes
  if retained > arena.capacity_limit || capacity > arena.capacity_limit - retained {
    return Allocation{ error: ErrorKind.Capacity }
  }
  created := arena_create(capacity)
  header := arena_push_or_panic(&created, #sizeof(Block), #alignof(Block))
  block = #cast(*Block) header
  block.arena = created
  block.start = arena_mark(&block.arena)
  // Capacity above includes worst-case header and payload alignment padding.
  // Publish ownership before the push so even a broken invariant cannot orphan it.
  if last != nil {
    last.next = block
  }
  else {
    arena.first = block
  }
  arena.current = block
  arena.backing_bytes += capacity
  return arena_try_push_impl(&block.arena, size, alignment, zero_memory)
}

// Ownership: result borrows growing arena storage; growth preserves earlier pointers.
// Invalidation: reset or release, or trim after the allocation has been reset.
// Allocation: reuses retained blocks before acquiring another bounded block.
// Failure: existing allocations and chain remain intact; zero size succeeds with nil.
// Thread safety: caller synchronized.
pub fn growing_push(arena: *GrowingArena, size: usize, alignment: usize) Allocation {
  return growing_push_impl(arena, size, alignment, true)
}

// Same lifetime and failure contract as growing_push; bytes are not initialized.
pub fn growing_push_uninit(arena: *GrowingArena, size: usize, alignment: usize) Allocation {
  return growing_push_impl(arena, size, alignment, false)
}

pub fn growing_push_or_panic(arena: *GrowingArena, size: usize, alignment: usize) *u8 {
  result := growing_push(arena, size, alignment)
  if !result.ok {
    #panic("growing arena allocation failed")
  }
  return result.memory
}

// Invalidates all allocations. Retains every block for reuse; does not free backing.
pub fn growing_reset(arena: *GrowingArena) {
  block := arena.first
  for block != nil {
    arena_rewind(&block.arena, block.start)
    block = block.next
  }
  arena.current = arena.first
}

// Releases only empty blocks until backing_bytes <= keep_bytes, where possible.
// Does not reset live allocations. Call after growing_reset to trim an idle arena.
pub fn growing_trim(arena: *GrowingArena, keep_bytes: usize) {
  retained := arena.backing_bytes
  previous: *Block = nil
  block := arena.first
  for block != nil && retained > keep_bytes {
    next := block.next
    if arena_used(&block.arena) == block.start {
      capacity := arena_capacity(&block.arena)
      owner := block.arena
      arena_release(&owner)
      if previous == nil { arena.first = next }
      else { previous.next = next }
      if arena.current == block {
        arena.current = next
        if next == nil { arena.current = previous }
      }
      retained -= capacity
      arena.backing_bytes = retained
    }
    else { previous = block }
    block = next
  }
}

// Invalidates every block.
pub fn growing_release(arena: *GrowingArena) {
  for arena.first != nil {
    block := arena.first
    next := block.next
    capacity := arena_capacity(&block.arena)
    // The owner lives in this mapping. Release through a local copy so clearing
    // the handle after unmapping never writes into freed storage.
    owner := block.arena
    arena_release(&owner)
    arena.first = next
    arena.current = next
    arena.backing_bytes -= capacity
  }
}
