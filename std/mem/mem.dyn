// Arenas and typed pushes.
//
// An arena hands out memory by moving a cursor forward, and takes it back all
// at once: rewind to a mark, reset, or release. Its blocks come from a
// Source: OS pages (arena_alloc), a caller buffer (arena_from_buffer), or
// blocks carved from another arena (within). Pushes zero what they return,
// except push_bytes. Running out of memory panics, a fixed buffer included,
// like an index out of range: size arenas for their work.
//
// Reset or rewind invalidates affected allocations. Reuse of individual
// objects is intrusive: see std/container/list free lists.

// An arena is a chain of blocks. Each block starts with an Arena header, so a
// *Arena refers to its backing header. Do not copy the public header or use
// an owning handle after release. The first block's header is the handle: it
// records the newest block and the arena-wide settings. A position is a byte
// offset in the arena's position space, where each block begins where the
// previous one ended; marks are positions.
pub struct Arena {
  // First block only: the newest block, where pushes go.
  current: *Arena,
  // The block before this one; nil for the first block.
  previous: *Arena,
  // This block's bytes, header included.
  data: []u8,
  // Position of data[0].
  base: usize,
  // Bytes used in this block, header included.
  offset: usize,
  // Bytes of this block ready to use: what the OS has committed of a
  // mapping (only Windows commits on demand), or a whole caller buffer.
  committed: usize,
  // This block is an OS mapping that release returns.
  owns_memory: bool,
  // First block only. Never add blocks: set for arena_from_buffer.
  fixed_buffer: bool,
  // First block only: where new blocks come from.
  source: Source,
  // First block only: backing bytes across all blocks.
  backing: usize,
  // First block only. Opt-in diagnostic scribble; does not make expired pointers safe.
  poison_on_rewind: bool,
}

// Where an arena's blocks come from. With take nil, blocks are OS pages,
// committed as they are used. Otherwise take returns a 16-byte aligned block
// of at least size bytes (empty when it has none, and the arena panics) and
// give, when set, takes a block back on rewind or release.
pub struct Source {
  context: rawptr,
  take: fn(rawptr, usize) []u8,
  give: fn(rawptr, []u8),
  // Preferred size of each block; zero picks the default for the source.
  block_size: usize,
  // Cap on backing bytes across all blocks, headers included; zero means none.
  limit: usize,
}

struct Mapping { bytes: []u8, committed: usize, error: isize, ok: bool }

// Bytes the arena header takes at the start of each block, and of every
// arena_from_buffer buffer. See ArenaBufferOverhead for unaligned caller buffers.
pub const ArenaHeader: usize = 144
// Maximum bytes consumed by the header and aligning arbitrary caller storage.
// A buffer of payload + ArenaBufferOverhead bytes guarantees payload capacity.
pub const ArenaBufferOverhead: usize = ArenaHeader + 15

fn header_size() usize {
  if #sizeof(Arena) > ArenaHeader {
    #panic("ArenaHeader is smaller than Arena")
  }
  return ArenaHeader
}

// Reserve and commit enough bytes for the header before storing into it.
// Windows mappings initially reserve address space without writable pages.
fn mapping_with_header(size: usize) Mapping {
  mapping := mapping_allocate(size)
  if !mapping.ok { return mapping }
  if mapping.committed < header_size() {
    if !mapping_commit(mapping.bytes, 0, header_size()) {
      _ = mapping_release(mapping.bytes)
      return Mapping{error: -12}
    }
    mapping.committed = header_size()
  }
  return mapping
}

// Puts a block header at the start of bytes.
fn block_init(bytes: []u8, base: usize, owns_memory: bool, committed: usize) *Arena {
  block := #cast(*Arena, &bytes[0])
  block.* = Arena{ data: bytes, base: base, offset: header_size(), owns_memory: owns_memory, committed: committed }
  return block
}

// OS pages for an arena, at most limit bytes in all (zero: no cap). A pushed
// block that would pass the limit panics.
pub fn pages(limit: usize) Source {
  return Source{ limit: limit }
}

// Blocks carved from parent, at most limit bytes in all (zero: no cap). A
// rewind or reset of parent that takes back those bytes invalidates the
// arena and everything pushed into it.
pub fn within(parent: *Arena, limit: usize) Source {
  return Source{ context: parent, take: take_within, limit: limit, block_size: 64 * KiB }
}
fn take_within(context: rawptr, size: usize) []u8 {
  if size > #max(usize) - 15 {
    #panic("arena size overflow")
  }
  bytes := push_bytes(#cast(*Arena, context), size + 15)
  skip := align_size(#cast(usize, &bytes[0]), 16) - #cast(usize, &bytes[0])
  return bytes[skip..skip + size]
}

// Places an arena in caller storage. The header takes the first ArenaHeader
// bytes of backing (plus up to 15 to align it), and the arena never grows past
// backing. Panics when backing cannot hold the header. Release clears it;
// reuse the storage by calling this again.
pub fn arena_from_buffer(backing: []u8) *Arena {
  if #len(backing) == 0 {
    #panic("arena buffer cannot hold the arena header")
  }
  address := #cast(usize, &backing[0])
  skip := align_size(address, 16) - address
  if skip > #len(backing) || #len(backing) - skip < header_size() {
    #panic("arena buffer cannot hold the arena header")
  }
  arena := block_init(backing[skip..], 0, false, #len(backing) - skip)
  arena.current = arena
  arena.fixed_buffer = true
  arena.backing = #len(arena.data)
  return arena
}

// An arena on OS pages. block_size is the reservation for each block; zero
// picks the target default (64 GiB of address space on 64-bit hosts, where
// only touched pages cost memory). When a block fills up, the arena adds
// another, so earlier allocations never move. Panics when the OS refuses the
// reservation. Release with arena_release.
pub fn arena_alloc(block_size: usize) *Arena {
  source := pages(0)
  source.block_size = block_size
  return arena_from_source(source)
}

// An arena whose blocks come from source. Panics when the source cannot give
// the first block.
pub fn arena_from_source(source: Source) *Arena {
  size := source.block_size
  if size == 0 {
    size = DefaultBlock
  }
  if source.limit != 0 && size > source.limit {
    size = source.limit
  }
  if size < header_size() {
    size = header_size()
  }
  if source.limit != 0 && size > source.limit {
    #panic("arena limit cannot hold the arena header")
  }
  arena := new_block(&source, size, 0)
  arena.current = arena
  arena.source = source
  arena.backing = #len(arena.data)
  return arena
}

// A block of size bytes at position base, from source.
fn new_block(source: *const Source, size: usize, base: usize) *Arena {
  if source.take == nil {
    mapping := mapping_with_header(size)
    if !mapping.ok {
      #panic("cannot reserve arena memory")
    }
    return block_init(mapping.bytes, base, true, mapping.committed)
  }
  bytes := source.take(source.context, size)
  if #len(bytes) < size || #len(bytes) < header_size() {
    #panic("arena exhausted: its source has no more memory")
  }
  if (#cast(usize, &bytes[0]) & 15) != 0 {
    #panic("arena source block is not 16-byte aligned")
  }
  return block_init(bytes, base, false, #len(bytes))
}

// Returns a block to where it came from.
fn give_block(arena: *const Arena, block: *Arena) {
  bytes := block.data
  if block.owns_memory {
    if mapping_release(bytes) != 0 {
      #panic("cannot release arena memory")
    }
  } else if arena.source.give != nil {
    arena.source.give(arena.source.context, bytes)
  }
}

// Frees every block that is not the first. Release with the newest first, so a
// bare-metal region is returned in order.
fn release_blocks_after(arena: *Arena, keep: *Arena) {
  for arena.current != nil && arena.current != keep {
    block := arena.current
    arena.current = block.previous
    arena.backing -= #len(block.data)
    give_block(arena, block)
  }
}

// Returns owned blocks to where they came from. A buffer arena is cleared and
// its storage is left to the caller. Releasing nil does nothing, so
// zero-valued owners can be released. Invalidation: everything pushed, and
// the arena itself.
pub fn arena_release(arena: *Arena) {
  if arena == nil { return }
  release_blocks_after(arena, arena)
  if arena.owns_memory || arena.source.give != nil {
    give_block(arena, arena)
    return
  }
  arena.* = Arena{}
}

const CommitStep: usize = 1048576

// Commits a block's backing through end, in CommitStep pieces. Windows only in practice.
fn arena_commit(block: *Arena, end: usize) bool {
  target := align_size(end, CommitStep)
  if target > #len(block.data) || target < end {
    target = #len(block.data)
  }
  if !mapping_commit(block.data, block.committed, target) { return false }
  block.committed = target
  return true
}

// Bytes pushed, padding included, headers excluded.
pub fn arena_used(arena: *const Arena) usize {
  total: usize = 0
  block := arena.current
  for block != nil {
    total += block.offset - header_size()
    block = block.previous
  }
  return total
}
// The largest push that cannot run out: what is left of a buffer arena, or
// of a limit, or #max(usize). Producers that guess an output size cap the
// guess with it, so a small buffer arena still holds output that fits.
// Alignment padding can take up to 15 more bytes from a typed push.
pub fn arena_room(arena: *const Arena) usize {
  block := arena.current
  tail := #len(block.data) - block.offset
  if arena.fixed_buffer { return tail }
  limit := arena.source.limit
  if limit == 0 { return #max(usize) }
  fresh: usize = 0
  if limit > arena.backing && limit - arena.backing > header_size() {
    fresh = limit - arena.backing - header_size()
  }
  if tail > fresh { return tail }
  return fresh
}
// Whether source borrows unused backing in any block of arena: bytes that are
// not live allocations, which the next push may overwrite. Producers that
// write into arena refuse such inputs. Cost: linear in the arena's blocks.
pub fn arena_overlaps_unallocated(arena: *const Arena, source: []const u8) bool {
  if arena == nil || #len(source) == 0 { return false }
  input := #cast(usize, &source[0])
  block := arena.current
  for block != nil {
    if block.offset < #len(block.data) {
      tail := #cast(usize, &block.data[block.offset])
      count := #len(block.data) - block.offset
      if input <= tail {
        if tail - input < #len(source) { return true }
      } else if input - tail < count { return true }
    }
    block = block.previous
  }
  return false
}

// The arena's current position, for arena_rewind.
pub fn arena_mark(arena: *const Arena) usize {
  return arena.current.base + arena.current.offset
}

// Takes back everything pushed.
pub fn arena_reset(arena: *Arena) {
  arena_rewind(arena, header_size())
}

// Takes back everything pushed after mark, and frees the blocks added since.
pub fn arena_rewind(arena: *Arena, mark: usize) {
  if mark > arena_mark(arena) {
    #panic("arena mark is ahead of current position")
  }
  // Marks below the start, such as 0, rewind to the start.
  target := mark
  if target < header_size() {
    target = header_size()
  }
  for arena.current != arena && target <= arena.current.base + header_size() {
    block := arena.current
    arena.current = block.previous
    arena.backing -= #len(block.data)
    give_block(arena, block)
  }
  block := arena.current
  at := target - block.base
  if arena.poison_on_rewind {
    i := at
    for i < block.offset {
      block.data[i] = 221
      i += 1
    }
  }
  block.offset = at
}

fn align_size(size: usize, alignment: usize) usize {
  remainder := size & (alignment - 1)
  if remainder == 0 { return size }
  padding := alignment - remainder
  maximum := #max(usize)
  if size > maximum - padding { return 0 }
  return size + padding
}

// Zero only payload bytes: align with scalar stores, then use bounded machine words.
fn zero_bytes_fast(items: []u8) {
  i: usize = 0
  for i < #len(items) && (#cast(usize, &items[i]) & (#sizeof(usize) - 1)) != 0 {
    items[i] = 0
    i += 1
  }
  for #len(items) - i >= #sizeof(usize) {
    (#cast(*usize, &items[i])).* = 0
    i += #sizeof(usize)
  }
  for i < #len(items) {
    items[i] = 0
    i += 1
  }
}

// Adds a block large enough for size bytes at alignment. Panics when the
// arena cannot grow.
fn arena_grow(arena: *Arena, size: usize, alignment: usize) {
  if arena.fixed_buffer {
    #panic("arena exhausted: its buffer is full")
  }
  maximum := #max(usize)
  // Blocks and their payloads start 16-aligned, so only larger alignments
  // can need padding.
  overhead := header_size()
  if alignment > 16 {
    overhead += alignment - 16
  }
  if size > maximum - overhead {
    #panic("arena size overflow")
  }
  wanted := arena.source.block_size
  if wanted == 0 {
    wanted = DefaultBlock
  }
  if wanted < size + overhead {
    wanted = size + overhead
  }
  limit := arena.source.limit
  if limit != 0 {
    if arena.backing >= limit || limit - arena.backing < size + overhead {
      #panic("arena exhausted: it reached its limit")
    }
    if wanted > limit - arena.backing {
      wanted = limit - arena.backing
    }
  }
  if wanted > maximum - arena.backing {
    #panic("arena size overflow")
  }
  block := new_block(&arena.source, wanted, arena_mark(arena) - header_size())
  block.previous = arena.current
  arena.current = block
  arena.backing += #len(block.data)
}

// Pushes size bytes at alignment, zeroed when zero_memory. Grows the arena,
// or panics when it cannot.
fn arena_push_slow(arena: *Arena, size: usize, alignment: usize, zero_memory: bool) *u8 {
  if alignment == 0 || (alignment & (alignment - 1)) != 0 {
    #panic("arena alignment is not a power of two")
  }
  if size == 0 { return nil }
  grew := false
  for {
    block := arena.current
    available := block.data[block.offset..]
    if #len(available) != 0 {
      address := #cast(usize, &available[0])
      remainder := address & (alignment - 1)
      padding: usize = 0
      if remainder != 0 {
        padding = alignment - remainder
      }
      if padding <= #len(available) && size <= #len(available) - padding {
        end := block.offset + padding + size
        if block.owns_memory && end > block.committed && !arena_commit(block, end) {
          #panic("cannot commit arena memory")
        }
        memory := &available[padding]
        block.offset = end
        if zero_memory {
          zero_bytes_fast(#slice(memory, size))
        }
        return memory
      }
    }
    if grew {
      #panic("arena exhausted")
    }
    arena_grow(arena, size, alignment)
    grew = true
  }
  #panic("unreachable arena push exit")
}

// The common push, small enough to inline: room in the current block, already
// committed, alignment at most 16. Returns nil for anything else, which
// arena_push_slow then handles with the same result.
fn arena_push_fast(arena: *Arena, size: usize, alignment: usize) *u8 {
  block := arena.current
  // Blocks start 16-aligned, so up to 16 an aligned offset is an aligned
  // address. Alignments of 0 and above 16 take the slow path.
  mask := alignment - 1
  start := (block.offset + mask) & ~mask
  if size == 0 || mask >= 16 || (alignment & mask) != 0 || start > block.committed || size > block.committed - start {
    return nil
  }
  block.offset = start + size
  return &block.data[start]
}

// Uninitialized bytes; see push_bytes.
fn push_raw(arena: *Arena, size: usize, alignment: usize) *u8 {
  memory := arena_push_fast(arena, size, alignment)
  if memory != nil { return memory }
  return arena_push_slow(arena, size, alignment, false)
}

// Tells the OS that bytes will be touched sparsely, such as one receive
// buffer per connection of which few are busy: on Linux the whole pages inside
// bytes stop getting transparent huge pages, so touching a few bytes no longer
// makes 2 MiB resident. Only memory use changes; other targets ignore it.
pub fn advise_sparse(bytes: []u8) {
  mapping_sparse(bytes)
}

// Pushes one fresh T: zeroed, then T's field defaults. #init fills the
// memory in place, with stores of T's size.
// Ownership: result borrows arena backing.
// Invalidation: applicable rewind, reset, or release.
// Allocation: aligned for T; an owning arena adds a block when full.
// Failure: panics when the arena is exhausted.
// Thread safety: caller synchronizes access to the arena.
pub fn push(T: type, arena: *Arena) *T {
  value := #cast(*T, push_raw(arena, #sizeof(T), #alignof(T)))
  #init(value)
  return value
}

// Pushes count zeroed elements.
// Ownership: result borrows arena backing; zero count returns an empty slice.
// Invalidation: applicable rewind, reset, or release.
// Allocation: checked count * #sizeof(T), aligned and zeroed; no heap fallback.
// Failure: panics when the arena is exhausted or the size overflows.
// Thread safety: caller synchronizes access to the arena.
pub fn push_array(T: type, arena: *Arena, count: usize) []T {
  if count == 0 {
    empty: []T
    return empty
  }
  if #sizeof(T) != 0 && count > #max(usize) / #sizeof(T) {
    #panic("arena size overflow")
  }
  size := count * #sizeof(T)
  memory := arena_push_fast(arena, size, #alignof(T))
  if memory == nil {
    return #slice(#cast(*T, arena_push_slow(arena, size, #alignof(T), true)), count)
  }
  zero_bytes_fast(#slice(memory, size))
  return #slice(#cast(*T, memory), count)
}

// Pushes count uninitialized bytes, for buffers that are written before they
// are read. The bytes start right at the cursor, with no alignment padding,
// so a mark taken before the push plus a length is a position inside them:
// arena_rewind(arena, mark + used) keeps the first used bytes.
pub fn push_bytes(arena: *Arena, count: usize) []u8 {
  if count == 0 {
    empty: []u8
    return empty
  }
  return #slice(push_raw(arena, count, 1), count)
}

// Copies source into the start of destination and returns the element count.
// Panics if destination is shorter than source. Use move for overlapping ranges.
pub fn copy(destination: []$T, source: []const $T) usize {
  if #len(destination) < #len(source) {
    #panic("copy destination too small")
  }
  for i in 0..#len(source) {
    destination[i] = source[i]
  }
  return #len(source)
}

// Like copy, but source and destination may overlap.
pub fn move(destination: []$T, source: []const $T) usize {
  if #len(destination) < #len(source) {
    #panic("move destination too small")
  }
  if #len(source) == 0 { return 0 }
  destination_address := #cast(usize, &destination[0])
  source_address := #cast(usize, &source[0])
  i: usize = 0
  if destination_address > source_address && destination_address < source_address + #len(source) * #sizeof(T) {
    i = #len(source)
    for i > 0 {
      i -= 1
      destination[i] = source[i]
    }
  } else {
    for i < #len(source) {
      destination[i] = source[i]
      i += 1
    }
  }
  return #len(source)
}

// Sets every element to its zero value.
pub fn zero(items: []$T) {
  empty: T
  for *item in items {
    item.* = empty
  }
}

// Zeroes the value behind a pointer byte by byte, without a temporary copy,
// so it is safe for structs too large for the stack.
pub fn clear(value: *$T) {
  zero(#slice(#cast(*u8, value), #sizeof(T)))
}

pub fn fill(items: []$T, value: $T) {
  for *item in items {
    item.* = value
  }
}

pub fn swap(a, b: *$T) {
  t := a.*
  a.* = b.*
  b.* = t
}

// Elementwise ==. Elements must support ==.
pub fn equal(left, right: []const $T) bool {
  if #len(left) != #len(right) { return false }
  for i in 0..#len(left) {
    if left[i] != right[i] { return false }
  }
  return true
}

pub fn compare(left: []const u8, right: []const u8) i32 {
  count := #len(left)
  if #len(right) < count {
    count = #len(right)
  }
  for i in 0..count {
    if left[i] < right[i] { return -1 }
    if left[i] > right[i] { return 1 }
  }
  if #len(left) < #len(right) { return -1 }
  if #len(left) > #len(right) { return 1 }
  return 0
}
