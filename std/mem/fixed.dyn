module mem

/// A bump allocator backed by a caller-provided byte slice.
/// The backing memory can live anywhere: stack, static, or heap.
/// Individual frees are no-ops; reclaim all memory at once with reset().
///
/// Example (stack-backed):
///   buf: [4096]u8 = [...]
///   mut fa := FixedAllocator.init(buf[..])
///   alloc  := fa.allocator()
pub FixedAllocator := struct {
    buf: []u8,
    pos: usize,
}
pub FixedAllocator.init := (buf: []u8) FixedAllocator => .{ buf: buf, pos: 0 }
pub FixedAllocator.allocator := (self: *FixedAllocator) Allocator => .{
    ctx:          $as(*any, self),
    impl_alloc:   alloc,
    impl_free:    free,
    impl_realloc: fixed_realloc,
}
pub FixedAllocator.used := (self: FixedAllocator) usize => self.pos
pub FixedAllocator.remaining := (self: FixedAllocator) usize => self.buf.len - self.pos
pub FixedAllocator.reset := (self: *FixedAllocator) { self.pos = 0 }
pub FixedAllocator.alloc := (ctx: *any, size: usize, align: usize) ?*any {
    self := $as(*FixedAllocator, ctx)
    mut aligned := self.pos
    if align > 1 {
        rem := self.pos % align
        if rem != 0 aligned = self.pos + (align - rem)
    }
    if aligned + size > self.buf.len return null
    ptr := $as(*any, $as(usize, self.buf.ptr) + aligned)
    self.pos = aligned + size
    return ptr
}
pub FixedAllocator.free := (ctx: *any, ptr: *any, size: usize) {}
pub FixedAllocator.fixed_realloc := (ctx: *any, ptr: *any, old_size: usize, new_size: usize, align: usize) ?*any {
    self := $as(*FixedAllocator, ctx)
    base := $as(usize, self.buf.ptr)
    if $as(usize, ptr) + old_size == base + self.pos {
        new_pos := self.pos - old_size + new_size
        if new_pos <= self.buf.len {
            self.pos = new_pos
            return ptr
        }
        return null
    }
    return null
}
