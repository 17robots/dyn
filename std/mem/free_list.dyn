struct FreeListNode { next: *FreeListNode }

pub struct FreeList {
  backing: []u8,
  slot_size: usize,
  free_head: *FreeListNode,
}

pub fn free_list_init(backing: []u8, slot_size: usize) FreeList {
  actual: usize = slot_size
  if actual < #sizeof(FreeListNode) { actual = #sizeof(FreeListNode) }
  if actual == 0 || #len(backing) < actual { #panic("free list requires at least one slot") }
  count: usize = #len(backing) / actual
  i: usize = 0
  for i < count {
    node: *FreeListNode = #cast(*FreeListNode) &backing[i * actual]
    if i + 1 < count { node.next = #cast(*FreeListNode) &backing[(i + 1) * actual] }
    else { node.next = nil }
    i += 1
  }
  return FreeList{ backing: backing, slot_size: actual, free_head: #cast(*FreeListNode) &backing[0] }
}

pub fn free_list_alloc(list: *FreeList) rawptr {
  if list.free_head == nil { #panic("free list exhausted") }
  node: *FreeListNode = list.free_head
  list.free_head = node.next
  return #cast(rawptr) node
}

pub fn free_list_free(list: *FreeList, memory: rawptr) {
  if memory == nil { return }
  node: *FreeListNode = #cast(*FreeListNode) memory
  node.next = list.free_head
  list.free_head = node
}
