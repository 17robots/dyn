pub struct Ring {
  data: []u8,
  read: usize,
  length: usize,
}

pub fn ring(backing: []u8) Ring { return Ring{ data: backing, read: 0, length: 0 } }
pub fn ring_length(state: *const Ring) usize { return state.length }
pub fn ring_push(state: *Ring, byte: u8) bool {
  if state.length == #len(state.data) || #len(state.data) == 0 { return false }
  state.data[(state.read + state.length) % #len(state.data)] = byte
  state.length += 1
  return true
}
pub fn ring_pop(state: *Ring, output: *u8) bool {
  if state.length == 0 { return false }
  output.* = state.data[state.read]
  state.read = (state.read + 1) % #len(state.data)
  state.length -= 1
  return true
}

pub fn bitset_clear(words: []u64) {
  i: usize = 0
  for i < #len(words) { words[i] = 0 i += 1 }
}
pub fn bitset_get(words: []const u64, bit: usize) bool {
  if bit / 64 >= #len(words) { return false }
  return (words[bit / 64] & (#cast(u64) 1 << (bit % 64))) != 0
}
pub fn bitset_set(words: []u64, bit: usize, value: bool) bool {
  if bit / 64 >= #len(words) { return false }
  mask := #cast(u64) 1 << (bit % 64)
  if value { words[bit / 64] = words[bit / 64] | mask }
  else { words[bit / 64] = words[bit / 64] & ~mask }
  return true
}
