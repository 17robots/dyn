pub struct U64Result { value: u64, ok: bool }

pub fn min_i64(a, b: i64) i64 { if a < b { return a } return b }
pub fn max_i64(a, b: i64) i64 { if a > b { return a } return b }
pub fn min_u64(a, b: u64) u64 { if a < b { return a } return b }
pub fn max_u64(a, b: u64) u64 { if a > b { return a } return b }
pub fn clamp_i64(value, minimum, maximum: i64) i64 {
  if minimum > maximum { #panic("clamp minimum exceeds maximum") }
  if value < minimum { return minimum }
  if value > maximum { return maximum }
  return value
}
pub fn abs_i64(value: i64) i64 {
  if value == -9223372036854775807 - 1 { #panic("absolute value overflow") }
  if value < 0 { return -value }
  return value
}
pub fn gcd_u64(a_value, b_value: u64) u64 {
  a := a_value b := b_value
  for b != 0 { remainder := a % b a = b b = remainder }
  return a
}
pub fn checked_add_u64(a, b: u64) U64Result {
  maximum: u64 = 18446744073709551615
  if a > maximum - b { return U64Result{} }
  return U64Result{ value: a + b, ok: true }
}
pub fn checked_mul_u64(a, b: u64) U64Result {
  maximum: u64 = 18446744073709551615
  if b != 0 && a > maximum / b { return U64Result{} }
  return U64Result{ value: a * b, ok: true }
}
pub fn lcm_u64(a, b: u64) U64Result {
  if a == 0 || b == 0 { return U64Result{ value: 0, ok: true } }
  return checked_mul_u64(a / gcd_u64(a, b), b)
}
pub fn pow_u64(base_value, exponent_value: u64) U64Result {
  base := base_value exponent := exponent_value value: u64 = 1
  for exponent > 0 {
    if exponent % 2 != 0 {
      product := checked_mul_u64(value, base)
      if !product.ok { return U64Result{} }
      value = product.value
    }
    exponent /= 2
    if exponent > 0 {
      square := checked_mul_u64(base, base)
      if !square.ok { return U64Result{} }
      base = square.value
    }
  }
  return U64Result{ value: value, ok: true }
}
pub fn sqrt_u64(value: u64) u64 {
  if value < 2 { return value }
  low: u64 = 1 high := value / 2 + 1
  for low < high {
    middle := low + (high - low + 1) / 2
    if middle <= value / middle { low = middle } else { high = middle - 1 }
  }
  return low
}

pub fn sign_i64(value: i64) i64 {
  if value < 0 { return -1 }
  if value > 0 { return 1 }
  return 0
}
