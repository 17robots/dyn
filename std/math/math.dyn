pub struct U64Result { value: u64, ok: bool }

// Operands must support <. The body is checked for each type it is called with.
pub fn min(a, b: $T) T {
  if b < a {
    return b
  }
  return a
}
pub fn max(a, b: $T) T {
  if a < b {
    return b
  }
  return a
}
pub fn clamp(value, minimum, maximum: $T) T {
  if maximum < minimum {
    #panic("clamp minimum exceeds maximum")
  }
  if value < minimum {
    return minimum
  }
  if maximum < value {
    return maximum
  }
  return value
}
// Signed integers and floats. Panics on the most negative integer.
pub fn abs(value: $T) T {
  if value < 0 {
    negated := -value
    if negated < 0 {
      #panic("absolute value overflow")
    }
    return negated
  }
  return value
}
// Converts value to T and panics if it does not fit; the checked form of #cast.
pub fn narrow($T: type, value: $U) T {
  result := #cast(T) value
  if #cast(U) result != value || (result < 0) != (value < 0) {
    #panic("narrow: value does not fit")
  }
  return result
}
pub fn gcd_u64(a_value, b_value: u64) u64 {
  a := a_value
  b := b_value
  for b != 0 {
    remainder := a % b
    a = b
    b = remainder
  }
  return a
}
pub fn checked_add_u64(a, b: u64) U64Result {
  maximum: u64 = 18446744073709551615
  if a > maximum - b {
    return U64Result{}
  }
  return U64Result{ value: a + b, ok: true }
}
pub fn checked_mul_u64(a, b: u64) U64Result {
  maximum: u64 = 18446744073709551615
  if b != 0 && a > maximum / b {
    return U64Result{}
  }
  return U64Result{ value: a * b, ok: true }
}
pub fn lcm_u64(a, b: u64) U64Result {
  if a == 0 || b == 0 {
    return U64Result{ value: 0, ok: true }
  }
  return checked_mul_u64(a / gcd_u64(a, b), b)
}
pub fn pow_u64(base_value, exponent_value: u64) U64Result {
  base := base_value
  exponent := exponent_value
  value: u64 = 1
  for exponent > 0 {
    if exponent % 2 != 0 {
      product := checked_mul_u64(value, base)
      if !product.ok {
        return U64Result{}
      }
      value = product.value
    }
    exponent /= 2
    if exponent > 0 {
      square := checked_mul_u64(base, base)
      if !square.ok {
        return U64Result{}
      }
      base = square.value
    }
  }
  return U64Result{ value: value, ok: true }
}
pub fn sqrt_u64(value: u64) u64 {
  if value < 2 {
    return value
  }
  low: u64 = 1
  high := value / 2 + 1
  for low < high {
    middle := low + (high - low + 1) / 2
    if middle <= value / middle {
      low = middle
    } else {
      high = middle - 1
    }
  }
  return low
}

pub fn sign_i64(value: i64) i64 {
  if value < 0 {
    return -1
  }
  if value > 0 {
    return 1
  }
  return 0
}
