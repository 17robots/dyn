// Arbitrary-precision integers. Values are immutable: every operation writes
// its result into the caller's arena and never changes its operands. Limbs are
// 32-bit, least significant first, with no leading zero limbs; zero has no
// limbs and is never negative.

use "std/fail"
use mem "std/mem"
use io "std/io"
pub struct Int { limbs: []const u32, negative: bool }

pub struct Division { quotient: Int, remainder: Int }

fn trimmed(limbs: []u32, negative: bool) Int {
  length := limbs.len
  for length != 0 && limbs[length - 1] == 0 {
    length -= 1
  }
  return Int{ limbs: limbs[..length], negative: negative && length != 0 }
}

pub fn zero() Int {
  return Int{}
}

pub fn from_u64(arena: *mem.Arena, value: u64) Int {
  limbs := mem.push_array<u32>(arena, 2)
  limbs[0] = value & 0xffffffff
  limbs[1] = value >> 32
  return trimmed(limbs, false)
}

pub fn from_i64(arena: *mem.Arena, value: i64) Int {
  magnitude := #bitcast(u64, value)
  if value < 0 {
    magnitude = 0 - magnitude
  }
  result := from_u64(arena, magnitude)
  result.negative = value < 0
  return result
}

pub fn is_zero(value: Int) bool {
  return value.limbs.len == 0
}

// The value as a u64. A negative value fails with InvalidInput, one past
// u64 with Overflow.
pub fn to_u64(status: *fail.Status, value: Int) u64 {
  if status == nil { return to_u64(&fail.Status{}, value) }
  if status.failed { return 0 }
  if value.negative {
    fail.invalid(status, "convert to u64", "", "the value is negative")
    return 0
  }
  if value.limbs.len > 2 {
    fail.set(status, fail.make(fail.Kind.Overflow, "convert to u64", "", "the value does not fit in u64"))
    return 0
  }
  result: u64 = 0
  for i in 0..value.limbs.len {
    result |= #cast(u64, value.limbs[i]) << #cast(u64, 32 * i)
  }
  return result
}

pub fn negate(value: Int) Int {
  return Int{ limbs: value.limbs, negative: !value.negative && value.limbs.len != 0 }
}

pub fn absolute(value: Int) Int {
  return Int{ limbs: value.limbs }
}

fn compare_magnitude(a: []const u32, b: []const u32) i32 {
  if a.len != b.len {
    if a.len < b.len { return -1 }
    return 1
  }
  at := a.len
  for at != 0 {
    at -= 1
    if a[at] != b[at] {
      if a[at] < b[at] { return -1 }
      return 1
    }
  }
  return 0
}

// -1, 0 or 1 as a is less than, equal to or greater than b.
pub fn compare(a: Int, b: Int) i32 {
  if a.negative != b.negative {
    if a.negative { return -1 }
    return 1
  }
  order := compare_magnitude(a.limbs, b.limbs)
  if a.negative { return -order }
  return order
}

pub fn equal(a: Int, b: Int) bool {
  return compare(a, b) == 0
}

fn add_magnitude(arena: *mem.Arena, a: []const u32, b: []const u32) []u32 {
  long := a
  short := b
  if b.len > a.len {
    long = b
    short = a
  }
  result := mem.push_array<u32>(arena, long.len + 1)
  carry: u64 = 0
  for i in 0..long.len {
    sum := long[i] + carry
    if i < short.len {
      sum += short[i]
    }
    result[i] = sum & 0xffffffff
    carry = sum >> 32
  }
  result[long.len] = #cast(u32, carry)
  return result
}

// a - b for |a| >= |b|.
fn subtract_magnitude(arena: *mem.Arena, a: []const u32, b: []const u32) []u32 {
  result := mem.push_array<u32>(arena, a.len)
  borrow: u64 = 0
  for i in 0..a.len {
    subtrahend := borrow
    if i < b.len {
      subtrahend += b[i]
    }
    minuend := #cast(u64, a[i])
    if minuend >= subtrahend {
      result[i] = #cast(u32, minuend - subtrahend)
      borrow = 0
    } else {
      result[i] = #cast(u32, minuend + 4294967296 - subtrahend)
      borrow = 1
    }
  }
  return result
}

pub fn add(arena: *mem.Arena, a: Int, b: Int) Int {
  if a.negative == b.negative { return trimmed(add_magnitude(arena, a.limbs, b.limbs), a.negative) }
  if compare_magnitude(a.limbs, b.limbs) >= 0 {
    return trimmed(subtract_magnitude(arena, a.limbs, b.limbs), a.negative)
  }
  return trimmed(subtract_magnitude(arena, b.limbs, a.limbs), b.negative)
}

pub fn subtract(arena: *mem.Arena, a: Int, b: Int) Int {
  return add(arena, a, negate(b))
}

pub fn multiply(arena: *mem.Arena, a: Int, b: Int) Int {
  if is_zero(a) || is_zero(b) { return Int{} }
  result := mem.push_array<u32>(arena, a.limbs.len + b.limbs.len)
  for i in 0..a.limbs.len {
    carry: u64 = 0
    left := #cast(u64, a.limbs[i])
    for j in 0..b.limbs.len {
      product := left * b.limbs[j] + result[i + j] + carry
      result[i + j] = product & 0xffffffff
      carry = product >> 32
    }
    result[i + b.limbs.len] = #cast(u32, carry)
  }
  return trimmed(result, a.negative != b.negative)
}

fn leading_zeros(value: u32) u32 {
  count: u32 = 0
  probe := value
  for (probe & 0x80000000) == 0 {
    probe <<= 1
    count += 1
  }
  return count
}

// Knuth's algorithm D for |a| / |b| with b of at least two limbs.
fn divide_magnitude(arena: *mem.Arena, a: []const u32, b: []const u32, quotient: []u32, remainder: []u32) {
  shift := leading_zeros(b[b.len - 1])
  n := b.len
  m := a.len - n
  divisor := mem.push_array<u32>(arena, n)
  dividend := mem.push_array<u32>(arena, a.len + 1)
  for i in 0..n {
    value := #wrapping(b[i] << shift)
    if shift != 0 && i != 0 {
      value |= b[i - 1] >> (32 - shift)
    }
    divisor[i] = value
  }
  for i in 0..a.len {
    value := #wrapping(a[i] << shift)
    if shift != 0 && i != 0 {
      value |= a[i - 1] >> (32 - shift)
    }
    dividend[i] = value
  }
  if shift != 0 {
    dividend[a.len] = a[a.len - 1] >> (32 - shift)
  }
  top := #cast(u64, divisor[n - 1])
  next := #cast(u64, divisor[n - 2])
  j := m + 1
  for j != 0 {
    j -= 1
    numerator := #cast(u64, dividend[j + n]) << 32 | #cast(u64, dividend[j + n - 1])
    estimate := numerator / top
    rest := numerator % top
    for estimate > 0xffffffff || estimate * next > (rest << 32 | dividend[j + n - 2]) {
      estimate -= 1
      rest += top
      if rest > 0xffffffff { break }
    }
    // Multiply and subtract estimate * divisor from the dividend window.
    borrow: i64 = 0
    carry: u64 = 0
    for i in 0..n {
      product := estimate * divisor[i] + carry
      carry = product >> 32
      difference := dividend[i + j] - borrow - #cast(i64, product & 0xffffffff)
      dividend[i + j] = #bitcast(u64, difference) & 0xffffffff
      borrow = 0
      if difference < 0 {
        borrow = 1
      }
    }
    difference := dividend[j + n] - borrow - #cast(i64, carry)
    dividend[j + n] = #bitcast(u64, difference) & 0xffffffff
    if difference < 0 {
      // The estimate was one too large: add the divisor back.
      estimate -= 1
      sum: u64 = 0
      for i in 0..n {
        sum = #cast(u64, dividend[i + j]) + #cast(u64, divisor[i]) + (sum >> 32)
        dividend[i + j] = sum & 0xffffffff
      }
      dividend[j + n] = #wrapping(dividend[j + n] + (sum >> 32)) & 0xffffffff
    }
    quotient[j] = #cast(u32, estimate)
  }
  for i in 0..n {
    value := dividend[i] >> shift
    if shift != 0 {
      value |= #wrapping(dividend[i + 1] << (32 - shift))
    }
    remainder[i] = value
  }
}

// Truncated division: the quotient rounds toward zero and the remainder has
// the sign of a. A zero b fails with InvalidInput.
pub fn divide(arena: *mem.Arena, status: *fail.Status, a: Int, b: Int) Division {
  if status == nil { return divide(arena, &fail.Status{}, a, b) }
  if status.failed { return Division{} }
  if is_zero(b) {
    fail.invalid(status, "divide", "", "division by zero")
    return Division{}
  }
  return divided(arena, a, b)
}
// divide for a nonzero b.
fn divided(arena: *mem.Arena, a: Int, b: Int) Division {
  if compare_magnitude(a.limbs, b.limbs) < 0 { return Division{ remainder: a } }
  quotient := mem.push_array<u32>(arena, a.limbs.len - b.limbs.len + 1)
  if b.limbs.len == 1 {
    divisor := #cast(u64, b.limbs[0])
    rest: u64 = 0
    at := a.limbs.len
    for at != 0 {
      at -= 1
      current := rest << 32 | a.limbs[at]
      quotient[at] = #cast(u32, current / divisor)
      rest = current % divisor
    }
    remainder := mem.push_array<u32>(arena, 1)
    remainder[0] = #cast(u32, rest)
    return Division{ quotient: trimmed(quotient, a.negative != b.negative), remainder: trimmed(remainder, a.negative) }
  }
  remainder := mem.push_array<u32>(arena, b.limbs.len)
  mark := mem.arena_mark(arena)
  divide_magnitude(arena, a.limbs, b.limbs, quotient, remainder)
  mem.arena_rewind(arena, mark)
  return Division{ quotient: trimmed(quotient, a.negative != b.negative), remainder: trimmed(remainder, a.negative) }
}

pub fn shift_left(arena: *mem.Arena, value: Int, bits: usize) Int {
  if is_zero(value) { return value }
  words := bits / 32
  shift := #cast(u32, bits % 32)
  result := mem.push_array<u32>(arena, value.limbs.len + words + 1)
  for i in 0..value.limbs.len {
    limb := value.limbs[i]
    result[i + words] |= #wrapping(limb << shift)
    if shift != 0 {
      result[i + words + 1] = limb >> (32 - shift)
    }
  }
  return trimmed(result, value.negative)
}

// Shifts the magnitude right; negative values round toward zero.
pub fn shift_right(arena: *mem.Arena, value: Int, bits: usize) Int {
  words := bits / 32
  if words >= value.limbs.len { return Int{} }
  shift := #cast(u32, bits % 32)
  count := value.limbs.len - words
  result := mem.push_array<u32>(arena, count)
  for i in 0..count {
    limb := value.limbs[i + words] >> shift
    if shift != 0 && i + words + 1 < value.limbs.len {
      limb |= #wrapping(value.limbs[i + words + 1] << (32 - shift))
    }
    result[i] = limb
  }
  return trimmed(result, value.negative)
}

pub fn bit_length(value: Int) usize {
  if is_zero(value) { return 0 }
  top := value.limbs[value.limbs.len - 1]
  return value.limbs.len * 32 - #cast(usize, leading_zeros(top))
}

// The non-negative remainder of value modulo a positive modulus.
fn reduce(arena: *mem.Arena, value: Int, modulus: Int) Int {
  division := divided(arena, value, modulus)
  if division.remainder.negative { return add(arena, division.remainder, modulus) }
  return division.remainder
}

// base^exponent mod modulus by square and multiply. A modulus below one or a
// negative exponent fails with InvalidInput. Not constant time.
pub fn power_mod(arena: *mem.Arena, status: *fail.Status, base: Int, exponent: Int, modulus: Int) Int {
  if status == nil { return power_mod(arena, &fail.Status{}, base, exponent, modulus) }
  if status.failed { return Int{} }
  if modulus.negative || is_zero(modulus) || exponent.negative {
    fail.invalid(status, "power mod", "", "the modulus must be at least one and the exponent not negative")
    return Int{}
  }
  one := from_u64(arena, 1)
  if equal(modulus, one) { return Int{} }
  result := one
  current := reduce(arena, base, modulus)
  bits := bit_length(exponent)
  for i in 0..bits {
    if (exponent.limbs[i / 32] >> #cast(u32, i % 32) & 1) != 0 {
      result = reduce(arena, multiply(arena, result, current), modulus)
    }
    if i + 1 < bits {
      current = reduce(arena, multiply(arena, current, current), modulus)
    }
  }
  return result
}

// Greatest common divisor, never negative.
pub fn gcd(arena: *mem.Arena, a: Int, b: Int) Int {
  x := absolute(a)
  y := absolute(b)
  for !is_zero(y) {
    division := divided(arena, x, y)
    x = y
    y = division.remainder
  }
  return x
}

fn digit_value(byte: u8) u32 {
  if byte >= '0' && byte <= '9' { return byte - '0' }
  if byte >= 'a' && byte <= 'z' { return #cast(u32, byte - 'a') + 10 }
  if byte >= 'A' && byte <= 'Z' { return #cast(u32, byte - 'A') + 10 }
  return 99
}

// Parses an optional sign and digits in base 2 through 36. Fails with
// InvalidInput at the first invalid byte, and allocates nothing then.
pub fn parse(arena: *mem.Arena, status: *fail.Status, text: []const u8, base: u32) Int {
  if status == nil { return parse(arena, &fail.Status{}, text, base) }
  if status.failed { return Int{} }
  if base < 2 || base > 36 {
    fail.invalid(status, "parse integer", "", "base must be 2 through 36")
    return Int{}
  }
  at: usize = 0
  negative := false
  if at < text.len && (text[at] == '-' || text[at] == '+') {
    negative = text[at] == '-'
    at += 1
  }
  if at == text.len {
    fail.at(status, fail.Kind.InvalidInput, "parse integer", "expected digits", at)
    return Int{}
  }
  for i in at..text.len {
    if digit_value(text[i]) >= base {
      fail.at(status, fail.Kind.InvalidInput, "parse integer", "expected a digit", i)
      return Int{}
    }
  }
  // Each digit needs at most log2(36) < 6 bits.
  limbs := mem.push_array<u32>(arena, (text.len - at) * 6 / 32 + 1)
  used: usize = 0
  for i in at..text.len {
    carry := #cast(u64, digit_value(text[i]))
    for k in 0..used {
      product := #cast(u64, limbs[k]) * #cast(u64, base) + carry
      limbs[k] = product & 0xffffffff
      carry = product >> 32
    }
    if carry != 0 {
      limbs[used] = #cast(u32, carry)
      used += 1
    }
  }
  return trimmed(limbs[..used], negative)
}

// The value's digits in base 2 through 36, lowercase, with a leading '-' when
// negative. Panics on another base.
pub fn format(arena: *mem.Arena, value: Int, base: u32) []u8 {
  if base < 2 || base > 36 {
    #panic("big.format base must be 2 through 36")
  }
  if is_zero(value) {
    text := mem.push_bytes(arena, 1)
    text[0] = '0'
    return text
  }
  // Digits come out least significant first into scratch after the output.
  capacity := value.limbs.len * 32 + 2
  output := mem.push_bytes(arena, capacity)
  mark := mem.arena_mark(arena)
  work := mem.push_array<u32>(arena, value.limbs.len)
  _ = mem.copy(work, value.limbs)
  length := work.len
  count: usize = 0
  for length != 0 {
    rest: u64 = 0
    at := length
    for at != 0 {
      at -= 1
      current := rest << 32 | work[at]
      work[at] = #cast(u32, current / base)
      rest = current % base
    }
    for length != 0 && work[length - 1] == 0 {
      length -= 1
    }
    digit := #cast(u8, rest)
    if digit < 10 {
      output[capacity - 1 - count] = '0' + digit
    } else {
      output[capacity - 1 - count] = 'a' + digit - 10
    }
    count += 1
  }
  mem.arena_rewind(arena, mark)
  start := capacity - count
  if value.negative {
    start -= 1
    output[start] = '-'
  }
  // Move the digits to the front and release the unused tail.
  shown := capacity - start
  for i in 0..shown {
    output[i] = output[start + i]
  }
  mem.arena_rewind(arena, mark - (capacity - shown))
  return output[..shown]
}

// A non-negative value from big-endian bytes.
pub fn from_bytes(arena: *mem.Arena, data: []const u8) Int {
  limbs := mem.push_array<u32>(arena, (data.len + 3) / 4)
  for i in 0..data.len {
    position := data.len - 1 - i
    limbs[position / 4] |= #cast(u32, data[i]) << #cast(u32, 8 * (position % 4))
  }
  return trimmed(limbs, false)
}

// The magnitude as big-endian bytes without leading zeros; zero is empty.
pub fn to_bytes(arena: *mem.Arena, value: Int) []u8 {
  count := (bit_length(value) + 7) / 8
  data := mem.push_bytes(arena, count)
  for i in 0..count {
    position := count - 1 - i
    data[i] = value.limbs[position / 4] >> #cast(u32, 8 * (position % 4)) & 255
  }
  return data
}
