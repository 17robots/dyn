// Half-open ranges [min, max). Equal endpoints form an empty range.
// Endpoints must be ordered and floating endpoints must not be NaN.
// Integer arithmetic is checked; an unrepresentable dimension or pad panics.

pub struct Rng1u64 { min: u64, max: u64 }
fn rng1u64_check(r: Rng1u64) {
  if !(r.min <= r.max) {
    #panic("invalid range")
  }
}
pub fn rng1u64_empty(r: Rng1u64) bool {
  rng1u64_check(r)
  return r.min == r.max
}
pub fn rng1u64_contains(r: Rng1u64, value: u64) bool {
  rng1u64_check(r)
  return r.min <= value && value < r.max
}
pub fn rng1u64_overlaps(a, b: Rng1u64) bool {
  rng1u64_check(a)
  rng1u64_check(b)
  return a.min < a.max && b.min < b.max && a.min < b.max && b.min < a.max
}
pub fn rng1u64_intersect(a, b: Rng1u64) Rng1u64 {
  rng1u64_check(a)
  rng1u64_check(b)
  lower := max(a.min, b.min)
  upper := max(lower, min(a.max, b.max))
  return Rng1u64{min: lower, max: upper}
}
// Empty ranges are identities for union.
pub fn rng1u64_union(a, b: Rng1u64) Rng1u64 {
  if rng1u64_empty(a) {
    rng1u64_check(b)
    return b
  }
  if rng1u64_empty(b) {
    return a
  }
  return Rng1u64{min: min(a.min, b.min), max: max(a.max, b.max)}
}
pub fn rng1u64_dimension(r: Rng1u64) u64 {
  rng1u64_check(r)
  return r.max - r.min
}
// Integer centers round toward the lower endpoint.
pub fn rng1u64_center(r: Rng1u64) u64 {
  rng1u64_check(r)
  return r.min + (r.max - r.min) / 2
}
pub fn rng1u64_pad(r: Rng1u64, amount: u64) Rng1u64 {
  rng1u64_check(r)
  return Rng1u64{min: r.min - amount, max: r.max + amount}
}
// Clamp to the closed endpoint interval; an empty range clamps to min.
// The result may equal max, so it need not satisfy contains.
pub fn rng1u64_clamp(r: Rng1u64, value: u64) u64 {
  rng1u64_check(r)
  return clamp(value, r.min, r.max)
}

pub struct Rng1i64 { min: i64, max: i64 }
fn rng1i64_check(r: Rng1i64) {
  if !(r.min <= r.max) {
    #panic("invalid range")
  }
}
pub fn rng1i64_empty(r: Rng1i64) bool {
  rng1i64_check(r)
  return r.min == r.max
}
pub fn rng1i64_contains(r: Rng1i64, value: i64) bool {
  rng1i64_check(r)
  return r.min <= value && value < r.max
}
pub fn rng1i64_overlaps(a, b: Rng1i64) bool {
  rng1i64_check(a)
  rng1i64_check(b)
  return a.min < a.max && b.min < b.max && a.min < b.max && b.min < a.max
}
pub fn rng1i64_intersect(a, b: Rng1i64) Rng1i64 {
  rng1i64_check(a)
  rng1i64_check(b)
  lower := max(a.min, b.min)
  upper := max(lower, min(a.max, b.max))
  return Rng1i64{min: lower, max: upper}
}
// Empty ranges are identities for union.
pub fn rng1i64_union(a, b: Rng1i64) Rng1i64 {
  if rng1i64_empty(a) {
    rng1i64_check(b)
    return b
  }
  if rng1i64_empty(b) {
    return a
  }
  return Rng1i64{min: min(a.min, b.min), max: max(a.max, b.max)}
}
pub fn rng1i64_dimension(r: Rng1i64) i64 {
  rng1i64_check(r)
  return r.max - r.min
}
// Integer centers round toward the lower endpoint.
pub fn rng1i64_center(r: Rng1i64) i64 {
  rng1i64_check(r)
  return r.min + #cast(i64, #wrap(#cast(u64, r.max) - #cast(u64, r.min)) / 2)
}
pub fn rng1i64_pad(r: Rng1i64, amount: i64) Rng1i64 {
  rng1i64_check(r)
  if !(amount >= 0) {
    #panic("negative range padding")
  }
  return Rng1i64{min: r.min - amount, max: r.max + amount}
}
// Clamp to the closed endpoint interval; an empty range clamps to min.
// The result may equal max, so it need not satisfy contains.
pub fn rng1i64_clamp(r: Rng1i64, value: i64) i64 {
  rng1i64_check(r)
  return clamp(value, r.min, r.max)
}

pub struct Rng1f32 { min: f32, max: f32 }
fn rng1f32_check(r: Rng1f32) {
  if !(r.min <= r.max) {
    #panic("invalid range")
  }
}
pub fn rng1f32_empty(r: Rng1f32) bool {
  rng1f32_check(r)
  return r.min == r.max
}
pub fn rng1f32_contains(r: Rng1f32, value: f32) bool {
  rng1f32_check(r)
  return r.min <= value && value < r.max
}
pub fn rng1f32_overlaps(a, b: Rng1f32) bool {
  rng1f32_check(a)
  rng1f32_check(b)
  return a.min < a.max && b.min < b.max && a.min < b.max && b.min < a.max
}
pub fn rng1f32_intersect(a, b: Rng1f32) Rng1f32 {
  rng1f32_check(a)
  rng1f32_check(b)
  lower := max(a.min, b.min)
  upper := max(lower, min(a.max, b.max))
  return Rng1f32{min: lower, max: upper}
}
// Empty ranges are identities for union.
pub fn rng1f32_union(a, b: Rng1f32) Rng1f32 {
  if rng1f32_empty(a) {
    rng1f32_check(b)
    return b
  }
  if rng1f32_empty(b) {
    return a
  }
  return Rng1f32{min: min(a.min, b.min), max: max(a.max, b.max)}
}
pub fn rng1f32_dimension(r: Rng1f32) f32 {
  rng1f32_check(r)
  return r.max - r.min
}
// Widen before averaging to preserve finite subnormal endpoints.
pub fn rng1f32_center(r: Rng1f32) f32 {
  rng1f32_check(r)
  return #cast(f32, (#cast(f64, r.min) + #cast(f64, r.max)) * 0.5)
}
pub fn rng1f32_pad(r: Rng1f32, amount: f32) Rng1f32 {
  rng1f32_check(r)
  if !(amount >= 0.0) {
    #panic("negative range padding")
  }
  return Rng1f32{min: r.min - amount, max: r.max + amount}
}
// Clamp to the closed endpoint interval; an empty range clamps to min.
// The result may equal max, so it need not satisfy contains.
pub fn rng1f32_clamp(r: Rng1f32, value: f32) f32 {
  rng1f32_check(r)
  return clamp(value, r.min, r.max)
}

pub struct Rng2f32 { min: Vec2, max: Vec2 }
fn rng2f32_check(r: Rng2f32) {
  if !(r.min.x <= r.max.x && r.min.y <= r.max.y) {
    #panic("invalid rectangle")
  }
}
pub fn rng2f32_empty(r: Rng2f32) bool {
  rng2f32_check(r)
  return r.min.x == r.max.x || r.min.y == r.max.y
}
pub fn rng2f32_contains(r: Rng2f32, point: Vec2) bool {
  rng2f32_check(r)
  return r.min.x <= point.x && point.x < r.max.x && r.min.y <= point.y && point.y < r.max.y
}
pub fn rng2f32_overlaps(a, b: Rng2f32) bool {
  rng2f32_check(a)
  rng2f32_check(b)
  if rng2f32_empty(a) || rng2f32_empty(b) {
    return false
  }
  return a.min.x < b.max.x && b.min.x < a.max.x && a.min.y < b.max.y && b.min.y < a.max.y
}
pub fn rng2f32_intersect(a, b: Rng2f32) Rng2f32 {
  rng2f32_check(a)
  rng2f32_check(b)
  lower := Vec2{x: max(a.min.x, b.min.x), y: max(a.min.y, b.min.y)}
  upper := Vec2{x: max(lower.x, min(a.max.x, b.max.x)), y: max(lower.y, min(a.max.y, b.max.y))}
  return Rng2f32{min: lower, max: upper}
}
pub fn rng2f32_union(a, b: Rng2f32) Rng2f32 {
  if rng2f32_empty(a) {
    rng2f32_check(b)
    return b
  }
  if rng2f32_empty(b) {
    return a
  }
  return Rng2f32{min: Vec2{x: min(a.min.x, b.min.x), y: min(a.min.y, b.min.y)}, max: Vec2{x: max(a.max.x, b.max.x), y: max(a.max.y, b.max.y)}}
}
pub fn rng2f32_dimension(r: Rng2f32) Vec2 {
  rng2f32_check(r)
  return Vec2{x: r.max.x - r.min.x, y: r.max.y - r.min.y}
}
pub fn rng2f32_center(r: Rng2f32) Vec2 {
  rng2f32_check(r)
  return Vec2{x: #cast(f32, (#cast(f64, r.min.x) + #cast(f64, r.max.x)) * 0.5), y: #cast(f32, (#cast(f64, r.min.y) + #cast(f64, r.max.y)) * 0.5)}
}
pub fn rng2f32_pad(r: Rng2f32, amount: f32) Rng2f32 {
  rng2f32_check(r)
  if !(amount >= 0.0) {
    #panic("negative rectangle padding")
  }
  return Rng2f32{min: Vec2{x: r.min.x - amount, y: r.min.y - amount}, max: Vec2{x: r.max.x + amount, y: r.max.y + amount}}
}
// Clamp to the closed endpoint rectangle, including its maximum edges.
pub fn rng2f32_clamp(r: Rng2f32, point: Vec2) Vec2 {
  rng2f32_check(r)
  return Vec2{x: clamp(point.x, r.min.x, r.max.x), y: clamp(point.y, r.min.y, r.max.y)}
}

pub struct Rng2i32 { min: Vec2i, max: Vec2i }
fn rng2i32_check(r: Rng2i32) {
  if !(r.min.x <= r.max.x && r.min.y <= r.max.y) {
    #panic("invalid rectangle")
  }
}
pub fn rng2i32_empty(r: Rng2i32) bool {
  rng2i32_check(r)
  return r.min.x == r.max.x || r.min.y == r.max.y
}
pub fn rng2i32_contains(r: Rng2i32, point: Vec2i) bool {
  rng2i32_check(r)
  return r.min.x <= point.x && point.x < r.max.x && r.min.y <= point.y && point.y < r.max.y
}
pub fn rng2i32_overlaps(a, b: Rng2i32) bool {
  rng2i32_check(a)
  rng2i32_check(b)
  if rng2i32_empty(a) || rng2i32_empty(b) {
    return false
  }
  return a.min.x < b.max.x && b.min.x < a.max.x && a.min.y < b.max.y && b.min.y < a.max.y
}
pub fn rng2i32_intersect(a, b: Rng2i32) Rng2i32 {
  rng2i32_check(a)
  rng2i32_check(b)
  lower := Vec2i{x: max(a.min.x, b.min.x), y: max(a.min.y, b.min.y)}
  upper := Vec2i{x: max(lower.x, min(a.max.x, b.max.x)), y: max(lower.y, min(a.max.y, b.max.y))}
  return Rng2i32{min: lower, max: upper}
}
pub fn rng2i32_union(a, b: Rng2i32) Rng2i32 {
  if rng2i32_empty(a) {
    rng2i32_check(b)
    return b
  }
  if rng2i32_empty(b) {
    return a
  }
  return Rng2i32{min: Vec2i{x: min(a.min.x, b.min.x), y: min(a.min.y, b.min.y)}, max: Vec2i{x: max(a.max.x, b.max.x), y: max(a.max.y, b.max.y)}}
}
pub fn rng2i32_dimension(r: Rng2i32) Vec2i {
  rng2i32_check(r)
  return Vec2i{x: r.max.x - r.min.x, y: r.max.y - r.min.y}
}
pub fn rng2i32_center(r: Rng2i32) Vec2i {
  rng2i32_check(r)
  return Vec2i{x: #cast(i32, #cast(i64, r.min.x) + (#cast(i64, r.max.x) - #cast(i64, r.min.x)) / 2), y: #cast(i32, #cast(i64, r.min.y) + (#cast(i64, r.max.y) - #cast(i64, r.min.y)) / 2)}
}
pub fn rng2i32_pad(r: Rng2i32, amount: i32) Rng2i32 {
  rng2i32_check(r)
  if !(amount >= 0) {
    #panic("negative rectangle padding")
  }
  return Rng2i32{min: Vec2i{x: r.min.x - amount, y: r.min.y - amount}, max: Vec2i{x: r.max.x + amount, y: r.max.y + amount}}
}
// Clamp to the closed endpoint rectangle, including its maximum edges.
pub fn rng2i32_clamp(r: Rng2i32, point: Vec2i) Vec2i {
  rng2i32_check(r)
  return Vec2i{x: clamp(point.x, r.min.x, r.max.x), y: clamp(point.y, r.min.y, r.max.y)}
}
