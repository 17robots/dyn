use "std/mem" mem

fn digit(value: u8) u8 {
  if value < 10 {
    return '0' + value
  }
  return 'a' + value - 10
}

// Compact deterministic hex dump in arena. Each row: 8-digit offset, two
// spaces, bytes, newline. Panics when columns is zero.
pub fn hexdump(arena: *mem.Arena, source: []const u8, columns: usize) []u8 {
  if columns == 0 {
    #panic("hexdump needs at least one column")
  }
  rows := (#len(source) + columns - 1) / columns
  destination := mem.push_bytes_uninit(arena, rows * 11 + #len(source) * 3)
  output_at: usize = 0
  input_at: usize = 0
  for input_at < #len(source) {
    row := #len(source) - input_at
    if row > columns {
      row = columns
    }
    shift: usize = 8
    for shift > 0 {
      shift -= 1
      destination[output_at] = digit(#cast(u8, ((input_at >> (shift * 4)) & 15)))
      output_at += 1
    }
    destination[output_at] = ' '
    destination[output_at + 1] = ' '
    output_at += 2
    for i in 0..row {
      byte := source[input_at + i]
      destination[output_at] = digit(byte >> 4)
      destination[output_at + 1] = digit(byte & 15)
      destination[output_at + 2] = ' '
      output_at += 3
    }
    destination[output_at] = '\n'
    output_at += 1
    input_at += row
  }
  return destination[..output_at]
}

pub fn poison(destination: []u8, pattern: u8) {
  for index in 0..#len(destination) {
    destination[index] = pattern
  }
}
pub fn all_equal(source: []const u8, pattern: u8) bool {
  for byte in source {
    if byte != pattern {
      return false
    }
  }
  return true
}
