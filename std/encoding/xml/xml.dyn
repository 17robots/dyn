use stream "std/io"
use parse "std/parse"
use utf8 "std/unicode/utf8"
use bytes "std/bytes"

pub enum Kind { Start, End, Text, Comment, Processing, Cdata }
// Malformed text fails with Invalid at its offset (a stream scanner: with
// InvalidInput, or Capacity for an event larger than storage). After a
// failure a scanner stays failed: later calls return no event. A scanner's ended turns true when next returns no
// event, at the end of the input or after a failure; that event is zero.
pub struct Event { kind: Kind, name: []const u8, text: []const u8, attributes: []const u8, self_closing: bool }
pub struct Scanner { source: []const u8, offset: usize, failed: bool, ended: bool }
pub struct StreamScanner { input: stream.Reader, storage: []u8, used: usize, consumed: usize, scanned: usize, quote: u8, input_done: bool, failed: bool, ended: bool }
pub struct AttributeScanner { source: []const u8, offset: usize, failed: bool, ended: bool }
pub struct Attribute { name: []const u8, value: []const u8 }
pub struct Writer { sink: stream.Writer }

pub fn scanner(source: []const u8) Scanner {
  return Scanner{ source: source }
}
pub fn stream_scanner(input: stream.Reader, storage: []u8) StreamScanner {
  return StreamScanner{ input: input, storage: storage }
}

fn shift_stream(state: *StreamScanner) {
  if state.consumed == 0 { return }
  remaining := state.used - state.consumed
  for i in 0..remaining {
    state.storage[i] = state.storage[state.consumed + i]
  }
  state.used = remaining
  state.consumed = 0
  state.scanned = 0
  state.quote = 0
}

// Events borrow storage until the next call. Text may be returned in multiple
// events. An event larger than storage fails with Capacity.
fn stream_ended(state: *StreamScanner) Event {
  state.ended = true
  return Event{}
}
pub fn next_stream(state: *StreamScanner) Event!stream.IoErr {
  if state.failed { return stream_ended(state) }
  shift_stream(state)
  for true {
    if state.used > 0 {
      complete := state.storage[0] != '<'
      // Delay classification until the comment prefix can be distinguished.
      if state.used >= 9 || state.input_done || (state.used >= 4 && state.storage[2] != '[') {
        comment := starts(state.storage[..state.used], 0, "<!--")
        cdata := starts(state.storage[..state.used], 0, "<![CDATA[")
        processing := starts(state.storage[..state.used], 0, "<?")
        for !complete && state.scanned < state.used {
          at := state.scanned
          byte := state.storage[at]
          state.scanned += 1
          if cdata {
            complete = at >= 2 && byte == '>' && state.storage[at - 1] == ']' && state.storage[at - 2] == ']'
          } else if comment {
            complete = at >= 2 && byte == '>' && state.storage[at - 1] == '-' && state.storage[at - 2] == '-'
          } else if state.quote != 0 {
            if byte == state.quote {
              state.quote = 0
            }
          } else if byte == 39 || byte == '"' {
            state.quote = byte
          } else if byte == '>' {
            complete = !processing || (at > 0 && state.storage[at - 1] == '?')
          }
        }
      }
      if complete || state.input_done {
        candidate := scanner(state.storage[..state.used])
        parsed := next(&candidate) catch {
          state.failed = true
          _ = stream_ended(state)
          fail .InvalidInput
        }
        if candidate.ended { return stream_ended(state) }
        state.consumed = candidate.offset
        return parsed
      }
    } else if state.input_done { return stream_ended(state) }
    if state.used == state.storage.len {
      state.failed = true
      _ = stream_ended(state)
      fail .Capacity
    }
    count := stream.read(state.input, state.storage[state.used..]) catch err {
      state.failed = true
      _ = stream_ended(state)
      fail err
    }
    state.used += count
    if count == 0 {
      state.input_done = true
    }
  }
  return stream_ended(state)
}
pub fn writer(destination_writer: stream.Writer) Writer {
  return Writer{ sink: destination_writer }
}

fn escaped(state: *Writer, value: []const u8, attribute: bool) !stream.IoErr {
  start: usize = 0
  for i in 0..value.len {
    replacement: []const u8 = ""
    if value[i] == '&' {
      replacement = "&amp;"
    } else if value[i] == '<' {
      replacement = "&lt;"
    } else if value[i] == '>' {
      replacement = "&gt;"
    } else if attribute && value[i] == '"' {
      replacement = "&quot;"
    }
    if replacement.len > 0 {
      if i > start { try stream.write(state.sink, value[start..i]) }
      try stream.write(state.sink, replacement)
      start = i + 1
    }
  }
  if start < value.len { try stream.write(state.sink, value[start..]) }
}

fn xml_name(name: []const u8) bool {
  return name.len > 0 && name_end(name, 0) == name.len
}

// Names and text that XML cannot hold fail with InvalidInput before any
// byte is written.
pub fn write_text(state: *Writer, value: []const u8) !stream.IoErr {
  if !valid_characters(value) { fail .InvalidInput }
  try escaped(state, value, false)
}
pub fn write_start(state: *Writer, name: []const u8) !stream.IoErr {
  if !xml_name(name) { fail .InvalidInput }
  try stream.write(state.sink, "<")
  try stream.write(state.sink, name)
}
pub fn write_attribute(state: *Writer, name: []const u8, value: []const u8) !stream.IoErr {
  if !xml_name(name) || !valid_characters(value) { fail .InvalidInput }
  try stream.write(state.sink, " ")
  try stream.write(state.sink, name)
  try stream.write(state.sink, "=\"")
  try escaped(state, value, true)
  try stream.write(state.sink, "\"")
}
pub fn write_start_end(state: *Writer, self_closing: bool) !stream.IoErr {
  if self_closing {
    try stream.write(state.sink, "/>")
    return
  }
  try stream.write(state.sink, ">")
}
pub fn write_end(state: *Writer, name: []const u8) !stream.IoErr {
  if !xml_name(name) { fail .InvalidInput }
  try stream.write(state.sink, "</")
  try stream.write(state.sink, name)
  try stream.write(state.sink, ">")
}
fn whitespace(byte: u8) bool {
  return byte == ' ' || byte == '\t' || byte == '\r' || byte == '\n'
}
fn starts(source: []const u8, at: usize, expected: []const u8) bool {
  if at > source.len || expected.len > source.len - at { return false }
  return bytes.equal(source[at..at + expected.len], expected)
}
// Ends the scanner for good and returns the failure at at.
fn fail_at(state: *Scanner, at: usize) parse.ParseErr {
  state.failed = true
  _ = scan_ended(state)
  return parse.ParseErr.Invalid(at)
}
fn scan_ended(state: *Scanner) Event {
  state.ended = true
  return Event{}
}

// XML 1.0 Fifth Edition NameStartChar/NameChar, decoded as Unicode scalars.
fn name_start(value: u32) bool {
  return value == 58 || value == 95 || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) ||
    (value >= 192 && value <= 214) || (value >= 216 && value <= 246) || (value >= 248 && value <= 767) ||
    (value >= 880 && value <= 893) || (value >= 895 && value <= 8191) || (value >= 8204 && value <= 8205) ||
    (value >= 8304 && value <= 8591) || (value >= 11264 && value <= 12271) || (value >= 12289 && value <= 55295) ||
    (value >= 63744 && value <= 64975) || (value >= 65008 && value <= 65533) || (value >= 65536 && value <= 983039)
}
fn name_end(source: []const u8, start: usize) usize {
  at := start
  first := utf8.decode(source, at)
  if !first.valid || !name_start(first.codepoint) { return start }
  at += first.width
  for at < source.len {
    part := utf8.decode(source, at)
    if !part.valid { break }
    value := part.codepoint
    if !name_start(value) && value != 45 && value != 46 && !(value >= 48 && value <= 57) && value != 183 && !(value >= 768 && value <= 879) && !(value >= 8255 && value <= 8256) {
      break
    }
    at += part.width
  }
  return at
}
fn xml_character(value: u32) bool {
  return value == 9 || value == 10 || value == 13 || (value >= 32 && value <= 55295) ||
    (value >= 57344 && value <= 65533) || (value >= 65536 && value <= 1114111)
}
fn valid_characters(text: []const u8) bool {
  at: usize = 0
  for at < text.len {
    decoded := utf8.decode(text, at)
    if !decoded.valid || !xml_character(decoded.codepoint) { return false }
    at += decoded.width
  }
  return true
}
// Unicode names, UTF-8 values, predefined/numeric entities; no DTD expansion.
fn valid_text(text: []const u8, attribute: bool) bool {
  at: usize = 0
  for at < text.len {
    decoded := utf8.decode(text, at)
    if !decoded.valid || !xml_character(decoded.codepoint) { return false }
    if attribute && text[at] == '<' { return false }
    if !attribute && starts(text, at, "]]>") { return false }
    if text[at] == '&' {
      end := at + 1
      for end < text.len && text[end] != ';' {
        end += 1
      }
      if end == text.len { return false }
      entity := text[at + 1..end]
      if entity.len > 0 && entity[0] == '#' {
        index: usize = 1
        base: u32 = 10
        value: u32 = 0
        if index < entity.len && entity[index] == 'x' {
          base = 16
          index += 1
        }
        if index == entity.len { return false }
        for index < entity.len {
          byte := entity[index]
          digit: u32 = 16
          if byte >= '0' && byte <= '9' {
            digit = (byte - '0')
          } else if byte >= 'a' && byte <= 'f' {
            digit = #cast(u32, (byte - 'a')) + 10
          } else if byte >= 'A' && byte <= 'F' {
            digit = #cast(u32, (byte - 'A')) + 10
          }
          if digit >= base || value > (1114111 - digit) / base { return false }
          value = value * base + digit
          index += 1
        }
        if !xml_character(value) { return false }
      } else if !bytes.equal(entity, "amp") && !bytes.equal(entity, "lt") && !bytes.equal(entity, "gt") &&
        !bytes.equal(entity, "apos") && !bytes.equal(entity, "quot") {
        return false
      }
      at = end + 1
    } else {
      at += decoded.width
    }
  }
  return true
}

pub fn next(state: *Scanner) Event!parse.ParseErr {
  if state.failed || state.offset == state.source.len { return scan_ended(state) }
  start := state.offset
  if state.source[start] != '<' {
    text_end := start
    for text_end < state.source.len && state.source[text_end] != '<' {
      text_end += 1
    }
    state.offset = text_end
    return Event{ kind: Kind.Text, text: state.source[start..text_end] }
  }
  if starts(state.source, start, "<![CDATA[") {
    cdata_end := start + 9
    for cdata_end + 3 <= state.source.len && !starts(state.source, cdata_end, "]]>") {
      cdata_end += 1
    }
    if cdata_end + 3 > state.source.len { fail fail_at(state, start) }
    state.offset = cdata_end + 3
    return Event{ kind: Kind.Cdata, text: state.source[start + 9..cdata_end] }
  }
  if starts(state.source, start, "<!--") {
    comment_end := start + 4
    for comment_end + 3 <= state.source.len && !starts(state.source, comment_end, "-->") {
      comment_end += 1
    }
    if comment_end + 3 > state.source.len { fail fail_at(state, start) }
    state.offset = comment_end + 3
    return Event{ kind: Kind.Comment, text: state.source[start + 4..comment_end] }
  }
  processing := starts(state.source, start, "<?")
  closing := starts(state.source, start, "</")
  at := start + 1
  if processing || closing {
    at += 1
  }
  name_start := at
  at = name_end(state.source, at)
  if at == name_start { fail fail_at(state, at) }
  name := state.source[name_start..at]
  if closing {
    for at < state.source.len && whitespace(state.source[at]) {
      at += 1
    }
    if at >= state.source.len || state.source[at] != '>' { fail fail_at(state, at) }
    state.offset = at + 1
    return Event{ kind: Kind.End, name: name }
  }
  attributes_start := at
  quote: u8 = 0
  tag_end := at
  for tag_end < state.source.len {
    byte := state.source[tag_end]
    if quote != 0 {
      if byte == quote {
        quote = 0
      }
    } else if byte == '"' || byte == 39 {
      quote = byte
    } else if processing && byte == '?' && tag_end + 1 < state.source.len && state.source[tag_end + 1] == '>' {
      break
    } else if !processing && byte == '>' { break }
    tag_end += 1
  }
  if tag_end >= state.source.len || quote != 0 { fail fail_at(state, tag_end) }
  terminator := tag_end
  if processing { state.offset = tag_end + 2 } else { state.offset = tag_end + 1 }
  attributes_end := terminator
  for attributes_end > attributes_start && whitespace(state.source[attributes_end - 1]) {
    attributes_end -= 1
  }
  self_closing := false
  if !processing && attributes_end > attributes_start && state.source[attributes_end - 1] == '/' {
    self_closing = true
    attributes_end -= 1
  }
  for attributes_end > attributes_start && whitespace(state.source[attributes_end - 1]) {
    attributes_end -= 1
  }
  event_kind := Kind.Start
  if processing {
    event_kind = Kind.Processing
  }
  return Event{ kind: event_kind, name: name, attributes: state.source[attributes_start..attributes_end], self_closing: self_closing }
}

pub fn attributes(event: Event) AttributeScanner {
  return AttributeScanner{ source: event.attributes }
}
// Ends the scanner for good and returns the failure at its offset.
fn attribute_error(state: *AttributeScanner) parse.ParseErr {
  state.failed = true
  _ = attribute_ended(state)
  return parse.ParseErr.Invalid(state.offset)
}
fn attribute_ended(state: *AttributeScanner) Attribute {
  state.ended = true
  return Attribute{}
}
pub fn next_attribute(state: *AttributeScanner) Attribute!parse.ParseErr {
  if state.failed { return attribute_ended(state) }
  at := state.offset
  for at < state.source.len && whitespace(state.source[at]) {
    at += 1
  }
  if at == state.source.len {
    state.offset = at
    return attribute_ended(state)
  }
  if at == state.offset { fail attribute_error(state) }
  start := at
  at = name_end(state.source, at)
  if at == start { fail attribute_error(state) }
  name := state.source[start..at]
  for at < state.source.len && whitespace(state.source[at]) {
    at += 1
  }
  if at >= state.source.len || state.source[at] != '=' { fail attribute_error(state) }
  at += 1
  for at < state.source.len && whitespace(state.source[at]) {
    at += 1
  }
  if at >= state.source.len || (state.source[at] != '"' && state.source[at] != 39) {
    fail attribute_error(state)
  }
  quote := state.source[at]
  at += 1
  value_start := at
  for at < state.source.len && state.source[at] != quote {
    at += 1
  }
  if at == state.source.len { fail attribute_error(state) }
  value := state.source[value_start..at]
  if !valid_text(value, true) { fail attribute_error(state) }
  state.offset = at + 1
  return Attribute{ name: name, value: value }
}
fn valid_attributes(event: Event) bool {
  scan := attributes(event)
  for {
    before := scan.offset
    item := next_attribute(&scan) catch { return false }
    if scan.ended { return true }
    previous := attributes(event)
    for previous.offset < before {
      other := next_attribute(&previous) catch { return false }
      if previous.ended { break }
      if bytes.equal(other.name, item.name) { return false }
    }
  }
  return false
}

pub fn valid(source: []const u8, stack: [][]const u8) bool {
  state := scanner(source)
  depth: usize = 0
  roots: usize = 0
  for {
    item := next(&state) catch { return false }
    if state.ended { return depth == 0 && roots == 1 }
    if item.kind == Kind.Text && !valid_text(item.text, false) { return false }
    if item.kind == Kind.Cdata || item.kind == Kind.Comment {
      if !valid_characters(item.text) { return false }
      if item.kind == Kind.Cdata && depth == 0 { return false }
    }
    if item.kind == Kind.Comment {
      i: usize = 0
      for i < item.text.len {
        if i + 1 < item.text.len && item.text[i] == '-' && item.text[i + 1] == '-' { return false }
        i += 1
      }
      if item.text.len > 0 && item.text[item.text.len - 1] == '-' { return false }
    }
    if item.kind == Kind.Start {
      if !valid_attributes(item) { return false }
      if depth == 0 {
        roots += 1
      }
      if !item.self_closing {
        if depth == stack.len { return false }
        stack[depth] = item.name
        depth += 1
      }
    } else if item.kind == Kind.End {
      if depth == 0 || !bytes.equal(stack[depth - 1], item.name) { return false }
      depth -= 1
    } else if item.kind == Kind.Text && depth == 0 {
      for byte in item.text {
        if !whitespace(byte) { return false }
      }
    }
  }
  return false
}
