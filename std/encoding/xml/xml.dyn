use "std/io" stream
use "std/fail"
use "std/unicode/utf8" utf8
use "std/bytes" bytes

pub enum Kind { Start, End, Text, Comment, Processing, Cdata }
// Malformed text fails with InvalidInput at its offset. After a failure a
// scanner stays failed. A scanner's ended turns true when next returns no
// event, at the end of the input or after a failure; that event is zero.
pub struct Event { kind: Kind, name: []const u8, text: []const u8, attributes: []const u8, self_closing: bool }
pub struct Scanner { source: []const u8, offset: usize, failed: bool, ended: bool }
pub struct StreamScanner { input: stream.Reader, storage: []u8, used: usize, consumed: usize, scanned: usize, quote: u8, input_done: bool, failed: bool, ended: bool }
pub struct AttributeScanner { source: []const u8, offset: usize, failed: bool, ended: bool }
pub struct Attribute { name: []const u8, value: []const u8 }
pub struct Writer { sink: stream.Writer }

pub fn scanner(source: []const u8) Scanner {
  return Scanner{ source: source }
}
pub fn stream_scanner(input: stream.Reader, storage: []u8) StreamScanner {
  return StreamScanner{ input: input, storage: storage }
}

fn shift_stream(state: *StreamScanner) {
  if state.consumed == 0 { return }
  remaining := state.used - state.consumed
  for i in 0..remaining {
    state.storage[i] = state.storage[state.consumed + i]
  }
  state.used = remaining
  state.consumed = 0
  state.scanned = 0
  state.quote = 0
}

// Events borrow storage until the next call. Text may be returned in multiple
// events. An event larger than storage fails with Capacity.
fn stream_ended(state: *StreamScanner) Event {
  state.ended = true
  return Event{}
}
pub fn next_stream(status: *fail.Status, state: *StreamScanner) Event {
  if status == nil { return next_stream(&fail.Status{}, state) }
  if status.failed || state.failed { return stream_ended(state) }
  shift_stream(state)
  for true {
    if state.used > 0 {
      complete := state.storage[0] != '<'
      // Delay classification until the comment prefix can be distinguished.
      if state.used >= 9 || state.input_done || (state.used >= 4 && state.storage[2] != '[') {
        comment := starts(state.storage[..state.used], 0, "<!--")
        cdata := starts(state.storage[..state.used], 0, "<![CDATA[")
        processing := starts(state.storage[..state.used], 0, "<?")
        for !complete && state.scanned < state.used {
          at := state.scanned
          byte := state.storage[at]
          state.scanned += 1
          if cdata {
            complete = at >= 2 && byte == '>' && state.storage[at - 1] == ']' && state.storage[at - 2] == ']'
          } else if comment {
            complete = at >= 2 && byte == '>' && state.storage[at - 1] == '-' && state.storage[at - 2] == '-'
          } else if state.quote != 0 {
            if byte == state.quote {
              state.quote = 0
            }
          } else if byte == 39 || byte == '"' {
            state.quote = byte
          } else if byte == '>' {
            complete = !processing || (at > 0 && state.storage[at - 1] == '?')
          }
        }
      }
      if complete || state.input_done {
        candidate := scanner(state.storage[..state.used])
        parsed := next(status, &candidate)
        state.failed = candidate.failed
        if candidate.ended { return stream_ended(state) }
        state.consumed = candidate.offset
        return parsed
      }
    } else if state.input_done { return stream_ended(state) }
    if state.used == #len(state.storage) {
      state.failed = true
      fail.set(status, fail.make(fail.Kind.Capacity, "read XML", "", "an event does not fit storage"))
      return stream_ended(state)
    }
    count := stream.read(status, state.input, state.storage[state.used..])
    if status.failed {
      state.failed = true
      return stream_ended(state)
    }
    state.used += count
    if count == 0 {
      state.input_done = true
    }
  }
  return stream_ended(state)
}
pub fn writer(destination_writer: stream.Writer) Writer {
  return Writer{ sink: destination_writer }
}

fn emit(status: *fail.Status, state: *Writer, data: []const u8) bool {
  stream.write(status, state.sink, data)
  return !status.failed
}

fn escaped(status: *fail.Status, state: *Writer, value: []const u8, attribute: bool) bool {
  if status.failed { return false }
  start: usize = 0
  for i in 0..#len(value) {
    replacement: []const u8 = ""
    if value[i] == '&' {
      replacement = "&amp;"
    } else if value[i] == '<' {
      replacement = "&lt;"
    } else if value[i] == '>' {
      replacement = "&gt;"
    } else if attribute && value[i] == '"' {
      replacement = "&quot;"
    }
    if #len(replacement) > 0 {
      if i > start && !emit(status, state, value[start..i]) { return false }
      if !emit(status, state, replacement) { return false }
      start = i + 1
    }
  }
  return start == #len(value) || emit(status, state, value[start..])
}

// Names and text that XML cannot hold fail with InvalidInput before any
// byte is written.
fn writer_valid(status: *fail.Status, valid: bool, message: []const u8) bool {
  if status.failed { return false }
  if !valid {
    fail.invalid(status, "write XML", "", message)
    return false
  }
  return true
}

pub fn write_text(status: *fail.Status, state: *Writer, value: []const u8) {
  if status == nil {
    write_text(&fail.Status{}, state, value)
    return
  }
  _ = writer_valid(status, valid_characters(value), "text holds characters XML cannot carry") && escaped(status, state, value, false)
}
pub fn write_start(status: *fail.Status, state: *Writer, name: []const u8) {
  if status == nil {
    write_start(&fail.Status{}, state, name)
    return
  }
  _ = writer_valid(status, #len(name) > 0 && name_end(name, 0) == #len(name), "not an XML name") && emit(status, state, "<") && emit(status, state, name)
}
pub fn write_attribute(status: *fail.Status, state: *Writer, name: []const u8, value: []const u8) {
  if status == nil {
    write_attribute(&fail.Status{}, state, name, value)
    return
  }
  _ = writer_valid(status, #len(name) > 0 && name_end(name, 0) == #len(name) && valid_characters(value), "not an XML name, or the value holds characters XML cannot carry") && emit(status, state, " ") && emit(status, state, name) && emit(status, state, "=\"") &&
    escaped(status, state, value, true) && emit(status, state, "\"")
}
pub fn write_start_end(status: *fail.Status, state: *Writer, self_closing: bool) {
  if status == nil {
    write_start_end(&fail.Status{}, state, self_closing)
    return
  }
  if self_closing {
    _ = emit(status, state, "/>")
    return
  }
  _ = emit(status, state, ">")
}
pub fn write_end(status: *fail.Status, state: *Writer, name: []const u8) {
  if status == nil {
    write_end(&fail.Status{}, state, name)
    return
  }
  _ = writer_valid(status, #len(name) > 0 && name_end(name, 0) == #len(name), "not an XML name") && emit(status, state, "</") && emit(status, state, name) && emit(status, state, ">")
}
fn whitespace(byte: u8) bool {
  return byte == ' ' || byte == '\t' || byte == '\r' || byte == '\n'
}
fn starts(source: []const u8, at: usize, expected: []const u8) bool {
  if at > #len(source) || #len(expected) > #len(source) - at { return false }
  return bytes.equal(source[at..at + #len(expected)], expected)
}
fn fail_at(status: *fail.Status, state: *Scanner, at: usize) Event {
  state.failed = true
  fail.at(status, fail.Kind.InvalidInput, "read XML", "malformed XML", at)
  return scan_ended(state)
}
fn scan_ended(state: *Scanner) Event {
  state.ended = true
  return Event{}
}

// XML 1.0 Fifth Edition NameStartChar/NameChar, decoded as Unicode scalars.
fn name_start(value: u32) bool {
  return value == 58 || value == 95 || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) ||
    (value >= 192 && value <= 214) || (value >= 216 && value <= 246) || (value >= 248 && value <= 767) ||
    (value >= 880 && value <= 893) || (value >= 895 && value <= 8191) || (value >= 8204 && value <= 8205) ||
    (value >= 8304 && value <= 8591) || (value >= 11264 && value <= 12271) || (value >= 12289 && value <= 55295) ||
    (value >= 63744 && value <= 64975) || (value >= 65008 && value <= 65533) || (value >= 65536 && value <= 983039)
}
fn name_end(source: []const u8, start: usize) usize {
  at := start
  first := utf8.decode(source, at)
  if !first.valid || !name_start(first.codepoint) { return start }
  at += first.width
  for at < #len(source) {
    part := utf8.decode(source, at)
    if !part.valid { break }
    value := part.codepoint
    if !name_start(value) && value != 45 && value != 46 && !(value >= 48 && value <= 57) && value != 183 && !(value >= 768 && value <= 879) && !(value >= 8255 && value <= 8256) {
      break
    }
    at += part.width
  }
  return at
}
fn xml_character(value: u32) bool {
  return value == 9 || value == 10 || value == 13 || (value >= 32 && value <= 55295) ||
    (value >= 57344 && value <= 65533) || (value >= 65536 && value <= 1114111)
}
fn valid_characters(text: []const u8) bool {
  at: usize = 0
  for at < #len(text) {
    decoded := utf8.decode(text, at)
    if !decoded.valid || !xml_character(decoded.codepoint) { return false }
    at += decoded.width
  }
  return true
}
// Unicode names, UTF-8 values, predefined/numeric entities; no DTD expansion.
fn valid_text(text: []const u8, attribute: bool) bool {
  at: usize = 0
  for at < #len(text) {
    decoded := utf8.decode(text, at)
    if !decoded.valid || !xml_character(decoded.codepoint) { return false }
    if attribute && text[at] == '<' { return false }
    if !attribute && starts(text, at, "]]>") { return false }
    if text[at] == '&' {
      end := at + 1
      for end < #len(text) && text[end] != ';' {
        end += 1
      }
      if end == #len(text) { return false }
      entity := text[at + 1..end]
      if #len(entity) > 0 && entity[0] == '#' {
        index: usize = 1
        base: u32 = 10
        value: u32 = 0
        if index < #len(entity) && entity[index] == 'x' {
          base = 16
          index += 1
        }
        if index == #len(entity) { return false }
        for index < #len(entity) {
          byte := entity[index]
          digit: u32 = 16
          if byte >= '0' && byte <= '9' {
            digit = (byte - '0')
          } else if byte >= 'a' && byte <= 'f' {
            digit = #cast(u32, (byte - 'a')) + 10
          } else if byte >= 'A' && byte <= 'F' {
            digit = #cast(u32, (byte - 'A')) + 10
          }
          if digit >= base || value > (1114111 - digit) / base { return false }
          value = value * base + digit
          index += 1
        }
        if !xml_character(value) { return false }
      } else if !bytes.equal(entity, "amp") && !bytes.equal(entity, "lt") && !bytes.equal(entity, "gt") &&
        !bytes.equal(entity, "apos") && !bytes.equal(entity, "quot") {
        return false
      }
      at = end + 1
    } else {
      at += decoded.width
    }
  }
  return true
}

pub fn next(status: *fail.Status, state: *Scanner) Event {
  if status == nil { return next(&fail.Status{}, state) }
  if status.failed || state.failed || state.offset == #len(state.source) { return scan_ended(state) }
  start := state.offset
  if state.source[start] != '<' {
    text_end := start
    for text_end < #len(state.source) && state.source[text_end] != '<' {
      text_end += 1
    }
    state.offset = text_end
    return Event{ kind: Kind.Text, text: state.source[start..text_end] }
  }
  if starts(state.source, start, "<![CDATA[") {
    cdata_end := start + 9
    for cdata_end + 3 <= #len(state.source) && !starts(state.source, cdata_end, "]]>") {
      cdata_end += 1
    }
    if cdata_end + 3 > #len(state.source) { return fail_at(status, state, start) }
    state.offset = cdata_end + 3
    return Event{ kind: Kind.Cdata, text: state.source[start + 9..cdata_end] }
  }
  if starts(state.source, start, "<!--") {
    comment_end := start + 4
    for comment_end + 3 <= #len(state.source) && !starts(state.source, comment_end, "-->") {
      comment_end += 1
    }
    if comment_end + 3 > #len(state.source) { return fail_at(status, state, start) }
    state.offset = comment_end + 3
    return Event{ kind: Kind.Comment, text: state.source[start + 4..comment_end] }
  }
  processing := starts(state.source, start, "<?")
  closing := starts(state.source, start, "</")
  at := start + 1
  if processing || closing {
    at += 1
  }
  name_start := at
  at = name_end(state.source, at)
  if at == name_start { return fail_at(status, state, at) }
  name := state.source[name_start..at]
  if closing {
    for at < #len(state.source) && whitespace(state.source[at]) {
      at += 1
    }
    if at >= #len(state.source) || state.source[at] != '>' { return fail_at(status, state, at) }
    state.offset = at + 1
    return Event{ kind: Kind.End, name: name }
  }
  attributes_start := at
  quote: u8 = 0
  tag_end := at
  for tag_end < #len(state.source) {
    byte := state.source[tag_end]
    if quote != 0 {
      if byte == quote {
        quote = 0
      }
    } else if byte == '"' || byte == 39 {
      quote = byte
    } else if processing && byte == '?' && tag_end + 1 < #len(state.source) && state.source[tag_end + 1] == '>' {
      break
    } else if !processing && byte == '>' { break }
    tag_end += 1
  }
  if tag_end >= #len(state.source) || quote != 0 { return fail_at(status, state, tag_end) }
  terminator := tag_end
  if processing { state.offset = tag_end + 2 } else { state.offset = tag_end + 1 }
  attributes_end := terminator
  for attributes_end > attributes_start && whitespace(state.source[attributes_end - 1]) {
    attributes_end -= 1
  }
  self_closing := false
  if !processing && attributes_end > attributes_start && state.source[attributes_end - 1] == '/' {
    self_closing = true
    attributes_end -= 1
  }
  for attributes_end > attributes_start && whitespace(state.source[attributes_end - 1]) {
    attributes_end -= 1
  }
  event_kind := Kind.Start
  if processing {
    event_kind = Kind.Processing
  }
  return Event{ kind: event_kind, name: name, attributes: state.source[attributes_start..attributes_end], self_closing: self_closing }
}

pub fn attributes(event: Event) AttributeScanner {
  return AttributeScanner{ source: event.attributes }
}
fn attribute_error(status: *fail.Status, state: *AttributeScanner) Attribute {
  state.failed = true
  fail.at(status, fail.Kind.InvalidInput, "read XML attributes", "malformed attribute", state.offset)
  return attribute_ended(state)
}
fn attribute_ended(state: *AttributeScanner) Attribute {
  state.ended = true
  return Attribute{}
}
pub fn next_attribute(status: *fail.Status, state: *AttributeScanner) Attribute {
  if status == nil { return next_attribute(&fail.Status{}, state) }
  if status.failed || state.failed { return attribute_ended(state) }
  at := state.offset
  for at < #len(state.source) && whitespace(state.source[at]) {
    at += 1
  }
  if at == #len(state.source) {
    state.offset = at
    return attribute_ended(state)
  }
  if at == state.offset { return attribute_error(status, state) }
  start := at
  at = name_end(state.source, at)
  if at == start { return attribute_error(status, state) }
  name := state.source[start..at]
  for at < #len(state.source) && whitespace(state.source[at]) {
    at += 1
  }
  if at >= #len(state.source) || state.source[at] != '=' { return attribute_error(status, state) }
  at += 1
  for at < #len(state.source) && whitespace(state.source[at]) {
    at += 1
  }
  if at >= #len(state.source) || (state.source[at] != '"' && state.source[at] != 39) {
    return attribute_error(status, state)
  }
  quote := state.source[at]
  at += 1
  value_start := at
  for at < #len(state.source) && state.source[at] != quote {
    at += 1
  }
  if at == #len(state.source) { return attribute_error(status, state) }
  value := state.source[value_start..at]
  if !valid_text(value, true) { return attribute_error(status, state) }
  state.offset = at + 1
  return Attribute{ name: name, value: value }
}
fn valid_attributes(event: Event) bool {
  scan := attributes(event)
  status: fail.Status
  for {
    before := scan.offset
    item := next_attribute(&status, &scan)
    if scan.ended { return !status.failed }
    previous := attributes(event)
    for previous.offset < before {
      other := next_attribute(&status, &previous)
      if previous.ended { break }
      if bytes.equal(other.name, item.name) { return false }
    }
  }
  return false
}

pub fn valid(source: []const u8, stack: [][]const u8) bool {
  state := scanner(source)
  depth: usize = 0
  roots: usize = 0
  status: fail.Status
  for {
    item := next(&status, &state)
    if state.ended { return !status.failed && depth == 0 && roots == 1 }
    if item.kind == Kind.Text && !valid_text(item.text, false) { return false }
    if item.kind == Kind.Cdata || item.kind == Kind.Comment {
      if !valid_characters(item.text) { return false }
      if item.kind == Kind.Cdata && depth == 0 { return false }
    }
    if item.kind == Kind.Comment {
      i: usize = 0
      for i < #len(item.text) {
        if i + 1 < #len(item.text) && item.text[i] == '-' && item.text[i + 1] == '-' {
          return false
        }
        i += 1
      }
      if #len(item.text) > 0 && item.text[#len(item.text) - 1] == '-' { return false }
    }
    if item.kind == Kind.Start {
      if !valid_attributes(item) { return false }
      if depth == 0 {
        roots += 1
      }
      if !item.self_closing {
        if depth == #len(stack) { return false }
        stack[depth] = item.name
        depth += 1
      }
    } else if item.kind == Kind.End {
      if depth == 0 || !bytes.equal(stack[depth - 1], item.name) { return false }
      depth -= 1
    } else if item.kind == Kind.Text && depth == 0 {
      for byte in item.text {
        if !whitespace(byte) { return false }
      }
    }
  }
  return false
}
