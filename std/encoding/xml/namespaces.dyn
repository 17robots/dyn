// Namespace context works with buffered or streaming events. Caller storage owns
// copied scope names and normalized namespace URIs; capacity failure is explicit.
pub struct NamespaceBinding { prefix: []const u8, uri: []const u8 }
pub struct NamespaceFrame { name: []const u8, bindings: usize, used: usize }
pub struct Namespaces {
  bindings: []NamespaceBinding, frames: []NamespaceFrame, storage: []u8,
  count: usize, depth: usize, used: usize,
}
pub struct ExpandedName { prefix: []const u8, local: []const u8, uri: []const u8 }
const XmlNamespace: []const u8 = "http://www.w3.org/XML/1998/namespace"
const XmlnsNamespace: []const u8 = "http://www.w3.org/2000/xmlns/"
pub fn namespaces(bindings: []NamespaceBinding, frames: []NamespaceFrame, storage: []u8) Namespaces {
  return Namespaces{ bindings: bindings, frames: frames, storage: storage }
}
// Namespace failures carry no offset: a malformed or unbound name fails with
// InvalidInput, full caller storage with Capacity.
fn qualified(name: []const u8) ExpandedName!stream.IoErr {
  colon := name.len
  i: usize = 0
  if name.len == 0 || name_end(name, 0) != name.len { fail .InvalidInput }
  for i < name.len {
    if name[i] == ':' {
      if colon != name.len { fail .InvalidInput }
      colon = i
    }
    i += 1
  }
  if colon == name.len { return ExpandedName{ local: name } }
  if colon == 0 || colon + 1 == name.len || name_end(name, colon + 1) != name.len {
    fail .InvalidInput
  }
  return ExpandedName{ prefix: name[..colon], local: name[colon + 1..] }
}
// The expanded name of an element or attribute name in the current scope.
// Malformed or unbound names fail with InvalidInput.
pub fn namespace_resolve(state: *const Namespaces, name: []const u8, attribute: bool) ExpandedName!stream.IoErr {
  result := try qualified(name)
  if bytes.equal(result.prefix, "xmlns") || (attribute && bytes.equal(name, "xmlns")) {
    result.uri = XmlnsNamespace
    return result
  }
  if bytes.equal(result.prefix, "xml") {
    result.uri = XmlNamespace
    return result
  }
  if attribute && result.prefix.len == 0 { return result }
  i := state.count
  for i > 0 {
    i -= 1
    if bytes.equal(state.bindings[i].prefix, result.prefix) {
      result.uri = state.bindings[i].uri
      return result
    }
  }
  if result.prefix.len != 0 { fail .InvalidInput }
  return result
}
fn namespace_copy(state: *Namespaces, source: []const u8) []const u8 {
  start := state.used
  for byte in source {
    state.storage[state.used] = byte
    state.used += 1
  }
  return state.storage[start..state.used]
}
// Attribute normalization: literal whitespace becomes spaces, references retain
// the referenced scalar. Scanner already checked XML entities and characters.
fn namespace_uri(state: *Namespaces, source: []const u8) []const u8 {
  start := state.used
  at: usize = 0
  for at < source.len {
    byte := source[at]
    if byte != '&' {
      if byte == '\r' {
        if at + 1 < source.len && source[at + 1] == '\n' {
          at += 1
        }
        byte = ' '
      } else if byte == '\n' || byte == '\t' {
        byte = ' '
      }
      state.storage[state.used] = byte
      state.used += 1
      at += 1
    } else {
      end := at + 1
      for source[end] != ';' {
        end += 1
      }
      entity := source[at + 1..end]
      value: u32 = 0
      if bytes.equal(entity, "amp") {
        value = 38
      } else if bytes.equal(entity, "lt") {
        value = 60
      } else if bytes.equal(entity, "gt") {
        value = 62
      } else if bytes.equal(entity, "apos") {
        value = 39
      } else if bytes.equal(entity, "quot") {
        value = 34
      } else {
        index: usize = 1
        base: u32 = 10
        if entity[index] == 'x' {
          base = 16
          index += 1
        }
        for index < entity.len {
          digit := #cast(u32, entity[index])
          if digit >= 48 && digit <= 57 {
            digit -= 48
          } else if digit >= 97 {
            digit = digit - 97 + 10
          } else {
            digit = digit - 65 + 10
          }
          value = value * base + digit
          index += 1
        }
      }
      state.used += utf8.encode(state.storage[state.used..], value)
      at = end + 1
    }
  }
  return state.storage[start..state.used]
}
fn namespace_enter_impl(state: *Namespaces, event: Event) ExpandedName!stream.IoErr {
  if event.kind != Kind.Start || !valid_attributes(event) { fail .InvalidInput }
  if state.depth == state.frames.len || event.name.len > state.storage.len - state.used {
    fail .Capacity
  }
  previous_count := state.count
  previous_used := state.used
  copied := namespace_copy(state, event.name)
  attributes_state := attributes(event)
  for {
    item := next_attribute(&attributes_state) catch { fail .InvalidInput }
    if attributes_state.ended { break }
    split := try qualified(item.name)
    declaration := bytes.equal(item.name, "xmlns") || bytes.equal(split.prefix, "xmlns")
    if declaration {
      prefix := split.local
      if split.prefix.len == 0 {
        prefix = ""
      }
      if state.count == state.bindings.len || prefix.len + item.value.len > state.storage.len - state.used {
        fail .Capacity
      }
      owned_prefix := namespace_copy(state, prefix)
      uri := namespace_uri(state, item.value)
      if bytes.equal(prefix, "xmlns") || bytes.equal(uri, XmlnsNamespace) || (bytes.equal(prefix, "xml") != bytes.equal(uri, XmlNamespace)) || (prefix.len > 0 && uri.len == 0) {
        fail .InvalidInput
      }
      state.bindings[state.count] = NamespaceBinding{ prefix: owned_prefix, uri: uri }
      state.count += 1
    }
  }
  resolved := try namespace_resolve(state, copied, false)
  if bytes.equal(resolved.prefix, "xmlns") { fail .InvalidInput }
  scan := attributes(event)
  for {
    before := scan.offset
    attribute_item := next_attribute(&scan) catch { fail .InvalidInput }
    if scan.ended { break }
    current := try namespace_resolve(state, attribute_item.name, true)
    prior := attributes(event)
    for prior.offset < before {
      other := next_attribute(&prior) catch { fail .InvalidInput }
      if prior.ended { break }
      expanded := try namespace_resolve(state, other.name, true)
      if bytes.equal(current.uri, expanded.uri) && bytes.equal(current.local, expanded.local) {
        fail .InvalidInput
      }
    }
  }
  state.frames[state.depth] = NamespaceFrame{ name: copied, bindings: previous_count, used: previous_used }
  state.depth += 1
  return resolved
}
// Enter every Start, including self-closing tags; leave it after consuming its
// attributes. Failed enter restores scope counters; unused storage may change.
// Expanded element slices last until scope exit.
// An event that lies in the namespace storage fails with InvalidInput.
pub fn namespace_enter(state: *Namespaces, event: Event) ExpandedName!stream.IoErr {
  if bytes.overlaps(state.storage, event.name) || bytes.overlaps(state.storage, event.attributes) { fail .InvalidInput }
  count := state.count
  used := state.used
  depth := state.depth
  result := namespace_enter_impl(state, event) catch err {
    state.count = count
    state.used = used
    state.depth = depth
    fail err
  }
  return result
}
// Leaves element name; an end tag that does not match the open element fails
// with InvalidInput.
pub fn namespace_leave(state: *Namespaces, name: []const u8) !stream.IoErr {
  if state.depth == 0 || !bytes.equal(state.frames[state.depth - 1].name, name) { fail .InvalidInput }
  frame := state.frames[state.depth - 1]
  state.depth -= 1
  state.count = frame.bindings
  state.used = frame.used
}
