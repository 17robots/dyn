// Namespace context works with buffered or streaming events. Caller storage owns
// copied scope names and normalized namespace URIs; capacity failure is explicit.
pub struct NamespaceBinding { prefix: []const u8, uri: []const u8 }
pub struct NamespaceFrame { name: []const u8, bindings: usize, used: usize }
pub struct Namespaces {
  bindings: []NamespaceBinding, frames: []NamespaceFrame, storage: []u8,
  count: usize, depth: usize, used: usize,
}
pub struct ExpandedName { prefix: []const u8, local: []const u8, uri: []const u8 }
const XmlNamespace: []const u8 = "http://www.w3.org/XML/1998/namespace"
const XmlnsNamespace: []const u8 = "http://www.w3.org/2000/xmlns/"
pub fn namespaces(bindings: []NamespaceBinding, frames: []NamespaceFrame, storage: []u8) Namespaces {
  return Namespaces{ bindings: bindings, frames: frames, storage: storage }
}
fn name_failure(status: *fail.Status, kind: fail.Kind, message: []const u8) ExpandedName {
  fail.set(status, fail.make(kind, "resolve XML namespace", "", message))
  return ExpandedName{}
}
fn qualified(status: *fail.Status, name: []const u8) ExpandedName {
  colon := #len(name)
  i: usize = 0
  if #len(name) == 0 || name_end(name, 0) != #len(name) {
    return name_failure(status, fail.Kind.InvalidInput, "malformed or unbound name")
  }
  for i < #len(name) {
    if name[i] == ':' {
      if colon != #len(name) {
        return name_failure(status, fail.Kind.InvalidInput, "malformed or unbound name")
      }
      colon = i
    }
    i += 1
  }
  if colon == #len(name) { return ExpandedName{ local: name } }
  if colon == 0 || colon + 1 == #len(name) || name_end(name, colon + 1) != #len(name) {
    return name_failure(status, fail.Kind.InvalidInput, "malformed or unbound name")
  }
  return ExpandedName{ prefix: name[..colon], local: name[colon + 1..] }
}
// The expanded name of an element or attribute name in the current scope.
// Malformed or unbound names fail with InvalidInput.
pub fn namespace_resolve(status: *fail.Status, state: *const Namespaces, name: []const u8, attribute: bool) ExpandedName {
  if status.failed { return ExpandedName{} }
  result := qualified(status, name)
  if status.failed { return result }
  if bytes.equal(result.prefix, "xmlns") || (attribute && bytes.equal(name, "xmlns")) {
    result.uri = XmlnsNamespace
    return result
  }
  if bytes.equal(result.prefix, "xml") {
    result.uri = XmlNamespace
    return result
  }
  if attribute && #len(result.prefix) == 0 { return result }
  i := state.count
  for i > 0 {
    i -= 1
    if bytes.equal(state.bindings[i].prefix, result.prefix) {
      result.uri = state.bindings[i].uri
      return result
    }
  }
  if #len(result.prefix) != 0 {
    return name_failure(status, fail.Kind.InvalidInput, "malformed or unbound name")
  }
  return result
}
fn namespace_copy(state: *Namespaces, source: []const u8) []const u8 {
  start := state.used
  for byte in source {
    state.storage[state.used] = byte
    state.used += 1
  }
  return state.storage[start..state.used]
}
// Attribute normalization: literal whitespace becomes spaces, references retain
// the referenced scalar. Scanner already checked XML entities and characters.
fn namespace_uri(state: *Namespaces, source: []const u8) []const u8 {
  start := state.used
  at: usize = 0
  for at < #len(source) {
    byte := source[at]
    if byte != '&' {
      if byte == '\r' {
        if at + 1 < #len(source) && source[at + 1] == '\n' {
          at += 1
        }
        byte = ' '
      } else if byte == '\n' || byte == '\t' {
        byte = ' '
      }
      state.storage[state.used] = byte
      state.used += 1
      at += 1
    } else {
      end := at + 1
      for source[end] != ';' {
        end += 1
      }
      entity := source[at + 1..end]
      value: u32 = 0
      if bytes.equal(entity, "amp") {
        value = 38
      } else if bytes.equal(entity, "lt") {
        value = 60
      } else if bytes.equal(entity, "gt") {
        value = 62
      } else if bytes.equal(entity, "apos") {
        value = 39
      } else if bytes.equal(entity, "quot") {
        value = 34
      } else {
        index: usize = 1
        base: u32 = 10
        if entity[index] == 'x' {
          base = 16
          index += 1
        }
        for index < #len(entity) {
          digit := #cast(u32, entity[index])
          if digit >= 48 && digit <= 57 {
            digit -= 48
          } else if digit >= 97 {
            digit = digit - 97 + 10
          } else {
            digit = digit - 65 + 10
          }
          value = value * base + digit
          index += 1
        }
      }
      state.used += utf8.encode(state.storage[state.used..], value)
      at = end + 1
    }
  }
  return state.storage[start..state.used]
}
fn namespace_enter_impl(status: *fail.Status, state: *Namespaces, event: Event) ExpandedName {
  if event.kind != Kind.Start || !valid_attributes(event) {
    return name_failure(status, fail.Kind.InvalidInput, "malformed or unbound name")
  }
  if state.depth == #len(state.frames) || #len(event.name) > #len(state.storage) - state.used {
    return name_failure(status, fail.Kind.Capacity, "the namespace storage is full")
  }
  previous_count := state.count
  previous_used := state.used
  copied := namespace_copy(state, event.name)
  attributes_state := attributes(event)
  for {
    item := next_attribute(status, &attributes_state)
    if !item.found { break }
    split := qualified(status, item.name)
    if status.failed { return split }
    declaration := bytes.equal(item.name, "xmlns") || bytes.equal(split.prefix, "xmlns")
    if declaration {
      prefix := split.local
      if #len(split.prefix) == 0 {
        prefix = ""
      }
      if state.count == #len(state.bindings) || #len(prefix) + #len(item.value) > #len(state.storage) - state.used {
        return name_failure(status, fail.Kind.Capacity, "the namespace storage is full")
      }
      owned_prefix := namespace_copy(state, prefix)
      uri := namespace_uri(state, item.value)
      if bytes.equal(prefix, "xmlns") || bytes.equal(uri, XmlnsNamespace) || (bytes.equal(prefix, "xml") != bytes.equal(uri, XmlNamespace)) || (#len(prefix) > 0 && #len(uri) == 0) {
        return name_failure(status, fail.Kind.InvalidInput, "malformed or unbound name")
      }
      state.bindings[state.count] = NamespaceBinding{ prefix: owned_prefix, uri: uri }
      state.count += 1
    }
  }
  resolved := namespace_resolve(status, state, copied, false)
  if status.failed { return resolved }
  if bytes.equal(resolved.prefix, "xmlns") {
    return name_failure(status, fail.Kind.InvalidInput, "malformed or unbound name")
  }
  scan := attributes(event)
  for {
    before := scan.offset
    attribute_item := next_attribute(status, &scan)
    if !attribute_item.found { break }
    current := namespace_resolve(status, state, attribute_item.name, true)
    if status.failed { return current }
    prior := attributes(event)
    for prior.offset < before {
      other := next_attribute(status, &prior)
      if !other.found { break }
      expanded := namespace_resolve(status, state, other.name, true)
      if bytes.equal(current.uri, expanded.uri) && bytes.equal(current.local, expanded.local) {
        return name_failure(status, fail.Kind.InvalidInput, "malformed or unbound name")
      }
    }
  }
  state.frames[state.depth] = NamespaceFrame{ name: copied, bindings: previous_count, used: previous_used }
  state.depth += 1
  return resolved
}
// Enter every Start, including self-closing tags; leave it after consuming its
// attributes. Failed enter restores scope counters; unused storage may change.
// Expanded element slices last until scope exit.
pub fn namespace_enter(status: *fail.Status, state: *Namespaces, event: Event) ExpandedName {
  if status.failed { return ExpandedName{} }
  if bytes.overlaps(state.storage, event.name) || bytes.overlaps(state.storage, event.attributes) {
    return name_failure(status, fail.Kind.InvalidInput, "the event lies in the namespace storage")
  }
  count := state.count
  used := state.used
  depth := state.depth
  result := namespace_enter_impl(status, state, event)
  if status.failed {
    state.count = count
    state.used = used
    state.depth = depth
  }
  return result
}
// Leaves element name; an end tag that does not match the open element fails
// with InvalidInput.
pub fn namespace_leave(status: *fail.Status, state: *Namespaces, name: []const u8) {
  if status.failed { return }
  if state.depth == 0 || !bytes.equal(state.frames[state.depth - 1].name, name) {
    fail.invalid(status, "leave XML element", name, "the end tag does not match the open element")
    return
  }
  frame := state.frames[state.depth - 1]
  state.depth -= 1
  state.count = frame.bindings
  state.used = frame.used
}
