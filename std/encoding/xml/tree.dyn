use tree_memory "std/mem"
// Arena-owned links, borrowed source slices. This is the scanner's XML stream
// subset: raw text/entities and raw attributes, no decoding, DTD expansion or
// namespace resolution. Processing instructions retain their raw body in text.
pub enum NodeKind { Missing, Document, Element, Text, Comment, Processing, Cdata }
pub struct Node {
  kind: NodeKind,
  name: []const u8,
  text: []const u8,
  attributes: []const u8,
  first: *Node,
  last: *Node,
  next: *Node,
  parent: *Node,
}
pub const nil_node: Node = Node{}

pub fn is_nil(node: *const Node) bool {
  return node == nil || node.kind == NodeKind.Missing
}
pub fn next_sibling(node: *const Node) *const Node {
  if is_nil(node) || node.next == nil { return &nil_node }
  return node.next
}
pub fn child(node: *const Node, name: []const u8) *const Node {
  if is_nil(node) { return &nil_node }
  item: *const Node = node.first
  for !is_nil(item) {
    if item.kind == NodeKind.Element && bytes.equal(item.name, name) { return item }
    item = next_sibling(item)
  }
  return &nil_node
}
pub fn at(node: *const Node, index: usize) *const Node {
  if is_nil(node) { return &nil_node }
  item: *const Node = node.first
  i: usize = 0
  for !is_nil(item) && i < index {
    item = next_sibling(item)
    i += 1
  }
  if is_nil(item) { return &nil_node }
  return item
}
fn tree_failure(arena: *tree_memory.Arena, status: *fail.Status, mark: usize, offset: usize, message: []const u8) *const Node {
  tree_memory.arena_rewind(arena, mark)
  text := message
  if text.len == 0 {
    text = "malformed XML"
  }
  fail.at(status, fail.Kind.InvalidInput, "parse XML", text, offset)
  return &nil_node
}
fn tree_append(arena: *tree_memory.Arena, parent: *Node, kind: NodeKind, event: Event) *Node {
  node := tree_memory.push<Node>(arena)
  node.* = Node{ kind: kind, name: event.name, text: event.text, attributes: event.attributes, parent: parent }
  if parent.last == nil { parent.first = node } else { parent.last.next = node }
  parent.last = node
  return node
}
// On validation failure rewind exactly the entry mark and return a read-only
// Missing stub. Exhaustion follows mem.push's panic contract. No depth limit or
// recursive parsing: open elements themselves form the parent stack.
// Semantic failures point to the token start; scanner failures use its offset;
// invalid UTF-8/XML characters point to the first invalid source byte; missing
// root/unclosed elements point to EOF. Success offset is source length.
pub fn parse(arena: *tree_memory.Arena, status: *fail.Status, source: []const u8) *const Node {
  if status == nil { return parse(arena, &fail.Status{}, source) }
  if status.failed { return &nil_node }
  mark := tree_memory.arena_mark(arena)
  position: usize = 0
  for position < source.len {
    decoded := utf8.decode(source, position)
    if !decoded.valid || !xml_character(decoded.codepoint) {
      return tree_failure(arena, status, mark, position, "")
    }
    position += decoded.width
  }
  document := tree_memory.push<Node>(arena)
  document.* = Node{ kind: NodeKind.Document }
  parent := document
  roots: usize = 0
  scan := scanner(source)
  for {
    start := scan.offset
    event := next(status, &scan)
    if scan.ended {
      if status.failed {
        tree_memory.arena_rewind(arena, mark)
        return &nil_node
      }
      if parent != document { return tree_failure(arena, status, mark, source.len, "mismatched tag") }
      if roots != 1 { return tree_failure(arena, status, mark, source.len, "") }
      return document
    }
    if event.kind == Kind.End {
      if parent == document || !bytes.equal(parent.name, event.name) {
        return tree_failure(arena, status, mark, start, "mismatched tag")
      }
      parent = parent.parent
    } else if event.kind == Kind.Start {
      if !valid_attributes(event) { return tree_failure(arena, status, mark, start, "") }
      if parent == document {
        if roots != 0 { return tree_failure(arena, status, mark, start, "") }
        roots += 1
      }
      node := tree_append(arena, parent, NodeKind.Element, event)
      if !event.self_closing {
        parent = node
      }
    } else {
      kind := NodeKind.Missing
      if event.kind == Kind.Text {
        if !valid_text(event.text, false) { return tree_failure(arena, status, mark, start, "") }
        if parent == document {
          for byte in event.text {
            if !whitespace(byte) { return tree_failure(arena, status, mark, start, "") }
          }
        }
        kind = NodeKind.Text
      } else if event.kind == Kind.Comment {
        for i in 0..event.text.len {
          if event.text[i] == '-' && (i + 1 == event.text.len || event.text[i + 1] == '-') {
            return tree_failure(arena, status, mark, start, "")
          }
        }
        kind = NodeKind.Comment
      } else if event.kind == Kind.Cdata {
        if parent == document { return tree_failure(arena, status, mark, start, "") }
        kind = NodeKind.Cdata
      } else if event.kind == Kind.Processing {
        kind = NodeKind.Processing
        event.text = source[start + 2 + event.name.len..scan.offset - 2]
      } else {
        return tree_failure(arena, status, mark, start, "")
      }
      _ = tree_append(arena, parent, kind, event)
    }
  }
  return tree_failure(arena, status, mark, source.len, "")
}
