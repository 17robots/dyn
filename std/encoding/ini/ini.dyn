use "std/parse" parse
use "std/fail"
use "std/bytes" byte_ops
use "std/mem"
// Allocation-free INI scanner. Names and values borrow the input.
// The first malformed line stops scanning: next fails with InvalidInput at
// its offset, and the scanner remembers the line in error_line. Later calls
// fail the same way.
pub enum Kind { Section, Pair }
pub struct Entry { section: []const u8, key: []const u8, value: []const u8, kind: Kind, line: usize }
// line counts the lines read so far, so a zero Scanner{ source: text } is ready to use.
pub struct Scanner { source: []const u8, offset: usize, line: usize, section: []const u8, failed: bool, error_offset: usize, error_line: usize }
// found is false at the end of the input.
pub struct Next { value: Entry, found: bool }

pub fn scanner(source: []const u8) Scanner {
  return Scanner{ source: source }
}
fn space(byte: u8) bool {
  return byte == ' ' || byte == '\t'
}
fn trim(source: []const u8) []const u8 {
  first: usize = 0
  last := #len(source)
  for first < last && space(source[first]) {
    first += 1
  }
  for last > first && space(source[last - 1]) {
    last -= 1
  }
  return source[first..last]
}

fn record(status: *fail.Status, state: *Scanner, line: usize, offset: usize) Next {
  if !state.failed {
    state.failed = true
    state.error_offset = offset
    state.error_line = line
  }
  parse.malformed(status, "parse INI", "a line without a section name or key", state.error_offset)
  return Next{}
}

pub fn next(status: *fail.Status, state: *Scanner) Next {
  if status.failed { return Next{} }
  if state.failed { return record(status, state, state.error_line, state.error_offset) }
  for state.offset < #len(state.source) {
    start := state.offset
    finish := start
    for finish < #len(state.source) && state.source[finish] != '\n' && state.source[finish] != '\r' {
      finish += 1
    }
    state.offset = finish
    if state.offset < #len(state.source) && state.source[state.offset] == '\r' {
      state.offset += 1
    }
    if state.offset < #len(state.source) && state.source[state.offset] == '\n' {
      state.offset += 1
    }
    state.line += 1
    line_number := state.line
    line := trim(state.source[start..finish])
    if #len(line) == 0 || line[0] == ';' || line[0] == '#' { } else if line[0] == '[' {
      section_name := line[..0]
      if #len(line) >= 3 && line[#len(line) - 1] == ']' {
        section_name = trim(line[1..#len(line) - 1])
      }
      if #len(section_name) == 0 {
        return record(status, state, line_number, start)
      } else {
        state.section = section_name
        return Next{ value: Entry{ section: section_name, kind: Kind.Section, line: line_number }, found: true }
      }
    } else {
      separator := #len(line)
      scan: usize = 0
      for scan < #len(line) {
        if line[scan] == '=' {
          separator = scan
          scan = #len(line)
        } else {
          scan += 1
        }
      }
      key_name := line[..0]
      if separator < #len(line) {
        key_name = trim(line[..separator])
      }
      if #len(key_name) == 0 {
        return record(status, state, line_number, start)
      } else {
        pair_value := trim(line[separator + 1..])
        return Next{ value: Entry{ section: state.section, key: key_name, value: pair_value, kind: Kind.Pair, line: line_number }, found: true }
      }
    }
  }
  return Next{}
}

// The value of key in section, or empty when absent or the text is malformed.
pub fn find(source: []const u8, section: []const u8, key: []const u8) []const u8 {
  state := scanner(source)
  status: fail.Status
  for {
    item := next(&status, &state)
    if !item.found { return source[..0] }
    if item.value.kind == Kind.Pair && byte_ops.equal(item.value.section, section) && byte_ops.equal(item.value.key, key) {
      return item.value.value
    }
  }
  return source[..0]
}


// A materialized entry table. Entries still borrow source bytes, including
// section names. Any malformed line fails the whole parse with InvalidInput
// at its offset.
// Ownership: table borrows the arena; entry text separately borrows source.
// Invalidation: arena rewind, reset or release; keep source alive and unchanged.
// Allocation: two scans, one exact-size table allocation; no hidden scratch.
// Failure: stops at the first syntax error before allocating; a full fixed arena panics.
pub fn parse(arena: *mem.Arena, status: *fail.Status, source: []const u8) []Entry {
  empty: []Entry
  if status.failed { return empty }
  state := scanner(source)
  count: usize = 0
  for next(status, &state).found {
    count += 1
  }
  if status.failed || count == 0 { return empty }
  entries := mem.push_array(Entry, arena, count)
  state = scanner(source)
  for i in 0..count {
    entries[i] = next(status, &state).value
  }
  return entries
}
