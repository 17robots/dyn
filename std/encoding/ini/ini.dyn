use "std/parse" parse
use "std/bytes" byte_ops
use "std/mem"
// Allocation-free INI scanner. Names and values borrow the input.
// The first malformed line stops scanning and records its error and line.
// Later calls do nothing. Check state.failure after the loop.
pub enum Kind { Section, Pair }
pub struct Entry { section: []const u8, key: []const u8, value: []const u8, kind: Kind, line: usize }
// line counts the lines read so far, so a zero Scanner{ source: text } is ready to use.
pub struct Scanner { source: []const u8, offset: usize, line: usize, section: []const u8, failure: parse.Failure, error_line: usize, errors: usize }
pub struct Result { value: Entry, found: bool, failure: parse.Failure }

pub fn scanner(source: []const u8) Scanner {
  return Scanner{ source: source }
}
fn space(byte: u8) bool {
  return byte == ' ' || byte == '\t'
}
fn trim(source: []const u8) []const u8 {
  first: usize = 0
  last := #len(source)
  for first < last && space(source[first]) {
    first += 1
  }
  for last > first && space(source[last - 1]) {
    last -= 1
  }
  return source[first..last]
}

fn record(state: *Scanner, line: usize, offset: usize) {
  if state.failure.kind == parse.Kind.Ok {
    state.failure = parse.Failure{ kind: parse.Kind.Syntax, offset: offset }
    state.error_line = line
  }
  state.errors += 1
}

pub fn next(state: *Scanner) Result {
  if state.failure.kind != parse.Kind.Ok {
    return Result{ failure: state.failure }
  }
  for state.offset < #len(state.source) {
    start := state.offset
    finish := start
    for finish < #len(state.source) && state.source[finish] != '\n' && state.source[finish] != '\r' {
      finish += 1
    }
    state.offset = finish
    if state.offset < #len(state.source) && state.source[state.offset] == '\r' {
      state.offset += 1
    }
    if state.offset < #len(state.source) && state.source[state.offset] == '\n' {
      state.offset += 1
    }
    state.line += 1
    line_number := state.line
    line := trim(state.source[start..finish])
    if #len(line) == 0 || line[0] == ';' || line[0] == '#' { } else if line[0] == '[' {
      section_name := line[..0]
      if #len(line) >= 3 && line[#len(line) - 1] == ']' {
        section_name = trim(line[1..#len(line) - 1])
      }
      if #len(section_name) == 0 {
        record(state, line_number, start)
        return Result{ failure: state.failure }
      } else {
        state.section = section_name
        return Result{ value: Entry{ section: section_name, kind: Kind.Section, line: line_number }, found: true }
      }
    } else {
      separator := #len(line)
      scan: usize = 0
      for scan < #len(line) {
        if line[scan] == '=' {
          separator = scan
          scan = #len(line)
        } else {
          scan += 1
        }
      }
      key_name := line[..0]
      if separator < #len(line) {
        key_name = trim(line[..separator])
      }
      if #len(key_name) == 0 {
        record(state, line_number, start)
        return Result{ failure: state.failure }
      } else {
        pair_value := trim(line[separator + 1..])
        return Result{ value: Entry{ section: state.section, key: key_name, value: pair_value, kind: Kind.Pair, line: line_number }, found: true }
      }
    }
  }
  return Result{}
}

pub fn find(source: []const u8, section: []const u8, key: []const u8) []const u8 {
  state := scanner(source)
  for {
    item := next(&state)
    if !item.found {
      return source[..0]
    }
    if item.value.kind == Kind.Pair && byte_ops.equal(item.value.section, section) && byte_ops.equal(item.value.key, key) {
      return item.value.value
    }
  }
  return source[..0]
}


// A materialized entry table. Entries still borrow source bytes, including section names.
// Any malformed line fails the whole parse; error_line is the first one.
pub struct ParseResult {
  value: []Entry,
  offset: usize,
  line: usize,
  failure: parse.Failure,
}

// Ownership: table borrows the arena; entry text separately borrows source.
// Invalidation: arena rewind, reset or release; keep source alive and unchanged.
// Allocation: two scans, one exact-size table allocation; no hidden scratch.
// Failure: stops at the first syntax error before allocating; a full fixed arena panics.
// Thread safety: source must remain stable throughout both passes; synchronize output.
pub fn parse(arena: *mem.Arena, source: []const u8) ParseResult {
  state := scanner(source)
  count: usize = 0
  for next(&state).found {
    if count == #cast(usize, -1) {
      return ParseResult{ offset: state.offset, failure: parse.Failure{ kind: parse.Kind.Overflow, offset: state.offset } }
    }
    count += 1
  }
  if state.failure.kind != parse.Kind.Ok {
    return ParseResult{ offset: state.failure.offset, line: state.error_line, failure: state.failure }
  }
  if count == 0 {
    return ParseResult{}
  }
  entries := mem.push_array(Entry, arena, count)
  state = scanner(source)
  for i in 0..count {
    entries[i] = next(&state).value
  }
  return ParseResult{ value: entries }
}
