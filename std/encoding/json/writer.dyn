use "std/encoding/binary"
use "std/fmt" format
use "std/fail"
use "std/unicode/utf8" utf8

// JSON output into bounded caller storage, without a Value tree. Separators
// are automatic: write a key before each object member, then its value.
// Failures go on the writer's status and are sticky: a write that does not fit
// fails it with Capacity; invalid UTF-8, a key outside an object, a value
// without its key, nesting past MaxDepth or a number JSON cannot hold fail it
// with InvalidInput. Later writes do nothing. Check the status once at the end.
pub const MaxDepth: usize = 64

pub struct Writer {
  buffer: format.Buffer,
  // Per open container: true for an object; whether it holds a member yet.
  objects: [MaxDepth]bool,
  members: [MaxDepth]bool,
  depth: usize,
  // An object member's key was written and its value is due.
  keyed: bool,
}

pub fn writer(status: *fail.Status, storage: []u8) Writer {
  return Writer{ buffer: format.buffer(status, storage) }
}

fn failed(target: *const Writer) bool {
  return target.buffer.status == nil || target.buffer.status.failed
}
// Records misuse or a value JSON cannot hold.
fn rejected(target: *Writer, message: []const u8) {
  if target.buffer.status != nil {
    fail.invalid(target.buffer.status, "write JSON", "", message)
  }
}

// The JSON written so far, or empty when failed or a container is still open.
pub fn output(target: *const Writer) []const u8 {
  if failed(target) || target.depth != 0 || target.keyed { return target.buffer.data[..0] }
  return format.bytes(&target.buffer)
}

// Separator before a value: a comma between array elements; inside an
// object the value must follow its key.
fn before_value(target: *Writer) bool {
  if failed(target) { return false }
  if target.depth == 0 {
    if target.buffer.length > 0 {
      rejected(target, "a second top-level value")
      return false
    }
    return true
  }
  level := target.depth - 1
  if target.objects[level] {
    if !target.keyed {
      rejected(target, "an object member without its key")
      return false
    }
    target.keyed = false
    return true
  }
  if target.members[level] {
    format.write_byte(&target.buffer, ',')
  }
  target.members[level] = true
  return true
}

fn open(target: *Writer, object: bool, byte: u8) {
  if !before_value(target) { return }
  if target.depth == MaxDepth {
    rejected(target, "nesting deeper than MaxDepth")
    return
  }
  format.write_byte(&target.buffer, byte)
  target.objects[target.depth] = object
  target.members[target.depth] = false
  target.depth += 1
}

fn close(target: *Writer, object: bool, byte: u8) {
  if failed(target) { return }
  if target.depth == 0 || target.objects[target.depth - 1] != object || target.keyed {
    rejected(target, "a close that does not match the open container")
    return
  }
  target.depth -= 1
  format.write_byte(&target.buffer, byte)
}

pub fn object_begin(target: *Writer) {
  open(target, true, '{')
}

pub fn object_end(target: *Writer) {
  close(target, true, '}')
}

pub fn array_begin(target: *Writer) {
  open(target, false, '[')
}

pub fn array_end(target: *Writer) {
  close(target, false, ']')
}

// Nonzero when a byte of word is zero.
fn zero_byte(word: u64) u64 {
  return #wrapping(word - 0x0101010101010101) & ~word & 0x8080808080808080
}

// How many bytes start text before the first that needs escaping (below
// 0x20, '"' or '\\'), eight at a time.
fn clean_prefix(text: []const u8) usize {
  at: usize = 0
  for #len(text) - at >= 8 {
    word := binary.load_u64_le(text[at..at + 8])
    below := #wrapping(word - 0x2020202020202020) & ~word & 0x8080808080808080
    if (below | zero_byte(word ^ 0x2222222222222222) | zero_byte(word ^ 0x5c5c5c5c5c5c5c5c)) != 0 { break }
    at += 8
  }
  for at < #len(text) {
    byte := text[at]
    if byte < 0x20 || byte == '"' || byte == '\\' { break }
    at += 1
  }
  return at
}

fn quoted(target: *Writer, value: []const u8) {
  if !utf8.valid(value) {
    rejected(target, "text is not valid UTF-8")
    return
  }
  digits := "0123456789abcdef"
  format.write_byte(&target.buffer, '"')
  start: usize = 0
  i: usize = 0
  for i < #len(value) {
    i += clean_prefix(value[i..])
    if i == #len(value) { break }
    byte := value[i]
    i += 1
    if byte >= 0x20 && byte != '"' && byte != '\\' { continue }
    format.write(&target.buffer, value[start..i - 1])
    start = i
    if byte == '"' {
      format.write(&target.buffer, "\\\"")
    } else if byte == '\\' {
      format.write(&target.buffer, "\\\\")
    } else if byte == '\n' {
      format.write(&target.buffer, "\\n")
    } else if byte == '\r' {
      format.write(&target.buffer, "\\r")
    } else if byte == '\t' {
      format.write(&target.buffer, "\\t")
    } else {
      format.write(&target.buffer, "\\u00")
      format.write_byte(&target.buffer, digits[byte >> 4])
      format.write_byte(&target.buffer, digits[byte & 15])
    }
  }
  format.write(&target.buffer, value[start..])
  format.write_byte(&target.buffer, '"')
}

// The next object member's name.
pub fn key(target: *Writer, name: []const u8) {
  if failed(target) { return }
  if target.depth == 0 || !target.objects[target.depth - 1] || target.keyed {
    rejected(target, "a key outside an object, or two keys in a row")
    return
  }
  level := target.depth - 1
  if target.members[level] {
    format.write_byte(&target.buffer, ',')
  }
  target.members[level] = true
  quoted(target, name)
  format.write_byte(&target.buffer, ':')
  target.keyed = true
}

pub fn text(target: *Writer, value: []const u8) {
  if before_value(target) {
    quoted(target, value)
  }
}

pub fn integer(target: *Writer, value: i64) {
  if before_value(target) {
    format.write_i64(&target.buffer, value)
  }
}

pub fn unsigned(target: *Writer, value: u64) {
  if before_value(target) {
    format.write_u64(&target.buffer, value)
  }
}

// Shortest round-trip form. NaN and infinities have no JSON form and fail.
pub fn float(target: *Writer, value: f64) {
  if value != value || value - value != 0.0 {
    rejected(target, "NaN and infinities have no JSON form")
    return
  }
  if before_value(target) {
    format.write_f64_shortest(&target.buffer, value)
  }
}

pub fn boolean(target: *Writer, value: bool) {
  if before_value(target) {
    format.write_bool(&target.buffer, value)
  }
}

pub fn null(target: *Writer) {
  if before_value(target) {
    format.write(&target.buffer, "null")
  }
}

// Already-encoded JSON, written as is: output of another Writer or encode.
// The caller vouches that it is one valid JSON value.
pub fn raw(target: *Writer, encoded: []const u8) {
  if before_value(target) {
    format.write(&target.buffer, encoded)
  }
}

// An object member in one call: key, then value written as text ([]const u8
// or []u8), integer (any width), unsigned, float or bool. Another type fails
// the writer.
pub fn field(target: *Writer, name: []const u8, value: any) {
  key(target, name)
  case value {
    []const u8 v => { text(target, v) }
    []u8 v => { text(target, v) }
    i64 v => { integer(target, v) }
    i32 v => { integer(target, v) }
    i16 v => { integer(target, v) }
    i8 v => { integer(target, v) }
    isize v => { integer(target, v) }
    u64 v => { unsigned(target, v) }
    u32 v => { unsigned(target, v) }
    u16 v => { unsigned(target, v) }
    u8 v => { unsigned(target, v) }
    usize v => { unsigned(target, v) }
    f64 v => { float(target, v) }
    f32 v => { float(target, v) }
    bool v => { boolean(target, v) }
    _ => { rejected(target, "a value of a type JSON cannot hold") }
  }
}

// Writes the struct value as a JSON object: each field by name, in
// declaration order. Fields may be integers, floats, bool or text
// ([]const u8, []u8); any other field type fails the writer (write nested
// values with key and their own object_of).
pub fn object_of(target: *Writer, value: $T) {
  object_at(target, &value)
}

// Writes the structs in values as a JSON array of objects (see object_of).
pub fn array_of(target: *Writer, values: []const $T) {
  array_begin(target)
  for i in 0..#len(values) {
    object_at(target, &values[i])
  }
  array_end(target)
}

fn object_at(target: *Writer, value: *const $T) {
  #assert(#typeof(T).kind == TypeKind.Struct, "json.object_of: value must be a struct")
  info := #typeof(T)
  base := #cast(usize, value)
  object_begin(target)
  for member in info.fields {
    key(target, member.name)
    write_member(target, base + #cast(usize, member.value), member.type_id)
  }
  object_end(target)
}

fn write_member(target: *Writer, at: usize, type_id: u64) {
  if type_id == #typeof(i64).id {
    integer(target, #cast(*const i64, at).*)
  } else if type_id == #typeof([]const u8).id || type_id == #typeof([]u8).id {
    text(target, #cast(*const []const u8, at).*)
  } else if type_id == #typeof(bool).id {
    boolean(target, #cast(*const bool, at).*)
  } else if type_id == #typeof(i32).id {
    integer(target, #cast(*const i32, at).*)
  } else if type_id == #typeof(u64).id {
    unsigned(target, #cast(*const u64, at).*)
  } else if type_id == #typeof(u32).id {
    unsigned(target, #cast(*const u32, at).*)
  } else if type_id == #typeof(usize).id {
    unsigned(target, #cast(*const usize, at).*)
  } else if type_id == #typeof(isize).id {
    integer(target, #cast(*const isize, at).*)
  } else if type_id == #typeof(i16).id {
    integer(target, #cast(*const i16, at).*)
  } else if type_id == #typeof(u16).id {
    unsigned(target, #cast(*const u16, at).*)
  } else if type_id == #typeof(i8).id {
    integer(target, #cast(*const i8, at).*)
  } else if type_id == #typeof(u8).id {
    unsigned(target, #cast(*const u8, at).*)
  } else if type_id == #typeof(f64).id {
    float(target, #cast(*const f64, at).*)
  } else if type_id == #typeof(f32).id {
    float(target, #cast(*const f32, at).*)
  } else {
    rejected(target, "a value of a type JSON cannot hold")
  }
}
