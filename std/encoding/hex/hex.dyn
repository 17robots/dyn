use "std/parse" parse
use "std/mem" mem
use "std/fail"
use "std/bytes" bytes
// A pass over the input: the bytes written, the exact size needed, or failed.
struct Result { data: []u8, required: usize, failed: bool }

// Source and destination must not overlap. All failures leave destination unchanged.

const Lower: []const u8 = "0123456789abcdef"
const Upper: []const u8 = "0123456789ABCDEF"

fn encoded_size(source_size: usize) usize {
  maximum := #max(usize)
  if source_size > maximum / 2 { return 0 }
  return source_size * 2
}

fn encode_into(destination: []u8, source: []const u8, uppercase: bool) Result {
  required := encoded_size(#len(source))
  if #len(source) != 0 && required == 0 { return Result{ failed: true } }
  if required > #len(destination) { return Result{ failed: true, required: required } }
  if bytes.overlaps(destination[..required], source) {
    return Result{ failed: true, required: required }
  }
  alphabet := Lower
  if uppercase {
    alphabet = Upper
  }
  for i in 0..#len(source) {
    destination[i * 2] = alphabet[(source[i] >> 4)]
    destination[i * 2 + 1] = alphabet[(source[i] & 15)]
  }
  return Result{ data: destination[..required], required: required }
}

fn digit_value(byte: u8) isize {
  if byte >= '0' && byte <= '9' { return (byte - '0') }
  if byte >= 'a' && byte <= 'f' { return #cast(isize, (byte - 'a')) + 10 }
  if byte >= 'A' && byte <= 'F' { return #cast(isize, (byte - 'A')) + 10 }
  return -1
}

fn decode_pass(destination: []u8, source: []const u8, write: bool, offset: *usize) Result {
  offset.* = #len(source)
  if #len(source) % 2 != 0 || (write && #len(source) / 2 > #len(destination)) {
    return Result{ data: destination[..0], failed: true }
  }
  i: usize = 0
  for i < #len(source) / 2 {
    high := digit_value(source[i * 2])
    low := digit_value(source[i * 2 + 1])
    if high < 0 || low < 0 {
      offset.* = i * 2
      if high >= 0 {
        offset.* += 1
      }
      return Result{ data: destination[..0], failed: true }
    }
    if write {
      destination[i] = #cast(u8, (high * 16 + low))
    }
    i += 1
  }
  return Result{ data: destination[..0], required: #len(source) / 2 }
}


fn decode_into(destination: []u8, source: []const u8) Result {
  offset: usize = 0
  measured := decode_pass(destination[..0], source, false, &offset)
  if measured.failed { return measured }
  if measured.required > #len(destination) {
    return Result{ failed: true, required: measured.required }
  }
  if bytes.overlaps(destination[..measured.required], source) {
    return Result{ failed: true, required: measured.required }
  }
  _ = decode_pass(destination, source, true, &offset)
  return Result{ data: destination[..measured.required], required: measured.required }
}

struct Size { value: usize, ok: bool, offset: usize }

// Validates the complete input and reports the exact decoded byte count.
// ok with value zero is a valid empty encoding.
fn decoded_size(source: []const u8) Size {
  empty: [0]u8
  offset: usize = 0
  measured := decode_pass(empty[..], source, false, &offset)
  return Size{ value: measured.required, ok: !measured.failed, offset: offset }
}


// Encodes source into arena. Size overflow or overlapping input/output panics.
pub fn encode(arena: *mem.Arena, source: []const u8, uppercase: bool) []u8 {
  required := encoded_size(#len(source))
  if #len(source) != 0 && required == 0 {
    #panic("hex.encode: size overflows")
  }
  output := mem.push_bytes_uninit(arena, required)
  result := encode_into(output, source, uppercase)
  if result.failed {
    #panic("hex.encode: invalid source/output overlap")
  }
  return output
}

// Decodes validated input into arena. Failures preserve the arena and source:
// malformed input fails with InvalidInput at an offending byte, or at the
// end of a truncated group. Arena exhaustion panics.
pub fn decode(arena: *mem.Arena, status: *fail.Status, source: []const u8) []u8 {
  empty: []u8
  if status.failed { return empty }
  size := decoded_size(source)
  if !size.ok {
    parse.malformed(status, "decode hex", "invalid hex", size.offset)
    return empty
  }
  // Check borrowed backing before allocation or rewind can modify aliased input.
  if mem.arena_overlaps_unallocated(arena, source) {
    fail.invalid(status, "decode hex", "", "the input lies in the arena's free space")
    return empty
  }
  output := mem.push_bytes_uninit(arena, size.value)
  _ = decode_into(output, source)
  return output
}
