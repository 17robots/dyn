use "std/mem" mem
use "std/encoding" codec
use "std/bytes" bytes
type Result = codec.Result
type ErrorKind = codec.ErrorKind

// Source and destination must not overlap. All failures leave destination unchanged.

const Lower: []const u8 = "0123456789abcdef"
const Upper: []const u8 = "0123456789ABCDEF"

fn encoded_size(source_size: usize) usize {
  maximum := ~#cast(usize, 0)
  if source_size > maximum / 2 {
    return 0
  }
  return source_size * 2
}

fn encode_into(destination: []u8, source: []const u8, uppercase: bool) Result {
  required := encoded_size(#len(source))
  if #len(source) != 0 && required == 0 {
    return Result{ error: ErrorKind.Overflow }
  }
  if required > #len(destination) {
    return Result{ error: ErrorKind.Capacity, required: required }
  }
  if bytes.overlaps(destination[..required], source) {
    return Result{ error: ErrorKind.Overlap, required: required }
  }
  alphabet := Lower
  if uppercase {
    alphabet = Upper
  }
  for i in 0..#len(source) {
    destination[i * 2] = alphabet[#cast(usize, (source[i] >> 4))]
    destination[i * 2 + 1] = alphabet[#cast(usize, (source[i] & 15))]
  }
  return Result{ data: destination[..required], required: required, ok: true }
}

fn digit_value(byte: u8) isize {
  if byte >= '0' && byte <= '9' {
    return #cast(isize, (byte - '0'))
  }
  if byte >= 'a' && byte <= 'f' {
    return #cast(isize, (byte - 'a')) + 10
  }
  if byte >= 'A' && byte <= 'F' {
    return #cast(isize, (byte - 'A')) + 10
  }
  return -1
}

fn decode_pass(destination: []u8, source: []const u8, write: bool) Result {
  if #len(source) % 2 != 0 || (write && #len(source) / 2 > #len(destination)) {
    return Result{ data: destination[..0], error: ErrorKind.InvalidInput, ok: false }
  }
  i: usize = 0
  for i < #len(source) / 2 {
    high := digit_value(source[i * 2])
    low := digit_value(source[i * 2 + 1])
    if high < 0 || low < 0 {
      return Result{ data: destination[..0], error: ErrorKind.InvalidInput, ok: false }
    }
    if write {
      destination[i] = #cast(u8, (high * 16 + low))
    }
    i += 1
  }
  return Result{ data: destination[..0], required: #len(source) / 2, ok: true }
}


fn decode_into(destination: []u8, source: []const u8) Result {
  measured := decode_pass(destination[..0], source, false)
  if !measured.ok {
    return measured
  }
  if measured.required > #len(destination) {
    return Result{ error: ErrorKind.Capacity, required: measured.required }
  }
  if bytes.overlaps(destination[..measured.required], source) {
    return Result{ error: ErrorKind.Overlap, required: measured.required }
  }
  _ = decode_pass(destination, source, true)
  return Result{ data: destination[..measured.required], required: measured.required, ok: true }
}

struct Size { value: usize, ok: bool }

// Validates the complete input and reports the exact decoded byte count.
// ok with value zero is a valid empty encoding.
fn decoded_size(source: []const u8) Size {
  empty: [0]u8 = []
  measured := decode_pass(empty[..], source, false)
  return Size{ value: measured.required, ok: measured.ok }
}

pub struct Decoded { value: []u8, ok: bool }

// Encodes source into arena. Panics when the size overflows.
pub fn encode(arena: *mem.Arena, source: []const u8, uppercase: bool) []u8 {
  required := encoded_size(#len(source))
  if #len(source) != 0 && required == 0 {
    #panic("hex.encode: size overflows")
  }
  output := mem.push_bytes_uninit(arena, required)
  _ = encode_into(output, source, uppercase)
  return output
}

// Decodes source into arena. ok is false, with nothing pushed, when source is
// not valid hex.
pub fn decode(arena: *mem.Arena, source: []const u8) Decoded {
  size := decoded_size(source)
  if !size.ok {
    return Decoded{}
  }
  output := mem.push_bytes_uninit(arena, size.value)
  _ = decode_into(output, source)
  return Decoded{ value: output, ok: true }
}
