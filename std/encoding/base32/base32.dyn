use "std/mem" mem
use "std/fail"
use "std/bytes" bytes
// A pass over the input: the bytes written, the exact size needed, or failed.
struct Result { data: []u8, required: usize, failed: bool }

// Source and destination must not overlap. All failures leave destination unchanged.

fn symbol(value: u8) u8 {
  if value < 26 { return 'A' + value }
  return '2' + value - 26
}

fn decode_symbol(byte: u8) u8 {
  if byte >= 'A' && byte <= 'Z' { return byte - 'A' }
  if byte >= 'a' && byte <= 'z' { return byte - 'a' }
  if byte >= '2' && byte <= '7' { return byte - '2' + 26 }
  return 255
}

fn encoded_size(length: usize) usize {
  maximum := #cast(usize, -1)
  if length > maximum - 4 || (length + 4) / 5 > maximum / 8 { return 0 }
  return ((length + 4) / 5) * 8
}

fn encode_into(destination: []u8, source: []const u8) Result {
  required := encoded_size(#len(source))
  if #len(source) != 0 && required == 0 { return Result{ failed: true } }
  if #len(destination) < required { return Result{ failed: true, required: required } }
  if bytes.overlaps(destination[..required], source) {
    return Result{ failed: true, required: required }
  }
  input_at: usize = 0
  output_at: usize = 0
  for input_at < #len(source) {
    remaining := #len(source) - input_at
    take := remaining
    if take > 5 {
      take = 5
    }
    block: u64 = 0
    for block_at in 0..take {
      block = (block << 8) | source[input_at + block_at]
    }
    block = block << ((5 - take) * 8)
    symbols := (take * 8 + 4) / 5
    for digit in 0..8 {
      if digit < symbols {
        destination[output_at] = symbol(((block >> (35 - digit * 5)) & 31))
      } else {
        destination[output_at] = '='
      }
      output_at += 1
    }
    input_at += take
  }
  return Result{ data: destination[..required], required: required }
}

fn decoded_extent(source: []const u8) usize {
  if #len(source) == 0 { return 0 }
  padding: usize = 0
  at := #len(source)
  for at > 0 && source[at - 1] == '=' {
    padding += 1
    at -= 1
  }
  if #len(source) % 8 != 0 || padding > 6 { return 0 }
  return (#len(source) / 8) * 5 - (padding * 5 + 7) / 8
}

fn decode_pass(destination: []u8, source: []const u8, write: bool, offset: *usize) Result {
  offset.* = #len(source)
  if #len(source) == 0 { return Result{ data: destination[..0] } }
  if #len(source) % 8 != 0 { return Result{ data: destination[..0], failed: true } }
  required := decoded_extent(source)
  if write && #len(destination) < required { return Result{ data: destination[..0], failed: true } }
  output_at: usize = 0
  input_at: usize = 0
  for input_at < #len(source) {
    block: u64 = 0
    symbols: usize = 0
    digit: usize = 0
    padding_started := false
    for digit < 8 {
      byte := source[input_at + digit]
      if byte == '=' {
        padding_started = true
        block = block << 5
      } else {
        decoded := decode_symbol(byte)
        if decoded == 255 || padding_started {
          offset.* = input_at + digit
          return Result{ data: destination[..0], failed: true }
        }
        block = (block << 5) | decoded
        symbols += 1
      }
      digit += 1
    }
    bytes_value := (symbols * 5) / 8
    if symbols != 8 && symbols != 7 && symbols != 5 && symbols != 4 && symbols != 2 {
      offset.* = input_at + symbols
      return Result{ data: destination[..0], failed: true }
    }
    if symbols != 8 && input_at + 8 != #len(source) {
      offset.* = input_at + symbols
      return Result{ failed: true }
    }
    unused := symbols * 5 - bytes_value * 8
    if unused > 0 && ((block >> ((8 - symbols) * 5)) & ((#cast(u64, 1) << unused) - 1)) != 0 {
      offset.* = input_at + symbols - 1
      return Result{ data: destination[..0], failed: true }
    }
    for byte_at in 0..bytes_value {
      if write {
        destination[output_at] = ((block >> (32 - byte_at * 8)) & 255)
      }
      output_at += 1
    }
    input_at += 8
  }
  return Result{ data: destination[..0], required: output_at }
}


fn decode_into(destination: []u8, source: []const u8) Result {
  offset: usize = 0
  measured := decode_pass(destination[..0], source, false, &offset)
  if measured.failed { return measured }
  if measured.required > #len(destination) {
    return Result{ failed: true, required: measured.required }
  }
  if bytes.overlaps(destination[..measured.required], source) {
    return Result{ failed: true, required: measured.required }
  }
  _ = decode_pass(destination, source, true, &offset)
  return Result{ data: destination[..measured.required], required: measured.required }
}

struct Size { value: usize, ok: bool, offset: usize }

// Validates the complete input and reports the exact decoded byte count.
// ok with value zero is a valid empty encoding.
fn decoded_size(source: []const u8) Size {
  empty: [0]u8
  offset: usize = 0
  measured := decode_pass(empty[..], source, false, &offset)
  return Size{ value: measured.required, ok: !measured.failed, offset: offset }
}


// Encodes source into arena. Size overflow or overlapping input/output panics.
pub fn encode(arena: *mem.Arena, source: []const u8) []u8 {
  required := encoded_size(#len(source))
  if #len(source) != 0 && required == 0 {
    #panic("base32.encode: size overflows")
  }
  output := mem.push_bytes_uninit(arena, required)
  result := encode_into(output, source)
  if result.failed {
    #panic("base32.encode: invalid source/output overlap")
  }
  return output
}

// Decodes validated input into arena. Failures preserve the arena and source:
// malformed input fails with InvalidInput at an offending byte, or at the
// end of a truncated group. Arena exhaustion panics.
pub fn decode(arena: *mem.Arena, status: *fail.Status, source: []const u8) []u8 {
  empty: []u8
  if status.failed { return empty }
  size := decoded_size(source)
  if !size.ok {
    fail.at(status, fail.Kind.InvalidInput, "decode base32", "invalid base32", size.offset)
    return empty
  }
  // Check borrowed backing before allocation or rewind can modify aliased input.
  if mem.arena_overlaps_unallocated(arena, source) {
    fail.invalid(status, "decode base32", "", "the input lies in the arena's free space")
    return empty
  }
  output := mem.push_bytes_uninit(arena, size.value)
  _ = decode_into(output, source)
  return output
}
