pub struct Result { data: []u8, ok: bool }

fn symbol(value: u8) u8 {
  if value < 26 { return 'A' + value }
  return '2' + value - 26
}

fn decode_symbol(byte: u8) u8 {
  if byte >= 'A' && byte <= 'Z' { return byte - 'A' }
  if byte >= 'a' && byte <= 'z' { return byte - 'a' }
  if byte >= '2' && byte <= '7' { return byte - '2' + 26 }
  return 255
}

pub fn encoded_length(length: usize) usize { return ((length + 4) / 5) * 8 }

pub fn encode(destination: []u8, source: []const u8) Result {
  required := encoded_length(#len(source))
  if #len(destination) < required { return Result{ data: destination[..0], ok: false } }
  input_at: usize = 0
  output_at: usize = 0
  for input_at < #len(source) {
    remaining := #len(source) - input_at
    take := remaining
    if take > 5 { take = 5 }
    block: u64 = 0
    block_at: usize = 0
    for block_at < take { block = (block << 8) | #cast(u64) source[input_at + block_at] block_at += 1 }
    block = block << ((5 - take) * 8)
    symbols := (take * 8 + 4) / 5
    digit: usize = 0
    for digit < 8 {
      if digit < symbols { destination[output_at] = symbol(#cast(u8) ((block >> (35 - digit * 5)) & 31)) }
      else { destination[output_at] = '=' }
      output_at += 1 digit += 1
    }
    input_at += take
  }
  return Result{ data: destination[..required], ok: true }
}

pub fn decoded_length(source: []const u8) usize {
  if #len(source) == 0 { return 0 }
  padding: usize = 0
  at := #len(source)
  for at > 0 && source[at - 1] == '=' { padding += 1 at -= 1 }
  return (#len(source) * 5) / 8 - (padding * 5) / 8
}

pub fn decode(destination: []u8, source: []const u8) Result {
  if #len(source) == 0 { return Result{ data: destination[..0], ok: true } }
  if #len(source) % 8 != 0 { return Result{ data: destination[..0], ok: false } }
  required := decoded_length(source)
  if #len(destination) < required { return Result{ data: destination[..0], ok: false } }
  output_at: usize = 0
  input_at: usize = 0
  for input_at < #len(source) {
    block: u64 = 0
    symbols: usize = 0
    digit: usize = 0
    padding_started := false
    for digit < 8 {
      byte := source[input_at + digit]
      if byte == '=' { padding_started = true block = block << 5 }
      else {
        decoded := decode_symbol(byte)
        if decoded == 255 || padding_started { return Result{ data: destination[..0], ok: false } }
        block = (block << 5) | #cast(u64) decoded symbols += 1
      }
      digit += 1
    }
    bytes := (symbols * 5) / 8
    if symbols != 8 && symbols != 7 && symbols != 5 && symbols != 4 && symbols != 2 { return Result{ data: destination[..0], ok: false } }
    unused := symbols * 5 - bytes * 8
    if unused > 0 && ((block >> ((8 - symbols) * 5)) & ((#cast(u64) 1 << unused) - 1)) != 0 { return Result{ data: destination[..0], ok: false } }
    byte_at: usize = 0
    for byte_at < bytes {
      destination[output_at] = #cast(u8) ((block >> (32 - byte_at * 8)) & 255)
      output_at += 1 byte_at += 1
    }
    input_at += 8
  }
  return Result{ data: destination[..output_at], ok: true }
}
