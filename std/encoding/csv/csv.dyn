// RFC 4180-style, allocation-free field scanner and streaming writer.
// Malformed text fails with InvalidInput (at its offset, for a scanner over
// bytes), a field larger than destination with Capacity. A scanner's ended
// turns true when next returns no field, at the end of the input or after a
// failure; that field's text is empty.
use stream "std/io"
use "std/fail"
pub struct Scanner { source: []const u8, offset: usize, finished: bool, ended: bool }
pub struct StreamScanner { input: stream.Reader, lookahead: u8, has_lookahead: bool, record_ended: bool, input_done: bool, finished: bool, ended: bool }
pub struct Field { text: []u8, end_record: bool, end_input: bool }
struct ByteResult { value: u8, end: bool, ok: bool }
pub struct Writer { sink: stream.Writer, fields: usize }

pub fn scanner(source: []const u8) Scanner {
  return Scanner{ source: source }
}
pub fn stream_scanner(input: stream.Reader) StreamScanner {
  return StreamScanner{ input: input }
}

fn stream_byte(status: *fail.Status, state: *StreamScanner) ByteResult {
  if state.has_lookahead {
    state.has_lookahead = false
    return ByteResult{ value: state.lookahead, ok: true }
  }
  if state.input_done { return ByteResult{ end: true, ok: true } }
  byte: [1]u8
  count := stream.read_status(status, state.input, byte[..])
  if status.failed {
    state.finished = true
    return ByteResult{}
  }
  state.input_done = count == 0
  if count == 0 { return ByteResult{ end: true, ok: true } }
  return ByteResult{ value: byte[0], ok: true }
}

fn stream_unread(state: *StreamScanner, value: u8) {
  state.lookahead = value
  state.has_lookahead = true
}

fn stream_fail(status: *fail.Status, state: *StreamScanner, kind: fail.Kind) Field {
  message: []const u8 = "malformed CSV"
  if kind == fail.Kind.Capacity {
    message = "the field does not fit destination"
  }
  fail.set(status, fail.make(kind, "read CSV", "", message))
  return stream_end(state)
}

fn stream_end(state: *StreamScanner) Field {
  state.finished = true
  state.ended = true
  return Field{}
}

// Reads one field from an arbitrarily chunked input stream.
pub fn next_stream(status: *fail.Status, state: *StreamScanner, destination: []u8) Field {
  if status == nil { return next_stream(&fail.Status{}, state, destination) }
  if status.failed || state.finished { return stream_end(state) }
  first := stream_byte(status, state)
  if !first.ok { return stream_end(state) }
  if first.end {
    if state.record_ended { return stream_end(state) }
    state.finished = true
    return Field{ text: destination[..0], end_record: true, end_input: true }
  }
  quoted := first.value == '"'
  if !quoted {
    stream_unread(state, first.value)
  }
  used: usize = 0
  closed := !quoted
  delimiter: u8 = 0
  input_ended := false
  for true {
    item := stream_byte(status, state)
    if !item.ok { return stream_end(state) }
    if item.end {
      input_ended = true
      break
    }
    byte := item.value
    if quoted {
      if byte == '"' {
        after := stream_byte(status, state)
        if !after.ok { return stream_end(state) }
        if after.end {
          closed = true
          input_ended = true
          break
        }
        if after.value == '"' {
          byte = '"'
        } else {
          closed = true
          delimiter = after.value
          break
        }
      }
    } else if byte == '"' {
      return stream_fail(status, state, fail.Kind.InvalidInput)
    } else if byte == ',' || byte == '\r' || byte == '\n' {
      delimiter = byte
      break
    }
    if used == destination.len { return stream_fail(status, state, fail.Kind.Capacity) }
    destination[used] = byte
    used += 1
  }
  if !closed { return stream_fail(status, state, fail.Kind.InvalidInput) }
  if quoted && !input_ended && delimiter != ',' && delimiter != '\r' && delimiter != '\n' {
    return stream_fail(status, state, fail.Kind.InvalidInput)
  }
  end_record := input_ended || delimiter == '\r' || delimiter == '\n'
  if delimiter == '\r' {
    after_cr := stream_byte(status, state)
    if !after_cr.ok { return stream_end(state) }
    if after_cr.end {
      input_ended = true
    } else if after_cr.value != '\n' {
      stream_unread(state, after_cr.value)
    }
  }
  state.record_ended = delimiter != ','
  if input_ended {
    state.finished = true
  }
  return Field{ text: destination[..used], end_record: end_record, end_input: state.finished }
}

pub fn writer(destination_writer: stream.Writer) Writer {
  return Writer{ sink: destination_writer }
}

fn write_all(status: *fail.Status, state: *Writer, bytes: []const u8) bool {
  stream.write_status(status, state.sink, bytes)
  return !status.failed
}

// Writes one field. `end_record` emits CRLF; otherwise the next field is comma-separated.
pub fn write_field(status: *fail.Status, state: *Writer, value: []const u8, end_record: bool) {
  if status == nil {
    write_field(&fail.Status{}, state, value, end_record)
    return
  }
  if status.failed { return }
  if state.fields > 0 && !write_all(status, state, ",") { return }
  quoted := false
  for byte in value {
    if byte == ',' || byte == '"' || byte == '\r' || byte == '\n' {
      quoted = true
      break
    }
  }
  if quoted && !write_all(status, state, "\"") { return }
  start: usize = 0
  for i in 0..value.len {
    if value[i] == '"' {
      if i > start && !write_all(status, state, value[start..i]) { return }
      if !write_all(status, state, "\"\"") { return }
      start = i + 1
    }
  }
  if start < value.len && !write_all(status, state, value[start..]) { return }
  if quoted && !write_all(status, state, "\"") { return }
  state.fields += 1
  if end_record {
    if !write_all(status, state, "\r\n") { return }
    state.fields = 0
  }
}

fn fail_at(status: *fail.Status, state: *Scanner, destination: []u8, kind: fail.Kind) Field {
  message: []const u8 = "malformed CSV"
  if kind == fail.Kind.Capacity {
    message = "the field does not fit destination"
  }
  fail.at(status, kind, "read CSV", message, state.offset)
  state.finished = true
  state.ended = true
  return Field{ text: destination[..0] }
}

pub fn next(status: *fail.Status, state: *Scanner, destination: []u8) Field {
  if status == nil { return next(&fail.Status{}, state, destination) }
  if status.failed || state.finished {
    state.ended = true
    return Field{ text: destination[..0] }
  }
  at := state.offset
  output_at: usize = 0
  quoted := at < state.source.len && state.source[at] == '"'
  if quoted {
    at += 1
  }
  closed := !quoted
  for at < state.source.len {
    byte := state.source[at]
    if quoted {
      if byte == '"' {
        if at + 1 < state.source.len && state.source[at + 1] == '"' {
          if output_at == destination.len { return fail_at(status, state, destination, fail.Kind.Capacity) }
          destination[output_at] = '"'
          output_at += 1
          at += 2
        } else {
          closed = true
          at += 1
          break
        }
      } else {
        if output_at == destination.len { return fail_at(status, state, destination, fail.Kind.Capacity) }
        destination[output_at] = byte
        output_at += 1
        at += 1
      }
    } else {
      if byte == ',' || byte == '\n' || byte == '\r' { break }
      if byte == '"' { return fail_at(status, state, destination, fail.Kind.InvalidInput) }
      if output_at == destination.len { return fail_at(status, state, destination, fail.Kind.Capacity) }
      destination[output_at] = byte
      output_at += 1
      at += 1
    }
  }
  if !closed { return fail_at(status, state, destination, fail.Kind.InvalidInput) }
  if quoted && at < state.source.len && state.source[at] != ',' && state.source[at] != '\n' && state.source[at] != '\r' {
    return fail_at(status, state, destination, fail.Kind.InvalidInput)
  }
  end_record := false
  if at == state.source.len {
    state.finished = true
    end_record = true
  } else if state.source[at] == ',' {
    at += 1
  } else {
    end_record = true
    if state.source[at] == '\r' {
      at += 1
      if at < state.source.len && state.source[at] == '\n' {
        at += 1
      }
    } else {
      at += 1
    }
    if at == state.source.len {
      state.finished = true
    }
  }
  state.offset = at
  return Field{ text: destination[..output_at], end_record: end_record, end_input: state.finished }
}
