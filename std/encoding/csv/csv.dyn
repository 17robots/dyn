// RFC 4180-style, allocation-free field scanner and streaming writer.
// Over bytes, malformed text fails with Invalid and a field larger than
// destination with TooLarge, at its offset. Over a stream they fail with
// InvalidInput and Capacity, and the reader's own failures pass through. A
// scanner's ended turns true when next returns no field, at the end of the
// input or after a failure; that field's text is empty.
use stream "std/io"
use parse "std/parse"
pub struct Scanner { source: []const u8, offset: usize, finished: bool, ended: bool }
pub struct StreamScanner { input: stream.Reader, lookahead: u8, has_lookahead: bool, record_ended: bool, input_done: bool, finished: bool, ended: bool }
pub struct Field { text: []u8, end_record: bool, end_input: bool }
struct ByteResult { value: u8, end: bool }
pub struct Writer { sink: stream.Writer, fields: usize }

pub fn scanner(source: []const u8) Scanner {
  return Scanner{ source: source }
}
pub fn stream_scanner(input: stream.Reader) StreamScanner {
  return StreamScanner{ input: input }
}

fn stream_byte(state: *StreamScanner) ByteResult!stream.IoErr {
  if state.has_lookahead {
    state.has_lookahead = false
    return ByteResult{ value: state.lookahead }
  }
  if state.input_done { return ByteResult{ end: true } }
  byte: [1]u8
  count := stream.read(state.input, byte[..]) catch err {
    stream_end(state)
    fail err
  }
  state.input_done = count == 0
  if count == 0 { return ByteResult{ end: true } }
  return ByteResult{ value: byte[0] }
}

fn stream_unread(state: *StreamScanner, value: u8) {
  state.lookahead = value
  state.has_lookahead = true
}

// Ends the scanner and returns err for the caller to fail with.
fn stream_fail(state: *StreamScanner, err: stream.IoErr) stream.IoErr {
  stream_end(state)
  return err
}

fn stream_end(state: *StreamScanner) {
  state.finished = true
  state.ended = true
}

// Reads one field from an arbitrarily chunked input stream.
pub fn next_stream(state: *StreamScanner, destination: []u8) Field!stream.IoErr {
  if state.finished {
    stream_end(state)
    return Field{}
  }
  first := try stream_byte(state)
  if first.end {
    if state.record_ended {
      stream_end(state)
      return Field{}
    }
    state.finished = true
    return Field{ text: destination[..0], end_record: true, end_input: true }
  }
  quoted := first.value == '"'
  if !quoted {
    stream_unread(state, first.value)
  }
  used: usize = 0
  closed := !quoted
  delimiter: u8 = 0
  input_ended := false
  for true {
    item := try stream_byte(state)
    if item.end {
      input_ended = true
      break
    }
    byte := item.value
    if quoted {
      if byte == '"' {
        after := try stream_byte(state)
        if after.end {
          closed = true
          input_ended = true
          break
        }
        if after.value == '"' {
          byte = '"'
        } else {
          closed = true
          delimiter = after.value
          break
        }
      }
    } else if byte == '"' {
      fail stream_fail(state, stream.IoErr.InvalidInput)
    } else if byte == ',' || byte == '\r' || byte == '\n' {
      delimiter = byte
      break
    }
    if used == destination.len { fail stream_fail(state, stream.IoErr.Capacity) }
    destination[used] = byte
    used += 1
  }
  if !closed { fail stream_fail(state, stream.IoErr.InvalidInput) }
  if quoted && !input_ended && delimiter != ',' && delimiter != '\r' && delimiter != '\n' {
    fail stream_fail(state, stream.IoErr.InvalidInput)
  }
  end_record := input_ended || delimiter == '\r' || delimiter == '\n'
  if delimiter == '\r' {
    after_cr := try stream_byte(state)
    if after_cr.end {
      input_ended = true
    } else if after_cr.value != '\n' {
      stream_unread(state, after_cr.value)
    }
  }
  state.record_ended = delimiter != ','
  if input_ended {
    state.finished = true
  }
  return Field{ text: destination[..used], end_record: end_record, end_input: state.finished }
}

pub fn writer(destination_writer: stream.Writer) Writer {
  return Writer{ sink: destination_writer }
}

// Writes one field. `end_record` emits CRLF; otherwise the next field is comma-separated.
pub fn write_field(state: *Writer, value: []const u8, end_record: bool) !stream.IoErr {
  if state.fields > 0 { try stream.write(state.sink, ",") }
  quoted := false
  for byte in value {
    if byte == ',' || byte == '"' || byte == '\r' || byte == '\n' {
      quoted = true
      break
    }
  }
  if quoted { try stream.write(state.sink, "\"") }
  start: usize = 0
  for i in 0..value.len {
    if value[i] == '"' {
      if i > start { try stream.write(state.sink, value[start..i]) }
      try stream.write(state.sink, "\"\"")
      start = i + 1
    }
  }
  if start < value.len { try stream.write(state.sink, value[start..]) }
  if quoted { try stream.write(state.sink, "\"") }
  state.fields += 1
  if end_record {
    try stream.write(state.sink, "\r\n")
    state.fields = 0
  }
}

// Ends the scanner and returns the failure at its offset.
fn fail_at(state: *Scanner, too_large: bool) parse.ParseErr {
  state.finished = true
  state.ended = true
  if too_large { return parse.ParseErr.TooLarge(state.offset) }
  return parse.ParseErr.Invalid(state.offset)
}

pub fn next(state: *Scanner, destination: []u8) Field!parse.ParseErr {
  if state.finished {
    state.ended = true
    return Field{ text: destination[..0] }
  }
  at := state.offset
  output_at: usize = 0
  quoted := at < state.source.len && state.source[at] == '"'
  if quoted {
    at += 1
  }
  closed := !quoted
  for at < state.source.len {
    byte := state.source[at]
    if quoted {
      if byte == '"' {
        if at + 1 < state.source.len && state.source[at + 1] == '"' {
          if output_at == destination.len { fail fail_at(state, true) }
          destination[output_at] = '"'
          output_at += 1
          at += 2
        } else {
          closed = true
          at += 1
          break
        }
      } else {
        if output_at == destination.len { fail fail_at(state, true) }
        destination[output_at] = byte
        output_at += 1
        at += 1
      }
    } else {
      if byte == ',' || byte == '\n' || byte == '\r' { break }
      if byte == '"' { fail fail_at(state, false) }
      if output_at == destination.len { fail fail_at(state, true) }
      destination[output_at] = byte
      output_at += 1
      at += 1
    }
  }
  if !closed { fail fail_at(state, false) }
  if quoted && at < state.source.len && state.source[at] != ',' && state.source[at] != '\n' && state.source[at] != '\r' {
    fail fail_at(state, false)
  }
  end_record := false
  if at == state.source.len {
    state.finished = true
    end_record = true
  } else if state.source[at] == ',' {
    at += 1
  } else {
    end_record = true
    if state.source[at] == '\r' {
      at += 1
      if at < state.source.len && state.source[at] == '\n' {
        at += 1
      }
    } else {
      at += 1
    }
    if at == state.source.len {
      state.finished = true
    }
  }
  state.offset = at
  return Field{ text: destination[..output_at], end_record: end_record, end_input: state.finished }
}
