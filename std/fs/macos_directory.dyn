use io "std/io"
use mem "std/mem"
use "std/os/macos/sys"
#target(kernel: darwin)

// Directory listing through getdirentries64. Entry kinds come from d_type,
// translated by entry_kind.
struct DirectoryState { file: File, offset: usize, used: usize, base: i64 }

fn native_open_directory(path: []const u8, storage: []u8, directory: *Directory) isize {
  if storage.len < 1048 { return -22 }
  space: [4096]u8
  name := terminated(path, space[..])
  if name == nil { return -63 }
  // O_RDONLY | O_DIRECTORY | O_CLOEXEC.
  descriptor := #syscall(sys.Open, name, 17825792, 0)
  if descriptor < 0 { return descriptor }
  directory.* = Directory{ storage: storage, state: DirectoryState{ file: owned_file(descriptor) } }
  return 0
}

// Entry name borrows directory storage until the next call.
fn native_directory_next(directory: *Directory, entry: *DirectoryEntry) isize {
  state := &directory.state
  if !is_open(&state.file) { return -9 }
  for true {
    if state.offset >= state.used {
      value := #syscall(sys.Getdirentries64, state.file.descriptor, &directory.storage[0], directory.storage.len, &state.base)
      for value == -4 {
        value = #syscall(sys.Getdirentries64, state.file.descriptor, &directory.storage[0], directory.storage.len, &state.base)
      }
      if value < 0 { return value }
      if value == 0 { return 0 }
      state.offset = 0
      state.used = #cast(usize, value)
    }
    at := state.offset
    if at + 21 > state.used { return -5 }
    record := #cast(usize, directory.storage[at + 16]) | #cast(usize, directory.storage[at + 17]) << 8
    length := #cast(usize, directory.storage[at + 18]) | #cast(usize, directory.storage[at + 19]) << 8
    if record < 21 || at + record > state.used || 21 + length > record { return -5 }
    kind := directory.storage[at + 20]
    name := directory.storage[at + 21..at + 21 + length]
    state.offset += record
    dot := name.len == 1 && name[0] == '.'
    dot_dot := name.len == 2 && name[0] == '.' && name[1] == '.'
    if !dot && !dot_dot {
      entry.* = DirectoryEntry{ name: name, kind: entry_kind(kind) }
      return 0
    }
  }
  return 0
}

fn native_close_directory(directory: *Directory) {
  directory.state.offset = 0
  directory.state.used = 0
  close(&directory.state.file)
}

// struct stat64: dev @0, mode @4, ino @8, mtime @48, ctime @64 (seconds,
// then nanoseconds), size @96.
fn stat_metadata(raw: *const [144]u8) Metadata {
  bytes := raw.*
  read := fn_u64(bytes[..], 8)
  info := Metadata{ size: fn_u64(bytes[..], 96), inode: read, device: fn_u32(bytes[..], 0), mode: #cast(u16, bytes[4]) | #cast(u16, bytes[5]) << 8 }
  info.modified_seconds = #bitcast(i64, fn_u64(bytes[..], 48))
  info.modified_nanoseconds = fn_u32(bytes[..], 56)
  info.changed_seconds = #bitcast(i64, fn_u64(bytes[..], 64))
  info.changed_nanoseconds = fn_u32(bytes[..], 72)
  return info
}

fn fn_u32(bytes: []const u8, at: usize) u32 {
  return #cast(u32, bytes[at]) | #cast(u32, bytes[at + 1]) << 8 | #cast(u32, bytes[at + 2]) << 16 | #cast(u32, bytes[at + 3]) << 24
}

fn fn_u64(bytes: []const u8, at: usize) u64 {
  return #cast(u64, fn_u32(bytes, at)) | #cast(u64, fn_u32(bytes, at + 4)) << 32
}

fn path_metadata(number: u64, path: []const u8, info: *Metadata) isize {
  space: [4096]u8
  name := terminated(path, space[..])
  if name == nil { return -63 }
  raw: [144]u8
  value := #syscall(number, name, &raw[0])
  if value < 0 { return value }
  info.* = stat_metadata(&raw)
  return 0
}
fn native_metadata(path: []const u8, info: *Metadata) isize {
  return path_metadata(sys.Stat64, path, info)
}
fn native_link_metadata(path: []const u8, info: *Metadata) isize {
  return path_metadata(sys.Lstat64, path, info)
}

fn native_file_metadata(file: *const File, info: *Metadata) isize {
  if !is_open(file) { return -9 }
  raw: [144]u8
  value := #syscall(sys.Fstat64, file.descriptor, &raw[0])
  if value < 0 { return value }
  info.* = stat_metadata(&raw)
  return 0
}

fn path_call(number: u64, path: []const u8, argument: usize) isize {
  space: [4096]u8
  name := terminated(path, space[..])
  if name == nil { return -63 }
  return #syscall(number, name, argument)
}

fn native_remove(path: []const u8) isize {
  return path_call(sys.Unlink, path, 0)
}

fn native_make_directory(path: []const u8, mode: usize) isize {
  return path_call(sys.Mkdir, path, mode)
}

fn native_remove_directory(path: []const u8) isize {
  return path_call(sys.Rmdir, path, 0)
}

fn native_rename(old_path: []const u8, new_path: []const u8) isize {
  old_space: [4096]u8
  new_space: [4096]u8
  old_name := terminated(old_path, old_space[..])
  new_name := terminated(new_path, new_space[..])
  if old_name == nil || new_name == nil { return -63 }
  return #syscall(sys.Rename, old_name, new_name)
}
// renameatx_np with RENAME_EXCL; a file system without it (ENOTSUP) gets a
// hard link and an unlink, which fail for directories.
fn native_rename_exclusive(old_path: []const u8, new_path: []const u8) isize {
  old_space: [4096]u8
  new_space: [4096]u8
  old_name := terminated(old_path, old_space[..])
  new_name := terminated(new_path, new_space[..])
  if old_name == nil || new_name == nil { return -63 }
  code := #syscall(sys.RenameatxNp, -2, old_name, -2, new_name, 4)
  if code != -45 { return code }
  linked := #syscall(sys.Link, old_name, new_name)
  if linked == -1 { return -45 }
  if linked < 0 { return linked }
  removed := #syscall(sys.Unlink, old_name)
  if removed < 0 {
    _ = #syscall(sys.Unlink, new_name)
  }
  return removed
}

fn open_path(path: []const u8, flags: usize, mode: usize) isize {
  space: [4096]u8
  name := terminated(path, space[..])
  if name == nil { return -22 }
  return #syscall(sys.Open, name, flags | 16777216, mode)
}
fn native_open_no_follow(path: []const u8) isize {
  // O_RDONLY | O_NOFOLLOW; ELOOP (62) means path is a symbolic link.
  opened := open_path(path, 256, 0)
  if opened == -62 { return -22 }
  return opened
}
// O_WRONLY | O_CREAT | O_EXCL with an owner-only mode.
fn native_create_private(path: []const u8, executable: bool) isize {
  mode: usize = 0o600
  if executable {
    mode = 0o700
  }
  return open_path(path, 2561, mode)
}
fn native_set_permissions(file: *const File, mode: usize) isize {
  return #syscall(sys.Fchmod, file.descriptor, mode)
}
// access(path, X_OK), with the real user and group.
fn native_executable(path: []const u8, _info: Metadata) bool {
  return path_call(sys.Access, path, 1) == 0
}
// No kernel range copy: copy_range writes it all through scratch.
fn native_copy_range(_source: *File, _offset: u64, _destination: *File, _length: u64, _scratch: []u8) u64!io.IoErr {
  return 0
}
// fclonefileat with CLONE_NOFOLLOW | CLONE_NOOWNERCOPY makes a clone with
// source's mode, so only a source already readable and writable by its owner
// is cloned; others, and volumes that cannot clone (ENOTSUP, EXDEV), get a
// new empty file for copy_range.
fn native_clone(source: *const File, path: []const u8, mode: usize, cloned: *bool) isize {
  info: Metadata
  if native_file_metadata(source, &info) == 0 && (#cast(usize, info.mode) & 0o777) == mode {
    space: [4096]u8
    name := terminated(path, space[..])
    if name == nil { return -63 }
    shared := #syscall(sys.Fclonefileat, source.descriptor, -2, name, 3)
    if shared == 0 {
      // O_WRONLY | O_NOFOLLOW | O_CLOEXEC: refuse a name replaced meanwhile.
      opened := #syscall(sys.Open, name, 16777473, 0)
      if opened < 0 {
        _ = #syscall(sys.Unlink, name)
        return opened
      }
      cloned.* = true
      return opened
    }
    if shared != -45 && shared != -18 && shared != -22 && shared != -78 { return shared }
  }
  return open_path(path, 2561, mode)
}

fn native_symbolic_link(target: []const u8, link: []const u8) isize {
  target_space: [4096]u8
  link_space: [4096]u8
  target_name := terminated(target, target_space[..])
  link_name := terminated(link, link_space[..])
  if target_name == nil || link_name == nil { return -63 }
  return #syscall(sys.Symlink, target_name, link_name)
}
fn native_read_link(path: []const u8, destination: []u8) isize {
  space: [4096]u8
  name := terminated(path, space[..])
  if name == nil { return -63 }
  return #syscall(sys.Readlink, name, &destination[0], destination.len)
}
fn native_sync_directory(path: []const u8) isize {
  // O_RDONLY | O_DIRECTORY.
  opened := open_path(path, 1048576, 0)
  if opened < 0 { return opened }
  code := #syscall(sys.Fsync, opened)
  _ = native_close(opened)
  return code
}
fn native_lock(handle: isize, operation: usize) isize {
  value := #syscall(sys.Flock, handle, operation)
  for value == -4 {
    value = #syscall(sys.Flock, handle, operation)
  }
  return value
}
fn native_truncate(path: []const u8, length: u64) isize {
  return path_call(sys.Truncate, path, #cast(usize, length))
}
fn native_resize(handle: isize, length: u64) isize {
  return #syscall(sys.Ftruncate, handle, length)
}

// libSystem's getenv; the process environment does not change under it
// unless the program itself calls setenv.
extern fn native_getenv "getenv"(name: *const u8) *const u8
fn native_environment(variable: []const u8, destination: []u8) []u8!io.IoErr {
  space: [256]u8
  name := terminated(variable, space[..])
  if name == nil { fail .InvalidInput }
  value := native_getenv(name)
  if value == nil { fail .NotFound }
  length: usize = 0
  bytes := #cast(*const u8, value)
  for {
    view := #slice(bytes, length + 1)
    if view[length] == 0 { break }
    if length == destination.len { fail .Capacity }
    destination[length] = view[length]
    length += 1
  }
  return destination[..length]
}
fn native_app_directory(kind: AppDirectory, destination: []u8) []u8!io.IoErr {
  case kind {
    .Home => { return try environment_into("HOME", destination) }
    .Cache => { return try environment_joined("HOME", "/Library/Caches", destination) }
    .Runtime => {
      value := try environment_into("TMPDIR", destination)
      length := value.len
      for length > 1 && value[length - 1] == '/' {
        length -= 1
      }
      return value[..length]
    }
    _ => { return try environment_joined("HOME", "/Library/Application Support", destination) }
  }
}

// Tree removal primitives, relative to a parent directory descriptor.
const current_directory: isize = -2
const remove_directory_flag: usize = 128
const link_loop_error: isize = -62
// getdirentries64 needs room for one record of the longest name (1024).
const removal_scratch: usize = 1048
fn native_unlink_at(parent: isize, name: []const u8, flags: usize) isize {
  space: [4096]u8
  raw := terminated(name, space[..])
  if raw == nil { return -63 }
  return #syscall(sys.Unlinkat, parent, raw, flags)
}
// O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC.
fn native_open_directory_at(parent: isize, name: []const u8) isize {
  space: [4096]u8
  raw := terminated(name, space[..])
  if raw == nil { return -63 }
  return #syscall(sys.Openat, parent, raw, 17826048, 0)
}
fn directory_handle(directory: *const Directory) isize {
  return directory.state.file.descriptor
}
fn directory_state_at(descriptor: isize) DirectoryState {
  return DirectoryState{ file: adopt_handle(descriptor) }
}
