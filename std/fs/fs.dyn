use "std/mem" memory
use "std/io" io
use "std/fail"
// Files and directories. Every function that can fail takes a *fail.Status:
// the first failure is recorded there with the operation, the path and the
// reason, and every later call given that status does nothing and returns
// zero or empty. Check status.failed once, before acting on the results.
//
// A file handle is a plain value: copy it freely, and close it once. Closing
// marks the value it was called on as closed; other copies still hold the
// number, which the system may reuse for the next file opened. File{} is not
// open. path borrows the text the file was opened with, for messages. ended
// is set when a read finds the end of the file.
pub struct File { descriptor: isize, active: bool, ended: bool, path: []const u8 }

// Size, inode, device and the POSIX mode (type and permission bits).
pub struct Metadata { size: u64, inode: u64, device: u64, mode: u16 }

// One directory entry. name borrows the directory's storage until the next
// call; kind uses dirent values: 4 directory, 8 regular file, 10 link.
pub struct DirectoryEntry { name: []const u8, kind: u8 }

fn owned_file(handle: isize) File {
  return File{ descriptor: handle, active: true }
}
pub fn is_open(file: *const File) bool {
  return file.active && native_valid(file.descriptor)
}
// A File for a native handle opened elsewhere; close it once, or not at all
// when something else will.
pub fn adopt_handle(handle: isize) File {
  if !native_valid(handle) { return File{} }
  return owned_file(handle)
}

// Records a native failure: its portable kind and the system's own reason.
fn fail_native(status: *fail.Status, operation: []const u8, path: []const u8, code: isize) {
  if status.failed { return }
  failure := fail.make(native_kind(code), operation, path, native_text(code))
  failure.native = code
  fail.set(status, failure)
}
fn fail_kind(status: *fail.Status, operation: []const u8, path: []const u8, kind: fail.Kind, message: []const u8) {
  if status.failed { return }
  fail.set(status, fail.make(kind, operation, path, message))
}
// Records code when it is a failure (negative).
fn check(status: *fail.Status, operation: []const u8, path: []const u8, code: isize) {
  if code < 0 { fail_native(status, operation, path, code) }
}

fn opened(status: *fail.Status, path: []const u8, mode: u8, operation: []const u8) File {
  if status.failed { return File{ path: path } }
  handle := native_open(path, mode)
  if handle < 0 {
    fail_native(status, operation, path, handle)
    return File{ path: path }
  }
  file := owned_file(handle)
  file.path = path
  return file
}
// Opens path for reading.
pub fn open(status: *fail.Status, path: []const u8) File {
  return opened(status, path, 0, "open")
}
// Creates path for writing, or empties it when it exists.
pub fn create(status: *fail.Status, path: []const u8) File {
  return opened(status, path, 1, "create")
}
// Opens path for writing at its end, creating it when missing.
pub fn append(status: *fail.Status, path: []const u8) File {
  return opened(status, path, 2, "append")
}
// Creates path for writing; fails with AlreadyExists when it exists.
pub fn create_exclusive(status: *fail.Status, path: []const u8) File {
  return opened(status, path, 3, "create")
}

// Whether an operation may run: status not failed and file open.
fn usable(status: *fail.Status, file: *const File, operation: []const u8) bool {
  if status.failed { return false }
  if !is_open(file) {
    fail_kind(status, operation, file.path, fail.Kind.InvalidState, "file is not open")
    return false
  }
  return true
}

// Closes the file. Safe on a file that never opened, and it closes whatever
// any status says, so cleanup needs none. A failed close is not reported: use
// sync when written data must be durable.
pub fn close(file: *File) {
  if !is_open(file) { return }
  handle := file.descriptor
  // Never retry close on a possibly reused native handle, including after EINTR.
  file.descriptor = 0
  file.active = false
  _ = native_close(handle)
}

// Reads into destination and returns the byte count: 0 at the end of the
// file (file.ended) and after a failure.
pub fn read(status: *fail.Status, file: *File, destination: []u8) usize {
  if #len(destination) == 0 || !usable(status, file, "read") { return 0 }
  value := native_read(file.descriptor, destination)
  for native_interrupted(value) {
    value = native_read(file.descriptor, destination)
  }
  if value < 0 {
    fail_native(status, "read", file.path, value)
    return 0
  }
  if value == 0 {
    file.ended = true
  }
  return #cast(usize, value)
}

// Writes all of source.
pub fn write(status: *fail.Status, file: *File, source: []const u8) {
  _ = write_count(status, file, source)
}
fn write_count(status: *fail.Status, file: *File, source: []const u8) usize {
  if !usable(status, file, "write") { return 0 }
  written: usize = 0
  for written < #len(source) {
    value := native_write(file.descriptor, source[written..])
    if native_interrupted(value) { continue }
    if value < 0 {
      fail_native(status, "write", file.path, value)
      return written
    }
    if value == 0 {
      fail_kind(status, "write", file.path, fail.Kind.System, "no progress")
      return written
    }
    written += #cast(usize, value)
  }
  return written
}

// Streams over a File, for code that takes io.Reader or io.Writer. The
// adapter borrows the File itself: keep it alive and unmoved until I/O
// completes.
fn stream_read(data: rawptr, status: *fail.Status, destination: []u8) usize {
  return read(status, #cast(*File, data), destination)
}
fn stream_write(data: rawptr, status: *fail.Status, source: []const u8) usize {
  return write_count(status, #cast(*File, data), source)
}
pub fn reader(file: *File) io.Reader {
  return io.Reader{ data: file, read: stream_read }
}
pub fn writer(file: *File) io.Writer {
  return io.Writer{ data: file, write: stream_write }
}

// Moves the file position and returns it; origin: 0 start, 1 current,
// 2 end. Zero after a failure.
pub fn seek(status: *fail.Status, file: *File, offset: isize, origin: usize) usize {
  if !usable(status, file, "seek") { return 0 }
  if origin > 2 {
    fail_kind(status, "seek", file.path, fail.Kind.InvalidInput, "origin must be 0, 1 or 2")
    return 0
  }
  value := native_seek(file.descriptor, offset, origin)
  if value < 0 {
    fail_native(status, "seek", file.path, value)
    return 0
  }
  return #cast(usize, value)
}
// Makes written data durable.
pub fn sync(status: *fail.Status, file: *File) {
  if !usable(status, file, "sync") { return }
  check(status, "sync", file.path, native_sync(file.descriptor))
}

// A read-only view of the whole file, owned by the caller until unmap. The
// bytes reflect the file when mapped; another writer may change them later.
// Truncating the file while mapped can fault on access. The file position is
// unchanged, and the file may be closed while the mapping stays valid. A
// zero-length file maps to an empty view without a native mapping.
pub fn map(status: *fail.Status, file: *const File) []const u8 {
  empty: []const u8
  if !usable(status, file, "map") { return empty }
  current := native_seek(file.descriptor, 0, 1)
  if current < 0 {
    fail_native(status, "map", file.path, current)
    return empty
  }
  end := native_seek(file.descriptor, 0, 2)
  restored := native_seek(file.descriptor, current, 0)
  if end < 0 || restored < 0 {
    code := end
    if code >= 0 {
      code = restored
    }
    fail_native(status, "map", file.path, code)
    return empty
  }
  size := #cast(usize, end)
  if size == 0 { return empty }
  address := native_map(file.descriptor, size)
  if address < 0 {
    fail_native(status, "map", file.path, address)
    return empty
  }
  bytes := #cast(*const u8, #cast(usize, address))
  return #slice(bytes, size)
}
// Releases a mapping and empties it. Unmapping an empty view does nothing.
pub fn unmap(mapping: *[]const u8) {
  view := mapping.*
  if #len(view) != 0 {
    _ = native_unmap(#cast(usize, &view[0]), #len(view))
  }
  empty: []const u8
  mapping.* = empty
}

// Reads one complete file into arena storage, bounded by maximum. Empty after
// a failure.
pub fn read_all(arena: *memory.Arena, status: *fail.Status, path: []const u8, maximum: usize) []u8 {
  file := open(status, path)
  bytes := read_contents(arena, status, &file, maximum)
  close(&file)
  return bytes
}
// Reads the rest of file into arena storage, bounded by maximum. On a
// failure, including a file larger than maximum (Overflow), the result is
// empty and the arena is as it was. Panics when the arena is exhausted.
pub fn read_contents(arena: *memory.Arena, status: *fail.Status, file: *File, maximum: usize) []u8 {
  if !usable(status, file, "read") { return file_empty() }
  mark := memory.arena_mark(arena)
  output: []u8
  output_mark := mark
  total: usize = 0
  too_large := false
  // Size the first allocation from the descriptor when it reports a length.
  // Geometric growth copies into new arena space and retains each earlier
  // buffer until the caller rewinds, so a 20 MiB file can pin ~40 MiB.
  // The size is only a hint: growth and EOF probing still handle files that
  // change length while being read, and pseudo files that report zero.
  hint: usize = 0
  hint_status: fail.Status
  info := file_metadata(&hint_status, file)
  if !hint_status.failed && info.size != 0 && info.size <= maximum {
    hint = #cast(usize, info.size)
  }
  for {
    capacity := #len(output) - total
    if capacity > 65536 {
      capacity = 65536
    }
    if capacity == 0 {
      // Probe before growing: empty files need no allocation, and a full
      // caller buffer still distinguishes EOF from capacity/maximum overflow.
      probe: [1]u8
      extra := read(status, file, probe[..])
      if status.failed { break }
      if extra == 0 { break }
      if total == maximum {
        too_large = true
        break
      }
      wanted := maximum
      if total == 0 && hint != 0 {
        wanted = hint
      } else if total == 0 {
        if wanted > 65536 {
          wanted = 65536
        }
      } else if total <= maximum / 2 {
        wanted = total * 2
      }
      // A buffer arena or a limit caps the guess, so a file that fits is
      // read even when the guess would not fit.
      room := memory.arena_room(arena)
      if wanted > room {
        wanted = room
      }
      if wanted <= total {
        #panic("arena exhausted: the file does not fit")
      }
      next := memory.push_bytes(arena, wanted)
      _ = memory.copy(next, output[..total])
      output = next
      output_mark = memory.arena_mark(arena) - wanted
      output[total] = probe[0]
      total += 1
      continue
    }
    part := read(status, file, output[total..total + capacity])
    total += part
    if status.failed { break }
    if part == 0 { break }
  }
  if too_large {
    fail_kind(status, "read", file.path, fail.Kind.Overflow, "file is larger than the limit")
  }
  if status.failed {
    memory.arena_rewind(arena, mark)
    return file_empty()
  }
  if #len(output) != 0 {
    memory.arena_rewind(arena, output_mark + total)
  }
  return output[..total]
}
fn file_empty() []u8 {
  empty: []u8
  return empty
}

// Creates or replaces path with source. A failed close is not reported: use
// write_atomic, or create, write and sync, when the write must be durable.
pub fn write_all(status: *fail.Status, path: []const u8, source: []const u8) {
  file := create(status, path)
  write(status, &file, source)
  close(&file)
}

// Metadata for path, following symbolic links. Zero after a failure.
pub fn metadata(status: *fail.Status, path: []const u8) Metadata {
  info: Metadata
  if status.failed { return info }
  check(status, "metadata", path, native_metadata(path, &info))
  if status.failed { return Metadata{} }
  return info
}
// Metadata for an open file.
pub fn file_metadata(status: *fail.Status, file: *const File) Metadata {
  info: Metadata
  if !usable(status, file, "metadata") { return info }
  check(status, "metadata", file.path, native_file_metadata(file, &info))
  if status.failed { return Metadata{} }
  return info
}
// Whether info describes a directory or a regular file.
pub fn is_directory(info: Metadata) bool {
  return (info.mode & 0o170000) == 0o040000
}
pub fn is_file(info: Metadata) bool {
  return (info.mode & 0o170000) == 0o100000
}

// Removes the file at path.
pub fn remove(status: *fail.Status, path: []const u8) {
  if status.failed { return }
  check(status, "remove", path, native_remove(path))
}
// Renames old_path to new_path, replacing new_path when it exists.
pub fn rename(status: *fail.Status, old_path: []const u8, new_path: []const u8) {
  if status.failed { return }
  check(status, "rename", old_path, native_rename(old_path, new_path))
}
// Creates the directory path, readable by everyone and writable by its
// owner (0o755). An existing directory is not a failure; an existing file
// is.
pub fn make_directory(status: *fail.Status, path: []const u8) {
  make_directory_mode(status, path, 0o755)
}
// Like make_directory, with the permission bits mode (ignored on Windows),
// such as 0o700 for a directory only its owner may enter.
pub fn make_directory_mode(status: *fail.Status, path: []const u8, mode: usize) {
  if status.failed { return }
  code := native_make_directory(path, mode)
  if code < 0 && native_kind(code) == fail.Kind.AlreadyExists {
    info: Metadata
    if native_metadata(path, &info) == 0 && is_directory(info) { return }
    fail_kind(status, "make directory", path, fail.Kind.AlreadyExists, "exists and is not a directory")
    return
  }
  check(status, "make directory", path, code)
}
// Creates the directory path with mode; fails with AlreadyExists when
// anything exists there, so the caller knows it made a new directory.
pub fn make_directory_exclusive(status: *fail.Status, path: []const u8, mode: usize) {
  if status.failed { return }
  check(status, "make directory", path, native_make_directory(path, mode))
}
// Removes the empty directory path.
pub fn remove_directory(status: *fail.Status, path: []const u8) {
  if status.failed { return }
  check(status, "remove directory", path, native_remove_directory(path))
}

// Opens the directory path for listing with directory_next. storage holds
// entry names and must outlive the directory; 4096 bytes is plenty.
pub fn open_directory(status: *fail.Status, path: []const u8, storage: []u8) Directory {
  directory: Directory
  if status.failed { return directory }
  check(status, "list", path, native_open_directory(path, storage, &directory))
  directory.path = path
  return directory
}
// The next entry, without "." and "..". At the end, and after a failure, it
// sets directory.ended and returns an entry with an empty name.
pub fn directory_next(status: *fail.Status, directory: *Directory) DirectoryEntry {
  entry: DirectoryEntry
  if !status.failed {
    check(status, "list", directory.path, native_directory_next(directory, &entry))
  }
  if status.failed || #len(entry.name) == 0 {
    directory.ended = true
    return DirectoryEntry{}
  }
  return entry
}
// The names in directory path, copied into arena, without "." and "..".
// Empty after a failure. Entries are in the system's order.
pub fn list(arena: *memory.Arena, status: *fail.Status, path: []const u8) []DirectoryEntry {
  empty: []DirectoryEntry
  if status.failed { return empty }
  storage: [4096]u8
  directory := open_directory(status, path, storage[..])
  defer close_directory(&directory)
  mark := memory.arena_mark(arena)
  capacity: usize = 16
  entries := memory.push_array(DirectoryEntry, arena, capacity)
  count: usize = 0
  for {
    entry := directory_next(status, &directory)
    if status.failed {
      memory.arena_rewind(arena, mark)
      return empty
    }
    if directory.ended { break }
    if count == capacity {
      grown := memory.push_array(DirectoryEntry, arena, capacity * 2)
      for i in 0..count {
        grown[i] = entries[i]
      }
      entries = grown
      capacity *= 2
    }
    name := memory.push_bytes(arena, #len(entry.name))
    _ = memory.copy(name, entry.name)
    entries[count] = DirectoryEntry{ name: name, kind: entry.kind }
    count += 1
  }
  return entries[..count]
}
