use "std/mem" memory
use "std/io" io
// A file handle is a plain value: copy it freely, and close it once. Closing
// marks the value it was called on as closed; other copies still hold the
// number, which the system may reuse for the next file opened. File{} is
// not open.
//
// Failure is state on the file. The first failed operation sets failed and
// failure, which names the operation, the path and the reason; after that
// every operation on the file does nothing and returns zero. Check
// file.failed once, where it matters, and print io.text(file.failure).
// ended is set when a read finds the end of the file.
pub struct File { descriptor: isize, active: bool, failed: bool, ended: bool, failure: io.Failure }
type FileResult = io.Result(File)
pub struct Result { transferred: usize, failure: io.Failure }
pub type OffsetResult = io.Count
fn owned_file(handle: isize) File {
  return File{ descriptor: handle, active: true }
}
pub fn is_open(file: *const File) bool {
  return file.active && native_valid(file.descriptor)
}
// A File for a native handle opened elsewhere; close it once, or not at all
// when something else will.
pub fn adopt_handle(handle: isize) File {
  if !native_valid(handle) { return File{} }
  return owned_file(handle)
}
fn opened(path: []const u8, mode: u8, operation: []const u8) File {
  result := native_open(path, mode)
  if io.failed(result.failure) {
    failure := result.failure
    failure.operation = operation
    failure.path = path
    return File{ failed: true, failure: failure }
  }
  return result.value
}
// Opens path for reading. On failure the File is failed and its failure says
// why; reading it returns nothing.
pub fn open(path: []const u8) File {
  return opened(path, 0, "open")
}
pub fn create(path: []const u8) File {
  return opened(path, 1, "create")
}
pub fn append(path: []const u8) File {
  return opened(path, 2, "append")
}
pub fn create_exclusive(path: []const u8) File {
  return opened(path, 3, "create")
}
fn failure(code: isize) Result {
  return Result{ failure: io.Failure{ kind: native_kind(code), native: code } }
}
// Records the first failure on file; later ones are consequences.
fn fail(file: *File, operation: []const u8, kind: io.Kind, native: isize) {
  if file.failed { return }
  file.failed = true
  file.failure = io.Failure{ kind: kind, native: native, operation: operation }
}
// Whether an operation may run: open and not failed. A closed file fails
// with InvalidState.
fn usable(file: *File, operation: []const u8) bool {
  if file.failed { return false }
  if !is_open(file) {
    fail(file, operation, io.Kind.InvalidState, 0)
    return false
  }
  return true
}
pub fn close(file: *File) {
  if !is_open(file) { return }
  handle := file.descriptor
  // Never retry close on a possibly reused native handle, including after EINTR.
  file.descriptor = 0
  file.active = false
  _ = native_close(handle)
}
// Reads into destination and returns the byte count. Zero means the end of
// the file (file.ended) or a failure (file.failed).
pub fn read(file: *File, destination: []u8) usize {
  if #len(destination) == 0 || !usable(file, "read") { return 0 }
  value := native_read(file.descriptor, destination)
  for native_interrupted(value) {
    value = native_read(file.descriptor, destination)
  }
  if value < 0 {
    fail(file, "read", native_kind(value), value)
    return 0
  }
  if value == 0 { file.ended = true }
  return #cast(usize, value)
}
// Writes all of source and returns the bytes written, fewer on a failure.
pub fn write(file: *File, source: []const u8) usize {
  if !usable(file, "write") { return 0 }
  written: usize = 0
  for written < #len(source) {
    value := native_write(file.descriptor, source[written..])
    if native_interrupted(value) { continue }
    if value < 0 {
      fail(file, "write", native_kind(value), value)
      return written
    }
    if value == 0 {
      fail(file, "write", io.Kind.System, 0)
      return written
    }
    written += #cast(usize, value)
  }
  return written
}
fn adapter_read(data: rawptr, destination: []u8) io.Transfer {
  file := #cast(*File, data)
  count := read(file, destination)
  if file.failed { return io.Transfer{ transferred: count, failure: file.failure } }
  status := io.Status.Complete
  if count == 0 && #len(destination) != 0 {
    status = io.Status.End
  }
  return io.Transfer{ transferred: count, status: status }
}
fn adapter_write(data: rawptr, source: []const u8) io.Transfer {
  file := #cast(*File, data)
  count := write(file, source)
  if file.failed { return io.Transfer{ transferred: count, failure: file.failure } }
  return io.Transfer{ transferred: count }
}
// Adapters borrow the File itself: keep it alive and unmoved until I/O completes.
pub fn reader(file: *File) io.Reader {
  return io.Reader{ data: file, read: adapter_read }
}
pub fn writer(file: *File) io.Writer {
  return io.Writer{ data: file, write: adapter_write }
}
// Moves the file position and returns it; origin: 0 start, 1 current,
// 2 end. Zero on a failure.
pub fn seek(file: *File, offset: isize, origin: usize) usize {
  if !usable(file, "seek") { return 0 }
  if origin > 2 {
    fail(file, "seek", io.Kind.InvalidInput, 0)
    return 0
  }
  value := native_seek(file.descriptor, offset, origin)
  if value < 0 {
    fail(file, "seek", native_kind(value), value)
    return 0
  }
  return #cast(usize, value)
}
// Makes written data durable.
pub fn sync(file: *File) {
  if !usable(file, "sync") { return }
  value := native_sync(file.descriptor)
  if value < 0 { fail(file, "sync", native_kind(value), value) }
}

// A read-only view of a whole file, owned by the caller until unmap. The
// bytes reflect the file when mapped; another writer may change them later.
// Truncating the file while mapped can fault on access. A zero-length file
// maps to an empty value without a native mapping.
pub type Mapping = io.Result([]const u8)

// Maps the whole file. The file position is unchanged, and the file may be
// closed while the mapping stays valid.
pub fn map(file: *const File) Mapping {
  if !is_open(file) { return Mapping{ failure: io.Failure{ kind: io.Kind.InvalidState } } }
  current := native_seek(file.descriptor, 0, 1)
  if current < 0 {
    return Mapping{ failure: io.Failure{ kind: native_kind(current), native: current } }
  }
  end := native_seek(file.descriptor, 0, 2)
  restored := native_seek(file.descriptor, current, 0)
  if end < 0 { return Mapping{ failure: io.Failure{ kind: native_kind(end), native: end } } }
  if restored < 0 {
    return Mapping{ failure: io.Failure{ kind: native_kind(restored), native: restored } }
  }
  size := #cast(usize, end)
  if size == 0 { return Mapping{} }
  address := native_map(file.descriptor, size)
  if address < 0 {
    return Mapping{ failure: io.Failure{ kind: native_kind(address), native: address } }
  }
  bytes := #cast(*const u8, #cast(usize, address))
  return Mapping{ value: #slice(bytes, size) }
}

// Releases a mapping and clears it. Unmapping a zero Mapping succeeds.
pub fn unmap(mapping: *Mapping) Result {
  if mapping == nil { return Result{ failure: io.Failure{ kind: io.Kind.InvalidInput } } }
  if #len(mapping.value) != 0 {
    value := native_unmap(#cast(usize, &mapping.value[0]), #len(mapping.value))
    if value < 0 { return failure(value) }
  }
  mapping.* = Mapping{}
  return Result{}
}

// Reads one complete file into arena storage, bounded by maximum. Empty when
// the file is missing or unreadable: to learn why, open it and use read_contents.
pub fn read_all(arena: *memory.Arena, path: []const u8, maximum: usize) []u8 {
  file := open(path)
  bytes := read_contents(arena, &file, maximum)
  close(&file)
  return bytes
}
// Reads the rest of file into arena storage, bounded by maximum. On a
// failure, including a file larger than maximum (Overflow) or an arena that
// cannot hold it (Capacity), the result is empty, the arena is as it was,
// and the failure is on file.
pub fn read_contents(arena: *memory.Arena, file: *File, maximum: usize) []u8 {
  if !usable(file, "read") { return file_empty() }
  mark := memory.arena_mark(arena)
  output: []u8
  output_mark := mark
  total: usize = 0
  error: isize = 0
  kind := io.Kind.Ok
  // Size the first allocation from the descriptor when it reports a length.
  // Geometric growth copies into new arena space and retains each earlier
  // buffer until the caller rewinds, so a 20 MiB file can pin ~40 MiB.
  // The size is only a hint: growth and EOF probing still handle files that
  // change length while being read, and pseudo files that report zero.
  hint: usize = 0
  info := file_metadata(file)
  if !io.failed(info.failure) && info.size != 0 && info.size <= maximum {
    hint = #cast(usize, info.size)
  }
  for {
    capacity := #len(output) - total
    if capacity > 65536 {
      capacity = 65536
    }
    if capacity == 0 {
      // Probe before growing: empty files need no allocation, and a full
      // caller buffer still distinguishes EOF from capacity/maximum overflow.
      probe: [1]u8
      extra := read(file, probe[..])
      if file.failed { break }
      if extra == 0 { break }
      if total == maximum {
        kind = io.Kind.Overflow
        break
      }
      wanted := maximum
      if total == 0 && hint != 0 {
        wanted = hint
      } else if total == 0 {
        if wanted > 65536 {
          wanted = 65536
        }
      } else if total <= maximum / 2 {
        wanted = total * 2
      }
      available := memory.arena_remaining(arena)
      // A hinted size is kept whole: clamping it to the current block's tail
      // would force a regrow copy that the hint exists to avoid.
      exact := hint != 0 && !arena.fixed_buffer
      if total == 0 && !exact && available != 0 && wanted > available {
        wanted = available
      } else if total != 0 && available != 0 && wanted - total > available {
        wanted = total + available
      }
      if arena.fixed_buffer {
        if total != 0 {
          kind = io.Kind.Capacity
          break
        }
        if wanted > memory.arena_remaining(arena) {
          wanted = memory.arena_remaining(arena)
        }
      }
      if wanted <= total {
        kind = io.Kind.Capacity
        break
      }
      if total != 0 && memory.arena_try_extend(arena, &output[0], total, wanted - total) {
        output = #slice(&output[0], wanted)
      } else {
        if wanted > available && arena.limit != 0 {
          // A geometric reservation is only a preference. Use the last
          // bounded block when it can still hold the complete output.
          backing_left := arena.limit - arena.backing
          if backing_left <= memory.ArenaHeader || backing_left - memory.ArenaHeader <= total {
            kind = io.Kind.Capacity
            break
          }
          if wanted > backing_left - memory.ArenaHeader {
            wanted = backing_left - memory.ArenaHeader
          }
        }
        pointer: *u8 = nil
        if wanted <= memory.arena_remaining(arena) {
          pointer = memory.arena_push_uninit(arena, wanted, 1)
        } else {
          allocation := memory.arena_try_push(arena, wanted, 1)
          if !allocation.ok {
            kind = io.Kind.Capacity
            if allocation.error == memory.ErrorKind.Overflow {
              kind = io.Kind.Overflow
            }
            if allocation.error == memory.ErrorKind.System {
              kind = io.Kind.System
            }
            error = allocation.code
            break
          }
          pointer = allocation.memory
        }
        next := #slice(pointer, wanted)
        _ = memory.copy(next, output[..total])
        output = next
        output_mark = memory.arena_mark(arena) - wanted
      }
      output[total] = probe[0]
      total += 1
      continue
    }
    part := read(file, output[total..total + capacity])
    total += part
    if file.failed { break }
    if part == 0 { break }
  }
  if kind != io.Kind.Ok { fail(file, "read", kind, error) }
  if file.failed {
    memory.arena_rewind(arena, mark)
    return file_empty()
  }
  if #len(output) != 0 {
    memory.arena_rewind(arena, output_mark + total)
  }
  return output[..total]
}
fn file_empty() []u8 {
  empty: []u8
  return empty
}

// Creates or replaces path with source; true when every byte was written.
// To learn why it failed, create the file and write it yourself. A failed
// close is not reported: use sync when the write must be durable.
pub fn write_all(path: []const u8, source: []const u8) bool {
  file := create(path)
  _ = write(&file, source)
  close(&file)
  return !file.failed
}

