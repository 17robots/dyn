use "std/io" io
use "std/os/linux/sys"
#target(kernel: linux)
// Scratch frame storage for iterative, descriptor-relative tree removal.
// Names borrow the parent frame's directory buffer, so no paths are rebuilt.
pub struct RemovalFrame { directory: Directory, name: []const u8, parent: isize }
fn unlink_at(parent: isize, name: []const u8, directory: bool) isize {
  storage: [4096]u8
  raw := terminated(name, storage[..])
  if raw == nil {
    return -36
  }
  flags: usize = 0
  if directory {
    flags = 512
  }
  return #syscall(sys.Unlinkat, parent, raw, flags)
}
fn open_removal(parent: isize, name: []const u8, storage: []u8) DirectoryResult {
  path: [4096]u8
  raw := terminated(name, path[..])
  if raw == nil {
    return DirectoryResult{ failure: io.linux_failure(-36) }
  }
  // O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC. Never descend through symlinks.
  descriptor := #syscall(sys.Openat, parent, raw, 720896, 0)
  if descriptor < 0 {
    return DirectoryResult{ failure: io.linux_failure(descriptor) }
  }
  return DirectoryResult{ value: Directory{ file: adopt_handle(descriptor), storage: storage } }
}
// Requires at least 280 scratch bytes per frame. Depth/capacity errors may leave
// a partially removed tree. Concurrent mutation may fail; it never follows links.
pub fn remove_tree(path: []const u8, frames: []RemovalFrame, scratch: []u8) Result {
  if #len(frames) == 0 || #len(scratch) / #len(frames) < 280 {
    return Result{ failure: io.linux_failure(-28) }
  }
  stride := #len(scratch) / #len(frames)
  root := open_removal(-100, path, scratch[..stride])
  if io.failed(root.failure) {
    if root.failure.native != -20 && root.failure.native != -40 {
      return Result{ failure: io.linux_failure(root.failure.native) }
    }
    removed := unlink_at(-100, path, false)
    return Result{ failure: io.linux_failure(removed) }
  }
  frames[0] = RemovalFrame{ directory: root.value, name: path, parent: -100 }
  depth: usize = 1
  defer {
    for depth > 0 {
      depth -= 1
      close_directory(&frames[depth].directory)
    }
  }
  for depth > 0 {
    item := directory_next(&frames[depth - 1].directory)
    if item.failure.native != 0 {
      return Result{ failure: io.linux_failure(item.failure.native) }
    }
    if !item.found {
      frame := &frames[depth - 1]
      removed_directory := unlink_at(frame.parent, frame.name, true)
      if removed_directory != 0 {
        return Result{ failure: io.linux_failure(removed_directory) }
      }
      close_directory(&frame.directory)
      depth -= 1
      continue
    }
    parent := frames[depth - 1].directory.file.descriptor
    // Try unlink first; type bytes may be DT_UNKNOWN. EISDIR means descend.
    removed_file := unlink_at(parent, item.name, false)
    if removed_file == 0 || removed_file == -2 {
      continue
    }
    if removed_file != -21 {
      return Result{ failure: io.linux_failure(removed_file) }
    }
    if depth == #len(frames) {
      return Result{ failure: io.linux_failure(-28) }
    }
    child := open_removal(parent, item.name, scratch[depth * stride..(depth + 1) * stride])
    if io.failed(child.failure) {
      return Result{ failure: io.linux_failure(child.failure.native) }
    }
    frames[depth] = RemovalFrame{ directory: child.value, name: item.name, parent: parent }
    depth += 1
  }
  return Result{}
}
