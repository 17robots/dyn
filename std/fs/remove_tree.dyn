use "std/fail"
use "std/os/linux/sys"
#target(kernel: linux)
// Scratch frame storage for iterative, descriptor-relative tree removal.
// Names borrow the parent frame's directory buffer, so no paths are rebuilt.
pub struct RemovalFrame { directory: Directory, name: []const u8, parent: isize }
fn unlink_at(parent: isize, name: []const u8, directory: bool) isize {
  storage: [4096]u8
  raw := terminated(name, storage[..])
  if raw == nil { return -36 }
  flags: usize = 0
  if directory {
    flags = 512
  }
  return #syscall(sys.Unlinkat, parent, raw, flags)
}
fn open_removal(parent: isize, name: []const u8, storage: []u8, directory: *Directory) isize {
  path: [4096]u8
  raw := terminated(name, path[..])
  if raw == nil { return -36 }
  // O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC. Never descend through symlinks.
  descriptor := #syscall(sys.Openat, parent, raw, 720896, 0)
  if descriptor < 0 { return descriptor }
  directory.* = Directory{ file: adopt_handle(descriptor), storage: storage, path: name }
  return 0
}
// Removes path and everything under it, without following symbolic links.
// Requires at least 280 scratch bytes per frame; the depth is at most
// #len(frames). Depth or capacity failures may leave a partly removed tree,
// and concurrent changes may make it fail.
pub fn remove_tree(status: *fail.Status, path: []const u8, frames: []RemovalFrame, scratch: []u8) {
  if status == nil {
    remove_tree(&fail.Status{}, path, frames, scratch)
    return
  }
  if status.failed { return }
  if #len(frames) == 0 || #len(scratch) / #len(frames) < 280 {
    fail.invalid(status, "remove", path, "too little scratch space")
    return
  }
  stride := #len(scratch) / #len(frames)
  root: Directory
  opened := open_removal(-100, path, scratch[..stride], &root)
  if opened != 0 {
    if opened != -20 && opened != -40 {
      check(status, "remove", path, opened)
      return
    }
    check(status, "remove", path, unlink_at(-100, path, false))
    return
  }
  frames[0] = RemovalFrame{ directory: root, name: path, parent: -100 }
  depth: usize = 1
  defer {
    for depth > 0 {
      depth -= 1
      close_directory(&frames[depth].directory)
    }
  }
  for depth > 0 {
    item: DirectoryEntry
    listed := native_directory_next(&frames[depth - 1].directory, &item)
    if listed != 0 {
      check(status, "remove", frames[depth - 1].name, listed)
      return
    }
    if #len(item.name) == 0 {
      frame := &frames[depth - 1]
      removed_directory := unlink_at(frame.parent, frame.name, true)
      if removed_directory != 0 {
        check(status, "remove", frame.name, removed_directory)
        return
      }
      close_directory(&frame.directory)
      depth -= 1
      continue
    }
    parent := frames[depth - 1].directory.file.descriptor
    // Try unlink first; type bytes may be DT_UNKNOWN. EISDIR means descend.
    removed_file := unlink_at(parent, item.name, false)
    if removed_file == 0 || removed_file == -2 { continue }
    if removed_file != -21 {
      check(status, "remove", item.name, removed_file)
      return
    }
    if depth == #len(frames) {
      fail.set(status, fail.make(fail.Kind.Capacity, "remove", path, "tree is deeper than the frames"))
      return
    }
    child: Directory
    descended := open_removal(parent, item.name, scratch[depth * stride..(depth + 1) * stride], &child)
    if descended != 0 {
      check(status, "remove", item.name, descended)
      return
    }
    frames[depth] = RemovalFrame{ directory: child, name: item.name, parent: parent }
    depth += 1
  }
}
