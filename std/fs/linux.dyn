use "std/io" io
use "std/os/linux/sys"
#target(kernel: linux)

fn open_flags(path: []const u8, flags: usize, mode: usize) FileResult {
  storage: [4096]u8
  raw := terminated(path, storage[..])
  if raw == nil {
    return FileResult{ failure: io.Failure{ kind: io.Kind.InvalidInput, native: -36 } }
  }
  descriptor := #syscall(sys.Openat, -100, raw, flags | 524288, mode)
  if descriptor < 0 {
    return FileResult{ failure: io.linux_failure(descriptor) }
  }
  return FileResult{ value: owned_file(descriptor) }
}

fn native_open_read(path: []const u8) FileResult {
  return open_flags(path, 0, 0)
}
fn native_create(path: []const u8) FileResult {
  return open_flags(path, 577, 420)
}
fn native_append(path: []const u8) FileResult {
  return open_flags(path, 1089, 420)
}
fn native_create_exclusive(path: []const u8) FileResult {
  return open_flags(path, 193, 420)
}

fn native_open(path: []const u8, mode: u8) FileResult {
  if mode == 1 {
    return native_create(path)
  }
  if mode == 2 {
    return native_append(path)
  }
  if mode == 3 {
    return native_create_exclusive(path)
  }
  return native_open_read(path)
}
fn native_close(handle: isize) isize {
  return #syscall(sys.Close, handle)
}
fn native_read(handle: isize, destination: []u8) isize {
  return #syscall(sys.Read, handle, &destination[0], #len(destination))
}
fn native_write(handle: isize, source: []const u8) isize {
  return #syscall(sys.Write, handle, &source[0], #len(source))
}
fn native_seek(handle: isize, offset: isize, origin: usize) isize {
  return #syscall(sys.Lseek, handle, offset, origin)
}
fn native_sync(handle: isize) isize {
  return #syscall(sys.Fsync, handle)
}
fn native_kind(code: isize) io.Kind {
  return io.linux(code)
}
fn native_valid(handle: isize) bool {
  return handle >= 0
}
fn native_interrupted(code: isize) bool {
  return code == -4
}
// Read-only private mapping of size bytes from offset zero.
fn native_map(handle: isize, size: usize) isize {
  return #syscall(sys.Mmap, 0, size, 1, 2, handle, 0)
}
fn native_unmap(address: usize, size: usize) isize {
  return #syscall(sys.Munmap, address, size)
}
