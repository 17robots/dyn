#target(kernel: windows)
use io "std/io"
use "std/fail"
use mem "std/mem"
use utf8 "std/unicode/utf8"
use utf16 "std/unicode/utf16"

pub const Modify: u32 = 2
pub const Attributes: u32 = 4
pub const CloseWrite: u32 = 8
pub const MoveFrom: u32 = 64
pub const MoveTo: u32 = 128
pub const Create: u32 = 256
pub const Delete: u32 = 512
pub const DeleteSelf: u32 = 1024
pub const MoveSelf: u32 = 2048
pub const Ignored: u32 = 32768
pub const IsDirectory: u32 = 1073741824
pub const Changes: u32 = 4046
pub const SupportedEvents: u32 = 966
pub const FixedWatchCapacity: usize = 16
pub const HasCloseWrite: bool = false
pub const HasMoveCookies: bool = false
pub const HasDirectoryFlag: bool = false
struct Overlapped { internal: usize, transferred: usize, offset: u32, offset_high: u32, event: rawptr }
struct Slot { handle: rawptr, event: rawptr, overlap: Overlapped, buffer: [1024]u32, used: usize, offset: usize, pending: bool, id: i32, mask: u32 }
struct Native { slots: [16]Slot, next_id: i32, cursor: usize }
// Noncopyable owner. Native requests borrow stable arena slots until completion.
// Names borrow caller storage until the next next() call. Watches are nonrecursive.
// Windows reports paired rename actions without cookies, and cannot distinguish
// close-write, directory flags, or deletion/movement of the watched directory.
// ended is set by a next call that returns no event: none is pending now,
// and a later call may return one.
pub struct Watcher { native: *Native, owner: *mem.Arena, storage: []u8, rescan_required: bool, failed: bool, error: io.IoErr, ended: bool }
pub struct Event { watch: i32, mask: u32, cookie: u32, name: []const u8, rescan: bool }
extern fn native_open "dyn_watch_open"(name: *const u16, access: u32, share: u32, security: rawptr, creation: u32, flags: u32, template: rawptr) rawptr
extern fn native_close "dyn_watch_close"(handle: rawptr) i32
extern fn native_error "dyn_watch_error"() u32
extern fn create_event "dyn_watch_create_event"(security: rawptr, manual: i32, initial: i32, name: rawptr) rawptr
extern fn reset_event "dyn_watch_reset_event"(event: rawptr) i32
extern fn read_changes "dyn_watch_read"(handle: rawptr, buffer: rawptr, size: u32, recursive: i32, filter: u32, transferred: *u32, overlap: *Overlapped, callback: rawptr) i32
extern fn completion "dyn_watch_result"(handle: rawptr, overlap: *Overlapped, transferred: *u32, wait: i32) i32
extern fn cancel "dyn_watch_cancel"(handle: rawptr, overlap: *Overlapped) i32
fn error() isize {
  return 0 - #cast(isize, native_error())
}
// Whether the read was queued; on failure code holds the negated native
// code, which may be zero.
fn arm(slot: *Slot, code: *isize) bool {
  if reset_event(slot.event) == 0 {
    code.* = error()
    return false
  }
  slot.overlap = Overlapped{ event: slot.event }
  slot.used = 0
  slot.offset = 0
  if read_changes(slot.handle, &slot.buffer[0], 4096, 0, 31, nil, &slot.overlap, nil) == 0 {
    native := native_error()
    if native != 997 {
      code.* = 0 - #cast(isize, native)
      return false
    }
  }
  slot.pending = true
  return true
}
pub fn open(storage: []u8) Watcher!io.IoErr {
  if storage.len < 272 { fail io.linux_err(-28) }
  owner := mem.arena_alloc(#sizeof(Native))
  native := mem.push<Native>(owner)
  native.next_id = 1
  return Watcher{ native: native, owner: owner, storage: storage }
}
fn retire(slot: *Slot) isize {
  if slot.pending {
    if cancel(slot.handle, &slot.overlap) == 0 {
      code := native_error()
      if code != 1168 { return 0 - #cast(isize, code) }
    }
    transferred: u32 = 0
    if completion(slot.handle, &slot.overlap, &transferred, 1) == 0 {
      code := native_error()
      if code != 995 && code != 1022 { return 0 - #cast(isize, code) }
      // Aborted or overflowed completion no longer borrows the slot. Unknown
      // errors retain it conservatively, so close never frees an active request.
    }
    slot.pending = false
  }
  if slot.handle != nil {
    if native_close(slot.handle) == 0 { return error() }
    slot.handle = nil
  }
  if slot.event != nil {
    if native_close(slot.event) == 0 { return error() }
    slot.event = nil
  }
  slot.id = 0
  slot.used = 0
  slot.offset = 0
  return 0
}
// Watches path; the watch identifier.
pub fn add(state: *Watcher, path: []const u8, mask: u32) i32!io.IoErr {
  if state.native == nil || path.len == 0 { fail io.linux_err(-22) }
  if (mask & SupportedEvents) == 0 { fail io.linux_err(-95) }
  index: usize = 16
  for i in 0..16 {
    if state.native.slots[i].handle == nil && state.native.slots[i].event == nil {
      index = i
      break
    }
  }
  if index == 16 || state.native.next_id == 2147483647 { fail io.linux_err(-28) }
  wide: [4096]u16
  at: usize = 0
  used: usize = 0
  for at < path.len {
    decoded := utf8.decode(path, at)
    if !decoded.valid || decoded.codepoint == 0 { fail io.linux_err(-22) }
    width := utf16.encode(wide[used..4095], decoded.codepoint)
    if width == 0 { fail io.linux_err(-36) }
    used += width
    at += decoded.width
  }
  slot := &state.native.slots[index]
  slot.handle = native_open(&wide[0], 1, 7, nil, 3, 1107296256, nil)
  if #cast(usize, slot.handle) == #max(usize) {
    slot.handle = nil
    fail io.windows_err(error())
  }
  slot.event = create_event(nil, 1, 0, nil)
  if slot.event == nil {
    code := error()
    _ = retire(slot)
    fail io.windows_err(code)
  }
  armed: isize = 0
  if !arm(slot, &armed) {
    _ = retire(slot)
    fail io.windows_err(armed)
  }
  slot.id = state.native.next_id
  state.native.next_id += 1
  slot.mask = mask
  return slot.id
}
pub fn remove(state: *Watcher, watch: i32) !io.IoErr {
  if state.native == nil || watch <= 0 { fail io.linux_err(-22) }
  for i in 0..16 {
    if state.native.slots[i].id == watch {
      code := retire(&state.native.slots[i])
      if code != 0 { fail io.windows_err(code) }
      return
    }
  }
  fail io.linux_err(-22)
}
pub fn close(state: *Watcher) {
  if state.native == nil { return }
  for i in 0..16 {
    code := retire(&state.native.slots[i])
    if code != 0 { return }
  }
  mem.arena_release(state.owner)
  state.native = nil
  state.storage = state.storage[..0]
}
fn rescan(state: *Watcher, id: i32) Event {
  state.rescan_required = true
  return Event{ watch: id, rescan: true }
}
// Empty and rescan events remain protocol states.
fn next_failed(state: *Watcher, code: isize) Event!io.IoErr {
  state.failed = true
  state.error = io.windows_err(code)
  state.ended = true
  fail state.error
}
fn idle(state: *Watcher) Event {
  state.ended = true
  return Event{}
}
pub fn next(state: *Watcher) Event!io.IoErr {
  state.ended = false
  if state.failed {
    state.ended = true
    fail state.error
  }
  if state.native == nil {
    // The watcher is closed.
    state.failed = true
    state.error = io.IoErr.InvalidInput
    state.ended = true
    fail state.error
  }
  for checked in 0..16 {
    index := state.native.cursor
    state.native.cursor = (index + 1) % 16
    slot := &state.native.slots[index]
    if slot.id == 0 { continue }
    if !slot.pending && slot.offset == slot.used {
      armed: isize = 0
      if !arm(slot, &armed) { return try next_failed(state, armed) }
    }
    if slot.pending {
      transferred: u32 = 0
      if completion(slot.handle, &slot.overlap, &transferred, 0) == 0 {
        code := native_error()
        if code == 996 { continue }
        if code == 1022 {
          slot.pending = false
          return rescan(state, slot.id)
        }
        return try next_failed(state, 0 - #cast(isize, code))
      }
      slot.pending = false
      slot.used = transferred
      slot.offset = 0
      if slot.used == 0 || slot.used > 4096 {
        slot.used = 0
        return rescan(state, slot.id)
      }
    }
    for slot.offset < slot.used {
      at := slot.offset
      if slot.used - at < 12 {
        slot.used = 0
        slot.offset = 0
        return rescan(state, slot.id)
      }
      words := slot.buffer[..]
      next_offset := #cast(usize, words[at / 4])
      action := words[at / 4 + 1]
      length := #cast(usize, words[at / 4 + 2])
      if length == 0 || length % 2 != 0 || length > slot.used - at - 12 || (next_offset != 0 && (next_offset % 4 != 0 || next_offset < 12 + length || next_offset > slot.used - at)) {
        slot.used = 0
        slot.offset = 0
        return rescan(state, slot.id)
      }
      if next_offset == 0 { slot.offset = slot.used } else { slot.offset += next_offset }
      mask: u32 = 0
      if action == 1 {
        mask = Create
      } else if action == 2 {
        mask = Delete
      } else if action == 3 {
        mask = Modify | Attributes
      } else if action == 4 {
        mask = MoveFrom
      } else if action == 5 {
        mask = MoveTo
      } else {
        return rescan(state, slot.id)
      }
      mask = mask & slot.mask
      if mask == 0 { continue }
      bytes := #slice(#cast(*u8, &slot.buffer[0]), 4096)
      names := #slice(#cast(*u16, &bytes[at + 12]), length / 2)
      position: usize = 0
      used: usize = 0
      for position < names.len {
        decoded := utf16.decode(names, position)
        if !decoded.valid { return rescan(state, slot.id) }
        width := utf8.encode(state.storage[used..], decoded.codepoint)
        if width == 0 { return rescan(state, slot.id) }
        used += width
        position += decoded.width
      }
      return Event{ watch: slot.id, mask: mask, name: state.storage[..used] }
    }
  }
  return idle(state)
}
pub fn acknowledge_rescan(state: *Watcher) {
  state.rescan_required = false
}
