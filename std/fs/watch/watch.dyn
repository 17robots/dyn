#target(kernel: linux)
use "std/mem" mem
use "std/io" io
use "std/fail"
use "std/fs" fs
use "std/c" c
use "std/os/linux/sys"

pub const Modify: u32 = 2
pub const Attributes: u32 = 4
pub const CloseWrite: u32 = 8
pub const MoveFrom: u32 = 64
pub const MoveTo: u32 = 128
pub const Create: u32 = 256
pub const Delete: u32 = 512
pub const DeleteSelf: u32 = 1024
pub const MoveSelf: u32 = 2048
pub const Ignored: u32 = 32768
pub const IsDirectory: u32 = 1073741824
pub const Changes: u32 = 4046
pub const SupportedEvents: u32 = 4046
pub const HasCloseWrite: bool = true
pub const HasMoveCookies: bool = true
pub const HasDirectoryFlag: bool = true
// Zero means no fixed userspace slot limit; native inotify quotas still apply.
pub const FixedWatchCapacity: usize = 0
// Zero is a closed watcher: active is false. After a failure in next the
// watcher stays failed: later calls fail the same way.
// Ownership: a live watcher is not an independent owner when copied. Keep one
// stable owner and close it before its storage is released or reused.
// ended is set by a next call that returns no event: none is pending now,
// and a later call may return one.
pub struct Watcher { descriptor: isize, active: bool, storage: []u8, used: usize, offset: usize, rescan_required: bool, failed: bool, failure: fail.Failure, ended: bool }
pub struct Event { watch: i32, mask: u32, cookie: u32, name: []const u8, rescan: bool }

// Watches are non-recursive. Register each directory explicitly. Names borrow
// storage until next refill. An overflow invalidates all cached workspace state.
// storage holds event records: at least 272 bytes.
pub fn open(status: *fail.Status, storage: []u8) Watcher {
  if status == nil { return open(&fail.Status{}, storage) }
  if status.failed { return Watcher{} }
  if #len(storage) < 272 {
    _ = failure(status, "watch", "", -28)
    return Watcher{}
  }
  descriptor := #syscall(sys.InotifyInit1, 526336)
  if descriptor < 0 {
    _ = failure(status, "watch", "", descriptor)
    return Watcher{}
  }
  return Watcher{ descriptor: descriptor, active: true, storage: storage }
}
// Watches path; the watch identifier, -1 after a failure.
pub fn add(status: *fail.Status, state: *Watcher, path: []const u8, mask: u32) i32 {
  if status == nil { return add(&fail.Status{}, state, path, mask) }
  if status.failed { return -1 }
  if #len(path) == 0 || !state.active { return failure(status, "watch", path, -22) }
  storage: [4096 + mem.ArenaBufferOverhead]u8
  name := c.string_into(status, storage[..], path)
  if status.failed { return -1 }
  value := #syscall(sys.InotifyAddWatch, state.descriptor, name, mask)
  if value < 0 { return failure(status, "watch", path, value) }
  return #cast(i32, value)
}
pub fn remove(status: *fail.Status, state: *Watcher, watch: i32) {
  if status == nil {
    remove(&fail.Status{}, state, watch)
    return
  }
  if status.failed { return }
  if !state.active {
    _ = failure(status, "unwatch", "", -9)
    return
  }
  value := #syscall(sys.InotifyRmWatch, state.descriptor, watch)
  if value < 0 {
    _ = failure(status, "unwatch", "", value)
  }
}
pub fn close(state: *Watcher) {
  if !state.active { return }
  _ = #syscall(sys.Close, state.descriptor)
  state.descriptor = 0
  state.active = false
  state.used = 0
  state.offset = 0
}
fn load(bytes: []const u8, at: usize) u32 {
  return #cast(u32, bytes[at]) | (#cast(u32, bytes[at+1]) << 8) | (#cast(u32, bytes[at+2]) << 16) | (#cast(u32, bytes[at+3]) << 24)
}
// Buffered records are returned first; reading more needs an active watcher.
// Empty and rescan events remain protocol states.
fn next_failed(status: *fail.Status, state: *Watcher, code: isize) Event {
  state.failed = true
  _ = failure(status, "read events", "", code)
  state.failure = status.failure
  return idle(state)
}
fn idle(state: *Watcher) Event {
  state.ended = true
  return Event{}
}
pub fn next(status: *fail.Status, state: *Watcher) Event {
  if status == nil { return next(&fail.Status{}, state) }
  state.ended = false
  if status.failed { return idle(state) }
  if state.failed {
    fail.set(status, state.failure)
    return idle(state)
  }
  if state.used > #len(state.storage) || state.offset > state.used { return next_failed(status, state, -74) }
  if state.offset == state.used {
    if !state.active { return next_failed(status, state, -9) }
    file := fs.adopt_handle(state.descriptor)
    reading: fail.Status
    count := fs.read(&reading, &file, state.storage)
    if reading.failed {
      if reading.failure.native == -11 { return idle(state) }
      state.failed = true
      state.failure = reading.failure
      fail.set(status, reading.failure)
      return idle(state)
    }
    if count == 0 { return next_failed(status, state, -5) }
    state.offset = 0
    state.used = count
  }
  at := state.offset
  if at > state.used || state.used - at < 16 { return next_failed(status, state, -74) }
  length := #cast(usize, load(state.storage, at+12))
  if length > state.used - at - 16 { return next_failed(status, state, -74) }
  name := state.storage[at+16..at+16+length]
  end: usize = 0
  for end < length && name[end] != 0 {
    end += 1
  }
  if length > 0 && end == length { return next_failed(status, state, -74) }
  mask := load(state.storage, at+4)
  rescan := (mask & 16384) != 0
  watch: i32 = -1
  raw_watch := load(state.storage, at)
  if raw_watch != 4294967295 {
    watch = #cast(i32, raw_watch)
  }
  state.offset += 16 + length
  if rescan {
    state.rescan_required = true
  }
  return Event{ watch: watch, mask: mask, cookie: load(state.storage, at+8), name: name[..end], rescan: rescan }
}
// Call only after rebuilding the snapshot; events may continue arriving during
// that scan, so drain/reconcile them before treating the workspace as current.
pub fn acknowledge_rescan(state: *Watcher) {
  state.rescan_required = false
}

fn failure(status: *fail.Status, operation: []const u8, path: []const u8, code: isize) i32 {
  fail.set(status, io.from_linux(operation, path, code))
  return -1
}
