use "std/parse" parse
#target(kernel: linux)
use "std/io" io
use "std/mem" mem
use "std/c" cstrings
use "std/os/linux" platform

pub struct Metadata { size: u64, inode: u64, device: u64, mode: u16, failure: io.Failure }
pub type PathResult = io.Bytes
pub enum AppDirectory { Home, Config, Cache, Data, Runtime }
pub struct Directory {
  file: File,
  storage: []u8,
  offset: usize,
  used: usize,
}
pub type DirectoryResult = io.Result(Directory)
pub struct DirectoryEntry { name: []const u8, kind: u8, found: bool, failure: io.Failure }

fn terminated(path: []const u8, storage: []u8) *const u8 {
  if #len(path) == 0 {
    return nil
  }
  result := cstrings.string_into(storage, path)
  if result.failure.kind != parse.Kind.Ok {
    return nil
  }
  return result.value
}

pub fn open_directory(path: []const u8, storage: []u8) DirectoryResult {
  if #len(storage) < 24 {
    return DirectoryResult{ failure: io.Failure{ kind: io.linux(-22), native: -22 } }
  }
  opened := open_flags(path, directory_flag, 0)
  if opened.failure.kind != io.Kind.Ok {
    return DirectoryResult{ failure: io.Failure{ kind: io.linux(opened.failure.native), native: opened.failure.native } }
  }
  return DirectoryResult{ value: Directory{ file: opened.value, storage: storage, offset: 0, used: 0 } }
}

// Entry name borrows directory storage and may be invalidated by next refill.
pub fn directory_next(directory: *Directory) DirectoryEntry {
  if !is_open(&directory.file) || #len(directory.storage) < 24 {
    return DirectoryEntry{ failure: io.Failure{ kind: io.linux(-9), native: -9 } }
  }
  for {
    if directory.offset >= directory.used {
      value := #syscall(217, directory.file.descriptor, &directory.storage[0], #len(directory.storage))
      for value == -4 {
        value = #syscall(217, directory.file.descriptor, &directory.storage[0], #len(directory.storage))
      }
      if value < 0 {
        return DirectoryEntry{ failure: io.Failure{ kind: io.linux(value), native: value } }
      }
      if value == 0 {
        return DirectoryEntry{}
      }
      directory.offset = 0
      directory.used = #cast(usize, value)
    }
    if directory.offset + 19 > directory.used {
      return DirectoryEntry{ failure: io.Failure{ kind: io.linux(-5), native: -5 } }
    }
    low := #cast(usize, directory.storage[directory.offset + 16])
    high := #cast(usize, directory.storage[directory.offset + 17])
    record_length := low + high * 256
    if record_length < 20 || directory.offset + record_length > directory.used {
      return DirectoryEntry{ failure: io.Failure{ kind: io.linux(-5), native: -5 } }
    }
    name_start := directory.offset + 19
    name_end := name_start
    for name_end < directory.offset + record_length && directory.storage[name_end] != 0 {
      name_end += 1
    }
    kind := directory.storage[directory.offset + 18]
    directory.offset += record_length
    name := directory.storage[name_start..name_end]
    dot := #len(name) == 1 && name[0] == '.'
    dot_dot := #len(name) == 2 && name[0] == '.' && name[1] == '.'
    if !dot && !dot_dot {
      return DirectoryEntry{ name: name, kind: kind, found: true }
    }
  }
  return DirectoryEntry{}
}

pub fn close_directory(directory: *Directory) {
  directory.offset = 0
  directory.used = 0
  close(&directory.file)
}

// A failed close is not reported. Sync the destination when it must be durable.
pub fn copy_file(source: []const u8, destination: []const u8, scratch: []u8) Result {
  if #len(scratch) == 0 {
    return Result{ failure: io.Failure{ kind: io.linux(-22), native: -22 } }
  }
  input := open(source)
  if input.failure.kind != io.Kind.Ok {
    return Result{ failure: io.Failure{ kind: io.linux(input.failure.native), native: input.failure.native } }
  }
  output_file := open_flags(destination, 65, 420)
  if output_file.failure.kind != io.Kind.Ok {
    close(&input.value)
    return Result{ failure: io.Failure{ kind: io.linux(output_file.failure.native), native: output_file.failure.native } }
  }
  source_info := file_metadata(&input.value)
  destination_info := file_metadata(&output_file.value)
  validation_error: isize = 0
  if source_info.failure.kind != io.Kind.Ok {
    validation_error = source_info.failure.native
  }
  else if destination_info.failure.kind != io.Kind.Ok {
    validation_error = destination_info.failure.native
  }
  else if source_info.device == destination_info.device && source_info.inode == destination_info.inode {
    validation_error = -22
  }
  else if (source_info.mode & 61440) != 32768 || (destination_info.mode & 61440) != 32768 {
    validation_error = -22
  }
  if validation_error == 0 {
    validation_error = #syscall(77, output_file.value.descriptor, 0)
  }
  if validation_error != 0 {
    close(&input.value)
    close(&output_file.value)
    return Result{ failure: io.Failure{ kind: io.linux(validation_error), native: validation_error } }
  }
  copied := stream.copy(writer(&output_file.value), reader(&input.value), scratch)
  close(&input.value)
  close(&output_file.value)
  if copied.status == stream.Status.Error {
    return Result{ transferred: copied.transferred, failure: io.Failure{ kind: copied.kind, native: copied.error } }
  }
  return Result{ transferred: copied.transferred }
}

// statx has one fixed layout on supported Linux architectures (Linux 4.11+).
// Descriptor lookup avoids path replacement races and does not change file position.
pub fn file_metadata(file: *const File) Metadata {
  if !is_open(file) {
    return Metadata{ failure: io.Failure{ kind: io.linux(-9), native: -9 } }
  }
  raw: [32]u64 = []
  empty: [1]u8 = []
  result := #syscall(332, file.descriptor, &empty[0], 4096, 2047, &raw[0])
  if result < 0 {
    return Metadata{ failure: io.Failure{ kind: io.linux(result), native: result } }
  }
  if (raw[0] & 769) != 769 {
    return Metadata{ failure: io.Failure{ kind: io.linux(-95), native: -95 } }
  }
  return Metadata{ size: raw[5], inode: raw[4], device: raw[17], mode: #cast(u16, (raw[3] >> 32)) }
}
pub fn metadata(path: []const u8) Metadata {
  opened := open(path)
  if opened.failure.kind != io.Kind.Ok {
    return Metadata{ failure: io.Failure{ kind: io.linux(opened.failure.native), native: opened.failure.native } }
  }
  info := file_metadata(&opened.value)
  close(&opened.value)
  if info.failure.kind != io.Kind.Ok {
    return info
  }
  return info
}

pub fn remove(path: []const u8) Result {
  storage: [4096 + mem.ArenaBufferOverhead]u8 = []
  raw := terminated(path, storage[..])
  if raw == nil {
    return Result{ transferred: 0, failure: io.Failure{ kind: io.linux(-36), native: -36 } }
  }
  value := #syscall(263, -100, raw, 0)
  if value < 0 {
    return Result{ transferred: 0, failure: io.Failure{ kind: io.linux(value), native: value } }
  }
  return Result{ transferred: 0, failure: io.Failure{ kind: io.linux(0), native: 0 } }
}

pub fn rename(old_path: []const u8, new_path: []const u8) Result {
  old_storage: [4096 + mem.ArenaBufferOverhead]u8 = []
  new_storage: [4096 + mem.ArenaBufferOverhead]u8 = []
  old_raw := terminated(old_path, old_storage[..])
  new_raw := terminated(new_path, new_storage[..])
  if old_raw == nil || new_raw == nil {
    return Result{ transferred: 0, failure: io.Failure{ kind: io.linux(-36), native: -36 } }
  }
  value := #syscall(264, -100, old_raw, -100, new_raw)
  if value < 0 {
    return Result{ transferred: 0, failure: io.Failure{ kind: io.linux(value), native: value } }
  }
  return Result{ transferred: 0, failure: io.Failure{ kind: io.linux(0), native: 0 } }
}

pub fn make_directory(path: []const u8, mode: usize) Result {
  storage: [4096 + mem.ArenaBufferOverhead]u8 = []
  raw := terminated(path, storage[..])
  if raw == nil {
    return Result{ transferred: 0, failure: io.Failure{ kind: io.linux(-36), native: -36 } }
  }
  value := #syscall(258, -100, raw, mode)
  if value < 0 {
    return Result{ transferred: 0, failure: io.Failure{ kind: io.linux(value), native: value } }
  }
  return Result{ transferred: 0, failure: io.Failure{ kind: io.linux(0), native: 0 } }
}

pub fn remove_directory(path: []const u8) Result {
  storage: [4096 + mem.ArenaBufferOverhead]u8 = []
  raw := terminated(path, storage[..])
  if raw == nil {
    return Result{ transferred: 0, failure: io.Failure{ kind: io.linux(-36), native: -36 } }
  }
  value := #syscall(263, -100, raw, 512)
  if value < 0 {
    return Result{ transferred: 0, failure: io.Failure{ kind: io.linux(value), native: value } }
  }
  return Result{ transferred: 0, failure: io.Failure{ kind: io.linux(0), native: 0 } }
}

pub fn symbolic_link(target: []const u8, link: []const u8) Result {
  target_storage: [4096 + mem.ArenaBufferOverhead]u8 = []
  link_storage: [4096 + mem.ArenaBufferOverhead]u8 = []
  target_raw := terminated(target, target_storage[..])
  link_raw := terminated(link, link_storage[..])
  if target_raw == nil || link_raw == nil {
    return Result{ failure: io.Failure{ kind: io.linux(-36), native: -36 } }
  }
  value := #syscall(266, target_raw, -100, link_raw)
  if value < 0 {
    return Result{ failure: io.Failure{ kind: io.linux(value), native: value } }
  }
  return Result{}
}

fn read_link_into(path: []const u8, destination: []u8) PathResult {
  storage: [4096 + mem.ArenaBufferOverhead]u8 = []
  raw := terminated(path, storage[..])
  if raw == nil {
    return PathResult{ value: destination[..0], failure: io.Failure{ kind: io.linux(-36), native: -36 } }
  }
  if #len(destination) == 0 {
    return PathResult{ value: destination[..0], failure: io.Failure{ kind: io.linux(-22), native: -22 } }
  }
  value := #syscall(267, -100, raw, &destination[0], #len(destination))
  if value < 0 {
    return PathResult{ value: destination[..0], failure: io.Failure{ kind: io.linux(value), native: value } }
  }
  return PathResult{ value: destination[..#cast(usize, value)], failure: io.Failure{ kind: io.linux(0), native: 0 } }
}

pub fn sync_directory(path: []const u8) Result {
  opened := open_flags(path, directory_flag, 0)
  if opened.failure.kind != io.Kind.Ok {
    return Result{ failure: io.Failure{ kind: io.linux(opened.failure.native), native: opened.failure.native } }
  }
  synced := sync(&opened.value)
  close(&opened.value)
  return synced
}

pub struct AtomicFile {
  file: File,
  destination: []const u8,
  temporary: []const u8,
  active: bool,
}
pub type AtomicResult = io.Result(AtomicFile)

// Both paths are borrowed until commit/abort. Temporary must be a sibling chosen by caller.
pub fn atomic_begin(destination: []const u8, temporary: []const u8) AtomicResult {
  if #len(destination) == 0 || #len(temporary) == 0 {
    return AtomicResult{ failure: io.Failure{ kind: io.linux(-22), native: -22 } }
  }
  created := create_exclusive(temporary)
  if created.failure.kind != io.Kind.Ok {
    return AtomicResult{ failure: io.Failure{ kind: io.linux(created.failure.native), native: created.failure.native } }
  }
  return AtomicResult{ value: AtomicFile{
    file: created.value,
    destination: destination,
    temporary: temporary,
    active: true,
  } }
}

pub fn atomic_commit(transaction: *AtomicFile) Result {
  if !transaction.active {
    return Result{ transferred: 0, failure: io.Failure{ kind: io.linux(-22), native: -22 } }
  }
  synced := sync(&transaction.file)
  if synced.failure.kind != io.Kind.Ok {
    return synced
  }
  close(&transaction.file)
  renamed := rename(transaction.temporary, transaction.destination)
  if renamed.failure.kind == io.Kind.Ok {
    transaction.active = false
  }
  return renamed
}

// Also syncs parent directory, making committed rename durable across power loss on Linux filesystems
// which honor fsync for files and directories.
pub fn atomic_commit_durable(transaction: *AtomicFile, parent_directory: []const u8) Result {
  committed := atomic_commit(transaction)
  if committed.failure.kind != io.Kind.Ok {
    return committed
  }
  return sync_directory(parent_directory)
}

pub fn atomic_abort(transaction: *AtomicFile) Result {
  if !transaction.active {
    return Result{ transferred: 0, failure: io.Failure{ kind: io.linux(-22), native: -22 } }
  }
  if is_open(&transaction.file) {
    close(&transaction.file)
  }
  removed := remove(transaction.temporary)
  if removed.failure.kind == io.Kind.Ok {
    transaction.active = false
  }
  return removed
}

// Writes through an explicitly named sibling temporary file and atomically renames it.
pub fn write_atomic(destination: []const u8, temporary: []const u8, source: []const u8) Result {
  transaction_result := atomic_begin(destination, temporary)
  if transaction_result.failure.kind != io.Kind.Ok {
    return Result{ failure: io.Failure{ kind: io.linux(transaction_result.failure.native), native: transaction_result.failure.native } }
  }
  transaction := transaction_result.value
  written := write(&transaction.file, source)
  if written.failure.kind != io.Kind.Ok {
    _ = atomic_abort(&transaction)
    return written
  }
  committed := atomic_commit(&transaction)
  if committed.failure.kind != io.Kind.Ok {
    if transaction.active {
      _ = atomic_abort(&transaction)
    }
    return committed
  }
  return Result{ transferred: written.transferred }
}

fn environment_get(name: []const u8, destination: []u8) PathResult {
  result := platform.environment_get(name, destination)
  if !result.ok {
    return PathResult{ value: destination[..0], failure: io.Failure{ kind: io.linux(result.error), native: result.error } }
  }
  if !result.found {
    return PathResult{ value: destination[..0], failure: io.Failure{ kind: io.linux(-2), native: -2 } }
  }
  return PathResult{ value: result.value }
}

fn append_suffix(destination: []u8, base: []const u8, suffix: []const u8) PathResult {
  if #len(base) + #len(suffix) > #len(destination) {
    return PathResult{ value: destination[..0], failure: io.Failure{ kind: io.linux(-28), native: -28 } }
  }
  i: usize = 0
  for i < #len(base) {
    destination[i] = base[i]
    i += 1
  }
  for j in 0..#len(suffix) {
    destination[i + j] = suffix[j]
  }
  return PathResult{ value: destination[..#len(base) + #len(suffix)], failure: io.Failure{ kind: io.linux(0), native: 0 } }
}

fn app_directory_into(kind: AppDirectory, destination: []u8) PathResult {
  if kind == AppDirectory.Home {
    direct_home := environment_get("HOME", destination)
    if direct_home.failure.kind == io.Kind.Ok && #len(direct_home.value) == 0 {
      return PathResult{ value: destination[..0], failure: io.Failure{ kind: io.linux(-2), native: -2 } }
    }
    return direct_home
  }
  if kind == AppDirectory.Runtime {
    runtime := environment_get("XDG_RUNTIME_DIR", destination)
    if runtime.failure.kind == io.Kind.Ok && #len(runtime.value) == 0 {
      return PathResult{ value: destination[..0], failure: io.Failure{ kind: io.linux(-2), native: -2 } }
    }
    return runtime
  }
  variable: []const u8 = "XDG_CONFIG_HOME"
  suffix: []const u8 = "/.config"
  if kind == AppDirectory.Cache {
    variable = "XDG_CACHE_HOME"
    suffix = "/.cache"
  }
  else if kind == AppDirectory.Data {
    variable = "XDG_DATA_HOME"
    suffix = "/.local/share"
  }
  configured := environment_get(variable, destination)
  if configured.failure.kind == io.Kind.Ok && #len(configured.value) > 0 {
    return configured
  }
  home_storage: [4096]u8 = []
  fallback_home := environment_get("HOME", home_storage[..])
  if fallback_home.failure.kind != io.Kind.Ok {
    return PathResult{ value: destination[..0], failure: io.Failure{ kind: io.linux(fallback_home.failure.native), native: fallback_home.failure.native } }
  }
  return append_suffix(destination, fallback_home.value, suffix)
}

pub fn lock(file: *File, operation: usize) Result {
  if !is_open(file) {
    return Result{ failure: io.Failure{ kind: io.Kind.InvalidState, native: -9 } }
  }
  value := #syscall(73, file.descriptor, operation)
  for value == -4 {
    value = #syscall(73, file.descriptor, operation)
  }
  if value < 0 {
    return Result{ failure: io.Failure{ kind: io.linux(value), native: value } }
  }
  return Result{}
}
pub fn truncate(path: []const u8, length: usize) Result {
  if length > 9223372036854775807 {
    return Result{ failure: io.Failure{ kind: io.linux(-22), native: -22 } }
  }
  storage: [4096 + mem.ArenaBufferOverhead]u8 = []
  name := terminated(path, storage[..])
  if name == nil {
    return Result{ failure: io.Failure{ kind: io.linux(-36), native: -36 } }
  }
  value := #syscall(76, name, length)
  if value < 0 {
    return Result{ failure: io.Failure{ kind: io.linux(value), native: value } }
  }
  return Result{}
}

fn kept(arena: *mem.Arena, mark: usize, result: PathResult) PathResult {
  if result.failure.kind != io.Kind.Ok {
    mem.arena_rewind(arena, mark)
    return result
  }
  mem.arena_rewind(arena, mark + #len(result.value))
  return result
}

// The target of the symbolic link at path, in arena.
pub fn read_link(arena: *mem.Arena, path: []const u8) PathResult {
  mark := mem.arena_mark(arena)
  return kept(arena, mark, read_link_into(path, mem.push_bytes_uninit(arena, 4096)))
}

// The per-user directory of kind, in arena.
pub fn app_directory(arena: *mem.Arena, kind: AppDirectory) PathResult {
  mark := mem.arena_mark(arena)
  return kept(arena, mark, app_directory_into(kind, mem.push_bytes_uninit(arena, 4096)))
}
