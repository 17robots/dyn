#target(kernel: linux)
use io "std/io"
use mem "std/mem"
use cstrings "std/c"
use platform "std/os/linux"
use "std/os/linux/sys"

pub enum AppDirectory { Home, Config, Cache, Data, Runtime }
pub struct Directory {
  file: File,
  storage: []u8,
  offset: usize,
  used: usize,
  path: []const u8,
  // Set by directory_next when it returns no entry.
  ended: bool,
}

fn terminated(path: []const u8, storage: []u8) *const u8 {
  if path.len == 0 { return nil }
  return cstrings.string_into(storage, path) catch nil
}

fn native_open_directory(path: []const u8, storage: []u8, directory: *Directory) isize {
  if storage.len < 24 { return -22 }
  opened := open_flags(path, directory_flag, 0)
  if opened < 0 { return opened }
  directory.* = Directory{ file: owned_file(opened), storage: storage }
  return 0
}

// Entry name borrows directory storage and may be invalidated by next refill.
fn native_directory_next(directory: *Directory, entry: *DirectoryEntry) isize {
  if !is_open(&directory.file) || directory.storage.len < 24 { return -9 }
  for {
    if directory.offset >= directory.used {
      value := #syscall(sys.Getdents64, directory.file.descriptor, &directory.storage[0], directory.storage.len)
      for value == -4 {
        value = #syscall(sys.Getdents64, directory.file.descriptor, &directory.storage[0], directory.storage.len)
      }
      if value < 0 { return value }
      if value == 0 { return 0 }
      directory.offset = 0
      directory.used = #cast(usize, value)
    }
    if directory.offset + 19 > directory.used { return -5 }
    low := #cast(usize, directory.storage[directory.offset + 16])
    high := #cast(usize, directory.storage[directory.offset + 17])
    record_length := low + high * 256
    if record_length < 20 || directory.offset + record_length > directory.used { return -5 }
    name_start := directory.offset + 19
    name_end := name_start
    for name_end < directory.offset + record_length && directory.storage[name_end] != 0 {
      name_end += 1
    }
    kind := directory.storage[directory.offset + 18]
    directory.offset += record_length
    name := directory.storage[name_start..name_end]
    dot := name.len == 1 && name[0] == '.'
    dot_dot := name.len == 2 && name[0] == '.' && name[1] == '.'
    if !dot && !dot_dot {
      entry.* = DirectoryEntry{ name: name, kind: entry_kind(kind) }
      return 0
    }
  }
  return 0
}

pub fn close_directory(directory: *Directory) {
  directory.offset = 0
  directory.used = 0
  close(&directory.file)
}

// Copies source to destination, replacing it, and returns the bytes copied.
// scratch is the copy buffer. A failed close is not reported: sync the
// destination when it must be durable. An empty scratch, the same file on
// both sides, or something other than regular files fail with InvalidInput.
pub fn copy_file(source: []const u8, destination: []const u8, scratch: []u8) usize!io.IoErr {
  if scratch.len == 0 { fail .InvalidInput }
  input := try open(source)
  defer close(&input)
  output_opened := open_flags(destination, 65, 420)
  if output_opened < 0 { fail native_err(output_opened) }
  output := owned_file(output_opened)
  output.path = destination
  defer close(&output)
  source_info := try file_metadata(&input)
  destination_info := try file_metadata(&output)
  if source_info.device == destination_info.device && source_info.inode == destination_info.inode { fail .InvalidInput }
  if !is_file(source_info) || !is_file(destination_info) { fail .InvalidInput }
  try check(#syscall(sys.Ftruncate, output.descriptor, 0))
  copied: usize = 0
  for {
    count := try read(&input, scratch)
    if count == 0 { break }
    try write(&output, scratch[..count])
    copied += count
  }
  return copied
}

// statx has one fixed layout on supported Linux architectures (Linux 4.11+).
// Descriptor lookup avoids path replacement races and does not change file position.
fn native_file_metadata(file: *const File, info: *Metadata) isize {
  if !is_open(file) { return -9 }
  raw: [32]u64
  empty: [1]u8
  result := #syscall(sys.Statx, file.descriptor, &empty[0], 4096, 2047, &raw[0])
  if result < 0 { return result }
  if (raw[0] & 769) != 769 { return -95 }
  info.* = Metadata{ size: raw[5], inode: raw[4], device: raw[17], mode: #cast(u16, (raw[3] >> 32)) }
  return 0
}
fn native_metadata(path: []const u8, info: *Metadata) isize {
  descriptor := native_open(path, 0)
  if descriptor < 0 { return descriptor }
  opened := owned_file(descriptor)
  code := native_file_metadata(&opened, info)
  close(&opened)
  return code
}

fn native_remove(path: []const u8) isize {
  storage: [4096 + mem.ArenaBufferOverhead]u8
  raw := terminated(path, storage[..])
  if raw == nil { return -36 }
  return #syscall(sys.Unlinkat, -100, raw, 0)
}
fn native_remove_directory(path: []const u8) isize {
  storage: [4096 + mem.ArenaBufferOverhead]u8
  raw := terminated(path, storage[..])
  if raw == nil { return -36 }
  return #syscall(sys.Unlinkat, -100, raw, 512)
}
fn native_make_directory(path: []const u8, mode: usize) isize {
  storage: [4096 + mem.ArenaBufferOverhead]u8
  raw := terminated(path, storage[..])
  if raw == nil { return -36 }
  return #syscall(sys.Mkdirat, -100, raw, mode)
}
fn native_rename(old_path: []const u8, new_path: []const u8) isize {
  old_storage: [4096 + mem.ArenaBufferOverhead]u8
  new_storage: [4096 + mem.ArenaBufferOverhead]u8
  old_raw := terminated(old_path, old_storage[..])
  new_raw := terminated(new_path, new_storage[..])
  if old_raw == nil || new_raw == nil { return -36 }
  // renameat2 with no flags: riscv64 has no renameat.
  return #syscall(sys.Renameat2, -100, old_raw, -100, new_raw, 0)
}

// Creates the symbolic link link pointing at target.
pub fn symbolic_link(target: []const u8, link: []const u8) !io.IoErr {
  target_storage: [4096 + mem.ArenaBufferOverhead]u8
  link_storage: [4096 + mem.ArenaBufferOverhead]u8
  target_raw := terminated(target, target_storage[..])
  link_raw := terminated(link, link_storage[..])
  if target_raw == nil || link_raw == nil { fail native_err(-36) }
  try check(#syscall(sys.Symlinkat, target_raw, -100, link_raw))
}

// Makes a directory's entries durable, such as a rename into it.
pub fn sync_directory(path: []const u8) !io.IoErr {
  opened := open_flags(path, directory_flag, 0)
  if opened < 0 { fail native_err(opened) }
  directory := owned_file(opened)
  directory.path = path
  defer close(&directory)
  try sync(&directory)
}

// A file written under a temporary name and renamed onto its destination
// when committed, so the destination is never partly written.
pub struct AtomicFile {
  file: File,
  destination: []const u8,
  temporary: []const u8,
  active: bool,
}

// Both paths are borrowed until commit or abort. temporary must be a sibling
// of destination (same directory), chosen by the caller. Empty paths fail
// with InvalidInput.
pub fn atomic_begin(destination: []const u8, temporary: []const u8) AtomicFile!io.IoErr {
  if destination.len == 0 || temporary.len == 0 { fail .InvalidInput }
  created := try create_exclusive(temporary)
  return AtomicFile{ file: created, destination: destination, temporary: temporary, active: true }
}

// Syncs and closes the temporary file and renames it onto the destination.
// A transaction that is not active fails with InvalidInput.
pub fn atomic_commit(transaction: *AtomicFile) !io.IoErr {
  if !transaction.active { fail .InvalidInput }
  try sync(&transaction.file)
  close(&transaction.file)
  try rename(transaction.temporary, transaction.destination)
  transaction.active = false
}

// Also syncs the parent directory, making the committed rename durable across
// power loss on Linux file systems that honor fsync for directories.
pub fn atomic_commit_durable(transaction: *AtomicFile, parent_directory: []const u8) !io.IoErr {
  try atomic_commit(transaction)
  try sync_directory(parent_directory)
}

// Closes and removes the temporary file. Cleanup: it cannot fail and runs
// after any failure; a file it cannot remove is left behind.
pub fn atomic_abort(transaction: *AtomicFile) {
  if !transaction.active { return }
  close(&transaction.file)
  _ = native_remove(transaction.temporary)
  transaction.active = false
}

// Writes source to destination through the sibling temporary file and renames
// it into place, so destination is either the old file or all of source.
pub fn write_atomic(destination: []const u8, temporary: []const u8, source: []const u8) !io.IoErr {
  transaction := try atomic_begin(destination, temporary)
  defer atomic_abort(&transaction)
  try write(&transaction.file, source)
  try atomic_commit(&transaction)
}

// An environment variable that is unset or empty fails with NotFound.
fn environment_into(variable: []const u8, destination: []u8) []u8!io.IoErr {
  value := try platform.environment_get(variable, destination)
  if value.len == 0 { fail .NotFound }
  return value
}

fn app_directory_into(kind: AppDirectory, destination: []u8) []u8!io.IoErr {
  if kind == AppDirectory.Home || kind == AppDirectory.Runtime {
    variable: []const u8 = "HOME"
    if kind == AppDirectory.Runtime {
      variable = "XDG_RUNTIME_DIR"
    }
    return try environment_into(variable, destination)
  }
  variable: []const u8 = "XDG_CONFIG_HOME"
  suffix: []const u8 = "/.config"
  if kind == AppDirectory.Cache {
    variable = "XDG_CACHE_HOME"
    suffix = "/.cache"
  } else if kind == AppDirectory.Data {
    variable = "XDG_DATA_HOME"
    suffix = "/.local/share"
  }
  configured := environment_into(variable, destination) catch destination[..0]
  if configured.len > 0 { return configured }
  home := try environment_into("HOME", destination)
  if home.len + suffix.len > destination.len { fail .Capacity }
  for j in 0..suffix.len {
    destination[home.len + j] = suffix[j]
  }
  return destination[..home.len + suffix.len]
}

// Locks file with flock(2): operation is LOCK_SH (1), LOCK_EX (2), or either
// with LOCK_NB (4); LOCK_UN (8) unlocks.
pub fn lock(file: *File, operation: usize) !io.IoErr {
  try usable(file)
  value := #syscall(sys.Flock, file.descriptor, operation)
  for value == -4 {
    value = #syscall(sys.Flock, file.descriptor, operation)
  }
  try check(value)
}
// Sets the length of the file at path. A length past #max(i64) fails with
// InvalidInput.
pub fn truncate(path: []const u8, length: usize) !io.IoErr {
  if length > 9223372036854775807 { fail .InvalidInput }
  storage: [4096 + mem.ArenaBufferOverhead]u8
  name := terminated(path, storage[..])
  if name == nil { fail native_err(-36) }
  try check(#syscall(sys.Truncate, name, length))
}

// The target of the symbolic link at path, in arena.
pub fn read_link(arena: *mem.Arena, path: []const u8) []u8!io.IoErr {
  storage: [4096 + mem.ArenaBufferOverhead]u8
  raw := terminated(path, storage[..])
  if raw == nil { fail native_err(-36) }
  mark := mem.arena_mark(arena)
  errdefer mem.arena_rewind(arena, mark)
  destination := mem.push_bytes(arena, 4096)
  count := #syscall(sys.Readlinkat, -100, raw, &destination[0], destination.len)
  try check(count)
  mem.arena_rewind(arena, mark + #cast(usize, count))
  return destination[..#cast(usize, count)]
}

// The per-user directory of kind, in arena.
pub fn app_directory(arena: *mem.Arena, kind: AppDirectory) []u8!io.IoErr {
  mark := mem.arena_mark(arena)
  errdefer mem.arena_rewind(arena, mark)
  value := try app_directory_into(kind, mem.push_bytes(arena, 4096))
  mem.arena_rewind(arena, mark + value.len)
  return value
}
