module collections

heap := use "heap"
Allocator := heap.Allocator
AllocError := heap.AllocError

pub Vec := (T: comp type) type => struct {
    items: []T,
    len: usize,
    cap: usize,
    allocator: Allocator,

    from_parts := (allocator: Allocator, ptr: usize, len: usize, cap: usize) Vec(T) => {
        base := $as(*mut T, ptr)
        return .{
            items: base[0..len],
            len: len,
            cap: cap,
            allocator: allocator,
        }
    },

    new := (allocator: Allocator) Vec(T) => Vec(T).from_parts(allocator, 0, 0, 0),

    items_ptr := (self: Vec(T)) usize => if self.cap == 0 0 else $as(usize, self.items),

    items_len := (self: Vec(T)) usize => self.len,

    ptr := (self: Vec(T), idx: usize) usize =>
        self.items_ptr() + (idx * comp $sizeof(T)),

    reserve := (self: Vec(T), new_cap: usize) Vec(T)!AllocError => {
        if new_cap <= self.cap return self
        old_ptr := self.items_ptr()
        next_ptr := if old_ptr == 0
            self.allocator.alloc(T, new_cap) or |err| return err
        else
            self.allocator.realloc(T, old_ptr, self.cap, new_cap) or |err| return err
        return Vec(T).from_parts(self.allocator, next_ptr, self.len, new_cap)
    },

    clear := (self: Vec(T)) Vec(T) =>
        Vec(T).from_parts(self.allocator, self.items_ptr(), 0, self.cap),

    deinit := (self: Vec(T)) u32 => {
        if self.cap == 0 return 1
        return self.allocator.free(T, self.items_ptr(), self.cap)
    },

    push_bytes := (self: Vec(T), src: usize) Vec(T)!AllocError => {
        next := if self.len == self.cap
            self.reserve(if self.cap == 0 4 else self.cap * 2) or |err| return err
        else
            self
        if next.len == next.cap return next
        elem_size := comp $sizeof(T)
        dst := next.items_ptr() + (next.len * elem_size)
        __dyn_mem_copy(dst, src, elem_size)
        return Vec(T).from_parts(next.allocator, next.items_ptr(), next.len + 1, next.cap)
    },

    get_bytes := (self: Vec(T), idx: usize, dst: usize) u32 => {
        if idx >= self.len return 0
        elem_size := comp $sizeof(T)
        src := self.items_ptr() + (idx * elem_size)
        __dyn_mem_copy(dst, src, elem_size)
        return 1
    },

    set_bytes := (self: Vec(T), idx: usize, src: usize) u32 => {
        if idx >= self.len return 0
        elem_size := comp $sizeof(T)
        dst := self.items_ptr() + (idx * elem_size)
        __dyn_mem_copy(dst, src, elem_size)
        return 1
    },

    pop_bytes := (self: Vec(T), dst: usize) Vec(T) => {
        if self.len == 0 return self
        elem_size := comp $sizeof(T)
        src := self.items_ptr() + ((self.len - 1) * elem_size)
        __dyn_mem_copy(dst, src, elem_size)
        return Vec(T).from_parts(self.allocator, self.items_ptr(), self.len - 1, self.cap)
    },
}
