use mem "std/mem"
use cabi "std/c"
use io "std/io"
// Dynamic-loader adapter for Linux, macOS and Windows. Handles own loader
// references; symbols borrow them. Symbols are invalid after the library is
// successfully closed. On Linux, linking requires libc (or libdl on older
// systems). Flags apply only to POSIX loaders; Windows ignores them.
// Windows failures carry the system's error code.
pub type Handle = rawptr

pub const Lazy: i32 = 1
pub const Now: i32 = 2
pub const Local: i32 = 0
pub const Global: i32 = 256

// Opens the library at path. The loader gives no reason on POSIX, so a
// library that does not load fails with NotFound; Windows keeps its code. A
// path too long to pass fails with InvalidInput.
pub fn open(path: []const u8, flags: i32) Handle!io.IoErr {
  storage: [4096 + mem.ArenaBufferOverhead]u8
  if path.len >= storage.len { fail .InvalidInput }
  name := try cabi.string_into(storage[..], path)
  return try platform_open(name, flags)
}

// The address of the symbol called name. A symbol may itself be nil; a
// missing one fails with NotFound, and a handle that is not open with
// InvalidInput.
pub fn symbol(handle: Handle, name: []const u8) rawptr!io.IoErr {
  if handle == nil { fail .InvalidInput }
  storage: [4096 + mem.ArenaBufferOverhead]u8
  if name.len >= storage.len { fail .InvalidInput }
  native_name := try cabi.string_into(storage[..], name)
  return try platform_symbol(handle, native_name)
}

// Clears the owned handle only after a successful close. Failure retains
// ownership; a handle that is not open fails with InvalidInput.
pub fn close(handle: *Handle) !io.IoErr {
  if handle == nil || handle.* == nil { fail .InvalidInput }
  try platform_close(handle.*)
  handle.* = nil
}
