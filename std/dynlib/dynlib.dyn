use "std/mem" mem
use "std/c" cabi
use "std/fail"
// Dynamic-loader adapter for Linux, macOS and Windows. Handles own loader
// references; symbols borrow them. Symbols are invalid after the library is
// successfully closed. On Linux, linking requires libc (or libdl on older
// systems). Flags apply only to POSIX loaders; Windows ignores them.
// Failures carry the loader's own text (dlerror) or the Windows error code.
pub type Handle = rawptr

pub const Lazy: i32 = 1
pub const Now: i32 = 2
pub const Local: i32 = 0
pub const Global: i32 = 256

// Opens the library at path; nil after a failure.
pub fn open(status: *fail.Status, path: []const u8, flags: i32) Handle {
  if status.failed { return nil }
  storage: [4096 + mem.ArenaBufferOverhead]u8
  if #len(path) >= #len(storage) {
    fail.invalid(status, "load library", path, "the path is too long")
    return nil
  }
  name := cabi.string_into(status, storage[..], path)
  if status.failed { return nil }
  return platform_open(status, name, path, flags)
}

// The address of the symbol called name; nil after a failure. A symbol may
// itself be nil: check status.failed, not the address.
pub fn symbol(status: *fail.Status, handle: Handle, name: []const u8) rawptr {
  if status.failed { return nil }
  if handle == nil {
    fail.set(status, fail.make(fail.Kind.InvalidState, "find symbol", name, "the library is not open"))
    return nil
  }
  storage: [4096 + mem.ArenaBufferOverhead]u8
  if #len(name) >= #len(storage) {
    fail.invalid(status, "find symbol", name, "the name is too long")
    return nil
  }
  native_name := cabi.string_into(status, storage[..], name)
  if status.failed { return nil }
  return platform_symbol(status, handle, native_name, name)
}

// Clears the owned handle only after a successful close. Failure retains ownership.
pub fn close(status: *fail.Status, handle: *Handle) {
  if status.failed { return }
  if handle == nil || handle.* == nil {
    fail.set(status, fail.make(fail.Kind.InvalidState, "close library", "", "the library is not open"))
    return
  }
  platform_close(status, handle.*)
  if !status.failed {
    handle.* = nil
  }
}

// Records a POSIX loader failure with dlerror's text.
fn loader_failed(status: *fail.Status, operation: []const u8, path: []const u8, message: *const u8) {
  reading: fail.Status
  text := cabi.bytes_from_string(&reading, message, 4096)
  fail.set(status, fail.make(fail.Kind.System, operation, path, text))
}
