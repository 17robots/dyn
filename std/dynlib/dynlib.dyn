use "std/parse" parse
use "std/mem" mem
use "std/c" cabi
use "std/io" io
// Dynamic-loader adapter for Linux, macOS and Windows. Handles own loader
// references; symbols borrow them. Symbols are invalid after the library is
// successfully closed. On Linux, linking requires libc (or libdl on older
// systems). Flags apply only to POSIX loaders; Windows ignores them.
pub type Handle = rawptr

pub const Lazy: i32 = 1
pub const Now: i32 = 2
pub const Local: i32 = 0
pub const Global: i32 = 256

pub struct OpenResult { value: Handle, message: *const u8, failure: io.Failure }
pub struct SymbolResult { value: rawptr, message: *const u8, failure: io.Failure }

// Loader messages borrow storage until the next loader operation.
// POSIX dlerror supplies text, not a native integer code; error remains zero.
// Windows supplies a GetLastError code in error; message stays nil.
pub struct Result { message: *const u8, failure: io.Failure }

pub fn open(path: []const u8, flags: i32) OpenResult {
  storage: [4096 + mem.ArenaBufferOverhead]u8 = []
  if #len(path) >= #len(storage) {
    return OpenResult{ failure: io.Failure{ kind: io.Kind.InvalidInput } }
  }
  name := cabi.string_into(storage[..], path)
  if name.failure.kind != parse.Kind.Ok {
    return OpenResult{ failure: io.Failure{ kind: io.Kind.InvalidInput } }
  }
  return platform_open(name.value, flags)
}

pub fn symbol(handle: Handle, name: []const u8) SymbolResult {
  if handle == nil {
    return SymbolResult{ failure: io.Failure{ kind: io.Kind.InvalidState } }
  }
  storage: [4096 + mem.ArenaBufferOverhead]u8 = []
  if #len(name) >= #len(storage) {
    return SymbolResult{ failure: io.Failure{ kind: io.Kind.InvalidInput } }
  }
  native_name := cabi.string_into(storage[..], name)
  if native_name.failure.kind != parse.Kind.Ok {
    return SymbolResult{ failure: io.Failure{ kind: io.Kind.InvalidInput } }
  }
  return platform_symbol(handle, native_name.value)
}

// Clears the owned handle only after a successful close. Failure retains ownership.
pub fn close(handle: *Handle) Result {
  if handle == nil {
    return Result{ failure: io.Failure{ kind: io.Kind.InvalidInput } }
  }
  value := handle.*
  if value == nil {
    return Result{ failure: io.Failure{ kind: io.Kind.InvalidState } }
  }
  closed := platform_close(value)
  if !io.failed(closed.failure) {
    handle.* = nil
  }
  return closed
}

// Returned bytes borrow loader-owned storage and die at next loader operation.
pub fn last_error(maximum: usize) cabi.BytesResult {
  return cabi.bytes_from_string(platform_error(), maximum)
}

pub fn error_bytes(error: *const u8, maximum: usize) cabi.BytesResult {
  return cabi.bytes_from_string(error, maximum)
}
