#target(kernel: darwin)

extern fn native_open "dlopen"(path: *const u8, flags: i32) rawptr
extern fn native_symbol "dlsym"(handle: rawptr, name: *const u8) rawptr
extern fn native_close "dlclose"(handle: rawptr) i32
extern fn native_error "dlerror"() *const u8

fn platform_open(path: *const u8, flags: i32) Handle!io.IoErr {
  _ = native_error()
  value := native_open(path, flags)
  if value == nil { fail .NotFound }
  return value
}

fn platform_symbol(handle: Handle, name: *const u8) rawptr!io.IoErr {
  // POSIX requires clearing prior error because a valid symbol may be null.
  _ = native_error()
  value := native_symbol(handle, name)
  if native_error() != nil { fail .NotFound }
  return value
}

fn platform_close(handle: Handle) !io.IoErr {
  _ = native_error()
  if native_close(handle) != 0 { fail .InvalidInput }
}
