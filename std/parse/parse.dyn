use "std/io" io
// Shared failure for parsers and decoders. Input decides the result, so a
// failure names where the input went wrong instead of a system error code.
pub enum Kind { Ok, Syntax, Truncated, Overflow, Capacity, Unsupported, Checksum, Overlap }

// Kind.Ok is the zero value, so a zero Failure means success. The message is
// static text; offset counts bytes from the start of the input.
pub struct Failure { kind: Kind, offset: usize, message: []const u8 }

// A stream decoder fails on its input text or on the stream that carries it.
// Whether a step failed. Kind.Ok is the zero value, so a zero Failure succeeded.
pub fn failed(failure: Failure) bool {
  return failure.kind != Kind.Ok
}

pub enum StreamKind { Ok, Parse, Io }
pub struct StreamFailure { kind: StreamKind, parse: Failure, io: io.Failure }

pub fn parse_failure(kind: Kind, offset: usize, message: []const u8) StreamFailure {
  return StreamFailure{ kind: StreamKind.Parse, parse: Failure{ kind: kind, offset: offset, message: message } }
}

pub fn io_failure(kind: io.Kind, native: isize) StreamFailure {
  return StreamFailure{ kind: StreamKind.Io, io: io.Failure{ kind: kind, native: native } }
}

// Payload readers speak io.Transfer, so a parse failure maps to the nearest io kind.
pub fn stream_result(failure: StreamFailure, transferred: usize) io.Transfer {
  kind := io.Kind.InvalidInput
  if failure.kind == StreamKind.Io {
    kind = failure.io.kind
  } else if failure.parse.kind == Kind.Capacity {
    kind = io.Kind.Capacity
  } else if failure.parse.kind == Kind.Overflow {
    kind = io.Kind.Overflow
  }
  return io.Transfer{ transferred: transferred, failure: io.Failure{ kind: kind, native: failure.io.native } }
}

// A value and how decoding went. value is zero or partial on failure.
pub struct Result(T) { value: T, failure: Failure }
// Decoded or encoded bytes, for codecs with nothing else to report.
pub type Bytes = Result([]u8)

// Whole text as a decimal u64: one or more ASCII digits, nothing else (no
// sign, space or underscore). Syntax at the first bad byte; Overflow past
// the u64 range.
pub fn u64_decimal(text: []const u8) Result(u64) {
  if #len(text) == 0 {
    return Result(u64){ failure: Failure{ kind: Kind.Syntax, message: "expected digits" } }
  }
  value: u64 = 0
  for i in 0..#len(text) {
    byte := text[i]
    if byte < '0' || byte > '9' {
      return Result(u64){ failure: Failure{ kind: Kind.Syntax, offset: i, message: "expected a digit" } }
    }
    digit := #cast(u64, byte - '0')
    if value > (18446744073709551615 - digit) / 10 {
      return Result(u64){ failure: Failure{ kind: Kind.Overflow, offset: i, message: "number exceeds u64" } }
    }
    value = value * 10 + digit
  }
  return Result(u64){ value: value }
}

// Whole text as a decimal i64 with an optional leading '-'.
pub fn i64_decimal(text: []const u8) Result(i64) {
  negative := #len(text) > 0 && text[0] == '-'
  start: usize = 0
  if negative {
    start = 1
  }
  magnitude := u64_decimal(text[start..])
  if magnitude.failure.kind != Kind.Ok {
    failure := magnitude.failure
    failure.offset += start
    return Result(i64){ failure: failure }
  }
  if negative {
    if magnitude.value > 9223372036854775808 {
      return Result(i64){ failure: Failure{ kind: Kind.Overflow, offset: start, message: "number below i64 minimum" } }
    }
    return Result(i64){ value: #cast(i64, 0 - magnitude.value) }
  }
  if magnitude.value > 9223372036854775807 {
    return Result(i64){ failure: Failure{ kind: Kind.Overflow, offset: start, message: "number exceeds i64" } }
  }
  return Result(i64){ value: #cast(i64, magnitude.value) }
}
