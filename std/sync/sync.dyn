#target(kernel: linux)

pub struct AtomicU32 { value: u32 }
pub struct AtomicU64 { value: u64 }

extern fn load_u32_raw "dyn_atomic_load_u32"(value: *const u32) u32
extern fn store_u32_raw "dyn_atomic_store_u32"(value: *u32, desired: u32)
extern fn exchange_u32_raw "dyn_atomic_exchange_u32"(value: *u32, desired: u32) u32
extern fn fetch_add_u32_raw "dyn_atomic_fetch_add_u32"(value: *u32, amount: u32) u32
extern fn compare_exchange_u32_raw "dyn_atomic_compare_exchange_u32"(value: *u32, expected: u32, desired: u32) bool
extern fn load_u64_raw "dyn_atomic_load_u64"(value: *const u64) u64
extern fn store_u64_raw "dyn_atomic_store_u64"(value: *u64, desired: u64)
extern fn exchange_u64_raw "dyn_atomic_exchange_u64"(value: *u64, desired: u64) u64
extern fn fetch_add_u64_raw "dyn_atomic_fetch_add_u64"(value: *u64, amount: u64) u64
extern fn compare_exchange_u64_raw "dyn_atomic_compare_exchange_u64"(value: *u64, expected: u64, desired: u64) bool

pub fn atomic_u32(value: u32) AtomicU32 { return AtomicU32{ value: value } }
pub fn atomic_u64(value: u64) AtomicU64 { return AtomicU64{ value: value } }
pub fn load_u32(value: *const AtomicU32) u32 { return load_u32_raw(&value.value) }
pub fn store_u32(value: *AtomicU32, desired: u32) { store_u32_raw(&value.value, desired) }
pub fn exchange_u32(value: *AtomicU32, desired: u32) u32 { return exchange_u32_raw(&value.value, desired) }
pub fn fetch_add_u32(value: *AtomicU32, amount: u32) u32 { return fetch_add_u32_raw(&value.value, amount) }
pub fn compare_exchange_u32(value: *AtomicU32, expected: u32, desired: u32) bool { return compare_exchange_u32_raw(&value.value, expected, desired) }
pub fn load_u64(value: *const AtomicU64) u64 { return load_u64_raw(&value.value) }
pub fn store_u64(value: *AtomicU64, desired: u64) { store_u64_raw(&value.value, desired) }
pub fn exchange_u64(value: *AtomicU64, desired: u64) u64 { return exchange_u64_raw(&value.value, desired) }
pub fn fetch_add_u64(value: *AtomicU64, amount: u64) u64 { return fetch_add_u64_raw(&value.value, amount) }
pub fn compare_exchange_u64(value: *AtomicU64, expected: u64, desired: u64) bool { return compare_exchange_u64_raw(&value.value, expected, desired) }


pub struct Mutex { state: AtomicU32 }

pub fn mutex() Mutex { return Mutex{ state: atomic_u32(0) } }

pub fn try_lock(value: *Mutex) bool {
  return compare_exchange_u32(&value.state, 0, 1)
}

pub fn lock(value: *Mutex) {
  if try_lock(value) { return }
  for true {
    previous := exchange_u32(&value.state, 2)
    if previous == 0 { return }
    _ = #syscall(202, &value.state, 0, 2, 0, 0, 0)
  }
}

pub fn unlock(value: *Mutex) {
  previous := exchange_u32(&value.state, 0)
  if previous == 0 { #panic("unlock of unlocked mutex") }
  if previous == 2 { _ = #syscall(202, &value.state, 1, 1, 0, 0, 0) }
}


pub struct Condition { sequence: AtomicU32 }
pub struct Semaphore { count: AtomicU32 }
pub struct Once { state: AtomicU32 }

pub fn condition() Condition { return Condition{ sequence: atomic_u32(0) } }

// Mutex must be held on entry. Spurious wakeups are allowed: always wait in a predicate loop.
pub fn condition_wait(value: *Condition, lock_value: *Mutex) {
  sequence := load_u32(&value.sequence)
  unlock(lock_value)
  result := #syscall(202, &value.sequence, 0, sequence, 0, 0, 0)
  for result == -4 { result = #syscall(202, &value.sequence, 0, sequence, 0, 0, 0) }
  lock(lock_value)
}

pub fn condition_signal(value: *Condition) {
  _ = fetch_add_u32(&value.sequence, 1)
  _ = #syscall(202, &value.sequence, 1, 1, 0, 0, 0)
}
pub fn condition_broadcast(value: *Condition) {
  _ = fetch_add_u32(&value.sequence, 1)
  _ = #syscall(202, &value.sequence, 1, 2147483647, 0, 0, 0)
}

pub fn semaphore(count: u32) Semaphore { return Semaphore{ count: atomic_u32(count) } }
pub fn semaphore_try_wait(value: *Semaphore) bool {
  current := load_u32(&value.count)
  for current > 0 {
    if compare_exchange_u32(&value.count, current, current - 1) { return true }
    current = load_u32(&value.count)
  }
  return false
}
pub fn semaphore_wait(value: *Semaphore) {
  for !semaphore_try_wait(value) { _ = #syscall(202, &value.count, 0, 0, 0, 0, 0) }
}
pub fn semaphore_post(value: *Semaphore) {
  _ = fetch_add_u32(&value.count, 1)
  _ = #syscall(202, &value.count, 1, 1, 0, 0, 0)
}

pub fn once() Once { return Once{ state: atomic_u32(0) } }
// Returns true exactly once. Winner calls initializer then `once_complete`.
pub fn once_begin(value: *Once) bool {
  if compare_exchange_u32(&value.state, 0, 1) { return true }
  for load_u32(&value.state) != 2 { _ = #syscall(202, &value.state, 0, 1, 0, 0, 0) }
  return false
}
pub fn once_complete(value: *Once) {
  if exchange_u32(&value.state, 2) != 1 { #panic("once_complete without once_begin") }
  _ = #syscall(202, &value.state, 1, 2147483647, 0, 0, 0)
}
