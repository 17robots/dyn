#target(pointer_bits: 64)
use "std/errors" errors
use "std/time" time

pub struct Mutex { state: AtomicU32 }

pub fn mutex() Mutex {
  return Mutex{ state: atomic_u32(0) }
}

fn wait_mutex_try_lock(value: *Mutex) bool {
  return compare_exchange_u32(&value.state, 0, 1)
}

fn wait_mutex_lock(value: *Mutex) {
  if wait_mutex_try_lock(value) {
    return
  }
  for true {
    previous := exchange_u32(&value.state, 2)
    if previous == 0 {
      return
    }
    _ = native_wait(&value.state, 2)
  }
}

fn wait_mutex_unlock(value: *Mutex) {
  previous := exchange_u32(&value.state, 0)
  if previous == 0 {
    #panic("unlock of unlocked mutex")
  }
  if previous == 2 {
    native_wake(&value.state, false)
  }
}


pub fn try_lock(value: *Mutex) bool {
  return native_mutex_try_lock(value)
}
pub fn lock(value: *Mutex) {
  native_mutex_lock(value)
}
pub fn unlock(value: *Mutex) {
  native_mutex_unlock(value)
}

pub struct Condition { sequence: AtomicU32 }
pub struct Semaphore { count: AtomicU32 }
pub struct Once { state: AtomicU32 }

pub fn condition() Condition {
  return Condition{ sequence: atomic_u32(0) }
}

// Mutex must be held on entry. Spurious wakeups are allowed: always wait in a predicate loop.
pub fn condition_wait(value: *Condition, lock_value: *Mutex) {
  sequence := load_u32(&value.sequence)
  unlock(lock_value)
  result := native_wait(&value.sequence, sequence)
  for native_wait_interrupted(result) {
    result = native_wait(&value.sequence, sequence)
  }
  lock(lock_value)
}

pub enum ConditionWaitStatus { Signaled, TimedOut }
pub struct ConditionWaitResult { status: ConditionWaitStatus, kind: errors.Kind, error: isize, ok: bool }

// Relative monotonic timeout in nanoseconds. The caller must hold lock_value.
// Every return keeps/reacquires that mutex, including errors. Zero returns
// TimedOut without unlocking; negative durations are InvalidInput. Signaled
// permits spurious wakeups: always recheck the protected predicate. Mutex
// reacquisition and scheduling may finish after the timeout has elapsed.
pub fn condition_wait_timeout(value: *Condition, lock_value: *Mutex, timeout: i64) ConditionWaitResult {
  if timeout < 0 { return ConditionWaitResult{kind:errors.Kind.InvalidInput} }
  if timeout == 0 { return ConditionWaitResult{status:ConditionWaitStatus.TimedOut,ok:true} }
  deadline := time.deadline_after(timeout)
  if !deadline.ok { return ConditionWaitResult{kind:deadline.kind,error:deadline.error} }
  sequence := load_u32(&value.sequence)
  unlock(lock_value)
  result := ConditionWaitResult{}
  for {
    if load_u32(&value.sequence) != sequence {
      result = ConditionWaitResult{status:ConditionWaitStatus.Signaled,ok:true}
      break
    }
    remaining := time.deadline_remaining(&deadline.value)
    if !remaining.ok {
      result = ConditionWaitResult{kind:remaining.kind,error:remaining.error}
      break
    }
    if remaining.value == 0 {
      result = ConditionWaitResult{status:ConditionWaitStatus.TimedOut,ok:true}
      break
    }
    code := native_wait_timeout(&value.sequence,sequence,remaining.value)
    if code == 0 {
      result = ConditionWaitResult{status:ConditionWaitStatus.Signaled,ok:true}
      break
    }
    // Timeouts are checked against the same deadline, including finite native
    // timeout chunks on Windows. EINTR never restarts the original budget.
    if code != 1 && !native_wait_interrupted(code) {
      result = ConditionWaitResult{kind:native_sync_error(code),error:code}
      break
    }
  }
  lock(lock_value)
  return result
}

pub fn condition_signal(value: *Condition) {
  _ = fetch_add_u32(&value.sequence, 1)
  native_wake(&value.sequence, false)
}
pub fn condition_broadcast(value: *Condition) {
  _ = fetch_add_u32(&value.sequence, 1)
  native_wake(&value.sequence, true)
}

pub fn semaphore(count: u32) Semaphore {
  return Semaphore{ count: atomic_u32(count) }
}
pub fn semaphore_try_wait(value: *Semaphore) bool {
  current := load_u32(&value.count)
  for current > 0 {
    if compare_exchange_u32(&value.count, current, current - 1) {
      return true
    }
    current = load_u32(&value.count)
  }
  return false
}
pub fn semaphore_wait(value: *Semaphore) {
  for !semaphore_try_wait(value) {
    _ = native_wait(&value.count, 0)
  }
}
pub fn semaphore_post(value: *Semaphore) {
  _ = fetch_add_u32(&value.count, 1)
  native_wake(&value.count, false)
}

pub fn once() Once {
  return Once{ state: atomic_u32(0) }
}
// Returns true exactly once. Winner calls initializer then `once_complete`.
pub fn once_begin(value: *Once) bool {
  if compare_exchange_u32(&value.state, 0, 1) {
    return true
  }
  for load_u32(&value.state) != 2 {
    _ = native_wait(&value.state, 1)
  }
  return false
}
pub fn once_complete(value: *Once) {
  if exchange_u32(&value.state, 2) != 1 {
    #panic("once_complete without once_begin")
  }
  native_wake(&value.state, true)
}
