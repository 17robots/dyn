#target(kernel: linux)
fn native_wait(address: *AtomicU32, expected: u32) isize {
  return #syscall(202, address, 0, expected, 0, 0, 0)
}
fn native_wake(address: *AtomicU32, all: bool) {
  count: usize = 1
  if all {
    count = 2147483647
  }
  _ = #syscall(202, address, 1, count, 0, 0, 0)
}
fn native_mutex_try_lock(value: *Mutex) bool {
  return wait_mutex_try_lock(value)
}
fn native_mutex_lock(value: *Mutex) {
  wait_mutex_lock(value)
}
fn native_mutex_unlock(value: *Mutex) {
  wait_mutex_unlock(value)
}

fn native_wait_timeout(address: *AtomicU32, expected: u32, duration: i64) isize {
  request := time.Instant{seconds:duration / time.Second, nanoseconds:duration % time.Second}
  code := #syscall(202, address, 0, expected, &request, 0, 0)
  if code == -110 {
    return 1
  }
  if code == -11 {
    return 0
  }
  return code
}
fn native_sync_error(code: isize) errors.Kind {
  return errors.linux(code)
}

fn native_wait_interrupted(code: isize) bool {
  return code == -4
}
