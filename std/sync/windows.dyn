#target(arch: x86_64, kernel: windows)

// WaitOnAddress/WakeByAddress* are process-local synchronization primitives.
// Runtime imports API-MS-Win-Core-Synch-l1-2-0.dll, without SDK import libraries.
extern fn wait_address "dyn_sync_wait"(address: *u32, expected: *const u32, size: usize, milliseconds: u32) i32
extern fn wake_single "dyn_sync_single"(address: *u32)
extern fn wake_all "dyn_sync_all"(address: *u32)
extern fn wait_error "dyn_sync_error"() u32

fn native_wait(address: *AtomicU32, expected: u32) isize {
  compared := expected
  if wait_address(&address.value, &compared, 4, 4294967295) == 0 {
    return 0 - #cast(isize) wait_error()
  }
  return 0
}
fn native_wake(address: *AtomicU32, all: bool) {
  if all { wake_all(&address.value) }
  else { wake_single(&address.value) }
}
fn native_mutex_lock(value: *Mutex) { wait_mutex_lock(value) }
fn native_mutex_try_lock(value: *Mutex) bool { return wait_mutex_try_lock(value) }
fn native_mutex_unlock(value: *Mutex) { wait_mutex_unlock(value) }
