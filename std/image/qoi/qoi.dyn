use "std/fail"
use mem "std/mem"
pub struct Info { width: usize, height: usize, channels: u8, srgb: bool }
// Malformed data fails with
// InvalidInput (at its offset when known), an impossible size with Overflow,
// data past the codec's working limits with Capacity.
pub struct Image { info: Info, pixels: []u8 }
struct DecodeWork { info: Info, pixels: []u8, error: isize, ok: bool, offset: usize }
struct EncodeWork { data: []u8, error: isize, ok: bool }

fn codec_failure(status: *fail.Status, operation: []const u8, detail: isize, offset: usize, located: bool) {
  kind := fail.Kind.InvalidInput
  message: []const u8 = "malformed QOI"
  if detail == -75 {
    kind = fail.Kind.Overflow
    message = "the image is too large"
  } else if detail == -28 {
    kind = fail.Kind.Capacity
    message = "the image exceeds the codec's limits"
  } else if !located {
    message = "invalid pixels or size"
  }
  failure := fail.make(kind, operation, "", message)
  failure.offset = offset
  failure.has_offset = located
  fail.set(status, failure)
}

// The header's description of the image, without decoding it.
pub fn inspect(status: *fail.Status, source: []const u8) Info {
  if status == nil { return inspect(&fail.Status{}, source) }
  if status.failed { return Info{} }
  info := inspect_info(source)
  if info.width == 0 {
    fail.at(status, fail.Kind.InvalidInput, "inspect QOI", "malformed QOI header", 0)
    return Info{}
  }
  return info
}

fn decode_result(status: *fail.Status, work: DecodeWork) Image {
  if !work.ok {
    codec_failure(status, "decode QOI", work.error, work.offset, true)
    return Image{}
  }
  return Image{ info: work.info, pixels: work.pixels }
}

fn encode_result(status: *fail.Status, work: EncodeWork) []u8 {
  if !work.ok {
    codec_failure(status, "encode QOI", work.error, 0, false)
    return work.data[..0]
  }
  return work.data
}

fn u32be(source: []const u8, at: usize) u32 {
  a: u32 = source[at]
  b: u32 = source[at + 1]
  c: u32 = source[at + 2]
  d: u32 = source[at + 3]
  return a * 16777216 + b * 65536 + c * 256 + d
}

// The header, or a zero Info (width 0) when it is malformed.
fn inspect_info(source: []const u8) Info {
  if source.len < 22 || source[0] != 'q' || source[1] != 'o' || source[2] != 'i' || source[3] != 'f' {
    return Info{}
  }
  width := u32be(source, 4)
  height := u32be(source, 8)
  channels := source[12]
  if width == 0 || height == 0 || (channels != 3 && channels != 4) || source[13] > 1 {
    return Info{}
  }
  return Info{ width: width, height: height, channels: channels, srgb: source[13] == 0 }
}

fn packed_pixel(r: u8, g: u8, b: u8, a: u8) u32 {
  return #cast(u32, r) * 16777216 + #cast(u32, g) * 65536 + #cast(u32, b) * 256 + #cast(u32, a)
}

fn hash(r: u8, g: u8, b: u8, a: u8) usize {
  return (#cast(usize, r) * 3 + #cast(usize, g) * 5 + #cast(usize, b) * 7 + #cast(usize, a) * 11) % 64
}

fn add(byte_value: u8, amount: i16) u8 {
  wide: i16 = byte_value + amount
  if wide < 0 {
    wide += 256
  }
  if wide > 255 {
    wide -= 256
  }
  return #cast(u8, wide)
}

fn decode_into(destination: []u8, source: []const u8) DecodeWork {
  info := inspect_info(source)
  if info.width == 0 { return DecodeWork{ error: -22 } }
  count := #cast(usize, info.width) * #cast(usize, info.height)
  if info.width != 0 && count / info.width != info.height { return DecodeWork{ error: -75 } }
  if count > destination.len / 4 { return DecodeWork{ info: info, error: -28 } }
  payload_end := source.len - 8
  for i in 0..8 {
    expected: u8 = 0
    if i == 7 {
      expected = 1
    }
    if source[payload_end + i] != expected {
      return DecodeWork{ info: info, error: -74, offset: payload_end + i }
    }
  }
  table: [64]u32
  red: u8 = 0
  green: u8 = 0
  blue: u8 = 0
  alpha: u8 = 255
  input: usize = 14
  output: usize = 0
  run: usize = 0
  for output < count {
    if run > 0 {
      run -= 1
    } else {
      if input >= source.len - 8 { return DecodeWork{ info: info, error: -74, offset: input } }
      tag := source[input]
      input += 1
      if tag == 254 {
        if input + 3 > source.len - 8 { return DecodeWork{ info: info, error: -74, offset: input } }
        red = source[input]
        green = source[input + 1]
        blue = source[input + 2]
        input += 3
      } else if tag == 255 {
        if input + 4 > source.len - 8 { return DecodeWork{ info: info, error: -74, offset: input } }
        red = source[input]
        green = source[input + 1]
        blue = source[input + 2]
        alpha = source[input + 3]
        input += 4
      } else if (tag & 192) == 0 {
        indexed_pixel := table[(tag & 63)]
        red = (indexed_pixel >> 24)
        green = #cast(u8, (indexed_pixel >> 16))
        blue = #cast(u8, (indexed_pixel >> 8))
        alpha = #cast(u8, indexed_pixel)
      } else if (tag & 192) == 64 {
        red = add(red, #cast(i16, ((tag >> 4) & 3)) - 2)
        green = add(green, #cast(i16, ((tag >> 2) & 3)) - 2)
        blue = add(blue, #cast(i16, (tag & 3)) - 2)
      } else if (tag & 192) == 128 {
        if input == source.len - 8 { return DecodeWork{ info: info, error: -74, offset: input } }
        second := source[input]
        input += 1
        dg: i16 = #cast(i16, (tag & 63)) - 32
        red = add(red, dg - 8 + (second >> 4))
        green = add(green, dg)
        blue = add(blue, dg - 8 + (second & 15))
      } else {
        run = (tag & 63)
        if run >= count - output { return DecodeWork{ info: info, error: -74, offset: input - 1 } }
      }
      table[hash(red, green, blue, alpha)] = packed_pixel(red, green, blue, alpha)
    }
    at := output * 4
    destination[at] = red
    destination[at + 1] = green
    destination[at + 2] = blue
    destination[at + 3] = alpha
    output += 1
  }
  if input != payload_end { return DecodeWork{ info: info, error: -74, offset: input } }
  return DecodeWork{ info: info, pixels: destination[..count * 4], ok: true }
}

fn put_u32be(destination: []u8, at: usize, number: u32) {
  destination[at] = (number >> 24)
  destination[at + 1] = #cast(u8, (number >> 16))
  destination[at + 2] = #cast(u8, (number >> 8))
  destination[at + 3] = #cast(u8, number)
}

fn delta(current: u8, previous: u8) i16 {
  difference: i16 = #cast(i16, current) - #cast(i16, previous)
  if difference > 127 {
    difference -= 256
  }
  if difference < -128 {
    difference += 256
  }
  return difference
}

fn encode_into(destination: []u8, pixels: []const u8, width: usize, height: usize, channels: u8, srgb: bool) EncodeWork {
  if width == 0 || height == 0 || (channels != 3 && channels != 4) {
    return EncodeWork{ error: -22 }
  }
  count := #cast(usize, width) * #cast(usize, height)
  if count / width != height || count > pixels.len / #cast(usize, channels) ||
    pixels.len != count * channels || destination.len < 22 {
    return EncodeWork{ error: -28 }
  }
  destination[0] = 'q'
  destination[1] = 'o'
  destination[2] = 'i'
  destination[3] = 'f'
  put_u32be(destination, 4, #cast(u32, width))
  put_u32be(destination, 8, #cast(u32, height))
  destination[12] = channels
  destination[13] = 1
  if srgb {
    destination[13] = 0
  }
  table: [64]u32
  previous_red: u8 = 0
  previous_green: u8 = 0
  previous_blue: u8 = 0
  previous_alpha: u8 = 255
  output: usize = 14
  run: usize = 0
  for pixel in 0..count {
    at := pixel * channels
    red := pixels[at]
    green := pixels[at + 1]
    blue := pixels[at + 2]
    alpha := previous_alpha
    if channels == 4 {
      alpha = pixels[at + 3]
    }
    if red == previous_red && green == previous_green && blue == previous_blue && alpha == previous_alpha {
      run += 1
      if run == 62 || pixel + 1 == count {
        if output == destination.len { return EncodeWork{ error: -28 } }
        destination[output] = 192 | #cast(u8, (run - 1))
        output += 1
        run = 0
      }
    } else {
      if run > 0 {
        if output == destination.len { return EncodeWork{ error: -28 } }
        destination[output] = 192 | #cast(u8, (run - 1))
        output += 1
        run = 0
      }
      index := hash(red, green, blue, alpha)
      packed_value := packed_pixel(red, green, blue, alpha)
      if table[index] == packed_value {
        if output == destination.len { return EncodeWork{ error: -28 } }
        destination[output] = #cast(u8, index)
        output += 1
      } else {
        table[index] = packed_value
        red_delta := delta(red, previous_red)
        green_delta := delta(green, previous_green)
        blue_delta := delta(blue, previous_blue)
        red_green := red_delta - green_delta
        blue_green := blue_delta - green_delta
        if alpha == previous_alpha && red_delta >= -2 && red_delta <= 1 && green_delta >= -2 && green_delta <= 1 && blue_delta >= -2 && blue_delta <= 1 {
          if output == destination.len { return EncodeWork{ error: -28 } }
          destination[output] = 64 | #cast(u8, ((red_delta + 2) << 4)) | #cast(u8, ((green_delta + 2) << 2)) | #cast(u8, (blue_delta + 2))
          output += 1
        } else if alpha == previous_alpha && green_delta >= -32 && green_delta <= 31 && red_green >= -8 && red_green <= 7 && blue_green >= -8 && blue_green <= 7 {
          if output + 2 > destination.len { return EncodeWork{ error: -28 } }
          destination[output] = 128 | #cast(u8, (green_delta + 32))
          destination[output + 1] = #cast(u8, ((red_green + 8) << 4)) | #cast(u8, (blue_green + 8))
          output += 2
        } else if alpha == previous_alpha {
          if output + 4 > destination.len { return EncodeWork{ error: -28 } }
          destination[output] = 254
          destination[output + 1] = red
          destination[output + 2] = green
          destination[output + 3] = blue
          output += 4
        } else {
          if output + 5 > destination.len { return EncodeWork{ error: -28 } }
          destination[output] = 255
          destination[output + 1] = red
          destination[output + 2] = green
          destination[output + 3] = blue
          destination[output + 4] = alpha
          output += 5
        }
      }
    }
    previous_red = red
    previous_green = green
    previous_blue = blue
    previous_alpha = alpha
  }
  if output + 8 > destination.len { return EncodeWork{ error: -28 } }
  for i in 0..7 {
    destination[output + i] = 0
  }
  destination[output + 7] = 1
  output += 8
  return EncodeWork{ data: destination[..output], ok: true }
}

// Decodes QOI into RGBA8 pixels in arena. Failure pushes nothing.
fn decode_work(arena: *mem.Arena, source: []const u8) DecodeWork {
  info := inspect_info(source)
  if info.width == 0 { return DecodeWork{ error: -22 } }
  mark := mem.arena_mark(arena)
  result := decode_into(mem.push_bytes(arena, #cast(usize, info.width) * #cast(usize, info.height) * 4), source)
  if !result.ok {
    mem.arena_rewind(arena, mark)
  }
  return result
}

// Encodes tightly packed RGB8 or RGBA8 pixels into arena.
fn encode_work(arena: *mem.Arena, pixels: []const u8, width: usize, height: usize, channels: u8, srgb: bool) EncodeWork {
  bound := #cast(usize, width) * #cast(usize, height) * (#cast(usize, channels) + 1) + 22
  mark := mem.arena_mark(arena)
  result := encode_into(mem.push_bytes(arena, bound), pixels, width, height, channels, srgb)
  if !result.ok {
    mem.arena_rewind(arena, mark)
    return result
  }
  mem.arena_rewind(arena, mark + result.data.len)
  return result
}

// Checked before allocation; no hidden allocator and failures preserve the arena mark.
fn pixel_count(width: usize, height: usize, channels: u8) usize {
  limit := #max(usize)
  w := #cast(usize, width)
  h := #cast(usize, height)
  if w > limit / h { return 0 }
  count := w * h
  if count > limit / channels { return 0 }
  return count * channels
}

pub fn decode(arena: *mem.Arena, status: *fail.Status, source: []const u8) Image {
  if status == nil { return decode(arena, &fail.Status{}, source) }
  if status.failed { return Image{} }
  info := inspect_info(source)
  if info.width == 0 {
    fail.set(status, fail.make(fail.Kind.InvalidInput, "decode QOI", "", "malformed QOI"))
    return Image{}
  }
  size := pixel_count(info.width, info.height, 4)
  if size == 0 {
    fail.set(status, fail.make(fail.Kind.Overflow, "decode QOI", "", "the QOI is too large"))
    return Image{}
  }
  return decode_result(status, decode_work(arena, source))
}

pub fn encode(arena: *mem.Arena, status: *fail.Status, pixels: []const u8, width: usize, height: usize, channels: u8, srgb: bool) []u8 {
  if status == nil { return encode(arena, &fail.Status{}, pixels, width, height, channels, srgb) }
  empty: []u8
  if status.failed { return empty }
  if width == 0 || height == 0 || width > 0xffffffff || height > 0xffffffff || (channels != 3 && channels != 4) {
    fail.set(status, fail.make(fail.Kind.InvalidInput, "encode QOI", "", "invalid pixels or size"))
    return empty
  }
  size := pixel_count(width, height, channels)
  bound_pixels := pixel_count(width, height, channels + 1)
  if size == 0 || bound_pixels == 0 || bound_pixels > #max(usize) - 22 {
    fail.set(status, fail.make(fail.Kind.Overflow, "encode QOI", "", "the QOI is too large"))
    return empty
  }
  if size != pixels.len {
    fail.set(status, fail.make(fail.Kind.InvalidInput, "encode QOI", "", "invalid pixels or size"))
    return empty
  }
  return encode_result(status, encode_work(arena, pixels, width, height, channels, srgb))
}
