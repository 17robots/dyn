use "std/compress/deflate" deflate

pub struct Info { width: u32, height: u32, channels: u8, ok: bool }
pub struct Result { info: Info, pixels: []u8, error: isize, ok: bool }
pub struct EncodeResult { data: []u8, error: isize, ok: bool }

fn u32be(source: []const u8, at: usize) u32 {
  return #cast(u32) source[at] * 16777216 + #cast(u32) source[at + 1] * 65536 +
    #cast(u32) source[at + 2] * 256 + #cast(u32) source[at + 3]
}

fn put_u32be(destination: []u8, at: usize, value: u32) {
  destination[at] = #cast(u8) (value >> 24)
  destination[at + 1] = #cast(u8) (value >> 16)
  destination[at + 2] = #cast(u8) (value >> 8)
  destination[at + 3] = #cast(u8) value
}

fn chunk_type(source: []const u8, at: usize, a: u8, b: u8, c: u8, d: u8) bool {
  return source[at] == a && source[at + 1] == b && source[at + 2] == c && source[at + 3] == d
}

fn crc_step(crc: u32, byte: u8) u32 {
  value := crc ^ #cast(u32) byte
  i: usize = 0
  for i < 8 { if (value & 1) != 0 { value = (value >> 1) ^ 3988292384 } else { value >>= 1 } i += 1 }
  return value
}

fn chunk_crc(source: []const u8, type_at: usize, data_at: usize, length: usize) u32 {
  value: u32 = 4294967295
  i: usize = 0 for i < 4 { value = crc_step(value, source[type_at + i]) i += 1 }
  i = 0 for i < length { value = crc_step(value, source[data_at + i]) i += 1 }
  return value ^ 4294967295
}

pub fn inspect(source: []const u8) Info {
  if #len(source) < 33 || source[0] != 137 || source[1] != 80 || source[2] != 78 || source[3] != 71 ||
    source[4] != 13 || source[5] != 10 || source[6] != 26 || source[7] != 10 || u32be(source, 8) != 13 ||
    !chunk_type(source, 12, 'I', 'H', 'D', 'R') { return Info{} }
  width := u32be(source, 16) height := u32be(source, 20)
  color := source[25]
  channels: u8 = 0
  if color == 0 { channels = 1 }
  else if color == 4 { channels = 2 }
  else if color == 2 { channels = 3 }
  else if color == 6 { channels = 4 }
  if width == 0 || height == 0 || channels == 0 || source[24] != 8 || source[26] != 0 || source[27] != 0 || source[28] != 0 { return Info{} }
  return Info{ width: width, height: height, channels: channels, ok: true }
}

fn paeth(a: u8, b: u8, c: u8) u8 {
  ai: i32 = #cast(i32) a bi: i32 = #cast(i32) b ci: i32 = #cast(i32) c
  p := ai + bi - ci
  pa := p - ai if pa < 0 { pa = -pa }
  pb := p - bi if pb < 0 { pb = -pb }
  pc := p - ci if pc < 0 { pc = -pc }
  if pa <= pb && pa <= pc { return a }
  if pb <= pc { return b }
  return c
}

fn add_byte(value: u8, predictor: u8) u8 {
  total: u16 = #cast(u16) value + #cast(u16) predictor
  return #cast(u8) total
}

// Decodes non-interlaced 8-bit grayscale, grayscale-alpha, RGB, and RGBA PNG.
pub fn decode(pixels: []u8, compressed: []u8, scanlines: []u8, source: []const u8) Result {
  info := inspect(source)
  if !info.ok { return Result{ error: -22 } }
  row_size := #cast(usize) info.width * #cast(usize) info.channels
  pixel_size := row_size * #cast(usize) info.height
  scanline_size := (row_size + 1) * #cast(usize) info.height
  if #cast(usize) info.height != 0 && pixel_size / #cast(usize) info.height != row_size { return Result{ info: info, error: -75 } }
  if #len(pixels) < pixel_size || #len(scanlines) < scanline_size { return Result{ info: info, error: -28 } }
  at: usize = 8
  compressed_used: usize = 0
  ended := false
  for at + 12 <= #len(source) {
    length := #cast(usize) u32be(source, at)
    type_at := at + 4
    data_at := at + 8
    if length > #len(source) - data_at - 4 { return Result{ info: info, error: -74 } }
    expected_crc := u32be(source, data_at + length)
    if chunk_crc(source, type_at, data_at, length) != expected_crc { return Result{ info: info, error: -74 } }
    if chunk_type(source, type_at, 'I', 'D', 'A', 'T') {
      if length > #len(compressed) - compressed_used { return Result{ info: info, error: -28 } }
      i: usize = 0 for i < length { compressed[compressed_used + i] = source[data_at + i] i += 1 }
      compressed_used += length
    } else if chunk_type(source, type_at, 'I', 'E', 'N', 'D') { ended = true break }
    at = data_at + length + 4
  }
  if !ended || compressed_used < 6 { return Result{ info: info, error: -74 } }
  cmf := compressed[0] flg := compressed[1]
  header_value: usize = #cast(usize) cmf * 256 + #cast(usize) flg
  if (cmf & 15) != 8 || (cmf >> 4) > 7 || header_value % 31 != 0 || (flg & 32) != 0 { return Result{ info: info, error: -74 } }
  inflated := deflate.inflate(scanlines[..scanline_size], compressed[2..compressed_used - 4])
  if !inflated.ok || inflated.written != scanline_size || adler32(scanlines[..scanline_size]) != u32be(compressed, compressed_used - 4) { return Result{ info: info, error: -74 } }
  y: usize = 0
  for y < #cast(usize) info.height {
    filter := scanlines[y * (row_size + 1)]
    x: usize = 0
    for x < row_size {
      raw := scanlines[y * (row_size + 1) + 1 + x]
      left: u8 = 0 above: u8 = 0 upper_left: u8 = 0
      channels := #cast(usize) info.channels
      if x >= channels { left = pixels[y * row_size + x - channels] }
      if y > 0 { above = pixels[(y - 1) * row_size + x] }
      if y > 0 && x >= channels { upper_left = pixels[(y - 1) * row_size + x - channels] }
      predictor: u8 = 0
      if filter == 1 { predictor = left }
      else if filter == 2 { predictor = above }
      else if filter == 3 { predictor = #cast(u8) ((#cast(u16) left + #cast(u16) above) / 2) }
      else if filter == 4 { predictor = paeth(left, above, upper_left) }
      else if filter != 0 { return Result{ info: info, error: -74 } }
      pixels[y * row_size + x] = add_byte(raw, predictor)
      x += 1
    }
    y += 1
  }
  return Result{ info: info, pixels: pixels[..pixel_size], ok: true }
}

fn adler32(source: []const u8) u32 {
  a: u32 = 1 b: u32 = 0
  for byte in source {
    a = (a + #cast(u32) byte) % 65521
    b = (b + a) % 65521
  }
  return b * 65536 + a
}

fn append_chunk(destination: []u8, at: usize, kind: []const u8, payload: []const u8) usize {
  if #len(kind) != 4 || at > #len(destination) || #len(payload) > #len(destination) - at ||
    #len(destination) - at - #len(payload) < 12 { return #len(destination) + 1 }
  put_u32be(destination, at, #cast(u32) #len(payload))
  i: usize = 0 for i < 4 { destination[at + 4 + i] = kind[i] i += 1 }
  i = 0 for i < #len(payload) { destination[at + 8 + i] = payload[i] i += 1 }
  checksum := chunk_crc(destination, at + 4, at + 8, #len(payload))
  put_u32be(destination, at + 8 + #len(payload), checksum)
  return at + 12 + #len(payload)
}

// Encodes tightly packed 8-bit grayscale, grayscale-alpha, RGB, or RGBA pixels.
// `scanlines` and `compressed` are caller-owned workspaces.
pub fn encode(destination: []u8, scanlines: []u8, compressed: []u8, pixels: []const u8,
  width: u32, height: u32, channels: u8) EncodeResult {
  if width == 0 || height == 0 || channels < 1 || channels > 4 { return EncodeResult{ error: -22 } }
  row_size := #cast(usize) width * #cast(usize) channels
  pixel_size := row_size * #cast(usize) height
  scanline_size := (row_size + 1) * #cast(usize) height
  if pixel_size != #len(pixels) || #len(scanlines) < scanline_size || #len(compressed) < 6 || #len(destination) < 57 {
    return EncodeResult{ error: -28 }
  }
  y: usize = 0
  for y < #cast(usize) height {
    scanline_at := y * (row_size + 1)
    scanlines[scanline_at] = 0
    x: usize = 0 for x < row_size { scanlines[scanline_at + 1 + x] = pixels[y * row_size + x] x += 1 }
    y += 1
  }
  compressed[0] = 120 compressed[1] = 1
  encoded := deflate.deflate_stored_chunk(compressed[2..#len(compressed) - 4], scanlines[..scanline_size], true)
  if !encoded.ok { return EncodeResult{ error: -28 } }
  zlib_size: usize = encoded.written + 6
  put_u32be(compressed, 2 + encoded.written, adler32(scanlines[..scanline_size]))
  signature: [8]u8 = [137,80,78,71,13,10,26,10]
  i: usize = 0 for i < 8 { destination[i] = signature[i] i += 1 }
  ihdr: [13]u8 = []
  put_u32be(ihdr[..], 0, width) put_u32be(ihdr[..], 4, height)
  ihdr[8] = 8
  if channels == 1 { ihdr[9] = 0 }
  else if channels == 2 { ihdr[9] = 4 }
  else if channels == 3 { ihdr[9] = 2 }
  else { ihdr[9] = 6 }
  at := append_chunk(destination, 8, "IHDR", ihdr[..])
  at = append_chunk(destination, at, "IDAT", compressed[..zlib_size])
  at = append_chunk(destination, at, "IEND", compressed[..0])
  if at > #len(destination) { return EncodeResult{ error: -28 } }
  return EncodeResult{ data: destination[..at], ok: true }
}
