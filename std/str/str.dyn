use "std/mem"

pub fn equal(left: []const u8, right: []const u8) bool {
  if #len(left) != #len(right) { return false }
  i: usize = 0
  for i < #len(left) {
    if left[i] != right[i] { return false }
    i += 1
  }
  return true
}

pub fn starts_with(text: []const u8, prefix: []const u8) bool {
  if #len(prefix) > #len(text) { return false }
  return equal(text[..#len(prefix)], prefix)
}

pub fn ends_with(text: []const u8, suffix: []const u8) bool {
  if #len(suffix) > #len(text) { return false }
  return equal(text[#len(text) - #len(suffix)..], suffix)
}

pub fn find(text: []const u8, needle: []const u8) isize {
  if #len(needle) == 0 { return 0 }
  if #len(needle) > #len(text) { return -1 }
  i: usize = 0
  for i <= #len(text) - #len(needle) {
    if equal(text[i..i + #len(needle)], needle) { return #cast(isize) i }
    i += 1
  }
  return -1
}

fn whitespace(byte: u8) bool {
  return byte == ' ' || byte == 9 || byte == 10 || byte == 13
}

pub fn trim(text: []const u8) []const u8 {
  start: usize = 0
  end: usize = #len(text)
  for start < end && whitespace(text[start]) { start += 1 }
  for end > start && whitespace(text[end - 1]) { end -= 1 }
  return text[start..end]
}

pub fn trim_left(text: []const u8) []const u8 {
  start: usize = 0
  for start < #len(text) && whitespace(text[start]) { start += 1 }
  return text[start..]
}

pub fn trim_right(text: []const u8) []const u8 {
  end := #len(text)
  for end > 0 && whitespace(text[end - 1]) { end -= 1 }
  return text[..end]
}

pub fn find_byte(text: []const u8, byte: u8) isize {
  i: usize = 0
  for i < #len(text) {
    if text[i] == byte { return #cast(isize) i }
    i += 1
  }
  return -1
}

pub fn find_last_byte(text: []const u8, byte: u8) isize {
  i := #len(text)
  for i > 0 {
    i -= 1
    if text[i] == byte { return #cast(isize) i }
  }
  return -1
}

pub fn find_last(text: []const u8, needle: []const u8) isize {
  if #len(needle) == 0 { return #cast(isize) #len(text) }
  if #len(needle) > #len(text) { return -1 }
  i := #len(text) - #len(needle) + 1
  for i > 0 {
    i -= 1
    if equal(text[i..i + #len(needle)], needle) { return #cast(isize) i }
  }
  return -1
}

// Advances offset and returns a borrowed line without its newline.
pub fn next_line(text: []const u8, offset: *usize, output: *[]const u8) bool {
  if offset.* >= #len(text) { return false }
  start := offset.*
  found := find_byte(text[start..], 10)
  if found < 0 { offset.* = #len(text) output.* = text[start..] return true }
  end := start + #cast(usize) found
  offset.* = end + 1
  if end > start && text[end - 1] == 13 { end -= 1 }
  output.* = text[start..end]
  return true
}

// Advances offset across ASCII whitespace and returns the next borrowed field.
pub fn next_field(text: []const u8, offset: *usize, output: *[]const u8) bool {
  for offset.* < #len(text) && whitespace(text[offset.*]) { offset.* += 1 }
  if offset.* == #len(text) { return false }
  start := offset.*
  for offset.* < #len(text) && !whitespace(text[offset.*]) { offset.* += 1 }
  output.* = text[start..offset.*]
  return true
}

// Allocation-free cursor over borrowed text.
pub struct Scanner { text: []const u8, offset: usize }

pub fn scanner(text: []const u8) Scanner { return Scanner{ text: text, offset: 0 } }
pub fn scanner_remaining(value: *Scanner) []const u8 { return value.text[value.offset..] }
pub fn scanner_line(value: *Scanner, output: *[]const u8) bool {
  return next_line(value.text, &value.offset, output)
}
pub fn scanner_field(value: *Scanner, output: *[]const u8) bool {
  return next_field(value.text, &value.offset, output)
}

// Returns text before delimiter, consumes delimiter, and borrows input.
// Final unterminated token is returned; exhausted scanner returns false.
pub fn scanner_until(value: *Scanner, delimiter: u8, output: *[]const u8) bool {
  if value.offset >= #len(value.text) { return false }
  start := value.offset
  found := find_byte(value.text[start..], delimiter)
  if found < 0 {
    value.offset = #len(value.text)
    output.* = value.text[start..]
  } else {
    end := start + #cast(usize) found
    output.* = value.text[start..end]
    value.offset = end + 1
  }
  return true
}

fn glob_literal(pattern: []const u8, at: usize, text_byte: u8) bool {
  if pattern[at] == '\\' && at + 1 < #len(pattern) { return pattern[at + 1] == text_byte }
  return pattern[at] == '?' || pattern[at] == text_byte
}

fn glob_width(pattern: []const u8, at: usize) usize {
  if pattern[at] == '\\' && at + 1 < #len(pattern) { return 2 }
  return 1
}

// Allocation-free byte glob: '?' matches one byte, '*' any bytes, '\\' escapes next byte.
pub fn glob_match(pattern: []const u8, text: []const u8) bool {
  p: usize = 0
  t: usize = 0
  star_p: isize = -1
  star_t: usize = 0
  for t < #len(text) {
    if p < #len(pattern) && pattern[p] != '*' && glob_literal(pattern, p, text[t]) {
      p += glob_width(pattern, p)
      t += 1
    } else if p < #len(pattern) && pattern[p] == '*' {
      for p < #len(pattern) && pattern[p] == '*' { p += 1 }
      star_p = #cast(isize) p
      star_t = t
    } else if star_p >= 0 {
      star_t += 1
      t = star_t
      p = #cast(usize) star_p
    } else { return false }
  }
  for p < #len(pattern) && pattern[p] == '*' { p += 1 }
  return p == #len(pattern)
}

pub fn replace(destination: []u8, text: []const u8, needle: []const u8, replacement: []const u8) []u8 {
  if #len(needle) == 0 { return destination[..0] }
  source: usize = 0
  written: usize = 0
  for source < #len(text) {
    match := source + #len(needle) <= #len(text) && equal(text[source..source + #len(needle)], needle)
    piece := text[source..source + 1]
    if match { piece = replacement }
    if #len(piece) > #len(destination) - written { return destination[..0] }
    _ = mem.copy(destination[written..], piece)
    written += #len(piece)
    if match { source += #len(needle) } else { source += 1 }
  }
  return destination[..written]
}

pub fn clone(arena: *mem.Arena, text: []const u8) []u8 {
  if #len(text) == 0 { return arena.data[0..0] }
  raw := mem.arena_push(arena, #len(text), 1)
  result := raw[..#len(text)]
  _ = mem.copy(result, text)
  return result
}

pub fn split(arena: *mem.Arena, text: []const u8, separator: []const u8) [][]const u8 {
  if #len(separator) == 0 { #panic("split separator must not be empty") }
  part_count: usize = 1
  offset: usize = 0
  for offset + #len(separator) <= #len(text) {
    if equal(text[offset..offset + #len(separator)], separator) {
      part_count += 1
      offset += #len(separator)
    }
    else { offset += 1 }
  }
  raw := #cast(*[]const u8) mem.arena_push(arena, part_count * #sizeof([]const u8), #alignof([]const u8))
  result := raw[..part_count]
  part_index: usize = 0
  part_start: usize = 0
  offset = 0
  for offset + #len(separator) <= #len(text) {
    if equal(text[offset..offset + #len(separator)], separator) {
      result[part_index] = text[part_start..offset]
      part_index += 1
      offset += #len(separator)
      part_start = offset
    }
    else { offset += 1 }
  }
  result[part_index] = text[part_start..]
  return result
}

pub fn join(arena: *mem.Arena, parts: [][]const u8, separator: []const u8) []u8 {
  length: usize = 0
  i: usize = 0
  for i < #len(parts) {
    length += #len(parts[i])
    if i + 1 < #len(parts) { length += #len(separator) }
    i += 1
  }
  if length == 0 { return arena.data[0..0] }
  raw := mem.arena_push(arena, length, 1)
  result := raw[..length]
  write_offset: usize = 0
  i = 0
  for i < #len(parts) {
    _ = mem.copy(result[write_offset..], parts[i])
    write_offset += #len(parts[i])
    if i + 1 < #len(parts) {
      _ = mem.copy(result[write_offset..], separator)
      write_offset += #len(separator)
    }
    i += 1
  }
  return result
}

pub fn parse_u64(text: []const u8, output: *u64) bool {
  if #len(text) == 0 { return false }
  value: u64 = 0
  i: usize = 0
  for i < #len(text) {
    byte := text[i]
    if byte < '0' || byte > '9' { return false }
    digit: u64 = #cast(u64) (byte - '0')
    maximum: u64 = 18446744073709551615
    if value > (maximum - digit) / 10 { return false }
    value = value * 10 + digit
    i += 1
  }
  output.* = value
  return true
}

fn digit_value(byte: u8) u8 {
  if byte >= '0' && byte <= '9' { return byte - '0' }
  if byte >= 'a' && byte <= 'z' { return byte - 'a' + 10 }
  if byte >= 'A' && byte <= 'Z' { return byte - 'A' + 10 }
  return 255
}

pub fn parse_u64_base(text: []const u8, base: u8, output: *u64) bool {
  if #len(text) == 0 || base < 2 || base > 36 { return false }
  value: u64 = 0
  radix := #cast(u64) base
  maximum: u64 = 18446744073709551615
  for byte in text {
    digit := digit_value(byte)
    if digit >= base { return false }
    wide := #cast(u64) digit
    if value > (maximum - wide) / radix { return false }
    value = value * radix + wide
  }
  output.* = value
  return true
}

pub fn contains(text: []const u8, needle: []const u8) bool { return find(text, needle) >= 0 }

pub fn strip_prefix(text: []const u8, prefix: []const u8) []const u8 {
  if starts_with(text, prefix) { return text[#len(prefix)..] }
  return text
}

pub fn strip_suffix(text: []const u8, suffix: []const u8) []const u8 {
  if ends_with(text, suffix) { return text[..#len(text) - #len(suffix)] }
  return text
}

pub fn ascii_is_digit(byte: u8) bool { return byte >= '0' && byte <= '9' }
pub fn ascii_is_alpha(byte: u8) bool {
  return (byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z')
}
pub fn ascii_is_whitespace(byte: u8) bool { return whitespace(byte) }
pub fn ascii_to_lower(byte: u8) u8 {
  if byte >= 'A' && byte <= 'Z' { return byte + ('a' - 'A') }
  return byte
}
pub fn ascii_to_upper(byte: u8) u8 {
  if byte >= 'a' && byte <= 'z' { return byte - ('a' - 'A') }
  return byte
}

pub fn parse_i64(text: []const u8, output: *i64) bool {
  if #len(text) == 0 { return false }
  negative := text[0] == '-'
  start: usize = 0
  if negative || text[0] == '+' { start = 1 }
  if start == #len(text) { return false }
  magnitude: u64 = 0
  if !parse_u64(text[start..], &magnitude) { return false }
  if negative {
    limit: u64 = 9223372036854775808
    if magnitude > limit { return false }
    if magnitude == limit { output.* = -9223372036854775807 - 1 }
    else { output.* = -#cast(i64) magnitude }
  } else {
    if magnitude > 9223372036854775807 { return false }
    output.* = #cast(i64) magnitude
  }
  return true
}

fn decimal_value(byte: u8) f64 {
  if byte == '0' { return 0.0 }
  if byte == '1' { return 1.0 }
  if byte == '2' { return 2.0 }
  if byte == '3' { return 3.0 }
  if byte == '4' { return 4.0 }
  if byte == '5' { return 5.0 }
  if byte == '6' { return 6.0 }
  if byte == '7' { return 7.0 }
  if byte == '8' { return 8.0 }
  return 9.0
}

pub fn parse_f64(text: []const u8, output: *f64) bool {
  if #len(text) == 0 { return false }
  negative := text[0] == '-'
  at: usize = 0
  if negative || text[0] == '+' { at = 1 }
  if at == #len(text) { return false }
  value: f64 = 0.0
  digits: usize = 0
  for at < #len(text) && ascii_is_digit(text[at]) {
    byte := text[at]
    value = value * 10.0 + decimal_value(byte)
    at += 1
    digits += 1
  }
  if at < #len(text) && text[at] == '.' {
    at += 1
    scale: f64 = 0.1
    for at < #len(text) && ascii_is_digit(text[at]) {
      fraction_byte := text[at]
      value += decimal_value(fraction_byte) * scale
      scale /= 10.0
      at += 1
      digits += 1
    }
  }
  if digits == 0 { return false }
  exponent: i64 = 0
  exponent_negative := false
  if at < #len(text) && (text[at] == 'e' || text[at] == 'E') {
    at += 1
    if at < #len(text) && (text[at] == '-' || text[at] == '+') {
      exponent_negative = text[at] == '-'
      at += 1
    }
    exponent_start := at
    for at < #len(text) && ascii_is_digit(text[at]) {
      exponent_digit: u8 = text[at] - '0'
      if exponent < 10000 { exponent = exponent * 10 + #cast(i64) exponent_digit }
      at += 1
    }
    if at == exponent_start { return false }
  }
  if at != #len(text) { return false }
  factor: f64 = 1.0
  power: f64 = 10.0
  // Exponentiation by squaring keeps hostile exponents logarithmic.
  for exponent > 0 {
    if (exponent & 1) != 0 { factor *= power }
    power *= power
    exponent /= 2
  }
  if exponent_negative { value /= factor } else { value *= factor }
  if negative { value = -value }
  output.* = value
  return true
}

pub struct Utf8Decode {
  codepoint: u32,
  width: usize,
  ok: bool,
}

pub fn utf8_decode(text: []const u8, offset: usize) Utf8Decode {
  if offset >= #len(text) { return Utf8Decode{ codepoint: 0, width: 0, ok: false } }
  first := text[offset]
  if first < 128 { return Utf8Decode{ codepoint: #cast(u32) first, width: 1, ok: true } }
  width: usize = 0
  value: u32 = 0
  minimum: u32 = 0
  if first >= 194 && first <= 223 {
    width = 2
    value = #cast(u32) (first & 31)
    minimum = 128
  }
  else if first >= 224 && first <= 239 {
    width = 3
    value = #cast(u32) (first & 15)
    minimum = 2048
  }
  else if first >= 240 && first <= 244 {
    width = 4
    value = #cast(u32) (first & 7)
    minimum = 65536
  }
  else { return Utf8Decode{ codepoint: 0, width: 1, ok: false } }
  if width > #len(text) - offset { return Utf8Decode{ codepoint: 0, width: 1, ok: false } }
  i: usize = 1
  for i < width {
    byte := text[offset + i]
    if byte < 128 || byte > 191 { return Utf8Decode{ codepoint: 0, width: 1, ok: false } }
    value = (value << 6) | #cast(u32) (byte & 63)
    i += 1
  }
  if value < minimum || value > 1114111 || (value >= 55296 && value <= 57343) {
    return Utf8Decode{ codepoint: 0, width: 1, ok: false }
  }
  return Utf8Decode{ codepoint: value, width: width, ok: true }
}

pub fn utf8_valid(text: []const u8) bool {
  offset: usize = 0
  for offset < #len(text) {
    decoded := utf8_decode(text, offset)
    if !decoded.ok { return false }
    offset += decoded.width
  }
  return true
}

pub fn utf8_count(text: []const u8, count: *usize) bool {
  offset: usize = 0
  total: usize = 0
  for offset < #len(text) {
    decoded := utf8_decode(text, offset)
    if !decoded.ok { return false }
    offset += decoded.width
    total += 1
  }
  count.* = total
  return true
}

pub fn utf8_encode(destination: []u8, codepoint: u32) usize {
  continuation: u32 = 128
  mask: u32 = 63
  if codepoint <= 127 {
    if #len(destination) < 1 { return 0 }
    destination[0] = #cast(u8) codepoint
    return 1
  }
  if codepoint <= 2047 {
    if #len(destination) < 2 { return 0 }
    lead2: u32 = 192
    destination[0] = #cast(u8) (lead2 | (codepoint >> 6))
    destination[1] = #cast(u8) (continuation | (codepoint & mask))
    return 2
  }
  if codepoint >= 55296 && codepoint <= 57343 { return 0 }
  if codepoint <= 65535 {
    if #len(destination) < 3 { return 0 }
    lead3: u32 = 224
    destination[0] = #cast(u8) (lead3 | (codepoint >> 12))
    destination[1] = #cast(u8) (continuation | ((codepoint >> 6) & mask))
    destination[2] = #cast(u8) (continuation | (codepoint & mask))
    return 3
  }
  if codepoint <= 1114111 {
    if #len(destination) < 4 { return 0 }
    lead4: u32 = 240
    destination[0] = #cast(u8) (lead4 | (codepoint >> 18))
    destination[1] = #cast(u8) (continuation | ((codepoint >> 12) & mask))
    destination[2] = #cast(u8) (continuation | ((codepoint >> 6) & mask))
    destination[3] = #cast(u8) (continuation | (codepoint & mask))
    return 4
  }
  return 0
}
