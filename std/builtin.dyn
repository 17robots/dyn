module builtin

/// Build mode set by the compiler. Controls optimisation and default sanitizer behaviour.
pub BuildMode := enum {
    debug,
    release_safe,
    release_fast,
    release_small,
}

/// Target CPU architecture.
pub Arch := enum {
    x86_64,
    aarch64,
    riscv64,
    wasm32,
}

/// Target operating system.
pub Os := enum {
    linux,
    macos,
    windows,
    freestanding,
}

/// Compile-time target information. Populated by the compiler.
/// Retrieve with $target().
///
/// sanitize defaults to true when mode == .debug.
/// Override with --sanitize / --no-sanitize compiler flags.
pub Target := struct {
    mode:     BuildMode,
    arch:     Arch,
    os:       Os,
    sanitize: u1,
}
