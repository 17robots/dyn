#target(kernel: linux)

use "std/io" stream

fn stdin_read(data: rawptr, destination: []u8) stream.Result {
  _ = data
  if #len(destination) == 0 {
    return stream.Result{ transferred: 0, error: 0, status: stream.Status.Complete }
  }
  value := #syscall(0, 0, &destination[0], #len(destination))
  for value == -4 { value = #syscall(0, 0, &destination[0], #len(destination)) }
  if value < 0 { return stream.Result{ transferred: 0, error: value, status: stream.Status.Error } }
  status := stream.Status.Complete
  if value == 0 { status = stream.Status.End }
  return stream.Result{ transferred: #cast(usize) value, error: 0, status: status }
}

fn write_descriptor(descriptor: isize, source: []const u8) isize {
  written: usize = 0
  for written < #len(source) {
    value := #syscall(1, descriptor, &source[written], #len(source) - written)
    if value == -4 { }
    else if value <= 0 { return value }
    else { written += #cast(usize) value }
  }
  return #cast(isize) written
}
fn stdout_write(data: rawptr, source: []const u8) stream.Result {
  _ = data
  value := write_descriptor(1, source)
  if value < 0 { return stream.Result{ transferred: 0, error: value, status: stream.Status.Error } }
  return stream.Result{ transferred: #cast(usize) value, error: 0, status: stream.Status.Complete }
}

fn stderr_write(data: rawptr, source: []const u8) stream.Result {
  _ = data
  value := write_descriptor(2, source)
  if value < 0 { return stream.Result{ transferred: 0, error: value, status: stream.Status.Error } }
  return stream.Result{ transferred: #cast(usize) value, error: 0, status: stream.Status.Complete }
}

pub fn stdin() stream.Reader { return stream.Reader{ data: nil, read: &stdin_read } }
pub fn stdout() stream.Writer { return stream.Writer{ data: nil, write: &stdout_write } }
pub fn stderr() stream.Writer { return stream.Writer{ data: nil, write: &stderr_write } }

pub struct State { bytes: [60]u8 }
pub struct Size { columns: usize, rows: usize, ok: bool }

pub fn read_state(descriptor: isize, output: *State) bool {
  return #syscall(16, descriptor, 21505, &output.bytes[0]) >= 0
}

pub fn restore(descriptor: isize, saved: *const State) bool {
  return #syscall(16, descriptor, 21506, &saved.bytes[0]) >= 0
}

pub fn is_attached(descriptor: isize) bool {
  saved := State{ bytes: [] }
  return read_state(descriptor, &saved)
}

// Applies a small cfmakeraw-equivalent while retaining a restorable copy.
pub fn raw(descriptor: isize, previous: *State) bool {
  if !read_state(descriptor, previous) { return false }
  changed := State{ bytes: [] }
  i: usize = 0
  for i < #len(changed.bytes) { changed.bytes[i] = previous.bytes[i] i += 1 }
  changed.bytes[0] = changed.bytes[0] & 252
  changed.bytes[1] = changed.bytes[1] & 250
  changed.bytes[3] = changed.bytes[3] & 245
  changed.bytes[12] = changed.bytes[12] & 160
  changed.bytes[22] = 0
  changed.bytes[23] = 1
  return restore(descriptor, &changed)
}

pub fn size(descriptor: isize) Size {
  bytes: [8]u8 = []
  if #syscall(16, descriptor, 21523, &bytes[0]) < 0 { return Size{} }
  rows := #cast(usize) bytes[0] + #cast(usize) bytes[1] * 256
  columns := #cast(usize) bytes[2] + #cast(usize) bytes[3] * 256
  return Size{ columns: columns, rows: rows, ok: true }
}
