use "std/unicode/utf8"
use "std/errors" errors

// Saved terminal settings. The layout is private to each platform: Linux and
// macOS store termios, Windows stores the console mode.
pub struct State { bytes: [72]u8 }
pub struct Size { columns: usize, rows: usize, kind: errors.Kind, error: isize, ok: bool }

pub struct Read { value: State, kind: errors.Kind, error: isize, ok: bool }
pub struct Result { kind: errors.Kind, error: isize, ok: bool }

// Descriptors 0, 1 and 2 are the standard streams on every platform. On
// Windows any other value is a console handle.
pub fn is_attached(descriptor: isize) bool {
  return read_state(descriptor).ok
}

// Applies a small cfmakeraw equivalent: no echo, no line buffering, no signal
// keys, and on Windows virtual-terminal input or output. Returns the previous
// settings, to pass to restore; ok is false when descriptor is not a terminal
// or the change failed.
pub fn raw(descriptor: isize) Read {
  saved := read_state(descriptor)
  if !saved.ok {
    return saved
  }
  changed := saved.value
  make_raw(descriptor, &changed)
  applied := restore(descriptor, &changed)
  if !applied.ok {
    return Read{ kind: applied.kind, error: applied.error }
  }
  return saved
}

pub enum KeyKind { Text, Escape, Up, Down, Left, Right, Home, End, Delete, Unknown, Incomplete }
pub struct Key { kind: KeyKind, codepoint: u32, consumed: usize }
// Recognizes UTF-8 text and common CSI cursor keys. Incomplete sequences consume
// nothing. A standalone ESC is returned immediately; callers choose any timeout.
pub fn key_decode(bytes: []const u8) Key {
  if #len(bytes) == 0 {
    return Key{ kind: KeyKind.Incomplete }
  }
  if bytes[0] != 27 {
    decoded := utf8.decode(bytes, 0)
    if decoded.ok {
      return Key{ kind: KeyKind.Text, codepoint: decoded.codepoint, consumed: decoded.width }
    }
    width: usize = 1
    if bytes[0] >= 194 && bytes[0] <= 223 {
      width = 2
    }
    else if bytes[0] >= 224 && bytes[0] <= 239 {
      width = 3
    }
    else if bytes[0] >= 240 && bytes[0] <= 244 {
      width = 4
    }
    if #len(bytes) < width {
      return Key{ kind: KeyKind.Incomplete }
    }
    return Key{ kind: KeyKind.Unknown, consumed: 1 }
  }
  if #len(bytes) == 1 || bytes[1] != '[' {
    return Key{ kind: KeyKind.Escape, consumed: 1 }
  }
  if #len(bytes) < 3 {
    return Key{ kind: KeyKind.Incomplete }
  }
  kind := KeyKind.Unknown
  if bytes[2] == 'A' {
    kind = KeyKind.Up
  }
  else if bytes[2] == 'B' {
    kind = KeyKind.Down
  }
  else if bytes[2] == 'C' {
    kind = KeyKind.Right
  }
  else if bytes[2] == 'D' {
    kind = KeyKind.Left
  }
  else if bytes[2] == 'H' {
    kind = KeyKind.Home
  }
  else if bytes[2] == 'F' {
    kind = KeyKind.End
  }
  if kind != KeyKind.Unknown {
    return Key{ kind: kind, consumed: 3 }
  }
  for end in 2..#len(bytes) {
    if bytes[end] >= 64 && bytes[end] <= 126 {
      if end == 3 && bytes[end] == '~' {
        if bytes[2] == '1' {
          kind = KeyKind.Home
        }
        else if bytes[2] == '3' {
          kind = KeyKind.Delete
        }
        else if bytes[2] == '4' {
          kind = KeyKind.End
        }
      }
      return Key{ kind: kind, consumed: end + 1 }
    }
  }
  return Key{ kind: KeyKind.Incomplete }
}
