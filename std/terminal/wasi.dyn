use "std/io" io
#target(kernel: wasi)

// WASI Preview 1 has no terminal control. Descriptors are never terminals;
// key_decode still works on bytes read from standard input.
pub fn read_state(descriptor: isize) Read {
  _ = descriptor
  return Read{ failure: io.Failure{ kind: io.Kind.Unsupported } }
}

pub fn restore(descriptor: isize, saved: *const State) Result {
  _ = descriptor
  if saved == nil {
    return Result{ failure: io.Failure{ kind: io.Kind.InvalidInput } }
  }
  return Result{ failure: io.Failure{ kind: io.Kind.Unsupported } }
}

fn make_raw(descriptor: isize, state: *State) {
  _ = descriptor
  _ = state
}

pub fn size(descriptor: isize) Size {
  _ = descriptor
  return Size{ failure: io.Failure{ kind: io.Kind.Unsupported } }
}
