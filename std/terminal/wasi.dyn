use "std/fail"
#target(kernel: wasi)

// WASI Preview 1 has no terminal control. Descriptors are never terminals;
// key_decode still works on bytes read from standard input.
pub fn read_state(status: *fail.Status, _descriptor: isize) State {
  unsupported(status)
  return State{}
}

pub fn restore(status: *fail.Status, _descriptor: isize, saved: *const State) {
  if saved == nil {
    fail.invalid(status, "restore terminal", "", "no saved settings")
    return
  }
  unsupported(status)
}

fn make_raw(_descriptor: isize, _state: *State) {
}

pub fn size(status: *fail.Status, _descriptor: isize) Size {
  unsupported(status)
  return Size{}
}

fn unsupported(status: *fail.Status) {
  fail.set(status, fail.make(fail.Kind.Unsupported, "terminal", "", "WASI has no terminal control"))
}
