use io "std/io"
#target(kernel: wasi)

// WASI Preview 1 has no terminal control. Descriptors are never terminals;
// key_decode still works on bytes read from standard input.
pub fn read_state(_descriptor: isize) State!io.IoErr {
  fail .Unsupported
}

pub fn restore(_descriptor: isize, saved: *const State) !io.IoErr {
  if saved == nil { fail .InvalidInput }
  fail .Unsupported
}

fn make_raw(_descriptor: isize, _state: *State) {
}

pub fn size(_descriptor: isize) Size!io.IoErr {
  fail .Unsupported
}
