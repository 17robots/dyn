use io "std/io"
use "std/os/linux/sys"
#target(kernel: linux)

// The terminal settings of descriptor; fails when it is not a terminal.
pub fn read_state(descriptor: isize) State!io.IoErr {
  result: State
  code := #syscall(sys.Ioctl, descriptor, 21505, &result.bytes[0])
  if code < 0 { fail io.linux_err(code) }
  return result
}

pub fn restore(descriptor: isize, saved: *const State) !io.IoErr {
  if saved == nil { fail .InvalidInput }
  code := #syscall(sys.Ioctl, descriptor, 21506, &saved.bytes[0])
  if code < 0 { fail io.linux_err(code) }
}

// Clears IGNBRK, BRKINT, ICRNL, IXON, OPOST-adjacent input bits, ISIG,
// ICANON and ECHO, then sets VTIME 0 and VMIN 1 in the Linux termios layout.
fn make_raw(_descriptor: isize, state: *State) {
  state.bytes[0] = state.bytes[0] & 252
  state.bytes[1] = state.bytes[1] & 250
  state.bytes[3] = state.bytes[3] & 245
  state.bytes[12] = state.bytes[12] & 160
  state.bytes[22] = 0
  state.bytes[23] = 1
}

pub fn size(descriptor: isize) Size!io.IoErr {
  bytes: [8]u8
  code := #syscall(sys.Ioctl, descriptor, 21523, &bytes[0])
  if code < 0 { fail io.linux_err(code) }
  rows := #cast(usize, bytes[0]) + #cast(usize, bytes[1]) * 256
  columns := #cast(usize, bytes[2]) + #cast(usize, bytes[3]) * 256
  return Size{ columns: columns, rows: rows }
}
