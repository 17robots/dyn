#target(kernel: linux)

// The terminal settings of descriptor. ok is false when it is not a terminal.
pub fn read_state(descriptor: isize) Read {
  result: Read
  code := #syscall(16, descriptor, 21505, &result.value.bytes[0])
  if code < 0 {
    return Read{ kind: errors.linux(code), error: code }
  }
  result.ok = true
  return result
}

pub fn restore(descriptor: isize, saved: *const State) Result {
  if saved == nil {
    return Result{ kind: errors.Kind.InvalidInput }
  }
  code := #syscall(16, descriptor, 21506, &saved.bytes[0])
  if code < 0 {
    return Result{ kind: errors.linux(code), error: code }
  }
  return Result{ ok: true }
}

// Clears IGNBRK, BRKINT, ICRNL, IXON, OPOST-adjacent input bits, ISIG,
// ICANON and ECHO, then sets VTIME 0 and VMIN 1 in the Linux termios layout.
fn make_raw(descriptor: isize, state: *State) {
  _ = descriptor
  state.bytes[0] = state.bytes[0] & 252
  state.bytes[1] = state.bytes[1] & 250
  state.bytes[3] = state.bytes[3] & 245
  state.bytes[12] = state.bytes[12] & 160
  state.bytes[22] = 0
  state.bytes[23] = 1
}

pub fn size(descriptor: isize) Size {
  bytes: [8]u8 = []
  code := #syscall(16, descriptor, 21523, &bytes[0])
  if code < 0 {
    return Size{ kind: errors.linux(code), error: code }
  }
  rows := #cast(usize, bytes[0]) + #cast(usize, bytes[1]) * 256
  columns := #cast(usize, bytes[2]) + #cast(usize, bytes[3]) * 256
  return Size{ columns: columns, rows: rows, ok: true }
}
