// Private implementation shared by the public algorithm modules.
// The algorithms' + and << are mod 2^32: they are written inside #wrapping.
fn rotr(x: u32, n: u32) u32 {
  return (x >> n) | #wrapping(x << (32 - n))
}

const K: [64]u32 = [
  1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
  3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
  3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
  2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
  666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
  2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
  430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
  1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298
]

// Whole 64-byte blocks of data, through the CPU's SHA instructions where
// there are some.
fn blocks(state: *[8]u32, data: []const u8) {
  if #len(data) < 64 || hardware_blocks(state, data) { return }
  at: usize = 0
  for #len(data) - at >= 64 {
    block(state, data[at..at + 64])
    at += 64
  }
}

fn block(state: *[8]u32, input: []const u8) {
  if #len(input) < 64 { return }
  words: [64]u32
  for i in 0..16 {
    at := i * 4
    words[i] = #wrapping((#cast(u32, input[at]) << 24) | (#cast(u32, input[at + 1]) << 16) | (#cast(u32, input[at + 2]) << 8) | #cast(u32, input[at + 3]))
  }
  for i in 16..64 {
    word_x := words[i - 15]
    word_y := words[i - 2]
    extend0 := rotr(word_x, 7) ^ rotr(word_x, 18) ^ (word_x >> 3)
    extend1 := rotr(word_y, 17) ^ rotr(word_y, 19) ^ (word_y >> 10)
    words[i] = #wrapping(words[i - 16] + extend0 + words[i - 7] + extend1)
  }
  a := state.*[0]
  b := state.*[1]
  c := state.*[2]
  d := state.*[3]
  e := state.*[4]
  f := state.*[5]
  g := state.*[6]
  h := state.*[7]
  for i in 0..64 {
    round1 := rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
    choose := (e & f) ^ (~e & g)
    t1 := #wrapping(h + round1 + choose + K[i] + words[i])
    round0 := rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
    majority := (a & b) ^ (a & c) ^ (b & c)
    t2 := #wrapping(round0 + majority)
    h = g
    g = f
    f = e
    e = #wrapping(d + t1)
    d = c
    c = b
    b = a
    a = #wrapping(t1 + t2)
  }
  state.*[0] = #wrapping(state.*[0] + a)
  state.*[1] = #wrapping(state.*[1] + b)
  state.*[2] = #wrapping(state.*[2] + c)
  state.*[3] = #wrapping(state.*[3] + d)
  state.*[4] = #wrapping(state.*[4] + e)
  state.*[5] = #wrapping(state.*[5] + f)
  state.*[6] = #wrapping(state.*[6] + g)
  state.*[7] = #wrapping(state.*[7] + h)
}

// Zero is an empty SHA-256 stream. Explicit init resets a used or failed stream.
pub struct Sha256 { state: [8]u32, tail: [64]u8, tail_length: usize, length: u64, initialized: bool, failed: bool }

pub fn sha256_init(context: *Sha256) {
  context.state = [1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225]
  context.tail_length = 0
  context.length = 0
  context.initialized = true
  context.failed = false
}

// Adds one chunk. False means the SHA-256 maximum input length was exceeded.
pub fn sha256_update(context: *Sha256, input: []const u8) bool {
  if !context.initialized {
    sha256_init(context)
  }
  if context.failed { return false }
  input_length: u64 = #len(input)
  maximum: u64 = 2305843009213693951
  if input_length > maximum - context.length {
    context.failed = true
    return false
  }
  context.length += input_length
  at: usize = 0
  if context.tail_length != 0 {
    block_size: usize = 64
    needed := block_size - context.tail_length
    take: usize = #len(input)
    if take > needed {
      take = needed
    }
    for i in 0..take {
      context.tail[context.tail_length + i] = input[i]
    }
    context.tail_length += take
    at += take
    if context.tail_length == 64 {
      blocks(&context.state, context.tail[..])
      context.tail_length = 0
    } else {
      return true
    }
  }
  whole := (#len(input) - at) / 64 * 64
  blocks(&context.state, input[at..at + whole])
  at += whole
  rest: usize = 0
  for at + rest < #len(input) {
    context.tail[rest] = input[at + rest]
    rest += 1
  }
  context.tail_length = rest
  return true
}

// Finishes into 32 caller-owned bytes, or returns an empty slice on failure.
// An oversized update latches failed; init resets the context for reuse.
pub fn sha256_finish(context: *Sha256, destination: []u8) []u8 {
  if !context.initialized {
    sha256_init(context)
  }
  if context.failed { return destination[..0] }
  if #len(destination) < 32 { return destination[..0] }
  tail: [128]u8
  remaining := context.tail_length
  i: usize = 0
  for i < remaining {
    tail[i] = context.tail[i]
    i += 1
  }
  tail[remaining] = 128
  length: usize = 64
  if remaining >= 56 {
    length = 128
  }
  bits := context.length * 8
  i = 0
  for i < 8 {
    tail[length - 1 - i] = #cast(u8, (bits >> (i * 8)))
    i += 1
  }
  blocks(&context.state, tail[..length])
  i = 0
  for i < 8 {
    destination[i * 4] = (context.state[i] >> 24)
    destination[i * 4 + 1] = #cast(u8, (context.state[i] >> 16))
    destination[i * 4 + 2] = #cast(u8, (context.state[i] >> 8))
    destination[i * 4 + 3] = #cast(u8, context.state[i])
    i += 1
  }
  return destination[..32]
}

// Writes 32-byte SHA-256 digest. Empty slice means destination too small or oversized input.
pub fn sha256(destination: []u8, input: []const u8) []u8 {
  context := Sha256{}
  sha256_init(&context)
  if !sha256_update(&context, input) { return destination[..0] }
  return sha256_finish(&context, destination)
}

// HMAC-SHA256 with the key pads already hashed. Computing many MACs with one
// key (PBKDF2, HKDF expand) then costs two compressions less per MAC.
pub struct HmacSha256 { inner: Sha256, outer: Sha256 }

// False, leaving state unusable, when a key longer than a block cannot be
// hashed (beyond SHA-256's input limit).
pub fn hmac_sha256_init(state: *HmacSha256, key: []const u8) bool {
  state.* = HmacSha256{}
  key_block: [64]u8
  if #len(key) > 64 {
    if #len(sha256(key_block[..32], key)) != 32 {
      state.inner.failed = true
      return false
    }
  } else {
    for i in 0..#len(key) {
      key_block[i] = key[i]
    }
  }
  pad: [64]u8
  for i in 0..64 {
    pad[i] = key_block[i] ^ 0x36
  }
  sha256_init(&state.inner)
  _ = sha256_update(&state.inner, pad[..])
  for i in 0..64 {
    pad[i] = key_block[i] ^ 0x5c
  }
  sha256_init(&state.outer)
  _ = sha256_update(&state.outer, pad[..])
  return true
}

// MAC of message into 32 bytes of destination. The keyed state is unchanged.
// A message of at most 55 bytes and its padding fill one block, so the inner
// and outer hashes are one block each, without copying the stream states.
// Every PBKDF2 round takes this path.
fn hmac_sha256_short(state: *const HmacSha256, destination: []u8, message: []const u8) []u8 {
  work: [64]u8
  for i in 0..#len(message) {
    work[i] = message[i]
  }
  work[#len(message)] = 128
  bits := (64 + #len(message)) * 8
  work[62] = #cast(u8, bits >> 8)
  work[63] = #cast(u8, bits)
  inner := state.inner.state
  blocks(&inner, work[..])
  for i in 0..8 {
    work[i * 4] = inner[i] >> 24
    work[i * 4 + 1] = #cast(u8, inner[i] >> 16)
    work[i * 4 + 2] = #cast(u8, inner[i] >> 8)
    work[i * 4 + 3] = #cast(u8, inner[i])
  }
  // The inner digest, 0x80, zeros, and the length (64 + 32) * 8 = 768.
  work[32] = 128
  for i in 33..62 {
    work[i] = 0
  }
  work[62] = 3
  work[63] = 0
  outer := state.outer.state
  blocks(&outer, work[..])
  for i in 0..8 {
    destination[i * 4] = outer[i] >> 24
    destination[i * 4 + 1] = #cast(u8, outer[i] >> 16)
    destination[i * 4 + 2] = #cast(u8, outer[i] >> 8)
    destination[i * 4 + 3] = #cast(u8, outer[i])
  }
  return destination[..32]
}

pub fn hmac_sha256_sum(state: *const HmacSha256, destination: []u8, message: []const u8) []u8 {
  if #len(destination) < 32 { return destination[..0] }
  if #len(message) <= 55 && state.inner.initialized && !state.inner.failed && state.inner.length == 64 &&
    state.outer.initialized && state.outer.length == 64 {
    return hmac_sha256_short(state, destination, message)
  }
  inner := state.inner
  if inner.failed || !inner.initialized || !sha256_update(&inner, message) {
    return destination[..0]
  }
  inner_digest: [32]u8
  _ = sha256_finish(&inner, inner_digest[..])
  outer := state.outer
  _ = sha256_update(&outer, inner_digest[..])
  return sha256_finish(&outer, destination)
}

pub fn hmac_sha256(destination: []u8, key: []const u8, message: []const u8) []u8 {
  state := HmacSha256{}
  if #len(destination) < 32 || !hmac_sha256_init(&state, key) { return destination[..0] }
  return hmac_sha256_sum(&state, destination, message)
}

pub fn equal_constant_time(left: []const u8, right: []const u8) bool {
  if #len(left) != #len(right) { return false }
  difference: u8 = 0
  for i in 0..#len(left) {
    difference = difference | (left[i] ^ right[i])
  }
  return difference == 0
}

