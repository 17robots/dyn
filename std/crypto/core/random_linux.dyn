#target(kernel: linux)
use "std/os/linux/sys"
// Linux getrandom, filling all of destination; a failing source fails with
// System and the errno in native.
pub fn secure_random(status: *fail.Status, destination: []u8) {
  if status.failed { return }
  total: usize = 0
  for total < #len(destination) {
    got := #syscall(sys.Getrandom, &destination[total], #len(destination) - total, 0)
    if got == -4 { } else if got <= 0 {
      random_failed(status, got)
      return
    } else { total += #cast(usize, got) }
  }
}
