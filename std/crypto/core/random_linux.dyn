#target(kernel: linux)
use "std/os/linux/sys"
// Linux getrandom, filling all of destination; fails when the source fails.
pub fn secure_random(destination: []u8) ! {
  total: usize = 0
  for total < destination.len {
    got := #syscall(sys.Getrandom, &destination[total], destination.len - total, 0)
    if got == -4 { } else if got <= 0 {
      fail
    } else { total += #cast(usize, got) }
  }
}
