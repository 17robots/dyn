#target(kernel: windows)
extern fn entropy "dyn_crypto_random"(algorithm: rawptr, destination: *u8, size: u32, flags: u32) i32
pub fn secure_random(destination: []u8) ! {
  at: usize = 0
  for at < destination.len {
    count := destination.len - at
    if count > 4294967295 {
      count = 4294967295
    }
    code := entropy(nil, &destination[at], #cast(u32, count), 2)
    if code < 0 { fail }
    at += count
  }
}
