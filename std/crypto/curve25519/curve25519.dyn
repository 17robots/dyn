// Fixed-limb arithmetic adapted from public-domain TweetNaCl:
// https://tweetnacl.cr.yp.to/20140427/tweetnacl.c
// Arithmetic modulo 2^255-19. Sixteen signed radix-2^16 limbs. All secret
// operations have fixed schedules and addresses
// machine qualification is separate.
pub struct Field { limbs: [16]i64 }
pub fn number(value: i64) Field {
  result: Field
  result.limbs[0] = value
  return result
}
pub fn add(a: Field, b: Field) Field {
  result: Field
  for i in 0..16 {
    result.limbs[i] = a.limbs[i] + b.limbs[i]
  }
  return result
}
pub fn sub(a: Field, b: Field) Field {
  result: Field
  for i in 0..16 {
    result.limbs[i] = a.limbs[i] - b.limbs[i]
  }
  return result
}
fn carry(a: *Field) {
  for i in 0..16 {
    a.limbs[i] += 65536
    c := a.limbs[i] >> 16
    a.limbs[i] -= c * 65536
    if i < 15 {
      a.limbs[i+1] += c - 1
    } else {
      a.limbs[0] += 38 * (c - 1)
    }
  }
}
pub fn select(a: *Field, b: *Field, bit: i64) {
  mask := -bit
  for i in 0..16 {
    change := mask & (a.limbs[i] ^ b.limbs[i])
    a.limbs[i] ^= change
    b.limbs[i] ^= change
  }
}
pub fn multiply(a: Field, b: Field) Field {
  t: [31]i64
  for i in 0..16 {
    for j in 0..16 {
      t[i+j] += a.limbs[i] * b.limbs[j]
    }
  }
  for i in 0..15 {
    t[i] += 38 * t[i+16]
  }
  result: Field
  for i in 0..16 {
    result.limbs[i] = t[i]
  }
  carry(&result)
  carry(&result)
  return result
}
pub fn square(a: Field) Field {
  return multiply(a, a)
}
pub fn decode(input: []const u8) Field {
  result: Field
  for i in 0..16 {
    result.limbs[i] = #cast(i64, input[2*i]) + #cast(i64, input[2*i+1])*256
  }
  result.limbs[15] &= 32767
  return result
}
pub fn encode(output: []u8, value: Field) {
  t := value
  carry(&t)
  carry(&t)
  carry(&t)
  for pass in 0..2 {
    m: Field
    m.limbs[0] = t.limbs[0] - 65517
    for i in 1..15 {
      m.limbs[i] = t.limbs[i] - 65535 - ((m.limbs[i-1] >> 16) & 1)
      m.limbs[i-1] &= 65535
    }
    m.limbs[15] = t.limbs[15] - 32767 - ((m.limbs[14] >> 16) & 1)
    bit := (m.limbs[15] >> 16) & 1
    m.limbs[14] &= 65535
    select(&t, &m, 1-bit)
  }
  for i in 0..16 {
    output[2*i] = #cast(u8, t.limbs[i] & 255)
    output[2*i+1] = #cast(u8, (t.limbs[i] >> 8) & 255)
  }
}
pub fn inverse(value: Field) Field {
  result := value
  for step in 0..254 {
    exponent := 253-step
    result = square(result)
    if exponent != 2 && exponent != 4 {
      result = multiply(result, value)
    }
  }
  return result
}
pub fn power2523(value: Field) Field {
  result := value
  for step in 0..251 {
    exponent := 250-step
    result = square(result)
    if exponent != 1 {
      result = multiply(result, value)
    }
  }
  return result
}
pub fn equal(a: Field, b: Field) bool {
  left: [32]u8
  right: [32]u8
  encode(left[..], a)
  encode(right[..], b)
  difference: u32
  for i in 0..32 {
    difference |= #cast(u32, left[i]^right[i])
  }
  return difference == 0
}
pub fn parity(a: Field) i64 {
  encoded: [32]u8
  encode(encoded[..], a)
  return #cast(i64, encoded[0]&1)
}
