use "std/fail"
use "std/crypto/curve25519" field
// RFC 7748. Caller storage
// destination must have at least 32 bytes. Inputs are
// copied before writing, permitting in-place use. All-zero shared secrets fail.
// The shared secret of private_key and peer. Bad sizes, or a peer key that
// gives an all-zero secret (a low-order point), fail with InvalidInput.
pub fn shared(status: *fail.Status, destination: []u8, private_key: []const u8, peer: []const u8) {
  if status == nil {
    shared(&fail.Status{}, destination, private_key, peer)
    return
  }
  if status.failed { return }
  if #len(destination)<32 || #len(private_key)!=32 || #len(peer)!=32 {
    fail.invalid(status, "X25519", "", "keys and output must be 32 bytes")
    return
  }
  scalar: [32]u8
  for i in 0..32 {
    scalar[i]=private_key[i]
  }
  scalar[0] &= 248
  scalar[31] = (scalar[31]&127)|64
  x := field.decode(peer)
  a := field.number(1)
  b := x
  c := field.number(0)
  d := field.number(1)
  constant := field.number(121665)
  for step in 0..255 {
    i := 254-step
    bit := #cast(i64, (scalar[i/8] >> #cast(u8, i&7)) & 1)
    field.select(&a, &b, bit)
    field.select(&c, &d, bit)
    e := field.add(a, c)
    a=field.sub(a, c)
    c=field.add(b, d)
    b=field.sub(b, d)
    d=field.square(e)
    f:=field.square(a)
    a=field.multiply(c, a)
    c=field.multiply(b, e)
    e=field.add(a, c)
    a=field.sub(a, c)
    b=field.square(a)
    c=field.sub(d, f)
    a=field.multiply(c, constant)
    a=field.add(a, d)
    c=field.multiply(c, a)
    a=field.multiply(d, f)
    d=field.multiply(b, x)
    b=field.square(e)
    field.select(&a, &b, bit)
    field.select(&c, &d, bit)
  }
  a=field.multiply(a, field.inverse(c))
  field.encode(destination[..32], a)
  nonzero: u32
  for i in 0..32 {
    nonzero |= destination[i]
  }
  if nonzero == 0 {
    fail.invalid(status, "X25519", "", "the peer key is a low-order point")
  }
}
pub fn public_key(status: *fail.Status, destination: []u8, private_key: []const u8) {
  if status == nil {
    public_key(&fail.Status{}, destination, private_key)
    return
  }
  if status.failed { return }
  base: [32]u8
  base[0]=9
  shared(status, destination, private_key, base[..])
}
