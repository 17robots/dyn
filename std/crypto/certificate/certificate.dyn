use "std/fail"
use der "std/crypto/der"
use crypto_core "std/crypto/core"

// Borrowed DER envelope; parse alone does not establish trust. std/crypto/x509
// validates explicit native paths. TLS retains its separate provider policy.
pub struct Certificate { encoded: []const u8, tbs: []const u8, signature_algorithm: []const u8, signature_bits: []const u8 }

fn malformed(status: *fail.Status, offset: usize) Certificate {
  fail.at(status, fail.Kind.InvalidInput, "parse certificate", "malformed certificate", offset)
  return Certificate{}
}
// The next element of cursor at base, which must have tag. A DER failure
// keeps its kind; its offset counts from the start of the certificate.
fn element(status: *fail.Status, cursor: *der.Cursor, base: usize, tag: u8) der.Element {
  start := cursor.offset
  inner: fail.Status
  next := der.next(&inner, cursor)
  if inner.failed {
    failure := inner.failure
    failure.offset += base
    fail.set(status, failure)
    return der.Element{}
  }
  if cursor.ended || next.tag != tag {
    _ = malformed(status, base + start)
    return der.Element{}
  }
  return next
}
// Malformed DER fails with InvalidInput (Overflow for an impossible length)
// at the offending byte.
pub fn parse(status: *fail.Status, encoded: []const u8) Certificate {
  if status == nil { return parse(&fail.Status{}, encoded) }
  if status.failed { return Certificate{} }
  outer_cursor := der.cursor(encoded)
  outer := element(status, &outer_cursor, 0, 48)
  if status.failed { return Certificate{} }
  if !der.finished(&outer_cursor) { return malformed(status, outer_cursor.offset) }
  header := outer.encoded.len - outer.content.len
  children := der.enter(outer)
  tbs := element(status, &children, header, 48)
  algorithm := element(status, &children, header, 48)
  start := children.offset
  signature := element(status, &children, header, 3)
  if status.failed { return Certificate{} }
  if signature.content.len < 1 { return malformed(status, header + start) }
  if signature.content[0] != 0 {
    return malformed(status, header + start + signature.encoded.len - signature.content.len)
  }
  if !der.finished(&children) { return malformed(status, header + children.offset) }
  return Certificate{
    encoded: encoded, tbs: tbs.encoded, signature_algorithm: algorithm.encoded,
    signature_bits: signature.content[1..],
  }
}

pub fn fingerprint_sha256(destination: []u8, certificate: Certificate) []u8 {
  return crypto_core.sha256(destination, certificate.encoded)
}
