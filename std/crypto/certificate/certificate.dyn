use parse "std/parse"
use der "std/crypto/der"
use crypto_core "std/crypto/core"

// Borrowed DER envelope; parse alone does not establish trust. std/crypto/x509
// validates explicit native paths. TLS retains its separate provider policy.
pub struct Certificate { encoded: []const u8, tbs: []const u8, signature_algorithm: []const u8, signature_bits: []const u8 }

// The next element of cursor at base, which must have tag. A DER failure
// keeps its kind; its offset counts from the start of the certificate.
fn element(cursor: *der.Cursor, base: usize, tag: u8) der.Element!parse.ParseErr {
  start := cursor.offset
  next := der.next(cursor) catch err { fail parse.shifted(err, base) }
  if cursor.ended || next.tag != tag { fail parse.ParseErr.Invalid(base + start) }
  return next
}
// Malformed DER fails with Invalid (TooLarge for an impossible length) at the
// offending byte.
pub fn parse(encoded: []const u8) Certificate!parse.ParseErr {
  outer_cursor := der.cursor(encoded)
  outer := try element(&outer_cursor, 0, 48)
  if !der.finished(&outer_cursor) { fail parse.ParseErr.Invalid(outer_cursor.offset) }
  header := outer.encoded.len - outer.content.len
  children := der.enter(outer)
  tbs := try element(&children, header, 48)
  algorithm := try element(&children, header, 48)
  start := children.offset
  signature := try element(&children, header, 3)
  if signature.content.len < 1 { fail parse.ParseErr.Invalid(header + start) }
  if signature.content[0] != 0 {
    fail parse.ParseErr.Invalid(header + start + signature.encoded.len - signature.content.len)
  }
  if !der.finished(&children) { fail parse.ParseErr.Invalid(header + children.offset) }
  return Certificate{
    encoded: encoded, tbs: tbs.encoded, signature_algorithm: algorithm.encoded,
    signature_bits: signature.content[1..],
  }
}

pub fn fingerprint_sha256(destination: []u8, certificate: Certificate) []u8 {
  return crypto_core.sha256(destination, certificate.encoded)
}
