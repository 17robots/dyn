use aead "std/crypto/aead"
use mem "std/mem"
use "std/fail"

// AES-256-GCM: arena-owned ciphertext and 16-byte tag. Inputs are borrowed for
// the call; outputs expire on applicable arena rewind/reset/release. Caller
// ensures nonce uniqueness per key. See std/crypto/aead for validation, overlap,
// failure rollback and exhaustion contracts; key is 32 bytes, nonce is 1..128 bytes.
pub fn gcm_seal(arena: *mem.Arena, status: *fail.Status, plaintext: []const u8, additional: []const u8, key: []const u8, nonce: []const u8) aead.Sealed {
  if status == nil { return gcm_seal(arena, &fail.Status{}, plaintext, additional, key, nonce) }
  return aead.seal(arena, status, aead.Cipher.Aes256Gcm, plaintext, additional, key, nonce)
}
// Returns arena-owned authenticated plaintext; failed output is cleared before
// rollback. Tag must be 16 bytes. Same lifetimes and contracts as gcm_seal.
pub fn gcm_open(arena: *mem.Arena, status: *fail.Status, ciphertext: []const u8, tag: []const u8, additional: []const u8, key: []const u8, nonce: []const u8) []u8 {
  if status == nil { return gcm_open(arena, &fail.Status{}, ciphertext, tag, additional, key, nonce) }
  return aead.open(arena, status, aead.Cipher.Aes256Gcm, ciphertext, tag, additional, key, nonce)
}
