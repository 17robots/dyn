use "std/parse" parse
use "std/fail"
pub struct Element { tag: u8, content: []const u8, encoded: []const u8, constructed: bool }
// After a failure the cursor stays failed: next fails the same way again.
pub struct Cursor { source: []const u8, offset: usize, failed: bool, error_kind: fail.Kind, error_offset: usize }
// An element, found false at the end of the input; offset is where it starts.
pub struct Next { value: Element, offset: usize, found: bool }

pub fn cursor(source: []const u8) Cursor {
  return Cursor{ source: source }
}
fn failed(status: *fail.Status, state: *Cursor, kind: fail.Kind, offset: usize) Next {
  state.failed = true
  state.error_kind = kind
  state.error_offset = offset
  message: []const u8 = "malformed DER"
  if kind == fail.Kind.Overflow {
    message = "the length exceeds usize"
  }
  parse.failed_at(status, kind, "read DER", message, offset)
  return Next{ offset: offset }
}
// Malformed input fails with InvalidInput, a length past usize with Overflow,
// both at the offending byte.
pub fn next(status: *fail.Status, state: *Cursor) Next {
  if status.failed { return Next{ offset: state.offset } }
  if state.failed { return failed(status, state, state.error_kind, state.error_offset) }
  start := state.offset
  if start == #len(state.source) { return Next{ offset: start } }
  if start > #len(state.source) || #len(state.source) - start < 2 {
    return failed(status, state, fail.Kind.InvalidInput, start)
  }
  tag := state.source[start]
  if (tag & 31) == 31 { return failed(status, state, fail.Kind.InvalidInput, start) }
  at := start + 1
  first_length := state.source[at]
  at += 1
  length: usize = 0
  if first_length < 128 {
    length = first_length
  } else {
    count := #cast(usize, (first_length & 127))
    if count == 0 || count > #len(state.source) - at {
      return failed(status, state, fail.Kind.InvalidInput, at - 1)
    }
    if count > #sizeof(usize) { return failed(status, state, fail.Kind.Overflow, at - 1) }
    if state.source[at] == 0 { return failed(status, state, fail.Kind.InvalidInput, at) }
    for i in 0..count {
      if length > (#max(usize) - #cast(usize, state.source[at + i])) / 256 {
        return failed(status, state, fail.Kind.Overflow, at + i)
      }
      length = length * 256 + state.source[at + i]
    }
    if length < 128 { return failed(status, state, fail.Kind.InvalidInput, at) }
    at += count
  }
  if length > #len(state.source) - at { return failed(status, state, fail.Kind.InvalidInput, at) }
  finish := at + length
  state.offset = finish
  return Next{ value: Element{ tag: tag, content: state.source[at..finish], encoded: state.source[start..finish], constructed: (tag & 32) != 0 }, offset: start, found: true }
}
pub fn enter(element: Element) Cursor {
  return cursor(element.content)
}
pub fn finished(state: *const Cursor) bool {
  return !state.failed && state.offset == #len(state.source)
}
