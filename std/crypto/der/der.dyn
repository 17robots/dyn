use parse "std/parse"
pub struct Element { tag: u8, content: []const u8, encoded: []const u8, constructed: bool }
// After a failure the cursor stays failed: next fails the same way again.
// start is where the last value next returned begins. ended turns true when
// next returns no value, at the end of the input or after a failure.
pub struct Cursor { source: []const u8, offset: usize, failed: bool, too_large: bool, error_offset: usize, start: usize, ended: bool }

pub fn cursor(source: []const u8) Cursor {
  return Cursor{ source: source }
}
fn ended(state: *Cursor, offset: usize) Element {
  state.start = offset
  state.ended = true
  return Element{}
}
// Ends the cursor for good and returns its failure.
fn failed(state: *Cursor, too_large: bool, offset: usize) parse.ParseErr {
  state.failed = true
  state.too_large = too_large
  state.error_offset = offset
  _ = ended(state, offset)
  if too_large { return parse.ParseErr.TooLarge(offset) }
  return parse.ParseErr.Invalid(offset)
}
// Malformed input fails with Invalid, a length past usize with TooLarge,
// both at the offending byte.
pub fn next(state: *Cursor) Element!parse.ParseErr {
  if state.failed { fail failed(state, state.too_large, state.error_offset) }
  start := state.offset
  if start == state.source.len { return ended(state, start) }
  if start > state.source.len || state.source.len - start < 2 { fail failed(state, false, start) }
  tag := state.source[start]
  if (tag & 31) == 31 { fail failed(state, false, start) }
  at := start + 1
  first_length := state.source[at]
  at += 1
  length: usize = 0
  if first_length < 128 {
    length = first_length
  } else {
    count := #cast(usize, (first_length & 127))
    if count == 0 || count > state.source.len - at { fail failed(state, false, at - 1) }
    if count > #sizeof(usize) { fail failed(state, true, at - 1) }
    if state.source[at] == 0 { fail failed(state, false, at) }
    for i in 0..count {
      if length > (#max(usize) - #cast(usize, state.source[at + i])) / 256 {
        fail failed(state, true, at + i)
      }
      length = length * 256 + state.source[at + i]
    }
    if length < 128 { fail failed(state, false, at) }
    at += count
  }
  if length > state.source.len - at { fail failed(state, false, at) }
  finish := at + length
  state.offset = finish
  state.start = start
  return Element{ tag: tag, content: state.source[at..finish], encoded: state.source[start..finish], constructed: (tag & 32) != 0 }
}
pub fn enter(element: Element) Cursor {
  return cursor(element.content)
}
pub fn finished(state: *const Cursor) bool {
  return !state.failed && state.offset == state.source.len
}
