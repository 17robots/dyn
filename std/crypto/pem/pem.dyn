use mem "std/mem"
use "std/fail"
use base64 "std/encoding/base64"

// A decoded block: data is arena-owned, label borrows the source, consumed
// counts the source bytes through the END line.
pub struct Block { data: []u8, label: []const u8, consumed: usize }
fn equal_at(source: []const u8, at: usize, expected: []const u8) bool {
  if at > source.len || expected.len > source.len - at { return false }
  for i in 0..expected.len {
    if source[at + i] != expected[i] { return false }
  }
  return true
}
fn append(destination: []u8, at: *usize, source: []const u8) bool {
  if source.len > destination.len - at.* { return false }
  for byte in source {
    destination[at.*] = byte
    at.* += 1
  }
  return true
}

fn malformed(arena: *mem.Arena, status: *fail.Status, mark: usize, offset: usize) Block {
  mem.arena_rewind(arena, mark)
  fail.at(status, fail.Kind.InvalidInput, "decode PEM", "malformed PEM", offset)
  return Block{}
}
// Decodes the first PEM block. Malformed text fails with InvalidInput at the
// offending line and restores the entry arena mark.
pub fn decode(arena: *mem.Arena, status: *fail.Status, source: []const u8) Block {
  if status == nil { return decode(arena, &fail.Status{}, source) }
  if status.failed { return Block{} }
  mark := mem.arena_mark(arena)
  base64_storage := mem.push_bytes(arena, source.len)
  begin: []const u8 = "-----BEGIN "
  end_prefix: []const u8 = "-----END "
  start: usize = 0
  for start + begin.len <= source.len && !equal_at(source, start, begin) {
    start += 1
  }
  if start + begin.len > source.len { return malformed(arena, status, mark, source.len) }
  label_start := start + begin.len
  label_end := label_start
  for label_end + 5 <= source.len && !equal_at(source, label_end, "-----") {
    label_end += 1
  }
  if label_end == label_start || label_end + 5 > source.len {
    return malformed(arena, status, mark, label_end)
  }
  label := source[label_start..label_end]
  at := label_end + 5
  if at < source.len && source[at] == '\r' {
    at += 1
  }
  if at >= source.len || source[at] != '\n' { return malformed(arena, status, mark, at) }
  at += 1
  body_start := at
  encoded_length: usize = 0
  found_end := false
  for at < source.len {
    line_start := at
    for at < source.len && source[at] != '\r' && source[at] != '\n' {
      at += 1
    }
    line := source[line_start..at]
    if line.len >= end_prefix.len && equal_at(line, 0, end_prefix) {
      if line.len != end_prefix.len + label.len + 5 || !equal_at(line, end_prefix.len, label) || !equal_at(line, end_prefix.len + label.len, "-----") {
        return malformed(arena, status, mark, line_start)
      }
      found_end = true
      if at < source.len && source[at] == '\r' {
        at += 1
      }
      if at < source.len && source[at] == '\n' {
        at += 1
      }
      break
    }
    if !append(base64_storage, &encoded_length, line) {
      return malformed(arena, status, mark, line_start)
    }
    if at < source.len && source[at] == '\r' {
      at += 1
    }
    if at < source.len && source[at] == '\n' {
      at += 1
    }
  }
  if !found_end { return malformed(arena, status, mark, at) }
  decoded := base64.decode(arena, base64_storage[..encoded_length]) catch { return malformed(arena, status, mark, body_start) }
  return Block{ data: decoded, label: label, consumed: at }
}
