use "std/mem" mem
use "std/errors" errors
use "std/encoding/base64" base64

pub struct Result { value: []u8, label: []const u8, consumed: usize, offset: usize, kind: errors.Kind, error: isize, ok: bool }
fn equal_at(source: []const u8, at: usize, expected: []const u8) bool {
  if at > #len(source) || #len(expected) > #len(source) - at {
    return false
  }
  for i in 0..#len(expected) {
    if source[at + i] != expected[i] {
      return false
    }
  }
  return true
}
fn append(destination: []u8, at: *usize, source: []const u8) bool {
  if #len(source) > #len(destination) - at.* {
    return false
  }
  for byte in source {
    destination[at.*] = byte
    at.* += 1
  }
  return true
}

fn fail(arena: *mem.Arena, mark: usize, offset: usize, kind: errors.Kind) Result {
  mem.arena_rewind(arena, mark)
  return Result{ kind: kind, offset: offset }
}
// Decodes the first PEM block. value is arena-owned; label borrows source.
// Failure returns an empty payload and restores the entry arena mark.
pub fn decode(arena: *mem.Arena, source: []const u8) Result {
  mark := mem.arena_mark(arena)
  base64_storage := mem.push_bytes_uninit(arena, #len(source))
  begin: []const u8 = "-----BEGIN "
  end_prefix: []const u8 = "-----END "
  start: usize = 0
  for start + #len(begin) <= #len(source) && !equal_at(source, start, begin) {
    start += 1
  }
  if start + #len(begin) > #len(source) {
    return fail(arena, mark, #len(source), errors.Kind.InvalidInput)
  }
  label_start := start + #len(begin)
  label_end := label_start
  for label_end + 5 <= #len(source) && !equal_at(source, label_end, "-----") {
    label_end += 1
  }
  if label_end == label_start || label_end + 5 > #len(source) {
    return fail(arena, mark, label_end, errors.Kind.InvalidInput)
  }
  label := source[label_start..label_end]
  at := label_end + 5
  if at < #len(source) && source[at] == '\r' {
    at += 1
  }
  if at >= #len(source) || source[at] != '\n' {
    return fail(arena, mark, at, errors.Kind.InvalidInput)
  }
  at += 1
  body_start := at
  encoded_length: usize = 0
  found_end := false
  for at < #len(source) {
    line_start := at
    for at < #len(source) && source[at] != '\r' && source[at] != '\n' {
      at += 1
    }
    line := source[line_start..at]
    if #len(line) >= #len(end_prefix) && equal_at(line, 0, end_prefix) {
      if #len(line) != #len(end_prefix) + #len(label) + 5 || !equal_at(line, #len(end_prefix), label) || !equal_at(line, #len(end_prefix) + #len(label), "-----") {
        return fail(arena, mark, line_start, errors.Kind.InvalidInput)
      }
      found_end = true
      if at < #len(source) && source[at] == '\r' {
        at += 1
      }
      if at < #len(source) && source[at] == '\n' {
        at += 1
      }
      break
    }
    if !append(base64_storage, &encoded_length, line) {
      return fail(arena, mark, line_start, errors.Kind.InvalidInput)
    }
    if at < #len(source) && source[at] == '\r' {
      at += 1
    }
    if at < #len(source) && source[at] == '\n' {
      at += 1
    }
  }
  if !found_end {
    return fail(arena, mark, at, errors.Kind.InvalidInput)
  }
  decoded := base64.decode(arena, base64_storage[..encoded_length])
  if !decoded.ok {
    return fail(arena, mark, body_start, errors.Kind.InvalidInput)
  }
  return Result{ value: decoded.value, label: label, consumed: at, ok: true }
}
