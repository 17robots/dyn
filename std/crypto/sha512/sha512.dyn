// FIPS 180-4 SHA-512. Streaming, caller-owned state and output.
use "std/encoding/binary" binary
pub struct State { words: [8]u64, buffer: [128]u8, used: usize, low: u64, high: u64, initialized: bool, failed: bool }
const K: [80]u64 = [
  0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
  0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
  0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
  0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
  0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0xfc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
  0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
  0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
  0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x6ca6351e003826f, 0x142929670a0e6e70,
  0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
  0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
  0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
  0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
  0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
  0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
  0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
  0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
  0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
  0x6f067aa72176fba, 0xa637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
  0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
  0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817
]
fn rotate(x: u64, n: usize) u64 {
  return (x >> n) | #wrap(x << (64-n))
}
fn block(state: *State, input: []const u8) {
  w: [80]u64
  for i in 0..16 {
    w[i]=binary.load_u64_be(input[i*8..i*8+8])
  }
  for i in 16..80 {
    x:=w[i-15]
    y:=w[i-2]
    s0:=rotate(x, 1)^rotate(x, 8)^(x>>7)
    s1:=rotate(y, 19)^rotate(y, 61)^(y>>6)
    w[i]=#wrap(w[i-16]+s0+w[i-7]+s1)
  }
  a:=state.words[0]
  b:=state.words[1]
  c:=state.words[2]
  d:=state.words[3]
  e:=state.words[4]
  f:=state.words[5]
  g:=state.words[6]
  h:=state.words[7]
  for i in 0..80 {
    s1:=rotate(e, 14)^rotate(e, 18)^rotate(e, 41)
    choose:=(e&f)^((~e)&g)
    t1:=#wrap(h+s1+choose+K[i]+w[i])
    s0:=rotate(a, 28)^rotate(a, 34)^rotate(a, 39)
    majority:=(a&b)^(a&c)^(b&c)
    t2:=#wrap(s0+majority)
    h=g
    g=f
    f=e
    e=#wrap(d+t1)
    d=c
    c=b
    b=a
    a=#wrap(t1+t2)
  }
  state.words[0]=#wrap(state.words[0]+a)
  state.words[1]=#wrap(state.words[1]+b)
  state.words[2]=#wrap(state.words[2]+c)
  state.words[3]=#wrap(state.words[3]+d)
  state.words[4]=#wrap(state.words[4]+e)
  state.words[5]=#wrap(state.words[5]+f)
  state.words[6]=#wrap(state.words[6]+g)
  state.words[7]=#wrap(state.words[7]+h)
}
pub fn init() State {
  return State{words: [0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1, 0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179], initialized:true}
}
pub fn update(state: *State, input: []const u8) bool {
  if !state.initialized {
    state.*=init()
  }
  if state.failed {
    return false
  }
  // Count bytes in 125 bits, so the 128-bit bit count cannot overflow.
  before:=state.low
  state.low=#wrap(state.low+#cast(u64, #len(input)))
  if state.low<before {
    state.high+=1
  }
  if state.high>0x1fffffffffffffff {
    state.failed=true
    return false
  }
  at: usize
  if state.used!=0 {
    for at<#len(input) && state.used<128 {
      state.buffer[state.used]=input[at]
      state.used+=1
      at+=1
    }
    if state.used==128 {
      block(state, state.buffer[..])
      state.used=0
    }
  }
  for #len(input)-at>=128 {
    block(state, input[at..at+128])
    at+=128
  }
  for at<#len(input) {
    state.buffer[state.used]=input[at]
    state.used+=1
    at+=1
  }
  return true
}
pub fn finish(state: *State, destination: []u8) []u8 {
  if !state.initialized {
    state.*=init()
  }
  if state.failed || #len(destination)<64 {
    return destination[..0]
  }
  tail: [256]u8
  for i in 0..state.used {
    tail[i]=state.buffer[i]
  }
  tail[state.used]=128
  count: usize=128
  if state.used>=112 {
    count=256
  }
  binary.store_u64_be(tail[count-16..count-8], (state.high<<3)|(state.low>>61))
  binary.store_u64_be(tail[count-8..count], #wrap(state.low<<3))
  block(state, tail[..128])
  if count==256 {
    block(state, tail[128..])
  }
  for i in 0..8 {
    binary.store_u64_be(destination[i*8..i*8+8], state.words[i])
  }
  state.*=State{initialized:true, failed:true}
  return destination[..64]
}
pub fn digest(destination: []u8, input: []const u8) []u8 {
  state:=init()
  if !update(&state, input) {
    return destination[..0]
  }
  return finish(&state, destination)
}
