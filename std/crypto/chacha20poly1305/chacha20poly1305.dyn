use "std/crypto/chacha20" chacha
use "std/crypto/poly1305" poly
use "std/encoding/binary" binary
use "std/fail"
// RFC 8439 AEAD. Key:32, nonce:12, tag:16 bytes. Never reuse a nonce/key pair.
// Caller owns all storage. Input/output may be exactly the same slice, but no
// partial overlap is allowed. Other output/input overlaps are rejected before
// writing. Bad sizes or overlaps fail with InvalidInput, and so does a tag that
// does not authenticate; failure leaves destination unchanged.
fn overlaps(left: []const u8, right: []const u8) bool {
  if #len(left) == 0 || #len(right) == 0 { return false }
  a := #cast(usize, &left[0])
  b := #cast(usize, &right[0])
  if a <= b { return b - a < #len(left) }
  return a - b < #len(right)
}
fn valid(output: []u8, input: []const u8, aad: []const u8, key: []const u8, nonce: []const u8) bool {
  if #len(key) != 32 || #len(nonce) != 12 || #len(output) != #len(input) { return false }
  // Counter zero is reserved for the MAC key. This expression cannot overflow.
  blocks := #len(input) / 64
  if #len(input) % 64 != 0 {
    blocks += 1
  }
  if #cast(u64, blocks) > 0xffffffff { return false }
  if overlaps(output, key) || overlaps(output, nonce) || overlaps(output, aad) { return false }
  if overlaps(output, input) && #cast(rawptr, &output[0]) != #cast(rawptr, &input[0]) {
    return false
  }
  return true
}
// Sizes are checked by the callers, so the primitives below cannot fail.
fn mac(status: *fail.Status, ciphertext: []const u8, aad: []const u8, key: []const u8, nonce: []const u8) [16]u8 {
  first: [64]u8
  chacha.block(status, first[..], key, nonce, 0)
  state := poly.init(status, first[..32])
  zero: [16]u8
  poly.update(&state, aad)
  if #len(aad) % 16 != 0 {
    poly.update(&state, zero[..16-#len(aad)%16])
  }
  poly.update(&state, ciphertext)
  if #len(ciphertext) % 16 != 0 {
    poly.update(&state, zero[..16-#len(ciphertext)%16])
  }
  lengths: [16]u8
  binary.store_u64_le(lengths[..8], #len(aad))
  binary.store_u64_le(lengths[8..], #len(ciphertext))
  poly.update(&state, lengths[..])
  return poly.finish(status, &state)
}
pub fn seal(status: *fail.Status, output: []u8, tag: []u8, input: []const u8, aad: []const u8, key: []const u8, nonce: []const u8) {
  if status == nil {
    seal(&fail.Status{}, output, tag, input, aad, key, nonce)
    return
  }
  if status.failed { return }
  if !valid(output, input, aad, key, nonce) || #len(tag) != 16 || overlaps(tag, output) || overlaps(tag, input) || overlaps(tag, aad) || overlaps(tag, key) || overlaps(tag, nonce) {
    fail.invalid(status, "ChaCha20-Poly1305 seal", "", "bad key, nonce, tag or output size, or overlapping buffers")
    return
  }
  chacha.xor(status, output, input, key, nonce, 1)
  result := mac(status, output, aad, key, nonce)
  if status.failed { return }
  for i in 0..16 {
    tag[i] = result[i]
  }
}
pub fn open(status: *fail.Status, output: []u8, input: []const u8, tag: []const u8, aad: []const u8, key: []const u8, nonce: []const u8) {
  if status == nil {
    open(&fail.Status{}, output, input, tag, aad, key, nonce)
    return
  }
  if status.failed { return }
  if !valid(output, input, aad, key, nonce) || #len(tag) != 16 || overlaps(output, tag) {
    fail.invalid(status, "ChaCha20-Poly1305 open", "", "bad key, nonce, tag or output size, or overlapping buffers")
    return
  }
  expected := mac(status, input, aad, key, nonce)
  if status.failed { return }
  if !poly.equal(expected[..], tag) {
    fail.invalid(status, "ChaCha20-Poly1305 open", "", "authentication failed")
    return
  }
  chacha.xor(status, output, input, key, nonce, 1)
}
