use chacha "std/crypto/chacha20"
use poly "std/crypto/poly1305"
use binary "std/encoding/binary"
// RFC 8439 AEAD. Key:32, nonce:12, tag:16 bytes. Never reuse a nonce/key pair.
// Caller owns all storage. Input/output may be exactly the same slice, but no
// partial overlap is allowed. Other output/input overlaps are rejected before
// writing. Bad sizes or overlaps fail with InvalidInput, and so does a tag that
// does not authenticate; failure leaves destination unchanged.
fn overlaps(left: []const u8, right: []const u8) bool {
  if left.len == 0 || right.len == 0 { return false }
  a := #cast(usize, &left[0])
  b := #cast(usize, &right[0])
  if a <= b { return b - a < left.len }
  return a - b < right.len
}
fn valid(output: []u8, input: []const u8, aad: []const u8, key: []const u8, nonce: []const u8) bool {
  if key.len != 32 || nonce.len != 12 || output.len != input.len { return false }
  // Counter zero is reserved for the MAC key. This expression cannot overflow.
  blocks := input.len / 64
  if input.len % 64 != 0 {
    blocks += 1
  }
  if #cast(u64, blocks) > 0xffffffff { return false }
  if overlaps(output, key) || overlaps(output, nonce) || overlaps(output, aad) { return false }
  if overlaps(output, input) && #cast(rawptr, &output[0]) != #cast(rawptr, &input[0]) {
    return false
  }
  return true
}
// Sizes are checked by the callers, so the primitives below cannot fail.
fn mac(ciphertext: []const u8, aad: []const u8, key: []const u8, nonce: []const u8) [16]u8! {
  first: [64]u8
  try chacha.block(first[..], key, nonce, 0)
  state := try poly.init(first[..32])
  zero: [16]u8
  poly.update(&state, aad)
  if aad.len % 16 != 0 {
    poly.update(&state, zero[..16 - aad.len % 16])
  }
  poly.update(&state, ciphertext)
  if ciphertext.len % 16 != 0 {
    poly.update(&state, zero[..16 - ciphertext.len % 16])
  }
  lengths: [16]u8
  binary.store_u64_le(lengths[..8], aad.len)
  binary.store_u64_le(lengths[8..], ciphertext.len)
  poly.update(&state, lengths[..])
  return try poly.finish(&state)
}
pub fn seal(output: []u8, tag: []u8, input: []const u8, aad: []const u8, key: []const u8, nonce: []const u8) ! {
  if !valid(output, input, aad, key, nonce) || tag.len != 16 || overlaps(tag, output) || overlaps(tag, input) || overlaps(tag, aad) || overlaps(tag, key) || overlaps(tag, nonce) {
    fail
  }
  try chacha.xor(output, input, key, nonce, 1)
  result := try mac(output, aad, key, nonce)
  for i in 0..16 {
    tag[i] = result[i]
  }
}
pub fn open(output: []u8, input: []const u8, tag: []const u8, aad: []const u8, key: []const u8, nonce: []const u8) ! {
  if !valid(output, input, aad, key, nonce) || tag.len != 16 || overlaps(output, tag) { fail }
  expected := try mac(input, aad, key, nonce)
  if !poly.equal(expected[..], tag) { fail }
  try chacha.xor(output, input, key, nonce, 1)
}
