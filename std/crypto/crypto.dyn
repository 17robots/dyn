const Mod32: u64 = 4294967296
fn add32(a: u32, b: u32) u32 {
  wide_a: u64 = #cast(u64) a
  wide_b: u64 = #cast(u64) b
  return #cast(u32) ((wide_a + wide_b) % Mod32)
}
fn shl32(x: u32, n: usize) u32 {
  factor: u64 = 1
  i: usize = 0
  for i < n { factor *= 2 i += 1 }
  wide: u64 = #cast(u64) x
  return #cast(u32) ((wide * factor) % Mod32)
}
fn rotr(x: u32, n: usize) u32 { return (x >> n) | shl32(x, 32 - n) }

const K: [64]u64 = [
  1116352408,1899447441,3049323471,3921009573,961987163,1508970993,2453635748,2870763221,
  3624381080,310598401,607225278,1426881987,1925078388,2162078206,2614888103,3248222580,
  3835390401,4022224774,264347078,604807628,770255983,1249150122,1555081692,1996064986,
  2554220882,2821834349,2952996808,3210313671,3336571891,3584528711,113926993,338241895,
  666307205,773529912,1294757372,1396182291,1695183700,1986661051,2177026350,2456956037,
  2730485921,2820302411,3259730800,3345764771,3516065817,3600352804,4094571909,275423344,
  430227734,506948616,659060556,883997877,958139571,1322822218,1537002063,1747873779,
  1955562222,2024104815,2227730452,2361852424,2428436474,2756734187,3204031479,3329325298
]

fn block(state: []u32, input: []const u8) {
  words: [64]u32 = []
  i: usize = 0
  for i < 16 {
    at := i * 4
    byte0: u32 = #cast(u32) input[at]
    byte1: u32 = #cast(u32) input[at + 1]
    byte2: u32 = #cast(u32) input[at + 2]
    byte3: u32 = #cast(u32) input[at + 3]
    words[i] = (byte0 << 24) | (byte1 << 16) | (byte2 << 8) | byte3
    i += 1
  }
  for i < 64 {
    word_x := words[i - 15] word_y := words[i - 2]
    extend0 := rotr(word_x, 7) ^ rotr(word_x, 18) ^ (word_x >> 3)
    extend1 := rotr(word_y, 17) ^ rotr(word_y, 19) ^ (word_y >> 10)
    words[i] = add32(add32(words[i - 16], extend0), add32(words[i - 7], extend1))
    i += 1
  }
  a := state[0] b := state[1] c := state[2] d := state[3]
  e := state[4] f := state[5] g := state[6] h := state[7]
  i = 0
  for i < 64 {
    round1 := rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
    choose := (e & f) ^ ((e ^ 4294967295) & g)
    constant: u32 = #cast(u32) K[i]
    t1 := add32(add32(add32(add32(h, round1), choose), constant), words[i])
    round0 := rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
    majority := (a & b) ^ (a & c) ^ (b & c)
    t2 := add32(round0, majority)
    h = g g = f f = e e = add32(d, t1) d = c c = b b = a a = add32(t1, t2)
    i += 1
  }
  state[0] = add32(state[0], a) state[1] = add32(state[1], b)
  state[2] = add32(state[2], c) state[3] = add32(state[3], d)
  state[4] = add32(state[4], e) state[5] = add32(state[5], f)
  state[6] = add32(state[6], g) state[7] = add32(state[7], h)
}

pub struct Sha256 { state: [8]u32, tail: [64]u8, tail_length: usize, length: u64 }

pub fn sha256_init(context: *Sha256) {
  context.state = [1779033703,3144134277,1013904242,2773480762,1359893119,2600822924,528734635,1541459225]
  context.tail_length = 0 context.length = 0
}

// Adds one chunk. False means the SHA-256 maximum input length was exceeded.
pub fn sha256_update(context: *Sha256, input: []const u8) bool {
  input_length: u64 = #cast(u64) #len(input)
  maximum: u64 = 2305843009213693951
  if input_length > maximum - context.length { return false }
  context.length += input_length
  at: usize = 0
  if context.tail_length != 0 {
    block_size: usize = 64
    needed := block_size - context.tail_length
    take: usize = #len(input)
    if take > needed { take = needed }
    i: usize = 0
    for i < take { context.tail[context.tail_length + i] = input[i] i += 1 }
    context.tail_length += take at += take
    if context.tail_length == 64 { block(context.state[..], context.tail[..]) context.tail_length = 0 }
    else { return true }
  }
  for at + 64 <= #len(input) { block(context.state[..], input[at..at + 64]) at += 64 }
  rest: usize = 0
  for at + rest < #len(input) { context.tail[rest] = input[at + rest] rest += 1 }
  context.tail_length = rest
  return true
}

// Finishes into 32 caller-owned bytes. The context may be reinitialized and reused.
pub fn sha256_finish(context: *Sha256, destination: []u8) []u8 {
  if #len(destination) < 32 { return destination[..0] }
  tail: [128]u8 = []
  remaining := context.tail_length
  i: usize = 0
  for i < remaining { tail[i] = context.tail[i] i += 1 }
  tail[remaining] = 128
  blocks: usize = 64
  if remaining >= 56 { blocks = 128 }
  bits := context.length * 8
  i = 0
  for i < 8 { tail[blocks - 1 - i] = #cast(u8) (bits >> (i * 8)) i += 1 }
  block(context.state[..], tail[..64])
  if blocks == 128 { block(context.state[..], tail[64..]) }
  i = 0
  for i < 8 {
    destination[i * 4] = #cast(u8) (context.state[i] >> 24)
    destination[i * 4 + 1] = #cast(u8) (context.state[i] >> 16)
    destination[i * 4 + 2] = #cast(u8) (context.state[i] >> 8)
    destination[i * 4 + 3] = #cast(u8) context.state[i]
    i += 1
  }
  return destination[..32]
}

// Writes 32-byte SHA-256 digest. Empty slice means destination too small or oversized input.
pub fn sha256(destination: []u8, input: []const u8) []u8 {
  context := Sha256{} sha256_init(&context)
  if !sha256_update(&context, input) { return destination[..0] }
  return sha256_finish(&context, destination)
}

pub fn hmac_sha256(destination: []u8, key: []const u8, message: []const u8) []u8 {
  if #len(destination) < 32 { return destination[..0] }
  key_block: [64]u8 = [] key_digest: [32]u8 = []
  key_at: usize = 0
  if #len(key) > 64 {
    hashed := sha256(key_digest[..], key)
    for key_at < #len(hashed) { key_block[key_at] = hashed[key_at] key_at += 1 }
  } else {
    for key_at < #len(key) { key_block[key_at] = key[key_at] key_at += 1 }
  }
  inner_block: [64]u8 = [] outer_block: [64]u8 = []
  pad_at: usize = 0
  for pad_at < 64 { inner_block[pad_at] = key_block[pad_at] ^ 54 outer_block[pad_at] = key_block[pad_at] ^ 92 pad_at += 1 }
  inner := Sha256{} sha256_init(&inner)
  if !sha256_update(&inner, inner_block[..]) || !sha256_update(&inner, message) { return destination[..0] }
  inner_digest: [32]u8 = []
  _ = sha256_finish(&inner, inner_digest[..])
  outer := Sha256{} sha256_init(&outer)
  if !sha256_update(&outer, outer_block[..]) || !sha256_update(&outer, inner_digest[..]) { return destination[..0] }
  return sha256_finish(&outer, destination)
}

pub fn equal_constant_time(left: []const u8, right: []const u8) bool {
  if #len(left) != #len(right) { return false }
  difference: u8 = 0
  i: usize = 0
  for i < #len(left) { difference = difference | (left[i] ^ right[i]) i += 1 }
  return difference == 0
}

// Linux getrandom. Success only when whole destination filled.
pub fn secure_random(destination: []u8) bool {
  total: usize = 0
  for total < #len(destination) {
    got := #syscall(318, &destination[total], #len(destination) - total, 0)
    if got == -4 { } else if got <= 0 { return false } else { total += #cast(usize) got }
  }
  return true
}
