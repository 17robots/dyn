use "std/fail"
use "std/crypto/core" crypto_core
use "std/bytes" bytes

// PBKDF2-HMAC-SHA256. scratch needs len(salt)+4 bytes.
// Destination and scratch must not overlap each other or borrowed password/salt,
// including unused slice tails. Validation failure leaves all storage unchanged.
pub fn pbkdf2_sha256(status: *fail.Status, destination: []u8, password: []const u8, salt: []const u8, iterations: u32, scratch: []u8) {
  if status == nil {
    pbkdf2_sha256(&fail.Status{}, destination, password, salt, iterations, scratch)
    return
  }
  if status.failed { return }
  limit: u64 = 2305843009213693951
  if iterations == 0 || #cast(u64, #len(destination)) > 137438953440 || #len(salt) > #max(usize) - 4 || #len(salt) > limit - 68 || #len(password) > limit || #len(scratch) < #len(salt) + 4 {
    fail.invalid(status, "PBKDF2", "", "bad sizes, zero iterations, or overlapping password, salt, output or scratch")
    return
  }
  if bytes.overlaps(destination, scratch) || bytes.overlaps(destination, password) || bytes.overlaps(destination, salt) || bytes.overlaps(scratch, password) || bytes.overlaps(scratch, salt) {
    fail.invalid(status, "PBKDF2", "", "bad sizes, zero iterations, or overlapping password, salt, output or scratch")
    return
  }
  i: usize = 0
  for i < #len(salt) {
    scratch[i] = salt[i]
    i += 1
  }
  output_at: usize = 0
  block_index: u32 = 1
  keyed := crypto_core.HmacSha256{}
  crypto_core.hmac_sha256_init(&keyed, password)
  if keyed.inner.failed {
    fail.invalid(status, "PBKDF2", "", "bad sizes, zero iterations, or overlapping password, salt, output or scratch")
    return
  }
  first: [32]u8
  accumulated: [32]u8
  next_value: [32]u8
  for output_at < #len(destination) {
    salt_length := #len(salt)
    scratch[salt_length] = (block_index >> 24)
    scratch[salt_length + 1] = #cast(u8, (block_index >> 16))
    scratch[salt_length + 2] = #cast(u8, (block_index >> 8))
    scratch[salt_length + 3] = #cast(u8, block_index)
    if #len(crypto_core.hmac_sha256_sum(&keyed, first[..], scratch[..salt_length + 4])) != 32 {
      fail.invalid(status, "PBKDF2", "", "bad sizes, zero iterations, or overlapping password, salt, output or scratch")
      return
    }
    i = 0
    for i < 32 {
      accumulated[i] = first[i]
      next_value[i] = first[i]
      i += 1
    }
    for round in 1..iterations {
      if #len(crypto_core.hmac_sha256_sum(&keyed, next_value[..], next_value[..])) != 32 {
        fail.invalid(status, "PBKDF2", "", "bad sizes, zero iterations, or overlapping password, salt, output or scratch")
        return
      }
      i = 0
      for i < 32 {
        accumulated[i] = accumulated[i] ^ next_value[i]
        i += 1
      }
    }
    take := #len(destination) - output_at
    if take > 32 {
      take = 32
    }
    i = 0
    for i < take {
      destination[output_at + i] = accumulated[i]
      i += 1
    }
    output_at += take
    if output_at < #len(destination) {
      block_index += 1
    }
  }
}
