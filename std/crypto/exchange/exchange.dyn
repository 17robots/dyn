use "std/crypto/x25519" native
use "std/bytes"
use "std/fail"
// Fixed-size keys and signatures use caller storage by exception. Successful
// values borrow destination; failures return an empty value. Validation leaves
// storage untouched. Arithmetic failures clear only the intended output prefix.
// A bad length, key or overlap fails with InvalidInput.

fn result(status: *fail.Status, destination: []u8, ok: bool) []u8 {
  if !ok {
    for i in 0..#len(destination) {
      destination[i] = 0
    }
    fail.invalid(status, "exchange keys", "", "the key was rejected")
    return destination[..0]
  }
  return destination
}
fn rejected(status: *fail.Status, destination: []u8, message: []const u8) []u8 {
  fail.invalid(status, "exchange keys", "", message)
  return destination[..0]
}

// Destination must not overlap either borrowed input, including in its tail.
pub fn x25519_public(status: *fail.Status, destination: []u8, private_key: []const u8) []u8 {
  if status.failed { return destination[..0] }
  if #len(destination) < 32 || #len(private_key) != 32 {
    return rejected(status, destination, "bad key or destination length")
  }
  if bytes.overlaps(destination, private_key) {
    return rejected(status, destination, "destination overlaps an input")
  }
  return result(status, destination[..32], native.public_key(destination[..32], private_key))
}
pub fn x25519(status: *fail.Status, destination: []u8, private_key: []const u8, peer_public_key: []const u8) []u8 {
  if status.failed { return destination[..0] }
  if #len(destination) < 32 || #len(private_key) != 32 || #len(peer_public_key) != 32 {
    return rejected(status, destination, "bad key or destination length")
  }
  if bytes.overlaps(destination, private_key) || bytes.overlaps(destination, peer_public_key) {
    return rejected(status, destination, "destination overlaps an input")
  }
  return result(status, destination[..32], native.shared(destination[..32], private_key, peer_public_key))
}
