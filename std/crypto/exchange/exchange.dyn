use native "std/crypto/x25519"
use "std/bytes"
// Fixed-size keys and signatures use caller storage by exception. Successful
// values borrow destination. Validation leaves storage untouched. Arithmetic
// failures clear only the intended output prefix. A bad length, key or
// overlap fails.

// Clears output after the primitive failed.
fn cleared(output: []u8) {
  for i in 0..output.len {
    output[i] = 0
  }
}

// Destination must not overlap either borrowed input, including in its tail.
pub fn x25519_public(destination: []u8, private_key: []const u8) []u8! {
  if destination.len < 32 || private_key.len != 32 { fail }
  if bytes.overlaps(destination, private_key) { fail }
  native.public_key(destination[..32], private_key) catch {
    cleared(destination[..32])
    fail
  }
  return destination[..32]
}
pub fn x25519(destination: []u8, private_key: []const u8, peer_public_key: []const u8) []u8! {
  if destination.len < 32 || private_key.len != 32 || peer_public_key.len != 32 { fail }
  if bytes.overlaps(destination, private_key) || bytes.overlaps(destination, peer_public_key) { fail }
  native.shared(destination[..32], private_key, peer_public_key) catch {
    cleared(destination[..32])
    fail
  }
  return destination[..32]
}
