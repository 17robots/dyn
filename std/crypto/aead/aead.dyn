use "std/fail"
use "std/crypto/aesgcm" aes
use "std/mem" mem
use "std/crypto/chacha20poly1305" native
pub enum Cipher { Aes256Gcm, Chacha20Poly1305 }
pub struct Sealed { ciphertext: []u8, tag: []u8 }

fn valid(kind: Cipher, count: usize, additional: []const u8, key: []const u8, nonce: []const u8) bool {
  if kind != Cipher.Aes256Gcm && kind != Cipher.Chacha20Poly1305 { return false }
  if #len(key) != 32 || #len(nonce) == 0 || #len(nonce) > 2147483647 || count > 2147483647 || #len(additional) > 2147483647 {
    return false
  }
  // Preserve the established GCM nonce and payload limits; ChaCha fixes IV12.
  if kind == Cipher.Aes256Gcm && #len(nonce) > 128 { return false }
  if kind == Cipher.Chacha20Poly1305 && #len(nonce) != 12 { return false }
  return true
}
fn overlaps(left: []const u8, right: []const u8) bool {
  if #len(left) == 0 || #len(right) == 0 { return false }
  a := #cast(usize, &left[0])
  b := #cast(usize, &right[0])
  if a <= b { return b - a < #len(left) }
  return a - b < #len(right)
}
// Reject unused backing before allocations can overwrite borrowed inputs.
// Allocated inputs remain stable when this arena adds blocks.
fn conflicts(arena: *mem.Arena, _count: usize, first: []const u8, second: []const u8, additional: []const u8, key: []const u8, nonce: []const u8) bool {
  return mem.arena_overlaps_unallocated(arena, first) || mem.arena_overlaps_unallocated(arena, second) || mem.arena_overlaps_unallocated(arena, additional) || mem.arena_overlaps_unallocated(arena, key) || mem.arena_overlaps_unallocated(arena, nonce)
}

// Produces arena-owned ciphertext (same length as plaintext) and a 16-byte tag.
// Views expire on the applicable arena rewind/reset/release. Inputs are borrowed
// only for this call and must not overlap pending output. Key is 32 bytes; GCM
// accepts 1..128 nonce bytes, ChaCha requires 12 bytes. Nonce uniqueness for a key
// is the caller's responsibility. Exhaustion panics; failure returns empty
// values, preserves the arena prefix, and consumes no arena bytes. A bad key,
// nonce or size, or an input in the arena's free space, fails with InvalidInput.
pub fn seal(arena: *mem.Arena, status: *fail.Status, kind: Cipher, plaintext: []const u8, additional: []const u8, key: []const u8, nonce: []const u8) Sealed {
  if status.failed { return Sealed{} }
  count := #len(plaintext)
  if !valid(kind, count, additional, key, nonce) || count > #max(usize) - 16 {
    fail.invalid(status, "seal", "", "bad cipher, key, nonce or size")
    return Sealed{}
  }
  empty: []const u8
  if conflicts(arena, count + 16, plaintext, empty, additional, key, nonce) {
    fail.invalid(status, "seal", "", "an input lies in the arena's free space")
    return Sealed{}
  }
  mark := mem.arena_mark(arena)
  output := mem.push_bytes(arena, count + 16)
  ciphertext := output[..count]
  tag := output[count..]
  if kind == Cipher.Chacha20Poly1305 {
    native.seal(status, ciphertext, tag, plaintext, additional, key, nonce)
  } else {
    aes.seal(status, ciphertext, tag, plaintext, additional, key, nonce)
  }
  if status.failed {
    mem.zero(output)
    mem.arena_rewind(arena, mark)
    return Sealed{}
  }
  return Sealed{ciphertext: ciphertext, tag: tag}
}

// Produces arena-owned authenticated plaintext of ciphertext length. Same
// borrowing, nonce, exhaustion and lifetime rules as seal; tag must be 16 bytes.
// On failure clears all allocated plaintext before rewinding. Authentication
// rejection is InvalidInput. Failure never publishes partial plaintext.
pub fn open(arena: *mem.Arena, status: *fail.Status, kind: Cipher, ciphertext: []const u8, tag: []const u8, additional: []const u8, key: []const u8, nonce: []const u8) []u8 {
  empty: []u8
  if status.failed { return empty }
  count := #len(ciphertext)
  if !valid(kind, count, additional, key, nonce) || #len(tag) != 16 {
    fail.invalid(status, "open", "", "bad cipher, key, nonce, tag or size")
    return empty
  }
  if conflicts(arena, count, ciphertext, tag, additional, key, nonce) {
    fail.invalid(status, "open", "", "an input lies in the arena's free space")
    return empty
  }
  mark := mem.arena_mark(arena)
  plaintext := mem.push_bytes(arena, count)
  if kind == Cipher.Chacha20Poly1305 {
    native.open(status, plaintext, ciphertext, tag, additional, key, nonce)
  } else {
    aes.open(status, plaintext, ciphertext, tag, additional, key, nonce)
  }
  if status.failed {
    mem.zero(plaintext)
    mem.arena_rewind(arena, mark)
    return empty
  }
  return plaintext
}
