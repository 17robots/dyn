use "std/crypto/aesgcm" aes
use "std/mem" mem
use "std/crypto/chacha20poly1305" native
use "std/errors" errors

pub enum Cipher { Aes256Gcm, Chacha20Poly1305 }
pub struct Sealed { ciphertext: []u8, tag: []u8 }
pub struct SealResult { value: Sealed, ok: bool, kind: errors.Kind, error: isize, provider_code: u64 }
pub struct OpenResult { value: []u8, ok: bool, kind: errors.Kind, error: isize, provider_code: u64 }

fn valid(kind: Cipher, count: usize, additional: []const u8, key: []const u8, nonce: []const u8) bool {
  if kind != Cipher.Aes256Gcm && kind != Cipher.Chacha20Poly1305 {
    return false
  }
  if #len(key) != 32 || #len(nonce) == 0 || #len(nonce) > 2147483647 || count > 2147483647 || #len(additional) > 2147483647 {
    return false
  }
  // Preserve the established GCM nonce and payload limits; ChaCha fixes IV12.
  if kind == Cipher.Aes256Gcm && #len(nonce) > 128 {
    return false
  }
  if kind == Cipher.Chacha20Poly1305 && #len(nonce) != 12 {
    return false
  }
  return true
}
fn overlaps(left: []const u8, right: []const u8) bool {
  if #len(left) == 0 || #len(right) == 0 {
    return false
  }
  a := #cast(usize, &left[0])
  b := #cast(usize, &right[0])
  if a <= b {
    return b - a < #len(left)
  }
  return a - b < #len(right)
}
// Reject unused backing before allocations can overwrite borrowed inputs.
// Allocated inputs remain stable when this arena adds blocks.
fn conflicts(arena: *mem.Arena, count: usize, first: []const u8, second: []const u8, additional: []const u8, key: []const u8, nonce: []const u8) bool {
  _ = count
  return mem.arena_overlaps_unallocated(arena, first) || mem.arena_overlaps_unallocated(arena, second) || mem.arena_overlaps_unallocated(arena, additional) || mem.arena_overlaps_unallocated(arena, key) || mem.arena_overlaps_unallocated(arena, nonce)
}

// Produces arena-owned ciphertext (same length as plaintext) and a 16-byte tag.
// Views expire on the applicable arena rewind/reset/release. Inputs are borrowed
// only for this call and must not overlap pending output. Key is 32 bytes; GCM
// accepts 1..128 nonce bytes, ChaCha requires 12 bytes. Nonce uniqueness for a key
// is the caller's responsibility. Exhaustion panics; failure returns empty
// values, preserves the arena prefix, and consumes no arena bytes. error and
// provider_code are always zero; the latter remains for source compatibility.
pub fn seal(arena: *mem.Arena, kind: Cipher, plaintext: []const u8, additional: []const u8, key: []const u8, nonce: []const u8) SealResult {
  count := #len(plaintext)
  if !valid(kind, count, additional, key, nonce) || count > ~#cast(usize, 0) - 16 {
    return SealResult{kind: errors.Kind.InvalidInput}
  }
  empty: []const u8
  if conflicts(arena, count + 16, plaintext, empty, additional, key, nonce) {
    return SealResult{kind: errors.Kind.InvalidInput}
  }
  mark := mem.arena_mark(arena)
  output := mem.push_bytes_uninit(arena, count + 16)
  ciphertext := output[..count]
  tag := output[count..]
  ok := false
  if kind == Cipher.Chacha20Poly1305 {
    ok = native.seal(ciphertext, tag, plaintext, additional, key, nonce)
  }
  else {
    ok = aes.seal(ciphertext, tag, plaintext, additional, key, nonce)
  }
  if !ok {
    mem.zero(output)
    mem.arena_rewind(arena, mark)
    return SealResult{kind: errors.Kind.InvalidInput}
  }
  return SealResult{value: Sealed{ciphertext: ciphertext, tag: tag}, ok: true}
}

// Produces arena-owned authenticated plaintext of ciphertext length. Same
// borrowing, nonce, exhaustion and lifetime rules as seal; tag must be 16 bytes.
// On failure clears all allocated plaintext before rewinding. Authentication
// rejection is InvalidInput. Failure never publishes partial plaintext.
pub fn open(arena: *mem.Arena, kind: Cipher, ciphertext: []const u8, tag: []const u8, additional: []const u8, key: []const u8, nonce: []const u8) OpenResult {
  count := #len(ciphertext)
  if !valid(kind, count, additional, key, nonce) || #len(tag) != 16 {
    return OpenResult{kind: errors.Kind.InvalidInput}
  }
  if conflicts(arena, count, ciphertext, tag, additional, key, nonce) {
    return OpenResult{kind: errors.Kind.InvalidInput}
  }
  mark := mem.arena_mark(arena)
  plaintext := mem.push_bytes_uninit(arena, count)
  ok := false
  if kind == Cipher.Chacha20Poly1305 {
    ok = native.open(plaintext, ciphertext, tag, additional, key, nonce)
  }
  else {
    ok = aes.open(plaintext, ciphertext, tag, additional, key, nonce)
  }
  if !ok {
    mem.zero(plaintext)
    mem.arena_rewind(arena, mark)
    return OpenResult{kind: errors.Kind.InvalidInput}
  }
  return OpenResult{value: plaintext, ok: true}
}
