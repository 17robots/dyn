use aes "std/crypto/aesgcm"
use mem "std/mem"
use native "std/crypto/chacha20poly1305"
pub enum Cipher { Aes256Gcm, Chacha20Poly1305 }
pub struct Sealed { ciphertext: []u8, tag: []u8 }

fn valid(kind: Cipher, count: usize, additional: []const u8, key: []const u8, nonce: []const u8) bool {
  if kind != Cipher.Aes256Gcm && kind != Cipher.Chacha20Poly1305 { return false }
  if key.len != 32 || nonce.len == 0 || nonce.len > 2147483647 || count > 2147483647 || additional.len > 2147483647 {
    return false
  }
  // Preserve the established GCM nonce and payload limits; ChaCha fixes IV12.
  if kind == Cipher.Aes256Gcm && nonce.len > 128 { return false }
  if kind == Cipher.Chacha20Poly1305 && nonce.len != 12 { return false }
  return true
}
fn overlaps(left: []const u8, right: []const u8) bool {
  if left.len == 0 || right.len == 0 { return false }
  a := #cast(usize, &left[0])
  b := #cast(usize, &right[0])
  if a <= b { return b - a < left.len }
  return a - b < right.len
}
// Reject unused backing before allocations can overwrite borrowed inputs.
// Allocated inputs remain stable when this arena adds blocks.
fn conflicts(arena: *mem.Arena, _count: usize, first: []const u8, second: []const u8, additional: []const u8, key: []const u8, nonce: []const u8) bool {
  return mem.arena_overlaps_unallocated(arena, first) || mem.arena_overlaps_unallocated(arena, second) || mem.arena_overlaps_unallocated(arena, additional) || mem.arena_overlaps_unallocated(arena, key) || mem.arena_overlaps_unallocated(arena, nonce)
}

// Produces arena-owned ciphertext (same length as plaintext) and a 16-byte tag.
// Views expire on the applicable arena rewind/reset/release. Inputs are borrowed
// only for this call and must not overlap pending output. Key is 32 bytes; GCM
// accepts 1..128 nonce bytes, ChaCha requires 12 bytes. Nonce uniqueness for a key
// is the caller's responsibility. Exhaustion panics; failure preserves the
// arena prefix and consumes no arena bytes. A bad key, nonce or size, or an
// input in the arena's free space, fails.
pub fn seal(arena: *mem.Arena, kind: Cipher, plaintext: []const u8, additional: []const u8, key: []const u8, nonce: []const u8) Sealed! {
  count := plaintext.len
  if !valid(kind, count, additional, key, nonce) || count > #max(usize) - 16 { fail }
  empty: []const u8
  if conflicts(arena, count + 16, plaintext, empty, additional, key, nonce) { fail }
  mark := mem.arena_mark(arena)
  output := mem.push_bytes(arena, count + 16)
  ciphertext := output[..count]
  tag := output[count..]
  sealed := true
  if kind == Cipher.Chacha20Poly1305 {
    native.seal(ciphertext, tag, plaintext, additional, key, nonce) catch { sealed = false }
  } else {
    aes.seal(ciphertext, tag, plaintext, additional, key, nonce) catch { sealed = false }
  }
  if !sealed {
    mem.zero(output)
    mem.arena_rewind(arena, mark)
    fail
  }
  return Sealed{ciphertext: ciphertext, tag: tag}
}

// Produces arena-owned authenticated plaintext of ciphertext length. Same
// borrowing, nonce, exhaustion and lifetime rules as seal; tag must be 16 bytes.
// On failure clears all allocated plaintext before rewinding. Authentication
// rejection fails too. Failure never publishes partial plaintext.
pub fn open(arena: *mem.Arena, kind: Cipher, ciphertext: []const u8, tag: []const u8, additional: []const u8, key: []const u8, nonce: []const u8) []u8! {
  count := ciphertext.len
  if !valid(kind, count, additional, key, nonce) || tag.len != 16 { fail }
  if conflicts(arena, count, ciphertext, tag, additional, key, nonce) { fail }
  mark := mem.arena_mark(arena)
  plaintext := mem.push_bytes(arena, count)
  opened := true
  if kind == Cipher.Chacha20Poly1305 {
    native.open(plaintext, ciphertext, tag, additional, key, nonce) catch { opened = false }
  } else {
    aes.open(plaintext, ciphertext, tag, additional, key, nonce) catch { opened = false }
  }
  if !opened {
    mem.zero(plaintext)
    mem.arena_rewind(arena, mark)
    fail
  }
  return plaintext
}
