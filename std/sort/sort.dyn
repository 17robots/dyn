pub struct SearchResult { index: usize, found: bool }

fn sift_i64(values: []i64, root_value, count: usize) {
  if count < 2 { return }
  root := root_value
  for root <= (count - 2) / 2 {
    child := root * 2 + 1
    if child + 1 < count && values[child] < values[child + 1] { child += 1 }
    if values[root] >= values[child] { return }
    temporary := values[root]
    values[root] = values[child]
    values[child] = temporary
    root = child
  }
}

// In-place ascending heapsort. Uses constant extra storage and makes no allocation.
pub fn i64s(values: []i64) {
  count := #len(values)
  if count < 2 { return }
  parent := count / 2
  for parent > 0 { parent -= 1 sift_i64(values, parent, count) }
  end := count
  for end > 1 {
    end -= 1
    temporary := values[0]
    values[0] = values[end]
    values[end] = temporary
    sift_i64(values, 0, end)
  }
}

fn sift_u64(values: []u64, root_value, count: usize) {
  if count < 2 { return }
  root := root_value
  for root <= (count - 2) / 2 {
    child := root * 2 + 1
    if child + 1 < count && values[child] < values[child + 1] { child += 1 }
    if values[root] >= values[child] { return }
    temporary := values[root]
    values[root] = values[child]
    values[child] = temporary
    root = child
  }
}

pub fn u64s(values: []u64) {
  count := #len(values)
  if count < 2 { return }
  parent := count / 2
  for parent > 0 { parent -= 1 sift_u64(values, parent, count) }
  end := count
  for end > 1 {
    end -= 1
    temporary := values[0]
    values[0] = values[end]
    values[end] = temporary
    sift_u64(values, 0, end)
  }
}

// Returns first equal element, or insertion index when absent.
pub fn search_i64(values: []const i64, target: i64) SearchResult {
  low: usize = 0
  high := #len(values)
  for low < high {
    middle := low + (high - low) / 2
    if values[middle] < target { low = middle + 1 } else { high = middle }
  }
  return SearchResult{ index: low, found: low < #len(values) && values[low] == target }
}

pub fn search_u64(values: []const u64, target: u64) SearchResult {
  low: usize = 0
  high := #len(values)
  for low < high {
    middle := low + (high - low) / 2
    if values[middle] < target { low = middle + 1 } else { high = middle }
  }
  return SearchResult{ index: low, found: low < #len(values) && values[low] == target }
}
