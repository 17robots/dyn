use "std/fail"
use "std/mem" memory

// C ABI names. Target files select long width and plain-char signedness. No wrappers,
// conversions, allocation, or distinct-type friction at foreign call sites.
pub type signed_char = i8
pub type unsigned_char = u8
pub type short = i16
pub type unsigned_short = u16
pub type int = i32
pub type unsigned_int = u32
pub type long_long = i64
pub type unsigned_long_long = u64
pub type float = f32
pub type double = f64
pub type size = usize
pub type ptrdiff = isize
pub type intptr = isize
pub type uintptr = usize
pub type intmax = i64
pub type uintmax = u64
pub type string = *const u8
pub type mutable_string = *u8
pub type pointer = rawptr


// Bounded scan: never reads beyond `maximum`; callers retain source ownership.
pub fn string_length(value: string, maximum: usize) usize {
  if value == nil { return 0 }
  bytes := #slice(value, maximum)
  count: usize = 0
  for count < maximum && bytes[count] != 0 {
    count += 1
  }
  return count
}

// The bytes of a NUL-terminated string, borrowed. InvalidInput for nil;
// Capacity when no NUL comes within maximum bytes.
pub fn bytes_from_string(status: *fail.Status, value: string, maximum: usize) []const u8 {
  if status == nil { return bytes_from_string(&fail.Status{}, value, maximum) }
  empty: []const u8 = ""
  if status.failed { return empty }
  if value == nil {
    fail.invalid(status, "read C string", "", "nil string")
    return empty
  }
  count := string_length(value, maximum)
  if count == maximum {
    fail.set(status, fail.make(fail.Kind.Capacity, "read C string", "", "no NUL within the limit"))
    return empty
  }
  return #slice(value, count)
}

pub fn errno_from_result(value: isize) isize {
  if value < 0 { return 0 - value }
  return 0
}
pub fn succeeded(value: isize) bool {
  return value >= 0
}

// Raw C-ABI scratch conversion. Borrows caller storage; writes source plus NUL.
// An embedded NUL is InvalidInput and too little storage Capacity; either
// leaves storage unchanged and returns nil, as does a source too long to
// terminate (Overflow). Allocates nothing; use
// string_from_bytes for arena-owned strings.
pub fn string_into(status: *fail.Status, destination: []u8, source: []const u8) string {
  if status == nil { return string_into(&fail.Status{}, destination, source) }
  if status.failed { return nil }
  if #len(source) == #cast(usize, -1) {
    fail.set(status, fail.make(fail.Kind.Overflow, "make C string", "", "the text is too long"))
    return nil
  }
  for byte in source {
    if byte == 0 {
      fail.invalid(status, "make C string", "", "the text holds NUL")
      return nil
    }
  }
  if #len(destination) <= #len(source) {
    fail.set(status, fail.make(fail.Kind.Capacity, "make C string", "", "the text does not fit the storage"))
    return nil
  }
  _ = memory.move(destination, source)
  destination[#len(source)] = 0
  return &destination[0]
}

// source with a NUL appended, in arena. An embedded NUL is InvalidInput;
// failure pushes nothing and returns nil.
pub fn string_from_bytes(arena: *memory.Arena, status: *fail.Status, source: []const u8) string {
  if status == nil { return string_from_bytes(arena, &fail.Status{}, source) }
  if status.failed { return nil }
  if #len(source) == #cast(usize, -1) {
    fail.set(status, fail.make(fail.Kind.Overflow, "make C string", "", "the text is too long"))
    return nil
  }
  mark := memory.arena_mark(arena)
  allocation := memory.push_bytes(arena, #len(source) + 1)
  result := string_into(status, allocation, source)
  if status.failed {
    memory.arena_rewind(arena, mark)
  }
  return result
}
