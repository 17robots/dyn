use "std/parse" parse
use "std/mem" memory

// C ABI names. Target files select long width and plain-char signedness. No wrappers,
// conversions, allocation, or distinct-type friction at foreign call sites.
pub type signed_char = i8
pub type unsigned_char = u8
pub type short = i16
pub type unsigned_short = u16
pub type int = i32
pub type unsigned_int = u32
pub type long_long = i64
pub type unsigned_long_long = u64
pub type float = f32
pub type double = f64
pub type size = usize
pub type ptrdiff = isize
pub type intptr = isize
pub type uintptr = usize
pub type intmax = i64
pub type uintmax = u64
pub type string = *const u8
pub type mutable_string = *u8
pub type pointer = rawptr


pub struct StringResult {
  required: usize,
  value: string,
  failure: parse.Failure,
}

pub type BytesResult = parse.Result([]const u8)

// Bounded scan: never reads beyond `maximum`; callers retain source ownership.
pub fn string_length(value: string, maximum: usize) usize {
  if value == nil {
    return 0
  }
  bytes := #slice(value, maximum)
  count: usize = 0
  for count < maximum && bytes[count] != 0 {
    count += 1
  }
  return count
}

pub fn bytes_from_string(value: string, maximum: usize) BytesResult {
  if value == nil {
    return BytesResult{ failure: parse.Failure{ kind: parse.Kind.Syntax } }
  }
  count := string_length(value, maximum)
  if count == maximum {
    return BytesResult{ failure: parse.Failure{ kind: parse.Kind.Truncated } }
  }
  return BytesResult{ value: #slice(value, count) }
}

pub fn errno_from_result(value: isize) isize {
  if value < 0 {
    return 0 - value
  }
  return 0
}
pub fn succeeded(value: isize) bool {
  return value >= 0
}

// Raw C-ABI scratch conversion. Borrows caller storage; writes source plus NUL.
// Invalid input or insufficient capacity leaves storage unchanged. This bounded
// adapter allocates nothing; use string_from_bytes for arena-owned strings.
pub fn string_into(destination: []u8, source: []const u8) StringResult {
  if #len(source) == #cast(usize, -1) {
    return StringResult{ failure: parse.Failure{ kind: parse.Kind.Overflow } }
  }
  for byte in source {
    if byte == 0 {
      return StringResult{ failure: parse.Failure{ kind: parse.Kind.Syntax } }
    }
  }
  required := #len(source) + 1
  if #len(destination) < required {
    return StringResult{ failure: parse.Failure{ kind: parse.Kind.Capacity }, required: required }
  }
  _ = memory.move(destination, source)
  destination[#len(source)] = 0
  return StringResult{ value: &destination[0], required: required }
}

// source with a NUL appended, in arena. Embedded NUL is invalid input; failure
// pushes nothing.
pub fn string_from_bytes(arena: *memory.Arena, source: []const u8) StringResult {
  if #len(source) == #cast(usize, -1) {
    return StringResult{ failure: parse.Failure{ kind: parse.Kind.Overflow } }
  }
  mark := memory.arena_mark(arena)
  allocation := memory.arena_push_uninit(arena, #len(source) + 1, 1)
  result := string_into(#slice(allocation, #len(source) + 1), source)
  if parse.failed(result.failure) {
    memory.arena_rewind(arena, mark)
  }
  return result
}
