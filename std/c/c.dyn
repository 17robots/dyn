// Target-neutral C ABI names. Width-varying long aliases live in target files. No wrappers,
// conversions, allocation, or distinct-type friction at foreign call sites.
pub type char = i8
pub type signed_char = i8
pub type unsigned_char = u8
pub type short = i16
pub type unsigned_short = u16
pub type int = i32
pub type unsigned_int = u32
pub type long_long = i64
pub type unsigned_long_long = u64
pub type float = f32
pub type double = f64
pub type size = usize
pub type ptrdiff = isize
pub type intptr = isize
pub type uintptr = usize
pub type intmax = i64
pub type uintmax = u64
pub type string = *const u8
pub type mutable_string = *u8
pub type pointer = rawptr

pub struct StringResult {
  value: string,
  ok: bool,
}

pub struct BytesResult { value: []const u8, ok: bool }

// Bounded scan: never reads beyond `maximum`; callers retain source ownership.
pub fn string_length(value: string, maximum: usize) usize {
  if value == nil { return 0 }
  bytes := value[..maximum]
  count: usize = 0
  for count < maximum && bytes[count] != 0 { count += 1 }
  return count
}

pub fn bytes_from_string(value: string, maximum: usize) BytesResult {
  if value == nil { return BytesResult{} }
  count := string_length(value, maximum)
  if count == maximum { return BytesResult{} }
  return BytesResult{ value: value[..count], ok: true }
}

pub fn errno_from_result(value: isize) isize {
  if value < 0 { return 0 - value }
  return 0
}
pub fn succeeded(value: isize) bool { return value >= 0 }

// Copies bytes and appends C's terminating zero into caller-owned storage.
pub fn string_from_bytes(destination: []u8, source: []const u8) StringResult {
  if #len(destination) <= #len(source) {
    return StringResult{ value: nil, ok: false }
  }
  i: usize = 0
  for i < #len(source) {
    destination[i] = source[i]
    i += 1
  }
  destination[i] = 0
  return StringResult{ value: &destination[0], ok: true }
}
