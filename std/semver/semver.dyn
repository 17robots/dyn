use "std/fail"
use io "std/io"
// Semantic Versioning 2.0 values. Prerelease/build slices borrow input.

pub struct Version {
  major: u32,
  minor: u32,
  patch: u32,
  prerelease: []const u8,
  build: []const u8,
}


fn identifier_byte(byte: u8) bool {
  return (byte >= '0' && byte <= '9') || (byte >= 'a' && byte <= 'z') ||
    (byte >= 'A' && byte <= 'Z') || byte == '-'
}

fn parse_number(text: []const u8, offset: *usize, output: *u32, kind: *fail.Kind) bool {
  start := offset.*
  for offset.* < text.len && text[offset.*] >= '0' && text[offset.*] <= '9' {
    offset.* += 1
  }
  if offset.* == start { return false }
  if offset.* - start > 1 && text[start] == '0' {
    offset.* = start + 1
    return false
  }
  value: u64 = 0
  i := start
  for i < offset.* {
    value = value * 10 + (text[i] - '0')
    if value > 4294967295 {
      kind.* = fail.Kind.Overflow
      offset.* = i
      return false
    }
    i += 1
  }
  output.* = #cast(u32, value)
  return true
}

fn valid_identifiers(text: []const u8, prerelease: bool, failure: *usize) bool {
  failure.* = 0
  if text.len == 0 { return false }
  start: usize = 0
  i: usize = 0
  for i <= text.len {
    if i == text.len || text[i] == '.' {
      if i == start {
        failure.* = i
        return false
      }
      numeric := true
      for j in start..i {
        if !identifier_byte(text[j]) {
          failure.* = j
          return false
        }
        if text[j] < '0' || text[j] > '9' {
          numeric = false
        }
      }
      if prerelease && numeric && i - start > 1 && text[start] == '0' {
        failure.* = start + 1
        return false
      }
      start = i + 1
    }
    i += 1
  }
  return true
}

// A version such as "1.2.3-alpha.1+build". Malformed text fails with
// InvalidInput, a number past u32 with Overflow, at the offending byte.
pub fn parse(status: *fail.Status, text: []const u8) Version {
  if status == nil { return parse(&fail.Status{}, text) }
  if status.failed { return Version{} }
  at: usize = 0
  version: Version
  kind := fail.Kind.InvalidInput
  if !parse_number(text, &at, &version.major, &kind) { return failed(status, kind, at) }
  if at == text.len || text[at] != '.' { return failed(status, kind, at) }
  at += 1
  if !parse_number(text, &at, &version.minor, &kind) { return failed(status, kind, at) }
  if at == text.len || text[at] != '.' { return failed(status, kind, at) }
  at += 1
  if !parse_number(text, &at, &version.patch, &kind) { return failed(status, kind, at) }
  if at < text.len && text[at] == '-' {
    at += 1
    prerelease_start := at
    for at < text.len && text[at] != '+' {
      at += 1
    }
    version.prerelease = text[prerelease_start..at]
    failure: usize = 0
    if !valid_identifiers(version.prerelease, true, &failure) {
      return failed(status, fail.Kind.InvalidInput, prerelease_start + failure)
    }
  }
  if at < text.len && text[at] == '+' {
    at += 1
    build_start := at
    at = text.len
    version.build = text[build_start..at]
    failure: usize = 0
    if !valid_identifiers(version.build, false, &failure) {
      return failed(status, fail.Kind.InvalidInput, build_start + failure)
    }
  }
  if at != text.len { return failed(status, kind, at) }
  return version
}

fn bytes_compare(a: []const u8, b: []const u8) i32 {
  shared := a.len
  if b.len < shared {
    shared = b.len
  }
  for i in 0..shared {
    if a[i] < b[i] { return -1 }
    if a[i] > b[i] { return 1 }
  }
  if a.len < b.len { return -1 }
  if a.len > b.len { return 1 }
  return 0
}

fn numeric_identifier(value: []const u8) bool {
  for byte in value {
    if byte < '0' || byte > '9' { return false }
  }
  return true
}

fn next_identifier(text: []const u8, offset: *usize) []const u8 {
  start := offset.*
  for offset.* < text.len && text[offset.*] != '.' {
    offset.* += 1
  }
  result := text[start..offset.*]
  if offset.* < text.len {
    offset.* += 1
  }
  return result
}

fn compare_prerelease(a: []const u8, b: []const u8) i32 {
  if a.len == 0 && b.len == 0 { return 0 }
  if a.len == 0 { return 1 }
  if b.len == 0 { return -1 }
  a_at: usize = 0
  b_at: usize = 0
  for a_at < a.len && b_at < b.len {
    left := next_identifier(a, &a_at)
    right := next_identifier(b, &b_at)
    left_numeric := numeric_identifier(left)
    right_numeric := numeric_identifier(right)
    if left_numeric && !right_numeric { return -1 }
    if !left_numeric && right_numeric { return 1 }
    comparison: i32 = 0
    if left_numeric {
      if left.len < right.len {
        comparison = -1
      } else if left.len > right.len {
        comparison = 1
      } else {
        comparison = bytes_compare(left, right)
      }
    } else {
      comparison = bytes_compare(left, right)
    }
    if comparison != 0 { return comparison }
  }
  if a_at < a.len { return 1 }
  if b_at < b.len { return -1 }
  return 0
}

// Build metadata does not affect precedence.
fn failed(status: *fail.Status, kind: fail.Kind, offset: usize) Version {
  fail.at(status, kind, "parse version", "malformed version", offset)
  return Version{}
}

pub fn compare(a, b: Version) i32 {
  if a.major < b.major { return -1 }
  if a.major > b.major { return 1 }
  if a.minor < b.minor { return -1 }
  if a.minor > b.minor { return 1 }
  if a.patch < b.patch { return -1 }
  if a.patch > b.patch { return 1 }
  return compare_prerelease(a.prerelease, b.prerelease)
}

pub struct Range {
  minimum: Version,
  maximum: Version,
  has_minimum: bool,
  has_maximum: bool,
  include_minimum: bool,
  include_maximum: bool,
}

pub fn contains(range: *const Range, version: Version) bool {
  if range.has_minimum {
    lower := compare(version, range.minimum)
    if lower < 0 || (lower == 0 && !range.include_minimum) { return false }
  }
  if range.has_maximum {
    upper := compare(version, range.maximum)
    if upper > 0 || (upper == 0 && !range.include_maximum) { return false }
  }
  return true
}
