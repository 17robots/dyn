module heap

Page := use "heap/page_allocator"
Gpa := use "heap/gpa"
Arena := use "heap/arena"
FixedBuffer := use "heap/fixed_buffer"

pub alloc := (size: i32, align: i32) i32 => 0
pub free := (ptr: i32, size: i32, align: i32) i32 => 0
pub realloc := (ptr: i32, old_size: i32, old_align: i32, new_size: i32, new_align: i32) i32 => 0
pub default_allocator := () i32 => 1
