module heap

pub AllocError := enum {
    OutOfMemory,
}

pub Allocator := struct {
    ctx: usize,

    alloc_bytes := (self: Allocator, size: usize, align: usize) usize!AllocError => {
        ptr := $alloc_with(self.ctx, size, align)
        if ptr == 0 .OutOfMemory else ptr
    },

    realloc_bytes :=
        (
            self: Allocator,
            ptr: usize,
            old_size: usize,
            new_size: usize,
            align: usize,
        ) usize!AllocError => {
            next := $realloc_with(self.ctx, ptr, old_size, new_size, align)
            if next == 0 .OutOfMemory else next
        },

    free_bytes := (self: Allocator, ptr: usize, size: usize, align: usize) u32 =>
        $free_with(self.ctx, ptr, size, align),

    alloc := inline (self: Allocator, T: comp type, count: usize) usize!AllocError => {
        size := count * comp $sizeof(T)
        self.alloc_bytes(size, comp $alignof(T))
    },

    realloc := inline
        (
            self: Allocator,
            T: comp type,
            ptr: usize,
            old_count: usize,
            new_count: usize,
        ) usize!AllocError => {
            old_size := old_count * comp $sizeof(T)
            new_size := new_count * comp $sizeof(T)
            self.realloc_bytes(ptr, old_size, new_size, comp $alignof(T))
        },

    free := inline (self: Allocator, T: comp type, ptr: usize, count: usize) u32 => {
        size := count * comp $sizeof(T)
        self.free_bytes(ptr, size, comp $alignof(T))
    },

    alloc_one := inline (self: Allocator, T: comp type) usize!AllocError => self.alloc(T, 1),

    free_one := inline (self: Allocator, T: comp type, ptr: usize) u32 => self.free(T, ptr, 1),
}

pub CAllocator := () type => struct {
    handle: usize,

    new := () CAllocator => CAllocator{ handle: $c_allocator() },

    allocator := (self: CAllocator) Allocator => Allocator{ ctx: self.handle },
}

pub FailingAllocator := () type => struct {
    handle: usize,

    new := () FailingAllocator => FailingAllocator{ handle: $test_failing_allocator() },

    set_fail_after := (self: FailingAllocator, remaining_successes: usize) u32 => {
        $test_set_fail_after(remaining_successes)
    },

    allocator := (self: FailingAllocator) Allocator => Allocator{ ctx: self.handle },
}

pub ArenaAllocator := () type => struct {
    handle: usize,

    new := (backing: Allocator) ArenaAllocator =>
        ArenaAllocator{ handle: $arena_allocator(backing.ctx) },

    reset := (self: ArenaAllocator) u32 => $arena_reset(self.handle),

    deinit := (self: ArenaAllocator) u32 => $arena_deinit(self.handle),

    allocator := (self: ArenaAllocator) Allocator => Allocator{ ctx: self.handle },
}
