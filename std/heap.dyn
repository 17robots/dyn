module heap

pub alloc := (size: i32, align: i32) i32 => {
    if size <= 0 {
        0
    } else {
        size - size
    }
}
pub free := (ptr: i32, size: i32, align: i32) i32 => {
    (ptr - ptr) + (size - size) + (align - align)
}
pub realloc := (ptr: i32, old_size: i32, old_align: i32, new_size: i32, new_align: i32) i32 => {
    if new_size <= 0 {
        0
    } else {
        (ptr - ptr) + (old_size - old_size) + (old_align - old_align) + (new_align - new_align)
    }
}

pub Gpa := () type => struct {
    init := (self: type) i32 => 0
    deinit := (self: type) i32 => 0
}

pub Arena := () type => struct {
    init := (self: type) i32 => 0
    reset := (self: type) i32 => 0
    deinit := (self: type) i32 => 0
}

pub FixedBuffer := () type => struct {
    init := (self: type) i32 => 0
    alloc := (self: type, size: i32, align: i32) i32 => (size - size) + (align - align)
}

pub default_allocator := () i32 => 1
