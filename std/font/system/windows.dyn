#target(kernel: windows)

fn font_directories(arena: *mem.Arena, output: [][]const u8) usize {
  count: usize = 0
  windows := process.environment(arena, "WINDIR")
  if windows.ok && windows.found {
    parts: [2][]const u8 = [windows.value, "Fonts"]
    output[count] = strings.join(arena, parts[..], "\\")
  }
  else {
    output[count] = "C:\\Windows\\Fonts"
  }
  count += 1
  local := process.environment(arena, "LOCALAPPDATA")
  if local.ok && local.found {
    parts: [2][]const u8 = [local.value, "Microsoft\\Windows\\Fonts"]
    output[count] = strings.join(arena, parts[..], "\\")
    count += 1
  }
  return count
}
