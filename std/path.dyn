module path

os := use "std/os"

pub join := (lhs: []u8, rhs: []u8) []u8 => os.path_join(lhs, rhs)
pub normalize := (value: []u8) []u8 => os.path_normalize(value)
pub dirname := (value: []u8) []u8 => os.path_dirname(value)
pub basename := (value: []u8) []u8 => os.path_basename(value)
pub extension := (value: []u8) []u8 => os.path_extension(value)
pub is_abs := (value: []u8) u32 => os.path_is_abs(value)
