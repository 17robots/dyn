module fs

os := use "std/os"

pub FsError := enum {
    ReadFailed,
    WriteFailed,
    CreateDirFailed,
    ListFailed,
}

require_u32 := (value: u32, err: FsError) u32!FsError {
    if value == 0 return err
    return value
}

require_bytes := (value: []u8, err: FsError) []u8!FsError {
    if value == 0 return err
    return value
}

pub exists := (path: []u8) u32 => os.fs_exists(path)

pub is_dir := (path: []u8) u32 => os.fs_is_dir(path)

pub read_all := (path: []u8) []u8!FsError => require_bytes(os.fs_read_all(path), .ReadFailed)

pub write_all := (path: []u8, data: []u8) u32!FsError =>
    require_u32(os.fs_write_all(path, data), .WriteFailed)

pub mkdir_all := (path: []u8) u32!FsError =>
    require_u32(os.fs_mkdir_all(path), .CreateDirFailed)

pub list_dir := (path: []u8) []u8!FsError => require_bytes(os.fs_list_dir(path), .ListFailed)
