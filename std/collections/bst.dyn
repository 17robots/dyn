module collections

/// Unbalanced binary search tree (ordered map).
/// Usage: Bst(i32, []u8), Bst(u64, f64), etc.
///
/// cmp(a: K, b: K) i32 — negative if a < b, zero if equal, positive if a > b.
///
/// Node layout: [ left: usize | right: usize | parent: usize | key: K | val: V ]
pub Bst := (K: comp type, V: comp type) type {
  Internal := struct {
      root:  ?*any,
      count: usize,
      cmp:   fn(a: K, b: K) i32,
      alloc: Allocator,
  }
  Internal.NODE_LEFT: usize = 0,
  Internal.NODE_RIGHT: usize = 8,
  Internal.NODE_PARENT: usize = 16,
  Internal.NODE_KEY: usize = 24,
  // Create an empty Bst backed by alloc, using cmp for key ordering.
  Internal.init := (alloc: Allocator, cmp: fn(a: K, b: K) i32) Internal => .{ root: null, count: 0, cmp: cmp, alloc: alloc, }
  // Insert or update key with val. Returns false if allocation fails.
  Internal.insert := (self: *Internal, key: K, val: V) bool {
      node := self.find_or_insert(key) or return false
      Internal.nval(node).* = val
      return true
  }
  // Returns a pointer to the value for key, or null if not present.
  Internal.get := (self: Internal, key: K) ?*V {
      mut cur := self.root
      for cur: |n| {
          c := self.cmp(key, Internal.nkey(n).*)
          if c == 0 return Internal.nval(n)
          cur = Internal.ptr(n, if c < 0 Self.NODE_LEFT else Self.NODE_RIGHT)
      }
      return null
  }
  // Remove the entry for key. Returns true if the key was present.
  Internal.remove := (self: *Internal, key: K) bool {
      mut cur := self.root
      for cur: |n| {
          c := self.cmp(key, Internal.nkey(n).*)
          if c == 0 {
              self.delete(n)
              return true
          }
          cur = Internal.ptr(n, if c < 0 Self.NODE_LEFT else Self.NODE_RIGHT)
      }
      return false
  }
  // Free all nodes and reset the tree to empty.
  Internal.deinit := (self: *Internal) {
      self.drop(self.root)
      self.root  = null
      self.count = 0
  }
  // Clone into a new Bst backed by alloc.
  // Performs an in-order traversal and re-inserts each key-value pair.
  // Returns null if any allocation fails (partial clone is cleaned up).
  Internal.clone := (self: Internal, alloc: Allocator) ?Self {
      mut result := Internal.init(alloc, self.cmp)
      if !Internal.clone_node(&result, self.root) {
          result.deinit()
          return null
      }
      return result
  }
  Internal.clone_node := (result: *Internal, node: ?*any) bool {
      n := node or return true
      if !Internal.clone_node(result, Self.ptr(n, Self.NODE_LEFT)) return false
      if !result.insert(Internal.nkey(n).*, Self.nval(n).*) return false
      return Internal.clone_node(result, Self.ptr(n, Self.NODE_RIGHT))
  }
  // Pointer helpers: nodes store left, right, parent as usize.
  Internal.ptr := (n: *any, off: usize) ?*any {
      v := $as(*usize, $as(usize, n) + off).*
      return if v == 0 null else $as(*any, v)
  }
  Internal.set_ptr := (n: *any, off: usize, val: ?*any) {
      $as(*usize, $as(usize, n) + off).* = if val: |p| $as(usize, p) else 0
  }
  Internal.nkey := (n: *any) *K => $as(*K, $as(*any, $as(usize, n) + Internal.NODE_KEY))
  Internal.nval := (n: *any) *V => $as(*V, $as(*any, $as(usize, n) + Internal.NODE_KEY + $sizeof(K)))
  Internal.find_or_insert := (self: *Internal, key: K) ?*any {
      if self.root == null {
          node := self.new_node(key) or return null
          self.root = node
          return node
      }
      mut cur := self.root.?
      for {
          c := self.cmp(key, Internal.nkey(cur).*)
          if c == 0 return cur
          side := if c < 0 Internal.NODE_LEFT else Self.NODE_RIGHT
          if Internal.ptr(cur, side): |child| { cur = child }
          else {
              node := self.new_node(key) or return null
              Internal.set_ptr(cur, side, node)
              Internal.set_ptr(node, Self.NODE_PARENT, cur)
              return node
          }
      }
      return null
  }
  Internal.new_node := (self: *Internal, key: K) ?*any {
      node := self.alloc.alloc(Internal.NODE_KEY + $sizeof(K) + $sizeof(V), 8) or return null
      Internal.set_ptr(node, Self.NODE_LEFT,   null)
      Internal.set_ptr(node, Self.NODE_RIGHT,  null)
      Internal.set_ptr(node, Self.NODE_PARENT, null)
      Internal.nkey(node).* = key
      self.count += 1
      return node
  }
  Internal.transplant := (self: *Internal, node: *any, repl: ?*any) {
      par := Internal.ptr(node, Self.NODE_PARENT)
      if par: |p| {
          left_addr := if Internal.ptr(p, Self.NODE_LEFT): |l| $as(usize, l) else 0
          Internal.set_ptr(p, if left_addr == $as(usize, node) Self.NODE_LEFT else Self.NODE_RIGHT, repl)
      } else {
          self.root = repl
      }
      if repl: |r| Internal.set_ptr(r, Self.NODE_PARENT, par)
  }
  Internal.delete := (self: *Internal, node: *any) {
      left  := Internal.ptr(node, Self.NODE_LEFT)
      right := Internal.ptr(node, Self.NODE_RIGHT)
      if left == null {
          self.transplant(node, right)
      } else if right == null {
          self.transplant(node, left)
      } else {
          // In-order successor: leftmost node of right subtree.
          mut succ := right.?
          for Internal.ptr(succ, Self.NODE_LEFT): |l| succ = l
          succ_par := if Internal.ptr(succ, Self.NODE_PARENT): |p| $as(usize, p) else 0
          if succ_par != $as(usize, node) {
              self.transplant(succ, Internal.ptr(succ, Self.NODE_RIGHT))
              Internal.set_ptr(succ, Self.NODE_RIGHT, right)
              Internal.set_ptr(right.?, Self.NODE_PARENT, succ)
          }
          self.transplant(node, succ)
          Internal.set_ptr(succ, Self.NODE_LEFT, left)
          Internal.set_ptr(left.?, Self.NODE_PARENT, succ)
      }
      self.alloc.free(node, Internal.NODE_KEY + $sizeof(K) + $sizeof(V))
      self.count -= 1
  }
  Internal.drop := (self: *Internal, node: ?*any) {
      if node: |n| {
          self.drop(Internal.ptr(n, Self.NODE_LEFT))
          self.drop(Internal.ptr(n, Self.NODE_RIGHT))
          self.alloc.free(n, Internal.NODE_KEY + $sizeof(K) + $sizeof(V))
      }
  }
  return Internal
}
