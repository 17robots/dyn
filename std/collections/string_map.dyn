module collections

/// Open-addressing hash map with []u8 keys compared by content.
///
/// Unlike Map([]u8, V), which hashes the fat-pointer bytes, StringMap hashes
/// and compares the actual string bytes, so two slices with the same content
/// but different pointer addresses are treated as equal.
///
/// Bucket layout (same open-addressing / linear-probing / tombstone design
/// as Map): [ state: u8 | key: []u8 (16 bytes) | value: V ]
pub StringMap := (V: comp type) type {
  Internal := struct {
    buckets: ?*any,
    count:   usize,
    cap:     usize,
    alloc:   Allocator
  }
  Internal.init := (alloc: Allocator) Internal => .{ buckets: null, count: 0, cap: 0, alloc: alloc }
  Internal.insert := (self: *Internal, key: []u8, val: V) bool {
      if self.cap == 0 || self.count * 2 >= self.cap {
          if !Internal.grow(self) return false
      }
      bsz := 1 + 16 + $sizeof(V)    // sizeof([]u8) = 16 on x86_64
      h := Internal.hash_key(key)
      mut slot := h & (self.cap - 1)
      mut tombstone := self.cap
      for {
        b := $as(usize, self.buckets.?) + slot * bsz
        state := $as(*u8, b).*
        if state == 0 {
            target := if tombstone < self.cap tombstone else slot
            tb := $as(usize, self.buckets.?) + target * bsz
            $as(*u8, tb).* = 1
            $as(*[]u8, $as(*any, tb + 1)).* = key
            $as(*V, $as(*any, tb + 1 + 16)).* = val    // sizeof([]u8) = 16 on x86_64
            self.count += 1
            return true
        }
        if state == 2 && tombstone == self.cap tombstone = slot
        if state == 1 {
            stored := $as(*[]u8, $as(*any, b + 1)).*
            if Internal.keq(stored, key) {
                $as(*V, $as(*any, b + 1 + 16)).* = val    // sizeof([]u8) = 16 on x86_64
                return true
            }
        }
        slot = (slot + 1) & (self.cap - 1)
      }
      return false
  }
  Internal.get := (self: Internal, key: []u8) ?*V {
      if self.cap == 0 return null
      bsz := 1 + 16 + $sizeof(V)    // sizeof([]u8) = 16 on x86_64
      h   := Internal.hash_key(key)
      mut slot := h & (self.cap - 1)
      for {
          b     := $as(usize, self.buckets.?) + slot * bsz
          state := $as(*u8, b).*
          if state == 0 return null
          if state == 1 {
              stored := $as(*[]u8, $as(*any, b + 1)).*
              if Internal.keq(stored, key)
                  return $as(*V, $as(*any, b + 1 + 16))    // sizeof([]u8) = 16 on x86_64
          }
          slot = (slot + 1) & (self.cap - 1)
      }
      return null
  }
  Internal.remove := (self: *Internal, key: []u8) bool {
      if self.cap == 0 return false
      bsz := 1 + 16 + $sizeof(V)    // sizeof([]u8) = 16 on x86_64
      h   := Internal.hash_key(key)
      mut slot := h & (self.cap - 1)
      for {
          b     := $as(usize, self.buckets.?) + slot * bsz
          state := $as(*u8, b).*
          if state == 0 return false
          if state == 1 {
              stored := $as(*[]u8, $as(*any, b + 1)).*
              if Internal.keq(stored, key) {
                  $as(*u8, b).* = 2
                  self.count -= 1
                  return true
              }
          }
          slot = (slot + 1) & (self.cap - 1)
      }
      return false
  }
  Internal.deinit := (self: *Internal) {
      if self.buckets: |b| {
          bsz := self.cap * (1 + 16 + $sizeof(V))    // sizeof([]u8) = 16 on x86_64
          self.alloc.free(b, bsz)
      }
      self.buckets = null
      self.count   = 0
      self.cap     = 0
  }
  Internal.clone := (self: Internal, alloc: Allocator) ?Internal {
      if self.cap == 0 return Internal.init(alloc)
      bsz         := 1 + 16 + $sizeof(V)    // sizeof([]u8) = 16 on x86_64
      new_buckets := alloc.alloc(self.cap * bsz, 8) or return null
      mut i := 0
      for i < self.cap: {
          src := $as(usize, self.buckets.?) + i * bsz
          if $as(*u8, src).* == 1 {
              stored := $as(*[]u8, $as(*any, src + 1)).*
              h      := Internal.hash_key(stored)
              mut slot := h & (self.cap - 1)
              for $as(*u8, $as(usize, new_buckets) + slot * bsz).* != 0:
                  slot = (slot + 1) & (self.cap - 1)
              dst := $as(usize, new_buckets) + slot * bsz
              $as(*u8, dst).* = 1
              $memcpy($as(*any, dst + 1), $as(*any, src + 1), 16 + $sizeof(V))    // sizeof([]u8) = 16 on x86_64
          }
          i += 1
      }
      return .{ buckets: new_buckets, count: self.count, cap: self.cap, alloc: alloc }
  }
  Internal.for_each := (self: Internal, f: fn(key: []u8, val: *V) void) {
      if self.cap == 0 return
      bsz := 1 + 16 + $sizeof(V)    // sizeof([]u8) = 16 on x86_64
      mut i := 0
      for i < self.cap: {
          b     := $as(usize, self.buckets.?) + i * bsz
          state := $as(*u8, b).*
          if state == 1 {
              key := $as(*[]u8, $as(*any, b + 1)).*
              val := $as(*V, $as(*any, b + 1 + 16))    // sizeof([]u8) = 16 on x86_64
              f(key, val)
          }
          i += 1
      }
  }
  Internal.hash_key := (key: []u8) usize => hash.hash_bytes($as(*any, key.ptr), key.len)
  Internal.keq := (a: []u8, b: []u8) bool {
      if a.len != b.len return false
      mut i := 0
      for i < a.len: {
          if a[i] != b[i] return false
          i += 1
      }
      return true
  }
  Internal.grow := (self: *Internal) bool {
      new_cap     := if self.cap == 0 8 else self.cap * 2
      bsz         := 1 + 16 + $sizeof(V)    // sizeof([]u8) = 16 on x86_64
      new_buckets := self.alloc.alloc(new_cap * bsz, 8) or return false
      if self.buckets: |old| {
          mut i := 0
          for i < self.cap: {
              src := $as(usize, old) + i * bsz
              if $as(*u8, src).* == 1 {
                  stored := $as(*[]u8, $as(*any, src + 1)).*
                  h := Internal.hash_key(stored)
                  mut slot := h & (new_cap - 1)
                  for $as(*u8, $as(usize, new_buckets) + slot * bsz).* != 0:
                      slot = (slot + 1) & (new_cap - 1)
                  dst := $as(usize, new_buckets) + slot * bsz
                  $as(*u8, dst).* = 1
                  $memcpy($as(*any, dst + 1), $as(*any, src + 1), 16 + $sizeof(V))    // sizeof([]u8) = 16 on x86_64
              }
              i += 1
          }
          self.alloc.free(old, self.cap * bsz)
      }
      self.buckets = new_buckets
      self.cap     = new_cap
      return true
  }
  return Internal
}
