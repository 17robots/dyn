module collections

/// Binary min-heap (priority queue). Usage: Heap(i32), Heap(f64), etc.
///
/// cmp(a: T, b: T) bool — return true if a has higher priority than b.
/// For a min-heap of integers, pass a comparator that returns a < b.
pub Heap := (T: comp type) type {
  Internal := struct {
    items: []T,
    cap:   usize,
    cmp:   fn(a: T, b: T) bool,
    alloc: Allocator,
  }
  Internal.init := (alloc: Allocator, cmp: fn(a: T, b: T) bool) Internal => .{
      items: .{ ptr: $as(*T, 0), len: 0 },
      cap:   0,
      cmp:   cmp,
      alloc: alloc,
  }
  Internal.push := (self: *Internal, item: T) bool {
      if self.items.len >= self.cap {
          new_cap := if self.cap == 0 8 else self.cap * 2
          new_ptr := if self.cap > 0 {
              p := self.alloc.realloc(
                  $as(*any, self.items.ptr),
                  self.cap * $sizeof(T),
                  new_cap * $sizeof(T),
                  $alignof(T),
              ) or return false
              $as(*T, p)
          } else {
              p := self.alloc.alloc(new_cap * $sizeof(T), $alignof(T)) or return false
              $as(*T, p)
          }
          self.items.ptr = new_ptr
          self.cap       = new_cap
      }
      self.at(self.items.len).* = item
      self.items.len += 1
      self.sift_up(self.items.len - 1)
      return true
  }
  Internal.pop := (self: *Internal) ?T {
      if self.items.len == 0 return null
      val := self.at(0).*
      self.items.len -= 1
      if self.items.len > 0 {
          self.at(0).* = self.at(self.items.len).*
          self.sift_down(0)
      }
      return val
  }
  Internal.peek := (self: Internal) ?*T {
      if self.items.len == 0 return null
      return self.at(0)
  }
  // Clone into a new Heap backed by alloc. Returns null if allocation fails.
  Internal.clone := (self: Internal, alloc: Allocator) ?Self {
      if self.items.len == 0 return Internal.init(alloc, self.cmp)
      p := alloc.alloc(self.items.len * $sizeof(T), $alignof(T)) or return null
      $memcpy(p, $as(*any, self.items.ptr), self.items.len * $sizeof(T))
      return .{
          items: .{ ptr: $as(*T, p), len: self.items.len },
          cap:   self.items.len,
          cmp:   self.cmp,
          alloc: alloc,
      }
  }
  Internal.deinit := (self: *Internal) {
      if self.cap > 0
          self.alloc.free($as(*any, self.items.ptr), self.cap * $sizeof(T))
      self.items.ptr = $as(*T, 0)
      self.items.len = 0
      self.cap       = 0
  }
  Internal.at := (self: Internal, i: usize) *T => $as(*T, $as(*any, $as(usize, self.items.ptr) + i * $sizeof(T)))
  Internal.sift_up := (self: *Internal, i: usize) {
      mut idx := i
      for idx > 0: {
          parent := (idx - 1) / 2
          if self.cmp(self.at(idx).*, self.at(parent).*) {
              tmp               := self.at(idx).*
              self.at(idx).*    = self.at(parent).*
              self.at(parent).* = tmp
              idx = parent
          } else {
              break
          }
      }
  }
  Internal.sift_down := (self: *Internal, i: usize) {
      mut idx := i
      for {
          left  := idx * 2 + 1
          right := idx * 2 + 2
          mut best := idx
          if left  < self.items.len and self.cmp(self.at(left).*,  self.at(best).*) best = left
          if right < self.items.len and self.cmp(self.at(right).*, self.at(best).*) best = right
          if best == idx break
          tmp             := self.at(idx).*
          self.at(idx).*  = self.at(best).*
          self.at(best).* = tmp
          idx = best
      }
  }
  return Internal
}
