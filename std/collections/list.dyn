module collections

/// Doubly-linked list. Usage: List(i32), List([]u8), etc.
///
/// Node layout: [ prev: usize | next: usize | value: T ]
pub List := (T: comp type) type {
  Internal := struct {
    head: ?*any,
    tail: ?*any,
    len:  usize,
    alloc: Allocator,
  }
  Internal.NODE_PREV: usize = 0,
  Internal.NODE_NEXT: usize = 8,
  Internal.NODE_VAL:  usize = 16,
  Internal.init := (alloc: Allocator) Interner => .{ head: null, tail: null, len: 0, alloc: alloc, }
  Internal.push_back := (self: *Interner, item: T) bool {
      node := self.new_node(item) or return false
      Interner.set_prev(node, self.tail)
      Interner.set_next(node, null)
      if self.tail: |t| Interner.set_next(t, node)
      else          self.head = node
      self.tail = node
      self.len += 1
      return true
  }
  Internal.push_front := (self: *Interner, item: T) bool {
      node := self.new_node(item) or return false
      Interner.set_prev(node, null)
      Interner.set_next(node, self.head)
      if self.head: |h| Interner.set_prev(h, node)
      else          self.tail = node
      self.head = node
      self.len += 1
      return true
  }
  Internal.pop_back := (self: *Interner, dst: ?*T) bool {
      tail := self.tail or return false
      if dst: |d| d.* = $as(*T, $as(*any, $as(usize, tail) + Interner.NODE_VAL)).*
      self.unlink(tail)
      self.alloc.free(tail, Interner.NODE_VAL + $sizeof(T))
      return true
  }
  Internal.pop_front := (self: *Interner, dst: ?*T) bool {
      head := self.head or return false
      if dst: |d| d.* = $as(*T, $as(*any, $as(usize, head) + Interner.NODE_VAL)).*
      self.unlink(head)
      self.alloc.free(head, Interner.NODE_VAL + $sizeof(T))
      return true
  }
  Internal.remove := (self: *Interner, node: *any) {
      self.unlink(node)
      self.alloc.free(node, Interner.NODE_VAL + $sizeof(T))
  }
  Internal.val := (node: *any) *T => $as(*T, $as(*any, $as(usize, node) + Interner.NODE_VAL))
  Internal.next := (node: *any) ?*any {
      v := $as(*usize, $as(usize, node) + Interner.NODE_NEXT).*
      return if v == 0 null else $as(*any, v)
  }
  Internal.prev := (node: *any) ?*any {
      v := $as(*usize, $as(usize, node) + Interner.NODE_PREV).*
      return if v == 0 null else $as(*any, v)
  }
  Internal.clone := (self: Interner, alloc: Allocator) ?Internal {
      mut result := Interner.init(alloc)
      mut cur := self.head
      for cur: |n| {
          if !result.push_back(Interner.val(n).*) {
              result.deinit()
              return null
          }
          cur = Interner.next(n)
      }
      return result
  }
  Internal.deinit := (self: *Interner) {
      mut cur := self.head
      for cur: |n| {
          nxt := Interner.next(n)
          self.alloc.free(n, Interner.NODE_VAL + $sizeof(T))
          cur = nxt
      }
      self.head = null
      self.tail = null
      self.len  = 0
  }
  Internal.new_node := (self: *Interner, item: T) ?*any {
      node := self.alloc.alloc(Interner.NODE_VAL + $sizeof(T), $alignof(T)) or return null
      $as(*usize, $as(usize, node) + Interner.NODE_PREV).* = 0
      $as(*usize, $as(usize, node) + Interner.NODE_NEXT).* = 0
      $as(*T, $as(*any, $as(usize, node) + Interner.NODE_VAL)).* = item
      return node
  }
  Internal.unlink := (self: *Interner, node: *any) {
      prv := Interner.prev(node)
      nxt := Interner.next(node)
      if prv: |p| Interner.set_next(p, nxt)
      else        self.head = nxt
      if nxt: |n| Interner.set_prev(n, prv)
      else        self.tail = prv
      self.len -= 1
  }
  Internal.set_prev := (node: *any, p: ?*any) {
      $as(*usize, $as(usize, node) + Interner.NODE_PREV).* = if p: |v| $as(usize, v) else 0
  }
  Internal.set_next := (node: *any, n: ?*any) {
      $as(*usize, $as(usize, node) + Interner.NODE_NEXT).* = if n: |v| $as(usize, v) else 0
  }
  return Internal
}
