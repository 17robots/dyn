module collections

/// String interner: maps []u8 content to a stable u32 ID.
/// Two slices with the same bytes always return the same ID.
/// Strings are stored in an internal buffer; returned IDs are valid
/// until deinit() is called.
pub Interner := struct {
    // Map from interned string slice to its ID.
    // The key slices point into buf.
    map:   StringMap(u32),
    // Backing store for all interned string bytes.
    buf:   []u8,
    blen:  usize,
    bcap:  usize,
    alloc: Allocator
}
pub Interner.init := (alloc: Allocator) Interner => .{
    map:   StringMap(u32).init(alloc),
    buf:   .{ ptr: $as(*u8, 0), len: 0 },
    blen:  0,
    bcap:  0,
    alloc: alloc,
}

// Intern a string and return its ID.
// If the string was seen before, return the existing ID.
// Returns null on allocation failure.
pub Interner.intern := (self: *Interner, s: []u8) ?u32 {
    // Fast path: already interned.
    if self.map.get(s): |id| return id.*

    // Slow path: copy bytes into buf, register in map.
    new_id := $as(u32, self.map.count)

    // Grow buf if needed.
    if self.blen + s.len > self.bcap {
        new_cap := if self.bcap == 0 4096 else self.bcap * 2
        if new_cap < self.blen + s.len new_cap = self.blen + s.len
        new_buf := if self.bcap > 0 {
            p := self.alloc.realloc(
                $as(*any, self.buf.ptr), self.bcap, new_cap, 1,
            ) or return null
            $as(*u8, p)
        } else {
            p := self.alloc.alloc(new_cap, 1) or return null
            $as(*u8, p)
        }
        self.buf.ptr = new_buf
        self.bcap    = new_cap
    }

    // Copy string bytes into buf.
    $memcpy(
        $as(*any, $as(usize, self.buf.ptr) + self.blen),
        $as(*any, s.ptr),
        s.len,
    )
    // The interned slice points into our buf — stable until deinit.
    interned: []u8 = .{
        ptr: $as(*u8, $as(usize, self.buf.ptr) + self.blen),
        len: s.len,
    }
    self.blen += s.len

    self.map.insert(interned, new_id) or return null
    return new_id
}
// Return the string for a given ID, or an empty slice if ID is unknown.
// Note: this is O(n) in the number of interned strings — use sparingly.
// For the compiler, intern at lex time and compare by ID thereafter.
pub Intern.get := (self: Interner, id: u32) []u8 {
    // Walk the map to find the entry with this value.
    // StringMap doesn't support reverse lookup directly, so this is a scan.
    mut result: []u8 = .{ ptr: $as(*u8, 0), len: 0 }
    self.map.for_each((key: []u8, val: *u32) {
        if val.* == id result = key
    })
    return result
}
pub Interner.deinit := (self: *Interner) {
    self.map.deinit()
    if self.bcap > 0
        self.alloc.free($as(*any, self.buf.ptr), self.bcap)
    self.buf.ptr = $as(*u8, 0)
    self.blen    = 0
    self.bcap    = 0
}

