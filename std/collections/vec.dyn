module collections

/// Growable typed array. Usage: Vec(i32), Vec([]u8), etc.
pub Vec := (T: comp type) type {
  Internal := struct {
    items: []T,
    cap:   usize,
    alloc: Allocator
  }
  Internal.init := (alloc: Allocator) Internal => .{
      items: .{ ptr: $as(*T, 0), len: 0 },
      cap:   0,
      alloc: alloc,
  }
  Internal.push := (self: *Internal, item: T) bool {
      if self.items.len >= self.cap {
          new_cap := if self.cap == 0 4 else self.cap * 2
          new_ptr := if self.cap > 0 {
              p := self.alloc.realloc(
                  $as(*any, self.items.ptr),
                  self.cap   * $sizeof(T),
                  new_cap * $sizeof(T),
                  $alignof(T),
              ) or return false
              break $as(*T, p)
          } else {
              p := self.alloc.alloc(new_cap * $sizeof(T), $alignof(T)) or return false
              break $as(*T, p)
          }
          self.items.ptr = new_ptr
          self.cap       = new_cap
      }
      $as(*T, $as(*any, $as(usize, self.items.ptr) + self.items.len * $sizeof(T))).* = item
      self.items.len += 1
      return true
  }
  Internal.pop := (self: *Internal) ?T {
      if self.items.len == 0 return null
      self.items.len -= 1
      return $as(*T, $as(*any, $as(usize, self.items.ptr) + self.items.len * $sizeof(T))).*
  }
  // Returns a pointer to the element at i, or null if out of bounds.
  Internal.get := (self: Internal, i: usize) ?*T {
      if i >= self.items.len return null
      return $as(*T, $as(*any, $as(usize, self.items.ptr) + i * $sizeof(T)))
  }
  Internal.clear := (self: *Internal) { self.items.len = 0 }
  // Clone into a new Vec backed by alloc. Returns null if allocation fails.
  Internal.clone := (self: Internal, alloc: Allocator) ?Self {
      if self.items.len == 0 return Internal.init(alloc)
      p := alloc.alloc(self.items.len * $sizeof(T), $alignof(T)) or return null
      $memcpy(p, $as(*any, self.items.ptr), self.items.len * $sizeof(T))
      return .{
          items: .{ ptr: $as(*T, p), len: self.items.len },
          cap:   self.items.len,
          alloc: alloc,
      }
  }
  Internal.deinit := (self: *Internal) {
      if self.cap > 0 self.alloc.free($as(*any, self.items.ptr), self.cap * $sizeof(T))
      self.items.ptr = $as(*T, 0)
      self.items.len = 0
      self.cap = 0
  }
  return Internal
}
