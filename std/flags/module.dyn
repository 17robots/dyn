// Allocation-free command-line parser. Definitions and returned strings are borrowed.
pub enum Kind { Bool, String }
pub enum ErrorKind { None, Unknown, MissingValue, UnexpectedValue, Capacity }
pub struct Option { name: []const u8, short: u8, kind: Kind }
pub struct Value { text: []const u8, present: bool, occurrences: usize }
pub struct Error { kind: ErrorKind, argument: usize, option: []const u8 }
pub struct Result { values: []Value, positionals: [][]const u8, error: Error, ok: bool }

pub fn bool_option(name: []const u8, short: u8) Option {
  return Option{ name: name, short: short, kind: Kind.Bool }
}
pub fn string_option(name: []const u8, short: u8) Option {
  return Option{ name: name, short: short, kind: Kind.String }
}
fn equal(a: []const u8, b: []const u8) bool {
  if #len(a) != #len(b) { return false }
  i: usize = 0 for i < #len(a) { if a[i] != b[i] { return false } i += 1 }
  return true
}
fn long_index(options: []const Option, name: []const u8) usize {
  i: usize = 0 for i < #len(options) { if equal(options[i].name, name) { return i } i += 1 }
  return #len(options)
}
fn short_index(options: []const Option, name: u8) usize {
  i: usize = 0
  for i < #len(options) { if options[i].short != 0 && options[i].short == name { return i } i += 1 }
  return #len(options)
}
fn failure(values: []Value, positionals: [][]const u8, kind: ErrorKind, at: usize, option: []const u8) Result {
  return Result{ values: values, positionals: positionals, error: Error{ kind: kind, argument: at, option: option }, ok: false }
}

pub fn parse(
  options: []const Option,
  arguments: [][]const u8,
  value_storage: []Value,
  positional_storage: [][]const u8,
) Result {
  if #len(value_storage) < #len(options) { return failure(value_storage[..0], positional_storage[..0], ErrorKind.Capacity, 0, "") }
  values := value_storage[..#len(options)]
  i: usize = 0
  for i < #len(values) { values[i] = Value{} i += 1 }
  positional_length: usize = 0
  options_done := false
  argument: usize = 0
  for argument < #len(arguments) {
    text := arguments[argument]
    if !options_done && equal(text, "--") { options_done = true }
    else if !options_done && #len(text) > 2 && text[0] == '-' && text[1] == '-' {
      name_end := #len(text) scan: usize = 2
      for scan < #len(text) { if text[scan] == '=' { name_end = scan scan = #len(text) } else { scan += 1 } }
      long_option := long_index(options, text[2..name_end])
      if long_option == #len(options) { return failure(values, positional_storage[..positional_length], ErrorKind.Unknown, argument, text) }
      inline := name_end < #len(text)
      if options[long_option].kind == Kind.Bool {
        if inline { return failure(values, positional_storage[..positional_length], ErrorKind.UnexpectedValue, argument, text) }
      } else if inline { values[long_option].text = text[name_end + 1..] }
      else {
        if argument + 1 == #len(arguments) { return failure(values, positional_storage[..positional_length], ErrorKind.MissingValue, argument, text) }
        argument += 1 values[long_option].text = arguments[argument]
      }
      values[long_option].present = true values[long_option].occurrences += 1
    } else if !options_done && #len(text) >= 2 && text[0] == '-' {
      short_at: usize = 1
      for short_at < #len(text) {
        short_option := short_index(options, text[short_at])
        if short_option == #len(options) { return failure(values, positional_storage[..positional_length], ErrorKind.Unknown, argument, text) }
        values[short_option].present = true values[short_option].occurrences += 1
        if options[short_option].kind == Kind.String {
          if short_at + 1 < #len(text) { values[short_option].text = text[short_at + 1..] }
          else {
            if argument + 1 == #len(arguments) { return failure(values, positional_storage[..positional_length], ErrorKind.MissingValue, argument, text) }
            argument += 1 values[short_option].text = arguments[argument]
          }
          short_at = #len(text)
        } else { short_at += 1 }
      }
    } else {
      if positional_length == #len(positional_storage) { return failure(values, positional_storage, ErrorKind.Capacity, argument, text) }
      positional_storage[positional_length] = text positional_length += 1
    }
    argument += 1
  }
  return Result{ values: values, positionals: positional_storage[..positional_length], error: Error{}, ok: true }
}

pub fn usage(destination: []u8, program: []const u8, options: []const Option) []u8 {
  at: usize = 0
  pieces: [3][]const u8 = ["usage: ", program, " [options]\n"]
  for piece in pieces { for piece_byte in piece { if at == #len(destination) { return destination[..0] } destination[at] = piece_byte at += 1 } }
  for option in options {
    prefix: []const u8 = "  --"
    for prefix_byte in prefix { if at == #len(destination) { return destination[..0] } destination[at] = prefix_byte at += 1 }
    for name_byte in option.name { if at == #len(destination) { return destination[..0] } destination[at] = name_byte at += 1 }
    if option.kind == Kind.String {
      suffix: []const u8 = " VALUE"
      for suffix_byte in suffix { if at == #len(destination) { return destination[..0] } destination[at] = suffix_byte at += 1 }
    }
    if at == #len(destination) { return destination[..0] } destination[at] = 10 at += 1
  }
  return destination[..at]
}
