use "std/strings"
use memory "std/mem"
use bytes "std/bytes"
// Command-line parser. Option definitions and returned strings are borrowed.
pub enum Kind { Bool, String, Integer, Float, Choice }
pub struct Option { name: []const u8, short: u8, kind: Kind, required: bool, default_value: []const u8, choices: [][]const u8 }
// occurrences counts the times the option was given; zero means text is its
// default.
pub struct Value { text: []const u8, occurrences: usize }
pub struct Parsed { values: []Value, positionals: [][]const u8 }
// Why arguments did not parse. The payload of the first four is the index of
// the offending argument; of MissingRequired and InvalidValue, the index of
// the option.
pub enum ArgsErr {
  UnknownOption(usize),
  UnexpectedValue(usize),
  MissingValue(usize),
  TooManyValues(usize),
  MissingRequired(usize),
  InvalidValue(usize),
}

// What went wrong, such as "unknown option", for a message that names the
// argument or option too.
pub fn message(err: ArgsErr) []const u8 {
  case err {
    .UnknownOption(_) => { return "unknown option" }
    .UnexpectedValue(_) => { return "unexpected value" }
    .MissingValue(_) => { return "missing value" }
    .TooManyValues(_) => { return "too many values" }
    .MissingRequired(_) => { return "missing required option" }
    .InvalidValue(_) => { return "invalid value" }
  }
}

pub fn bool_option(name: []const u8, short: u8) Option {
  return Option{ name: name, short: short, kind: Kind.Bool }
}
pub fn string_option(name: []const u8, short: u8) Option {
  return Option{ name: name, short: short, kind: Kind.String }
}

fn long_index(options: []const Option, name: []const u8) usize {
  for i in 0..options.len {
    if bytes.equal(options[i].name, name) { return i }
  }
  return options.len
}
fn short_index(options: []const Option, name: u8) usize {
  for i in 0..options.len {
    if options[i].short != 0 && options[i].short == name { return i }
  }
  return options.len
}
fn parse_buffers(
  options: []const Option,
  arguments: [][]const u8,
  value_storage: []Value,
  positional_storage: [][]const u8,
) Parsed!ArgsErr {
  if value_storage.len < options.len { #panic("flags: no room for the option values") }
  values := value_storage[..options.len]
  for i in 0..values.len {
    values[i] = Value{}
  }
  positional_length: usize = 0
  options_done := false
  argument: usize = 0
  for argument < arguments.len {
    text := arguments[argument]
    if !options_done && bytes.equal(text, "--") {
      options_done = true
    } else if !options_done && text.len > 2 && text[0] == '-' && text[1] == '-' {
      name_end := text.len
      scan: usize = 2
      for scan < text.len {
        if text[scan] == '=' {
          name_end = scan
          scan = text.len
        } else {
          scan += 1
        }
      }
      long_option := long_index(options, text[2..name_end])
      if long_option == options.len { fail ArgsErr.UnknownOption(argument) }
      inline := name_end < text.len
      if options[long_option].kind == Kind.Bool {
        if inline { fail ArgsErr.UnexpectedValue(argument) }
      } else if inline {
        values[long_option].text = text[name_end + 1..]
      } else {
        if argument + 1 == arguments.len { fail ArgsErr.MissingValue(argument) }
        argument += 1
        values[long_option].text = arguments[argument]
      }
      values[long_option].occurrences += 1
    } else if !options_done && text.len >= 2 && text[0] == '-' {
      short_at: usize = 1
      for short_at < text.len {
        short_option := short_index(options, text[short_at])
        if short_option == options.len { fail ArgsErr.UnknownOption(argument) }
        values[short_option].occurrences += 1
        if options[short_option].kind != Kind.Bool {
          if short_at + 1 < text.len {
            values[short_option].text = text[short_at + 1..]
          } else {
            if argument + 1 == arguments.len { fail ArgsErr.MissingValue(argument) }
            argument += 1
            values[short_option].text = arguments[argument]
          }
          short_at = text.len
        } else {
          short_at += 1
        }
      }
    } else {
      if positional_length == positional_storage.len { fail ArgsErr.TooManyValues(argument) }
      positional_storage[positional_length] = text
      positional_length += 1
    }
    argument += 1
  }
  option_index: usize = 0
  for option_index < options.len {
    definition := options[option_index]
    if values[option_index].occurrences == 0 {
      if definition.required { fail ArgsErr.MissingRequired(option_index) }
      values[option_index].text = definition.default_value
    }
    if values[option_index].occurrences > 0 || definition.default_value.len > 0 {
      text_value := values[option_index].text
      valid := true
      if definition.kind == Kind.Integer {
        valid = strings.valid<i64>(text_value)
      } else if definition.kind == Kind.Float {
        valid = strings.valid<f64>(text_value)
      } else if definition.kind == Kind.Choice {
        valid = false
        for choice_value in definition.choices {
          if bytes.equal(text_value, choice_value) {
            valid = true
          }
        }
      }
      if !valid { fail ArgsErr.InvalidValue(option_index) }
    }
    option_index += 1
  }
  return Parsed{ values: values, positionals: positional_storage[..positional_length] }
}

// Output arrays belong to arena and live until rewind/reset/release. Text slices
// borrow arguments or option defaults; those bytes must outlive the result.
// Allocates checked, aligned arrays for len(options) values and at most
// len(arguments) positional views, exclusively in arena. Exhaustion/overflow
// panic under the ordinary mem push policy. Invalid arguments fail with
// ArgsErr; all pushes are rewound.
pub fn parse(arena: *memory.Arena, options: []const Option, arguments: [][]const u8) Parsed!ArgsErr {
  mark := memory.arena_mark(arena)
  values := memory.push_array<Value>(arena, options.len)
  positionals := memory.push_array<[]const u8>(arena, arguments.len)
  result := parse_buffers(options, arguments, values, positionals) catch err {
    memory.arena_rewind(arena, mark)
    fail err
  }
  return result
}

struct TextResult { value: []u8, required: usize, failed: bool }

fn render_piece(destination: []u8, offset: *usize, piece: []const u8, write: bool) bool {
  if piece.len > #cast(usize, -1) - offset.* { return false }
  if write {
    _ = memory.copy(destination[offset.*..], piece)
  }
  offset.* += piece.len
  return true
}
fn render(destination: []u8, program: []const u8, options: []const Option, is_usage: bool, write: bool) TextResult {
  at: usize = 0
  if is_usage {
    if !render_piece(destination, &at, "usage: ", write) || !render_piece(destination, &at, program, write) || !render_piece(destination, &at, " [options]\n", write) {
      return TextResult{ failed: true }
    }
  }
  for option in options {
    prefix: []const u8 = "--"
    if is_usage {
      prefix = "  --"
    }
    if !render_piece(destination, &at, prefix, write) || !render_piece(destination, &at, option.name, write) {
      return TextResult{ failed: true }
    }
    if is_usage && option.kind != Kind.Bool {
      if !render_piece(destination, &at, " VALUE", write) { return TextResult{ failed: true } }
    }
    if !render_piece(destination, &at, "\n", write) { return TextResult{ failed: true } }
  }
  return TextResult{ required: at }
}
fn render_checked(destination: []u8, program: []const u8, options: []const Option, is_usage: bool) TextResult {
  measured := render(destination[..0], program, options, is_usage, false)
  if measured.failed { return measured }
  if measured.required > destination.len {
    return TextResult{ required: measured.required, failed: true }
  }
  output := destination[..measured.required]
  if bytes.overlaps(output, program) {
    return TextResult{ required: measured.required, failed: true }
  }
  for option in options {
    if bytes.overlaps(output, option.name) {
      return TextResult{ required: measured.required, failed: true }
    }
  }
  _ = render(output, program, options, is_usage, true)
  return TextResult{ value: output, required: measured.required }
}
// Failure writes nothing. Returned text borrows destination and excludes NUL.
// Usage text for options, in arena.
pub fn usage(arena: *memory.Arena, program: []const u8, options: []const Option) []u8 {
  return render_arena(arena, program, options, true)
}

pub fn required_string_option(name: []const u8, short: u8) Option {
  return Option{ name: name, short: short, kind: Kind.String, required: true }
}
pub fn integer_option(name: []const u8, short: u8) Option {
  return Option{ name: name, short: short, kind: Kind.Integer }
}
pub fn float_option(name: []const u8, short: u8) Option {
  return Option{ name: name, short: short, kind: Kind.Float }
}
pub fn choice_option(name: []const u8, short: u8, choices: [][]const u8) Option {
  return Option{ name: name, short: short, kind: Kind.Choice, choices: choices }
}
// One long-option candidate per line. Empty option lists succeed with empty text.
// Shell completion words for options, in arena.
pub fn completion(arena: *memory.Arena, options: []const Option) []u8 {
  return render_arena(arena, "", options, false)
}

fn render_arena(arena: *memory.Arena, program: []const u8, options: []const Option, is_usage: bool) []u8 {
  empty: [0]u8
  measured := render(empty[..], program, options, is_usage, false)
  if measured.failed {
    #panic("flags: usage text size overflows")
  }
  output := memory.push_bytes(arena, measured.required)
  _ = render_checked(output, program, options, is_usage)
  return output
}
