pub struct PropertyOptions { seed: u64, cases: usize, shrink_checks: usize }
pub struct PropertyResult {
  passed: bool, seed: u64, iteration: usize, example: []const u8,
  checks: usize, shrink_exhausted: bool,
}
// Property must be deterministic and must not retain its input. Work is split
// into sample/trial halves; its half-length is the maximum generated input size.
// A failure's minimized example borrows work. Reproduction requires the same
// seed, iteration, work capacity, and deterministic predicate.
pub fn check_property(options: PropertyOptions, work: []u8,
  predicate: fn(rawptr, []const u8) bool, context: rawptr) PropertyResult {
  capacity := #len(work) / 2
  sample := work[..capacity]
  trial := work[capacity..]
  generator := random(options.seed)
  iteration: usize = 0
  for iteration < options.cases {
    length := random_below(&generator, capacity + 1)
    for i in 0..length {
      sample[i] = #cast(u8, (random_next(&generator) & 255))
    }
    if !predicate(context, sample[..length]) {
      shrunk := shrink(sample, trial, length, options.shrink_checks, predicate, context)
      length = shrunk.length
      checks := shrunk.checks
      return PropertyResult{ seed: options.seed, iteration: iteration, example: sample[..length],
        checks: checks, shrink_exhausted: checks == options.shrink_checks }
    }
    iteration += 1
  }
  return PropertyResult{ passed: true, seed: options.seed, iteration: iteration }
}

struct Shrunk { length: usize, checks: usize }

// Minimizes a failing sample[..length] in place: removes contiguous chunks,
// then lowers byte values, while predicate keeps failing. trial is scratch of
// the same capacity.
fn shrink(sample: []u8, trial: []u8, failing: usize, budget: usize,
  predicate: fn(rawptr, []const u8) bool, context: rawptr) Shrunk {
  length := failing
  checks: usize = 0
  chunk := length
  for chunk > 0 && checks < budget {
    at: usize = 0
    reduced: bool = false
    for at + chunk <= length && checks < budget {
      j: usize = 0
      for j < at {
        trial[j] = sample[j]
        j += 1
      }
      for tail in at + chunk..length {
        trial[j] = sample[tail]
        j += 1
      }
      checks += 1
      if !predicate(context, trial[..length - chunk]) {
        length -= chunk
        for k in 0..length {
          sample[k] = trial[k]
        }
        reduced = true
      } else {
        at += chunk
      }
    }
    if !reduced {
      chunk /= 2
    }
  }
  position: usize = 0
  for position < length && checks < budget {
    original := sample[position]
    candidate: u16 = 0
    for candidate < #cast(u16, original) && checks < budget {
      sample[position] = #cast(u8, candidate)
      checks += 1
      if !predicate(context, sample[..length]) {
        break
      }
      sample[position] = original
      candidate += 1
    }
    position += 1
  }
  return Shrunk{ length: length, checks: checks }
}
