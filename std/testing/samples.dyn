use "std/fail"
use sorting "std/sort"

pub struct Samples { count: usize, minimum, median, p90, maximum: i64 }

// Sorts caller-owned nanosecond samples in place; no allocation. No samples,
// or a negative one, fails with InvalidInput without changing the samples.
// Median is the lower middle observation; p90 uses the nearest-rank
// definition. Measure batches to amortize clock costs.
pub fn summarize(status: *fail.Status, samples: []i64) Samples {
  if status == nil { return summarize(&fail.Status{}, samples) }
  if status.failed { return Samples{} }
  if samples.len == 0 {
    fail.invalid(status, "summarize samples", "", "there are no samples")
    return Samples{}
  }
  for value in samples {
    if value < 0 {
      fail.invalid(status, "summarize samples", "", "a sample is negative")
      return Samples{}
    }
  }
  sorting.sort(samples)
  count := samples.len
  return Samples{count: count, minimum: samples[0], median: samples[(count - 1) / 2],
    p90: samples[count - count / 10 - 1], maximum: samples[count - 1]}
}
