use "std/time" clock
use "std/errors" benchmark_errors

pub fn expect(condition: bool, message: []const u8) {
  if !condition {
    #panic(message)
  }
}
pub fn expect_false(condition: bool, message: []const u8) {
  if condition {
    #panic(message)
  }
}
pub fn equal_bytes(left: []const u8, right: []const u8) bool {
  if #len(left) != #len(right) {
    return false
  }
  for i in 0..#len(left) {
    if left[i] != right[i] {
      return false
    }
  }
  return true
}
pub fn expect_equal_bytes(left: []const u8, right: []const u8, message: []const u8) {
  if !equal_bytes(left, right) {
    #panic(message)
  }
}
pub fn expect_equal_i64(left: i64, right: i64, message: []const u8) {
  if left != right {
    #panic(message)
  }
}
pub fn expect_equal_u64(left: u64, right: u64, message: []const u8) {
  if left != right {
    #panic(message)
  }
}
pub fn expect_equal_usize(left: usize, right: usize, message: []const u8) {
  if left != right {
    #panic(message)
  }
}
pub fn expect_equal_isize(left: isize, right: isize, message: []const u8) {
  if left != right {
    #panic(message)
  }
}
pub fn expect_equal_bool(left: bool, right: bool, message: []const u8) {
  if left != right {
    #panic(message)
  }
}

pub struct Random { state: u64 }
pub fn random(seed_value: u64) Random {
  actual := seed_value
  if actual == 0 {
    actual = 11400714819323198485
  }
  return Random{ state: actual }
}
pub fn random_next(generator: *Random) u64 {
  random_value := generator.state
  random_value = random_value ^ ((random_value & 2251799813685247) << 13)
  random_value = random_value ^ (random_value >> 7)
  random_value = random_value ^ ((random_value & 140737488355327) << 17)
  generator.state = random_value
  return random_value
}
pub fn random_below(generator: *Random, bound: usize) usize {
  if bound == 0 {
    return 0
  }
  return #cast(usize, (random_next(generator) % #cast(u64, bound)))
}

// Clock failures are retained by the benchmark and returned by later queries.
pub struct Benchmark { started: clock.ClockResult, iterations: usize, failed: bool, error: isize, kind: benchmark_errors.Kind }
pub fn benchmark_start(iterations: usize) Benchmark {
  now := clock.monotonic_now()
  return Benchmark{ started: now, iterations: iterations, failed: !now.ok, error: now.error, kind: now.kind }
}
fn benchmark_failure(benchmark: *Benchmark, kind: benchmark_errors.Kind, code: isize) clock.DurationResult {
  if !benchmark.failed {
    benchmark.failed = true
    benchmark.kind = kind
    benchmark.error = code
  }
  if benchmark.kind == benchmark_errors.Kind.None {
    benchmark.kind = benchmark_errors.Kind.InvalidState
  }
  return clock.DurationResult{kind: benchmark.kind, error: benchmark.error}
}
pub fn benchmark_elapsed(benchmark: *Benchmark) clock.DurationResult {
  if benchmark.failed {
    return benchmark_failure(benchmark, benchmark.kind, benchmark.error)
  }
  if !benchmark.started.ok {
    return benchmark_failure(benchmark, benchmark.started.kind, benchmark.started.error)
  }
  finished := clock.monotonic_now()
  if !finished.ok {
    return benchmark_failure(benchmark, finished.kind, finished.error)
  }
  duration := clock.elapsed(benchmark.started.value, finished.value)
  if !duration.ok {
    return benchmark_failure(benchmark, benchmark_errors.Kind.Overflow, 0)
  }
  return duration
}
pub fn benchmark_nanoseconds_each(benchmark: *Benchmark) clock.DurationResult {
  if benchmark.failed {
    return benchmark_failure(benchmark, benchmark.kind, benchmark.error)
  }
  if !benchmark.started.ok && (benchmark.started.kind != benchmark_errors.Kind.None || benchmark.started.error != 0) {
    return benchmark_failure(benchmark, benchmark.started.kind, benchmark.started.error)
  }
  if benchmark.iterations == 0 {
    return clock.DurationResult{ok: true}
  }
  duration := benchmark_elapsed(benchmark)
  if !duration.ok {
    return duration
  }
  duration.value /= #cast(i64, benchmark.iterations)
  return duration
}
