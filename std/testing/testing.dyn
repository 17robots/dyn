use "std/fmt"
use "std/mem"
use "std/os"
use "std/time"

pub fn expect(condition: bool, message: []const u8) {
  if !condition { #panic(message) }
}

pub fn expect_false(condition: bool, message: []const u8) {
  if condition { #panic(message) }
}

pub fn equal_bytes(left: []const u8, right: []const u8) bool {
  if #len(left) != #len(right) { return false }
  i: usize = 0
  for i < #len(left) {
    if left[i] != right[i] { return false }
    i += 1
  }
  return true
}

pub fn expect_equal_bytes(left: []const u8, right: []const u8, message: []const u8) {
  if !equal_bytes(left, right) { #panic(message) }
}

pub fn expect_equal_i64(left: i64, right: i64, message: []const u8) {
  if left != right { #panic(message) }
}

pub fn expect_equal_u64(left: u64, right: u64, message: []const u8) {
  if left != right { #panic(message) }
}

pub fn expect_equal_usize(left: usize, right: usize, message: []const u8) {
  if left != right { #panic(message) }
}

pub fn expect_equal_isize(left: isize, right: isize, message: []const u8) {
  if left != right { #panic(message) }
}

pub fn expect_equal_bool(left: bool, right: bool, message: []const u8) {
  if left != right { #panic(message) }
}

// Deterministic caller-buffer path. Caller supplies unique suffix when parallel tests need it.
pub fn temporary_path(destination: []u8, prefix: []const u8, suffix: []const u8) []u8 {
  pid_storage: [20]u8 = []
  pid := fmt.u64_to_bytes(pid_storage[..], #cast(u64) os.process_id())
  required := #len("/tmp/") + #len(prefix) + 1 + #len(pid) + #len(suffix)
  if required > #len(destination) { return destination[..0] }
  at: usize = 0
  parts: [5][]const u8 = ["/tmp/", prefix, "-", pid, suffix]
  for part in parts {
    i: usize = 0
    for i < #len(part) {
      destination[at] = part[i]
      at += 1
      i += 1
    }
  }
  return destination[..at]
}

pub fn assert(cond: bool, msg: []const u8) {
  if !cond { #panic(msg) }
}

pub struct Random { state: u64 }
pub fn random(seed: u64) Random {
  if seed == 0 { seed = 11400714819323198485 }
  return Random{ state: seed }
}
pub fn random_next(generator: *Random) u64 {
  value := generator.state
  value = value ^ (value << 13)
  value = value ^ (value >> 7)
  value = value ^ (value << 17)
  generator.state = value
  return value
}
pub fn random_below(generator: *Random, bound: usize) usize {
  if bound == 0 { return 0 }
  return #cast(usize) (random_next(generator) % #cast(u64) bound)
}

pub struct Benchmark { started: time.Timespec, iterations: usize }
pub fn benchmark_start(iterations: usize) Benchmark {
  return Benchmark{ started: time.monotonic_now(), iterations: iterations }
}
pub fn benchmark_elapsed(benchmark: *const Benchmark) i64 {
  return time.elapsed_nanoseconds(benchmark.started, time.monotonic_now())
}

pub fn benchmark_nanoseconds_each(benchmark: *const Benchmark) i64 {
  if benchmark.iterations == 0 { return 0 }
  return benchmark_elapsed(benchmark) / #cast(i64) benchmark.iterations
}

pub fn expect_file(arena: *mem.Arena, path: []const u8, expected: []const u8, message: []const u8) {
  mark := mem.arena_mark(arena)
  actual := os.try_read_file(arena, path)
  if !actual.ok || !equal_bytes(actual.value, expected) {
    mem.arena_rewind(arena, mark)
    #panic(message)
  }
  mem.arena_rewind(arena, mark)
}

pub fn temporary_directory(path: []const u8) bool {
  return os.make_directory(path, 448).ok
}
