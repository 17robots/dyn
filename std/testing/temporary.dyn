#target(kernel: linux)
use format "std/fmt"
use platform "std/os/linux"
use "std/sync"
use fs "std/fs"
use io "std/io"
use mem "std/mem"
pub struct TemporaryDirectory { path: []const u8, active: bool }
// Reserves a private 0700 directory. Its path is in arena. A prefix holding
// NUL or '/' fails with InvalidInput.
pub fn temporary_directory(arena: *mem.Arena, prefix: []const u8) TemporaryDirectory!io.IoErr {
  for byte in prefix {
    if byte == 0 || byte == '/' { fail .InvalidInput }
  }
  for attempt in 0..128 {
    path := temporary_path(arena, prefix, "")
    // create_exclusive semantics: an existing name is tried again.
    exists := false
    fs.make_directory_exclusive(path, 448) catch err {
      case err {
        .AlreadyExists => { exists = true }
        _ => { fail err }
      }
    }
    if !exists { return TemporaryDirectory{ path: path, active: true } }
  }
  fail .AlreadyExists
}
pub fn remove_temporary(directory: *TemporaryDirectory, frames: []fs.RemovalFrame, scratch: []u8) !io.IoErr {
  if !directory.active { return }
  try fs.remove_tree(directory.path, frames, scratch)
  directory.active = false
}

// Generates a process-local unique candidate name; it does not reserve a file.
// Use fs.create_exclusive to claim it, or a caller-selected private directory.
temporary_path_sequence: sync.AtomicU64
pub fn temporary_path(arena: *mem.Arena, prefix: []const u8, suffix: []const u8) []u8 {
  storage: [4096]u8
  state := format.buffer(storage[..])
  format.write_values(&state, "/tmp/", prefix, "-", platform.process_id(), "-", sync.fetch_add_u64(&temporary_path_sequence, 1), suffix)
  if format.overflowed(&state) {
    #panic("temporary path longer than 4096 bytes")
  }
  output := mem.push_bytes(arena, state.length)
  _ = mem.copy(output, format.bytes(&state))
  return output
}
