#target(kernel: linux)
use format "std/fmt"
use platform "std/os/linux"
use "std/sync"
use "std/fail"
use fs "std/fs"
use io "std/io"
use mem "std/mem"
pub struct TemporaryDirectory { path: []const u8, active: bool }
// Reserves a private 0700 directory. Its path is in arena.
pub fn temporary_directory(arena: *mem.Arena, status: *fail.Status, prefix: []const u8) TemporaryDirectory {
  if status == nil { return temporary_directory(arena, &fail.Status{}, prefix) }
  if status.failed { return TemporaryDirectory{} }
  for byte in prefix {
    if byte == 0 || byte == '/' {
      fail.set(status, io.from_linux("make temporary directory", prefix, -22))
      return TemporaryDirectory{}
    }
  }
  for attempt in 0..128 {
    path := temporary_path(arena, prefix, "")
    // create_exclusive semantics: an existing name is tried again.
    attempted: fail.Status
    fs.make_directory_exclusive(&attempted, path, 448)
    if !attempted.failed { return TemporaryDirectory{ path: path, active: true } }
    if attempted.failure.kind != fail.Kind.AlreadyExists {
      fail.set(status, attempted.failure)
      return TemporaryDirectory{}
    }
  }
  fail.set(status, io.from_linux("make temporary directory", prefix, -17))
  return TemporaryDirectory{}
}
pub fn remove_temporary(status: *fail.Status, directory: *TemporaryDirectory, frames: []fs.RemovalFrame, scratch: []u8) {
  if status == nil {
    remove_temporary(&fail.Status{}, directory, frames, scratch)
    return
  }
  if !directory.active { return }
  fs.remove_tree(status, directory.path, frames, scratch)
  if !status.failed {
    directory.active = false
  }
}

// Generates a process-local unique candidate name; it does not reserve a file.
// Use fs.create_exclusive to claim it, or a caller-selected private directory.
temporary_path_sequence: sync.AtomicU64
pub fn temporary_path(arena: *mem.Arena, prefix: []const u8, suffix: []const u8) []u8 {
  storage: [4096]u8
  naming: fail.Status
  state := format.buffer(&naming, storage[..])
  format.write_values(&state, "/tmp/", prefix, "-", platform.process_id(), "-", sync.fetch_add_u64(&temporary_path_sequence, 1), suffix)
  if naming.failed {
    #panic("temporary path longer than 4096 bytes")
  }
  output := mem.push_bytes(arena, state.length)
  _ = mem.copy(output, format.bytes(&state))
  return output
}
