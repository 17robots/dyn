#target(kernel: linux)
use "std/fmt" format
use "std/os/linux" platform
use "std/sync"
use "std/fs" fs
use "std/errors" errors
use "std/mem" mem
pub struct TemporaryDirectory { path: []const u8, active: bool }
pub struct TemporaryResult { value: TemporaryDirectory, error: isize, kind: errors.Kind, ok: bool }
// Reserves a private 0700 directory. Its path is in arena.
pub fn temporary_directory(arena: *mem.Arena, prefix: []const u8) TemporaryResult {
  for byte in prefix {
    if byte == 0 || byte == '/' {
      return TemporaryResult{ error: -22, kind: errors.linux(-22) }
    }
  }
  for attempt in 0..128 {
    path := temporary_path(arena, prefix, "")
    created := fs.make_directory(path, 448)
    if created.ok {
      return TemporaryResult{ value: TemporaryDirectory{ path: path, active: true }, ok: true }
    }
    if created.error != -17 {
      return TemporaryResult{ error: created.error, kind: created.kind }
    }
  }
  return TemporaryResult{ error: -17, kind: errors.linux(-17) }
}
pub fn remove_temporary(directory: *TemporaryDirectory, frames: []fs.RemovalFrame, scratch: []u8) fs.Result {
  if !directory.active {
    return fs.Result{ ok: true }
  }
  result := fs.remove_tree(directory.path, frames, scratch)
  if result.ok {
    directory.active = false
  }
  return result
}

// Generates a process-local unique candidate name; it does not reserve a file.
// Use fs.create_exclusive to claim it, or a caller-selected private directory.
temporary_path_sequence: sync.AtomicU64
pub fn temporary_path(arena: *mem.Arena, prefix: []const u8, suffix: []const u8) []u8 {
  storage: [4096]u8 = []
  state := format.buffer(storage[..])
  if !format.write_values(&state, "/tmp/", prefix, "-", platform.process_id(), "-", sync.fetch_add_u64(&temporary_path_sequence, 1), suffix) {
    #panic("temporary path longer than 4096 bytes")
  }
  output := mem.push_bytes_uninit(arena, state.length)
  _ = mem.copy(output, format.bytes(&state))
  return output
}
