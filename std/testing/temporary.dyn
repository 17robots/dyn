#target(kernel: linux)
use "std/fmt" format
use "std/os/linux" platform
use "std/sync"
use "std/fs" fs
pub struct TemporaryDirectory { path: []const u8, active: bool }
pub struct TemporaryResult { directory: TemporaryDirectory, error: isize, ok: bool }
// Reserves a private 0700 directory. The returned path borrows destination.
pub fn temporary_directory(destination: []u8, prefix: []const u8) TemporaryResult {
  for byte in prefix {
    if byte == 0 || byte == '/' {
      return TemporaryResult{ error: -22 }
    }
  }
  for attempt in 0..128 {
    path := temporary_path(destination, prefix, "")
    if #len(path) == 0 {
      return TemporaryResult{ error: -28 }
    }
    created := fs.make_directory(path, 448)
    if created.ok {
      return TemporaryResult{ directory: TemporaryDirectory{ path: path, active: true }, ok: true }
    }
    if created.error != -17 {
      return TemporaryResult{ error: created.error }
    }
  }
  return TemporaryResult{ error: -17 }
}
pub fn remove_temporary(directory: *TemporaryDirectory, frames: []fs.RemovalFrame, scratch: []u8) fs.Result {
  if !directory.active {
    return fs.Result{ ok: true }
  }
  result := fs.remove_tree(directory.path, frames, scratch)
  if result.ok {
    directory.active = false
  }
  return result
}

// Generates a process-local unique candidate name; it does not reserve a file.
// Use fs.create_exclusive to claim it, or a caller-selected private directory.
temporary_path_sequence: sync.AtomicU64
pub fn temporary_path(destination: []u8, prefix: []const u8, suffix: []const u8) []u8 {
  state := format.buffer(destination)
  if !format.write_values(&state, "/tmp/", prefix, "-", platform.process_id(), "-", sync.fetch_add_u64(&temporary_path_sequence, 1), suffix) {
    return destination[..0]
  }
  return destination[..state.length]
}
