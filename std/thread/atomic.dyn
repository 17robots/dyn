pub struct AtomicU32 { value: u32 }
pub struct AtomicU64 { value: u64 }

extern fn load_u32_raw "dyn_atomic_load_u32"(value: *const u32) u32
extern fn store_u32_raw "dyn_atomic_store_u32"(value: *u32, desired: u32)
extern fn exchange_u32_raw "dyn_atomic_exchange_u32"(value: *u32, desired: u32) u32
extern fn fetch_add_u32_raw "dyn_atomic_fetch_add_u32"(value: *u32, amount: u32) u32
extern fn compare_exchange_u32_raw "dyn_atomic_compare_exchange_u32"(value: *u32, expected: u32, desired: u32) bool
extern fn load_u64_raw "dyn_atomic_load_u64"(value: *const u64) u64
extern fn store_u64_raw "dyn_atomic_store_u64"(value: *u64, desired: u64)
extern fn exchange_u64_raw "dyn_atomic_exchange_u64"(value: *u64, desired: u64) u64
extern fn fetch_add_u64_raw "dyn_atomic_fetch_add_u64"(value: *u64, amount: u64) u64
extern fn compare_exchange_u64_raw "dyn_atomic_compare_exchange_u64"(value: *u64, expected: u64, desired: u64) bool

pub fn atomic_u32(value: u32) AtomicU32 { return AtomicU32{ value: value } }
pub fn atomic_u64(value: u64) AtomicU64 { return AtomicU64{ value: value } }
pub fn load_u32(value: *const AtomicU32) u32 { return load_u32_raw(&value.value) }
pub fn store_u32(value: *AtomicU32, desired: u32) { store_u32_raw(&value.value, desired) }
pub fn exchange_u32(value: *AtomicU32, desired: u32) u32 { return exchange_u32_raw(&value.value, desired) }
pub fn fetch_add_u32(value: *AtomicU32, amount: u32) u32 { return fetch_add_u32_raw(&value.value, amount) }
pub fn compare_exchange_u32(value: *AtomicU32, expected: u32, desired: u32) bool { return compare_exchange_u32_raw(&value.value, expected, desired) }
pub fn load_u64(value: *const AtomicU64) u64 { return load_u64_raw(&value.value) }
pub fn store_u64(value: *AtomicU64, desired: u64) { store_u64_raw(&value.value, desired) }
pub fn exchange_u64(value: *AtomicU64, desired: u64) u64 { return exchange_u64_raw(&value.value, desired) }
pub fn fetch_add_u64(value: *AtomicU64, amount: u64) u64 { return fetch_add_u64_raw(&value.value, amount) }
pub fn compare_exchange_u64(value: *AtomicU64, expected: u64, desired: u64) bool { return compare_exchange_u64_raw(&value.value, expected, desired) }
