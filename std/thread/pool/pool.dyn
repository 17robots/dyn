// A fixed set of worker threads draining a bounded task queue. All storage
// comes from the caller's arena when the pool starts; submit never allocates
// and reports a full queue instead of growing it.

use mem "std/mem"
use sync "std/sync"
use thread "std/thread"
use "std/fail"
// One unit of work. run receives data on a worker thread.
pub struct Task { run: fn(rawptr), data: rawptr }

// Pools live in the caller's arena and must not move. Use the functions below;
// fields are private to this module.
pub struct Pool {
  lock: sync.Mutex,
  ready: sync.Condition,
  idle: sync.Condition,
  tasks: []Task,
  head: usize,
  count: usize,
  running: usize,
  stopping: bool,
  workers: []*thread.Thread,
  // Handles from spawner instead of workers, when started by start_spawned.
  natives: []rawptr,
  spawner: *const thread.Spawner,
  started: usize,
}


fn worker(pool: *Pool) isize {
  sync.lock(&pool.lock)
  for true {
    for pool.count == 0 && !pool.stopping {
      sync.condition_wait(&pool.ready, &pool.lock)
    }
    if pool.count == 0 { break }
    task := pool.tasks[pool.head]
    pool.head = (pool.head + 1) % pool.tasks.len
    pool.count -= 1
    pool.running += 1
    sync.unlock(&pool.lock)
    task.run(task.data)
    sync.lock(&pool.lock)
    pool.running -= 1
    if pool.count == 0 && pool.running == 0 {
      sync.condition_broadcast(&pool.idle)
    }
  }
  sync.unlock(&pool.lock)
  return 0
}

// Starts workers threads, each with an owned stack of stack_size bytes, and a
// queue of capacity tasks. Storage comes from arena; on failure the arena is
// rewound and any started workers are stopped.
// nil after a failure.
pub fn start(arena: *mem.Arena, status: *fail.Status, workers: usize, capacity: usize, stack_size: usize) *Pool {
  if status == nil { return start(arena, &fail.Status{}, workers, capacity, stack_size) }
  if status.failed { return nil }
  if workers == 0 || capacity == 0 || stack_size < 256 {
    fail.invalid(status, "start pool", "", "a pool needs workers, capacity and stacks of at least 256 bytes")
    return nil
  }
  mark := mem.arena_mark(arena)
  pool := mem.push<Pool>(arena)
  pool.lock = sync.mutex()
  pool.ready = sync.condition()
  pool.idle = sync.condition()
  pool.tasks = mem.push_array<Task>(arena, capacity)
  pool.workers = mem.push_array<*thread.Thread>(arena, workers)
  for i in 0..workers {
    spawned := thread.spawn_with_size(arena, status, stack_size, worker, pool)
    if status.failed {
      cleanup: fail.Status
      stop(&cleanup, pool)
      mem.arena_rewind(arena, mark)
      return nil
    }
    pool.workers[i] = spawned
    pool.started += 1
  }
  return pool
}

// Whether task was queued: false, queuing nothing, when the queue is full or
// the pool is stopping, so the caller can retry or run it elsewhere.
pub fn submit(pool: *Pool, task: Task) bool {
  if pool == nil || task.run == nil { return false }
  sync.lock(&pool.lock)
  if pool.stopping || pool.count == pool.tasks.len {
    sync.unlock(&pool.lock)
    return false
  }
  pool.tasks[(pool.head + pool.count) % pool.tasks.len] = task
  pool.count += 1
  sync.condition_signal(&pool.ready)
  sync.unlock(&pool.lock)
  return true
}

// Blocks until every queued task has finished, including tasks submitted by
// running tasks.
pub fn wait(pool: *Pool) {
  if pool == nil { return }
  sync.lock(&pool.lock)
  for pool.count != 0 || pool.running != 0 {
    sync.condition_wait(&pool.idle, &pool.lock)
  }
  sync.unlock(&pool.lock)
}

// Like start, with threads from spawner, such as std/thread/posix spawner()
// for tasks that call C libraries. spawner must stay alive until stop.
pub fn start_spawned(arena: *mem.Arena, status: *fail.Status, workers: usize, capacity: usize, stack_size: usize, spawner: *const thread.Spawner) *Pool {
  if status == nil { return start_spawned(arena, &fail.Status{}, workers, capacity, stack_size, spawner) }
  if status.failed { return nil }
  if workers == 0 || capacity == 0 || stack_size < 256 || spawner == nil {
    fail.invalid(status, "start pool", "", "a pool needs workers, capacity, a spawner and stacks of at least 256 bytes")
    return nil
  }
  mark := mem.arena_mark(arena)
  pool := mem.push<Pool>(arena)
  pool.lock = sync.mutex()
  pool.ready = sync.condition()
  pool.idle = sync.condition()
  pool.tasks = mem.push_array<Task>(arena, capacity)
  pool.natives = mem.push_array<rawptr>(arena, workers)
  pool.spawner = spawner
  for i in 0..workers {
    native := spawner.spawn(spawner.data, arena, stack_size, #cast(fn(rawptr) isize, worker), pool)
    if native == nil {
      cleanup: fail.Status
      stop(&cleanup, pool)
      mem.arena_rewind(arena, mark)
      fail.set(status, fail.make(fail.Kind.System, "start pool", "", "the spawner could not start a thread"))
      return nil
    }
    pool.natives[i] = native
    pool.started += 1
  }
  return pool
}

// Finishes queued tasks, then joins every worker. The pool's arena storage
// may be reclaimed after a successful stop.
pub fn stop(status: *fail.Status, pool: *Pool) {
  if status == nil {
    stop(&fail.Status{}, pool)
    return
  }
  if status.failed || pool == nil { return }
  sync.lock(&pool.lock)
  pool.stopping = true
  sync.condition_broadcast(&pool.ready)
  sync.unlock(&pool.lock)
  for i in 0..pool.started {
    if pool.spawner != nil {
      if !pool.spawner.join(pool.spawner.data, pool.natives[i]) {
        fail.set(status, fail.make(fail.Kind.System, "stop pool", "", "the spawner could not join a thread"))
        return
      }
      continue
    }
    thread.join(status, pool.workers[i])
    if status.failed { return }
  }
  pool.started = 0
}

// A counter that waiters block on until it returns to zero, for fan-out work
// that does not use a pool. Zero is ready to use.
pub struct Group { lock: sync.Mutex, done: sync.Condition, count: usize }

pub fn group_add(group: *Group, amount: usize) {
  sync.lock(&group.lock)
  group.count += amount
  sync.unlock(&group.lock)
}

// Marks one unit finished. Calling it more times than added panics.
pub fn group_done(group: *Group) {
  sync.lock(&group.lock)
  if group.count == 0 {
    sync.unlock(&group.lock)
    #panic("pool.group_done without matching group_add")
  }
  group.count -= 1
  if group.count == 0 {
    sync.condition_broadcast(&group.done)
  }
  sync.unlock(&group.lock)
}

pub fn group_wait(group: *Group) {
  sync.lock(&group.lock)
  for group.count != 0 {
    sync.condition_wait(&group.done, &group.lock)
  }
  sync.unlock(&group.lock)
}
