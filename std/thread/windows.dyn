#target(kernel: windows)

use "std/io" io
use "std/fail"
use "std/os/windows" win

pub struct Thread { native: win.Thread }

// Windows owns the actual stack; the slice length requests its initial size.
// Keep the arena, Thread, and context alive/unmoved until successful join.
// Fixed arena exhaustion panics; native spawn failure restores the arena mark.
fn spawn_untyped(arena: *mem.Arena, status: *fail.Status, stack: []u8, entry: fn(rawptr) isize, context: rawptr) *Thread {
  return spawn_with_size_untyped(arena, status, #len(stack), entry, context)
}
fn spawn_with_size_untyped(arena: *mem.Arena, status: *fail.Status, stack_size: usize, entry: fn(rawptr) isize, context: rawptr) *Thread {
  if stack_size < 256 || entry == nil { return spawn_invalid(status, "a thread needs an entry and a stack of at least 256 bytes") }
  mark := mem.arena_mark(arena)
  thread := mem.push(Thread, arena)
  if !win.thread_spawn(&thread.native, stack_size, entry, context) {
    error := win.thread_error()
    mem.arena_rewind(arena, mark)
    fail.set(status, io.from_windows("spawn thread", "", error))
    return nil
  }
  return thread
}

// Success clears the native owner. Failure retains it for retry; keep the
// arena/thread/context alive until success. One caller controls this descriptor.
pub fn join(status: *fail.Status, thread: *Thread) {
  if status == nil {
    join(&fail.Status{}, thread)
    return
  }
  if status.failed || thread.native.handle == nil { return }
  if !win.thread_join(&thread.native) {
    fail.set(status, io.from_windows("join thread", "", win.thread_error()))
  }
}

// Identifies an unjoined thread; this is not a portable liveness check.
pub fn id(thread: *const Thread) u32 {
  if thread.native.handle == nil { return 0 }
  return thread.native.id
}

// SwitchToThread returning false means no other thread ran, not an error.
pub fn yield_now() {
  win.thread_yield()
}

// SYSTEM_INFO: dwNumberOfProcessors is the u32 at byte 32 on 64-bit Windows.
struct SystemInfo { bytes: [64]u8 }
extern fn system_info "dyn_win_system_info"(info: *SystemInfo)

// Logical processors in this process's processor group, at least 1.
pub fn cpu_count() usize {
  info := SystemInfo{}
  system_info(&info)
  count := #cast(usize, info.bytes[32]) | #cast(usize, info.bytes[33]) << 8 |
    #cast(usize, info.bytes[34]) << 16 | #cast(usize, info.bytes[35]) << 24
  if count == 0 { return 1 }
  return count
}
