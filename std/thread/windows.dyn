#target(kernel: windows)

use "std/io" io
use "std/os/windows" win

pub struct Thread { native: win.Thread }

// Windows owns the actual stack; the slice length requests its initial size.
// Keep the arena, Thread, and context alive/unmoved until successful join.
// Fixed arena exhaustion panics; native spawn failure restores the arena mark.
pub fn spawn(arena: *mem.Arena, stack: []u8, entry: fn(rawptr) isize, context: rawptr) SpawnResult {
  return spawn_with_size(arena, #len(stack), entry, context)
}
pub fn spawn_with_size(arena: *mem.Arena, stack_size: usize, entry: fn(rawptr) isize, context: rawptr) SpawnResult {
  if stack_size < 256 || entry == nil {
    return SpawnResult{ failure: io.Failure{ kind: io.Kind.InvalidInput } }
  }
  mark := mem.arena_mark(arena)
  thread := mem.push(Thread, arena)
  if !win.thread_spawn(&thread.native, stack_size, entry, context) {
    error := win.thread_error()
    mem.arena_rewind(arena, mark)
    return SpawnResult{ failure: io.Failure{ kind: io.windows(error), native: error } }
  }
  return SpawnResult{ value: thread }
}

// Success clears the native owner. Failure retains it for retry; keep the
// arena/thread/context alive until success. One caller controls this descriptor.
pub fn join(thread: *Thread) Result {
  if thread.native.handle == nil {
    return Result{}
  }
  if !win.thread_join(&thread.native) {
    error := win.thread_error()
    return Result{ failure: io.Failure{ kind: io.windows(error), native: error } }
  }
  return Result{}
}

// Identifies an unjoined thread; this is not a portable liveness check.
pub fn id(thread: *const Thread) u32 {
  if thread.native.handle == nil {
    return 0
  }
  return thread.native.id
}

// SwitchToThread returning false means no other thread ran, not an error.
pub fn yield_now() Result {
  win.thread_yield()
  return Result{}
}
