#target(kernel: linux)

use "std/io" io
use "std/sync"

// stack is the mapping spawn_with_size made for the thread, or empty.
pub struct Thread { tid: sync.AtomicU32, stack: []u8 }
// Below each mapped stack: no access, so an overflow faults instead of
// writing into the next mapping. 64 KiB covers 64 KiB pages.
const stack_guard: usize = 65536

extern fn spawn_raw "dyn_thread_spawn"(
  stack: *u8,
  size: usize,
  entry: fn(rawptr) isize,
  context: rawptr,
  tid: *sync.AtomicU32,
) isize

// Ownership: returns a stable node in the caller arena. Do not move its storage
// or rewind, reset, or release it before successful join. Stack and context are
// borrowed until successful join. Linux raw threads do not provide libc/pthread TLS.
// Allocation: one zeroed Thread; arena exhaustion panics.
// Failure: invalid input has no native code; OS errors retain their negative code.
// Failed creation rewinds the arena to its entry mark; no worker starts.
// Thread safety: caller synchronizes arena access and shared context; one caller
// controls each returned Thread's lifecycle.
pub fn spawn(arena: *mem.Arena, stack: []u8, entry: fn(rawptr) isize, context: rawptr) SpawnResult {
  if #len(stack) < 256 || entry == nil {
    return SpawnResult{ failure: io.Failure{ kind: io.Kind.InvalidInput } }
  }
  mark := mem.arena_mark(arena)
  thread := mem.push(Thread, arena)
  value := spawn_raw(&stack[0], #len(stack), entry, context, &thread.tid)
  if value < 0 {
    mem.arena_rewind(arena, mark)
    return SpawnResult{ failure: io.Failure{ kind: io.linux(value), native: value } }
  }
  return SpawnResult{ value: thread }
}

// Same stable caller-arena node and context lifetime as spawn. Owns a mapped
// stack until successful join; failed creation releases it and rewinds the node.
pub fn spawn_with_size(arena: *mem.Arena, size: usize, entry: fn(rawptr) isize, context: rawptr) SpawnResult {
  if size < 256 || entry == nil {
    return SpawnResult{ failure: io.Failure{ kind: io.Kind.InvalidInput } }
  }
  if size > ~#cast(usize, 0) - stack_guard - 4096 {
    return SpawnResult{ failure: io.Failure{ kind: io.Kind.InvalidInput } }
  }
  mark := mem.arena_mark(arena)
  thread := mem.push(Thread, arena)
  // Private, anonymous, reserved lazily; the guard is the lowest 64 KiB.
  total := stack_guard + (size + 4095) / 4096 * 4096
  address := #syscall(9, 0, total, 3, 16418, -1, 0)
  if address < 0 {
    mem.arena_rewind(arena, mark)
    return SpawnResult{ failure: io.Failure{ kind: io.linux(address), native: address } }
  }
  base := #cast(*u8, address)
  _ = #syscall(10, base, stack_guard, 0)
  thread.stack = #slice(base, total)
  value := spawn_raw(&thread.stack[stack_guard], total - stack_guard, entry, context, &thread.tid)
  if value < 0 {
    _ = #syscall(11, base, total)
    mem.arena_rewind(arena, mark)
    return SpawnResult{ failure: io.Failure{ kind: io.linux(value), native: value } }
  }
  return SpawnResult{ value: thread }
}

// Ownership: success ends worker access and releases any owned stack.
// The caller-arena node is not freed. Joining a zero or joined Thread succeeds.
// Failure retains the owner; do not reclaim worker context or stack.
// Thread safety: never join concurrently through copied Thread descriptors.
pub fn join(thread: *Thread) Result {
  for true {
    tid := sync.load_u32(&thread.tid)
    if tid == 0 {
      if #len(thread.stack) != 0 {
        _ = #syscall(11, &thread.stack[0], #len(thread.stack))
        thread.stack = thread.stack[..0]
      }
      return Result{}
    }
    result := #syscall(202, &thread.tid, 0, tid, 0, 0, 0)
    if result < 0 && result != -4 && result != -11 {
      return Result{ failure: io.Failure{ kind: io.linux(result), native: result } }
    }
  }
  return Result{}
}

pub fn id(thread: *const Thread) u32 {
  return sync.load_u32(&thread.tid)
}
pub fn yield_now() Result {
  value := #syscall(24)
  if value < 0 {
    return Result{ failure: io.Failure{ kind: io.linux(value), native: value } }
  }
  return Result{ value: value }
}

// CPUs this process may run on (its affinity mask), at least 1. Use it to size
// worker pools; it can change while the process runs.
pub fn cpu_count() usize {
  mask: [128]u8 = []
  written := #syscall(204, 0, #len(mask), &mask[0])
  if written <= 0 {
    return 1
  }
  count: usize = 0
  for byte in mask[..#cast(usize, written)] {
    bits := byte
    for bits != 0 {
      count += #cast(usize, bits & 1)
      bits >>= 1
    }
  }
  if count == 0 {
    return 1
  }
  return count
}
