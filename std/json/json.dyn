use "std/mem"
use "std/str"

struct Cursor { source: []const u8, at: usize }

pub const KindNull: u8 = 0
pub const KindBool: u8 = 1
pub const KindNumber: u8 = 2
pub const KindString: u8 = 3
pub const KindArray: u8 = 4
pub const KindObject: u8 = 5

pub struct Value {
  kind: u8,
  boolean: bool,
  text: []const u8,
  key: []const u8,
  first: *Value,
  last: *Value,
  next: *Value,
}

pub struct ParseResult { root: *Value, error_offset: usize, ok: bool }

fn node(arena: *mem.Arena, kind: u8) *Value {
  allocation := mem.arena_try_push(arena, #sizeof(Value), #alignof(Value))
  if !allocation.ok { return nil }
  result := #cast(*Value) allocation.memory
  result.kind = kind
  return result
}

fn append(parent: *Value, child: *Value) {
  if parent.first == nil { parent.first = child }
  else { parent.last.next = child }
  parent.last = child
}

fn whitespace(byte: u8) bool { return byte == ' ' || byte == '\n' || byte == '\r' || byte == '\t' }
fn digit(byte: u8) bool { return byte >= '0' && byte <= '9' }
fn hex(byte: u8) bool { return digit(byte) || (byte >= 'a' && byte <= 'f') || (byte >= 'A' && byte <= 'F') }

fn hex_value(byte: u8) usize {
  if byte >= '0' && byte <= '9' { return #cast(usize) (byte - '0') }
  if byte >= 'a' && byte <= 'f' { return #cast(usize) (byte - 'a') + 10 }
  if byte >= 'A' && byte <= 'F' { return #cast(usize) (byte - 'A') + 10 }
  return 16
}

fn utf8_byte(value: usize, marker: u8) u8 {
  converted: u8 = #cast(u8) value
  return converted | marker
}

fn skip(cursor: *Cursor) {
  for cursor.at < #len(cursor.source) && whitespace(cursor.source[cursor.at]) { cursor.at += 1 }
}

fn literal(cursor: *Cursor, text: []const u8) bool {
  if cursor.at + #len(text) > #len(cursor.source) { return false }
  i: usize = 0
  for i < #len(text) {
    if cursor.source[cursor.at + i] != text[i] { return false }
    i += 1
  }
  cursor.at += #len(text)
  return true
}

fn string(cursor: *Cursor) bool {
  if cursor.at >= #len(cursor.source) || cursor.source[cursor.at] != '"' { return false }
  cursor.at += 1
  for cursor.at < #len(cursor.source) {
    byte := cursor.source[cursor.at]
    cursor.at += 1
    if byte == '"' { return true }
    if byte < 32 { return false }
    if byte == '\\' {
      if cursor.at >= #len(cursor.source) { return false }
      escaped := cursor.source[cursor.at]
      cursor.at += 1
      if escaped == 'u' {
        count: usize = 0
        for count < 4 {
          if cursor.at >= #len(cursor.source) || !hex(cursor.source[cursor.at]) { return false }
          cursor.at += 1
          count += 1
        }
      } else if escaped != '"' && escaped != '\\' && escaped != '/' && escaped != 'b' && escaped != 'f' && escaped != 'n' && escaped != 'r' && escaped != 't' { return false }
    }
  }
  return false
}

fn number(cursor: *Cursor) bool {
  if cursor.at < #len(cursor.source) && cursor.source[cursor.at] == '-' { cursor.at += 1 }
  if cursor.at >= #len(cursor.source) { return false }
  if cursor.source[cursor.at] == '0' { cursor.at += 1 }
  else {
    if cursor.source[cursor.at] < '1' || cursor.source[cursor.at] > '9' { return false }
    for cursor.at < #len(cursor.source) && digit(cursor.source[cursor.at]) { cursor.at += 1 }
  }
  if cursor.at < #len(cursor.source) && cursor.source[cursor.at] == '.' {
    cursor.at += 1
    exponent_start := cursor.at
    for cursor.at < #len(cursor.source) && digit(cursor.source[cursor.at]) { cursor.at += 1 }
    if cursor.at == exponent_start { return false }
  }
  if cursor.at < #len(cursor.source) && (cursor.source[cursor.at] == 'e' || cursor.source[cursor.at] == 'E') {
    cursor.at += 1
    if cursor.at < #len(cursor.source) && (cursor.source[cursor.at] == '+' || cursor.source[cursor.at] == '-') { cursor.at += 1 }
    start := cursor.at
    for cursor.at < #len(cursor.source) && digit(cursor.source[cursor.at]) { cursor.at += 1 }
    if cursor.at == start { return false }
  }
  return true
}

fn validate_value(cursor: *Cursor) bool {
  skip(cursor)
  if cursor.at >= #len(cursor.source) { return false }
  byte := cursor.source[cursor.at]
  if byte == '"' { return string(cursor) }
  if byte == 'n' { return literal(cursor, "null") }
  if byte == 't' { return literal(cursor, "true") }
  if byte == 'f' { return literal(cursor, "false") }
  if byte == '[' {
    cursor.at += 1
    skip(cursor)
    if cursor.at < #len(cursor.source) && cursor.source[cursor.at] == ']' {
      cursor.at += 1
      return true
    }
    for {
      if !validate_value(cursor) { return false }
      skip(cursor)
      if cursor.at >= #len(cursor.source) { return false }
      if cursor.source[cursor.at] == ']' {
        cursor.at += 1
        return true
      }
      if cursor.source[cursor.at] != ',' { return false }
      cursor.at += 1
    }
  }
  if byte == '{' {
    cursor.at += 1
    skip(cursor)
    if cursor.at < #len(cursor.source) && cursor.source[cursor.at] == '}' {
      cursor.at += 1
      return true
    }
    for {
      skip(cursor)
      if !string(cursor) { return false }
      skip(cursor)
      if cursor.at >= #len(cursor.source) || cursor.source[cursor.at] != ':' { return false }
      cursor.at += 1
      if !validate_value(cursor) { return false }
      skip(cursor)
      if cursor.at >= #len(cursor.source) { return false }
      if cursor.source[cursor.at] == '}' {
        cursor.at += 1
        return true
      }
      if cursor.source[cursor.at] != ',' { return false }
      cursor.at += 1
    }
  }
  return number(cursor)
}

pub fn valid(source: []const u8) bool {
  cursor := Cursor{ source: source, at: 0 }
  if !validate_value(&cursor) { return false }
  skip(&cursor)
  return cursor.at == #len(source)
}

pub fn write_string(destination: []u8, source: []const u8) []u8 {
  if #len(destination) < 2 { return destination[..0] }
  at: usize = 0
  destination[at] = '"'
  at += 1
  for byte in source {
    escaped: u8 = 0
    if byte == '"' { escaped = '"' }
    else if byte == '\\' { escaped = '\\' }
    else if byte == '\n' { escaped = 'n' }
    else if byte == '\r' { escaped = 'r' }
    else if byte == '\t' { escaped = 't' }
    else if byte == 8 { escaped = 'b' }
    else if byte == 12 { escaped = 'f' }
    if escaped != 0 {
      if at + 2 >= #len(destination) { return destination[..0] }
      destination[at] = '\\'
      destination[at + 1] = escaped
      at += 2
    } else {
      if byte < 32 || at + 1 >= #len(destination) { return destination[..0] }
      destination[at] = byte
      at += 1
    }
  }
  destination[at] = '"'
  return destination[..at + 1]
}

fn decoded_string(arena: *mem.Arena, cursor: *Cursor) []const u8 {
  if cursor.at >= #len(cursor.source) || cursor.source[cursor.at] != '"' { return cursor.source[..0] }
  cursor.at += 1
  start := cursor.at
  end := start
  for end < #len(cursor.source) && cursor.source[end] != '"' {
    if cursor.source[end] == '\\' { end += 1 }
    if end >= #len(cursor.source) || cursor.source[end] < 32 { return cursor.source[..0] }
    end += 1
  }
  if end >= #len(cursor.source) { return cursor.source[..0] }
  allocation := mem.arena_try_push(arena, end - start, 1)
  if !allocation.ok { return cursor.source[..0] }
  output := allocation.memory[..end - start]
  source_at := start
  output_at: usize = 0
  for source_at < end {
    byte := cursor.source[source_at]
    source_at += 1
    if byte == '\\' {
      if source_at >= end { return cursor.source[..0] }
      escaped := cursor.source[source_at]
      source_at += 1
      if escaped == '"' || escaped == '\\' || escaped == '/' { byte = escaped }
      else if escaped == 'b' { byte = 8 }
      else if escaped == 'f' { byte = 12 }
      else if escaped == 'n' { byte = '\n' }
      else if escaped == 'r' { byte = '\r' }
      else if escaped == 't' { byte = '\t' }
      else if escaped == 'u' {
        if source_at + 4 > end { return cursor.source[..0] }
        code: usize = 0
        digits: usize = 0
        for digits < 4 {
          part := hex_value(cursor.source[source_at])
          if part == 16 { return cursor.source[..0] }
          code = code * 16 + part
          source_at += 1
          digits += 1
        }
        if code >= 55296 && code <= 56319 {
          if source_at + 6 > end || cursor.source[source_at] != '\\' || cursor.source[source_at + 1] != 'u' { return cursor.source[..0] }
          source_at += 2
          low: usize = 0
          low_digits: usize = 0
          for low_digits < 4 {
            low_part := hex_value(cursor.source[source_at])
            if low_part == 16 { return cursor.source[..0] }
            low = low * 16 + low_part
            source_at += 1
            low_digits += 1
          }
          if low < 56320 || low > 57343 { return cursor.source[..0] }
          code = 65536 + (code - 55296) * 1024 + low - 56320
        } else if code >= 56320 && code <= 57343 { return cursor.source[..0] }
        if code <= 127 {
          output[output_at] = #cast(u8) code
          output_at += 1
        } else if code <= 2047 {
          output[output_at] = utf8_byte(code >> 6, 192)
          output[output_at + 1] = utf8_byte(code & 63, 128)
          output_at += 2
        } else if code <= 65535 {
          output[output_at] = utf8_byte(code >> 12, 224)
          output[output_at + 1] = utf8_byte((code >> 6) & 63, 128)
          output[output_at + 2] = utf8_byte(code & 63, 128)
          output_at += 3
        } else {
          output[output_at] = utf8_byte(code >> 18, 240)
          output[output_at + 1] = utf8_byte((code >> 12) & 63, 128)
          output[output_at + 2] = utf8_byte((code >> 6) & 63, 128)
          output[output_at + 3] = utf8_byte(code & 63, 128)
          output_at += 4
        }
        continue
      } else { return cursor.source[..0] }
    }
    output[output_at] = byte
    output_at += 1
  }
  cursor.at = end + 1
  return output[..output_at]
}

fn parse_node(arena: *mem.Arena, cursor: *Cursor) *Value {
  skip(cursor)
  if cursor.at >= #len(cursor.source) { return nil }
  byte := cursor.source[cursor.at]
  if byte == 'n' {
    if !literal(cursor, "null") { return nil }
    return node(arena, KindNull)
  }
  if byte == 't' || byte == 'f' {
    truth := byte == 't'
    if truth { if !literal(cursor, "true") { return nil } }
    else { if !literal(cursor, "false") { return nil } }
    bool_node := node(arena, KindBool)
    if bool_node != nil { bool_node.boolean = truth }
    return bool_node
  }
  if byte == '"' {
    text := decoded_string(arena, cursor)
    string_node := node(arena, KindString)
    if string_node != nil { string_node.text = text }
    return string_node
  }
  if byte == '[' || byte == '{' {
    object := byte == '{'
    cursor.at += 1
    container := node(arena, KindArray)
    if object && container != nil { container.kind = KindObject }
    if container == nil { return nil }
    skip(cursor)
    closing: u8 = ']'
    if object { closing = '}' }
    if cursor.at < #len(cursor.source) && cursor.source[cursor.at] == closing {
      cursor.at += 1
      return container
    }
    for {
      key: []const u8 = cursor.source[..0]
      if object {
        key = decoded_string(arena, cursor)
        skip(cursor)
        if cursor.at >= #len(cursor.source) || cursor.source[cursor.at] != ':' { return nil }
        cursor.at += 1
      }
      child := parse_node(arena, cursor)
      if child == nil { return nil }
      child.key = key
      append(container, child)
      skip(cursor)
      if cursor.at >= #len(cursor.source) { return nil }
      if cursor.source[cursor.at] == closing {
        cursor.at += 1
        return container
      }
      if cursor.source[cursor.at] != ',' { return nil }
      cursor.at += 1
      skip(cursor)
    }
  }
  start := cursor.at
  if !number(cursor) { return nil }
  number_node := node(arena, KindNumber)
  if number_node != nil { number_node.text = cursor.source[start..cursor.at] }
  return number_node
}

pub fn parse(arena: *mem.Arena, source: []const u8) ParseResult {
  mark := mem.arena_mark(arena)
  cursor := Cursor{ source: source, at: 0 }
  root := parse_node(arena, &cursor)
  skip(&cursor)
  if root == nil || cursor.at != #len(source) {
    mem.arena_rewind(arena, mark)
    return ParseResult{ root: nil, error_offset: cursor.at, ok: false }
  }
  return ParseResult{ root: root, error_offset: 0, ok: true }
}

pub fn object_get(object: *const Value, key: []const u8) *const Value {
  if object == nil || object.kind != KindObject { return nil }
  child := object.first
  for child != nil {
    if str.equal(child.key, key) { return child }
    child = child.next
  }
  return nil
}

pub fn array_length(array: *const Value) usize {
  if array == nil || array.kind != KindArray { return 0 }
  count: usize = 0
  child := array.first
  for child != nil {
    count += 1
    child = child.next
  }
  return count
}

pub fn array_get(array: *const Value, index: usize) *const Value {
  if array == nil || array.kind != KindArray { return nil }
  child := array.first
  at: usize = 0
  for child != nil {
    if at == index { return child }
    at += 1
    child = child.next
  }
  return nil
}

pub fn is_null(value: *const Value) bool { return value != nil && value.kind == KindNull }
pub fn is_bool(value: *const Value) bool { return value != nil && value.kind == KindBool }
pub fn is_number(value: *const Value) bool { return value != nil && value.kind == KindNumber }
pub fn is_string(value: *const Value) bool { return value != nil && value.kind == KindString }
pub fn is_array(value: *const Value) bool { return value != nil && value.kind == KindArray }
pub fn is_object(value: *const Value) bool { return value != nil && value.kind == KindObject }

fn copy(destination: []u8, at: *usize, bytes: []const u8) bool {
  if #len(bytes) > #len(destination) - at.* { return false }
  for byte in bytes {
    destination[at.*] = byte
    at.* += 1
  }
  return true
}

fn encode_value(destination: []u8, at: *usize, value: *const Value) bool {
  if value == nil { return false }
  if value.kind == KindNull { return copy(destination, at, "null") }
  if value.kind == KindBool {
    if value.boolean { return copy(destination, at, "true") }
    return copy(destination, at, "false")
  }
  if value.kind == KindNumber { return copy(destination, at, value.text) }
  if value.kind == KindString {
    string_encoded := write_string(destination[at.*..], value.text)
    if #len(string_encoded) == 0 { return false }
    at.* += #len(string_encoded)
    return true
  }
  opening: u8 = '['
  closing: u8 = ']'
  if value.kind == KindObject {
    opening = '{'
    closing = '}'
  }
  if at.* >= #len(destination) { return false }
  destination[at.*] = opening
  at.* += 1
  child := value.first
  first := true
  for child != nil {
    if !first { if !copy(destination, at, ",") { return false } }
    if value.kind == KindObject {
      key_encoded := write_string(destination[at.*..], child.key)
      if #len(key_encoded) == 0 { return false }
      at.* += #len(key_encoded)
      if !copy(destination, at, ":") { return false }
    }
    if !encode_value(destination, at, child) { return false }
    first = false
    child = child.next
  }
  if at.* >= #len(destination) { return false }
  destination[at.*] = closing
  at.* += 1
  return true
}

pub fn write(destination: []u8, value: *const Value) []u8 {
  at: usize = 0
  if !encode_value(destination, &at, value) { return destination[..0] }
  return destination[..at]
}
