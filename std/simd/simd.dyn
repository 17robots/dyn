  return output
}

pub fn f32x4_sub(a, b: F32x4) F32x4 {
  output: F32x4 = []
  for i in 0..4 {
    output[i] = a[i] - b[i]
  }
  return output
}

pub fn f32x4_mul(a, b: F32x4) F32x4 {
  output: F32x4 = []
  for i in 0..4 {
    output[i] = a[i] * b[i]
  }
  return output
}

pub fn f32x4_div(a, b: F32x4) F32x4 {
  output: F32x4 = []
  for i in 0..4 {
    output[i] = a[i] / b[i]
  }
  return output
}

pub type F64x2 = [2]f64

pub fn f64x2_splat(value: f64) F64x2 {
  output: F64x2 = []
  for i in 0..2 {
    output[i] = value
  }
  return output
}
// Requires at least 2 elements; extra elements are ignored.
pub fn f64x2_load(source: []const f64) F64x2 {
  if #len(source) < 2 {
    #panic("short SIMD load")
  }
  output: F64x2 = []
  for i in 0..2 {
    output[i] = source[i]
  }
  return output
}
// Writes exactly 2 elements; requires at least 2 elements.
pub fn f64x2_store(destination: []f64, value: F64x2) {
  if #len(destination) < 2 {
    #panic("short SIMD store")
  }
  for i in 0..2 {
    destination[i] = value[i]
  }
}

pub fn f64x2_add(a, b: F64x2) F64x2 {
  output: F64x2 = []
  for i in 0..2 {
    output[i] = a[i] + b[i]
  }
  return output
}

pub fn f64x2_sub(a, b: F64x2) F64x2 {
  output: F64x2 = []
  for i in 0..2 {
    output[i] = a[i] - b[i]
  }
  return output
}

pub fn f64x2_mul(a, b: F64x2) F64x2 {
  output: F64x2 = []
  for i in 0..2 {
    output[i] = a[i] * b[i]
  }
  return output
}

pub fn f64x2_div(a, b: F64x2) F64x2 {
  output: F64x2 = []
  for i in 0..2 {
    output[i] = a[i] / b[i]
  }
  return output
}
