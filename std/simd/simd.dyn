// Fixed 128-bit lane values with portable scalar semantics. Integer arithmetic
// wraps per lane, including debug builds. No alignment beyond the element type
// is required. O3 can lower supported 32/64-bit integer operations to SSE2/NEON;
// other targets and operations use the same checked, bounds-safe scalar code.
// This API does not expose native vector ABI types for FFI.

pub type U8x16 = [16]u8

pub fn u8x16_splat(value: u8) U8x16 {
  output: U8x16 = []
  for i in 0..16 {
    output[i] = value
  }
  return output
}
// Requires at least 16 elements; extra elements are ignored.
pub fn u8x16_load(source: []const u8) U8x16 {
  if #len(source) < 16 {
    #panic("short SIMD load")
  }
  output: U8x16 = []
  for i in 0..16 {
    output[i] = source[i]
  }
  return output
}
// Writes exactly 16 elements; requires at least 16 elements.
pub fn u8x16_store(destination: []u8, value: U8x16) {
  if #len(destination) < 16 {
    #panic("short SIMD store")
  }
  for i in 0..16 {
    destination[i] = value[i]
  }
}

pub fn u8x16_add(a, b: U8x16) U8x16 {
  output: U8x16 = []
  for i in 0..16 {
    output[i] = #wrap(a[i] + b[i])
  }
  return output
}

pub fn u8x16_sub(a, b: U8x16) U8x16 {
  output: U8x16 = []
  for i in 0..16 {
    output[i] = #wrap(a[i] - b[i])
  }
  return output
}

pub fn u8x16_mul(a, b: U8x16) U8x16 {
  output: U8x16 = []
  for i in 0..16 {
    output[i] = #wrap(a[i] * b[i])
  }
  return output
}

pub fn u8x16_and(a, b: U8x16) U8x16 {
  output: U8x16 = []
  for i in 0..16 {
    output[i] = a[i] & b[i]
  }
  return output
}

pub fn u8x16_or(a, b: U8x16) U8x16 {
  output: U8x16 = []
  for i in 0..16 {
    output[i] = a[i] | b[i]
  }
  return output
}

pub fn u8x16_xor(a, b: U8x16) U8x16 {
  output: U8x16 = []
  for i in 0..16 {
    output[i] = a[i] ^ b[i]
  }
  return output
}

// Full-bit equality mask in each lane: all ones for equal, zero otherwise.
pub fn u8x16_equal(a, b: U8x16) U8x16 {
  output: U8x16 = []
  for i in 0..16 {
    if a[i] == b[i] {
      output[i] = ~#cast(u8, 0)
    }
  }
  return output
}
// Select individual bits from a where mask is one and b where mask is zero.
pub fn u8x16_select(mask, a, b: U8x16) U8x16 {
  output: U8x16 = []
  for i in 0..16 {
    output[i] = (a[i] & mask[i]) | (b[i] & ~mask[i])
  }
  return output
}

