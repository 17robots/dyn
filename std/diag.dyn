module diag

fmt := use "std/fmt"
path := use "std/path"

pub Severity := enum {
    Error,
    Warning,
    Note,
}

pub Span := struct {
    file: []u8,
    start_line: usize,
    start_col: usize,
    end_line: usize,
    end_col: usize,
}

pub Label := struct {
    primary: u1,
    span: Span,
    message: []u8,
}

pub Diagnostic := struct {
    code: []u8,
    severity: Severity,
    message: []u8,
    label: Label,

    header := (self: Diagnostic) []u8 {
        sev := severity_text(self.severity)
        return fmt.join3(self.code, ": ", fmt.join3(sev, ": ", self.message))
    },
}

pub make :=
    (
        code: []u8,
        severity: Severity,
        message: []u8,
        file: []u8,
        line: usize,
        col: usize,
    ) Diagnostic => Diagnostic{
        code: code,
        severity: severity,
        message: message,
        label: Label{
            primary: true,
            span: Span{
                file: file,
                start_line: line,
                start_col: col,
                end_line: line,
                end_col: col,
            },
            message: message,
        },
    }

pub severity_text := (severity: Severity) []u8 {
    if severity == .Error return "error"
    if severity == .Warning return "warning"
    return "note"
}

pub file_name := (diagnostic: Diagnostic) []u8 => path.basename(diagnostic.label.span.file)
