use clock "std/time"
// Caller-backed monotonic profiling. Event names are borrowed.
pub struct Event {
  name: []const u8,
  started_nanoseconds: i64,
  duration_nanoseconds: i64,
}

pub struct Span { name: []const u8, started: clock.Instant }

// Events go in caller storage; once it is full, finish counts them in dropped.
pub struct Trace {
  events: []Event,
  count: usize,
  dropped: usize,
}

pub fn trace(events: []Event) Trace {
  return Trace{ events: events, count: 0, dropped: 0 }
}

pub fn begin(name: []const u8) Span {
  return Span{ name: name, started: clock.monotonic_now() }
}

// Records span as ended now. When the trace is full the event is dropped
// and counted in dropped.
pub fn finish(destination: *Trace, span: Span) {
  if destination.count >= destination.events.len {
    destination.dropped += 1
    return
  }
  finished := clock.monotonic_now()
  destination.events[destination.count] = Event{
    name: span.name,
    started_nanoseconds: clock.elapsed(clock.Instant{}, span.started),
    duration_nanoseconds: clock.elapsed(span.started, finished),
  }
  destination.count += 1
}

pub fn recorded(value: *Trace) []Event {
  return value.events[..value.count]
}
pub fn clear(value: *Trace) {
  value.count = 0
  value.dropped = 0
}
