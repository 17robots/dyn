use "std/time"

// Caller-backed monotonic profiling. Event names are borrowed.
pub struct Event {
  name: []const u8,
  started_nanoseconds: i64,
  duration_nanoseconds: i64,
}

pub struct Span { name: []const u8, started: time.Timespec }

pub struct Trace {
  events: []Event,
  count: usize,
  dropped: usize,
}

pub fn trace(events: []Event) Trace {
  return Trace{ events: events, count: 0, dropped: 0 }
}

pub fn begin(name: []const u8) Span {
  return Span{ name: name, started: time.monotonic_now() }
}

pub fn end(destination: *Trace, span: Span) bool {
  finished := time.monotonic_now()
  if destination.count == #len(destination.events) {
    destination.dropped += 1
    return false
  }
  destination.events[destination.count] = Event{
    name: span.name,
    started_nanoseconds: time.duration_nanoseconds(span.started),
    duration_nanoseconds: time.elapsed_nanoseconds(span.started, finished),
  }
  destination.count += 1
  return true
}

pub fn recorded(value: *Trace) []Event { return value.events[..value.count] }
pub fn clear(value: *Trace) { value.count = 0
  value.dropped = 0
}
