// Allocation-free byte-slice operations. Returned slices borrow input or caller storage.

pub fn equal(left: []const u8, right: []const u8) bool {
  if #len(left) != #len(right) { return false }
  return compare(left, right) == 0
}

pub fn compare(left: []const u8, right: []const u8) i32 {
  shared := #len(left)
  if #len(right) < shared { shared = #len(right) }
  i: usize = 0
  for i < shared {
    if left[i] < right[i] { return -1 }
    if left[i] > right[i] { return 1 }
    i += 1
  }
  if #len(left) < #len(right) { return -1 }
  if #len(left) > #len(right) { return 1 }
  return 0
}

pub fn starts_with(value: []const u8, prefix: []const u8) bool {
  return #len(prefix) <= #len(value) && equal(value[..#len(prefix)], prefix)
}

pub fn ends_with(value: []const u8, suffix: []const u8) bool {
  return #len(suffix) <= #len(value) && equal(value[#len(value) - #len(suffix)..], suffix)
}

pub fn find_byte(value: []const u8, byte: u8) isize {
  i: usize = 0
  for i < #len(value) {
    if value[i] == byte { return #cast(isize) i }
    i += 1
  }
  return -1
}

pub fn find_last_byte(value: []const u8, byte: u8) isize {
  i := #len(value)
  for i > 0 {
    i -= 1
    if value[i] == byte { return #cast(isize) i }
  }
  return -1
}

pub fn find(value: []const u8, needle: []const u8) isize {
  if #len(needle) == 0 { return 0 }
  if #len(needle) > #len(value) { return -1 }
  i: usize = 0
  for i <= #len(value) - #len(needle) {
    if equal(value[i..i + #len(needle)], needle) { return #cast(isize) i }
    i += 1
  }
  return -1
}

pub fn find_last(value: []const u8, needle: []const u8) isize {
  if #len(needle) == 0 { return #cast(isize) #len(value) }
  if #len(needle) > #len(value) { return -1 }
  i := #len(value) - #len(needle) + 1
  for i > 0 {
    i -= 1
    if equal(value[i..i + #len(needle)], needle) { return #cast(isize) i }
  }
  return -1
}

pub fn contains(value: []const u8, needle: []const u8) bool { return find(value, needle) >= 0 }

pub fn count_occurrences(value: []const u8, needle: []const u8) usize {
  if #len(needle) == 0 { return #len(value) + 1 }
  found_count: usize = 0
  offset: usize = 0
  for offset + #len(needle) <= #len(value) {
    if equal(value[offset..offset + #len(needle)], needle) {
      found_count += 1
      offset += #len(needle)
    } else { offset += 1 }
  }
  return found_count
}

pub struct Splitter {
  value: []const u8,
  separator: []const u8,
  offset: usize,
  done: bool,
}

pub fn splitter(value: []const u8, separator: []const u8) Splitter {
  if #len(separator) == 0 { #panic("split separator must not be empty") }
  return Splitter{ value: value, separator: separator, offset: 0, done: false }
}

pub fn split_next(state: *Splitter, output: *[]const u8) bool {
  if state.done { return false }
  found := find(state.value[state.offset..], state.separator)
  if found < 0 {
    output.* = state.value[state.offset..]
    state.offset = #len(state.value)
    state.done = true
    return true
  }
  end := state.offset + #cast(usize) found
  output.* = state.value[state.offset..end]
  state.offset = end + #len(state.separator)
  return true
}

pub struct Cursor {
  data: []const u8,
  offset: usize,
}

pub fn cursor(data: []const u8) Cursor { return Cursor{ data: data, offset: 0 } }
pub fn cursor_remaining(state: *const Cursor) usize { return #len(state.data) - state.offset }
pub fn cursor_rest(state: *const Cursor) []const u8 { return state.data[state.offset..] }

pub fn cursor_read(state: *Cursor, destination: []u8) usize {
  take := cursor_remaining(state)
  if #len(destination) < take { take = #len(destination) }
  i: usize = 0
  for i < take {
    destination[i] = state.data[state.offset + i]
    i += 1
  }
  state.offset += take
  return take
}

pub fn cursor_skip(state: *Cursor, amount: usize) bool {
  if amount > cursor_remaining(state) { return false }
  state.offset += amount
  return true
}

pub struct Builder {
  data: []u8,
  length: usize,
  failed: bool,
}

pub fn builder(storage: []u8) Builder {
  return Builder{ data: storage, length: 0, failed: false }
}

pub fn builder_bytes(state: *const Builder) []const u8 { return state.data[..state.length] }
pub fn builder_remaining(state: *const Builder) usize { return #len(state.data) - state.length }

pub fn builder_write(state: *Builder, value: []const u8) bool {
  if state.failed || #len(value) > builder_remaining(state) {
    state.failed = true
    return false
  }
  i: usize = 0
  for i < #len(value) {
    state.data[state.length + i] = value[i]
    i += 1
  }
  state.length += #len(value)
  return true
}

pub fn builder_write_byte(state: *Builder, value: u8) bool {
  if state.failed || state.length == #len(state.data) {
    state.failed = true
    return false
  }
  state.data[state.length] = value
  state.length += 1
  return true
}

pub fn builder_reset(state: *Builder) {
  state.length = 0
  state.failed = false
}
