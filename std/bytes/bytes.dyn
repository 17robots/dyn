// Allocation-free byte-slice operations. Returned slices borrow input or caller storage.

pub fn equal(left: []const u8, right: []const u8) bool {
  if #len(left) != #len(right) {
    return false
  }
  return compare(left, right) == 0
}

pub fn compare(left: []const u8, right: []const u8) i32 {
  shared := #len(left)
  if #len(right) < shared {
    shared = #len(right)
  }
  for i in 0..shared {
    if left[i] < right[i] {
      return -1
    }
    if left[i] > right[i] {
      return 1
    }
  }
  if #len(left) < #len(right) {
    return -1
  }
  if #len(left) > #len(right) {
    return 1
  }
  return 0
}

pub fn starts_with(value: []const u8, prefix: []const u8) bool {
  return #len(prefix) <= #len(value) && equal(value[..#len(prefix)], prefix)
}

pub fn ends_with(value: []const u8, suffix: []const u8) bool {
  return #len(suffix) <= #len(value) && equal(value[#len(value) - #len(suffix)..], suffix)
}

// Positions are usize. A miss returns #len(value), which is always a safe
// slice bound: value[..at] is the whole input and value[at..] is empty.

pub fn find_byte(value: []const u8, byte: u8) usize {
  for i in 0..#len(value) {
    if value[i] == byte {
      return i
    }
  }
  return #len(value)
}

pub fn find_last_byte(value: []const u8, byte: u8) usize {
  i := #len(value)
  for i > 0 {
    i -= 1
    if value[i] == byte {
      return i
    }
  }
  return #len(value)
}

// An empty needle matches at zero.
pub fn find(value: []const u8, needle: []const u8) usize {
  if #len(needle) == 0 {
    return 0
  }
  if #len(needle) > #len(value) {
    return #len(value)
  }
  if #len(needle) == 1 {
    return find_byte(value, needle[0])
  }
  last := #len(needle) - 1
  final_byte := needle[last]
  candidates := #len(value) - #len(needle) + 1
  i: usize = 0
  for i < candidates {
    remaining := value[i + last..]
    skipped := find_byte(remaining, final_byte)
    if skipped == #len(remaining) {
      return #len(value)
    }
    i += skipped
    if equal(value[i..i + #len(needle)], needle) {
      return i
    }
    i += 1
  }
  return #len(value)
}

// An empty needle matches at the end.
pub fn find_last(value: []const u8, needle: []const u8) usize {
  if #len(needle) == 0 || #len(needle) > #len(value) {
    return #len(value)
  }
  if #len(needle) == 1 {
    return find_last_byte(value, needle[0])
  }
  i := #len(value) - #len(needle) + 1
  for i > 0 {
    i -= 1
    if equal(value[i..i + #len(needle)], needle) {
      return i
    }
  }
  return #len(value)
}

pub fn contains(value: []const u8, needle: []const u8) bool {
  return #len(needle) == 0 || find(value, needle) < #len(value)
}

pub fn count_occurrences(value: []const u8, needle: []const u8) usize {
  if #len(needle) == 0 {
    return #len(value) + 1
  }
  found_count: usize = 0
  offset: usize = 0
  for offset + #len(needle) <= #len(value) {
    if equal(value[offset..offset + #len(needle)], needle) {
      found_count += 1
      offset += #len(needle)
    } else {
      offset += 1
    }
  }
  return found_count
}

pub struct Splitter {
  value: []const u8,
  separator: []const u8,
  offset: usize,
  done: bool,
}

pub fn splitter(value: []const u8, separator: []const u8) Splitter {
  if #len(separator) == 0 {
    #panic("split separator must not be empty")
  }
  return Splitter{ value: value, separator: separator, offset: 0, done: false }
}

pub struct Piece { value: []const u8, ok: bool }

// The next piece, or ok false after the last one. A value without the
// separator is one piece; a trailing separator gives a final empty piece.
pub fn split_next(state: *Splitter) Piece {
  if state.done {
    return Piece{}
  }
  rest := state.value[state.offset..]
  found := find(rest, state.separator)
  if found == #len(rest) {
    state.offset = #len(state.value)
    state.done = true
    return Piece{ value: rest, ok: true }
  }
  end := state.offset + found
  piece := state.value[state.offset..end]
  state.offset = end + #len(state.separator)
  return Piece{ value: piece, ok: true }
}

pub struct Cursor {
  data: []const u8,
  offset: usize,
}

pub fn cursor(data: []const u8) Cursor {
  return Cursor{ data: data, offset: 0 }
}
pub fn cursor_remaining(state: *const Cursor) usize {
  return #len(state.data) - state.offset
}
pub fn cursor_rest(state: *const Cursor) []const u8 {
  return state.data[state.offset..]
}

pub fn cursor_read(state: *Cursor, destination: []u8) usize {
  take := cursor_remaining(state)
  if #len(destination) < take {
    take = #len(destination)
  }
  for i in 0..take {
    destination[i] = state.data[state.offset + i]
  }
  state.offset += take
  return take
}

pub fn cursor_skip(state: *Cursor, amount: usize) bool {
  if amount > cursor_remaining(state) {
    return false
  }
  state.offset += amount
  return true
}

pub struct Builder {
  data: []u8,
  length: usize,
  failed: bool,
}

pub fn builder(storage: []u8) Builder {
  return Builder{ data: storage, length: 0, failed: false }
}

pub fn builder_bytes(state: *const Builder) []const u8 {
  return state.data[..state.length]
}
pub fn builder_remaining(state: *const Builder) usize {
  return #len(state.data) - state.length
}

pub fn builder_write(state: *Builder, value: []const u8) bool {
  if state.failed || #len(value) > builder_remaining(state) {
    state.failed = true
    return false
  }
  for i in 0..#len(value) {
    state.data[state.length + i] = value[i]
  }
  state.length += #len(value)
  return true
}

pub fn builder_write_byte(state: *Builder, value: u8) bool {
  if state.failed || state.length == #len(state.data) {
    state.failed = true
    return false
  }
  state.data[state.length] = value
  state.length += 1
  return true
}

pub fn builder_reset(state: *Builder) {
  state.length = 0
  state.failed = false
}

// Empty slices never overlap. Uses differences so address addition cannot overflow.
pub fn overlaps(left: []const u8, right: []const u8) bool {
  if #len(left) == 0 || #len(right) == 0 {
    return false
  }
  a := #cast(usize, &left[0])
  b := #cast(usize, &right[0])
  if a <= b {
    return b - a < #len(left)
  }
  return a - b < #len(right)
}
