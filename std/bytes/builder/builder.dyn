use "std/mem" memory
use "std/fail"

// Byte and UTF-8 string construction share this byte-oriented builder. No UTF-8
// validation is implied. A builder borrows storage; arena growth is explicit.
pub struct Builder { storage: []u8, length: usize }

pub fn from_buffer(storage: []u8) Builder {
  return Builder{ storage: storage }
}
// Ownership: returned view borrows builder storage; no copy.
// Invalidation: reacquire after mutation; backing storage must remain alive.
// Allocation: none.
pub fn bytes(state: *const Builder) []const u8 {
  return state.storage[..state.length]
}
// Empties the builder. Keeps capacity.
pub fn clear(state: *Builder) {
  state.length = 0
}

// Exact capacity reservation. Panics when the arena is exhausted.
// Extends the arena's most recent buffer in place when possible. Otherwise old
// arena buffers remain allocated until the caller rewinds or resets.
pub fn reserve(arena: *memory.Arena, state: *Builder, capacity: usize) {
  if state.length > #len(state.storage) {
    #panic("builder length is past its storage")
  }
  if capacity <= #len(state.storage) { return }
  if #len(state.storage) > 0 && memory.arena_try_extend(arena, &state.storage[0],
    #len(state.storage), capacity - #len(state.storage)) {
    state.storage = #slice(&state.storage[0], capacity)
    return
  }
  allocated := memory.arena_push_uninit(arena, capacity, 1)
  storage := #slice(allocated, capacity)
  _ = memory.move(storage, state.storage[..state.length])
  state.storage = storage
}

// Bounded append supports overlap/self-append. Fails with Capacity, writing
// nothing, when source does not fit the storage left.
// Allocation: none; capacity is fixed until an explicit reserve or append_grow.
pub fn append(status: *fail.Status, state: *Builder, source: []const u8) {
  if status.failed { return }
  if state.length > #len(state.storage) {
    fail.set(status, fail.make(fail.Kind.InvalidState, "append", "", "builder length is past its storage"))
    return
  }
  if #len(source) > #len(state.storage) - state.length {
    fail.set(status, fail.make(fail.Kind.Capacity, "append", "", "builder storage is full"))
    return
  }
  _ = memory.move(state.storage[state.length..], source)
  state.length += #len(source)
}

// Geometric growth. Panics when the arena cannot hold the selected capacity.
// Existing views must be reacquired after mutation. Source may borrow this builder.
pub fn append_grow(arena: *memory.Arena, state: *Builder, source: []const u8) {
  if state.length > #len(state.storage) {
    #panic("builder length is past its storage")
  }
  maximum := #cast(usize, -1)
  if #len(source) > maximum - state.length {
    #panic("builder size overflow")
  }
  required := state.length + #len(source)
  if required > #len(state.storage) {
    capacity := #len(state.storage)
    if capacity < 64 {
      capacity = 64
    }
    for capacity < required {
      if capacity > maximum / 2 {
        capacity = required
        break
      }
      capacity *= 2
    }
    reserve(arena, state, capacity)
  }
  _ = memory.move(state.storage[state.length..], source)
  state.length += #len(source)
}
