// UTF-8 strings are immutable byte slices. Operations work on bytes unless named otherwise.

pub fn equal(left: []const u8, right: []const u8) bool {
  if #len(left) != #len(right) { return false }
  i: usize = 0
  for i < #len(left) { if left[i] != right[i] { return false } i += 1 }
  return true
}

pub fn find_byte(text: []const u8, byte: u8) isize {
  i: usize = 0
  for i < #len(text) { if text[i] == byte { return #cast(isize) i } i += 1 }
  return -1
}

pub fn find(text: []const u8, needle: []const u8) isize {
  if #len(needle) == 0 { return 0 }
  if #len(needle) > #len(text) { return -1 }
  i: usize = 0
  for i <= #len(text) - #len(needle) {
    if equal(text[i..i + #len(needle)], needle) { return #cast(isize) i }
    i += 1
  }
  return -1
}

pub fn contains(text: []const u8, needle: []const u8) bool { return find(text, needle) >= 0 }
pub fn starts_with(text: []const u8, prefix: []const u8) bool {
  return #len(prefix) <= #len(text) && equal(text[..#len(prefix)], prefix)
}
pub fn ends_with(text: []const u8, suffix: []const u8) bool {
  return #len(suffix) <= #len(text) && equal(text[#len(text) - #len(suffix)..], suffix)
}
pub fn strip_prefix(text: []const u8, prefix: []const u8) []const u8 {
  if starts_with(text, prefix) { return text[#len(prefix)..] }
  return text
}
pub fn strip_suffix(text: []const u8, suffix: []const u8) []const u8 {
  if ends_with(text, suffix) { return text[..#len(text) - #len(suffix)] }
  return text
}

pub fn ascii_is_digit(byte: u8) bool { return byte >= '0' && byte <= '9' }
pub fn ascii_is_alpha(byte: u8) bool {
  return (byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z')
}
pub fn ascii_is_whitespace(byte: u8) bool {
  return byte == ' ' || byte == 9 || byte == 10 || byte == 13
}
pub fn ascii_to_lower(byte: u8) u8 {
  if byte >= 'A' && byte <= 'Z' { return byte + ('a' - 'A') }
  return byte
}
pub fn ascii_to_upper(byte: u8) u8 {
  if byte >= 'a' && byte <= 'z' { return byte - ('a' - 'A') }
  return byte
}

pub fn trim(text: []const u8) []const u8 {
  start: usize = 0
  end := #len(text)
  for start < end && ascii_is_whitespace(text[start]) { start += 1 }
  for end > start && ascii_is_whitespace(text[end - 1]) { end -= 1 }
  return text[start..end]
}

fn digit_value(byte: u8) u8 {
  if byte >= '0' && byte <= '9' { return byte - '0' }
  if byte >= 'a' && byte <= 'z' { return byte - 'a' + 10 }
  if byte >= 'A' && byte <= 'Z' { return byte - 'A' + 10 }
  return 255
}

pub fn parse_u64_base(text: []const u8, base: u8, output: *u64) bool {
  if #len(text) == 0 || base < 2 || base > 36 { return false }
  value: u64 = 0
  radix := #cast(u64) base
  maximum: u64 = 18446744073709551615
  for byte in text {
    digit := digit_value(byte)
    if digit >= base { return false }
    wide := #cast(u64) digit
    if value > (maximum - wide) / radix { return false }
    value = value * radix + wide
  }
  output.* = value
  return true
}

pub fn parse_u64(text: []const u8, output: *u64) bool {
  return parse_u64_base(text, 10, output)
}

pub fn parse_i64(text: []const u8, output: *i64) bool {
  if #len(text) == 0 { return false }
  negative := text[0] == '-'
  start: usize = 0
  if negative || text[0] == '+' { start = 1 }
  if start == #len(text) { return false }
  magnitude: u64 = 0
  if !parse_u64(text[start..], &magnitude) { return false }
  if negative {
    if magnitude > 9223372036854775808 { return false }
    if magnitude == 9223372036854775808 { output.* = -9223372036854775807 - 1 }
    else { output.* = -#cast(i64) magnitude }
  } else {
    if magnitude > 9223372036854775807 { return false }
    output.* = #cast(i64) magnitude
  }
  return true
}

pub struct Scanner { text: []const u8, offset: usize }
pub fn scanner(text: []const u8) Scanner { return Scanner{ text: text, offset: 0 } }
pub fn scanner_rest(state: *const Scanner) []const u8 { return state.text[state.offset..] }

pub fn scan_until(state: *Scanner, delimiter: u8, output: *[]const u8) bool {
  if state.offset >= #len(state.text) { return false }
  start := state.offset
  found := find_byte(state.text[start..], delimiter)
  if found < 0 {
    state.offset = #len(state.text)
    output.* = state.text[start..]
  } else {
    end := start + #cast(usize) found
    output.* = state.text[start..end]
    state.offset = end + 1
  }
  return true
}

pub fn scan_field(state: *Scanner, output: *[]const u8) bool {
  for state.offset < #len(state.text) && ascii_is_whitespace(state.text[state.offset]) {
    state.offset += 1
  }
  if state.offset == #len(state.text) { return false }
  start := state.offset
  for state.offset < #len(state.text) && !ascii_is_whitespace(state.text[state.offset]) {
    state.offset += 1
  }
  output.* = state.text[start..state.offset]
  return true
}
