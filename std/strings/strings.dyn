use "std/mem" memory
use "std/bytes" byte_ops
use "std/io" io

// UTF-8 strings are immutable byte slices. Operations work on bytes unless named otherwise.

pub fn equal(left: []const u8, right: []const u8) bool {
  return byte_ops.equal(left, right)
}

// Positions: a miss returns #len(text), always a safe slice bound.
pub fn find_byte(text: []const u8, byte: u8) usize {
  return byte_ops.find_byte(text, byte)
}

pub fn find(text: []const u8, needle: []const u8) usize {
  return byte_ops.find(text, needle)
}

pub fn contains(text: []const u8, needle: []const u8) bool {
  return byte_ops.contains(text, needle)
}
pub fn starts_with(text: []const u8, prefix: []const u8) bool {
  return byte_ops.starts_with(text, prefix)
}
pub fn ends_with(text: []const u8, suffix: []const u8) bool {
  return byte_ops.ends_with(text, suffix)
}
pub fn strip_prefix(text: []const u8, prefix: []const u8) []const u8 {
  if starts_with(text, prefix) {
    return text[#len(prefix)..]
  }
  return text
}
pub fn strip_suffix(text: []const u8, suffix: []const u8) []const u8 {
  if ends_with(text, suffix) {
    return text[..#len(text) - #len(suffix)]
  }
  return text
}

pub fn ascii_is_digit(byte: u8) bool {
  return byte >= '0' && byte <= '9'
}
pub fn ascii_is_alpha(byte: u8) bool {
  return (byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z')
}
pub fn ascii_is_whitespace(byte: u8) bool {
  return byte == ' ' || byte == 9 || byte == 10 || byte == 13
}
pub fn ascii_to_lower(byte: u8) u8 {
  if byte >= 'A' && byte <= 'Z' {
    return byte + ('a' - 'A')
  }
  return byte
}
pub fn ascii_to_upper(byte: u8) u8 {
  if byte >= 'a' && byte <= 'z' {
    return byte - ('a' - 'A')
  }
  return byte
}

// Returns a borrowed view of text; no allocation or copy. Keep input storage alive and unchanged.
pub fn trim(text: []const u8) []const u8 {
  start: usize = 0
  end := #len(text)
  for start < end && ascii_is_whitespace(text[start]) {
    start += 1
  }
  for end > start && ascii_is_whitespace(text[end - 1]) {
    end -= 1
  }
  return text[start..end]
}

fn digit_value(byte: u8) u8 {
  if byte >= '0' && byte <= '9' {
    return byte - '0'
  }
  if byte >= 'a' && byte <= 'z' {
    return byte - 'a' + 10
  }
  if byte >= 'A' && byte <= 'Z' {
    return byte - 'A' + 10
  }
  return 255
}

fn parse_u64_into(text: []const u8, base: u8, output: *u64) bool {
  if #len(text) == 0 || base < 2 || base > 36 {
    return false
  }
  value: u64 = 0
  radix := #cast(u64, base)
  maximum: u64 = 18446744073709551615
  for byte in text {
    digit := digit_value(byte)
    if digit >= base {
      return false
    }
    wide := #cast(u64, digit)
    if value > (maximum - wide) / radix {
      return false
    }
    value = value * radix + wide
  }
  output.* = value
  return true
}

fn parse_i64_into(text: []const u8, base: u8, output: *i64) bool {
  if #len(text) == 0 {
    return false
  }
  negative := text[0] == '-'
  start: usize = 0
  if negative || text[0] == '+' {
    start = 1
  }
  if start == #len(text) {
    return false
  }
  magnitude: u64 = 0
  if !parse_u64_into(text[start..], base, &magnitude) {
    return false
  }
  if negative {
    if magnitude > 9223372036854775808 {
      return false
    }
    if magnitude == 9223372036854775808 {
      output.* = -9223372036854775807 - 1
    }
    else {
      output.* = -#cast(i64, magnitude)
    }
  } else {
    if magnitude > 9223372036854775807 {
      return false
    }
    output.* = #cast(i64, magnitude)
  }
  return true
}

pub struct Scanner { text: []const u8, offset: usize }
pub fn scanner(text: []const u8) Scanner {
  return Scanner{ text: text, offset: 0 }
}
pub fn scanner_rest(state: *const Scanner) []const u8 {
  return state.text[state.offset..]
}

pub struct Scanned { value: []const u8, ok: bool }

// The text up to the next delimiter, which is consumed, or the rest of the
// text. ok is false once the text is used up.
pub fn scan_until(state: *Scanner, delimiter: u8) Scanned {
  if state.offset >= #len(state.text) {
    return Scanned{}
  }
  start := state.offset
  rest := state.text[start..]
  found := find_byte(rest, delimiter)
  if found == #len(rest) {
    state.offset = #len(state.text)
  } else {
    state.offset = start + found + 1
  }
  return Scanned{ value: rest[..found], ok: true }
}

// The next run of non-whitespace bytes. ok is false when only whitespace is left.
pub fn scan_field(state: *Scanner) Scanned {
  for state.offset < #len(state.text) && ascii_is_whitespace(state.text[state.offset]) {
    state.offset += 1
  }
  if state.offset == #len(state.text) {
    return Scanned{}
  }
  start := state.offset
  for state.offset < #len(state.text) && !ascii_is_whitespace(state.text[state.offset]) {
    state.offset += 1
  }
  return Scanned{ value: state.text[start..state.offset], ok: true }
}

// Binary64 decimal conversion uses bounded integer arithmetic. Every binary64
// rounding boundary has fewer than 800 significant decimal digits, so omitted
// digits need only a sticky bit. 128 limbs cover the worst subnormal comparison.
struct DecimalInteger { limbs: [128]u32, used: usize }
fn decimal_multiply(value: *DecimalInteger, factor: u32, addition: u32) {
  carry := #cast(u64, addition)
  index: usize = 0
  for index < value.used {
    product := #cast(u64, value.limbs[index]) * #cast(u64, factor) + carry
    value.limbs[index] = #cast(u32, product)
    carry = product >> 32
    index += 1
  }
  if carry != 0 {
    value.limbs[value.used] = #cast(u32, carry)
    value.used += 1
  }
  for value.used > 0 && value.limbs[value.used - 1] == 0 {
    value.used -= 1
  }
}
fn decimal_shift(value: *DecimalInteger, bits: usize) {
  if value.used == 0 {
    return
  }
  words := bits / 32
  index := value.used
  for index > 0 {
    index -= 1
    value.limbs[index + words] = value.limbs[index]
  }
  index = 0
  for index < words {
    value.limbs[index] = 0
    index += 1
  }
  value.used += words
  factor: u32 = 1
  factor = factor << (bits % 32)
  decimal_multiply(value, factor, 0)
}
fn decimal_add(left: *DecimalInteger, right: *const DecimalInteger) {
  limit := left.used
  if right.used > limit {
    limit = right.used
  }
  index: usize = 0
  carry: u64 = 0
  for index < limit {
    item := carry
    if index < left.used {
      item += #cast(u64, left.limbs[index])
    }
    if index < right.used {
      item += #cast(u64, right.limbs[index])
    }
    left.limbs[index] = #cast(u32, item)
    carry = item >> 32
    index += 1
  }
  left.used = limit
  if carry != 0 {
    left.limbs[left.used] = #cast(u32, carry)
    left.used += 1
  }
}
// Compare numerator/denominator with mantissa * 2^exponent.
fn decimal_compare(numerator: *const DecimalInteger, denominator: *const DecimalInteger, mantissa: u64, exponent: i64) i32 {
  left := numerator.*
  right := denominator.*
  high := denominator.*
  decimal_multiply(&right, #cast(u32, mantissa), 0)
  decimal_multiply(&high, #cast(u32, (mantissa >> 32)), 0)
  decimal_shift(&high, 32)
  decimal_add(&right, &high)
  if exponent < 0 {
    decimal_shift(&left, #cast(usize, -exponent))
  }
  else {
    decimal_shift(&right, #cast(usize, exponent))
  }
  if left.used < right.used {
    return -1
  }
  if left.used > right.used {
    return 1
  }
  index := left.used
  for index > 0 {
    index -= 1
    if left.limbs[index] < right.limbs[index] {
      return -1
    }
    if left.limbs[index] > right.limbs[index] {
      return 1
    }
  }
  return 0
}
fn decimal_compare_bits(numerator: *const DecimalInteger, denominator: *const DecimalInteger, bits: u64, midpoint: bool) i32 {
  exponent := #cast(i64, (bits >> 52))
  mantissa := bits & 4503599627370495
  if exponent == 0 {
    exponent = -1074
  }
  else {
    mantissa += 4503599627370496
    exponent -= 1075
  }
  if midpoint {
    mantissa = mantissa * 2 + 1
    exponent -= 1
  }
  return decimal_compare(numerator, denominator, mantissa, exponent)
}

// Decimal syntax, rounded to binary64 with round-to-nearest/ties-to-even.
// Overflow yields signed infinity; underflow preserves signed zero. Invalid
// syntax leaves output unchanged. No heap allocations or locale dependence.
// Reached through parse(f64, text).
fn parse_f64_into(text: []const u8, output: *f64) bool {
  if #len(text) == 0 || #cast(u64, #len(text)) > 9223372036854765807 {
    return false
  }
  at: usize = 0
  negative := text[0] == '-'
  if negative || text[0] == '+' {
    at += 1
  }
  if at == #len(text) {
    return false
  }
  numerator := DecimalInteger{}
  significant: usize = 0
  digits: usize = 0
  shift: i64 = 0
  sticky := false
  fraction := false
  for at < #len(text) {
    byte := text[at]
    if byte == '.' && !fraction {
      fraction = true
      at += 1
    }
    else if ascii_is_digit(byte) {
      digits += 1
      if fraction {
        shift -= 1
      }
      if significant < 800 {
        decimal_multiply(&numerator, 10, #cast(u32, (byte - '0')))
        if byte != '0' || significant > 0 {
          significant += 1
        }
      } else {
        shift += 1
        if byte != '0' {
          sticky = true
        }
      }
      at += 1
    } else {
      break
    }
  }
  if digits == 0 {
    return false
  }
  exponent: i64 = 0
  exponent_negative := false
  if at < #len(text) && (text[at] == 'e' || text[at] == 'E') {
    at += 1
    if at < #len(text) && (text[at] == '-' || text[at] == '+') {
      exponent_negative = text[at] == '-'
      at += 1
    }
    start := at
    cap := #cast(i64, #len(text)) + 10000
    for at < #len(text) && ascii_is_digit(text[at]) {
      digit := #cast(i64, (text[at] - '0'))
      if exponent <= (cap - digit) / 10 {
        exponent = exponent * 10 + digit
      }
      else {
        exponent = cap
      }
      at += 1
    }
    if at == start {
      return false
    }
  }
  if at != #len(text) {
    return false
  }
  bits: u64 = 0
  if numerator.used != 0 {
    if exponent_negative {
      if shift < exponent - 2000 {
        shift = -2000
      }
      else {
        shift -= exponent
      }
    } else {
      if shift > 2000 - exponent {
        shift = 2000
      }
      else {
        shift += exponent
      }
    }
    order := shift + #cast(i64, significant)
    if order > 309 {
      bits = 9218868437227405312
    }
    else if order >= -323 {
      denominator := DecimalInteger{}
      decimal_multiply(&denominator, 1, 1)
      for shift > 0 {
        decimal_multiply(&numerator, 10, 0)
        shift -= 1
      }
      for shift < 0 {
        decimal_multiply(&denominator, 10, 0)
        shift += 1
      }
      low: u64 = 0
      high: u64 = 9218868437227405311
      for low < high {
        middle := low + (high - low) / 2 + 1
        if decimal_compare_bits(&numerator, &denominator, middle, false) >= 0 {
          low = middle
        }
        else {
          high = middle - 1
        }
      }
      comparison := decimal_compare_bits(&numerator, &denominator, low, true)
      bits = low
      if comparison > 0 || (comparison == 0 && (sticky || (low & 1) != 0)) {
        bits += 1
      }
    }
  }
  if negative {
    bits = bits | 9223372036854775808
  }
  output.* = #bitcast(f64, bits)
  return true
}

pub fn trim_left(text: []const u8) []const u8 {
  at: usize = 0
  for at < #len(text) && ascii_is_whitespace(text[at]) {
    at += 1
  }
  return text[at..]
}
pub fn trim_right(text: []const u8) []const u8 {
  end := #len(text)
  for end > 0 && ascii_is_whitespace(text[end - 1]) {
    end -= 1
  }
  return text[..end]
}
pub fn find_last_byte(text: []const u8, byte: u8) usize {
  return byte_ops.find_last_byte(text, byte)
}
pub fn find_last(text: []const u8, needle: []const u8) usize {
  return byte_ops.find_last(text, needle)
}
// The next line without its \n or \r\n. ok is false at the end of the text.
pub fn scan_line(state: *Scanner) Scanned {
  line := scan_until(state, 10)
  line.value = strip_suffix(line.value, "\r")
  return line
}

// Parses text as T: an integer type, f32, f64 or bool ("true" or "false").
// Integers accept an optional sign; floats use decimal syntax. Returns zero
// when text is not a valid T or does not fit. Use valid first when bad input
// must be reported. Another T panics.
pub fn parse($T: type, text: []const u8) T {
  result: T
  _ = parse_into(text, 10, &result)
  return result
}

// Like parse for integer types, in base 2 through 36.
pub fn parse_base($T: type, text: []const u8, base: u8) T {
  result: T
  _ = parse_into(text, base, &result)
  return result
}

// Whether text parses as T, by the same rules as parse.
pub fn valid($T: type, text: []const u8) bool {
  result: T
  return parse_into(text, 10, &result)
}

fn signed_into(text: []const u8, base: u8, minimum: i64, maximum: i64, output: *i64) bool {
  value: i64
  if !parse_i64_into(text, base, &value) || value < minimum || value > maximum {
    return false
  }
  output.* = value
  return true
}

fn unsigned_into(text: []const u8, base: u8, maximum: u64, output: *u64) bool {
  value: u64
  if #len(text) > 0 && text[0] == '+' {
    if !parse_u64_into(text[1..], base, &value) {
      return false
    }
  } else if !parse_u64_into(text, base, &value) {
    return false
  }
  if value > maximum {
    return false
  }
  output.* = value
  return true
}

fn parse_into(text: []const u8, base: u8, target: any) bool {
  wide: i64
  natural: u64
  case target {
    is *i8 p => {
      ok := signed_into(text, base, -128, 127, &wide)
      p.* = #cast(i8, wide)
      return ok
    },
    is *i16 p => {
      ok := signed_into(text, base, -32768, 32767, &wide)
      p.* = #cast(i16, wide)
      return ok
    },
    is *i32 p => {
      ok := signed_into(text, base, -2147483648, 2147483647, &wide)
      p.* = #cast(i32, wide)
      return ok
    },
    is *i64 p => {
      return parse_i64_into(text, base, p)
    },
    is *isize p => {
      ok := parse_i64_into(text, base, &wide)
      if !ok || wide < #cast(i64, isize_minimum()) || wide > #cast(i64, isize_maximum()) {
        return false
      }
      p.* = #cast(isize, wide)
      return true
    },
    is *u8 p => {
      ok := unsigned_into(text, base, 255, &natural)
      p.* = #cast(u8, natural)
      return ok
    },
    is *u16 p => {
      ok := unsigned_into(text, base, 65535, &natural)
      p.* = #cast(u16, natural)
      return ok
    },
    is *u32 p => {
      ok := unsigned_into(text, base, 4294967295, &natural)
      p.* = #cast(u32, natural)
      return ok
    },
    is *u64 p => {
      return unsigned_into(text, base, 18446744073709551615, p)
    },
    is *usize p => {
      ok := unsigned_into(text, base, #cast(u64, usize_maximum()), &natural)
      p.* = #cast(usize, natural)
      return ok
    },
    is *f64 p => {
      return base == 10 && parse_f64_into(text, p)
    },
    is *f32 p => {
      value: f64
      if base != 10 || !parse_f64_into(text, &value) {
        return false
      }
      p.* = #cast(f32, value)
      return true
    },
    is *bool p => {
      if equal(text, "true") {
        p.* = true
        return true
      }
      return equal(text, "false")
    },
    _ => {
      #panic("strings.parse: unsupported type")
    },
  }
}

fn usize_maximum() usize {
  return ~#cast(usize, 0)
}
fn isize_maximum() isize {
  return #cast(isize, usize_maximum() / 2)
}
fn isize_minimum() isize {
  return -isize_maximum() - 1
}

pub enum ErrorKind { None, InvalidInput, Capacity, Overflow, Overlap }
pub struct Result { value: []u8, error: ErrorKind, required: usize, ok: bool }
pub struct SplitResult { values: [][]const u8, error: ErrorKind, required: usize, ok: bool }
pub struct SizeResult { value: usize, error: ErrorKind, ok: bool }

// Exact-capacity copies support overlap; failure leaves destination unchanged.
// Copies into caller destination. Successful value borrows destination, not source. Inspect Result.ok.
// Ownership: copies bytes; returned view borrows destination.
// Invalidation: destination mutation or destruction.
// Allocation: none.
// Failure: destination is unchanged; required reports the source length.
pub fn clone_into(destination: []u8, source: []const u8) Result {
  if #len(destination) < #len(source) {
    return Result{ error: ErrorKind.Capacity, required: #len(source) }
  }
  _ = memory.move(destination, source)
  return Result{ value: destination[..#len(source)], required: #len(source), ok: true }
}
// Copies source into arena. The copy expires at the applicable rewind, reset or release.
pub fn clone(arena: *memory.Arena, source: []const u8) []u8 {
  output := memory.push_bytes_uninit(arena, #len(source))
  _ = memory.copy(output, source)
  return output
}

pub fn join_size(parts: [][]const u8, separator: []const u8) SizeResult {
  total: usize = 0
  maximum := #cast(usize, -1)
  for i in 0..#len(parts) {
    if #len(parts[i]) > maximum - total {
      return SizeResult{ error: ErrorKind.Overflow }
    }
    total += #len(parts[i])
    if i > 0 {
      if #len(separator) > maximum - total {
        return SizeResult{ error: ErrorKind.Overflow }
      }
      total += #len(separator)
    }
  }
  return SizeResult{ value: total, ok: true }
}
// Output must not overlap any input bytes. Failure writes nothing.
pub fn join_into(destination: []u8, parts: [][]const u8, separator: []const u8) Result {
  size := join_size(parts, separator)
  if !size.ok {
    return Result{ error: size.error }
  }
  if size.value > #len(destination) {
    return Result{ error: ErrorKind.Capacity, required: size.value }
  }
  output := destination[..size.value]
  if byte_ops.overlaps(output, separator) {
    return Result{ error: ErrorKind.Overlap, required: size.value }
  }
  for part in parts {
    if byte_ops.overlaps(output, part) {
      return Result{ error: ErrorKind.Overlap, required: size.value }
    }
  }
  at: usize = 0
  for i in 0..#len(parts) {
    if i > 0 {
      at += memory.copy(output[at..], separator)
    }
    at += memory.copy(output[at..], parts[i])
  }
  return Result{ value: output, required: size.value, ok: true }
}
// Joins parts into arena. Panics when the total size overflows.
pub fn join(arena: *memory.Arena, parts: [][]const u8, separator: []const u8) []u8 {
  size := join_size(parts, separator)
  if !size.ok {
    #panic("join size overflows")
  }
  output := memory.push_bytes_uninit(arena, size.value)
  at: usize = 0
  for i in 0..#len(parts) {
    if i > 0 {
      at += memory.copy(output[at..], separator)
    }
    at += memory.copy(output[at..], parts[i])
  }
  return output
}

pub fn split_count(source: []const u8, separator: []const u8) SizeResult {
  if #len(separator) == 0 {
    return SizeResult{ error: ErrorKind.InvalidInput }
  }
  count: usize = 1
  at: usize = 0
  for {
    rest := source[at..]
    found := find(rest, separator)
    if found == #len(rest) {
      break
    }
    if count == #cast(usize, -1) {
      return SizeResult{ error: ErrorKind.Overflow }
    }
    count += 1
    at += found + #len(separator)
  }
  return SizeResult{ value: count, ok: true }
}
// Slice table and input bytes must occupy separate storage. Elements borrow source.
// Empty fields, including the last, are retained. Failure changes no entries.
// Writes views into caller slice-table storage. Elements still borrow source bytes; keep BOTH alive.
pub fn split_into(storage: [][]const u8, source: []const u8, separator: []const u8) SplitResult {
  count := split_count(source, separator)
  if !count.ok {
    return SplitResult{ error: count.error }
  }
  if count.value > #len(storage) {
    return SplitResult{ error: ErrorKind.Capacity, required: count.value }
  }
  at: usize = 0
  i: usize = 0
  for i + 1 < count.value {
    end := at + find(source[at..], separator)
    storage[i] = source[at..end]
    at = end + #len(separator)
    i += 1
  }
  storage[i] = source[at..]
  return SplitResult{ values: storage[..count.value], required: count.value, ok: true }
}
// Splits source on separator. Only the slice table lives in arena; elements
// borrow source, so keep both alive. Empty fields, including the last, are kept.
// Panics when separator is empty.
pub fn split(arena: *memory.Arena, source: []const u8, separator: []const u8) [][]const u8 {
  count := split_count(source, separator)
  if !count.ok {
    #panic("split separator is empty")
  }
  values := memory.push_array([]const u8, arena, count.value)
  _ = split_into(values, source, separator)
  return values
}
// Caller storage must not overlap source. Capacity failure leaves it unchanged.
pub fn replace(destination: []u8, source: []const u8, needle: []const u8, replacement: []const u8) Result {
  if #len(needle) == 0 {
    return Result{ error: ErrorKind.InvalidInput }
  }
  total := #len(source)
  at: usize = 0
  maximum := #cast(usize, -1)
  for {
    rest := source[at..]
    found := find(rest, needle)
    if found == #len(rest) {
      break
    }
    total -= #len(needle)
    if #len(replacement) > maximum - total {
      return Result{ error: ErrorKind.Overflow }
    }
    total += #len(replacement)
    at += found + #len(needle)
  }
  if total > #len(destination) {
    return Result{ error: ErrorKind.Capacity, required: total }
  }
  if byte_ops.overlaps(destination[..total], source) || byte_ops.overlaps(destination[..total], needle) || byte_ops.overlaps(destination[..total], replacement) {
    return Result{ error: ErrorKind.Overlap, required: total }
  }
  at = 0
  written: usize = 0
  for {
    rest := source[at..]
    next := find(rest, needle)
    if next == #len(rest) {
      break
    }
    end := at + next
    written += memory.copy(destination[written..], source[at..end])
    written += memory.copy(destination[written..], replacement)
    at = end + #len(needle)
  }
  written += memory.copy(destination[written..], source[at..])
  return Result{ value: destination[..written], required: total, ok: true }
}

// Byte wildcard matching: * matches any sequence, ? one byte, backslash escapes.
// Uses constant memory and no recursive backtracking.
pub fn glob_match(pattern: []const u8, text: []const u8) bool {
  p: usize = 0
  t: usize = 0
  star := #len(pattern)
  retry: usize = 0
  for t < #len(text) {
    if p < #len(pattern) && pattern[p] == '*' {
      star = p
      p += 1
      retry = t
    } else {
      next := p
      matched := false
      if next < #len(pattern) {
        if pattern[next] == '\\' {
          next += 1
          if next < #len(pattern) {
            matched = pattern[next] == text[t]
            next += 1
          }
        } else {
          matched = pattern[next] == '?' || pattern[next] == text[t]
          next += 1
        }
      }
      if matched {
        p = next
        t += 1
      }
      else if star < #len(pattern) {
        retry += 1
        t = retry
        p = star + 1
      }
      else {
        return false
      }
    }
  }
  for p < #len(pattern) && pattern[p] == '*' {
    p += 1
  }
  return p == #len(pattern)
}

fn count_write(data: rawptr, source: []const u8) io.Result {
  total := #cast(*usize, data)
  total.* += #len(source)
  return io.Result{ transferred: #len(source), status: io.Status.Complete }
}

// Formats into arena using the io.print template language: {} inserts a value,
// {{ and }} write literal braces. Allocates exactly the formatted length.
// Panics on a bad template or argument count.
pub fn format_arguments(arena: *memory.Arena, template: []const u8, arguments: []const any) []u8 {
  size: usize = 0
  counted := io.print_arguments(io.Writer{ data: &size, write: &count_write }, template, arguments)
  if counted.status == io.Status.Error {
    #panic("format template does not match its arguments")
  }
  output := memory.push_bytes_uninit(arena, size)
  buffer := io.buffer_writer(output)
  _ = io.print_arguments(io.buffer_writer_adapter(&buffer), template, arguments)
  return output
}

pub fn format(arena: *memory.Arena, template: []const u8, arguments: ...any) []u8 {
  return format_arguments(arena, template, arguments)
}

// Singly linked list of string views whose nodes live in an arena. Pushing
// never copies the bytes; use list_push_format or clone for owned text.
pub struct ListNode {
  next: *ListNode,
  value: []const u8,
}
pub struct List {
  first: *ListNode,
  last: *ListNode,
  count: usize,
  total: usize,
}

// Pushes one node; value is not copied.
pub fn list_push(arena: *memory.Arena, list: *List, value: []const u8) {
  node := memory.push(ListNode, arena)
  node.value = value
  if list.last == nil {
    list.first = node
  } else {
    list.last.next = node
  }
  list.last = node
  list.count += 1
  list.total += #len(value)
}

// Formats into arena, then pushes the result.
pub fn list_push_format(arena: *memory.Arena, list: *List, template: []const u8, arguments: ...any) {
  list_push(arena, list, format_arguments(arena, template, arguments))
}

// Joins every node into one arena allocation.
pub fn list_join(arena: *memory.Arena, list: *const List, separator: []const u8) []u8 {
  size := list.total
  if list.count > 1 {
    size += (list.count - 1) * #len(separator)
  }
  output := memory.push_bytes_uninit(arena, size)
  at: usize = 0
  node := list.first
  for node != nil {
    if node != list.first {
      at += memory.copy(output[at..], separator)
    }
    at += memory.copy(output[at..], node.value)
    node = node.next
  }
  return output
}
