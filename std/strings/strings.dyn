use "std/mem" memory
use "std/bytes" byte_ops

// UTF-8 strings are immutable byte slices. Operations work on bytes unless named otherwise.

pub fn equal(left: []const u8, right: []const u8) bool { return byte_ops.equal(left, right) }

pub fn find_byte(text: []const u8, byte: u8) isize { return byte_ops.find_byte(text, byte) }

pub fn find(text: []const u8, needle: []const u8) isize { return byte_ops.find(text, needle) }

pub fn contains(text: []const u8, needle: []const u8) bool { return byte_ops.contains(text, needle) }
pub fn starts_with(text: []const u8, prefix: []const u8) bool { return byte_ops.starts_with(text, prefix) }
pub fn ends_with(text: []const u8, suffix: []const u8) bool { return byte_ops.ends_with(text, suffix) }
pub fn strip_prefix(text: []const u8, prefix: []const u8) []const u8 {
  if starts_with(text, prefix) { return text[#len(prefix)..] }
  return text
}
pub fn strip_suffix(text: []const u8, suffix: []const u8) []const u8 {
  if ends_with(text, suffix) { return text[..#len(text) - #len(suffix)] }
  return text
}

pub fn ascii_is_digit(byte: u8) bool { return byte >= '0' && byte <= '9' }
pub fn ascii_is_alpha(byte: u8) bool {
  return (byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z')
}
pub fn ascii_is_whitespace(byte: u8) bool {
  return byte == ' ' || byte == 9 || byte == 10 || byte == 13
}
pub fn ascii_to_lower(byte: u8) u8 {
  if byte >= 'A' && byte <= 'Z' { return byte + ('a' - 'A') }
  return byte
}
pub fn ascii_to_upper(byte: u8) u8 {
  if byte >= 'a' && byte <= 'z' { return byte - ('a' - 'A') }
  return byte
}

// Returns a borrowed view of text; no allocation or copy. Keep input storage alive and unchanged.
pub fn trim(text: []const u8) []const u8 {
  start: usize = 0
  end := #len(text)
  for start < end && ascii_is_whitespace(text[start]) { start += 1 }
  for end > start && ascii_is_whitespace(text[end - 1]) { end -= 1 }
  return text[start..end]
}

fn digit_value(byte: u8) u8 {
  if byte >= '0' && byte <= '9' { return byte - '0' }
  if byte >= 'a' && byte <= 'z' { return byte - 'a' + 10 }
  if byte >= 'A' && byte <= 'Z' { return byte - 'A' + 10 }
  return 255
}

pub fn parse_u64_base(text: []const u8, base: u8, output: *u64) bool {
  if #len(text) == 0 || base < 2 || base > 36 { return false }
  value: u64 = 0
  radix := #cast(u64) base
  maximum: u64 = 18446744073709551615
  for byte in text {
    digit := digit_value(byte)
    if digit >= base { return false }
    wide := #cast(u64) digit
    if value > (maximum - wide) / radix { return false }
    value = value * radix + wide
  }
  output.* = value
  return true
}

pub fn parse_u64(text: []const u8, output: *u64) bool {
  return parse_u64_base(text, 10, output)
}

pub fn parse_i64(text: []const u8, output: *i64) bool {
  if #len(text) == 0 { return false }
  negative := text[0] == '-'
  start: usize = 0
  if negative || text[0] == '+' { start = 1 }
  if start == #len(text) { return false }
  magnitude: u64 = 0
  if !parse_u64(text[start..], &magnitude) { return false }
  if negative {
    if magnitude > 9223372036854775808 { return false }
    if magnitude == 9223372036854775808 { output.* = -9223372036854775807 - 1 }
    else { output.* = -#cast(i64) magnitude }
  } else {
    if magnitude > 9223372036854775807 { return false }
    output.* = #cast(i64) magnitude
  }
  return true
}

pub struct Scanner { text: []const u8, offset: usize }
pub fn scanner(text: []const u8) Scanner { return Scanner{ text: text, offset: 0 } }
pub fn scanner_rest(state: *const Scanner) []const u8 { return state.text[state.offset..] }

pub fn scan_until(state: *Scanner, delimiter: u8, output: *[]const u8) bool {
  if state.offset >= #len(state.text) { return false }
  start := state.offset
  found := find_byte(state.text[start..], delimiter)
  if found < 0 {
    state.offset = #len(state.text)
    output.* = state.text[start..]
  } else {
    end := start + #cast(usize) found
    output.* = state.text[start..end]
    state.offset = end + 1
  }
  return true
}

pub fn scan_field(state: *Scanner, output: *[]const u8) bool {
  for state.offset < #len(state.text) && ascii_is_whitespace(state.text[state.offset]) {
    state.offset += 1
  }
  if state.offset == #len(state.text) { return false }
  start := state.offset
  for state.offset < #len(state.text) && !ascii_is_whitespace(state.text[state.offset]) {
    state.offset += 1
  }
  output.* = state.text[start..state.offset]
  return true
}

// Binary64 decimal conversion uses bounded integer arithmetic. Every binary64
// rounding boundary has fewer than 800 significant decimal digits, so omitted
// digits need only a sticky bit. 128 limbs cover the worst subnormal comparison.
struct DecimalInteger { limbs: [128]u32, used: usize }
fn decimal_multiply(value: *DecimalInteger, factor: u32, addition: u32) {
  carry := #cast(u64) addition
  index: usize = 0
  for index < value.used {
    product := #cast(u64) value.limbs[index] * #cast(u64) factor + carry
    value.limbs[index] = #cast(u32) product
    carry = product >> 32
    index += 1
  }
  if carry != 0 { value.limbs[value.used] = #cast(u32) carry value.used += 1 }
  for value.used > 0 && value.limbs[value.used - 1] == 0 { value.used -= 1 }
}
fn decimal_shift(value: *DecimalInteger, bits: usize) {
  if value.used == 0 { return }
  words := bits / 32
  index := value.used
  for index > 0 { index -= 1 value.limbs[index + words] = value.limbs[index] }
  index = 0
  for index < words { value.limbs[index] = 0 index += 1 }
  value.used += words
  factor: u32 = 1
  factor = factor << (bits % 32)
  decimal_multiply(value, factor, 0)
}
fn decimal_add(left: *DecimalInteger, right: *const DecimalInteger) {
  limit := left.used
  if right.used > limit { limit = right.used }
  index: usize = 0
  carry: u64 = 0
  for index < limit {
    item := carry
    if index < left.used { item += #cast(u64) left.limbs[index] }
    if index < right.used { item += #cast(u64) right.limbs[index] }
    left.limbs[index] = #cast(u32) item
    carry = item >> 32
    index += 1
  }
  left.used = limit
  if carry != 0 { left.limbs[left.used] = #cast(u32) carry left.used += 1 }
}
// Compare numerator/denominator with mantissa * 2^exponent.
fn decimal_compare(numerator: *const DecimalInteger, denominator: *const DecimalInteger, mantissa: u64, exponent: i64) i32 {
  left := numerator.*
  right := denominator.*
  high := denominator.*
  decimal_multiply(&right, #cast(u32) mantissa, 0)
  decimal_multiply(&high, #cast(u32) (mantissa >> 32), 0)
  decimal_shift(&high, 32)
  decimal_add(&right, &high)
  if exponent < 0 { decimal_shift(&left, #cast(usize) -exponent) }
  else { decimal_shift(&right, #cast(usize) exponent) }
  if left.used < right.used { return -1 }
  if left.used > right.used { return 1 }
  index := left.used
  for index > 0 {
    index -= 1
    if left.limbs[index] < right.limbs[index] { return -1 }
    if left.limbs[index] > right.limbs[index] { return 1 }
  }
  return 0
}
fn decimal_compare_bits(numerator: *const DecimalInteger, denominator: *const DecimalInteger, bits: u64, midpoint: bool) i32 {
  exponent := #cast(i64) (bits >> 52)
  mantissa := bits & 4503599627370495
  if exponent == 0 { exponent = -1074 }
  else { mantissa += 4503599627370496 exponent -= 1075 }
  if midpoint { mantissa = mantissa * 2 + 1 exponent -= 1 }
  return decimal_compare(numerator, denominator, mantissa, exponent)
}

// Decimal syntax, rounded to binary64 with round-to-nearest/ties-to-even.
// Overflow yields signed infinity; underflow preserves signed zero. Invalid
// syntax leaves output unchanged. No heap allocations or locale dependence.
pub fn parse_f64(text: []const u8, output: *f64) bool {
  if #len(text) == 0 || #len(text) > 9223372036854765807 { return false }
  at: usize = 0
  negative := text[0] == '-'
  if negative || text[0] == '+' { at += 1 }
  if at == #len(text) { return false }
  numerator := DecimalInteger{}
  significant: usize = 0
  digits: usize = 0
  shift: i64 = 0
  sticky := false
  fraction := false
  for at < #len(text) {
    byte := text[at]
    if byte == '.' && !fraction { fraction = true at += 1 }
    else if ascii_is_digit(byte) {
      digits += 1
      if fraction { shift -= 1 }
      if significant < 800 {
        decimal_multiply(&numerator, 10, #cast(u32) (byte - '0'))
        if byte != '0' || significant > 0 { significant += 1 }
      } else {
        shift += 1
        if byte != '0' { sticky = true }
      }
      at += 1
    } else { break }
  }
  if digits == 0 { return false }
  exponent: i64 = 0
  exponent_negative := false
  if at < #len(text) && (text[at] == 'e' || text[at] == 'E') {
    at += 1
    if at < #len(text) && (text[at] == '-' || text[at] == '+') {
      exponent_negative = text[at] == '-' at += 1
    }
    start := at
    cap := #cast(i64) #len(text) + 10000
    for at < #len(text) && ascii_is_digit(text[at]) {
      digit := #cast(i64) (text[at] - '0')
      if exponent <= (cap - digit) / 10 { exponent = exponent * 10 + digit }
      else { exponent = cap }
      at += 1
    }
    if at == start { return false }
  }
  if at != #len(text) { return false }
  bits: u64 = 0
  if numerator.used != 0 {
    if exponent_negative {
      if shift < exponent - 2000 { shift = -2000 }
      else { shift -= exponent }
    } else {
      if shift > 2000 - exponent { shift = 2000 }
      else { shift += exponent }
    }
    order := shift + #cast(i64) significant
    if order > 309 { bits = 9218868437227405312 }
    else if order >= -323 {
      denominator := DecimalInteger{}
      decimal_multiply(&denominator, 1, 1)
      for shift > 0 { decimal_multiply(&numerator, 10, 0) shift -= 1 }
      for shift < 0 { decimal_multiply(&denominator, 10, 0) shift += 1 }
      low: u64 = 0
      high: u64 = 9218868437227405311
      for low < high {
        middle := low + (high - low) / 2 + 1
        if decimal_compare_bits(&numerator, &denominator, middle, false) >= 0 { low = middle }
        else { high = middle - 1 }
      }
      comparison := decimal_compare_bits(&numerator, &denominator, low, true)
      bits = low
      if comparison > 0 || (comparison == 0 && (sticky || (low & 1) != 0)) { bits += 1 }
    }
  }
  if negative { bits = bits | 9223372036854775808 }
  output.* = #bitcast(f64) bits
  return true
}

pub fn trim_left(text: []const u8) []const u8 {
  at: usize = 0
  for at < #len(text) && ascii_is_whitespace(text[at]) { at += 1 }
  return text[at..]
}
pub fn trim_right(text: []const u8) []const u8 {
  end := #len(text)
  for end > 0 && ascii_is_whitespace(text[end - 1]) { end -= 1 }
  return text[..end]
}
pub fn find_last_byte(text: []const u8, byte: u8) isize { return byte_ops.find_last_byte(text, byte) }
pub fn find_last(text: []const u8, needle: []const u8) isize { return byte_ops.find_last(text, needle) }
pub fn scan_line(state: *Scanner, output: *[]const u8) bool {
  if !scan_until(state, 10, output) { return false }
  output.* = strip_suffix(output.*, "\r")
  return true
}

pub enum ErrorKind { None, InvalidInput, Capacity, Overflow, Overlap }
pub struct Result { value: []u8, error: ErrorKind, required: usize, ok: bool }
pub struct SplitResult { values: [][]const u8, error: ErrorKind, required: usize, ok: bool }
pub struct SizeResult { value: usize, error: ErrorKind, ok: bool }

// Exact-capacity copies support overlap; failure leaves destination unchanged.
// Copies into caller destination. Successful value borrows destination, not source. Inspect Result.ok.
pub fn clone_into(destination: []u8, source: []const u8) Result {
  if #len(destination) < #len(source) { return Result{ error: ErrorKind.Capacity, required: #len(source) } }
  _ = memory.move(destination, source)
  return Result{ value: destination[..#len(source)], required: #len(source), ok: true }
}
// Copies bytes into arena. Result expires at applicable rewind/reset/release; input need not outlive it.
pub fn clone(arena: *memory.Arena, source: []const u8) Result {
  if #len(source) == 0 { return Result{ value: arena.data[..0], ok: true } }
  allocated := memory.arena_try_push_uninit(arena, #len(source), 1)
  if !allocated.ok { return Result{ error: ErrorKind.Capacity, required: #len(source) } }
  return clone_into(allocated.memory[..#len(source)], source)
}
pub fn join_size(parts: [][]const u8, separator: []const u8) SizeResult {
  total: usize = 0 maximum := #cast(usize) -1
  i: usize = 0
  for i < #len(parts) {
    if #len(parts[i]) > maximum - total { return SizeResult{ error: ErrorKind.Overflow } }
    total += #len(parts[i])
    if i > 0 {
      if #len(separator) > maximum - total { return SizeResult{ error: ErrorKind.Overflow } }
      total += #len(separator)
    }
    i += 1
  }
  return SizeResult{ value: total, ok: true }
}
// Output must not overlap any input bytes. Failure writes nothing.
pub fn join_into(destination: []u8, parts: [][]const u8, separator: []const u8) Result {
  size := join_size(parts, separator)
  if !size.ok { return Result{ error: size.error } }
  if size.value > #len(destination) { return Result{ error: ErrorKind.Capacity, required: size.value } }
  output := destination[..size.value]
  if byte_ops.overlaps(output, separator) { return Result{ error: ErrorKind.Overlap, required: size.value } }
  for part in parts { if byte_ops.overlaps(output, part) { return Result{ error: ErrorKind.Overlap, required: size.value } } }
  at: usize = 0 i: usize = 0
  for i < #len(parts) {
    if i > 0 { at += memory.copy(output[at..], separator) }
    at += memory.copy(output[at..], parts[i]) i += 1
  }
  return Result{ value: output, required: size.value, ok: true }
}
pub fn join(arena: *memory.Arena, parts: [][]const u8, separator: []const u8) Result {
  size := join_size(parts, separator)
  if !size.ok { return Result{ error: size.error } }
  mark := memory.arena_mark(arena)
  allocated := memory.arena_try_push_uninit(arena, size.value, 1)
  if !allocated.ok { return Result{ error: ErrorKind.Capacity, required: size.value } }
  storage := arena.data[..0]
  if size.value > 0 { storage = allocated.memory[..size.value] }
  result := join_into(storage, parts, separator)
  if !result.ok { memory.arena_rewind(arena, mark) }
  return result
}
pub fn split_count(source: []const u8, separator: []const u8) SizeResult {
  if #len(separator) == 0 { return SizeResult{ error: ErrorKind.InvalidInput } }
  count: usize = 1 at: usize = 0
  for {
    found := find(source[at..], separator)
    if found < 0 { break }
    if count == #cast(usize) -1 { return SizeResult{ error: ErrorKind.Overflow } }
    count += 1 at += #cast(usize) found + #len(separator)
  }
  return SizeResult{ value: count, ok: true }
}
// Slice table and input bytes must occupy separate storage. Elements borrow source.
// Empty fields, including the last, are retained. Failure changes no entries.
// Writes views into caller slice-table storage. Elements still borrow source bytes; keep BOTH alive.
pub fn split_into(storage: [][]const u8, source: []const u8, separator: []const u8) SplitResult {
  count := split_count(source, separator)
  if !count.ok { return SplitResult{ error: count.error } }
  if count.value > #len(storage) { return SplitResult{ error: ErrorKind.Capacity, required: count.value } }
  at: usize = 0 i: usize = 0
  for i + 1 < count.value {
    next := find(source[at..], separator)
    end := at + #cast(usize) next
    storage[i] = source[at..end]
    at = end + #len(separator) i += 1
  }
  storage[i] = source[at..]
  return SplitResult{ values: storage[..count.value], required: count.value, ok: true }
}
// Allocates only the slice table in arena. Elements borrow source bytes; keep BOTH alive.
// Arena rewind/reset/release expires the table. This is not a deep copy of source.
pub fn split(arena: *memory.Arena, source: []const u8, separator: []const u8) SplitResult {
  count := split_count(source, separator)
  if !count.ok { return SplitResult{ error: count.error } }
  maximum := #cast(usize) -1
  if count.value > maximum / #sizeof([]const u8) { return SplitResult{ error: ErrorKind.Overflow } }
  mark := memory.arena_mark(arena)
  allocated := memory.arena_try_push_uninit(arena, count.value * #sizeof([]const u8), #alignof([]const u8))
  if !allocated.ok { return SplitResult{ error: ErrorKind.Capacity, required: count.value } }
  values := (#cast(*[]const u8) allocated.memory)[..count.value]
  result := split_into(values, source, separator)
  if !result.ok { memory.arena_rewind(arena, mark) }
  return result
}
// Caller storage must not overlap source. Capacity failure leaves it unchanged.
pub fn replace(destination: []u8, source: []const u8, needle: []const u8, replacement: []const u8) Result {
  if #len(needle) == 0 { return Result{ error: ErrorKind.InvalidInput } }
  total := #len(source)
  at: usize = 0
  maximum := #cast(usize) -1
  for {
    found := find(source[at..], needle)
    if found < 0 { break }
    total -= #len(needle)
    if #len(replacement) > maximum - total { return Result{ error: ErrorKind.Overflow } }
    total += #len(replacement)
    at += #cast(usize) found + #len(needle)
  }
  if total > #len(destination) { return Result{ error: ErrorKind.Capacity, required: total } }
  if byte_ops.overlaps(destination[..total], source) || byte_ops.overlaps(destination[..total], needle) || byte_ops.overlaps(destination[..total], replacement) {
    return Result{ error: ErrorKind.Overlap, required: total }
  }
  at = 0
  written: usize = 0
  for {
    next := find(source[at..], needle)
    if next < 0 { break }
    end := at + #cast(usize) next
    written += memory.copy(destination[written..], source[at..end])
    written += memory.copy(destination[written..], replacement)
    at = end + #len(needle)
  }
  written += memory.copy(destination[written..], source[at..])
  return Result{ value: destination[..written], required: total, ok: true }
}

// Byte wildcard matching: * matches any sequence, ? one byte, backslash escapes.
// Uses constant memory and no recursive backtracking.
pub fn glob_match(pattern: []const u8, text: []const u8) bool {
  p: usize = 0 t: usize = 0
  star := #len(pattern)
  retry: usize = 0
  for t < #len(text) {
    if p < #len(pattern) && pattern[p] == '*' {
      star = p p += 1 retry = t
    } else {
      next := p
      matched := false
      if next < #len(pattern) {
        if pattern[next] == '\\' {
          next += 1
          if next < #len(pattern) { matched = pattern[next] == text[t] next += 1 }
        } else { matched = pattern[next] == '?' || pattern[next] == text[t] next += 1 }
      }
      if matched { p = next t += 1 }
      else if star < #len(pattern) { retry += 1 t = retry p = star + 1 }
      else { return false }
    }
  }
  for p < #len(pattern) && pattern[p] == '*' { p += 1 }
  return p == #len(pattern)
}
