use stream "std/io"

pub enum Level { Debug, Info, Warning, Error }
pub struct Field { name: []const u8, value: []const u8 }
pub struct Logger { output: stream.Writer, minimum: Level }
pub fn logger(output: stream.Writer, minimum: Level) Logger {
  return Logger{ output: output, minimum: minimum }
}
fn enabled(level, minimum: Level) bool {
  if minimum == Level.Debug { return true }
  if minimum == Level.Info { return level != Level.Debug }
  if minimum == Level.Warning { return level == Level.Warning || level == Level.Error }
  return level == Level.Error
}
fn name(level: Level) []const u8 {
  if level == Level.Debug { return "debug" }
  if level == Level.Info { return "info" }
  if level == Level.Warning { return "warning" }
  return "error"
}
// Writes one line, "level: message name=value ...", when level is at least
// the logger's minimum.
pub fn write(target: *Logger, level: Level, message: []const u8, fields: []const Field) !stream.IoErr {
  if !enabled(level, target.minimum) { return }
  // A line that fits goes out in one write, so lines from several threads
  // do not interleave; a longer one is written in pieces.
  line: [1024]u8
  length := put(line[..], 0, name(level))
  length = put(line[..], length, ": ")
  length = put(line[..], length, message)
  for field in fields {
    length = put(line[..], length, " ")
    length = put(line[..], length, field.name)
    length = put(line[..], length, "=")
    length = put(line[..], length, field.value)
  }
  length = put(line[..], length, "\n")
  if length <= line.len {
    try stream.write(target.output, line[..length])
    return
  }
  try stream.write(target.output, name(level))
  try stream.write(target.output, ": ")
  try stream.write(target.output, message)
  for field in fields {
    try stream.write(target.output, " ")
    try stream.write(target.output, field.name)
    try stream.write(target.output, "=")
    try stream.write(target.output, field.value)
  }
  try stream.write(target.output, "\n")
}

// Appends text at length, or returns more than #len(line) once it no longer fits.
fn put(line: []u8, length: usize, text: []const u8) usize {
  if length > line.len || text.len > line.len - length { return line.len + 1 }
  for i in 0..text.len {
    line[length + i] = text[i]
  }
  return length + text.len
}
