use "std/mem" mem
use "std/fail"
pub struct URL {
  scheme: []const u8,
  authority: []const u8,
  path: []const u8,
  query: []const u8,
  fragment: []const u8,
}

fn malformed(status: *fail.Status, operation: []const u8, message: []const u8, offset: usize) {
  failure := fail.make(fail.Kind.InvalidInput, operation, "", message)
  failure.offset = offset
  failure.has_offset = true
  fail.set(status, failure)
}

// Splits text into its parts (RFC 3986), borrowing text. Only the scheme is
// checked; a bad scheme fails with InvalidInput at its offset.
pub fn parse(status: *fail.Status, text: []const u8) URL {
  if status == nil { return parse(&fail.Status{}, text) }
  empty := text[0..0]
  if status.failed { return URL{ scheme: empty, authority: empty, path: empty, query: empty, fragment: empty } }
  result := URL{ scheme: empty, authority: empty, path: empty, query: empty, fragment: empty }
  at: usize = 0
  colon: isize = -1
  scan: usize = 0
  for scan < #len(text) && text[scan] != '/' && text[scan] != '?' && text[scan] != '#' {
    if text[scan] == ':' {
      colon = #cast(isize, scan)
      break
    }
    scan += 1
  }
  if colon >= 0 {
    if colon == 0 {
      malformed(status, "parse URL", "empty scheme", 0)
      return result
    }
    i: usize = 0
    for i < #cast(usize, colon) {
      byte := text[i]
      alpha := (byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z')
      if !alpha && (i == 0 || !((byte >= '0' && byte <= '9') || byte == '+' || byte == '-' || byte == '.')) {
        malformed(status, "parse URL", "invalid scheme", i)
        return URL{ scheme: empty, authority: empty, path: empty, query: empty, fragment: empty }
      }
      i += 1
    }
    result.scheme = text[..#cast(usize, colon)]
    at = #cast(usize, colon) + 1
  }
  if at + 2 <= #len(text) && text[at] == '/' && text[at + 1] == '/' {
    at += 2
    end := at
    for end < #len(text) && text[end] != '/' && text[end] != '?' && text[end] != '#' {
      end += 1
    }
    result.authority = text[at..end]
    at = end
  }
  path_end := at
  for path_end < #len(text) && text[path_end] != '?' && text[path_end] != '#' {
    path_end += 1
  }
  result.path = text[at..path_end]
  at = path_end
  if at < #len(text) && text[at] == '?' {
    at += 1
    query_end := at
    for query_end < #len(text) && text[query_end] != '#' {
      query_end += 1
    }
    result.query = text[at..query_end]
    at = query_end
  }
  if at < #len(text) && text[at] == '#' {
    result.fragment = text[at + 1..]
  }
  return result
}

struct Encoded { value: []u8, offset: usize, failed: bool }
fn unreserved(byte: u8) bool {
  return (byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z') ||
    (byte >= '0' && byte <= '9') || byte == '-' || byte == '.' || byte == '_' || byte == '~'
}
fn hex_value(byte: u8) isize {
  if byte >= '0' && byte <= '9' { return (byte - '0') }
  if byte >= 'a' && byte <= 'f' { return #cast(isize, (byte - 'a')) + 10 }
  if byte >= 'A' && byte <= 'F' { return #cast(isize, (byte - 'A')) + 10 }
  return -1
}
// Encode one component, including slashes. Source and destination must not overlap.
// Capacity/validation failures leave destination unchanged.
fn percent_encode_into(destination: []u8, source: []const u8) Encoded {
  required: usize = 0
  for byte in source {
    amount: usize = 3
    if unreserved(byte) {
      amount = 1
    }
    if amount > #len(destination) - required {
      return Encoded{ value: destination[..0], failed: true }
    }
    required += amount
  }
  alphabet := "0123456789abcdef"
  at: usize = 0
  for input_byte in source {
    if unreserved(input_byte) {
      destination[at] = input_byte
      at += 1
    } else {
      destination[at] = '%'
      destination[at + 1] = alphabet[(input_byte >> 4)]
      destination[at + 2] = alphabet[(input_byte & 15)]
      at += 3
    }
  }
  return Encoded{ value: destination[..at] }
}
// Percent decoding treats '+' literally; it is not form-urlencoded decoding.
fn percent_decode_into(destination: []u8, source: []const u8) Encoded {
  required: usize = 0
  i: usize = 0
  for i < #len(source) {
    if source[i] == '%' {
      if #len(source) - i < 3 || hex_value(source[i + 1]) < 0 || hex_value(source[i + 2]) < 0 {
        return Encoded{ value: destination[..0], offset: i, failed: true }
      }
      i += 2
    }
    if required == #len(destination) {
      return Encoded{ value: destination[..0], offset: i, failed: true }
    }
    required += 1
    i += 1
  }
  i = 0
  at: usize = 0
  for i < #len(source) {
    if source[i] == '%' {
      destination[at] = #cast(u8, (hex_value(source[i + 1]) * 16 + hex_value(source[i + 2])))
      i += 3
    } else {
      destination[at] = source[i]
      i += 1
    }
    at += 1
  }
  return Encoded{ value: destination[..at] }
}

// One component percent-encoded, slashes included, in arena.
pub fn percent_encode(arena: *mem.Arena, source: []const u8) []u8 {
  mark := mem.arena_mark(arena)
  space := mem.push_bytes(arena, 3 * #len(source))
  encoded := percent_encode_into(space, source)
  mem.arena_rewind(arena, mark + #len(encoded.value))
  return encoded.value
}

// source with %XX escapes decoded, in arena. '+' stays literal. A malformed
// escape fails with InvalidInput at its offset, with nothing pushed.
pub fn percent_decode(arena: *mem.Arena, status: *fail.Status, source: []const u8) []u8 {
  if status == nil { return percent_decode(arena, &fail.Status{}, source) }
  empty: []u8
  if status.failed { return empty }
  mark := mem.arena_mark(arena)
  space := mem.push_bytes(arena, #len(source))
  decoded := percent_decode_into(space, source)
  if decoded.failed {
    mem.arena_rewind(arena, mark)
    malformed(status, "percent-decode", "malformed %XX escape", decoded.offset)
    return empty
  }
  mem.arena_rewind(arena, mark + #len(decoded.value))
  return decoded.value
}
