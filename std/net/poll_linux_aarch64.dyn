#target(arch: aarch64, kernel: linux)

struct PollTimespec { seconds: isize, nanoseconds: isize }

// AArch64 has ppoll rather than the legacy poll syscall. Dyn syscall 271 names
// ppoll portably; the compiler maps it to AArch64 syscall 73.
pub fn poll(descriptors: []PollDescriptor, timeout_milliseconds: i32) Result {
  timeout := PollTimespec{ seconds: #cast(isize) (timeout_milliseconds / 1000), nanoseconds: #cast(isize) ((timeout_milliseconds % 1000) * 1000000) }
  descriptor_pointer: *PollDescriptor = nil
  if #len(descriptors) > 0 { descriptor_pointer = &descriptors[0] }
  value: isize = 0
  if timeout_milliseconds < 0 { value = #syscall(271, descriptor_pointer, #len(descriptors), 0, 0, 0) }
  else { value = #syscall(271, descriptor_pointer, #len(descriptors), &timeout, 0, 0) }
  for value == -4 {
    if timeout_milliseconds < 0 { value = #syscall(271, descriptor_pointer, #len(descriptors), 0, 0, 0) }
    else { value = #syscall(271, descriptor_pointer, #len(descriptors), &timeout, 0, 0) }
  }
  return result(value)
}

pub fn wait(descriptor: isize, events: i16, timeout_milliseconds: i32) Result {
  item := PollDescriptor{ descriptor: #cast(i32) descriptor, events: events, returned: 0 }
  outcome := poll((&item)[..1], timeout_milliseconds)
  if !outcome.ok || outcome.value == 0 { return outcome }
  return Result{ value: #cast(isize) item.returned, error: 0, ok: true }
}

pub fn poll_has(item: *const PollDescriptor, events: i16) bool { return (item.returned & events) != 0 }
