pub const AddressFamilyIpv4: usize = 2
pub const AddressFamilyUnix: usize = 1
pub const AddressFamilyIpv6: usize = 10
pub const SocketStream: usize = 1
pub const SocketDatagram: usize = 2
pub const PollReadable: i16 = 1
pub const PollWritable: i16 = 4
pub const PollError: i16 = 8
pub const PollHangup: i16 = 16
pub const ShutdownRead: usize = 0
pub const ShutdownWrite: usize = 1
pub const ShutdownBoth: usize = 2

pub struct Ipv4Address { bytes: [16]u8 }
pub struct Ipv6Address { bytes: [28]u8 }
pub struct UnixAddress { bytes: [110]u8, length: usize }
// Large enough for every supported sockaddr. `length` makes ownership and ABI size explicit.
pub struct Address { bytes: [128]u8, length: usize }
pub struct PollDescriptor { descriptor: i32, events: i16, returned: i16 }

pub struct Result { value: isize, error: isize, ok: bool }
pub fn result_value(outcome: *const Result) isize { return outcome.value }

fn result(value: isize) Result {
  if value < 0 { return Result{ value: value, error: value, ok: false } }
  return Result{ value: value, error: 0, ok: true }
}

pub fn socket(family: usize, kind: usize, protocol: usize) Result {
  return result(#syscall(41, family, kind, protocol))
}

pub fn close(descriptor: isize) Result { return result(#syscall(3, descriptor)) }
pub fn listen(descriptor: isize, backlog: usize) Result { return result(#syscall(50, descriptor, backlog)) }
pub fn shutdown(descriptor: isize, how: usize) Result { return result(#syscall(48, descriptor, how)) }

pub fn ipv4_address(destination: []u8, a: u8, b: u8, c: u8, d: u8, port: u16) []u8 {
  if #len(destination) < 16 { return destination[..0] }
  i: usize = 0
  for i < 16 {
    destination[i] = 0
    i += 1
  }
  destination[0] = 2
  destination[2] = #cast(u8) (port >> 8)
  destination[3] = #cast(u8) port
  destination[4] = a
  destination[5] = b
  destination[6] = c
  destination[7] = d
  return destination[..16]
}

pub fn ipv4(a: u8, b: u8, c: u8, d: u8, port: u16) Ipv4Address {
  address_result: Ipv4Address = Ipv4Address{}
  _ = ipv4_address(address_result.bytes[..], a, b, c, d, port)
  return address_result
}

pub fn ipv6(bytes: [16]u8, port: u16, scope: u32) Ipv6Address {
  value: Ipv6Address = Ipv6Address{}
  value.bytes[0] = 10
  value.bytes[2] = #cast(u8) (port >> 8)
  value.bytes[3] = #cast(u8) port
  i: usize = 0
  for i < 16 { value.bytes[8 + i] = bytes[i]
    i += 1
  }
  value.bytes[24] = #cast(u8) scope
  value.bytes[25] = #cast(u8) (scope >> 8)
  value.bytes[26] = #cast(u8) (scope >> 16)
  value.bytes[27] = #cast(u8) (scope >> 24)
  return value
}

// Linux sockaddr_un. Empty result means an empty/oversized path.
pub fn unix(path: []const u8) UnixAddress {
  value: UnixAddress = UnixAddress{}
  if #len(path) == 0 || #len(path) > 107 { return value }
  value.bytes[0] = 1
  i: usize = 0
  for i < #len(path) { value.bytes[2 + i] = path[i]
    i += 1
  }
  value.length = 3 + #len(path)
  return value
}

pub fn connect_ipv4(descriptor: isize, address: *const Ipv4Address) Result {
  return result(#syscall(42, descriptor, &address.bytes[0], 16))
}

pub fn bind_ipv4(descriptor: isize, address: *const Ipv4Address) Result {
  return result(#syscall(49, descriptor, &address.bytes[0], 16))
}

pub fn connect_ipv6(descriptor: isize, address: *const Ipv6Address) Result { return result(#syscall(42, descriptor, &address.bytes[0], 28)) }
pub fn bind_ipv6(descriptor: isize, address: *const Ipv6Address) Result { return result(#syscall(49, descriptor, &address.bytes[0], 28)) }
pub fn connect_unix(descriptor: isize, address: *const UnixAddress) Result {
  if address.length == 0 { return Result{ value: -1, error: -22, ok: false } }
  return result(#syscall(42, descriptor, &address.bytes[0], address.length))
}
pub fn bind_unix(descriptor: isize, address: *const UnixAddress) Result {
  if address.length == 0 { return Result{ value: -1, error: -22, ok: false } }
  return result(#syscall(49, descriptor, &address.bytes[0], address.length))
}

pub fn connect(descriptor: isize, address: []const u8) Result {
  if #len(address) == 0 { return Result{ value: -1, error: -22, ok: false } }
  return result(#syscall(42, descriptor, &address[0], #len(address)))
}

pub fn bind(descriptor: isize, address: []const u8) Result {
  if #len(address) == 0 { return Result{ value: -1, error: -22, ok: false } }
  return result(#syscall(49, descriptor, &address[0], #len(address)))
}

pub fn accept(descriptor: isize) Result { return result(#syscall(43, descriptor, 0, 0)) }

pub fn accept_address(descriptor: isize, address: *Address) Result {
  length: u32 = 128
  outcome := result(#syscall(43, descriptor, &address.bytes[0], &length))
  if outcome.ok { address.length = #cast(usize) length }
  return outcome
}

pub fn local_address(descriptor: isize, address: *Address) Result {
  length: u32 = 128
  outcome := result(#syscall(51, descriptor, &address.bytes[0], &length))
  if outcome.ok { address.length = #cast(usize) length }
  return outcome
}

pub fn peer_address(descriptor: isize, address: *Address) Result {
  length: u32 = 128
  outcome := result(#syscall(52, descriptor, &address.bytes[0], &length))
  if outcome.ok { address.length = #cast(usize) length }
  return outcome
}

pub fn send(descriptor: isize, bytes: []const u8, flags: usize) Result {
  if #len(bytes) == 0 { return Result{ value: 0, error: 0, ok: true } }
  value := #syscall(44, descriptor, &bytes[0], #len(bytes), flags, 0, 0)
  for value == -4 { value = #syscall(44, descriptor, &bytes[0], #len(bytes), flags, 0, 0) }
  return result(value)
}

pub fn receive(descriptor: isize, bytes: []u8, flags: usize) Result {
  if #len(bytes) == 0 { return Result{ value: 0, error: 0, ok: true } }
  value := #syscall(45, descriptor, &bytes[0], #len(bytes), flags, 0, 0)
  for value == -4 { value = #syscall(45, descriptor, &bytes[0], #len(bytes), flags, 0, 0) }
  return result(value)
}

pub fn send_to(descriptor: isize, bytes: []const u8, flags: usize, address: []const u8) Result {
  if #len(bytes) == 0 { return Result{ value: 0, error: 0, ok: true } }
  if #len(address) == 0 { return Result{ value: -1, error: -22, ok: false } }
  value := #syscall(44, descriptor, &bytes[0], #len(bytes), flags, &address[0], #len(address))
  for value == -4 { value = #syscall(44, descriptor, &bytes[0], #len(bytes), flags, &address[0], #len(address)) }
  return result(value)
}

pub fn receive_from(descriptor: isize, bytes: []u8, flags: usize, address: []u8, address_length: *u32) Result {
  if #len(bytes) == 0 { return Result{ value: 0, error: 0, ok: true } }
  address_raw: *u8 = nil
  if #len(address) > 0 {
    address_raw = &address[0]
    address_length.* = #cast(u32) #len(address)
  }
  value := #syscall(45, descriptor, &bytes[0], #len(bytes), flags, address_raw, address_length)
  for value == -4 { value = #syscall(45, descriptor, &bytes[0], #len(bytes), flags, address_raw, address_length) }
  return result(value)
}

pub fn reuse_address(descriptor: isize, enabled: bool) Result {
  value: i32 = 0
  if enabled { value = 1 }
  return result(#syscall(54, descriptor, 1, 2, &value, #sizeof(i32)))
}

pub fn nonblocking(descriptor: isize, enabled: bool) Result {
  flags := #syscall(72, descriptor, 3, 0)
  if flags < 0 { return result(flags) }
  if enabled { flags = flags | 2048 }
  else { flags = flags & ~2048 }
  return result(#syscall(72, descriptor, 4, flags))
}

struct TimeValue { seconds: isize, microseconds: isize }

pub fn receive_timeout(descriptor: isize, milliseconds: usize) Result {
  timeout := TimeValue{ seconds: #cast(isize) (milliseconds / 1000), microseconds: #cast(isize) ((milliseconds % 1000) * 1000) }
  return result(#syscall(54, descriptor, 1, 20, &timeout, #sizeof(TimeValue)))
}

pub fn send_timeout(descriptor: isize, milliseconds: usize) Result {
  timeout := TimeValue{ seconds: #cast(isize) (milliseconds / 1000), microseconds: #cast(isize) ((milliseconds % 1000) * 1000) }
  return result(#syscall(54, descriptor, 1, 21, &timeout, #sizeof(TimeValue)))
}

pub fn poll(descriptors: []PollDescriptor, timeout_milliseconds: i32) Result {
  value: isize = 0
  if #len(descriptors) == 0 { value = #syscall(7, 0, 0, timeout_milliseconds) }
  else { value = #syscall(7, &descriptors[0], #len(descriptors), timeout_milliseconds) }
  for value == -4 {
    if #len(descriptors) == 0 { value = #syscall(7, 0, 0, timeout_milliseconds) }
    else { value = #syscall(7, &descriptors[0], #len(descriptors), timeout_milliseconds) }
  }
  return result(value)
}

pub fn wait(descriptor: isize, events: i16, timeout_milliseconds: i32) Result {
  item := PollDescriptor{ descriptor: #cast(i32) descriptor, events: events, returned: 0 }
  outcome := poll((&item)[..1], timeout_milliseconds)
  if !outcome.ok || outcome.value == 0 { return outcome }
  return Result{ value: #cast(isize) item.returned, error: 0, ok: true }
}

pub fn poll_has(item: *const PollDescriptor, events: i16) bool { return (item.returned & events) != 0 }
pub fn would_block(outcome: *const Result) bool { return !outcome.ok && (outcome.error == -11 || outcome.error == -115) }
