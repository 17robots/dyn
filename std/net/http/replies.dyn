use "std/html" html

// One-call answers for the usual responses. Each is respond with its
// options filled in; pass headers for anything more.

// A plain-text body with status.
pub fn text(status: *fail.Status, response: *Response, code: u16, body: []const u8) {
  respond(status, response, body, ResponseOptions{ status: code, content_type: "text/plain; charset=utf-8" })
}

// A JSON body with status, not cached.
pub fn json(status: *fail.Status, response: *Response, code: u16, body: []const u8) {
  cache: [1]Header = [Header{ name: "Cache-Control", value: "no-store" }]
  respond(status, response, body, ResponseOptions{ status: code, content_type: "application/json", headers: cache[..] })
}

// 303 See Other to location, setting cookies (none is fine): the answer to a
// form post.
pub fn redirect(status: *fail.Status, response: *Response, location: []const u8, cookies: []const Cookie) {
  headers: [1]Header = [Header{ name: "Location", value: location }]
  respond(status, response, "", ResponseOptions{ status: StatusSeeOther, headers: headers[..], cookies: cookies })
}

// A Writer for an HTML page (see page): over the response's send buffer when
// it is free, so the page goes out without a copy, else over fallback. A page
// that does not fit fails status with Capacity; the server then answers 500.
pub fn page_writer(status: *fail.Status, response: *Response, fallback: []u8) html.Writer {
  storage := body_buffer(response, #len(fallback))
  if #len(storage) == 0 { return html.writer(status, fallback) }
  return html.writer(status, storage)
}

// Sends the page from page_writer with code as text/html, not cached, with
// Content-Security-Policy default-src 'self' and X-Content-Type-Options
// nosniff.
pub fn page(status: *fail.Status, response: *Response, code: u16, rendered: *const html.Writer) {
  if status.failed { return }
  headers: [3]Header = [
    Header{ name: "Content-Security-Policy", value: "default-src 'self'" },
    Header{ name: "X-Content-Type-Options", value: "nosniff" },
    Header{ name: "Cache-Control", value: "no-store" },
  ]
  options := ResponseOptions{ status: code, content_type: "text/html; charset=utf-8", headers: headers[..] }
  body := html.output(rendered).bytes
  if #len(response.reserved) > 0 && #len(body) > 0 && &body[0] == &response.reserved[0] {
    respond_buffered(status, response, #len(body), options)
    return
  }
  respond(status, response, body, options)
}
