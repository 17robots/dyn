use "std/html" html

// One-call answers for the usual responses. Each is respond with its
// options filled in; pass headers for anything more.

// A plain-text body with status.
pub fn text(response: *Response, status: u16, body: []const u8) Result {
  return respond(response, body, ResponseOptions{ status: status, content_type: "text/plain; charset=utf-8" })
}

// A JSON body with status, not cached.
pub fn json(response: *Response, status: u16, body: []const u8) Result {
  cache: [1]Header = [Header{ name: "Cache-Control", value: "no-store" }]
  return respond(response, body, ResponseOptions{ status: status, content_type: "application/json", headers: cache[..] })
}

// 303 See Other to location, with a Set-Cookie when set_cookie is not empty
// (see set_cookie): the answer to a form post.
pub fn redirect(response: *Response, location: []const u8, set_cookie: []const u8) Result {
  headers: [2]Header = [Header{ name: "Location", value: location }, Header{ name: "Set-Cookie", value: set_cookie }]
  count: usize = 1
  if #len(set_cookie) > 0 {
    count = 2
  }
  return respond(response, "", ResponseOptions{ status: StatusSeeOther, headers: headers[..count] })
}

// A Writer for an HTML page (see page): over the response's send buffer when
// it is free, so the page goes out without a copy, else over fallback.
pub fn page_writer(response: *Response, fallback: []u8) html.Writer {
  storage := body_buffer(response, #len(fallback))
  if #len(storage) == 0 { return html.writer(fallback) }
  return html.writer(storage)
}

// Sends the page from page_writer with status as text/html, not cached, with
// Content-Security-Policy default-src 'self' and X-Content-Type-Options
// nosniff. 500 when it did not fit its storage.
pub fn page(response: *Response, status: u16, rendered: *const html.Writer) Result {
  if html.failed(rendered) { return text(response, 500, "page too large") }
  headers: [3]Header = [
    Header{ name: "Content-Security-Policy", value: "default-src 'self'" },
    Header{ name: "X-Content-Type-Options", value: "nosniff" },
    Header{ name: "Cache-Control", value: "no-store" },
  ]
  options := ResponseOptions{ status: status, content_type: "text/html; charset=utf-8", headers: headers[..] }
  body := html.output(rendered).bytes
  if #len(response.reserved) > 0 && #len(body) > 0 && &body[0] == &response.reserved[0] {
    return respond_buffered(response, #len(body), options)
  }
  return respond(response, body, options)
}
