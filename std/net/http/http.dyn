use "std/parse" parse
use "std/fail"
use "std/io" io
use "std/mem" memory
use "std/net" network
use "std/bytes" bytes
use "std/fmt" format
use "std/net/url" urls
use "std/time" clock

pub enum Framing { None, Length, Chunked, Close }
// Parser offsets are byte positions in the supplied input; zero also denotes an
// unavailable position for semantic URL/upgrade validation without a source cursor.
pub struct HttpHead { framing: Framing, code: u16, header_length: usize, content_length: usize, keep_alive: bool, chunked: bool }
pub struct HttpHeader { name: []const u8, value: []const u8, found: bool }
pub struct Url { scheme: []const u8, host: []const u8, port: u16, target: []const u8, secure: bool }

// A head as parsed, before anyone is told: failed with the offset where the
// input went wrong. Framing paths use it with no status.
struct Parsed { head: HttpHead, failed: bool, offset: usize }
fn parsed_failure(offset: usize) Parsed {
  return Parsed{ failed: true, offset: offset }
}
// Records a malformed message at offset.
fn malformed(status: *fail.Status, operation: []const u8, message: []const u8, offset: usize) {
  failure := fail.make(fail.Kind.InvalidInput, operation, "", message)
  failure.offset = offset
  failure.has_offset = true
  fail.set(status, failure)
}

// How a chunked-body scan ended: complete, needing more input, malformed,
// or past the destination.
enum Scan { Done, More, Invalid, Capacity }
struct ScanResult { value: []u8, offset: usize, consumed: usize, count: usize, scan: Scan }

fn append_bytes(destination: []u8, offset: usize, source: []const u8) usize {
  if offset > #len(destination) || #len(source) > #len(destination) - offset {
    return #len(destination) + 1
  }
  for i in 0..#len(source) {
    destination[offset + i] = source[i]
  }
  return offset + #len(source)
}

fn append_usize(destination: []u8, offset: usize, value: usize) usize {
  digits: [20 + memory.ArenaBufferOverhead]u8
  scratch := memory.arena_from_buffer(digits[..])
  return append_bytes(destination, offset, format.u64_decimal(scratch, value))
}

fn request_into(destination: []u8, method: []const u8, target: []const u8, host: []const u8, body: []const u8) []u8 {
  offset := append_bytes(destination, 0, method)
  offset = append_bytes(destination, offset, " ")
  if #len(target) > 0 && target[0] == '?' {
    offset = append_bytes(destination, offset, "/")
  }
  offset = append_bytes(destination, offset, target)
  offset = append_bytes(destination, offset, " HTTP/1.1\r\nHost: ")
  offset = append_bytes(destination, offset, host)
  offset = append_bytes(destination, offset, "\r\nConnection: close\r\nContent-Length: ")
  offset = append_usize(destination, offset, #len(body))
  offset = append_bytes(destination, offset, "\r\n\r\n")
  offset = append_bytes(destination, offset, body)
  if offset > #len(destination) { return destination[..0] }
  return destination[..offset]
}

fn response_into(destination: []u8, code: u16, reason: []const u8, content_type: []const u8, body: []const u8) []u8 {
  offset := append_bytes(destination, 0, "HTTP/1.1 ")
  offset = append_usize(destination, offset, code)
  offset = append_bytes(destination, offset, " ")
  offset = append_bytes(destination, offset, reason)
  offset = append_bytes(destination, offset, "\r\nContent-Type: ")
  offset = append_bytes(destination, offset, content_type)
  offset = append_bytes(destination, offset, "\r\nConnection: close\r\nContent-Length: ")
  offset = append_usize(destination, offset, #len(body))
  offset = append_bytes(destination, offset, "\r\n\r\n")
  offset = append_bytes(destination, offset, body)
  if offset > #len(destination) { return destination[..0] }
  return destination[..offset]
}

fn ascii_lower(value: u8) u8 {
  if value >= 'A' && value <= 'Z' { return value + 32 }
  return value
}

fn starts_ascii_case(input: []const u8, at: usize, expected: []const u8) bool {
  if at > #len(input) || #len(expected) > #len(input) - at { return false }
  for i in 0..#len(expected) {
    if ascii_lower(input[at + i]) != ascii_lower(expected[i]) { return false }
  }
  return true
}

struct Decimal { value: usize, offset: usize, ok: bool }

fn parse_decimal(input: []const u8, start: usize, end: usize) Decimal {
  value: usize = 0
  i := start
  if start == end { return Decimal{ offset: i } }
  for i < end {
    if input[i] < '0' || input[i] > '9' { return Decimal{ offset: i } }
    digit := #cast(usize, (input[i] - '0'))
    if value > (#max(usize) - digit) / 10 { return Decimal{ offset: i } }
    value = value * 10 + digit
    i += 1
  }
  return Decimal{ value: value, ok: true }
}

fn ascii_equal(left: []const u8, right: []const u8) bool {
  return #len(left) == #len(right) && starts_ascii_case(left, 0, right)
}
fn trim_ows(value: []const u8) []const u8 {
  first: usize = 0
  last := #len(value)
  for first < last && (value[first] == ' ' || value[first] == '\t') {
    first += 1
  }
  for last > first && (value[last - 1] == ' ' || value[last - 1] == '\t') {
    last -= 1
  }
  return value[first..last]
}
// RFC 9110 tchar: letters, digits and !#$%&'*+-.^_`|~, as bits of two masks
// over ASCII (bytes 0-63 and 64-127).
const TokenLow: u64 = 0x03ff6cfa00000000
const TokenHigh: u64 = 0x57ffffffc7fffffe

fn token_byte(byte: u8) bool {
  if byte >= 128 { return false }
  if byte >= 64 { return ((TokenHigh >> #cast(u64, byte - 64)) & 1) != 0 }
  return ((TokenLow >> #cast(u64, byte)) & 1) != 0
}
// The next "\r\n" at or after from, found with find_byte; #len(input) - 1
// (or from, near the end) when there is none.
fn crlf_at(input: []const u8, from: usize) usize {
  at := from
  for at + 1 < #len(input) {
    at += bytes.find_byte(input[at..#len(input) - 1], '\r')
    if at + 1 >= #len(input) || input[at + 1] == '\n' { return at }
    at += 1
  }
  return at
}

fn http_parse_head(input: []const u8, response: bool) Parsed {
  line_end := crlf_at(input, 0)
  if line_end + 1 >= #len(input) { return parsed_failure(#len(input)) }
  code: u16 = 0
  version := input[..0]
  version_at: usize = 0
  if response {
    if line_end < 12 { return parsed_failure(line_end) }
    if input[8] != ' ' { return parsed_failure(8) }
    if input[12] != ' ' { return parsed_failure(12) }
    version = input[..8]
    parsed_code := parse_decimal(input, 9, 12)
    if !parsed_code.ok { return parsed_failure(parsed_code.offset) }
    if parsed_code.value < 100 || parsed_code.value > 999 { return parsed_failure(9) }
    code = #cast(u16, parsed_code.value)
  } else {
    first: usize = 0
    for first < line_end && token_byte(input[first]) {
      first += 1
    }
    if first == 0 || first >= line_end || input[first] != ' ' { return parsed_failure(first) }
    second := first + 1
    for second < line_end && input[second] > 32 && input[second] != 127 {
      second += 1
    }
    if second == first + 1 || second >= line_end || input[second] != ' ' {
      return parsed_failure(second)
    }
    version_at = second + 1
    version = input[version_at..line_end]
  }
  if !bytes.equal(version, "HTTP/1.1") && !bytes.equal(version, "HTTP/1.0") {
    bad: usize = 0
    expected: []const u8 = "HTTP/1.1"
    for bad < #len(version) && bad < #len(expected) && version[bad] == expected[bad] {
      bad += 1
    }
    return parsed_failure(version_at + bad)
  }
  cursor := line_end + 2
  content_length: usize = 0
  keep_alive := bytes.equal(version, "HTTP/1.1")
  close_requested := false
  chunked := false
  has_length := false
  has_transfer := false
  for cursor + 1 < #len(input) {
    if input[cursor] == '\r' && input[cursor + 1] == '\n' {
      if has_transfer && has_length { return parsed_failure(cursor) }
      framing := Framing.None
      if chunked {
        framing = Framing.Chunked
      } else if has_length {
        framing = Framing.Length
      } else if response {
        framing = Framing.Close
      }
      if response && (code < 200 || code == 204 || code == 304) {
        framing = Framing.None
      }
      return Parsed{ head: HttpHead{ code: code, header_length: cursor + 2, content_length: content_length, keep_alive: keep_alive && !close_requested, chunked: chunked, framing: framing } }
    }
    end := crlf_at(input, cursor)
    if end + 1 >= #len(input) { return parsed_failure(#len(input)) }
    colon := cursor
    for colon < end && token_byte(input[colon]) {
      colon += 1
    }
    if colon == cursor || colon == end || input[colon] != ':' { return parsed_failure(colon) }
    value_at := colon + 1
    for value_at < end && (input[value_at] == ' ' || input[value_at] == '\t') {
      value_at += 1
    }
    value := trim_ows(input[value_at..end])
    for value_i in 0..#len(value) {
      byte := value[value_i]
      if (byte < 32 && byte != '\t') || byte == 127 { return parsed_failure(value_at + value_i) }
    }
    name := input[cursor..colon]
    if ascii_equal(name, "Content-Length") {
      parsed_length := parse_decimal(value, 0, #len(value))
      if !parsed_length.ok { return parsed_failure(value_at + parsed_length.offset) }
      if has_length && content_length != parsed_length.value { return parsed_failure(value_at) }
      content_length = parsed_length.value
      has_length = true
    } else if ascii_equal(name, "Transfer-Encoding") {
      // Only chunked is implemented. Never silently ignore unknown codings.
      if has_transfer || !ascii_equal(value, "chunked") { return parsed_failure(value_at) }
      has_transfer = true
      chunked = true
    } else if ascii_equal(name, "Connection") {
      at: usize = 0
      for at < #len(value) {
        finish := at
        for finish < #len(value) && value[finish] != ',' {
          finish += 1
        }
        item := trim_ows(value[at..finish])
        if #len(item) == 0 { return parsed_failure(value_at + at) }
        item_at := at
        for item_at < finish && (value[item_at] == ' ' || value[item_at] == '\t') {
          item_at += 1
        }
        for item_i in 0..#len(item) {
          if !token_byte(item[item_i]) { return parsed_failure(value_at + item_at + item_i) }
        }
        if ascii_equal(item, "close") {
          close_requested = true
        }
        if ascii_equal(item, "keep-alive") {
          keep_alive = true
        }
        at = finish
        if at < #len(value) {
          at += 1
        }
      }
    }
    cursor = end + 2
  }
  return parsed_failure(cursor)
}

fn parse_head(status: *fail.Status, input: []const u8, response: bool) HttpHead {
  if status.failed { return HttpHead{} }
  parsed := http_parse_head(input, response)
  if parsed.failed {
    malformed(status, "parse HTTP head", "malformed HTTP head", parsed.offset)
    return HttpHead{}
  }
  return parsed.head
}
// Parses a complete response or request head. A malformed head fails with
// InvalidInput at the offset where it went wrong.
pub fn parse_response(status: *fail.Status, input: []const u8) HttpHead {
  return parse_head(status, input, true)
}
pub fn parse_request(status: *fail.Status, input: []const u8) HttpHead {
  return parse_head(status, input, false)
}

// The value of the first header field called name, matched without case, in
// a complete head; "" when it cannot be read, and then the status says why: a
// missing field is NotFound, a malformed head InvalidInput at its offset.
// Read an optional field with a status of its own.
pub fn header(status: *fail.Status, input: []const u8, name: []const u8) []const u8 {
  if status.failed { return input[..0] }
  parsed := http_parse_head(input, starts_ascii_case(input, 0, "HTTP/"))
  if parsed.failed {
    malformed(status, "parse HTTP head", "malformed HTTP head", parsed.offset)
    return input[..0]
  }
  return present(status, field(input, parsed.head, name), "read header", name)
}

// The value of found, or "" and NotFound naming the field ("\"Host\" is
// missing"): the shared end of every public lookup.
fn present(status: *fail.Status, found: HttpHeader, operation: []const u8, name: []const u8) []const u8 {
  if status.failed { return found.value[..0] }
  if found.found { return found.value }
  missing(status, operation, name)
  return found.value[..0]
}

fn missing(status: *fail.Status, operation: []const u8, name: []const u8) {
  message: [160]u8
  used: usize = 0
  parts: [3][]const u8 = ["\"", name, "\" is missing"]
  for part in parts {
    for byte in part {
      if used < #len(message) {
        message[used] = byte
        used += 1
      }
    }
  }
  fail.set(status, fail.make(fail.Kind.NotFound, operation, "", message[..used]))
}

// Finds name in the fields of a head already parsed.
fn field(input: []const u8, head: HttpHead, name: []const u8) HttpHeader {
  cursor: usize = 0
  for cursor + 1 < head.header_length && !(input[cursor] == '\r' && input[cursor + 1] == '\n') {
    cursor += 1
  }
  cursor += 2
  for cursor + 1 < head.header_length {
    end := cursor
    for end + 1 < head.header_length && !(input[end] == '\r' && input[end + 1] == '\n') {
      end += 1
    }
    colon := cursor
    for colon < end && input[colon] != ':' {
      colon += 1
    }
    if colon - cursor == #len(name) && starts_ascii_case(input, cursor, name) {
      value := colon + 1
      for value < end && (input[value] == ' ' || input[value] == '\t') {
        value += 1
      }
      return HttpHeader{ name: input[cursor..colon], value: input[value..end], found: true }
    }
    cursor = end + 2
  }
  return HttpHeader{}
}

fn hex(value: u8) i16 {
  if value >= '0' && value <= '9' { return (value - '0') }
  lower := ascii_lower(value)
  if lower >= 'a' && lower <= 'f' { return (lower - 'a' + 10) }
  return -1
}

// Decodes a complete chunked body into caller storage. Extensions are skipped.
// Cursors advance only over validated framing; buffered payload stays encoded
// until the whole message has been validated and can be decoded in place.
struct ChunkProgress { cursor: usize, line_scan: usize, count: usize, size: usize, phase: u8, digits: bool, extension: bool }
fn chunk_progress(state: *ChunkProgress, input: []const u8) ScanResult {
  for {
    if state.phase == 1 {
      if state.size > #len(input) - state.cursor {
        return ScanResult{ offset: #len(input), scan: Scan.More }
      }
      end := state.cursor + state.size
      if #len(input) - end < 2 { return ScanResult{ offset: #len(input), scan: Scan.More } }
      if input[end] != '\r' { return ScanResult{ offset: end, scan: Scan.Invalid } }
      if input[end + 1] != '\n' { return ScanResult{ offset: end + 1, scan: Scan.Invalid } }
      if state.size > #max(usize) - state.count {
        return ScanResult{ offset: state.line_scan, scan: Scan.Capacity }
      }
      state.count += state.size
      state.cursor = end + 2
      state.line_scan = state.cursor
      state.size = 0
      state.digits = false
      state.extension = false
      state.phase = 0
    }
    if state.phase == 0 {
      for state.line_scan < #len(input) && input[state.line_scan] != '\r' {
        byte := input[state.line_scan]
        if !state.extension && byte != ';' {
          value := hex(byte)
          if value < 0 || state.size > (#max(usize) - #cast(usize, value)) / 16 {
            return ScanResult{ offset: state.line_scan, scan: Scan.Invalid }
          }
          state.size = state.size * 16 + #cast(usize, value)
          state.digits = true
        } else {
          if !state.digits || byte < 32 || byte == 127 {
            return ScanResult{ offset: state.line_scan, scan: Scan.Invalid }
          }
          state.extension = true
        }
        state.line_scan += 1
      }
      if state.line_scan == #len(input) {
        return ScanResult{ offset: #len(input), scan: Scan.More }
      }
      if !state.digits { return ScanResult{ offset: state.line_scan, scan: Scan.Invalid } }
      if state.line_scan + 1 >= #len(input) {
        return ScanResult{ offset: #len(input), scan: Scan.More }
      }
      if input[state.line_scan + 1] != '\n' {
        return ScanResult{ offset: state.line_scan + 1, scan: Scan.Invalid }
      }
      state.cursor = state.line_scan + 2
      state.line_scan = state.cursor
      state.phase = 1
      if state.size == 0 {
        state.phase = 2
      }
    } else {
      for state.line_scan + 1 < #len(input) && !(input[state.line_scan] == '\r' && input[state.line_scan + 1] == '\n') {
        state.line_scan += 1
      }
      if state.line_scan + 1 >= #len(input) {
        return ScanResult{ offset: #len(input), scan: Scan.More }
      }
      end := state.line_scan
      if end == state.cursor { return ScanResult{ count: state.count, consumed: end + 2 } }
      colon := state.cursor
      for colon < end && token_byte(input[colon]) {
        colon += 1
      }
      if colon == state.cursor || colon == end || input[colon] != ':' {
        return ScanResult{ offset: colon, scan: Scan.Invalid }
      }
      for value_at in colon + 1..end {
        byte := input[value_at]
        if (byte < 32 && byte != '\t') || byte == 127 {
          return ScanResult{ offset: value_at, scan: Scan.Invalid }
        }
      }
      if ascii_equal(input[state.cursor..colon], "Content-Length") || ascii_equal(input[state.cursor..colon], "Transfer-Encoding") {
        return ScanResult{ offset: state.cursor, scan: Scan.Invalid }
      }
      state.cursor = end + 2
      state.line_scan = state.cursor
    }
  }
  return ScanResult{ scan: Scan.Invalid }
}

// Retain the last three bytes so a header terminator may cross reads.
fn head_complete(input: []const u8, cursor: *usize) bool {
  for cursor.* + 3 < #len(input) {
    at := cursor.*
    if input[at] == '\r' && input[at + 1] == '\n' && input[at + 2] == '\r' && input[at + 3] == '\n' {
      return true
    }
    cursor.* += 1
  }
  return false
}

fn scan_chunked(input: []const u8, destination: []u8, write: bool) ScanResult {
  cursor: usize = 0
  output: usize = 0
  for {
    size: usize = 0
    digits: usize = 0
    for cursor < #len(input) && input[cursor] != '\r' && input[cursor] != ';' {
      value := hex(input[cursor])
      if value < 0 || size > (#max(usize) - #cast(usize, value)) / 16 {
        return ScanResult{ offset: cursor, scan: Scan.Invalid }
      }
      size = size * 16 + #cast(usize, value)
      cursor += 1
      digits += 1
    }
    if cursor == #len(input) { return ScanResult{ offset: #len(input), scan: Scan.More } }
    if digits == 0 { return ScanResult{ offset: cursor, scan: Scan.Invalid } }
    for cursor < #len(input) && input[cursor] != '\r' {
      if input[cursor] < 32 || input[cursor] == 127 {
        return ScanResult{ offset: cursor, scan: Scan.Invalid }
      }
      cursor += 1
    }
    if cursor + 1 >= #len(input) { return ScanResult{ offset: #len(input), scan: Scan.More } }
    if input[cursor + 1] != '\n' { return ScanResult{ offset: cursor + 1, scan: Scan.Invalid } }
    cursor += 2
    if size == 0 {
      for {
        end := cursor
        for end + 1 < #len(input) && !(input[end] == '\r' && input[end + 1] == '\n') {
          end += 1
        }
        if end + 1 >= #len(input) { return ScanResult{ offset: #len(input), scan: Scan.More } }
        if end == cursor { return ScanResult{ count: output, consumed: end + 2 } }
        colon := cursor
        for colon < end && token_byte(input[colon]) {
          colon += 1
        }
        if colon == cursor || colon == end || input[colon] != ':' {
          return ScanResult{ offset: colon, scan: Scan.Invalid }
        }
        for value_at in colon + 1..end {
          byte := input[value_at]
          if (byte < 32 && byte != '\t') || byte == 127 {
            return ScanResult{ offset: value_at, scan: Scan.Invalid }
          }
        }
        if ascii_equal(input[cursor..colon], "Content-Length") || ascii_equal(input[cursor..colon], "Transfer-Encoding") {
          return ScanResult{ offset: cursor, scan: Scan.Invalid }
        }
        cursor = end + 2
      }
    }
    if size > #len(input) - cursor { return ScanResult{ offset: #len(input), scan: Scan.More } }
    if size > #max(usize) - output { return ScanResult{ offset: cursor, scan: Scan.Capacity } }
    if write {
      if size > #len(destination) - output {
        return ScanResult{ offset: cursor, scan: Scan.Capacity }
      }
      for i in 0..size {
        destination[output + i] = input[cursor + i]
      }
    }
    cursor += size
    output += size
    if cursor + 1 >= #len(input) { return ScanResult{ offset: #len(input), scan: Scan.More } }
    if input[cursor] != '\r' { return ScanResult{ offset: cursor, scan: Scan.Invalid } }
    if input[cursor + 1] != '\n' { return ScanResult{ offset: cursor + 1, scan: Scan.Invalid } }
    cursor += 2
  }
  return ScanResult{ scan: Scan.Invalid }
}
// Incremental chunked body decoding (RFC 9112 7.1) for bodies read in pieces,
// such as uploads larger than any buffer. Framing is checked byte by byte as
// it arrives and never buffered; data is handed back as slices of the input.
// Extensions are skipped; trailer fields are checked and dropped.
pub struct ChunkReader {
  phase: ChunkPhase,
  size: usize,
  // Decoded bytes so far.
  total: usize,
  // A trailer field name being read: its length and whether it can still be
  // Content-Length or Transfer-Encoding, which trailers must not carry.
  name_length: usize,
  maybe_length: bool,
  maybe_encoding: bool,
}

enum ChunkPhase { Size, Extension, SizeEnd, Data, DataCr, DataLf, TrailerStart, TrailerName, TrailerValue, TrailerLf, EndLf, Done, Failed }

// consumed bytes of input were used; data, when not empty, is the next piece
// of the body (it lies inside input[..consumed]). done once the final chunk
// and trailers have been read: input[consumed..] then belongs to the next
// message. Malformed framing fails with InvalidInput at its offset in input.
pub struct ChunkStep { consumed: usize, data: []const u8, done: bool }

pub fn chunk_reader() ChunkReader {
  return ChunkReader{ phase: ChunkPhase.Size }
}

// Reads framing from input until it reaches data, the end of the body or the
// end of input. Call again with input[consumed..] until consumed is zero or
// done is set.
pub fn chunk_step(status: *fail.Status, reader: *ChunkReader, input: []const u8) ChunkStep {
  if status.failed { return ChunkStep{} }
  at: usize = 0
  for at < #len(input) {
    byte := input[at]
    case reader.phase {
      ChunkPhase.Size => {
        value := hex(byte)
        if value >= 0 {
          if reader.size > (#max(usize) - #cast(usize, value)) / 16 {
            return chunk_failed(status, reader, at)
          }
          reader.size = reader.size * 16 + #cast(usize, value)
          reader.name_length += 1
        } else if reader.name_length == 0 {
          return chunk_failed(status, reader, at)
        } else if byte == ';' {
          reader.phase = ChunkPhase.Extension
        } else if byte == '\r' {
          reader.phase = ChunkPhase.SizeEnd
        } else {
          return chunk_failed(status, reader, at)
        }
      }
      ChunkPhase.Extension => {
        if byte == '\r' {
          reader.phase = ChunkPhase.SizeEnd
        } else if byte < 32 || byte == 127 { return chunk_failed(status, reader, at) }
      }
      ChunkPhase.SizeEnd => {
        if byte != '\n' { return chunk_failed(status, reader, at) }
        reader.name_length = 0
        if reader.size == 0 {
          reader.phase = ChunkPhase.TrailerStart
        } else {
          if reader.size > #max(usize) - reader.total { return chunk_failed(status, reader, at) }
          reader.phase = ChunkPhase.Data
        }
      }
      ChunkPhase.Data => {
        count := #len(input) - at
        if count > reader.size {
          count = reader.size
        }
        reader.size -= count
        reader.total += count
        if reader.size == 0 {
          reader.phase = ChunkPhase.DataCr
        }
        return ChunkStep{ consumed: at + count, data: input[at..at + count] }
      }
      ChunkPhase.DataCr => {
        if byte != '\r' { return chunk_failed(status, reader, at) }
        reader.phase = ChunkPhase.DataLf
      }
      ChunkPhase.DataLf => {
        if byte != '\n' { return chunk_failed(status, reader, at) }
        reader.phase = ChunkPhase.Size
      }
      ChunkPhase.TrailerStart => {
        if byte == '\r' {
          reader.phase = ChunkPhase.EndLf
        } else if token_byte(byte) {
          reader.name_length = 0
          reader.maybe_length = true
          reader.maybe_encoding = true
          trailer_name_byte(reader, byte)
          reader.phase = ChunkPhase.TrailerName
        } else {
          return chunk_failed(status, reader, at)
        }
      }
      ChunkPhase.TrailerName => {
        if byte == ':' {
          if (reader.maybe_length && reader.name_length == 14) || (reader.maybe_encoding && reader.name_length == 17) {
            return chunk_failed(status, reader, at)
          }
          reader.phase = ChunkPhase.TrailerValue
        } else if token_byte(byte) {
          trailer_name_byte(reader, byte)
        } else {
          return chunk_failed(status, reader, at)
        }
      }
      ChunkPhase.TrailerValue => {
        if byte == '\r' {
          reader.phase = ChunkPhase.TrailerLf
        } else if (byte < 32 && byte != '\t') || byte == 127 { return chunk_failed(status, reader, at) }
      }
      ChunkPhase.TrailerLf => {
        if byte != '\n' { return chunk_failed(status, reader, at) }
        reader.phase = ChunkPhase.TrailerStart
      }
      ChunkPhase.EndLf => {
        if byte != '\n' { return chunk_failed(status, reader, at) }
        reader.phase = ChunkPhase.Done
        return ChunkStep{ consumed: at + 1, done: true }
      }
      ChunkPhase.Done => {
        return ChunkStep{ consumed: at, done: true }
      }
      ChunkPhase.Failed => {
        fail.set(status, fail.make(fail.Kind.InvalidState, "read chunked body", "", "the body already failed"))
        return ChunkStep{ consumed: at }
      }
    }
    at += 1
  }
  if reader.phase == ChunkPhase.Data && reader.size == 0 {
    reader.phase = ChunkPhase.DataCr
  }
  return ChunkStep{ consumed: at, done: reader.phase == ChunkPhase.Done }
}

fn chunk_failed(status: *fail.Status, reader: *ChunkReader, at: usize) ChunkStep {
  reader.phase = ChunkPhase.Failed
  malformed(status, "read chunked body", "malformed chunk framing", at)
  return ChunkStep{ consumed: at }
}

fn trailer_name_byte(reader: *ChunkReader, byte: u8) {
  lower := ascii_lower(byte)
  length := "content-length"
  encoding := "transfer-encoding"
  if reader.name_length >= #len(length) || length[reader.name_length] != lower {
    reader.maybe_length = false
  }
  if reader.name_length >= #len(encoding) || encoding[reader.name_length] != lower {
    reader.maybe_encoding = false
  }
  reader.name_length += 1
}

// Borrowed inputs may live below the mark, but must not overlap future writes.
fn validate_borrow(arena: *memory.Arena, input: []const u8) {
  if memory.arena_overlaps_unallocated(arena, input) {
    #panic("HTTP input overlaps arena output")
  }
}

// Validate the complete wire before allocating or writing decoded payload.
// A malformed or incomplete body fails with InvalidInput at its offset.
pub fn decode_chunked(arena: *memory.Arena, status: *fail.Status, input: []const u8) Chunked {
  if status.failed { return Chunked{} }
  validate_borrow(arena, input)
  scanned := scan_chunked(input, arena.data[..0], false)
  if scanned.scan == Scan.More {
    malformed(status, "decode chunked body", "the body ends early", scanned.offset)
    return Chunked{}
  }
  if scanned.scan != Scan.Done {
    malformed(status, "decode chunked body", "malformed chunk framing", scanned.offset)
    return Chunked{}
  }
  destination := memory.push_bytes(arena, scanned.count)
  _ = scan_chunked(input[..scanned.consumed], destination, true)
  return Chunked{ value: destination, consumed: scanned.consumed }
}
// A decoded body, and how many input bytes its framing took.
pub struct Chunked { value: []u8, consumed: usize }

// An http or https URL with its host, port and request target. A malformed
// URL fails with InvalidInput at the offset where it went wrong.
fn url_failure(status: *fail.Status, message: []const u8, offset: usize) Url {
  malformed(status, "parse URL", message, offset)
  return Url{}
}
pub fn parse_url(status: *fail.Status, input: []const u8) Url {
  if status.failed { return Url{} }
  value := urls.parse(status, input)
  if status.failed { return Url{} }
  secure := ascii_equal(value.scheme, "https")
  if !secure && !ascii_equal(value.scheme, "http") {
    return url_failure(status, "the scheme is not http or https", 0)
  }
  authority_at := #len(value.scheme) + 3
  authority := value.authority
  if #len(authority) == 0 || bytes.find_byte(authority, '@') < #len(authority) {
    return url_failure(status, "malformed URL", authority_at + bytes.find_byte(authority, '@'))
  }
  host_end := #len(authority)
  port_start := #len(authority)
  host_start: usize = 0
  if authority[0] == '[' {
    bracket := bytes.find_byte(authority, ']')
    if bracket <= 1 || bracket == #len(authority) {
      return url_failure(status, "malformed URL", authority_at + bracket)
    }
    host_start = 1
    host_end = bracket
    if host_end + 1 < #len(authority) {
      if authority[host_end + 1] != ':' {
        return url_failure(status, "malformed URL", authority_at + host_end + 1)
      }
      port_start = host_end + 2
    }
  } else {
    colon := bytes.find_byte(authority, ':')
    if colon < #len(authority) {
      host_end = colon
      port_start = host_end + 1
    }
  }
  if host_end == host_start {
    return url_failure(status, "malformed URL", authority_at + host_start)
  }
  port: u16 = 80
  if secure {
    port = 443
  }
  if port_start < #len(authority) {
    number := parse_decimal(authority, port_start, #len(authority))
    if !number.ok { return url_failure(status, "malformed URL", authority_at + number.offset) }
    if number.value == 0 || number.value > 65535 {
      return url_failure(status, "malformed URL", authority_at + port_start)
    }
    port = #cast(u16, number.value)
  } else if authority[#len(authority) - 1] == ':' {
    return url_failure(status, "malformed URL", authority_at + #len(authority))
  }
  target: []const u8 = "/"
  // Borrow the original suffix to retain query bytes; fragments are never sent.
  path_at := #len(value.scheme) + 3 + #len(authority)
  end := #len(input)
  end = path_at + bytes.find_byte(input[path_at..], '#')
  if path_at < end {
    target = input[path_at..end]
  }
  return Url{ scheme: value.scheme, host: authority[host_start..host_end], port: port, target: target, secure: secure }
}

pub const StatusOk: u16 = 200
pub const StatusCreated: u16 = 201
pub const StatusNoContent: u16 = 204
pub const StatusAccepted: u16 = 202
pub const StatusPartialContent: u16 = 206
pub const StatusMovedPermanently: u16 = 301
pub const StatusFound: u16 = 302
pub const StatusSeeOther: u16 = 303
pub const StatusNotModified: u16 = 304
pub const StatusTemporaryRedirect: u16 = 307
pub const StatusPermanentRedirect: u16 = 308
pub const StatusRequestTimeout: u16 = 408
pub const StatusGone: u16 = 410
pub const StatusPreconditionFailed: u16 = 412
pub const StatusUnsupportedMediaType: u16 = 415
pub const StatusRangeNotSatisfiable: u16 = 416
pub const StatusHeaderFieldsTooLarge: u16 = 431
pub const StatusNotImplemented: u16 = 501
pub const StatusBadGateway: u16 = 502
pub const StatusGatewayTimeout: u16 = 504
pub const StatusBadRequest: u16 = 400
pub const StatusUnauthorized: u16 = 401
pub const StatusForbidden: u16 = 403
pub const StatusNotFound: u16 = 404
pub const StatusMethodNotAllowed: u16 = 405
pub const StatusConflict: u16 = 409
pub const StatusUnprocessableContent: u16 = 422
pub const StatusTooManyRequests: u16 = 429
pub const StatusServiceUnavailable: u16 = 503
pub const MaxParams: usize = 4
pub const StatusPayloadTooLarge: u16 = 413
pub const StatusInternalServerError: u16 = 500


pub struct Request {
  raw: []const u8,
  method: []const u8,
  target: []const u8,
  // target before '?', and after it (empty when absent). Both borrow raw.
  path: []const u8,
  query: []const u8,
  body: []const u8,
  header_length: usize,
  keep_alive: bool,
  // Borrowed application state given to serve_stream or an evented start; nil otherwise.
  context: rawptr,
  // Path parameters captured by a Routes pattern such as /users/:id. Read
  // them with param.
  params: [MaxParams]Header,
  param_count: usize,
}

// A response being written. Once a write fails the response is finished:
// later writes fail with InvalidState rather than send a broken message.
pub struct Response {
  output: io.Writer,
  // Optional transport-owned response storage. Both callbacks use output.data.
  // reserve_body returns exclusive writable storage until commit or handler return.
  // commit_body queues a copied head followed by the first length body bytes,
  // and returns the count queued.
  reserve_body: fn(rawptr, usize) []u8,
  commit_body: fn(rawptr, *fail.Status, []const u8, usize) usize,
  reserved: []u8,
  started: bool,
  finished: bool,
  // The request was HEAD: the head is sent with the Content-Length the body
  // would have, and the body is dropped.
  head_only: bool,
  // Preformatted IMF-fixdate for the Date header, kept current by the server
  // loop. Empty: response_begin reads the clock itself.
  date: []const u8,
  // Set by servers that also speak HTTP/3: an Alt-Svc value (RFC 7838) sent
  // with every response, such as h3=":443"; ma=86400. Empty sends none.
  alt_svc: []const u8,
  // The status sent, once the head is written; 0 before.
  status: u16,
  // Set by a server that closes the connection after this response: the
  // head then says Connection: close whatever the options say.
  closing: bool,
}

pub struct Header { name: []const u8, value: []const u8 }

pub struct ResponseOptions {
  status: u16,
  reason: []const u8,
  content_type: []const u8,
  close_connection: bool,
  // Leaves out the Date header that every response otherwise carries.
  omit_date: bool,
  // Extra response headers, written in order. Names must be tokens and values
  // must not hold CR, LF or NUL; otherwise respond fails with Invalid before
  // writing anything, so request data cannot inject headers.
  headers: []const Header,
  // Set-Cookie headers, written from each Cookie (see set_cookie for what
  // is refused). A bad cookie fails respond before anything is written.
  cookies: []const Cookie,
}

// After a failure the stream position is lost, so the server stays failed:
// later receives fail with InvalidState.
pub struct Server {
  failed: bool,
  ended: bool,
  input: io.Reader,
  output: io.Writer,
  storage: []u8,
  used: usize,
  consumed: usize,
  // Copied into every received Request.
  context: rawptr,
}

// A received request and the response to write. ended: the client closed
// the stream cleanly between requests; there is no request.
pub struct Received { request: Request, response: Response, ended: bool }

// A streamed response body. A failed write finishes it, like Response.
pub struct Body {
  output: io.Writer,
  finished: bool,
  // A HEAD response: writes succeed and send nothing.
  discard: bool,
}

// Handles one request: writes the response, and records any failure in
// status. What a server does after a failure depends on the server.
pub type Handler = fn(*fail.Status, *Response, *const Request)

pub struct ClientResponse {
  raw: []u8,
  body: []u8,
  status: u16,
}

// A GET route also answers HEAD; the response then sends its head only.
fn method_matches(route: []const u8, method: []const u8) bool {
  return bytes.equal(route, method) || (bytes.equal(route, "GET") && bytes.equal(method, "HEAD"))
}

// Typed application state. A server stores one Handler and one rawptr; bind
// pairs them so the cast back to *T lives here, matched by construction, and
// handlers receive *T directly. The Typed value must stay alive and unmoved
// while any server uses the Binding.
pub struct Typed(T) {
  state: *T,
  handler: fn(*fail.Status, *Response, *const Request, *T),
}

pub struct Binding { handler: Handler, context: rawptr }

fn typed_dispatch(T: type, status: *fail.Status, response: *Response, request: *const Request) {
  typed := #cast(*Typed(T), request.context)
  typed.handler(status, response, request, typed.state)
}

pub fn bind(typed: *Typed($T)) Binding {
  return Binding{ handler: #instance(typed_dispatch, T), context: typed }
}

// Typed router. Patterns are exact paths with optional :name segments, each
// matching one nonempty path segment: "/users/:id/posts/:post". At most
// MaxParams per pattern. A path that matches with another method gets 405
// with an Allow header; no match runs fallback, or 404 when fallback is nil.
pub struct TypedRoute(T) {
  method: []const u8,
  pattern: []const u8,
  handler: fn(*fail.Status, *Response, *const Request, *T),
}

pub struct Routes(T) {
  routes: []TypedRoute(T),
  count: usize,
  state: *T,
  fallback: fn(*fail.Status, *Response, *const Request, *T),
}

// Route storage is caller-supplied; method and pattern strings are borrowed.
pub fn typed_routes(storage: []TypedRoute($T), state: *$T) Routes(T) {
  return Routes(T){ routes: storage, state: state }
}

// Adds a route. A pattern that is not a path or has more than MaxParams
// :name segments is InvalidInput; a full route table is Capacity.
pub fn add(status: *fail.Status, router: *Routes($T), method: []const u8, pattern: []const u8, handler: fn(*fail.Status, *Response, *const Request, *$T)) {
  if status.failed { return }
  if handler == nil || #len(pattern) == 0 || pattern[0] != '/' || pattern_params(pattern) > MaxParams {
    fail.invalid(status, "add route", pattern, "a route needs a handler and a path pattern with at most MaxParams parameters")
    return
  }
  if router.count >= #len(router.routes) {
    fail.set(status, fail.make(fail.Kind.Capacity, "add route", pattern, "the route table is full"))
    return
  }
  router.routes[router.count] = TypedRoute(T){ method: method, pattern: pattern, handler: handler }
  router.count += 1
}

fn routes_dispatch(T: type, status: *fail.Status, response: *Response, request: *const Request) {
  serve_routes(status, #cast(*Routes(T), request.context), response, request)
}

// Runs the matching route. Use it from a Typed handler that wraps routing
// with its own work, such as counting or authentication.
pub fn serve_routes(status: *fail.Status, router: *Routes($T), response: *Response, request: *const Request) {
  captures: [MaxParams]Header
  allow_storage: [128]u8
  allow_used: usize = 0
  for i in 0..router.count {
    candidate := &router.routes[i]
    count := match_captures(candidate.pattern, request.path, captures[..])
    if count < 0 { continue }
    if method_matches(candidate.method, request.method) {
      if count == 0 {
        candidate.handler(status, response, request, router.state)
        return
      }
      // Only a pattern with :name segments pays for a Request copy.
      matched := request.*
      for k in 0..#cast(usize, count) {
        matched.params[k] = captures[k]
      }
      matched.param_count = #cast(usize, count)
      candidate.handler(status, response, &matched, router.state)
      return
    }
    if allow_used > 0 {
      allow_used = append_bytes(allow_storage[..], allow_used, ", ")
    }
    allow_used = append_bytes(allow_storage[..], allow_used, candidate.method)
  }
  if allow_used > 0 && allow_used <= #len(allow_storage) {
    headers: [1]Header = [Header{ name: "Allow", value: allow_storage[..allow_used] }]
    respond(status, response, "method not allowed\n", ResponseOptions{ status: StatusMethodNotAllowed,
      content_type: "text/plain; charset=utf-8", headers: headers[..] })
    return
  }
  if router.fallback != nil {
    router.fallback(status, response, request, router.state)
    return
  }
  respond(status, response, "not found\n", ResponseOptions{ status: StatusNotFound, content_type: "text/plain; charset=utf-8" })
}

// Binds a router for a server start, like bind.
pub fn bind_routes(router: *Routes($T)) Binding {
  return Binding{ handler: #instance(routes_dispatch, T), context: router }
}

fn pattern_params(pattern: []const u8) usize {
  count: usize = 0
  for i in 0..#len(pattern) {
    if pattern[i] == ':' && i > 0 && pattern[i - 1] == '/' {
      count += 1
    }
  }
  return count
}

// Matches path against pattern segment by segment, capturing :name segments
// into request.params. Captures borrow path.
pub fn match_path(pattern: []const u8, path: []const u8, request: *Request) bool {
  count := match_captures(pattern, path, request.params[..])
  if count < 0 {
    request.param_count = 0
    return false
  }
  request.param_count = #cast(usize, count)
  return true
}

// The number of :name captures written to captures, or -1 for no match.
fn match_captures(pattern: []const u8, path: []const u8, captures: []Header) isize {
  count: usize = 0
  p: usize = 0
  q: usize = 0
  for p < #len(pattern) && q < #len(path) {
    if pattern[p] == path[q] && pattern[p] != ':' {
      p += 1
      q += 1
      continue
    }
    if pattern[p] != ':' || p == 0 || pattern[p - 1] != '/' {
      if pattern[p] != path[q] { return -1 }
      p += 1
      q += 1
      continue
    }
    name_end := p + bytes.find_byte(pattern[p..], '/')
    value_end := q + bytes.find_byte(path[q..], '/')
    if value_end == q || count >= #len(captures) { return -1 }
    captures[count] = Header{ name: pattern[p + 1..name_end], value: path[q..value_end] }
    count += 1
    p = name_end
    q = value_end
  }
  if p != #len(pattern) || q != #len(path) { return -1 }
  return #cast(isize, count)
}

// Path parameter captured by a Routes pattern, still percent-encoded; ""
// and NotFound when the pattern has no such parameter.
pub fn param(status: *fail.Status, request: *const Request, name: []const u8) []const u8 {
  return present(status, find_param(request, name), "read path parameter", name)
}

fn find_param(request: *const Request, name: []const u8) HttpHeader {
  for i in 0..request.param_count {
    if bytes.equal(request.params[i].name, name) {
      return HttpHeader{ name: request.params[i].name, value: request.params[i].value, found: true }
    }
  }
  return HttpHeader{}
}

pub fn server(input: io.Reader, output: io.Writer, storage: []u8) Server {
  return Server{ input: input, output: output, storage: storage }
}

fn shift_consumed(state: *Server) {
  if state.consumed == 0 { return }
  remaining := state.used - state.consumed
  for i in 0..remaining {
    state.storage[i] = state.storage[state.consumed + i]
  }
  state.used = remaining
  state.consumed = 0
}

fn request_parts(input: []const u8, head: HttpHead) Request {
  line_end: usize = 0
  for line_end + 1 < head.header_length && !(input[line_end] == '\r' && input[line_end + 1] == '\n') {
    line_end += 1
  }
  first_space: usize = 0
  for first_space < line_end && input[first_space] != ' ' {
    first_space += 1
  }
  second_space := first_space + 1
  for second_space < line_end && input[second_space] != ' ' {
    second_space += 1
  }
  if first_space == 0 || second_space <= first_space + 1 || second_space >= line_end {
    return Request{}
  }
  total := head.header_length + head.content_length
  target := input[first_space + 1..second_space]
  question := bytes.find_byte(target, '?')
  query := target[..0]
  if question < #len(target) {
    query = target[question + 1..]
  }
  return Request{
    raw: input[..total],
    method: input[..first_space],
    target: target,
    path: target[..question],
    query: query,
    body: input[head.header_length..total],
    header_length: head.header_length,
    keep_alive: head.keep_alive,
  }
}

pub enum FrameStatus { Incomplete, Ready, Invalid, Capacity }
// On Incomplete with a complete head, total is the request's full length and
// expect_continue says the client waits for 100 Continue before its body.
pub struct FrameResult { status: FrameStatus, request: Request, consumed: usize, offset: usize, total: usize, expect_continue: bool,
  // frame_request_head: the declared Content-Length, or chunked.
  body_length: usize,
  chunked: bool,
}

// Frames one request from bytes already buffered, with no I/O, for callers that
// own their sockets (event loops). capacity is the most bytes the caller can
// ever buffer for one request. Ready requests borrow input; consumed is its
// full length. Incomplete means read more. Chunked request bodies are Invalid.
pub fn frame_request(input: []const u8, capacity: usize) FrameResult {
  scan: usize = 0
  if !head_complete(input, &scan) {
    if #len(input) >= capacity { return FrameResult{ status: FrameStatus.Capacity } }
    return FrameResult{ status: FrameStatus.Incomplete }
  }
  parsed := http_parse_head(input, false)
  if parsed.failed { return FrameResult{ status: FrameStatus.Invalid, offset: parsed.offset } }
  head := parsed.head
  if head.chunked { return FrameResult{ status: FrameStatus.Invalid } }
  if head.header_length > capacity || head.content_length > capacity - head.header_length {
    return FrameResult{ status: FrameStatus.Capacity }
  }
  total := head.header_length + head.content_length
  if #len(input) < total {
    expect := field(input, head, "Expect")
    return FrameResult{ status: FrameStatus.Incomplete, total: total,
      expect_continue: expect.found && ascii_equal(trim_ows(expect.value), "100-continue") }
  }
  request := request_parts(input, head)
  if #len(request.method) == 0 { return FrameResult{ status: FrameStatus.Invalid } }
  return FrameResult{ status: FrameStatus.Ready, request: request, consumed: total }
}

// Like frame_request, and also takes Transfer-Encoding: chunked bodies. Once
// the whole chunked body has arrived it is decoded in place, so input
// changes; Request.body and Request.raw then hold the decoded body. Until
// then the result is Incomplete with total one past the bytes at hand.
pub fn frame_request_decoding(input: []u8, capacity: usize) FrameResult {
  scan: usize = 0
  if !head_complete(input, &scan) { return frame_request(input, capacity) }
  parsed := http_parse_head(input, false)
  if parsed.failed || !parsed.head.chunked { return frame_request(input, capacity) }
  head := parsed.head
  if head.header_length > capacity { return FrameResult{ status: FrameStatus.Capacity } }
  empty: [0]u8
  probe := scan_chunked(input[head.header_length..], empty[..], false)
  if probe.scan == Scan.More {
    if #len(input) >= capacity { return FrameResult{ status: FrameStatus.Capacity } }
    expect := field(input, head, "Expect")
    return FrameResult{ status: FrameStatus.Incomplete, total: #len(input) + 1,
      expect_continue: expect.found && ascii_equal(trim_ows(expect.value), "100-continue") }
  }
  if probe.scan != Scan.Done {
    return FrameResult{ status: FrameStatus.Invalid, offset: head.header_length + probe.offset }
  }
  body := input[head.header_length..]
  decoded := scan_chunked(body, body, true)
  if decoded.scan != Scan.Done { return FrameResult{ status: FrameStatus.Invalid } }
  framed := head
  framed.content_length = decoded.count
  request := request_parts(input, framed)
  if #len(request.method) == 0 { return FrameResult{ status: FrameStatus.Invalid } }
  return FrameResult{ status: FrameStatus.Ready, request: request, consumed: head.header_length + probe.consumed }
}

// Frames only a request's head, for bodies read separately (see ChunkReader).
// Ready requests borrow input and have an empty body; consumed is the head's
// length, body_length the declared Content-Length unless chunked is set.
// Capacity means the head alone exceeds capacity.
pub fn frame_request_head(input: []const u8, capacity: usize) FrameResult {
  scan: usize = 0
  if !head_complete(input, &scan) {
    if #len(input) >= capacity { return FrameResult{ status: FrameStatus.Capacity } }
    return FrameResult{ status: FrameStatus.Incomplete }
  }
  parsed := http_parse_head(input, false)
  if parsed.failed { return FrameResult{ status: FrameStatus.Invalid, offset: parsed.offset } }
  head := parsed.head
  if head.header_length > capacity { return FrameResult{ status: FrameStatus.Capacity } }
  framed := head
  framed.content_length = 0
  request := request_parts(input, framed)
  if #len(request.method) == 0 { return FrameResult{ status: FrameStatus.Invalid } }
  expect := field(input, head, "Expect")
  return FrameResult{ status: FrameStatus.Ready, request: request, consumed: head.header_length,
    expect_continue: expect.found && ascii_equal(trim_ows(expect.value), "100-continue"),
    body_length: head.content_length, chunked: head.chunked }
}

fn receive_failed(status: *fail.Status, state: *Server, kind: fail.Kind, message: []const u8, offset: usize) Received {
  state.failed = true
  failure := fail.make(kind, "receive request", "", message)
  if offset != 0 {
    failure.offset = offset
    failure.has_offset = true
  }
  fail.set(status, failure)
  return Received{}
}

// The next request. Malformed requests fail with InvalidInput (at the
// offset where they went wrong), requests larger than the storage with
// Capacity. A clean end of the stream between requests is no failure:
// ended is set. Request slices borrow state.storage and stay valid only
// until the next receive.
pub fn receive(status: *fail.Status, state: *Server) Received {
  if status.failed { return Received{} }
  if state.failed { return receive_failed(status, state, fail.Kind.InvalidState, "an earlier receive failed", 0) }
  if state.used > #len(state.storage) || state.consumed > state.used || state.input.read == nil || state.output.write == nil {
    return receive_failed(status, state, fail.Kind.InvalidState, "the server is not set up", 0)
  }
  shift_consumed(state)
  head := HttpHead{}
  head_scan: usize = 0
  head_checked := false
  for true {
    if !head_checked && head_complete(state.storage[..state.used], &head_scan) {
      parsed := http_parse_head(state.storage[..state.used], false)
      head = parsed.head
      head_checked = true
      // More bytes cannot repair a complete head that does not parse.
      if parsed.failed { return receive_failed(status, state, fail.Kind.InvalidInput, "malformed request head", parsed.offset) }
    }
    if head_checked && head.chunked {
      // Decoded in place once the whole body is here.
      framed := frame_request_decoding(state.storage[..state.used], #len(state.storage))
      if framed.status == FrameStatus.Invalid {
        return receive_failed(status, state, fail.Kind.InvalidInput, "malformed chunked body", framed.offset)
      }
      if framed.status == FrameStatus.Capacity {
        return receive_failed(status, state, fail.Kind.Capacity, "the request does not fit the storage", 0)
      }
      if framed.status == FrameStatus.Ready {
        request := framed.request
        request.context = state.context
        state.consumed = framed.consumed
        return Received{ request: request, response: Response{ output: state.output, head_only: bytes.equal(request.method, "HEAD") } }
      }
    } else if head_checked {
      if head.content_length > #len(state.storage) - head.header_length {
        return receive_failed(status, state, fail.Kind.Capacity, "the request does not fit the storage", 0)
      }
      total := head.header_length + head.content_length
      if state.used >= total {
        request := request_parts(state.storage[..state.used], head)
        request.context = state.context
        if #len(request.method) == 0 { return receive_failed(status, state, fail.Kind.InvalidInput, "malformed request line", 0) }
        state.consumed = total
        return Received{ request: request, response: Response{ output: state.output, head_only: bytes.equal(request.method, "HEAD") } }
      }
    }
    // End is a transport state until all buffered requests have been consumed.
    if state.ended {
      if state.used == 0 { return Received{ ended: true } }
      return receive_failed(status, state, fail.Kind.InvalidInput, "the stream ended inside a request", state.used)
    }
    if state.used == #len(state.storage) { return receive_failed(status, state, fail.Kind.Capacity, "the request does not fit the storage", 0) }
    count := io.read(status, state.input, state.storage[state.used..])
    if status.failed {
      state.failed = true
      return Received{}
    }
    state.used += count
    if count == 0 {
      state.ended = true
    }
  }
  return Received{}
}

// Reason phrase for status, or "Status" for codes without a registered one.
pub fn status_reason(status: u16) []const u8 {
  case status {
    100 => { return "Continue" }
    101 => { return "Switching Protocols" }
    103 => { return "Early Hints" }
    200 => { return "OK" }
    201 => { return "Created" }
    202 => { return "Accepted" }
    203 => { return "Non-Authoritative Information" }
    204 => { return "No Content" }
    205 => { return "Reset Content" }
    206 => { return "Partial Content" }
    300 => { return "Multiple Choices" }
    301 => { return "Moved Permanently" }
    302 => { return "Found" }
    303 => { return "See Other" }
    304 => { return "Not Modified" }
    307 => { return "Temporary Redirect" }
    308 => { return "Permanent Redirect" }
    400 => { return "Bad Request" }
    401 => { return "Unauthorized" }
    402 => { return "Payment Required" }
    403 => { return "Forbidden" }
    404 => { return "Not Found" }
    405 => { return "Method Not Allowed" }
    406 => { return "Not Acceptable" }
    407 => { return "Proxy Authentication Required" }
    408 => { return "Request Timeout" }
    409 => { return "Conflict" }
    410 => { return "Gone" }
    411 => { return "Length Required" }
    412 => { return "Precondition Failed" }
    413 => { return "Content Too Large" }
    414 => { return "URI Too Long" }
    415 => { return "Unsupported Media Type" }
    416 => { return "Range Not Satisfiable" }
    417 => { return "Expectation Failed" }
    421 => { return "Misdirected Request" }
    422 => { return "Unprocessable Content" }
    425 => { return "Too Early" }
    426 => { return "Upgrade Required" }
    428 => { return "Precondition Required" }
    429 => { return "Too Many Requests" }
    431 => { return "Request Header Fields Too Large" }
    451 => { return "Unavailable For Legal Reasons" }
    500 => { return "Internal Server Error" }
    501 => { return "Not Implemented" }
    502 => { return "Bad Gateway" }
    503 => { return "Service Unavailable" }
    504 => { return "Gateway Timeout" }
    505 => { return "HTTP Version Not Supported" }
    _ => { return "Status" }
  }
}

// Responses with these codes never carry content (RFC 9110 6.4.1): the head
// has no Content-Type, Content-Length or Transfer-Encoding.
pub fn status_has_body(status: u16) bool {
  return status >= 200 && status != StatusNoContent && status != StatusNotModified
}

const WeekdayNames: []const u8 = "ThuFriSatSunMonTueWed"
const MonthNames: []const u8 = "JanFebMarAprMayJunJulAugSepOctNovDec"
pub const DateLength: usize = 29

fn put_two(destination: []u8, at: usize, value: u32) {
  destination[at] = #cast(u8, '0' + value / 10)
  destination[at + 1] = #cast(u8, '0' + value % 10)
}

// IMF-fixdate (RFC 9110 5.6.7) for unix_seconds, such as
// "Sun, 06 Nov 1994 08:49:37 GMT", into the first DateLength bytes of
// destination. Empty when destination is shorter or the year is outside 1-9999.
pub fn format_date(destination: []u8, unix_seconds: i64) []u8 {
  if #len(destination) < DateLength || unix_seconds < -62135596800 || unix_seconds > 253402300799 {
    return destination[..0]
  }
  days := unix_seconds / 86400
  seconds := unix_seconds % 86400
  if seconds < 0 {
    seconds += 86400
    days -= 1
  }
  civil := clock.civil_from_days(days)
  weekday := #cast(usize, ((days % 7) + 7) % 7)
  for i in 0..3 {
    destination[i] = WeekdayNames[weekday * 3 + i]
  }
  destination[3] = ','
  destination[4] = ' '
  put_two(destination, 5, civil.day)
  destination[7] = ' '
  month := #cast(usize, civil.month - 1)
  for i in 0..3 {
    destination[8 + i] = MonthNames[month * 3 + i]
  }
  destination[11] = ' '
  year := #cast(u32, civil.year)
  put_two(destination, 12, year / 100)
  put_two(destination, 14, year % 100)
  destination[16] = ' '
  second_of_day := #cast(u32, seconds)
  put_two(destination, 17, second_of_day / 3600)
  destination[19] = ':'
  put_two(destination, 20, second_of_day / 60 % 60)
  destination[22] = ':'
  put_two(destination, 23, second_of_day % 60)
  destination[25] = ' '
  destination[26] = 'G'
  destination[27] = 'M'
  destination[28] = 'T'
  return destination[..DateLength]
}


fn two_digits(text: []const u8, at: usize) i64 {
  high := text[at]
  low := text[at + 1]
  if high < '0' || high > '9' || low < '0' || low > '9' { return -1 }
  return ((high - '0') * 10 + (low - '0'))
}

// Unix seconds from an IMF-fixdate, as in If-Modified-Since. The obsolete
// RFC 850 and asctime forms fail with InvalidInput.
pub fn parse_date(status: *fail.Status, text: []const u8) i64 {
  if status.failed { return 0 }
  if #len(text) != DateLength || text[3] != ',' || text[4] != ' ' || text[7] != ' ' || text[11] != ' ' ||
    text[16] != ' ' || text[19] != ':' || text[22] != ':' || !bytes.equal(text[25..], " GMT") {
    malformed(status, "parse date", "not an IMF-fixdate", 0)
    return 0
  }
  month: usize = 12
  for i in 0..12 {
    if bytes.equal(text[8..11], MonthNames[i * 3..i * 3 + 3]) {
      month = i
    }
  }
  day := two_digits(text, 5)
  century := two_digits(text, 12)
  year_low := two_digits(text, 14)
  hour := two_digits(text, 17)
  minute := two_digits(text, 20)
  second := two_digits(text, 23)
  if month == 12 || day < 1 || day > 31 || century < 0 || year_low < 0 || hour < 0 || hour > 23 || minute < 0 ||
    minute > 59 || second < 0 || second > 60 {
    malformed(status, "parse date", "a date field is out of range", 5)
    return 0
  }
  year := century * 100 + year_low
  if year < 1 {
    malformed(status, "parse date", "the year is out of range", 12)
    return 0
  }
  days := clock.days_from_civil(#cast(i32, year), #cast(u8, month + 1), #cast(u8, day))
  return days * 86400 + hour * 3600 + minute * 60 + second
}

fn decimal(destination: []u8, value: usize) []const u8 {
  digits: [20 + memory.ArenaBufferOverhead]u8
  scratch := memory.arena_from_buffer(digits[..])
  text := format.u64_decimal(scratch, value)
  if #len(text) > #len(destination) { return destination[..0] }
  for i in 0..#len(text) {
    destination[i] = text[i]
  }
  return destination[..#len(text)]
}

fn response_invalid(status: *fail.Status, message: []const u8) {
  fail.set(status, fail.make(fail.Kind.InvalidInput, "respond", "", message))
}
fn response_state(status: *fail.Status, message: []const u8) {
  fail.set(status, fail.make(fail.Kind.InvalidState, "respond", "", message))
}

// Writes source to the client. A failure finishes the response.
fn response_output(status: *fail.Status, response: *Response, source: []const u8) {
  io.write(status, response.output, source)
  if status.failed {
    response.started = true
    response.finished = true
  }
}

fn header_valid(item: Header) bool {
  if #len(item.name) == 0 { return false }
  for byte in item.name {
    if !token_byte(byte) { return false }
  }
  for byte in item.value {
    if byte == '\r' || byte == '\n' || byte == 0 { return false }
  }
  return true
}
fn text_valid(value: []const u8) bool {
  for byte in value {
    if byte == '\r' || byte == '\n' || byte == 0 { return false }
  }
  return true
}

enum HeadMode { Measure, Stage, Direct }
struct HeadWriter { mode: HeadMode, staging: []u8, used: usize, response: *Response, status: *fail.Status }
fn head_emit(writer: *HeadWriter, piece: []const u8) {
  if writer.mode == HeadMode.Measure {
    writer.used += #len(piece)
  } else if writer.mode == HeadMode.Stage {
    writer.used = append_bytes(writer.staging, writer.used, piece)
  } else {
    response_output(writer.status, writer.response, piece)
  }
}
fn head_write(writer: *HeadWriter, options: ResponseOptions, status: u16, reason: []const u8, content_type: []const u8, body_length: usize, chunked: bool, date: []const u8) {
  number_storage: [20]u8
  head_emit(writer, "HTTP/1.1 ")
  head_emit(writer, decimal(number_storage[..], status))
  head_emit(writer, " ")
  head_emit(writer, reason)
  if status_has_body(status) {
    if #len(content_type) > 0 {
      head_emit(writer, "\r\nContent-Type: ")
      head_emit(writer, content_type)
    }
    if chunked {
      head_emit(writer, "\r\nTransfer-Encoding: chunked")
    } else {
      head_emit(writer, "\r\nContent-Length: ")
      head_emit(writer, decimal(number_storage[..], body_length))
    }
  }
  if #len(date) > 0 {
    head_emit(writer, "\r\nDate: ")
    head_emit(writer, date)
  }
  if #len(writer.response.alt_svc) > 0 {
    head_emit(writer, "\r\nAlt-Svc: ")
    head_emit(writer, writer.response.alt_svc)
  }
  for item in options.headers {
    head_emit(writer, "\r\n")
    head_emit(writer, item.name)
    head_emit(writer, ": ")
    head_emit(writer, item.value)
  }
  for item in options.cookies {
    // Checked in response_begin, so formatting succeeds here.
    storage: [CookieLength]u8
    formatting: fail.Status
    head_emit(writer, "\r\nSet-Cookie: ")
    head_emit(writer, set_cookie(&formatting, storage[..], item))
  }
  if options.close_connection || writer.response.closing {
    head_emit(writer, "\r\nConnection: close\r\n\r\n")
  } else {
    head_emit(writer, "\r\nConnection: keep-alive\r\n\r\n")
  }
}

// Writes the response head, followed by body when given. Head and body leave in
// one write when they fit in a stack staging buffer: separate small writes on a
// keep-alive socket stall on Nagle plus delayed ACK (about 40 ms per response).
fn response_begin(status: *fail.Status, response: *Response, options: ResponseOptions, body_length: usize, chunked: bool, body: []const u8, buffered: bool) {
  if status.failed { return }
  if response.started || response.finished || response.output.write == nil {
    response_state(status, "already responded")
    return
  }
  if !buffered { response.reserved = response.reserved[..0] }
  code := options.status
  if code == 0 {
    code = StatusOk
  }
  reason := options.reason
  if #len(reason) == 0 {
    reason = status_reason(code)
  }
  content_type := options.content_type
  if #len(content_type) == 0 && (body_length > 0 || chunked) {
    content_type = "application/octet-stream"
  }
  // Rejected before any byte is written; the response stays unstarted.
  // 1xx, 204 and 304 carry no content and are never chunked.
  if !status_has_body(code) && (body_length > 0 || chunked) {
    response_invalid(status, "this status carries no body")
    return
  }
  if !text_valid(reason) || !text_valid(content_type) {
    response_invalid(status, "the reason or content type holds CR, LF or NUL")
    return
  }
  for item in options.headers {
    if !header_valid(item) {
      response_invalid(status, "a header name is not a token or its value holds CR, LF or NUL")
      return
    }
  }
  for item in options.cookies {
    storage: [CookieLength]u8
    _ = set_cookie(status, storage[..], item)
    if status.failed { return }
  }
  response.status = code
  date_storage: [DateLength]u8
  date := response.date
  if options.omit_date {
    date = date_storage[..0]
  } else if #len(date) == 0 {
    date = format_date(date_storage[..], clock.realtime_now().seconds)
  }
  // HEAD: the head describes the body, which is not sent.
  payload := body
  if response.head_only {
    payload = body[..0]
  }
  staging: [8 * memory.KiB]u8
  measure := HeadWriter{ mode: HeadMode.Measure, response: response, status: status }
  head_write(&measure, options, code, reason, content_type, body_length, chunked, date)
  head_length := measure.used
  if buffered {
    if head_length > #len(staging) {
      fail.set(status, fail.make(fail.Kind.Capacity, "respond", "", "the head does not fit 8 KiB"))
      return
    }
    stage := HeadWriter{ mode: HeadMode.Stage, staging: staging[..], response: response, status: status }
    head_write(&stage, options, code, reason, content_type, body_length, false, date)
    sent_length := body_length
    if response.head_only {
      sent_length = 0
    }
    written := response.commit_body(response.output.data, status, staging[..head_length], sent_length)
    response.reserved = response.reserved[..0]
    response.started = true
    if !status.failed && written != head_length + sent_length {
      fail.set(status, fail.make(fail.Kind.InvalidState, "respond", "", "the transport queued part of the response"))
    }
    if status.failed {
      response.finished = true
    }
    return
  }
  if head_length <= #len(staging) {
    stage := HeadWriter{ mode: HeadMode.Stage, staging: staging[..], response: response, status: status }
    head_write(&stage, options, code, reason, content_type, body_length, chunked, date)
    if #len(payload) <= #len(staging) - head_length {
      // Common case: head and body in one write.
      used := append_bytes(staging[..], head_length, payload)
      response.started = true
      response_output(status, response, staging[..used])
      return
    }
    response.started = true
    response_output(status, response, staging[..head_length])
  } else {
    response.started = true
    direct := HeadWriter{ mode: HeadMode.Direct, response: response, status: status }
    head_write(&direct, options, code, reason, content_type, body_length, chunked, date)
  }
  response_output(status, response, payload)
}

// The value of the first request header named name (ASCII case-insensitive),
// borrowing request.raw; "" and NotFound when there is none. Each call scans
// the head. Read an optional header with a status of its own.
pub fn request_header(status: *fail.Status, request: *const Request, name: []const u8) []const u8 {
  return present(status, find_header(request, name), "read header", name)
}

fn find_header(request: *const Request, name: []const u8) HttpHeader {
  raw := request.raw[..request.header_length]
  parsed := http_parse_head(raw, false)
  if parsed.failed { return HttpHeader{} }
  return field(raw, parsed.head, name)
}

// Value of cookie name from the request's Cookie headers (RFC 6265 5.4).
// Surrounding double quotes are removed; the value borrows request.raw. ""
// and NotFound when the request has no such cookie.
pub fn cookie(status: *fail.Status, request: *const Request, name: []const u8) []const u8 {
  return present(status, find_cookie(request, name), "read cookie", name)
}

fn find_cookie(request: *const Request, name: []const u8) HttpHeader {
  head := request.raw[..request.header_length]
  at: usize = 0
  for at < #len(head) {
    line_end := at + bytes.find(head[at..], "\r\n")
    line := head[at..line_end]
    at = line_end + 2
    colon := bytes.find_byte(line, ':')
    if colon == #len(line) || !ascii_equal(line[..colon], "cookie") { continue }
    found := find_cookie_in(line[colon + 1..], name)
    if found.found { return found }
  }
  return HttpHeader{}
}

// The cookie named name in one Cookie header value, such as "a=1; b=2"; ""
// and NotFound when it is not there.
pub fn cookie_in(status: *fail.Status, header_value: []const u8, name: []const u8) []const u8 {
  return present(status, find_cookie_in(header_value, name), "read cookie", name)
}

fn find_cookie_in(header_value: []const u8, name: []const u8) HttpHeader {
  rest := header_value
  for #len(rest) > 0 {
    end := bytes.find_byte(rest, ';')
    pair := trim_ows(rest[..end])
    equals := bytes.find_byte(pair, '=')
    if equals < #len(pair) && bytes.equal(trim_ows(pair[..equals]), name) {
      value := trim_ows(pair[equals + 1..])
      if #len(value) >= 2 && value[0] == '"' && value[#len(value) - 1] == '"' {
        value = value[1..#len(value) - 1]
      }
      return HttpHeader{ name: name, value: value, found: true }
    }
    if end >= #len(rest) { break }
    rest = rest[end + 1..]
  }
  return HttpHeader{}
}

fn text_failure(status: *fail.Status, destination: []u8, kind: fail.Kind, message: []const u8, offset: usize) []u8 {
  failure := fail.make(kind, "format", "", message)
  if offset != 0 {
    failure.offset = offset
    failure.has_offset = true
  }
  fail.set(status, failure)
  return destination[..0]
}

pub enum SameSite { Default, Lax, Strict, None }

// A Set-Cookie value. max_age 0 leaves Max-Age out (a session cookie);
// negative writes Max-Age=0, which deletes the cookie. expires 0 leaves
// Expires out, otherwise it is unix seconds. SameSite None requires secure.
// The longest Set-Cookie value respond writes from a Cookie.
pub const CookieLength: usize = 1024

pub struct Cookie {
  name: []const u8,
  value: []const u8,
  path: []const u8,
  domain: []const u8,
  max_age: i64,
  expires: i64,
  secure: bool,
  http_only: bool,
  same_site: SameSite,
  partitioned: bool,
}


fn cookie_octet(byte: u8) bool {
  return byte == 0x21 || (byte >= 0x23 && byte <= 0x2b) || (byte >= 0x2d && byte <= 0x3a) ||
    (byte >= 0x3c && byte <= 0x5b) || (byte >= 0x5d && byte <= 0x7e)
}

fn attribute_valid(value: []const u8) bool {
  for byte in value {
    if byte < 0x20 || byte == 0x7f || byte == ';' { return false }
  }
  return true
}

// Writes the Set-Cookie header value for cookie into destination. Fails with
// Syntax when the name is not a token, the value has bytes outside
// cookie-octet, an attribute has ';' or control bytes, or SameSite None lacks
// secure; with Capacity when destination is too small.
pub fn set_cookie(status: *fail.Status, destination: []u8, item: Cookie) []u8 {
  if status.failed { return destination[..0] }
  if #len(item.name) == 0 { return text_failure(status, destination, fail.Kind.InvalidInput, "invalid character", 0) }
  for byte in item.name {
    if !token_byte(byte) { return text_failure(status, destination, fail.Kind.InvalidInput, "invalid character", 0) }
  }
  for byte in item.value {
    if !cookie_octet(byte) {
      return text_failure(status, destination, fail.Kind.InvalidInput, "invalid cookie value", #len(item.name) + 1)
    }
  }
  if !attribute_valid(item.path) || !attribute_valid(item.domain) || (item.same_site == SameSite.None && !item.secure) {
    return text_failure(status, destination, fail.Kind.InvalidInput, "invalid character", 0)
  }
  out := format.buffer(status, destination)
  format.write(&out, item.name)
  format.write_byte(&out, '=')
  format.write(&out, item.value)
  if #len(item.path) > 0 {
    format.write(&out, "; Path=")
    format.write(&out, item.path)
  }
  if #len(item.domain) > 0 {
    format.write(&out, "; Domain=")
    format.write(&out, item.domain)
  }
  if item.max_age > 0 {
    format.write(&out, "; Max-Age=")
    format.write_i64(&out, item.max_age)
  } else if item.max_age < 0 {
    format.write(&out, "; Max-Age=0")
  }
  if item.expires != 0 {
    date_storage: [DateLength]u8
    date := format_date(date_storage[..], item.expires)
    if #len(date) == 0 { return text_failure(status, destination, fail.Kind.Overflow, "expires is out of range", 0) }
    format.write(&out, "; Expires=")
    format.write(&out, date)
  }
  if item.secure {
    format.write(&out, "; Secure")
  }
  if item.http_only {
    format.write(&out, "; HttpOnly")
  }
  case item.same_site {
    SameSite.Default => {}
    SameSite.Lax => { format.write(&out, "; SameSite=Lax") }
    SameSite.Strict => { format.write(&out, "; SameSite=Strict") }
    SameSite.None => { format.write(&out, "; SameSite=None") }
  }
  if item.partitioned {
    format.write(&out, "; Partitioned")
  }
  if status.failed { return destination[..0] }
  return destination[..out.length]
}

// One Server-Sent Events message: optional event and id fields, a data line
// for each line of data (CR, LF or CRLF), then a blank line. Empty event or
// id is left out. Fails with Syntax when event or id holds CR or LF, or id
// holds NUL; with Capacity when destination is too small.
pub fn sse_event(status: *fail.Status, destination: []u8, event: []const u8, id: []const u8, data: []const u8) []u8 {
  if status.failed { return destination[..0] }
  for byte in event {
    if byte == '\r' || byte == '\n' {
      return text_failure(status, destination, fail.Kind.InvalidInput, "invalid character", 0)
    }
  }
  for byte in id {
    if byte == '\r' || byte == '\n' || byte == 0 {
      return text_failure(status, destination, fail.Kind.InvalidInput, "invalid character", 0)
    }
  }
  out := format.buffer(status, destination)
  if #len(event) > 0 {
    format.write(&out, "event: ")
    format.write(&out, event)
    format.write_byte(&out, '\n')
  }
  if #len(id) > 0 {
    format.write(&out, "id: ")
    format.write(&out, id)
    format.write_byte(&out, '\n')
  }
  start: usize = 0
  for true {
    end := start
    for end < #len(data) && data[end] != '\r' && data[end] != '\n' {
      end += 1
    }
    format.write(&out, "data: ")
    format.write(&out, data[start..end])
    format.write_byte(&out, '\n')
    if end == #len(data) { break }
    if data[end] == '\r' && end + 1 < #len(data) && data[end + 1] == '\n' {
      end += 1
    }
    start = end + 1
  }
  format.write_byte(&out, '\n')
  if status.failed { return destination[..0] }
  return destination[..out.length]
}


// application/x-www-form-urlencoded value into destination: '+' becomes a
// space and %XX a byte. Fails with InvalidInput on a bad escape and Capacity
// when destination is too small; destination contents are then unspecified.
pub fn form_decode(status: *fail.Status, destination: []u8, source: []const u8) []u8 {
  if status.failed { return destination[..0] }
  at: usize = 0
  i: usize = 0
  for i < #len(source) {
    if at == #len(destination) {
      failure := fail.make(fail.Kind.Capacity, "decode form", "", "the value does not fit the storage")
      failure.offset = i
      failure.has_offset = true
      fail.set(status, failure)
      return destination[..0]
    }
    byte := source[i]
    if byte == '%' {
      if #len(source) - i < 3 || hex(source[i + 1]) < 0 || hex(source[i + 2]) < 0 {
        malformed(status, "decode form", "malformed %XX escape", i)
        return destination[..0]
      }
      destination[at] = #cast(u8, hex(source[i + 1]) * 16 + hex(source[i + 2]))
      i += 3
    } else {
      if byte == '+' {
        byte = ' '
      }
      destination[at] = byte
      i += 1
    }
    at += 1
  }
  return destination[..at]
}

// Raw, still-encoded value of the first field named name in an urlencoded
// form or query string; "" and NotFound when there is none.
pub fn form_field(status: *fail.Status, form: []const u8, name: []const u8) []const u8 {
  return present(status, find_form_field(form, name), "read form field", name)
}

fn find_form_field(form: []const u8, name: []const u8) HttpHeader {
  start: usize = 0
  for start <= #len(form) {
    end := start + bytes.find_byte(form[start..], '&')
    pair := form[start..end]
    equals := bytes.find_byte(pair, '=')
    if bytes.equal(pair[..equals], name) {
      if equals == #len(pair) { return HttpHeader{ name: pair, value: pair[..0], found: true } }
      return HttpHeader{ name: pair[..equals], value: pair[equals + 1..], found: true }
    }
    start = end + 1
  }
  return HttpHeader{}
}

// Whether the query has a parameter called name, with or without a value
// ("?debug" and "?debug=1" both have debug).
pub fn query_has(request: *const Request, name: []const u8) bool {
  return find_form_field(request.query, name).found
}

// Decoded query parameter name into destination; empty when it cannot be
// read, and then the status says why: NotFound when absent, InvalidInput for
// bad percent-encoding, Capacity when destination is too small.
pub fn query_value(status: *fail.Status, request: *const Request, name: []const u8, destination: []u8) []u8 {
  return decoded_field(status, find_form_field(request.query, name), "read query parameter", name, destination)
}

fn decoded_field(status: *fail.Status, found: HttpHeader, operation: []const u8, name: []const u8, destination: []u8) []u8 {
  if status.failed { return destination[..0] }
  if !found.found {
    missing(status, operation, name)
    return destination[..0]
  }
  return form_decode(status, destination, found.value)
}

// Decoded urlencoded body field name into destination, by the rules of
// query_value. The caller checks the content type when it matters.
pub fn form_value(status: *fail.Status, request: *const Request, name: []const u8, destination: []u8) []u8 {
  return decoded_field(status, find_form_field(request.body, name), "read form field", name, destination)
}

// Returns exclusive transport-owned body storage, or empty when unavailable.
// Do not retain the view beyond respond_buffered, another response operation,
// or handler return. No bytes are queued until respond_buffered succeeds.
pub fn body_buffer(response: *Response, capacity: usize) []u8 {
  if response.started || response.finished || capacity == 0 ||
    #len(response.reserved) != 0 || response.reserve_body == nil || response.commit_body == nil {
    empty: []u8
    return empty
  }
  response.reserved = response.reserve_body(response.output.data, capacity)
  return response.reserved
}

// Commit the initialized prefix of body_buffer without copying its body.
// Invalid options/length leave the reservation available for correction.
pub fn respond_buffered(status: *fail.Status, response: *Response, length: usize, options: ResponseOptions) {
  if status.failed { return }
  if response.commit_body == nil || #len(response.reserved) == 0 || length > #len(response.reserved) {
    response_invalid(status, "the length is past the body_buffer storage")
    return
  }
  response_begin(status, response, options, length, false, "", true)
  if !status.failed {
    response.finished = true
  }
}

// Writes the whole response: head and body.
pub fn respond(status: *fail.Status, response: *Response, body: []const u8, options: ResponseOptions) {
  response_begin(status, response, options, #len(body), false, body, false)
  if response.started {
    response.finished = true
  }
}

// Writes the head of a chunked response; write the body through body_writer
// and end it with body_finish.
pub fn respond_stream(status: *fail.Status, response: *Response, options: ResponseOptions) Body {
  response_begin(status, response, options, 0, true, "", false)
  if status.failed { return Body{ finished: true } }
  response.finished = true
  return Body{ output: response.output, discard: response.head_only }
}

fn hex_size(destination: []u8, value: usize) []const u8 {
  digits: []const u8 = "0123456789abcdef"
  end := #len(destination)
  number := value
  if number == 0 {
    destination[end - 1] = '0'
    return destination[end - 1..]
  }
  for number > 0 && end > 0 {
    end -= 1
    destination[end] = digits[number & 15]
    number >>= 4
  }
  if number != 0 { return destination[..0] }
  return destination[end..]
}

// Writes source to the client. A failure finishes the body.
fn body_output(status: *fail.Status, body: *Body, source: []const u8) {
  if body.discard { return }
  io.write(status, body.output, source)
  if status.failed {
    body.finished = true
  }
}

fn body_finished(status: *fail.Status) {
  fail.set(status, fail.make(fail.Kind.InvalidState, "write body", "", "the body is finished"))
}

fn body_write(data: rawptr, status: *fail.Status, source: []const u8) usize {
  body := #cast(*Body, data)
  if body.finished || body.output.write == nil {
    body_finished(status)
    return 0
  }
  if #len(source) == 0 { return 0 }
  size_storage: [16]u8
  size := hex_size(size_storage[..], #len(source))
  // A small chunk leaves in one write: four writes per chunk would each be a
  // segment, and stall on Nagle with delayed ACK.
  staging: [4 * memory.KiB]u8
  if #len(source) <= #len(staging) - #len(size) - 4 {
    used := append_bytes(staging[..], 0, size)
    used = append_bytes(staging[..], used, "\r\n")
    used = append_bytes(staging[..], used, source)
    used = append_bytes(staging[..], used, "\r\n")
    body_output(status, body, staging[..used])
  } else {
    body_output(status, body, size)
    body_output(status, body, "\r\n")
    body_output(status, body, source)
    body_output(status, body, "\r\n")
  }
  if status.failed { return 0 }
  return #len(source)
}

// Borrows a stable Body slot: do not move or destroy it during the writer's lifetime.
pub fn body_writer(body: *Body) io.Writer {
  return io.Writer{ data: body, write: body_write }
}

// Ends the body with the last chunk.
pub fn body_finish(status: *fail.Status, body: *Body) {
  if status.failed { return }
  if body.finished || body.output.write == nil {
    body_finished(status)
    return
  }
  body_output(status, body, "0\r\n\r\n")
  body.finished = true
}

// Stops the body without the last chunk, so the client sees it cut short.
pub fn body_abort(body: *Body) {
  body.finished = true
}

// Serves HTTP/1.1 on one stream until the client closes or a request fails,
// one request at a time on the calling thread. For a single-threaded or
// embedded server, and for tests; evented is the multi-connection server.
// Every Request carries context, borrowed application state the handler casts
// back to its own type (http.bind does that cast). The caller keeps it alive.
// A handler's failure ends serving, with that failure in status; when the
// handler had not responded, the client gets 500 first.
pub fn serve_stream(status: *fail.Status, input: io.Reader, output: io.Writer, storage: []u8, handler: Handler, context: rawptr) {
  if status.failed { return }
  if handler == nil || #len(storage) == 0 {
    fail.invalid(status, "serve", "", "serving needs a handler and storage")
    return
  }
  state := server(input, output, storage)
  state.context = context
  for !status.failed {
    received := receive(status, &state)
    if received.ended { return }
    if status.failed {
      // Tell the client why the connection closes. The reply is best effort:
      // the receive failure is reported either way.
      kind := status.failure.kind
      if kind == fail.Kind.InvalidInput || kind == fail.Kind.Capacity {
        rejected := Response{ output: output }
        options := ResponseOptions{ status: StatusBadRequest, content_type: "text/plain; charset=utf-8", close_connection: true }
        body := "bad request\n"
        if kind == fail.Kind.Capacity {
          options.status = StatusPayloadTooLarge
          body = "request too large\n"
        }
        reply: fail.Status
        respond(&reply, &rejected, body, options)
      }
      return
    }
    handler(status, &received.response, &received.request)
    if status.failed && !received.response.started {
      received.response.closing = true
      answering: fail.Status
      respond(&answering, &received.response, "internal server error\n", ResponseOptions{ status: StatusInternalServerError,
        content_type: "text/plain; charset=utf-8" })
    }
    if !received.request.keep_alive { return }
  }
}

// Complete exchange; returned response slices belong to arena. Failures rewind.
pub fn client_do(arena: *memory.Arena, status: *fail.Status, input: io.Reader, output: io.Writer,
  method: []const u8, target: []const u8, host: []const u8, body: []const u8) ClientResponse {
  if status.failed { return ClientResponse{} }
  validate_borrow(arena, method)
  validate_borrow(arena, target)
  validate_borrow(arena, host)
  validate_borrow(arena, body)
  mark := memory.arena_mark(arena)
  request_bytes := write_request(arena, method, target, host, body)
  io.write(status, output, request_bytes)
  memory.arena_rewind(arena, mark)
  result := client_receive(arena, status, input, method)
  if status.failed {
    memory.arena_rewind(arena, mark)
    return ClientResponse{}
  }
  return result
}

fn client_failed(status: *fail.Status, message: []const u8, offset: usize) ClientResponse {
  malformed(status, "receive response", message, offset)
  return ClientResponse{}
}

fn client_receive(arena: *memory.Arena, status: *fail.Status, input: io.Reader, method: []const u8) ClientResponse {
  if status.failed { return ClientResponse{} }
  // The response is the arena's last allocation: it grows by moving into a
  // larger one, and completion rewinds the arena to its end.
  response_storage: []u8
  used: usize = 0
  ended := false
  head := HttpHead{}
  head_scan: usize = 0
  head_checked := false
  chunks := ChunkProgress{}
  for {
    if !head_checked && head_complete(response_storage[..used], &head_scan) {
      parsed := http_parse_head(response_storage[..used], true)
      head = parsed.head
      head_checked = true
      if parsed.failed { return client_failed(status, "malformed response head", parsed.offset) }
    }
    if head_checked {
      if head.code >= 100 && head.code < 200 && head.code != 101 {
        remaining := used - head.header_length
        for i in 0..remaining {
          response_storage[i] = response_storage[head.header_length + i]
        }
        used = remaining
        response_mark := memory.arena_mark(arena) - #len(response_storage)
        memory.arena_rewind(arena, response_mark + used)
        response_storage = response_storage[..used]
        head = HttpHead{}
        head_scan = 0
        head_checked = false
        continue
      }
      framing := head.framing
      if bytes.equal(method, "HEAD") || (bytes.equal(method, "CONNECT") && head.code >= 200 && head.code < 300) {
        framing = Framing.None
      }
      body_length: usize = 0
      complete := framing == Framing.None
      if framing == Framing.Length {
        body_length = head.content_length
        complete = used - head.header_length >= body_length
      } else if framing == Framing.Close {
        body_length = used - head.header_length
        complete = ended
      } else if framing == Framing.Chunked {
        scanned := chunk_progress(&chunks, response_storage[head.header_length..used])
        decoded := scanned
        if scanned.scan == Scan.Done {
          decoded = scan_chunked(response_storage[head.header_length..used], response_storage[head.header_length..], true)
        }
        if decoded.scan == Scan.Done {
          body_length = decoded.count
          complete = true
        } else if decoded.scan != Scan.More {
          return client_failed(status, "malformed chunked body", head.header_length + decoded.offset)
        }
      }
      if complete {
        total := head.header_length + body_length
        // Growth can move the response into a later block, so its start is
        // unrelated to the exchange's rollback entry mark.
        response_mark := memory.arena_mark(arena) - #len(response_storage)
        memory.arena_rewind(arena, response_mark + total)
        return ClientResponse{ raw: response_storage[..total], body: response_storage[head.header_length..total], status: head.code }
      }
    }
    if ended { return client_failed(status, "the response ends early", used) }
    if #len(response_storage) - used < 4096 {
      grown := memory.push_bytes(arena, 2 * #len(response_storage) + 4096)
      _ = memory.copy(grown, response_storage[..used])
      response_storage = grown
    }
    count := io.read(status, input, response_storage[used..])
    if status.failed { return ClientResponse{} }
    used += count
    ended = count == 0
  }
  return ClientResponse{}
}

pub fn client_do_connection(arena: *memory.Arena, status: *fail.Status, connection: *network.Connection,
  method: []const u8, target: []const u8, host: []const u8, body: []const u8) ClientResponse {
  return client_do(arena, status, network.connection_reader(connection), network.connection_writer(connection),
    method, target, host, body)
}

// A complete HTTP/1.1 request with Connection: close, in arena.
pub fn write_request(arena: *memory.Arena, method: []const u8, target: []const u8, host: []const u8, body: []const u8) []u8 {
  validate_borrow(arena, method)
  validate_borrow(arena, target)
  validate_borrow(arena, host)
  validate_borrow(arena, body)
  digits: usize = 1
  number := #len(body)
  for number >= 10 {
    digits += 1
    number /= 10
  }
  size: usize = 59 + digits
  if #len(target) > 0 && target[0] == '?' {
    size += 1
  }
  for length in [#len(method), #len(target), #len(host), #len(body)] {
    if length > #max(usize) - size {
      #panic("HTTP request size overflows")
    }
    size += length
  }
  mark := memory.arena_mark(arena)
  space := memory.push_bytes(arena, size)
  output := request_into(space, method, target, host, body)
  memory.arena_rewind(arena, mark + #len(output))
  return output
}

// A complete HTTP/1.1 response with Connection: close, in arena.
pub fn write_response(arena: *memory.Arena, code: u16, reason: []const u8, content_type: []const u8, body: []const u8) []u8 {
  size: usize = 96 + #len(reason) + #len(content_type) + #len(body)
  mark := memory.arena_mark(arena)
  space := memory.push_bytes(arena, size)
  output := response_into(space, code, reason, content_type, body)
  memory.arena_rewind(arena, mark + #len(output))
  return output
}
