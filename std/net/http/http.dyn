use "std/errors" errors
use "std/mem" memory
use "std/io" stream
use "std/net" network
use "std/bytes" bytes
use "std/fmt" format
use "std/net/url" urls

pub type StreamReader = stream.Reader
pub type StreamWriter = stream.Writer
pub type StreamResult = stream.Result
pub type Listener = network.Listener
pub type Connection = network.Connection

pub struct AcceptResult { value: Connection, error: isize, kind: errors.Kind, ok: bool }

pub fn accept(listener: *Listener) AcceptResult {
  accepted := network.listener_accept(listener)
  return AcceptResult{ value: accepted.value, error: accepted.error, kind: accepted.kind, ok: accepted.ok }
}
pub fn close(connection: *Connection) Result {
  result := network.connection_close(connection)
  return Result{ error: result.error, kind: result.kind, ok: result.ok }
}

pub enum Framing { None, Length, Chunked, Close }
// Parser offsets are byte positions in the supplied input; zero also denotes an
// unavailable position for semantic URL/upgrade validation without a source cursor.
pub struct HttpHead {
  kind: errors.Kind, error: isize, offset: usize,
  framing: Framing,
  code: u16,
  header_length: usize,
  content_length: usize,
  keep_alive: bool,
  chunked: bool,
  ok: bool,
}
pub struct HttpHeader { kind: errors.Kind, error: isize, offset: usize, name: []const u8, value: []const u8, ok: bool }
pub struct Url { kind: errors.Kind, error: isize, offset: usize, scheme: []const u8, host: []const u8, port: u16, target: []const u8, secure: bool, ok: bool }

pub struct HttpIoResult {
  value: []u8,
  kind: errors.Kind,
  offset: usize,
  consumed: usize,
  count: usize,
  error: isize,
  ok: bool,
}

fn append_bytes(destination: []u8, offset: usize, source: []const u8) usize {
  if offset > #len(destination) || #len(source) > #len(destination) - offset {
    return #len(destination) + 1
  }
  for i in 0..#len(source) {
    destination[offset + i] = source[i]
  }
  return offset + #len(source)
}

fn append_usize(destination: []u8, offset: usize, value: usize) usize {
  digits: [20 + memory.ArenaBufferOverhead]u8 = []
  scratch := memory.arena_from_buffer(digits[..])
  return append_bytes(destination, offset, format.u64_decimal(scratch, #cast(u64, value)))
}

fn request_into(destination: []u8, method: []const u8, target: []const u8, host: []const u8, body: []const u8) []u8 {
  offset := append_bytes(destination, 0, method)
  offset = append_bytes(destination, offset, " ")
  if #len(target) > 0 && target[0] == '?' {
    offset = append_bytes(destination, offset, "/")
  }
  offset = append_bytes(destination, offset, target)
  offset = append_bytes(destination, offset, " HTTP/1.1\r\nHost: ")
  offset = append_bytes(destination, offset, host)
  offset = append_bytes(destination, offset, "\r\nConnection: close\r\nContent-Length: ")
  offset = append_usize(destination, offset, #len(body))
  offset = append_bytes(destination, offset, "\r\n\r\n")
  offset = append_bytes(destination, offset, body)
  if offset > #len(destination) {
    return destination[..0]
  }
  return destination[..offset]
}

fn response_into(destination: []u8, code: u16, reason: []const u8, content_type: []const u8, body: []const u8) []u8 {
  offset := append_bytes(destination, 0, "HTTP/1.1 ")
  offset = append_usize(destination, offset, #cast(usize, code))
  offset = append_bytes(destination, offset, " ")
  offset = append_bytes(destination, offset, reason)
  offset = append_bytes(destination, offset, "\r\nContent-Type: ")
  offset = append_bytes(destination, offset, content_type)
  offset = append_bytes(destination, offset, "\r\nConnection: close\r\nContent-Length: ")
  offset = append_usize(destination, offset, #len(body))
  offset = append_bytes(destination, offset, "\r\n\r\n")
  offset = append_bytes(destination, offset, body)
  if offset > #len(destination) {
    return destination[..0]
  }
  return destination[..offset]
}

fn ascii_lower(value: u8) u8 {
  if value >= 'A' && value <= 'Z' {
    return value + 32
  }
  return value
}

fn starts_ascii_case(input: []const u8, at: usize, expected: []const u8) bool {
  if at > #len(input) || #len(expected) > #len(input) - at {
    return false
  }
  for i in 0..#len(expected) {
    if ascii_lower(input[at + i]) != ascii_lower(expected[i]) {
      return false
    }
  }
  return true
}

struct Decimal { value: usize, offset: usize, ok: bool }

fn parse_decimal(input: []const u8, start: usize, end: usize) Decimal {
  value: usize = 0
  i := start
  if start == end {
    return Decimal{ offset: i }
  }
  for i < end {
    if input[i] < '0' || input[i] > '9' {
      return Decimal{ offset: i }
    }
    digit := #cast(usize, (input[i] - '0'))
    if value > (~#cast(usize, 0) - digit) / 10 {
      return Decimal{ offset: i }
    }
    value = value * 10 + digit
    i += 1
  }
  return Decimal{ value: value, ok: true }
}

fn ascii_equal(left: []const u8, right: []const u8) bool {
  return #len(left) == #len(right) && starts_ascii_case(left, 0, right)
}
fn trim_ows(value: []const u8) []const u8 {
  first: usize = 0
  last := #len(value)
  for first < last && (value[first] == ' ' || value[first] == '\t') {
    first += 1
  }
  for last > first && (value[last - 1] == ' ' || value[last - 1] == '\t') {
    last -= 1
  }
  return value[first..last]
}
fn token_byte(byte: u8) bool {
  return (byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z') ||
    (byte >= '0' && byte <= '9') || byte == '!' || byte == '#' || byte == '$' || byte == '%' ||
    byte == '&' || byte == 39 || byte == '*' || byte == '+' || byte == '-' || byte == '.' ||
    byte == '^' || byte == '_' || byte == '`' || byte == '|' || byte == '~'
}
fn http_parse_head(input: []const u8, response: bool) HttpHead {
  line_end: usize = 0
  for line_end + 1 < #len(input) && !(input[line_end] == '\r' && input[line_end + 1] == '\n') {
    line_end += 1
  }
  if line_end + 1 >= #len(input) {
    return HttpHead{ kind: errors.Kind.InvalidInput, offset: #len(input) }
  }
  code: u16 = 0
  version := input[..0]
  version_at: usize = 0
  if response {
    if line_end < 12 {
      return HttpHead{ kind: errors.Kind.InvalidInput, offset: line_end }
    }
    if input[8] != ' ' {
      return HttpHead{ kind: errors.Kind.InvalidInput, offset: 8 }
    }
    if input[12] != ' ' {
      return HttpHead{ kind: errors.Kind.InvalidInput, offset: 12 }
    }
    version = input[..8]
    parsed_code := parse_decimal(input, 9, 12)
    if !parsed_code.ok {
      return HttpHead{ kind: errors.Kind.InvalidInput, offset: parsed_code.offset }
    }
    if parsed_code.value < 100 || parsed_code.value > 999 {
      return HttpHead{ kind: errors.Kind.InvalidInput, offset: 9 }
    }
    code = #cast(u16, parsed_code.value)
  } else {
    first: usize = 0
    for first < line_end && token_byte(input[first]) {
      first += 1
    }
    if first == 0 || first >= line_end || input[first] != ' ' {
      return HttpHead{ kind: errors.Kind.InvalidInput, offset: first }
    }
    second := first + 1
    for second < line_end && input[second] > 32 && input[second] != 127 {
      second += 1
    }
    if second == first + 1 || second >= line_end || input[second] != ' ' {
      return HttpHead{ kind: errors.Kind.InvalidInput, offset: second }
    }
    version_at = second + 1
    version = input[version_at..line_end]
  }
  if !bytes.equal(version, "HTTP/1.1") && !bytes.equal(version, "HTTP/1.0") {
    bad: usize = 0
    expected: []const u8 = "HTTP/1.1"
    for bad < #len(version) && bad < #len(expected) && version[bad] == expected[bad] {
      bad += 1
    }
    return HttpHead{ kind: errors.Kind.InvalidInput, offset: version_at + bad }
  }
  cursor := line_end + 2
  content_length: usize = 0
  keep_alive := bytes.equal(version, "HTTP/1.1")
  close_requested := false
  chunked := false
  has_length := false
  has_transfer := false
  for cursor + 1 < #len(input) {
    if input[cursor] == '\r' && input[cursor + 1] == '\n' {
      if has_transfer && has_length {
        return HttpHead{ kind: errors.Kind.InvalidInput, offset: cursor }
      }
      framing := Framing.None
      if chunked {
        framing = Framing.Chunked
      }
      else if has_length {
        framing = Framing.Length
      }
      else if response {
        framing = Framing.Close
      }
      if response && (code < 200 || code == 204 || code == 304) {
        framing = Framing.None
      }
      return HttpHead{ code: code, header_length: cursor + 2, content_length: content_length,
        keep_alive: keep_alive && !close_requested, chunked: chunked, framing: framing, ok: true }
    }
    end := cursor
    for end + 1 < #len(input) && !(input[end] == '\r' && input[end + 1] == '\n') {
      end += 1
    }
    if end + 1 >= #len(input) {
      return HttpHead{ kind: errors.Kind.InvalidInput, offset: #len(input) }
    }
    colon := cursor
    for colon < end && token_byte(input[colon]) {
      colon += 1
    }
    if colon == cursor || colon == end || input[colon] != ':' {
      return HttpHead{ kind: errors.Kind.InvalidInput, offset: colon }
    }
    value_at := colon + 1
    for value_at < end && (input[value_at] == ' ' || input[value_at] == '\t') {
      value_at += 1
    }
    value := trim_ows(input[value_at..end])
    for value_i in 0..#len(value) {
      byte := value[value_i]
      if (byte < 32 && byte != '\t') || byte == 127 {
        return HttpHead{ kind: errors.Kind.InvalidInput, offset: value_at + value_i }
      }
    }
    name := input[cursor..colon]
    if ascii_equal(name, "Content-Length") {
      parsed_length := parse_decimal(value, 0, #len(value))
      if !parsed_length.ok {
        return HttpHead{ kind: errors.Kind.InvalidInput, offset: value_at + parsed_length.offset }
      }
      if has_length && content_length != parsed_length.value {
        return HttpHead{ kind: errors.Kind.InvalidInput, offset: value_at }
      }
      content_length = parsed_length.value
      has_length = true
    } else if ascii_equal(name, "Transfer-Encoding") {
      // Only chunked is implemented. Never silently ignore unknown codings.
      if has_transfer || !ascii_equal(value, "chunked") {
        return HttpHead{ kind: errors.Kind.InvalidInput, offset: value_at }
      }
      has_transfer = true
      chunked = true
    } else if ascii_equal(name, "Connection") {
      at: usize = 0
      for at < #len(value) {
        finish := at
        for finish < #len(value) && value[finish] != ',' {
          finish += 1
        }
        item := trim_ows(value[at..finish])
        if #len(item) == 0 {
          return HttpHead{ kind: errors.Kind.InvalidInput, offset: value_at + at }
        }
        item_at := at
        for item_at < finish && (value[item_at] == ' ' || value[item_at] == '\t') {
          item_at += 1
        }
        for item_i in 0..#len(item) {
          if !token_byte(item[item_i]) {
            return HttpHead{ kind: errors.Kind.InvalidInput, offset: value_at + item_at + item_i }
          }
        }
        if ascii_equal(item, "close") {
          close_requested = true
        }
        if ascii_equal(item, "keep-alive") {
          keep_alive = true
        }
        at = finish
        if at < #len(value) {
          at += 1
        }
      }
    }
    cursor = end + 2
  }
  return HttpHead{ kind: errors.Kind.InvalidInput, offset: cursor }
}

pub fn parse_response(input: []const u8) HttpHead {
  return http_parse_head(input, true)
}
pub fn parse_request(input: []const u8) HttpHead {
  return http_parse_head(input, false)
}

pub fn header(input: []const u8, name: []const u8) HttpHeader {
  head := http_parse_head(input, starts_ascii_case(input, 0, "HTTP/"))
  if !head.ok {
    return HttpHeader{ kind: head.kind, error: head.error, offset: head.offset }
  }
  cursor: usize = 0
  for cursor + 1 < head.header_length && !(input[cursor] == '\r' && input[cursor + 1] == '\n') {
    cursor += 1
  }
  cursor += 2
  for cursor + 1 < head.header_length {
    end := cursor
    for end + 1 < head.header_length && !(input[end] == '\r' && input[end + 1] == '\n') {
      end += 1
    }
    colon := cursor
    for colon < end && input[colon] != ':' {
      colon += 1
    }
    if colon - cursor == #len(name) && starts_ascii_case(input, cursor, name) {
      value := colon + 1
      for value < end && (input[value] == ' ' || input[value] == '\t') {
        value += 1
      }
      return HttpHeader{ name: input[cursor..colon], value: input[value..end], ok: true }
    }
    cursor = end + 2
  }
  return HttpHeader{ kind: errors.Kind.NotFound }
}

fn hex(value: u8) i16 {
  if value >= '0' && value <= '9' {
    return #cast(i16, (value - '0'))
  }
  lower := ascii_lower(value)
  if lower >= 'a' && lower <= 'f' {
    return #cast(i16, (lower - 'a' + 10))
  }
  return -1
}

// Decodes a complete chunked body into caller storage. Extensions are skipped.
// Cursors advance only over validated framing; buffered payload stays encoded
// until the whole message has been validated and can be decoded in place.
struct ChunkProgress { cursor: usize, line_scan: usize, count: usize, size: usize, phase: u8, digits: bool, extension: bool }
fn chunk_progress(state: *ChunkProgress, input: []const u8) HttpIoResult {
  for {
    if state.phase == 1 {
      if state.size > #len(input) - state.cursor {
        return HttpIoResult{ kind: errors.Kind.WouldBlock, offset: #len(input), error: 0 }
      }
      end := state.cursor + state.size
      if #len(input) - end < 2 {
        return HttpIoResult{ kind: errors.Kind.WouldBlock, offset: #len(input), error: 0 }
      }
      if input[end] != '\r' {
        return HttpIoResult{ kind: errors.Kind.InvalidInput, offset: end, error: 0 }
      }
      if input[end + 1] != '\n' {
        return HttpIoResult{ kind: errors.Kind.InvalidInput, offset: end + 1, error: 0 }
      }
      if state.size > ~#cast(usize, 0) - state.count {
        return HttpIoResult{ kind: errors.Kind.Capacity, offset: state.line_scan, error: 0 }
      }
      state.count += state.size
      state.cursor = end + 2
      state.line_scan = state.cursor
      state.size = 0
      state.digits = false
      state.extension = false
      state.phase = 0
    }
    if state.phase == 0 {
      for state.line_scan < #len(input) && input[state.line_scan] != '\r' {
        byte := input[state.line_scan]
        if !state.extension && byte != ';' {
          value := hex(byte)
          if value < 0 || state.size > (~#cast(usize, 0) - #cast(usize, value)) / 16 {
            return HttpIoResult{ kind: errors.Kind.InvalidInput, offset: state.line_scan, error: 0 }
          }
          state.size = state.size * 16 + #cast(usize, value)
          state.digits = true
        } else {
          if !state.digits || byte < 32 || byte == 127 {
            return HttpIoResult{ kind: errors.Kind.InvalidInput, offset: state.line_scan, error: 0 }
          }
          state.extension = true
        }
        state.line_scan += 1
      }
      if state.line_scan == #len(input) {
        return HttpIoResult{ kind: errors.Kind.WouldBlock, offset: #len(input), error: 0 }
      }
      if !state.digits {
        return HttpIoResult{ kind: errors.Kind.InvalidInput, offset: state.line_scan, error: 0 }
      }
      if state.line_scan + 1 >= #len(input) {
        return HttpIoResult{ kind: errors.Kind.WouldBlock, offset: #len(input), error: 0 }
      }
      if input[state.line_scan + 1] != '\n' {
        return HttpIoResult{ kind: errors.Kind.InvalidInput, offset: state.line_scan + 1, error: 0 }
      }
      state.cursor = state.line_scan + 2
      state.line_scan = state.cursor
      state.phase = 1
      if state.size == 0 {
        state.phase = 2
      }
    } else {
      for state.line_scan + 1 < #len(input) && !(input[state.line_scan] == '\r' && input[state.line_scan + 1] == '\n') {
        state.line_scan += 1
      }
      if state.line_scan + 1 >= #len(input) {
        return HttpIoResult{ kind: errors.Kind.WouldBlock, offset: #len(input), error: 0 }
      }
      end := state.line_scan
      if end == state.cursor {
        return HttpIoResult{ count: state.count, consumed: end + 2, ok: true }
      }
      colon := state.cursor
      for colon < end && token_byte(input[colon]) {
        colon += 1
      }
      if colon == state.cursor || colon == end || input[colon] != ':' {
        return HttpIoResult{ kind: errors.Kind.InvalidInput, offset: colon, error: 0 }
      }
      for value_at in colon + 1..end {
        byte := input[value_at]
        if (byte < 32 && byte != '\t') || byte == 127 {
          return HttpIoResult{ kind: errors.Kind.InvalidInput, offset: value_at, error: 0 }
        }
      }
      if ascii_equal(input[state.cursor..colon], "Content-Length") || ascii_equal(input[state.cursor..colon], "Transfer-Encoding") {
        return HttpIoResult{ kind: errors.Kind.InvalidInput, offset: state.cursor, error: 0 }
      }
      state.cursor = end + 2
      state.line_scan = state.cursor
    }
  }
  return HttpIoResult{}
}

// Retain the last three bytes so a header terminator may cross reads.
fn head_complete(input: []const u8, cursor: *usize) bool {
  for cursor.* + 3 < #len(input) {
    at := cursor.*
    if input[at] == '\r' && input[at + 1] == '\n' && input[at + 2] == '\r' && input[at + 3] == '\n' {
      return true
    }
    cursor.* += 1
  }
  return false
}

fn scan_chunked(input: []const u8, destination: []u8, write: bool) HttpIoResult {
  cursor: usize = 0
  output: usize = 0
  for {
    size: usize = 0
    digits: usize = 0
    for cursor < #len(input) && input[cursor] != '\r' && input[cursor] != ';' {
      value := hex(input[cursor])
      if value < 0 || size > (~#cast(usize, 0) - #cast(usize, value)) / 16 {
        return HttpIoResult{ kind: errors.Kind.InvalidInput, offset: cursor, error: 0 }
      }
      size = size * 16 + #cast(usize, value)
      cursor += 1
      digits += 1
    }
    if cursor == #len(input) {
      return HttpIoResult{ kind: errors.Kind.WouldBlock, offset: #len(input), error: 0 }
    }
    if digits == 0 {
      return HttpIoResult{ kind: errors.Kind.InvalidInput, offset: cursor, error: 0 }
    }
    for cursor < #len(input) && input[cursor] != '\r' {
      if input[cursor] < 32 || input[cursor] == 127 {
        return HttpIoResult{ kind: errors.Kind.InvalidInput, offset: cursor, error: 0 }
      }
      cursor += 1
    }
    if cursor + 1 >= #len(input) {
      return HttpIoResult{ kind: errors.Kind.WouldBlock, offset: #len(input), error: 0 }
    }
    if input[cursor + 1] != '\n' {
      return HttpIoResult{ kind: errors.Kind.InvalidInput, offset: cursor + 1, error: 0 }
    }
    cursor += 2
    if size == 0 {
      for {
        end := cursor
        for end + 1 < #len(input) && !(input[end] == '\r' && input[end + 1] == '\n') {
          end += 1
        }
        if end + 1 >= #len(input) {
          return HttpIoResult{ kind: errors.Kind.WouldBlock, offset: #len(input), error: 0 }
        }
        if end == cursor {
          return HttpIoResult{ count: output, consumed: end + 2, ok: true }
        }
        colon := cursor
        for colon < end && token_byte(input[colon]) {
          colon += 1
        }
        if colon == cursor || colon == end || input[colon] != ':' {
          return HttpIoResult{ kind: errors.Kind.InvalidInput, offset: colon, error: 0 }
        }
        for value_at in colon + 1..end {
          byte := input[value_at]
          if (byte < 32 && byte != '\t') || byte == 127 {
            return HttpIoResult{ kind: errors.Kind.InvalidInput, offset: value_at, error: 0 }
          }
        }
        if ascii_equal(input[cursor..colon], "Content-Length") || ascii_equal(input[cursor..colon], "Transfer-Encoding") {
          return HttpIoResult{ kind: errors.Kind.InvalidInput, offset: cursor, error: 0 }
        }
        cursor = end + 2
      }
    }
    if size > #len(input) - cursor {
      return HttpIoResult{ kind: errors.Kind.WouldBlock, offset: #len(input), error: 0 }
    }
    if size > ~#cast(usize, 0) - output {
      return HttpIoResult{ kind: errors.Kind.Capacity, offset: cursor, error: 0 }
    }
    if write {
      if size > #len(destination) - output {
        return HttpIoResult{ kind: errors.Kind.Capacity, offset: cursor, error: 0 }
      }
      for i in 0..size {
        destination[output + i] = input[cursor + i]
      }
    }
    cursor += size
    output += size
    if cursor + 1 >= #len(input) {
      return HttpIoResult{ kind: errors.Kind.WouldBlock, offset: #len(input), error: 0 }
    }
    if input[cursor] != '\r' {
      return HttpIoResult{ kind: errors.Kind.InvalidInput, offset: cursor, error: 0 }
    }
    if input[cursor + 1] != '\n' {
      return HttpIoResult{ kind: errors.Kind.InvalidInput, offset: cursor + 1, error: 0 }
    }
    cursor += 2
  }
  return HttpIoResult{}
}
// Borrowed inputs may live below the mark, but must not overlap future writes.
fn validate_borrow(arena: *memory.Arena, input: []const u8) {
  if memory.arena_overlaps_unallocated(arena, input) {
    #panic("HTTP input overlaps arena output")
  }
}

// Validate the complete wire before allocating or writing decoded payload.
pub fn decode_chunked(arena: *memory.Arena, input: []const u8) HttpIoResult {
  validate_borrow(arena, input)
  scanned := scan_chunked(input, arena.data[..0], false)
  if !scanned.ok {
    return scanned
  }
  destination := memory.push_bytes_uninit(arena, scanned.count)
  decoded := scan_chunked(input[..scanned.consumed], destination, true)
  decoded.value = destination
  return decoded
}

pub fn parse_url(input: []const u8) Url {
  parsed := urls.parse(input)
  if !parsed.ok {
    return Url{ kind: parsed.kind, error: parsed.error, offset: parsed.offset }
  }
  value := parsed.value
  secure := ascii_equal(value.scheme, "https")
  if !secure && !ascii_equal(value.scheme, "http") {
    return Url{ kind: errors.Kind.InvalidInput }
  }
  authority_at := #len(value.scheme) + 3
  authority := value.authority
  if #len(authority) == 0 || bytes.find_byte(authority, '@') < #len(authority) {
    return Url{ kind: errors.Kind.InvalidInput, offset: authority_at + bytes.find_byte(authority, '@') }
  }
  host_end := #len(authority)
  port_start := #len(authority)
  host_start: usize = 0
  if authority[0] == '[' {
    bracket := bytes.find_byte(authority, ']')
    if bracket <= 1 || bracket == #len(authority) {
      return Url{ kind: errors.Kind.InvalidInput, offset: authority_at + bracket }
    }
    host_start = 1
    host_end = bracket
    if host_end + 1 < #len(authority) {
      if authority[host_end + 1] != ':' {
        return Url{ kind: errors.Kind.InvalidInput, offset: authority_at + host_end + 1 }
      }
      port_start = host_end + 2
    }
  } else {
    colon := bytes.find_byte(authority, ':')
    if colon < #len(authority) {
      host_end = colon
      port_start = host_end + 1
    }
  }
  if host_end == host_start {
    return Url{ kind: errors.Kind.InvalidInput, offset: authority_at + host_start }
  }
  port: u16 = 80
  if secure {
    port = 443
  }
  if port_start < #len(authority) {
    number := parse_decimal(authority, port_start, #len(authority))
    if !number.ok {
      return Url{ kind: errors.Kind.InvalidInput, offset: authority_at + number.offset }
    }
    if number.value == 0 || number.value > 65535 {
      return Url{ kind: errors.Kind.InvalidInput, offset: authority_at + port_start }
    }
    port = #cast(u16, number.value)
  } else if authority[#len(authority) - 1] == ':' {
    return Url{ kind: errors.Kind.InvalidInput, offset: authority_at + #len(authority) }
  }
  target: []const u8 = "/"
  // Borrow the original suffix to retain query bytes; fragments are never sent.
  path_at := #len(value.scheme) + 3 + #len(authority)
  end := #len(input)
  end = path_at + bytes.find_byte(input[path_at..], '#')
  if path_at < end {
    target = input[path_at..end]
  }
  return Url{ scheme: value.scheme, host: authority[host_start..host_end], port: port, target: target, secure: secure, ok: true }
}

pub const StatusOk: u16 = 200
pub const StatusNoContent: u16 = 204
pub const StatusBadRequest: u16 = 400
pub const StatusNotFound: u16 = 404
pub const StatusPayloadTooLarge: u16 = 413
pub const StatusInternalServerError: u16 = 500

pub enum ErrorKind { None, End, Invalid, Capacity, Io }
fn http_kind(detail: ErrorKind) errors.Kind {
  if detail == ErrorKind.Invalid {
    return errors.Kind.InvalidInput
  }
  if detail == ErrorKind.Capacity {
    return errors.Kind.Capacity
  }
  if detail == ErrorKind.Io {
    return errors.Kind.System
  }
  return errors.Kind.None
}

pub struct Request {
  raw: []const u8,
  method: []const u8,
  target: []const u8,
  body: []const u8,
  header_length: usize,
  keep_alive: bool,
  // Borrowed application state given to serve_stream_context and friends; nil otherwise.
  context: rawptr,
}

pub struct Response {
  failed: bool,
  first: Result,
  first_stream: stream.Result,
  output: stream.Writer,
  started: bool,
  finished: bool,
}

pub struct ResponseOptions {
  status: u16,
  reason: []const u8,
  content_type: []const u8,
  close_connection: bool,
}

pub struct Server {
  failed: bool,
  first: Result,
  ended: bool,
  input: stream.Reader,
  output: stream.Writer,
  storage: []u8,
  used: usize,
  consumed: usize,
  // Copied into every received Request.
  context: rawptr,
}

pub struct ReceiveResult {
  request: Request,
  response: Response,
  detail: ErrorKind,
  kind: errors.Kind,
  offset: usize,
  error: isize,
  ok: bool,
}

pub struct Result {
  detail: ErrorKind,
  kind: errors.Kind,
  offset: usize,
  error: isize,
  ok: bool,
}

pub struct Body {
  failed: bool,
  first: Result,
  first_stream: stream.Result,
  output: stream.Writer,
  finished: bool,
}

pub struct BodyResult {
  kind: errors.Kind, error: isize, detail: ErrorKind,
  body: Body,
  result: Result,
  ok: bool,
}

pub type Handler = fn(*Response, *const Request) Result

pub struct Route {
  method: []const u8,
  target: []const u8,
  handler: Handler,
}

pub struct Router {
  routes: []Route,
  count: usize,
  fallback: Handler,
}

pub struct ClientResponse {
  raw: []u8,
  body: []u8,
  status: u16,
  detail: ErrorKind,
  kind: errors.Kind,
  offset: usize,
  error: isize,
  ok: bool,
}


// Router storage is supplied by the caller. Route strings are borrowed.
pub fn router(storage: []Route, fallback: Handler) Router {
  return Router{ routes: storage, fallback: fallback }
}

pub fn route(state: *Router, method: []const u8, target: []const u8, handler: Handler) Result {
  if handler == nil {
    return Result{ kind: errors.Kind.InvalidInput, detail: ErrorKind.Invalid }
  }
  if state.count >= #len(state.routes) {
    return Result{ kind: errors.Kind.Capacity, detail: ErrorKind.Capacity }
  }
  state.routes[state.count] = Route{ method: method, target: target, handler: handler }
  state.count += 1
  return Result{ ok: true }
}

pub fn dispatch(state: *Router, response: *Response, request: *const Request) Result {
  i: usize = 0
  for i < state.count {
    candidate := state.routes[i]
    if bytes.equal(candidate.method, request.method) && bytes.equal(candidate.target, request.target) {
      return candidate.handler(response, request)
    }
    i += 1
  }
  if state.fallback != nil {
    return state.fallback(response, request)
  }
  return respond(response, "not found\n", ResponseOptions{ status: StatusNotFound, content_type: "text/plain; charset=utf-8" })
}

pub fn server(input: stream.Reader, output: stream.Writer, storage: []u8) Server {
  return Server{ input: input, output: output, storage: storage }
}

pub fn connection_server(input: stream.Reader, output: stream.Writer, storage: []u8) Server {
  return server(input, output, storage)
}

fn shift_consumed(state: *Server) {
  if state.consumed == 0 {
    return
  }
  remaining := state.used - state.consumed
  for i in 0..remaining {
    state.storage[i] = state.storage[state.consumed + i]
  }
  state.used = remaining
  state.consumed = 0
}

fn request_parts(input: []const u8, head: HttpHead) Request {
  line_end: usize = 0
  for line_end + 1 < head.header_length && !(input[line_end] == '\r' && input[line_end + 1] == '\n') {
    line_end += 1
  }
  first_space: usize = 0
  for first_space < line_end && input[first_space] != ' ' {
    first_space += 1
  }
  second_space := first_space + 1
  for second_space < line_end && input[second_space] != ' ' {
    second_space += 1
  }
  if first_space == 0 || second_space <= first_space + 1 || second_space >= line_end {
    return Request{}
  }
  total := head.header_length + head.content_length
  return Request{
    raw: input[..total],
    method: input[..first_space],
    target: input[first_space + 1..second_space],
    body: input[head.header_length..total],
    header_length: head.header_length,
    keep_alive: head.keep_alive,
  }
}

fn receive_failure(state: *Server, detail: ErrorKind, native: isize) ReceiveResult {
  if !state.failed {
    state.failed = true
    state.first = Result{ detail: detail, kind: http_kind(detail), error: native }
  }
  return ReceiveResult{ detail: state.first.detail, kind: state.first.kind, offset: state.first.offset, error: state.first.error }
}

// Returned request slices borrow state.storage and remain valid only until the next receive call.
pub fn receive(state: *Server) ReceiveResult {
  if state.failed {
    return receive_failure(state, ErrorKind.None, 0)
  }
  if state.used > #len(state.storage) || state.consumed > state.used || state.input.read == nil || state.output.write == nil {
    return receive_failure(state, ErrorKind.Invalid, 0)
  }
  shift_consumed(state)
  head := HttpHead{}
  head_scan: usize = 0
  head_checked := false
  for true {
    if !head_checked && head_complete(state.storage[..state.used], &head_scan) {
      head = parse_request(state.storage[..state.used])
      head_checked = true
      // More bytes cannot repair a complete head that does not parse.
      if !head.ok {
        failure := receive_failure(state, ErrorKind.Invalid, 0)
        state.first.offset = head.offset
        failure.offset = head.offset
        return failure
      }
    }
    if head.ok {
      if head.chunked {
        return receive_failure(state, ErrorKind.Invalid, 0)
      }
      if head.content_length > #len(state.storage) - head.header_length {
        return receive_failure(state, ErrorKind.Capacity, 0)
      }
      total := head.header_length + head.content_length
      if state.used >= total {
        request := request_parts(state.storage[..state.used], head)
        request.context = state.context
        if #len(request.method) == 0 {
          return receive_failure(state, ErrorKind.Invalid, 0)
        }
        state.consumed = total
        return ReceiveResult{
          request: request,
          response: Response{ output: state.output },
          detail: ErrorKind.None,
          error: 0,
          ok: true,
        }
      }
    }
    // End is a transport state until all buffered requests have been consumed.
    if state.ended {
      if state.used == 0 {
        return receive_failure(state, ErrorKind.End, 0)
      }
      failure := receive_failure(state, ErrorKind.Invalid, 0)
      state.first.offset = state.used
      failure.offset = state.used
      return failure
    }
    if state.used == #len(state.storage) {
      return receive_failure(state, ErrorKind.Capacity, 0)
    }
    input := stream.read(state.input, state.storage[state.used..])
    if input.transferred > #len(state.storage) - state.used {
      return receive_failure(state, ErrorKind.Io, 0)
    }
    state.used += input.transferred
    if input.status == stream.Status.Error {
      failure := receive_failure(state, ErrorKind.Io, input.error)
      state.first.kind = input.kind
      failure.kind = input.kind
      return failure
    }
    state.ended = input.status == stream.Status.End
    if input.transferred == 0 {
      if !state.ended {
        return receive_failure(state, ErrorKind.Io, 0)
      }
      if state.used == 0 {
        return receive_failure(state, ErrorKind.End, 0)
      }
      failure := receive_failure(state, ErrorKind.Invalid, 0)
      state.first.offset = state.used
      failure.offset = state.used
      return failure
    }
  }
  return ReceiveResult{}
}

fn status_reason(status: u16) []const u8 {
  if status == 200 {
    return "OK"
  }
  if status == 204 {
    return "No Content"
  }
  if status == 400 {
    return "Bad Request"
  }
  if status == 404 {
    return "Not Found"
  }
  if status == 413 {
    return "Payload Too Large"
  }
  if status == 500 {
    return "Internal Server Error"
  }
  return "Status"
}

fn decimal(destination: []u8, value: usize) []const u8 {
  digits: [20 + memory.ArenaBufferOverhead]u8 = []
  scratch := memory.arena_from_buffer(digits[..])
  text := format.u64_decimal(scratch, #cast(u64, value))
  if #len(text) > #len(destination) {
    return destination[..0]
  }
  for i in 0..#len(text) {
    destination[i] = text[i]
  }
  return destination[..#len(text)]
}

fn write_output(destination: stream.Writer, bytes: []const u8) Result {
  written := stream.write_all(destination, bytes)
  if written.status == stream.Status.Error {
    return Result{ kind: written.kind, detail: ErrorKind.Io, error: written.error, ok: false }
  }
  return Result{ detail: ErrorKind.None, ok: true }
}

fn response_failure(response: *Response, result: Result) Result {
  if !response.failed {
    response.failed = true
    response.first = result
    if response.first_stream.status != stream.Status.Error {
      response.first_stream = stream.Result{ error: 0, kind: errors.Kind.InvalidState, status: stream.Status.Error }
    }
  }
  return response.first
}

fn response_output(response: *Response, source: []const u8) Result {
  if response.failed {
    return response.first
  }
  written := stream.write_all(response.output, source)
  if written.status == stream.Status.Error {
    response.first_stream = stream.Result{ error: written.error, kind: written.kind, status: stream.Status.Error }
    return response_failure(response, Result{ kind: written.kind, detail: ErrorKind.Io, error: written.error })
  }
  return Result{ ok: true }
}

fn response_begin(response: *Response, options: ResponseOptions, body_length: usize, chunked: bool) Result {
  if response.failed {
    return response.first
  }
  if response.started || response.finished || response.output.write == nil {
    return response_failure(response, Result{ kind: errors.Kind.InvalidState, detail: ErrorKind.Invalid })
  }
  status := options.status
  if status == 0 {
    status = StatusOk
  }
  reason := options.reason
  if #len(reason) == 0 {
    reason = status_reason(status)
  }
  content_type := options.content_type
  if #len(content_type) == 0 {
    content_type = "application/octet-stream"
  }
  number_storage: [20]u8 = []
  status_text := decimal(number_storage[..], #cast(usize, status))
  if !response_output(response, "HTTP/1.1 ").ok || !response_output(response, status_text).ok ||
    !response_output(response, " ").ok || !response_output(response, reason).ok ||
    !response_output(response, "\r\nContent-Type: ").ok || !response_output(response, content_type).ok {
    return response.first
  }
  if chunked {
    if !response_output(response, "\r\nTransfer-Encoding: chunked").ok {
      return response.first
    }
  } else {
    length_text := decimal(number_storage[..], body_length)
    if !response_output(response, "\r\nContent-Length: ").ok || !response_output(response, length_text).ok {
      return response.first
    }
  }
  connection := "\r\nConnection: keep-alive\r\n\r\n"
  if options.close_connection {
    connection = "\r\nConnection: close\r\n\r\n"
  }
  result := response_output(response, connection)
  if result.ok {
    response.started = true
  }
  return result
}

pub fn respond(response: *Response, body: []const u8, options: ResponseOptions) Result {
  started := response_begin(response, options, #len(body), false)
  if !started.ok {
    return started
  }
  written := response_output(response, body)
  if written.ok {
    response.finished = true
  }
  return written
}

pub fn respond_stream(response: *Response, options: ResponseOptions) BodyResult {
  started := response_begin(response, options, 0, true)
  if !started.ok {
    return BodyResult{ kind: started.kind, error: started.error, detail: started.detail, body: Body{ failed: true, first: started, first_stream: response.first_stream }, result: started, ok: false }
  }
  response.finished = true
  return BodyResult{
    body: Body{ output: response.output },
    result: Result{ detail: ErrorKind.None, ok: true },
    ok: true,
  }
}

fn hex_size(destination: []u8, value: usize) []const u8 {
  digits: []const u8 = "0123456789abcdef"
  end := #len(destination)
  number := value
  if number == 0 {
    destination[end - 1] = '0'
    return destination[end - 1..]
  }
  for number > 0 && end > 0 {
    end -= 1
    destination[end] = digits[number & 15]
    number >>= 4
  }
  if number != 0 {
    return destination[..0]
  }
  return destination[end..]
}

fn body_failure(body: *Body, result: Result, native: stream.Result) Result {
  if !body.failed {
    body.failed = true
    body.first = result
    body.first_stream = stream.Result{ error: native.error, kind: native.kind, status: stream.Status.Error }
  }
  return body.first
}

fn body_invalid(body: *Body) Result {
  return body_failure(body, Result{ kind: errors.Kind.InvalidState, detail: ErrorKind.Invalid }, stream.Result{ error: 0, kind: errors.Kind.InvalidState, status: stream.Status.Error })
}

fn body_output(body: *Body, source: []const u8) stream.Result {
  if body.failed {
    return body.first_stream
  }
  result := stream.write_all(body.output, source)
  if result.status == stream.Status.Error {
    _ = body_failure(body, Result{ kind: result.kind, detail: ErrorKind.Io, error: result.error }, result)
  }
  return result
}

fn body_write(data: rawptr, source: []const u8) stream.Result {
  body := #cast(*Body, data)
  if body.failed {
    return body.first_stream
  }
  if body.finished || body.output.write == nil {
    _ = body_invalid(body)
    return body.first_stream
  }
  if #len(source) == 0 {
    return stream.Result{ status: stream.Status.Complete }
  }
  size_storage: [16]u8 = []
  size := hex_size(size_storage[..], #len(source))
  first := body_output(body, size)
  if first.status == stream.Status.Error {
    return first
  }
  separator := body_output(body, "\r\n")
  if separator.status == stream.Status.Error {
    return separator
  }
  content := body_output(body, source)
  if content.status == stream.Status.Error {
    return content
  }
  ending := body_output(body, "\r\n")
  if ending.status == stream.Status.Error {
    return ending
  }
  return stream.Result{ transferred: #len(source), status: stream.Status.Complete }
}

// Borrows a stable Body slot: do not move or destroy it during the writer's lifetime.
pub fn body_writer(body: *Body) stream.Writer {
  return stream.Writer{ data: body, write: body_write }
}

pub fn body_finish(body: *Body) Result {
  if body.failed {
    return body.first
  }
  if body.finished || body.output.write == nil {
    return body_invalid(body)
  }
  result := body_output(body, "0\r\n\r\n")
  if result.status == stream.Status.Error {
    return body.first
  }
  body.finished = true
  return Result{ ok: true }
}

pub fn body_abort(body: *Body) Result {
  if body.failed {
    return body.first
  }
  if body.output.write == nil {
    return body_invalid(body)
  }
  body.finished = true
  return Result{ detail: ErrorKind.None, ok: true }
}

pub fn serve_connection(connection: *network.Connection, storage: []u8, handler: Handler) Result {
  return serve_connection_context(connection, storage, handler, nil)
}

// Like serve_connection; every Request carries context for the handler.
pub fn serve_connection_context(connection: *network.Connection, storage: []u8, handler: Handler, context: rawptr) Result {
  return serve_stream_context(network.connection_reader(connection), network.connection_writer(connection), storage, handler, context)
}

// Stream seam shared by plain TCP, TLS, tests, and embedded transports.
pub fn serve_stream(input: stream.Reader, output: stream.Writer, storage: []u8, handler: Handler) Result {
  return serve_stream_context(input, output, storage, handler, nil)
}

// Like serve_stream; every Request carries context, borrowed application state
// the handler casts back to its own type. The caller keeps it alive.
pub fn serve_stream_context(input: stream.Reader, output: stream.Writer, storage: []u8, handler: Handler, context: rawptr) Result {
  if handler == nil || #len(storage) == 0 {
    return Result{ kind: errors.Kind.InvalidInput, detail: ErrorKind.Invalid, ok: false }
  }
  state := connection_server(input, output, storage)
  state.context = context
  for true {
    received := receive(&state)
    if !received.ok {
      if received.detail == ErrorKind.End {
        return Result{ detail: ErrorKind.None, ok: true }
      }
      // Tell the client why the connection closes. The reply is best effort:
      // the receive error is reported either way.
      if received.detail == ErrorKind.Invalid || received.detail == ErrorKind.Capacity {
        rejected := Response{ output: output }
        options := ResponseOptions{ status: StatusBadRequest, content_type: "text/plain; charset=utf-8", close_connection: true }
        body := "bad request\n"
        if received.detail == ErrorKind.Capacity {
          options.status = StatusPayloadTooLarge
          body = "request too large\n"
        }
        _ = respond(&rejected, body, options)
      }
      return Result{ detail: received.detail, kind: received.kind, offset: received.offset, error: received.error, ok: false }
    }
    handled := handler(&received.response, &received.request)
    if !handled.ok {
      return handled
    }
    if !received.request.keep_alive {
      return Result{ detail: ErrorKind.None, ok: true }
    }
  }
  return Result{ detail: ErrorKind.None, ok: true }
}

// Complete exchange; returned response slices belong to arena. Failures rewind.
pub fn client_do(arena: *memory.Arena, input: stream.Reader, output: stream.Writer,
  method: []const u8, target: []const u8, host: []const u8, body: []const u8) ClientResponse {
  validate_borrow(arena, method)
  validate_borrow(arena, target)
  validate_borrow(arena, host)
  validate_borrow(arena, body)
  mark := memory.arena_mark(arena)
  request_bytes := write_request(arena, method, target, host, body)
  sent := stream.write_all(output, request_bytes)
  memory.arena_rewind(arena, mark)
  if sent.status == stream.Status.Error {
    return ClientResponse{ kind: sent.kind, detail: ErrorKind.Io, error: sent.error }
  }
  result := client_receive(arena, input, method)
  if !result.ok {
    memory.arena_rewind(arena, mark)
  }
  return result
}

fn client_receive(arena: *memory.Arena, input: stream.Reader, method: []const u8) ClientResponse {
  response_storage := arena.data[..0]
  used: usize = 0
  ended := false
  head := HttpHead{}
  head_scan: usize = 0
  head_checked := false
  chunks := ChunkProgress{}
  for {
    if !head_checked && head_complete(response_storage[..used], &head_scan) {
      head = parse_response(response_storage[..used])
      head_checked = true
      if !head.ok {
        return ClientResponse{ kind: head.kind, error: head.error, offset: head.offset, detail: ErrorKind.Invalid }
      }
    }
    if head.ok {
      if head.code >= 100 && head.code < 200 && head.code != 101 {
        remaining := used - head.header_length
        for i in 0..remaining {
          response_storage[i] = response_storage[head.header_length + i]
        }
        used = remaining
        response_mark := memory.arena_mark(arena) - #len(response_storage)
        memory.arena_rewind(arena, response_mark + used)
        response_storage = response_storage[..used]
        head = HttpHead{}
        head_scan = 0
        head_checked = false
        continue
      }
      framing := head.framing
      if bytes.equal(method, "HEAD") || (bytes.equal(method, "CONNECT") && head.code >= 200 && head.code < 300) {
        framing = Framing.None
      }
      body_length: usize = 0
      complete := framing == Framing.None
      if framing == Framing.Length {
        body_length = head.content_length
        complete = used - head.header_length >= body_length
      } else if framing == Framing.Close {
        body_length = used - head.header_length
        complete = ended
      }
      else if framing == Framing.Chunked {
        scanned := chunk_progress(&chunks, response_storage[head.header_length..used])
        decoded := scanned
        if scanned.ok {
          decoded = scan_chunked(response_storage[head.header_length..used], response_storage[head.header_length..], true)
        }
        if decoded.ok {
          body_length = decoded.count
          complete = true
        }
        else if decoded.kind != errors.Kind.WouldBlock {
          return ClientResponse{ kind: decoded.kind, error: decoded.error, offset: head.header_length + decoded.offset, detail: ErrorKind.Invalid }
        }
      }
      if complete {
        total := head.header_length + body_length
        // append_many can move the contiguous response into a later block.
        // Its start is unrelated to the exchange's rollback entry mark.
        response_mark := memory.arena_mark(arena) - #len(response_storage)
        memory.arena_rewind(arena, response_mark + total)
        return ClientResponse{ raw: response_storage[..total], body: response_storage[head.header_length..total], status: head.code, ok: true }
      }
    }
    if ended {
      return ClientResponse{ kind: errors.Kind.InvalidInput, offset: used, detail: ErrorKind.Invalid }
    }
    scratch: [4096]u8 = []
    part := stream.read(input, scratch[..])
    if part.transferred > #len(scratch) {
      return ClientResponse{ kind: errors.Kind.System, detail: ErrorKind.Io }
    }
    if part.status == stream.Status.Error {
      return ClientResponse{ kind: part.kind, detail: ErrorKind.Io, error: part.error }
    }
    memory.append_many(arena, &response_storage, scratch[..part.transferred])
    used += part.transferred
    ended = part.status == stream.Status.End
    if part.transferred == 0 && !ended {
      return ClientResponse{ kind: errors.Kind.System, detail: ErrorKind.Io, error: 0 }
    }
  }
  return ClientResponse{}
}

pub fn client_do_connection(arena: *memory.Arena, connection: *network.Connection,
  method: []const u8, target: []const u8, host: []const u8, body: []const u8) ClientResponse {
  return client_do(arena, network.connection_reader(connection), network.connection_writer(connection),
    method, target, host, body)
}

// A complete HTTP/1.1 request with Connection: close, in arena.
pub fn write_request(arena: *memory.Arena, method: []const u8, target: []const u8, host: []const u8, body: []const u8) []u8 {
  validate_borrow(arena, method)
  validate_borrow(arena, target)
  validate_borrow(arena, host)
  validate_borrow(arena, body)
  digits: usize = 1
  number := #len(body)
  for number >= 10 {
    digits += 1
    number /= 10
  }
  size: usize = 59 + digits
  if #len(target) > 0 && target[0] == '?' {
    size += 1
  }
  for length in [#len(method), #len(target), #len(host), #len(body)] {
    if length > ~#cast(usize, 0) - size {
      #panic("HTTP request size overflows")
    }
    size += length
  }
  mark := memory.arena_mark(arena)
  space := memory.push_bytes_uninit(arena, size)
  output := request_into(space, method, target, host, body)
  memory.arena_rewind(arena, mark + #len(output))
  return output
}

// A complete HTTP/1.1 response with Connection: close, in arena.
pub fn write_response(arena: *memory.Arena, code: u16, reason: []const u8, content_type: []const u8, body: []const u8) []u8 {
  size: usize = 96 + #len(reason) + #len(content_type) + #len(body)
  mark := memory.arena_mark(arena)
  space := memory.push_bytes_uninit(arena, size)
  output := response_into(space, code, reason, content_type, body)
  memory.arena_rewind(arena, mark + #len(output))
  return output
}
