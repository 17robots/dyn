use "std/parse" parse
use "std/io" io
use "std/mem" memory
use "std/net" network
use "std/bytes" bytes
use "std/fmt" format
use "std/net/url" urls

pub type StreamReader = io.Reader
pub type StreamWriter = io.Writer
pub type StreamResult = io.Transfer
pub type Listener = network.Listener
pub type Connection = network.Connection

pub type AcceptResult = io.Result(Connection)

pub fn accept(listener: *Listener) AcceptResult {
  accepted := network.listener_accept(listener)
  return AcceptResult{ value: accepted.value, failure: io.Failure{ kind: accepted.failure.kind, native: accepted.failure.native } }
}
pub fn close(connection: *Connection) {
  network.connection_close(connection)
}

pub enum Framing { None, Length, Chunked, Close }
// Parser offsets are byte positions in the supplied input; zero also denotes an
// unavailable position for semantic URL/upgrade validation without a source cursor.
pub struct HttpHead { offset: usize, framing: Framing, code: u16, header_length: usize, content_length: usize, keep_alive: bool, chunked: bool, failure: parse.Failure }
pub struct HttpHeader { offset: usize, name: []const u8, value: []const u8, found: bool, failure: parse.Failure }
pub struct Url { offset: usize, scheme: []const u8, host: []const u8, port: u16, target: []const u8, secure: bool, failure: parse.Failure }

pub struct HttpIoResult { value: []u8, offset: usize, consumed: usize, count: usize, failure: io.Failure }

fn append_bytes(destination: []u8, offset: usize, source: []const u8) usize {
  if offset > #len(destination) || #len(source) > #len(destination) - offset {
    return #len(destination) + 1
  }
  for i in 0..#len(source) {
    destination[offset + i] = source[i]
  }
  return offset + #len(source)
}

fn append_usize(destination: []u8, offset: usize, value: usize) usize {
  digits: [20 + memory.ArenaBufferOverhead]u8 = []
  scratch := memory.arena_from_buffer(digits[..])
  return append_bytes(destination, offset, format.u64_decimal(scratch, value))
}

fn request_into(destination: []u8, method: []const u8, target: []const u8, host: []const u8, body: []const u8) []u8 {
  offset := append_bytes(destination, 0, method)
  offset = append_bytes(destination, offset, " ")
  if #len(target) > 0 && target[0] == '?' {
    offset = append_bytes(destination, offset, "/")
  }
  offset = append_bytes(destination, offset, target)
  offset = append_bytes(destination, offset, " HTTP/1.1\r\nHost: ")
  offset = append_bytes(destination, offset, host)
  offset = append_bytes(destination, offset, "\r\nConnection: close\r\nContent-Length: ")
  offset = append_usize(destination, offset, #len(body))
  offset = append_bytes(destination, offset, "\r\n\r\n")
  offset = append_bytes(destination, offset, body)
  if offset > #len(destination) {
    return destination[..0]
  }
  return destination[..offset]
}

fn response_into(destination: []u8, code: u16, reason: []const u8, content_type: []const u8, body: []const u8) []u8 {
  offset := append_bytes(destination, 0, "HTTP/1.1 ")
  offset = append_usize(destination, offset, code)
  offset = append_bytes(destination, offset, " ")
  offset = append_bytes(destination, offset, reason)
  offset = append_bytes(destination, offset, "\r\nContent-Type: ")
  offset = append_bytes(destination, offset, content_type)
  offset = append_bytes(destination, offset, "\r\nConnection: close\r\nContent-Length: ")
  offset = append_usize(destination, offset, #len(body))
  offset = append_bytes(destination, offset, "\r\n\r\n")
  offset = append_bytes(destination, offset, body)
  if offset > #len(destination) {
    return destination[..0]
  }
  return destination[..offset]
}

fn ascii_lower(value: u8) u8 {
  if value >= 'A' && value <= 'Z' {
    return value + 32
  }
  return value
}

fn starts_ascii_case(input: []const u8, at: usize, expected: []const u8) bool {
  if at > #len(input) || #len(expected) > #len(input) - at {
    return false
  }
  for i in 0..#len(expected) {
    if ascii_lower(input[at + i]) != ascii_lower(expected[i]) {
      return false
    }
  }
  return true
}

struct Decimal { value: usize, offset: usize, ok: bool }

fn parse_decimal(input: []const u8, start: usize, end: usize) Decimal {
  value: usize = 0
  i := start
  if start == end {
    return Decimal{ offset: i }
  }
  for i < end {
    if input[i] < '0' || input[i] > '9' {
      return Decimal{ offset: i }
    }
    digit := #cast(usize, (input[i] - '0'))
    if value > (#max(usize) - digit) / 10 {
      return Decimal{ offset: i }
    }
    value = value * 10 + digit
    i += 1
  }
  return Decimal{ value: value, ok: true }
}

fn ascii_equal(left: []const u8, right: []const u8) bool {
  return #len(left) == #len(right) && starts_ascii_case(left, 0, right)
}
fn trim_ows(value: []const u8) []const u8 {
  first: usize = 0
  last := #len(value)
  for first < last && (value[first] == ' ' || value[first] == '\t') {
    first += 1
  }
  for last > first && (value[last - 1] == ' ' || value[last - 1] == '\t') {
    last -= 1
  }
  return value[first..last]
}
fn token_byte(byte: u8) bool {
  return (byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z') ||
    (byte >= '0' && byte <= '9') || byte == '!' || byte == '#' || byte == '$' || byte == '%' ||
    byte == '&' || byte == 39 || byte == '*' || byte == '+' || byte == '-' || byte == '.' ||
    byte == '^' || byte == '_' || byte == '`' || byte == '|' || byte == '~'
}
fn http_parse_head(input: []const u8, response: bool) HttpHead {
  line_end: usize = 0
  for line_end + 1 < #len(input) && !(input[line_end] == '\r' && input[line_end + 1] == '\n') {
    line_end += 1
  }
  if line_end + 1 >= #len(input) {
    return HttpHead{ offset: #len(input), failure: parse.Failure{ kind: parse.Kind.Syntax, offset: #len(input) } }
  }
  code: u16 = 0
  version := input[..0]
  version_at: usize = 0
  if response {
    if line_end < 12 {
      return HttpHead{ offset: line_end, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: line_end } }
    }
    if input[8] != ' ' {
      return HttpHead{ offset: 8, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: 8 } }
    }
    if input[12] != ' ' {
      return HttpHead{ offset: 12, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: 12 } }
    }
    version = input[..8]
    parsed_code := parse_decimal(input, 9, 12)
    if !parsed_code.ok {
      return HttpHead{ offset: parsed_code.offset, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: parsed_code.offset } }
    }
    if parsed_code.value < 100 || parsed_code.value > 999 {
      return HttpHead{ offset: 9, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: 9 } }
    }
    code = #cast(u16, parsed_code.value)
  } else {
    first: usize = 0
    for first < line_end && token_byte(input[first]) {
      first += 1
    }
    if first == 0 || first >= line_end || input[first] != ' ' {
      return HttpHead{ offset: first, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: first } }
    }
    second := first + 1
    for second < line_end && input[second] > 32 && input[second] != 127 {
      second += 1
    }
    if second == first + 1 || second >= line_end || input[second] != ' ' {
      return HttpHead{ offset: second, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: second } }
    }
    version_at = second + 1
    version = input[version_at..line_end]
  }
  if !bytes.equal(version, "HTTP/1.1") && !bytes.equal(version, "HTTP/1.0") {
    bad: usize = 0
    expected: []const u8 = "HTTP/1.1"
    for bad < #len(version) && bad < #len(expected) && version[bad] == expected[bad] {
      bad += 1
    }
    return HttpHead{ offset: version_at + bad, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: version_at + bad } }
  }
  cursor := line_end + 2
  content_length: usize = 0
  keep_alive := bytes.equal(version, "HTTP/1.1")
  close_requested := false
  chunked := false
  has_length := false
  has_transfer := false
  for cursor + 1 < #len(input) {
    if input[cursor] == '\r' && input[cursor + 1] == '\n' {
      if has_transfer && has_length {
        return HttpHead{ offset: cursor, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: cursor } }
      }
      framing := Framing.None
      if chunked {
        framing = Framing.Chunked
      } else if has_length {
        framing = Framing.Length
      } else if response {
        framing = Framing.Close
      }
      if response && (code < 200 || code == 204 || code == 304) {
        framing = Framing.None
      }
      return HttpHead{ code: code, header_length: cursor + 2, content_length: content_length, keep_alive: keep_alive && !close_requested, chunked: chunked, framing: framing }
    }
    end := cursor
    for end + 1 < #len(input) && !(input[end] == '\r' && input[end + 1] == '\n') {
      end += 1
    }
    if end + 1 >= #len(input) {
      return HttpHead{ offset: #len(input), failure: parse.Failure{ kind: parse.Kind.Syntax, offset: #len(input) } }
    }
    colon := cursor
    for colon < end && token_byte(input[colon]) {
      colon += 1
    }
    if colon == cursor || colon == end || input[colon] != ':' {
      return HttpHead{ offset: colon, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: colon } }
    }
    value_at := colon + 1
    for value_at < end && (input[value_at] == ' ' || input[value_at] == '\t') {
      value_at += 1
    }
    value := trim_ows(input[value_at..end])
    for value_i in 0..#len(value) {
      byte := value[value_i]
      if (byte < 32 && byte != '\t') || byte == 127 {
        return HttpHead{ offset: value_at + value_i, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: value_at + value_i } }
      }
    }
    name := input[cursor..colon]
    if ascii_equal(name, "Content-Length") {
      parsed_length := parse_decimal(value, 0, #len(value))
      if !parsed_length.ok {
        return HttpHead{ offset: value_at + parsed_length.offset, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: value_at + parsed_length.offset } }
      }
      if has_length && content_length != parsed_length.value {
        return HttpHead{ offset: value_at, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: value_at } }
      }
      content_length = parsed_length.value
      has_length = true
    } else if ascii_equal(name, "Transfer-Encoding") {
      // Only chunked is implemented. Never silently ignore unknown codings.
      if has_transfer || !ascii_equal(value, "chunked") {
        return HttpHead{ offset: value_at, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: value_at } }
      }
      has_transfer = true
      chunked = true
    } else if ascii_equal(name, "Connection") {
      at: usize = 0
      for at < #len(value) {
        finish := at
        for finish < #len(value) && value[finish] != ',' {
          finish += 1
        }
        item := trim_ows(value[at..finish])
        if #len(item) == 0 {
          return HttpHead{ offset: value_at + at, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: value_at + at } }
        }
        item_at := at
        for item_at < finish && (value[item_at] == ' ' || value[item_at] == '\t') {
          item_at += 1
        }
        for item_i in 0..#len(item) {
          if !token_byte(item[item_i]) {
            return HttpHead{ offset: value_at + item_at + item_i, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: value_at + item_at + item_i } }
          }
        }
        if ascii_equal(item, "close") {
          close_requested = true
        }
        if ascii_equal(item, "keep-alive") {
          keep_alive = true
        }
        at = finish
        if at < #len(value) {
          at += 1
        }
      }
    }
    cursor = end + 2
  }
  return HttpHead{ offset: cursor, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: cursor } }
}

pub fn parse_response(input: []const u8) HttpHead {
  return http_parse_head(input, true)
}
pub fn parse_request(input: []const u8) HttpHead {
  return http_parse_head(input, false)
}

pub fn header(input: []const u8, name: []const u8) HttpHeader {
  head := http_parse_head(input, starts_ascii_case(input, 0, "HTTP/"))
  if head.failure.kind != parse.Kind.Ok {
    return HttpHeader{ offset: head.offset, failure: head.failure }
  }
  cursor: usize = 0
  for cursor + 1 < head.header_length && !(input[cursor] == '\r' && input[cursor + 1] == '\n') {
    cursor += 1
  }
  cursor += 2
  for cursor + 1 < head.header_length {
    end := cursor
    for end + 1 < head.header_length && !(input[end] == '\r' && input[end + 1] == '\n') {
      end += 1
    }
    colon := cursor
    for colon < end && input[colon] != ':' {
      colon += 1
    }
    if colon - cursor == #len(name) && starts_ascii_case(input, cursor, name) {
      value := colon + 1
      for value < end && (input[value] == ' ' || input[value] == '\t') {
        value += 1
      }
      return HttpHeader{ name: input[cursor..colon], value: input[value..end], found: true }
    }
    cursor = end + 2
  }
  return HttpHeader{}
}

fn hex(value: u8) i16 {
  if value >= '0' && value <= '9' {
    return (value - '0')
  }
  lower := ascii_lower(value)
  if lower >= 'a' && lower <= 'f' {
    return (lower - 'a' + 10)
  }
  return -1
}

// Decodes a complete chunked body into caller storage. Extensions are skipped.
// Cursors advance only over validated framing; buffered payload stays encoded
// until the whole message has been validated and can be decoded in place.
struct ChunkProgress { cursor: usize, line_scan: usize, count: usize, size: usize, phase: u8, digits: bool, extension: bool }
fn chunk_progress(state: *ChunkProgress, input: []const u8) HttpIoResult {
  for {
    if state.phase == 1 {
      if state.size > #len(input) - state.cursor {
        return HttpIoResult{ offset: #len(input), failure: io.Failure{ kind: io.Kind.WouldBlock, native: 0 } }
      }
      end := state.cursor + state.size
      if #len(input) - end < 2 {
        return HttpIoResult{ offset: #len(input), failure: io.Failure{ kind: io.Kind.WouldBlock, native: 0 } }
      }
      if input[end] != '\r' {
        return HttpIoResult{ offset: end, failure: io.Failure{ kind: io.Kind.InvalidInput, native: 0 } }
      }
      if input[end + 1] != '\n' {
        return HttpIoResult{ offset: end + 1, failure: io.Failure{ kind: io.Kind.InvalidInput, native: 0 } }
      }
      if state.size > #max(usize) - state.count {
        return HttpIoResult{ offset: state.line_scan, failure: io.Failure{ kind: io.Kind.Capacity, native: 0 } }
      }
      state.count += state.size
      state.cursor = end + 2
      state.line_scan = state.cursor
      state.size = 0
      state.digits = false
      state.extension = false
      state.phase = 0
    }
    if state.phase == 0 {
      for state.line_scan < #len(input) && input[state.line_scan] != '\r' {
        byte := input[state.line_scan]
        if !state.extension && byte != ';' {
          value := hex(byte)
          if value < 0 || state.size > (#max(usize) - #cast(usize, value)) / 16 {
            return HttpIoResult{ offset: state.line_scan, failure: io.Failure{ kind: io.Kind.InvalidInput, native: 0 } }
          }
          state.size = state.size * 16 + #cast(usize, value)
          state.digits = true
        } else {
          if !state.digits || byte < 32 || byte == 127 {
            return HttpIoResult{ offset: state.line_scan, failure: io.Failure{ kind: io.Kind.InvalidInput, native: 0 } }
          }
          state.extension = true
        }
        state.line_scan += 1
      }
      if state.line_scan == #len(input) {
        return HttpIoResult{ offset: #len(input), failure: io.Failure{ kind: io.Kind.WouldBlock, native: 0 } }
      }
      if !state.digits {
        return HttpIoResult{ offset: state.line_scan, failure: io.Failure{ kind: io.Kind.InvalidInput, native: 0 } }
      }
      if state.line_scan + 1 >= #len(input) {
        return HttpIoResult{ offset: #len(input), failure: io.Failure{ kind: io.Kind.WouldBlock, native: 0 } }
      }
      if input[state.line_scan + 1] != '\n' {
        return HttpIoResult{ offset: state.line_scan + 1, failure: io.Failure{ kind: io.Kind.InvalidInput, native: 0 } }
      }
      state.cursor = state.line_scan + 2
      state.line_scan = state.cursor
      state.phase = 1
      if state.size == 0 {
        state.phase = 2
      }
    } else {
      for state.line_scan + 1 < #len(input) && !(input[state.line_scan] == '\r' && input[state.line_scan + 1] == '\n') {
        state.line_scan += 1
      }
      if state.line_scan + 1 >= #len(input) {
        return HttpIoResult{ offset: #len(input), failure: io.Failure{ kind: io.Kind.WouldBlock, native: 0 } }
      }
      end := state.line_scan
      if end == state.cursor {
        return HttpIoResult{ count: state.count, consumed: end + 2 }
      }
      colon := state.cursor
      for colon < end && token_byte(input[colon]) {
        colon += 1
      }
      if colon == state.cursor || colon == end || input[colon] != ':' {
        return HttpIoResult{ offset: colon, failure: io.Failure{ kind: io.Kind.InvalidInput, native: 0 } }
      }
      for value_at in colon + 1..end {
        byte := input[value_at]
        if (byte < 32 && byte != '\t') || byte == 127 {
          return HttpIoResult{ offset: value_at, failure: io.Failure{ kind: io.Kind.InvalidInput, native: 0 } }
        }
      }
      if ascii_equal(input[state.cursor..colon], "Content-Length") || ascii_equal(input[state.cursor..colon], "Transfer-Encoding") {
        return HttpIoResult{ offset: state.cursor, failure: io.Failure{ kind: io.Kind.InvalidInput, native: 0 } }
      }
      state.cursor = end + 2
      state.line_scan = state.cursor
    }
  }
  return HttpIoResult{ failure: io.Failure{ kind: io.Kind.System } }
}

// Retain the last three bytes so a header terminator may cross reads.
fn head_complete(input: []const u8, cursor: *usize) bool {
  for cursor.* + 3 < #len(input) {
    at := cursor.*
    if input[at] == '\r' && input[at + 1] == '\n' && input[at + 2] == '\r' && input[at + 3] == '\n' {
      return true
    }
    cursor.* += 1
  }
  return false
}

fn scan_chunked(input: []const u8, destination: []u8, write: bool) HttpIoResult {
  cursor: usize = 0
  output: usize = 0
  for {
    size: usize = 0
    digits: usize = 0
    for cursor < #len(input) && input[cursor] != '\r' && input[cursor] != ';' {
      value := hex(input[cursor])
      if value < 0 || size > (#max(usize) - #cast(usize, value)) / 16 {
        return HttpIoResult{ offset: cursor, failure: io.Failure{ kind: io.Kind.InvalidInput, native: 0 } }
      }
      size = size * 16 + #cast(usize, value)
      cursor += 1
      digits += 1
    }
    if cursor == #len(input) {
      return HttpIoResult{ offset: #len(input), failure: io.Failure{ kind: io.Kind.WouldBlock, native: 0 } }
    }
    if digits == 0 {
      return HttpIoResult{ offset: cursor, failure: io.Failure{ kind: io.Kind.InvalidInput, native: 0 } }
    }
    for cursor < #len(input) && input[cursor] != '\r' {
      if input[cursor] < 32 || input[cursor] == 127 {
        return HttpIoResult{ offset: cursor, failure: io.Failure{ kind: io.Kind.InvalidInput, native: 0 } }
      }
      cursor += 1
    }
    if cursor + 1 >= #len(input) {
      return HttpIoResult{ offset: #len(input), failure: io.Failure{ kind: io.Kind.WouldBlock, native: 0 } }
    }
    if input[cursor + 1] != '\n' {
      return HttpIoResult{ offset: cursor + 1, failure: io.Failure{ kind: io.Kind.InvalidInput, native: 0 } }
    }
    cursor += 2
    if size == 0 {
      for {
        end := cursor
        for end + 1 < #len(input) && !(input[end] == '\r' && input[end + 1] == '\n') {
          end += 1
        }
        if end + 1 >= #len(input) {
          return HttpIoResult{ offset: #len(input), failure: io.Failure{ kind: io.Kind.WouldBlock, native: 0 } }
        }
        if end == cursor {
          return HttpIoResult{ count: output, consumed: end + 2 }
        }
        colon := cursor
        for colon < end && token_byte(input[colon]) {
          colon += 1
        }
        if colon == cursor || colon == end || input[colon] != ':' {
          return HttpIoResult{ offset: colon, failure: io.Failure{ kind: io.Kind.InvalidInput, native: 0 } }
        }
        for value_at in colon + 1..end {
          byte := input[value_at]
          if (byte < 32 && byte != '\t') || byte == 127 {
            return HttpIoResult{ offset: value_at, failure: io.Failure{ kind: io.Kind.InvalidInput, native: 0 } }
          }
        }
        if ascii_equal(input[cursor..colon], "Content-Length") || ascii_equal(input[cursor..colon], "Transfer-Encoding") {
          return HttpIoResult{ offset: cursor, failure: io.Failure{ kind: io.Kind.InvalidInput, native: 0 } }
        }
        cursor = end + 2
      }
    }
    if size > #len(input) - cursor {
      return HttpIoResult{ offset: #len(input), failure: io.Failure{ kind: io.Kind.WouldBlock, native: 0 } }
    }
    if size > #max(usize) - output {
      return HttpIoResult{ offset: cursor, failure: io.Failure{ kind: io.Kind.Capacity, native: 0 } }
    }
    if write {
      if size > #len(destination) - output {
        return HttpIoResult{ offset: cursor, failure: io.Failure{ kind: io.Kind.Capacity, native: 0 } }
      }
      for i in 0..size {
        destination[output + i] = input[cursor + i]
      }
    }
    cursor += size
    output += size
    if cursor + 1 >= #len(input) {
      return HttpIoResult{ offset: #len(input), failure: io.Failure{ kind: io.Kind.WouldBlock, native: 0 } }
    }
    if input[cursor] != '\r' {
      return HttpIoResult{ offset: cursor, failure: io.Failure{ kind: io.Kind.InvalidInput, native: 0 } }
    }
    if input[cursor + 1] != '\n' {
      return HttpIoResult{ offset: cursor + 1, failure: io.Failure{ kind: io.Kind.InvalidInput, native: 0 } }
    }
    cursor += 2
  }
  return HttpIoResult{ failure: io.Failure{ kind: io.Kind.System } }
}
// Borrowed inputs may live below the mark, but must not overlap future writes.
fn validate_borrow(arena: *memory.Arena, input: []const u8) {
  if memory.arena_overlaps_unallocated(arena, input) {
    #panic("HTTP input overlaps arena output")
  }
}

// Validate the complete wire before allocating or writing decoded payload.
pub fn decode_chunked(arena: *memory.Arena, input: []const u8) HttpIoResult {
  validate_borrow(arena, input)
  scanned := scan_chunked(input, arena.data[..0], false)
  if io.failed(scanned.failure) {
    return scanned
  }
  destination := memory.push_bytes_uninit(arena, scanned.count)
  decoded := scan_chunked(input[..scanned.consumed], destination, true)
  decoded.value = destination
  return decoded
}

pub fn parse_url(input: []const u8) Url {
  parsed := urls.parse(input)
  if parsed.failure.kind != parse.Kind.Ok {
    return Url{ offset: parsed.offset, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: parsed.offset } }
  }
  value := parsed.value
  secure := ascii_equal(value.scheme, "https")
  if !secure && !ascii_equal(value.scheme, "http") {
    return Url{ failure: parse.Failure{ kind: parse.Kind.Syntax } }
  }
  authority_at := #len(value.scheme) + 3
  authority := value.authority
  if #len(authority) == 0 || bytes.find_byte(authority, '@') < #len(authority) {
    return Url{ offset: authority_at + bytes.find_byte(authority, '@'), failure: parse.Failure{ kind: parse.Kind.Syntax, offset: authority_at + bytes.find_byte(authority, '@') } }
  }
  host_end := #len(authority)
  port_start := #len(authority)
  host_start: usize = 0
  if authority[0] == '[' {
    bracket := bytes.find_byte(authority, ']')
    if bracket <= 1 || bracket == #len(authority) {
      return Url{ offset: authority_at + bracket, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: authority_at + bracket } }
    }
    host_start = 1
    host_end = bracket
    if host_end + 1 < #len(authority) {
      if authority[host_end + 1] != ':' {
        return Url{ offset: authority_at + host_end + 1, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: authority_at + host_end + 1 } }
      }
      port_start = host_end + 2
    }
  } else {
    colon := bytes.find_byte(authority, ':')
    if colon < #len(authority) {
      host_end = colon
      port_start = host_end + 1
    }
  }
  if host_end == host_start {
    return Url{ offset: authority_at + host_start, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: authority_at + host_start } }
  }
  port: u16 = 80
  if secure {
    port = 443
  }
  if port_start < #len(authority) {
    number := parse_decimal(authority, port_start, #len(authority))
    if !number.ok {
      return Url{ offset: authority_at + number.offset, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: authority_at + number.offset } }
    }
    if number.value == 0 || number.value > 65535 {
      return Url{ offset: authority_at + port_start, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: authority_at + port_start } }
    }
    port = #cast(u16, number.value)
  } else if authority[#len(authority) - 1] == ':' {
    return Url{ offset: authority_at + #len(authority), failure: parse.Failure{ kind: parse.Kind.Syntax, offset: authority_at + #len(authority) } }
  }
  target: []const u8 = "/"
  // Borrow the original suffix to retain query bytes; fragments are never sent.
  path_at := #len(value.scheme) + 3 + #len(authority)
  end := #len(input)
  end = path_at + bytes.find_byte(input[path_at..], '#')
  if path_at < end {
    target = input[path_at..end]
  }
  return Url{ scheme: value.scheme, host: authority[host_start..host_end], port: port, target: target, secure: secure }
}

pub const StatusOk: u16 = 200
pub const StatusCreated: u16 = 201
pub const StatusNoContent: u16 = 204
pub const StatusSeeOther: u16 = 303
pub const StatusBadRequest: u16 = 400
pub const StatusUnauthorized: u16 = 401
pub const StatusForbidden: u16 = 403
pub const StatusNotFound: u16 = 404
pub const StatusMethodNotAllowed: u16 = 405
pub const StatusConflict: u16 = 409
pub const StatusUnprocessableContent: u16 = 422
pub const StatusTooManyRequests: u16 = 429
pub const StatusServiceUnavailable: u16 = 503
pub const MaxParams: usize = 4
pub const StatusPayloadTooLarge: u16 = 413
pub const StatusInternalServerError: u16 = 500

pub enum ErrorKind { None, End, Invalid, Capacity, Io }
fn http_kind(detail: ErrorKind) io.Kind {
  if detail == ErrorKind.Invalid {
    return io.Kind.InvalidInput
  }
  if detail == ErrorKind.Capacity {
    return io.Kind.Capacity
  }
  if detail == ErrorKind.Io {
    return io.Kind.System
  }
  return io.Kind.Ok
}

pub struct Request {
  raw: []const u8,
  method: []const u8,
  target: []const u8,
  // target before '?', and after it (empty when absent). Both borrow raw.
  path: []const u8,
  query: []const u8,
  body: []const u8,
  header_length: usize,
  keep_alive: bool,
  // Borrowed application state given to serve_stream_context and friends; nil otherwise.
  context: rawptr,
  // Path parameters captured by a Routes pattern such as /users/:id. Read
  // them with param.
  params: [MaxParams]Header,
  param_count: usize,
}

pub struct Response {
  failed: bool,
  first: Result,
  first_stream: io.Transfer,
  output: io.Writer,
  started: bool,
  finished: bool,
}

pub struct Header { name: []const u8, value: []const u8 }

pub struct ResponseOptions {
  status: u16,
  reason: []const u8,
  content_type: []const u8,
  close_connection: bool,
  // Extra response headers, written in order. Names must be tokens and values
  // must not hold CR, LF or NUL; otherwise respond fails with Invalid before
  // writing anything, so request data cannot inject headers.
  headers: []const Header,
}

pub struct Server {
  failed: bool,
  first: Result,
  ended: bool,
  input: io.Reader,
  output: io.Writer,
  storage: []u8,
  used: usize,
  consumed: usize,
  // Copied into every received Request.
  context: rawptr,
}

pub struct ReceiveResult { request: Request, response: Response, detail: ErrorKind, offset: usize, failure: io.Failure }

pub struct Result { detail: ErrorKind, offset: usize, failure: io.Failure }

pub struct Body {
  failed: bool,
  first: Result,
  first_stream: io.Transfer,
  output: io.Writer,
  finished: bool,
}

pub struct BodyResult { detail: ErrorKind, body: Body, result: Result, failure: io.Failure }

pub type Handler = fn(*Response, *const Request) Result

pub struct Route {
  method: []const u8,
  target: []const u8,
  handler: Handler,
}

pub struct Router {
  routes: []Route,
  count: usize,
  fallback: Handler,
}

pub struct ClientResponse {
  raw: []u8,
  body: []u8,
  status: u16,
  detail: ErrorKind,
  offset: usize,
  failure: io.Failure,
}


// Router storage is supplied by the caller. Route strings are borrowed.
pub fn router(storage: []Route, fallback: Handler) Router {
  return Router{ routes: storage, fallback: fallback }
}

pub fn route(state: *Router, method: []const u8, target: []const u8, handler: Handler) Result {
  if handler == nil {
    return Result{ detail: ErrorKind.Invalid, failure: io.Failure{ kind: io.Kind.InvalidInput } }
  }
  if state.count >= #len(state.routes) {
    return Result{ detail: ErrorKind.Capacity, failure: io.Failure{ kind: io.Kind.Capacity } }
  }
  state.routes[state.count] = Route{ method: method, target: target, handler: handler }
  state.count += 1
  return Result{}
}

pub fn dispatch(state: *Router, response: *Response, request: *const Request) Result {
  i: usize = 0
  for i < state.count {
    candidate := state.routes[i]
    if bytes.equal(candidate.method, request.method) && bytes.equal(candidate.target, request.path) {
      return candidate.handler(response, request)
    }
    i += 1
  }
  if state.fallback != nil {
    return state.fallback(response, request)
  }
  return respond(response, "not found\n", ResponseOptions{ status: StatusNotFound, content_type: "text/plain; charset=utf-8" })
}

// Typed application state. A server stores one Handler and one rawptr; bind
// pairs them so the cast back to *T lives here, matched by construction, and
// handlers receive *T directly. The Typed value must stay alive and unmoved
// while any server uses the Binding.
pub struct Typed(T) {
  state: *T,
  handler: fn(*Response, *const Request, *T) Result,
}

pub struct Binding { handler: Handler, context: rawptr }

fn typed_dispatch(T: type, response: *Response, request: *const Request) Result {
  typed := #cast(*Typed(T), request.context)
  return typed.handler(response, request, typed.state)
}

pub fn bind(typed: *Typed($T)) Binding {
  return Binding{ handler: #instance(typed_dispatch, T), context: typed }
}

// Typed router. Patterns are exact paths with optional :name segments, each
// matching one nonempty path segment: "/users/:id/posts/:post". At most
// MaxParams per pattern. A path that matches with another method gets 405
// with an Allow header; no match runs fallback, or 404 when fallback is nil.
pub struct TypedRoute(T) {
  method: []const u8,
  pattern: []const u8,
  handler: fn(*Response, *const Request, *T) Result,
}

pub struct Routes(T) {
  routes: []TypedRoute(T),
  count: usize,
  state: *T,
  fallback: fn(*Response, *const Request, *T) Result,
}

// Route storage is caller-supplied; method and pattern strings are borrowed.
pub fn typed_routes(storage: []TypedRoute($T), state: *$T) Routes(T) {
  return Routes(T){ routes: storage, state: state }
}

pub fn add(router: *Routes($T), method: []const u8, pattern: []const u8, handler: fn(*Response, *const Request, *$T) Result) Result {
  if handler == nil || #len(pattern) == 0 || pattern[0] != '/' || pattern_params(pattern) > MaxParams {
    return Result{ detail: ErrorKind.Invalid, failure: io.Failure{ kind: io.Kind.InvalidInput } }
  }
  if router.count >= #len(router.routes) {
    return Result{ detail: ErrorKind.Capacity, failure: io.Failure{ kind: io.Kind.Capacity } }
  }
  router.routes[router.count] = TypedRoute(T){ method: method, pattern: pattern, handler: handler }
  router.count += 1
  return Result{}
}

fn routes_dispatch(T: type, response: *Response, request: *const Request) Result {
  return serve_routes(#cast(*Routes(T), request.context), response, request)
}

// Runs the matching route. Use it from a Typed handler that wraps routing
// with its own work, such as counting or authentication.
pub fn serve_routes(router: *Routes($T), response: *Response, request: *const Request) Result {
  matched := request.*
  allow_storage: [128]u8 = []
  allow_used: usize = 0
  for i in 0..router.count {
    candidate := &router.routes[i]
    if !match_path(candidate.pattern, request.path, &matched) {
      continue
    }
    if bytes.equal(candidate.method, request.method) {
      return candidate.handler(response, &matched, router.state)
    }
    if allow_used > 0 {
      allow_used = append_bytes(allow_storage[..], allow_used, ", ")
    }
    allow_used = append_bytes(allow_storage[..], allow_used, candidate.method)
  }
  if allow_used > 0 && allow_used <= #len(allow_storage) {
    headers: [1]Header = [Header{ name: "Allow", value: allow_storage[..allow_used] }]
    return respond(response, "method not allowed\n", ResponseOptions{ status: StatusMethodNotAllowed,
      content_type: "text/plain; charset=utf-8", headers: headers[..] })
  }
  if router.fallback != nil {
    return router.fallback(response, request, router.state)
  }
  return respond(response, "not found\n", ResponseOptions{ status: StatusNotFound, content_type: "text/plain; charset=utf-8" })
}

// Binds a router for a server start, like bind.
pub fn bind_routes(router: *Routes($T)) Binding {
  return Binding{ handler: #instance(routes_dispatch, T), context: router }
}

fn pattern_params(pattern: []const u8) usize {
  count: usize = 0
  for i in 0..#len(pattern) {
    if pattern[i] == ':' && i > 0 && pattern[i - 1] == '/' {
      count += 1
    }
  }
  return count
}

// Matches path against pattern segment by segment, capturing :name segments
// into request.params. Captures borrow path.
pub fn match_path(pattern: []const u8, path: []const u8, request: *Request) bool {
  request.param_count = 0
  p: usize = 0
  q: usize = 0
  for p < #len(pattern) && q < #len(path) {
    if pattern[p] == ':' && p > 0 && pattern[p - 1] == '/' {
      name_end := p + bytes.find_byte(pattern[p..], '/')
      value_end := q + bytes.find_byte(path[q..], '/')
      if value_end == q || request.param_count >= MaxParams {
        return false
      }
      request.params[request.param_count] = Header{ name: pattern[p + 1..name_end], value: path[q..value_end] }
      request.param_count += 1
      p = name_end
      q = value_end
      continue
    }
    if pattern[p] != path[q] {
      return false
    }
    p += 1
    q += 1
  }
  return p == #len(pattern) && q == #len(path)
}

// Path parameter captured by a Routes pattern, still percent-encoded.
pub fn param(request: *const Request, name: []const u8) HttpHeader {
  for i in 0..request.param_count {
    if bytes.equal(request.params[i].name, name) {
      return HttpHeader{ name: request.params[i].name, value: request.params[i].value, found: true }
    }
  }
  return HttpHeader{}
}

pub fn server(input: io.Reader, output: io.Writer, storage: []u8) Server {
  return Server{ input: input, output: output, storage: storage }
}

pub fn connection_server(input: io.Reader, output: io.Writer, storage: []u8) Server {
  return server(input, output, storage)
}

fn shift_consumed(state: *Server) {
  if state.consumed == 0 {
    return
  }
  remaining := state.used - state.consumed
  for i in 0..remaining {
    state.storage[i] = state.storage[state.consumed + i]
  }
  state.used = remaining
  state.consumed = 0
}

fn request_parts(input: []const u8, head: HttpHead) Request {
  line_end: usize = 0
  for line_end + 1 < head.header_length && !(input[line_end] == '\r' && input[line_end + 1] == '\n') {
    line_end += 1
  }
  first_space: usize = 0
  for first_space < line_end && input[first_space] != ' ' {
    first_space += 1
  }
  second_space := first_space + 1
  for second_space < line_end && input[second_space] != ' ' {
    second_space += 1
  }
  if first_space == 0 || second_space <= first_space + 1 || second_space >= line_end {
    return Request{}
  }
  total := head.header_length + head.content_length
  target := input[first_space + 1..second_space]
  question := bytes.find_byte(target, '?')
  query := target[..0]
  if question < #len(target) {
    query = target[question + 1..]
  }
  return Request{
    raw: input[..total],
    method: input[..first_space],
    target: target,
    path: target[..question],
    query: query,
    body: input[head.header_length..total],
    header_length: head.header_length,
    keep_alive: head.keep_alive,
  }
}

pub enum FrameStatus { Incomplete, Ready, Invalid, Capacity }
pub struct FrameResult { status: FrameStatus, request: Request, consumed: usize, offset: usize }

// Frames one request from bytes already buffered, with no I/O, for callers that
// own their sockets (event loops). capacity is the most bytes the caller can
// ever buffer for one request. Ready requests borrow input; consumed is its
// full length. Incomplete means read more. Chunked request bodies are Invalid.
pub fn frame_request(input: []const u8, capacity: usize) FrameResult {
  scan: usize = 0
  if !head_complete(input, &scan) {
    if #len(input) >= capacity {
      return FrameResult{ status: FrameStatus.Capacity }
    }
    return FrameResult{ status: FrameStatus.Incomplete }
  }
  head := parse_request(input)
  if head.failure.kind != parse.Kind.Ok {
    return FrameResult{ status: FrameStatus.Invalid, offset: head.offset }
  }
  if head.chunked {
    return FrameResult{ status: FrameStatus.Invalid }
  }
  if head.header_length > capacity || head.content_length > capacity - head.header_length {
    return FrameResult{ status: FrameStatus.Capacity }
  }
  total := head.header_length + head.content_length
  if #len(input) < total {
    return FrameResult{ status: FrameStatus.Incomplete }
  }
  request := request_parts(input, head)
  if #len(request.method) == 0 {
    return FrameResult{ status: FrameStatus.Invalid }
  }
  return FrameResult{ status: FrameStatus.Ready, request: request, consumed: total }
}

fn receive_failure(state: *Server, detail: ErrorKind, native: isize) ReceiveResult {
  if !state.failed {
    state.failed = true
    state.first = Result{ detail: detail, failure: io.Failure{ kind: http_kind(detail), native: native } }
  }
  return ReceiveResult{ detail: state.first.detail, offset: state.first.offset, failure: io.Failure{ kind: state.first.failure.kind, native: state.first.failure.native } }
}

// Returned request slices borrow state.storage and remain valid only until the next receive call.
pub fn receive(state: *Server) ReceiveResult {
  if state.failed {
    return receive_failure(state, ErrorKind.None, 0)
  }
  if state.used > #len(state.storage) || state.consumed > state.used || state.input.read == nil || state.output.write == nil {
    return receive_failure(state, ErrorKind.Invalid, 0)
  }
  shift_consumed(state)
  head := HttpHead{}
  head_scan: usize = 0
  head_checked := false
  for true {
    if !head_checked && head_complete(state.storage[..state.used], &head_scan) {
      head = parse_request(state.storage[..state.used])
      head_checked = true
      // More bytes cannot repair a complete head that does not parse.
      if head.failure.kind != parse.Kind.Ok {
        failure := receive_failure(state, ErrorKind.Invalid, 0)
        state.first.offset = head.offset
        failure.offset = head.offset
        return failure
      }
    }
    if head_checked {
      if head.chunked {
        return receive_failure(state, ErrorKind.Invalid, 0)
      }
      if head.content_length > #len(state.storage) - head.header_length {
        return receive_failure(state, ErrorKind.Capacity, 0)
      }
      total := head.header_length + head.content_length
      if state.used >= total {
        request := request_parts(state.storage[..state.used], head)
        request.context = state.context
        if #len(request.method) == 0 {
          return receive_failure(state, ErrorKind.Invalid, 0)
        }
        state.consumed = total
        return ReceiveResult{ request: request, response: Response{ output: state.output }, detail: ErrorKind.None }
      }
    }
    // End is a transport state until all buffered requests have been consumed.
    if state.ended {
      if state.used == 0 {
        return receive_failure(state, ErrorKind.End, 0)
      }
      failure := receive_failure(state, ErrorKind.Invalid, 0)
      state.first.offset = state.used
      failure.offset = state.used
      return failure
    }
    if state.used == #len(state.storage) {
      return receive_failure(state, ErrorKind.Capacity, 0)
    }
    input := io.read(state.input, state.storage[state.used..])
    if input.transferred > #len(state.storage) - state.used {
      return receive_failure(state, ErrorKind.Io, 0)
    }
    state.used += input.transferred
    if input.status == io.Status.Error {
      failure := receive_failure(state, ErrorKind.Io, input.error)
      state.first.failure.kind = input.kind
      failure.failure.kind = input.kind
      return failure
    }
    state.ended = input.status == io.Status.End
    if input.transferred == 0 {
      if !state.ended {
        return receive_failure(state, ErrorKind.Io, 0)
      }
      if state.used == 0 {
        return receive_failure(state, ErrorKind.End, 0)
      }
      failure := receive_failure(state, ErrorKind.Invalid, 0)
      state.first.offset = state.used
      failure.offset = state.used
      return failure
    }
  }
  return ReceiveResult{ failure: io.Failure{ kind: io.Kind.System } }
}

fn status_reason(status: u16) []const u8 {
  if status == 200 {
    return "OK"
  }
  if status == 201 {
    return "Created"
  }
  if status == 204 {
    return "No Content"
  }
  if status == 303 {
    return "See Other"
  }
  if status == 400 {
    return "Bad Request"
  }
  if status == 401 {
    return "Unauthorized"
  }
  if status == 403 {
    return "Forbidden"
  }
  if status == 404 {
    return "Not Found"
  }
  if status == 405 {
    return "Method Not Allowed"
  }
  if status == 409 {
    return "Conflict"
  }
  if status == 422 {
    return "Unprocessable Content"
  }
  if status == 429 {
    return "Too Many Requests"
  }
  if status == 503 {
    return "Service Unavailable"
  }
  if status == 413 {
    return "Payload Too Large"
  }
  if status == 500 {
    return "Internal Server Error"
  }
  return "Status"
}

fn decimal(destination: []u8, value: usize) []const u8 {
  digits: [20 + memory.ArenaBufferOverhead]u8 = []
  scratch := memory.arena_from_buffer(digits[..])
  text := format.u64_decimal(scratch, value)
  if #len(text) > #len(destination) {
    return destination[..0]
  }
  for i in 0..#len(text) {
    destination[i] = text[i]
  }
  return destination[..#len(text)]
}

fn write_output(destination: io.Writer, bytes: []const u8) Result {
  written := io.write_all(destination, bytes)
  if written.status == io.Status.Error {
    return Result{ detail: ErrorKind.Io, failure: io.Failure{ kind: written.kind, native: written.error } }
  }
  return Result{ detail: ErrorKind.None }
}

fn response_failure(response: *Response, result: Result) Result {
  if !response.failed {
    response.failed = true
    response.first = result
    if response.first_stream.status != io.Status.Error {
      response.first_stream = io.Transfer{ error: 0, kind: io.Kind.InvalidState, status: io.Status.Error }
    }
  }
  return response.first
}

fn response_output(response: *Response, source: []const u8) Result {
  if response.failed {
    return response.first
  }
  written := io.write_all(response.output, source)
  if written.status == io.Status.Error {
    response.first_stream = io.Transfer{ error: written.error, kind: written.kind, status: io.Status.Error }
    return response_failure(response, Result{ detail: ErrorKind.Io, failure: io.Failure{ kind: written.kind, native: written.error } })
  }
  return Result{}
}

fn header_valid(item: Header) bool {
  if #len(item.name) == 0 {
    return false
  }
  for byte in item.name {
    if !token_byte(byte) {
      return false
    }
  }
  for byte in item.value {
    if byte == '\r' || byte == '\n' || byte == 0 {
      return false
    }
  }
  return true
}
fn text_valid(value: []const u8) bool {
  for byte in value {
    if byte == '\r' || byte == '\n' || byte == 0 {
      return false
    }
  }
  return true
}

enum HeadMode { Measure, Stage, Direct }
struct HeadWriter { mode: HeadMode, staging: []u8, used: usize, response: *Response, failed: bool }
fn head_emit(writer: *HeadWriter, piece: []const u8) {
  if writer.failed {
    return
  }
  if writer.mode == HeadMode.Measure {
    writer.used += #len(piece)
  } else if writer.mode == HeadMode.Stage {
    writer.used = append_bytes(writer.staging, writer.used, piece)
  } else {
    writer.failed = response_output(writer.response, piece).failure.kind != io.Kind.Ok
  }
}
fn head_write(writer: *HeadWriter, options: ResponseOptions, status: u16, reason: []const u8, content_type: []const u8, body_length: usize, chunked: bool) {
  number_storage: [20]u8 = []
  head_emit(writer, "HTTP/1.1 ")
  head_emit(writer, decimal(number_storage[..], status))
  head_emit(writer, " ")
  head_emit(writer, reason)
  head_emit(writer, "\r\nContent-Type: ")
  head_emit(writer, content_type)
  if chunked {
    head_emit(writer, "\r\nTransfer-Encoding: chunked")
  } else {
    head_emit(writer, "\r\nContent-Length: ")
    head_emit(writer, decimal(number_storage[..], body_length))
  }
  for item in options.headers {
    head_emit(writer, "\r\n")
    head_emit(writer, item.name)
    head_emit(writer, ": ")
    head_emit(writer, item.value)
  }
  if options.close_connection {
    head_emit(writer, "\r\nConnection: close\r\n\r\n")
  } else {
    head_emit(writer, "\r\nConnection: keep-alive\r\n\r\n")
  }
}

// Writes the response head, followed by body when given. Head and body leave in
// one write when they fit in a stack staging buffer: separate small writes on a
// keep-alive socket stall on Nagle plus delayed ACK (about 40 ms per response).
fn response_begin(response: *Response, options: ResponseOptions, body_length: usize, chunked: bool, body: []const u8) Result {
  if response.failed {
    return response.first
  }
  if response.started || response.finished || response.output.write == nil {
    return response_failure(response, Result{ detail: ErrorKind.Invalid, failure: io.Failure{ kind: io.Kind.InvalidState } })
  }
  status := options.status
  if status == 0 {
    status = StatusOk
  }
  reason := options.reason
  if #len(reason) == 0 {
    reason = status_reason(status)
  }
  content_type := options.content_type
  if #len(content_type) == 0 {
    content_type = "application/octet-stream"
  }
  // Rejected before any byte is written; the response stays unstarted.
  if !text_valid(reason) || !text_valid(content_type) {
    return Result{ detail: ErrorKind.Invalid, failure: io.Failure{ kind: io.Kind.InvalidInput } }
  }
  for item in options.headers {
    if !header_valid(item) {
      return Result{ detail: ErrorKind.Invalid, failure: io.Failure{ kind: io.Kind.InvalidInput } }
    }
  }
  staging: [8 * memory.KiB]u8 = []
  measure := HeadWriter{ mode: HeadMode.Measure, response: response }
  head_write(&measure, options, status, reason, content_type, body_length, chunked)
  head_length := measure.used
  if head_length <= #len(staging) {
    stage := HeadWriter{ mode: HeadMode.Stage, staging: staging[..], response: response }
    head_write(&stage, options, status, reason, content_type, body_length, chunked)
    if #len(body) <= #len(staging) - head_length {
      // Common case: head and body in one write.
      used := append_bytes(staging[..], head_length, body)
      result := response_output(response, staging[..used])
      if !io.failed(result.failure) {
        response.started = true
      }
      return result
    }
    if response_output(response, staging[..head_length]).failure.kind != io.Kind.Ok {
      return response.first
    }
  } else {
    direct := HeadWriter{ mode: HeadMode.Direct, response: response }
    head_write(&direct, options, status, reason, content_type, body_length, chunked)
    if direct.failed {
      return response.first
    }
  }
  response.started = true
  return response_output(response, body)
}

// First request header named name (ASCII case-insensitive). The value borrows
// request.raw. Each call scans the head.
pub fn request_header(request: *const Request, name: []const u8) HttpHeader {
  return header(request.raw[..request.header_length], name)
}

pub struct FieldValue { value: []u8, found: bool, failure: parse.Failure }

// application/x-www-form-urlencoded value into destination: '+' becomes a
// space and %XX a byte. Fails with Syntax on a bad escape and Capacity when
// destination is too small; destination contents are then unspecified.
pub fn form_decode(destination: []u8, source: []const u8) FieldValue {
  at: usize = 0
  i: usize = 0
  for i < #len(source) {
    if at == #len(destination) {
      return FieldValue{ found: true, failure: parse.Failure{ kind: parse.Kind.Capacity, offset: i } }
    }
    byte := source[i]
    if byte == '%' {
      if #len(source) - i < 3 || hex(source[i + 1]) < 0 || hex(source[i + 2]) < 0 {
        return FieldValue{ found: true, failure: parse.Failure{ kind: parse.Kind.Syntax, offset: i } }
      }
      destination[at] = #cast(u8, hex(source[i + 1]) * 16 + hex(source[i + 2]))
      i += 3
    } else {
      if byte == '+' {
        byte = ' '
      }
      destination[at] = byte
      i += 1
    }
    at += 1
  }
  return FieldValue{ value: destination[..at], found: true }
}

// Raw, still-encoded value of the first field named name in an urlencoded
// form or query string.
pub fn form_field(form: []const u8, name: []const u8) HttpHeader {
  start: usize = 0
  for start <= #len(form) {
    end := start + bytes.find_byte(form[start..], '&')
    pair := form[start..end]
    equals := bytes.find_byte(pair, '=')
    if bytes.equal(pair[..equals], name) {
      if equals == #len(pair) {
        return HttpHeader{ name: pair, value: pair[..0], found: true }
      }
      return HttpHeader{ name: pair[..equals], value: pair[equals + 1..], found: true }
    }
    start = end + 1
  }
  return HttpHeader{}
}

// Decoded query parameter name into destination. found is false when absent.
pub fn query_value(request: *const Request, name: []const u8, destination: []u8) FieldValue {
  field := form_field(request.query, name)
  if !field.found {
    return FieldValue{}
  }
  return form_decode(destination, field.value)
}

// Decoded urlencoded body field name into destination. The caller checks the
// content type when it matters. found is false when absent.
pub fn form_value(request: *const Request, name: []const u8, destination: []u8) FieldValue {
  field := form_field(request.body, name)
  if !field.found {
    return FieldValue{}
  }
  return form_decode(destination, field.value)
}

pub fn respond(response: *Response, body: []const u8, options: ResponseOptions) Result {
  written := response_begin(response, options, #len(body), false, body)
  if !io.failed(written.failure) {
    response.finished = true
  }
  return written
}

pub fn respond_stream(response: *Response, options: ResponseOptions) BodyResult {
  started := response_begin(response, options, 0, true, "")
  if io.failed(started.failure) {
    return BodyResult{ detail: started.detail, body: Body{ failed: true, first: started, first_stream: response.first_stream }, result: started, failure: io.Failure{ kind: started.failure.kind, native: started.failure.native } }
  }
  response.finished = true
  return BodyResult{ body: Body{ output: response.output }, result: Result{ detail: ErrorKind.None } }
}

fn hex_size(destination: []u8, value: usize) []const u8 {
  digits: []const u8 = "0123456789abcdef"
  end := #len(destination)
  number := value
  if number == 0 {
    destination[end - 1] = '0'
    return destination[end - 1..]
  }
  for number > 0 && end > 0 {
    end -= 1
    destination[end] = digits[number & 15]
    number >>= 4
  }
  if number != 0 {
    return destination[..0]
  }
  return destination[end..]
}

fn body_failure(body: *Body, result: Result, native: io.Transfer) Result {
  if !body.failed {
    body.failed = true
    body.first = result
    body.first_stream = io.Transfer{ error: native.error, kind: native.kind, status: io.Status.Error }
  }
  return body.first
}

fn body_invalid(body: *Body) Result {
  return body_failure(body, Result{ detail: ErrorKind.Invalid, failure: io.Failure{ kind: io.Kind.InvalidState } }, io.Transfer{ error: 0, kind: io.Kind.InvalidState, status: io.Status.Error })
}

fn body_output(body: *Body, source: []const u8) io.Transfer {
  if body.failed {
    return body.first_stream
  }
  result := io.write_all(body.output, source)
  if result.status == io.Status.Error {
    _ = body_failure(body, Result{ detail: ErrorKind.Io, failure: io.Failure{ kind: result.kind, native: result.error } }, result)
  }
  return result
}

fn body_write(data: rawptr, source: []const u8) io.Transfer {
  body := #cast(*Body, data)
  if body.failed {
    return body.first_stream
  }
  if body.finished || body.output.write == nil {
    _ = body_invalid(body)
    return body.first_stream
  }
  if #len(source) == 0 {
    return io.Transfer{ status: io.Status.Complete }
  }
  size_storage: [16]u8 = []
  size := hex_size(size_storage[..], #len(source))
  first := body_output(body, size)
  if first.status == io.Status.Error {
    return first
  }
  separator := body_output(body, "\r\n")
  if separator.status == io.Status.Error {
    return separator
  }
  content := body_output(body, source)
  if content.status == io.Status.Error {
    return content
  }
  ending := body_output(body, "\r\n")
  if ending.status == io.Status.Error {
    return ending
  }
  return io.Transfer{ transferred: #len(source), status: io.Status.Complete }
}

// Borrows a stable Body slot: do not move or destroy it during the writer's lifetime.
pub fn body_writer(body: *Body) io.Writer {
  return io.Writer{ data: body, write: body_write }
}

pub fn body_finish(body: *Body) Result {
  if body.failed {
    return body.first
  }
  if body.finished || body.output.write == nil {
    return body_invalid(body)
  }
  result := body_output(body, "0\r\n\r\n")
  if result.status == io.Status.Error {
    return body.first
  }
  body.finished = true
  return Result{}
}

pub fn body_abort(body: *Body) Result {
  if body.failed {
    return body.first
  }
  if body.output.write == nil {
    return body_invalid(body)
  }
  body.finished = true
  return Result{ detail: ErrorKind.None }
}

pub fn serve_connection(connection: *network.Connection, storage: []u8, handler: Handler) Result {
  return serve_connection_context(connection, storage, handler, nil)
}

// Like serve_connection; every Request carries context for the handler.
pub fn serve_connection_context(connection: *network.Connection, storage: []u8, handler: Handler, context: rawptr) Result {
  return serve_stream_context(network.connection_reader(connection), network.connection_writer(connection), storage, handler, context)
}

// Stream seam shared by plain TCP, TLS, tests, and embedded transports.
pub fn serve_stream(input: io.Reader, output: io.Writer, storage: []u8, handler: Handler) Result {
  return serve_stream_context(input, output, storage, handler, nil)
}

// Like serve_stream; every Request carries context, borrowed application state
// the handler casts back to its own type. The caller keeps it alive.
pub fn serve_stream_context(input: io.Reader, output: io.Writer, storage: []u8, handler: Handler, context: rawptr) Result {
  if handler == nil || #len(storage) == 0 {
    return Result{ detail: ErrorKind.Invalid, failure: io.Failure{ kind: io.Kind.InvalidInput } }
  }
  state := connection_server(input, output, storage)
  state.context = context
  for true {
    received := receive(&state)
    if received.detail != ErrorKind.None {
      if received.detail == ErrorKind.End {
        return Result{ detail: ErrorKind.None }
      }
      // Tell the client why the connection closes. The reply is best effort:
      // the receive error is reported either way.
      if received.detail == ErrorKind.Invalid || received.detail == ErrorKind.Capacity {
        rejected := Response{ output: output }
        options := ResponseOptions{ status: StatusBadRequest, content_type: "text/plain; charset=utf-8", close_connection: true }
        body := "bad request\n"
        if received.detail == ErrorKind.Capacity {
          options.status = StatusPayloadTooLarge
          body = "request too large\n"
        }
        _ = respond(&rejected, body, options)
      }
      return Result{ detail: received.detail, offset: received.offset, failure: io.Failure{ kind: received.failure.kind, native: received.failure.native } }
    }
    handled := handler(&received.response, &received.request)
    if io.failed(handled.failure) {
      return handled
    }
    if !received.request.keep_alive {
      return Result{ detail: ErrorKind.None }
    }
  }
  return Result{ detail: ErrorKind.None }
}

// Complete exchange; returned response slices belong to arena. Failures rewind.
pub fn client_do(arena: *memory.Arena, input: io.Reader, output: io.Writer,
  method: []const u8, target: []const u8, host: []const u8, body: []const u8) ClientResponse {
  validate_borrow(arena, method)
  validate_borrow(arena, target)
  validate_borrow(arena, host)
  validate_borrow(arena, body)
  mark := memory.arena_mark(arena)
  request_bytes := write_request(arena, method, target, host, body)
  sent := io.write_all(output, request_bytes)
  memory.arena_rewind(arena, mark)
  if sent.status == io.Status.Error {
    return ClientResponse{ detail: ErrorKind.Io, failure: io.Failure{ kind: sent.kind, native: sent.error } }
  }
  result := client_receive(arena, input, method)
  if io.failed(result.failure) {
    memory.arena_rewind(arena, mark)
  }
  return result
}

fn client_receive(arena: *memory.Arena, input: io.Reader, method: []const u8) ClientResponse {
  response_storage := arena.data[..0]
  used: usize = 0
  ended := false
  head := HttpHead{}
  head_scan: usize = 0
  head_checked := false
  chunks := ChunkProgress{}
  for {
    if !head_checked && head_complete(response_storage[..used], &head_scan) {
      head = parse_response(response_storage[..used])
      head_checked = true
      if head.failure.kind != parse.Kind.Ok {
        return ClientResponse{ offset: head.offset, detail: ErrorKind.Invalid, failure: io.Failure{ kind: io.Kind.InvalidInput } }
      }
    }
    if head_checked {
      if head.code >= 100 && head.code < 200 && head.code != 101 {
        remaining := used - head.header_length
        for i in 0..remaining {
          response_storage[i] = response_storage[head.header_length + i]
        }
        used = remaining
        response_mark := memory.arena_mark(arena) - #len(response_storage)
        memory.arena_rewind(arena, response_mark + used)
        response_storage = response_storage[..used]
        head = HttpHead{}
        head_scan = 0
        head_checked = false
        continue
      }
      framing := head.framing
      if bytes.equal(method, "HEAD") || (bytes.equal(method, "CONNECT") && head.code >= 200 && head.code < 300) {
        framing = Framing.None
      }
      body_length: usize = 0
      complete := framing == Framing.None
      if framing == Framing.Length {
        body_length = head.content_length
        complete = used - head.header_length >= body_length
      } else if framing == Framing.Close {
        body_length = used - head.header_length
        complete = ended
      } else if framing == Framing.Chunked {
        scanned := chunk_progress(&chunks, response_storage[head.header_length..used])
        decoded := scanned
        if !io.failed(scanned.failure) {
          decoded = scan_chunked(response_storage[head.header_length..used], response_storage[head.header_length..], true)
        }
        if !io.failed(decoded.failure) {
          body_length = decoded.count
          complete = true
        } else if decoded.failure.kind != io.Kind.WouldBlock {
          return ClientResponse{ offset: head.header_length + decoded.offset, detail: ErrorKind.Invalid, failure: io.Failure{ kind: decoded.failure.kind, native: decoded.failure.native } }
        }
      }
      if complete {
        total := head.header_length + body_length
        // append_many can move the contiguous response into a later block.
        // Its start is unrelated to the exchange's rollback entry mark.
        response_mark := memory.arena_mark(arena) - #len(response_storage)
        memory.arena_rewind(arena, response_mark + total)
        return ClientResponse{ raw: response_storage[..total], body: response_storage[head.header_length..total], status: head.code }
      }
    }
    if ended {
      return ClientResponse{ offset: used, detail: ErrorKind.Invalid, failure: io.Failure{ kind: io.Kind.InvalidInput } }
    }
    scratch: [4096]u8 = []
    part := io.read(input, scratch[..])
    if part.transferred > #len(scratch) {
      return ClientResponse{ detail: ErrorKind.Io, failure: io.Failure{ kind: io.Kind.System } }
    }
    if part.status == io.Status.Error {
      return ClientResponse{ detail: ErrorKind.Io, failure: io.Failure{ kind: part.kind, native: part.error } }
    }
    memory.append_many_grow(arena, &response_storage, scratch[..part.transferred])
    used += part.transferred
    ended = part.status == io.Status.End
    if part.transferred == 0 && !ended {
      return ClientResponse{ detail: ErrorKind.Io, failure: io.Failure{ kind: io.Kind.System } }
    }
  }
  return ClientResponse{ detail: ErrorKind.Io, failure: io.Failure{ kind: io.Kind.System } }
}

pub fn client_do_connection(arena: *memory.Arena, connection: *network.Connection,
  method: []const u8, target: []const u8, host: []const u8, body: []const u8) ClientResponse {
  return client_do(arena, network.connection_reader(connection), network.connection_writer(connection),
    method, target, host, body)
}

// A complete HTTP/1.1 request with Connection: close, in arena.
pub fn write_request(arena: *memory.Arena, method: []const u8, target: []const u8, host: []const u8, body: []const u8) []u8 {
  validate_borrow(arena, method)
  validate_borrow(arena, target)
  validate_borrow(arena, host)
  validate_borrow(arena, body)
  digits: usize = 1
  number := #len(body)
  for number >= 10 {
    digits += 1
    number /= 10
  }
  size: usize = 59 + digits
  if #len(target) > 0 && target[0] == '?' {
    size += 1
  }
  for length in [#len(method), #len(target), #len(host), #len(body)] {
    if length > #max(usize) - size {
      #panic("HTTP request size overflows")
    }
    size += length
  }
  mark := memory.arena_mark(arena)
  space := memory.push_bytes_uninit(arena, size)
  output := request_into(space, method, target, host, body)
  memory.arena_rewind(arena, mark + #len(output))
  return output
}

// A complete HTTP/1.1 response with Connection: close, in arena.
pub fn write_response(arena: *memory.Arena, code: u16, reason: []const u8, content_type: []const u8, body: []const u8) []u8 {
  size: usize = 96 + #len(reason) + #len(content_type) + #len(body)
  mark := memory.arena_mark(arena)
  space := memory.push_bytes_uninit(arena, size)
  output := response_into(space, code, reason, content_type, body)
  memory.arena_rewind(arena, mark + #len(output))
  return output
}
