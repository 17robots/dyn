use bytes "std/bytes"

// multipart/form-data request bodies (RFC 7578). Parts borrow the request
// body; nothing is copied or allocated. The whole body must fit the server's
// receive buffer, so size uploads with Config.receive_size.

pub struct Part {
  // From Content-Disposition: the field name, and the file name when the
  // part is a file. Quotes are removed; backslash escapes are kept as sent.
  name: []const u8,
  filename: []const u8,
  has_filename: bool,
  // Empty means text/plain.
  content_type: []const u8,
  body: []const u8,
}

pub struct Parts {
  delimiter: [74]u8,
  delimiter_length: usize,
  rest: []const u8,
  done: bool,
  failed: bool,
  // Set by a next_part call that returns no part: after the closing
  // delimiter, or after a failure.
  ended: bool,
}

// A malformed part or body: the reader stays failed and ended.
fn parts_failed(reader: *Parts) io.IoErr {
  reader.failed = true
  reader.ended = true
  return io.IoErr.InvalidInput
}

// The boundary parameter of a multipart Content-Type, unquoted.
fn boundary_of(content_type: []const u8) []const u8 {
  rest := content_type
  for rest.len > 0 {
    end := bytes.find_byte(rest, ';')
    item := trim_ows(rest[..end])
    equals := bytes.find_byte(item, '=')
    if equals < item.len && ascii_equal(trim_ows(item[..equals]), "boundary") {
      value := trim_ows(item[equals + 1..])
      if value.len >= 2 && value[0] == '"' && value[value.len - 1] == '"' {
        value = value[1..value.len - 1]
      }
      return value
    }
    if end >= rest.len { break }
    rest = rest[end + 1..]
  }
  return content_type[..0]
}

// Starts reading a multipart/form-data body. Fails with InvalidInput when the
// Content-Type is not multipart/form-data or has no valid boundary (1-70
// bytes), or the body does not start with the first delimiter.
pub fn multipart(request: *const Request) Parts!io.IoErr {
  header := find_header(request, "Content-Type")
  if !header.found || header.value.len < 19 || !ascii_equal(header.value[..19], "multipart/form-data") {
    fail .InvalidInput
  }
  boundary := boundary_of(header.value)
  if boundary.len == 0 || boundary.len > 70 { fail .InvalidInput }
  reader := Parts{}
  reader.delimiter[0] = '\r'
  reader.delimiter[1] = '\n'
  reader.delimiter[2] = '-'
  reader.delimiter[3] = '-'
  for i in 0..boundary.len {
    reader.delimiter[4 + i] = boundary[i]
  }
  reader.delimiter_length = 4 + boundary.len
  body := request.body
  // The first delimiter may lack its leading CRLF; a preamble is skipped.
  first := reader.delimiter[2..reader.delimiter_length]
  at: usize = 0
  if !bytes.starts_with(body, first) {
    found := bytes.find(body, reader.delimiter[..reader.delimiter_length])
    if found == body.len { fail .InvalidInput }
    at = found + 2
  }
  reader.rest = body[at + first.len..]
  return reader
}

// A Content-Disposition parameter such as name="field", unquoted.
fn disposition_parameter(value: []const u8, wanted: []const u8) HttpHeader {
  rest := value
  for rest.len > 0 {
    // Split on ';' outside quotes.
    end: usize = 0
    quoted := false
    for end < rest.len && (quoted || rest[end] != ';') {
      if rest[end] == '"' {
        quoted = !quoted
      } else if rest[end] == '\\' && quoted && end + 1 < rest.len {
        end += 1
      }
      end += 1
    }
    item := trim_ows(rest[..end])
    equals := bytes.find_byte(item, '=')
    if equals < item.len && ascii_equal(trim_ows(item[..equals]), wanted) {
      text := trim_ows(item[equals + 1..])
      if text.len >= 2 && text[0] == '"' && text[text.len - 1] == '"' {
        text = text[1..text.len - 1]
      }
      return HttpHeader{ name: wanted, value: text, found: true }
    }
    if end >= rest.len { break }
    rest = rest[end + 1..]
  }
  return HttpHeader{}
}

// The next part. Sets reader.ended after the closing delimiter. Fails with
// InvalidInput on a malformed part or a body cut short; after that the
// reader stays failed.
fn parts_ended(reader: *Parts) Part {
  reader.ended = true
  return Part{}
}
pub fn next_part(reader: *Parts) Part!io.IoErr {
  // An earlier part was malformed.
  if reader.failed { fail parts_failed(reader) }
  if reader.done { return parts_ended(reader) }
  rest := reader.rest
  // After a delimiter: "--" closes, otherwise optional padding and CRLF.
  if bytes.starts_with(rest, "--") {
    reader.done = true
    return parts_ended(reader)
  }
  line_end := bytes.find(rest, "\r\n")
  if line_end == rest.len || trim_ows(rest[..line_end]).len != 0 { fail parts_failed(reader) }
  rest = rest[line_end + 2..]
  part := Part{}
  disposition := false
  for true {
    end := bytes.find(rest, "\r\n")
    if end == rest.len { fail parts_failed(reader) }
    line := rest[..end]
    rest = rest[end + 2..]
    if line.len == 0 { break }
    colon := bytes.find_byte(line, ':')
    if colon == line.len { fail parts_failed(reader) }
    field := trim_ows(line[..colon])
    value := trim_ows(line[colon + 1..])
    if ascii_equal(field, "content-disposition") {
      if value.len < 9 || !ascii_equal(value[..9], "form-data") { fail parts_failed(reader) }
      part.name = disposition_parameter(value, "name").value
      file := disposition_parameter(value, "filename")
      part.filename = file.value
      part.has_filename = file.found
      disposition = true
    } else if ascii_equal(field, "content-type") {
      part.content_type = value
    }
  }
  if !disposition { fail parts_failed(reader) }
  delimiter := reader.delimiter[..reader.delimiter_length]
  end := bytes.find(rest, delimiter)
  if end == rest.len { fail parts_failed(reader) }
  part.body = rest[..end]
  reader.rest = rest[end + delimiter.len..]
  return part
}
