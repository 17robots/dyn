// Cookie sessions for the evented server: tokens, CSRF secrets, the sid
// cookie, and a per-worker cache in front of the app's own store. The app
// keeps sessions where it likes (a SQLite table, say): start makes a new
// one to store, cached answers from memory, remember adds what the store
// returned, and forget invalidates every worker's cache after a logout.
use bytes "std/bytes"
use versions "std/cache"
use crypto "std/crypto/core"
use "std/fail"
use io "std/io"
use random "std/crypto/random"
use hex "std/encoding/hex"
use mem "std/mem"
use http "std/net/http"

// The cookie's name, and the lengths of a token and a CSRF secret (hex).
pub const CookieName: []const u8 = "sid"
pub const TokenLength: usize = 64
pub const CsrfLength: usize = 32
pub const Slots: usize = 256
pub const DataSize: usize = 64

// A session as handlers see it. csrf and data point into the cache, valid
// until the worker's next request.
pub struct Session { user: i64, csrf: []const u8, data: []const u8 }

struct Slot { token: [64]u8, user: i64, csrf: [32]u8, data: [64]u8, data_length: usize, expires: i64 }

// One per worker; only that worker touches it.
pub struct Cache { slots: [Slots]Slot, copy: versions.Copy }

// Shared by the workers: forget marks every cache stale, and each empties
// itself when it notices.
pub struct Shared { sessions: versions.Shared }

// A new session to store: token, csrf, and the Set-Cookie value.
pub struct New { token: []const u8, csrf: []const u8, cookie: http.Cookie }

// The request's session token, or empty when it has none of the right form.
pub fn token(request: *const http.Request) []const u8 {
  // No session cookie is the usual case for a new visitor.
  value := http.cookie(request, CookieName) catch ""
  if value.len != TokenLength { return "" }
  return value
}

// The session for token from the cache: a store answer for it that is
// unexpired at now and not forgotten since. NotFound when there is none;
// then ask the store and remember its answer.
pub fn cached(cache: *Cache, shared: *Shared, token: []const u8, now: i64) Session!io.IoErr {
  seen := versions.stale(&cache.copy, &shared.sessions)
  if seen != 0 {
    for i in 0..Slots {
      cache.slots[i].expires = 0
    }
    versions.rebuilt(&cache.copy, seen)
  }
  // No session token, or not cached.
  if token.len != TokenLength { fail .NotFound }
  slot := slot_of(cache, token)
  if slot.expires <= now || !bytes.equal(slot.token[..], token) { fail .NotFound }
  return Session{ user: slot.user, csrf: slot.csrf[..], data: slot.data[..slot.data_length] }
}

// Caches what the store returned for token and returns it as a Session.
// InvalidInput when token or csrf has the wrong length or data is too long.
pub fn remember(cache: *Cache, token: []const u8, user: i64, csrf: []const u8, data: []const u8,
  expires: i64) Session!io.IoErr {
  if token.len != TokenLength || csrf.len != CsrfLength || data.len > DataSize { fail .InvalidInput }
  slot := slot_of(cache, token)
  slot.* = Slot{ user: user, data_length: data.len, expires: expires }
  _ = mem.copy(slot.token[..], token)
  _ = mem.copy(slot.csrf[..], csrf)
  _ = mem.copy(slot.data[..], data)
  return Session{ user: user, csrf: slot.csrf[..], data: slot.data[..slot.data_length] }
}

// A fresh token and CSRF secret in arena, and the cookie that carries the
// token for a session of seconds (HttpOnly, SameSite=Lax, Path=/): pass it in
// ResponseOptions.cookies or to http.redirect. Fails with System when the
// system has no randomness.
pub fn start(arena: *mem.Arena, seconds: i64) New!io.IoErr {
  raw: [32]u8
  drawing: fail.Status
  random.fill(&drawing, raw[..])
  try io.check_status(&drawing)
  token := hex.encode(arena, raw[..], false)
  random.fill(&drawing, raw[..16])
  try io.check_status(&drawing)
  csrf := hex.encode(arena, raw[..16], false)
  cookie := http.Cookie{ name: CookieName, value: token, path: "/", max_age: seconds, http_only: true, same_site: http.SameSite.Lax }
  return New{ token: token, csrf: csrf, cookie: cookie }
}

// After the app deleted a session from its store: every worker's cache
// forgets what it holds. Returns the cookie that clears the session cookie.
pub fn forget(shared: *Shared) http.Cookie {
  versions.changed(&shared.sessions)
  return http.Cookie{ name: CookieName, path: "/", max_age: -1, http_only: true, same_site: http.SameSite.Lax }
}

// Whether presented (a form field or header) is the session's CSRF secret,
// compared in constant time. Always false for an empty Session.
pub fn csrf_ok(session: *const Session, presented: []const u8) bool {
  return session.csrf.len == CsrfLength && crypto.equal_constant_time(presented, session.csrf)
}

// The token's last bytes are random hex: they pick its slot.
fn slot_of(cache: *Cache, token: []const u8) *Slot {
  return &cache.slots[(#cast(usize, token[TokenLength - 2]) * 16 + #cast(usize, token[TokenLength - 1])) % Slots]
}
