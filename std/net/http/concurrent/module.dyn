#target(kernel: linux)

use "std/net/http" http
use "std/thread" threading

pub struct Worker {
  thread: threading.Thread,
  listener: *http.Listener,
  handler: http.Handler,
  storage: []u8,
  error: http.Result,
}

pub struct Result { started: usize, error: isize, ok: bool }

fn worker_main(context: rawptr) isize {
  worker := #cast(*Worker) context
  for true {
    accepted := http.accept(worker.listener)
    if !accepted.ok { worker.error = http.Result{ error: http.ErrorKind.Io, system_error: accepted.error } return accepted.error }
    socket := accepted.connection
    handled := http.serve_connection(&socket, worker.storage, worker.handler)
    close_error := http.close(&socket)
    if !handled.ok { worker.error = handled return handled.system_error }
    if close_error != 0 { worker.error = http.Result{ error: http.ErrorKind.Io, system_error: close_error } return close_error }
  }
  return 0
}

// Starts a fixed worker pool. Storage and stacks are partitioned without allocation.
// Closing the shared listener causes workers to exit; call join afterward.
pub fn start(workers: []Worker, listener: *http.Listener, receive_storage: []u8,
  worker_storage_size: usize, stacks: []u8, stack_size: usize, handler: http.Handler) Result {
  if #len(workers) == 0 || listener == nil || handler == nil || worker_storage_size == 0 || stack_size < 256 ||
    worker_storage_size > #len(receive_storage) / #len(workers) || stack_size > #len(stacks) / #len(workers) {
    return Result{ error: -22 }
  }
  i: usize = 0
  for i < #len(workers) {
    workers[i].listener = listener
    workers[i].handler = handler
    workers[i].storage = receive_storage[i * worker_storage_size..(i + 1) * worker_storage_size]
    spawned := threading.spawn(&workers[i].thread, stacks[i * stack_size..(i + 1) * stack_size],
      &worker_main, #cast(rawptr) &workers[i])
    if spawned != 0 { return Result{ started: i, error: spawned } }
    i += 1
  }
  return Result{ started: #len(workers), ok: true }
}

pub fn join(workers: []Worker) Result {
  i: usize = 0
  for i < #len(workers) {
    joined := threading.join(&workers[i].thread)
    if joined != 0 { return Result{ started: i, error: joined } }
    if !workers[i].error.ok && workers[i].error.error != http.ErrorKind.None &&
      workers[i].error.system_error != -9 && workers[i].error.system_error != -22 {
      return Result{ started: i + 1, error: workers[i].error.system_error }
    }
    i += 1
  }
  return Result{ started: #len(workers), ok: true }
}
