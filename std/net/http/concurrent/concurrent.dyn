#target(kernel: linux)

use "std/net/http" http
use "std/net" network
use "std/thread" threading
use "std/sync" sync
use "std/mem" mem
use "std/errors" errors

pub struct Worker {
  thread: *threading.Thread,
  listener: *http.Listener,
  handler: http.Handler,
  context: rawptr,
  storage: []u8,
  error: Result,
  stopping: sync.AtomicU32,
  control: sync.Mutex,
  active_descriptor: isize,
  active_socket: bool,
  request_errors: usize,
}
pub struct Result { started: usize, error: isize, kind: errors.Kind, ok: bool }

fn worker_main(context: rawptr) isize {
  worker := #cast(*Worker, context)
  for sync.load_u32(&worker.stopping) == 0 {
    accepted := http.accept(worker.listener)
    if !accepted.ok {
      if sync.load_u32(&worker.stopping) != 0 {
        return 0
      }
      if accepted.kind == errors.Kind.Interrupted {
        continue
      }
      worker.error = Result{ kind: accepted.kind, error: accepted.error }
      if worker.error.kind == errors.Kind.None {
        worker.error.kind = errors.Kind.System
      }
      return accepted.error
    }
    socket := accepted.value
    sync.lock(&worker.control)
    if sync.load_u32(&worker.stopping) != 0 {
      _ = http.close(&socket)
      sync.unlock(&worker.control)
      return 0
    }
    worker.active_descriptor = socket.descriptor
    worker.active_socket = true
    sync.unlock(&worker.control)
    handled := http.serve_connection_context(&socket, worker.storage, worker.handler, worker.context)
    // Serialize shutdown and close so stop cannot act on a recycled descriptor.
    sync.lock(&worker.control)
    close_error := http.close(&socket)
    worker.active_socket = false
    sync.unlock(&worker.control)
    if !handled.ok || !close_error.ok {
      worker.request_errors += 1
    }
  }
  return 0
}

// Call stop, then join, then close the listener. Never close it while workers run.
// stop interrupts blocked accept/read/write, but cannot cancel arbitrary handler code.
pub fn stop(workers: []Worker) {
  for *worker in workers {
    sync.store_u32(&worker.stopping, 1)
  }
  for *active_worker in workers {
    if active_worker.listener != nil && active_worker.listener.active {
      _ = network.shutdown(active_worker.listener.descriptor, network.ShutdownBoth)
    }
    sync.lock(&active_worker.control)
    if active_worker.active_socket {
      _ = network.shutdown(active_worker.active_descriptor, network.ShutdownBoth)
    }
    sync.unlock(&active_worker.control)
  }
}

// Backing storage/stacks must be disjoint and live through join. Workers must be
// zero-initialized or already joined. Partial startup is stopped and drained.
// Arena thread nodes and worker addresses must remain stable through successful
// join; do not rewind/reset/release the arena while any worker is live.
pub fn start(arena: *mem.Arena, workers: []Worker, listener: *http.Listener, receive_storage: []u8,
  worker_storage_size: usize, stacks: []u8, stack_size: usize, handler: http.Handler) Result {
  return start_context(arena, workers, listener, receive_storage, worker_storage_size, stacks, stack_size, handler, nil)
}

// Like start; every Request carries context. Workers share it, so the
// application synchronizes any mutable state behind it.
pub fn start_context(arena: *mem.Arena, workers: []Worker, listener: *http.Listener, receive_storage: []u8,
  worker_storage_size: usize, stacks: []u8, stack_size: usize, handler: http.Handler, context: rawptr) Result {
  if #len(workers) == 0 || listener == nil || handler == nil || worker_storage_size == 0 || stack_size < 256 ||
    worker_storage_size > #len(receive_storage) / #len(workers) || stack_size > #len(stacks) / #len(workers) {
    return Result{ kind: errors.Kind.InvalidInput }
  }
  for *worker in workers {
    if worker.thread != nil {
      return Result{ kind: errors.Kind.InvalidState }
    }
  }
  i: usize = 0
  for i < #len(workers) {
    workers[i] = Worker{ listener: listener, handler: handler, context: context,
      storage: receive_storage[i * worker_storage_size..(i + 1) * worker_storage_size] }
    spawned := threading.spawn(arena, stacks[i * stack_size..(i + 1) * stack_size],
      &worker_main, &workers[i])
    if !spawned.ok {
      stop(workers[..i])
      _ = join(workers[..i])
      return Result{ started: i, kind: spawned.kind, error: spawned.error }
    }
    workers[i].thread = spawned.value
    i += 1
  }
  return Result{ started: #len(workers), ok: true }
}

// Always attempts every join; a worker error never strands later live workers.
pub fn join(workers: []Worker) Result {
  result := Result{ ok: true }
  for *worker in workers {
    completed := true
    if worker.thread != nil {
      joined := threading.join(worker.thread)
      completed = joined.ok
      if joined.ok {
        worker.thread = nil
      } else if result.ok {
        result.ok = false
        result.kind = joined.kind
        result.error = joined.error
      }
    }
    // A zero/already joined worker is a successful no-op, as with thread.join.
    if completed {
      result.started += 1
      // Read worker state only after join has established completion.
      if result.ok && worker.error.kind != errors.Kind.None {
        result.ok = false
        result.kind = worker.error.kind
        result.error = worker.error.error
      }
    }
  }
  return result
}
