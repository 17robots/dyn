use "std/io" stream
use "std/net" network

pub type StreamReader = stream.Reader
pub type StreamWriter = stream.Writer
pub type StreamResult = stream.Result
pub type Listener = network.Listener
pub type Connection = network.Connection

pub struct AcceptResult { connection: Connection, error: isize, ok: bool }

pub fn stream_read(input: StreamReader, destination: []u8) StreamResult { return stream.read(input, destination) }
pub fn stream_write_all(output: StreamWriter, source: []const u8) StreamResult { return stream.write_all(output, source) }
pub fn stream_failed(result: StreamResult) bool { return result.status == stream.Status.Error }
pub fn stream_ended(result: StreamResult) bool { return result.status == stream.Status.End }
pub fn accept(listener: *Listener) AcceptResult {
  accepted := network.listener_accept(listener)
  return AcceptResult{ connection: accepted.connection, error: accepted.error, ok: accepted.ok }
}
pub fn close(connection: *Connection) isize {
  result := network.connection_close(connection)
  return result.error
}

pub struct HttpHead {
  code: u16,
  header_length: usize,
  content_length: usize,
  keep_alive: bool,
  chunked: bool,
  ok: bool,
}
pub struct HttpHeader { name: []const u8, value: []const u8, ok: bool }
pub struct Url { scheme: []const u8, host: []const u8, port: u16, target: []const u8, secure: bool, ok: bool }

pub struct HttpIoResult {
  count: usize,
  error: isize,
  ok: bool,
}

fn append_bytes(destination: []u8, offset: usize, source: []const u8) usize {
  if offset > #len(destination) || #len(source) > #len(destination) - offset { return #len(destination) + 1 }
  i: usize = 0
  for i < #len(source) {
    destination[offset + i] = source[i]
    i += 1
  }
  return offset + #len(source)
}

fn append_usize(destination: []u8, offset: usize, value: usize) usize {
  digits: [20]u8 = []
  count: usize = 0
  number := value
  if number == 0 {
    digits[0] = '0'
    count = 1
  }
  for number > 0 {
    digit: u8 = #cast(u8) (number % 10)
    digits[count] = '0' + digit
    count += 1
    number /= 10
  }
  if offset > #len(destination) || count > #len(destination) - offset { return #len(destination) + 1 }
  i: usize = 0
  for i < count {
    destination[offset + i] = digits[count - i - 1]
    i += 1
  }
  return offset + count
}

pub fn write_request(destination: []u8, method: []const u8, target: []const u8, host: []const u8, body: []const u8) []u8 {
  offset := append_bytes(destination, 0, method)
  offset = append_bytes(destination, offset, " ")
  offset = append_bytes(destination, offset, target)
  offset = append_bytes(destination, offset, " HTTP/1.1\r\nHost: ")
  offset = append_bytes(destination, offset, host)
  offset = append_bytes(destination, offset, "\r\nConnection: close\r\nContent-Length: ")
  offset = append_usize(destination, offset, #len(body))
  offset = append_bytes(destination, offset, "\r\n\r\n")
  offset = append_bytes(destination, offset, body)
  if offset > #len(destination) { return destination[..0] }
  return destination[..offset]
}

pub fn write_response(destination: []u8, code: u16, reason: []const u8, content_type: []const u8, body: []const u8) []u8 {
  offset := append_bytes(destination, 0, "HTTP/1.1 ")
  offset = append_usize(destination, offset, #cast(usize) code)
  offset = append_bytes(destination, offset, " ")
  offset = append_bytes(destination, offset, reason)
  offset = append_bytes(destination, offset, "\r\nContent-Type: ")
  offset = append_bytes(destination, offset, content_type)
  offset = append_bytes(destination, offset, "\r\nConnection: close\r\nContent-Length: ")
  offset = append_usize(destination, offset, #len(body))
  offset = append_bytes(destination, offset, "\r\n\r\n")
  offset = append_bytes(destination, offset, body)
  if offset > #len(destination) { return destination[..0] }
  return destination[..offset]
}

fn ascii_lower(value: u8) u8 {
  if value >= 'A' && value <= 'Z' { return value + 32 }
  return value
}

fn starts_ascii_case(input: []const u8, at: usize, expected: []const u8) bool {
  if at > #len(input) || #len(expected) > #len(input) - at { return false }
  i: usize = 0
  for i < #len(expected) {
    if ascii_lower(input[at + i]) != ascii_lower(expected[i]) { return false }
    i += 1
  }
  return true
}

struct Decimal { value: usize, ok: bool }

fn parse_decimal(input: []const u8, start: usize, end: usize) Decimal {
  value: usize = 0
  i := start
  if start == end { return Decimal{} }
  for i < end {
    if input[i] < '0' || input[i] > '9' { return Decimal{} }
    digit := #cast(usize) (input[i] - '0')
    if value > (18446744073709551615 - digit) / 10 { return Decimal{} }
    value = value * 10 + digit
    i += 1
  }
  return Decimal{ value: value, ok: true }
}

fn http_parse_head(input: []const u8, response: bool) HttpHead {
  line_end: usize = 0
  for line_end + 1 < #len(input) && !(input[line_end] == '\r' && input[line_end + 1] == '\n') { line_end += 1 }
  if line_end + 1 >= #len(input) { return HttpHead{} }
  code: u16 = 0
  if response {
    if line_end < 12 || !starts_ascii_case(input, 0, "HTTP/1.") { return HttpHead{} }
    space: usize = 0
    for space < line_end && input[space] != ' ' { space += 1 }
    if space + 4 > line_end { return HttpHead{} }
    parsed_code := parse_decimal(input, space + 1, space + 4)
    if !parsed_code.ok || parsed_code.value < 100 || parsed_code.value > 999 { return HttpHead{} }
    code = #cast(u16) parsed_code.value
  } else {
    if line_end < 10 || !starts_ascii_case(input, line_end - 8, "HTTP/1.") { return HttpHead{} }
  }
  cursor := line_end + 2
  content_length: usize = 0
  keep_alive := true
  chunked := false
  has_length := false
  for cursor + 1 < #len(input) {
    if input[cursor] == '\r' && input[cursor + 1] == '\n' {
      return HttpHead{ code: code, header_length: cursor + 2, content_length: content_length, keep_alive: keep_alive, chunked: chunked, ok: true }
    }
    end := cursor
    for end + 1 < #len(input) && !(input[end] == '\r' && input[end + 1] == '\n') { end += 1 }
    if end + 1 >= #len(input) { return HttpHead{} }
    if starts_ascii_case(input, cursor, "Content-Length:") {
      length_start := cursor + 15
      for length_start < end && (input[length_start] == ' ' || input[length_start] == '\t') { length_start += 1 }
      parsed_length := parse_decimal(input, length_start, end)
      if !parsed_length.ok { return HttpHead{} }
      if has_length && content_length != parsed_length.value { return HttpHead{} }
      content_length = parsed_length.value
      has_length = true
    }
    if starts_ascii_case(input, cursor, "Connection:") {
      connection_start := cursor + 11
      for connection_start < end && (input[connection_start] == ' ' || input[connection_start] == '\t') { connection_start += 1 }
      if starts_ascii_case(input, connection_start, "close") { keep_alive = false }
      if starts_ascii_case(input, connection_start, "keep-alive") { keep_alive = true }
    }
    if starts_ascii_case(input, cursor, "Transfer-Encoding:") {
      encoding_start := cursor + 18
      for encoding_start < end && (input[encoding_start] == ' ' || input[encoding_start] == '\t') { encoding_start += 1 }
      if starts_ascii_case(input, encoding_start, "chunked") { chunked = true }
    }
    cursor = end + 2
  }
  return HttpHead{}
}

pub fn parse_response(input: []const u8) HttpHead { return http_parse_head(input, true) }
pub fn parse_request(input: []const u8) HttpHead { return http_parse_head(input, false) }

pub fn header(input: []const u8, name: []const u8) HttpHeader {
  head := http_parse_head(input, false)
  if !head.ok { head = http_parse_head(input, true) }
  if !head.ok { return HttpHeader{} }
  cursor: usize = 0
  for cursor + 1 < head.header_length && !(input[cursor] == '\r' && input[cursor + 1] == '\n') { cursor += 1 }
  cursor += 2
  for cursor + 1 < head.header_length {
    end := cursor
    for end + 1 < head.header_length && !(input[end] == '\r' && input[end + 1] == '\n') { end += 1 }
    colon := cursor
    for colon < end && input[colon] != ':' { colon += 1 }
    if colon - cursor == #len(name) && starts_ascii_case(input, cursor, name) {
      value := colon + 1
      for value < end && (input[value] == ' ' || input[value] == '\t') { value += 1 }
      return HttpHeader{ name: input[cursor..colon], value: input[value..end], ok: true }
    }
    cursor = end + 2
  }
  return HttpHeader{}
}

fn hex(value: u8) i16 {
  if value >= '0' && value <= '9' { return #cast(i16) (value - '0') }
  lower := ascii_lower(value)
  if lower >= 'a' && lower <= 'f' { return #cast(i16) (lower - 'a' + 10) }
  return -1
}

// Decodes a complete chunked body into caller storage. Extensions are skipped.
pub fn decode_chunked(input: []const u8, destination: []u8) HttpIoResult {
  cursor: usize = 0
  output: usize = 0
  for true {
    size: usize = 0
    digits: usize = 0
    for cursor < #len(input) && input[cursor] != '\r' && input[cursor] != ';' {
      value := hex(input[cursor])
      if value < 0 || size > (18446744073709551615 - #cast(usize) value) / 16 { return HttpIoResult{ count: output, error: -22, ok: false } }
      size = size * 16 + #cast(usize) value
      cursor += 1
      digits += 1
    }
    if digits == 0 { return HttpIoResult{ count: output, error: -22, ok: false } }
    for cursor < #len(input) && input[cursor] != '\r' { cursor += 1 }
    if cursor + 1 >= #len(input) || input[cursor + 1] != '\n' { return HttpIoResult{ count: output, error: -22, ok: false } }
    cursor += 2
    if size == 0 { return HttpIoResult{ count: output, error: 0, ok: true } }
    if size > #len(input) - cursor || size > #len(destination) - output { return HttpIoResult{ count: output, error: -28, ok: false } }
    i: usize = 0
    for i < size { destination[output + i] = input[cursor + i]
      i += 1
    }
    cursor += size
    output += size
    if cursor + 1 >= #len(input) || input[cursor] != '\r' || input[cursor + 1] != '\n' { return HttpIoResult{ count: output, error: -22, ok: false } }
    cursor += 2
  }
  return HttpIoResult{}
}

pub fn parse_url(input: []const u8) Url {
  secure := false
  start: usize = 0
  port: u16 = 80
  scheme: []const u8 = "http"
  if starts_ascii_case(input, 0, "http://") { start = 7 }
  else if starts_ascii_case(input, 0, "https://") { start = 8
    port = 443
    secure = true
    scheme = "https"
  }
  else { return Url{} }
  end := start
  for end < #len(input) && input[end] != '/' && input[end] != ':' { end += 1 }
  if end == start { return Url{} }
  host_end := end
  if end < #len(input) && input[end] == ':' {
    port_start := end + 1
    end = port_start
    for end < #len(input) && input[end] != '/' { end += 1 }
    parsed := parse_decimal(input, port_start, end)
    if !parsed.ok || parsed.value == 0 || parsed.value > 65535 { return Url{} }
    port = #cast(u16) parsed.value
  }
  target: []const u8 = "/"
  if end < #len(input) { target = input[end..] }
  return Url{ scheme: scheme, host: input[start..host_end], port: port, target: target, secure: secure, ok: true }
}

pub const StatusOk: u16 = 200
pub const StatusNoContent: u16 = 204
pub const StatusBadRequest: u16 = 400
pub const StatusNotFound: u16 = 404
pub const StatusPayloadTooLarge: u16 = 413
pub const StatusInternalServerError: u16 = 500

pub enum ErrorKind { None, End, Invalid, Capacity, Io }

pub struct Request {
  raw: []const u8,
  method: []const u8,
  target: []const u8,
  body: []const u8,
  header_length: usize,
  keep_alive: bool,
}

pub struct Response {
  output: stream.Writer,
  started: bool,
  finished: bool,
}

pub struct ResponseOptions {
  status: u16,
  reason: []const u8,
  content_type: []const u8,
  close_connection: bool,
}

pub struct Server {
  input: stream.Reader,
  output: stream.Writer,
  storage: []u8,
  used: usize,
  consumed: usize,
}

pub struct ReceiveResult {
  request: Request,
  response: Response,
  error: ErrorKind,
  system_error: isize,
  ok: bool,
}

pub struct Result {
  error: ErrorKind,
  system_error: isize,
  ok: bool,
}

pub struct Body {
  output: stream.Writer,
  finished: bool,
}

pub struct BodyResult {
  body: Body,
  result: Result,
  ok: bool,
}

pub type Handler = *fn(*Response, *const Request) Result

pub struct Route {
  method: []const u8,
  target: []const u8,
  handler: Handler,
}

pub struct Router {
  routes: []Route,
  count: usize,
  fallback: Handler,
}

pub struct ClientResponse {
  raw: []u8,
  body: []u8,
  status: u16,
  error: ErrorKind,
  system_error: isize,
  ok: bool,
}

pub fn client_response_raw(response: *const ClientResponse) []const u8 { return response.raw }
pub fn client_response_body(response: *const ClientResponse) []const u8 { return response.body }
pub fn client_response_status(response: *const ClientResponse) u16 { return response.status }

fn bytes_equal(left: []const u8, right: []const u8) bool {
  if #len(left) != #len(right) { return false }
  i: usize = 0
  for i < #len(left) {
    if left[i] != right[i] { return false }
    i += 1
  }
  return true
}

// Router storage is supplied by the caller. Route strings are borrowed.
pub fn router(storage: []Route, fallback: Handler) Router {
  return Router{ routes: storage, fallback: fallback }
}

pub fn route(state: *Router, method: []const u8, target: []const u8, handler: Handler) bool {
  if state.count == #len(state.routes) || handler == nil { return false }
  state.routes[state.count] = Route{ method: method, target: target, handler: handler }
  state.count += 1
  return true
}

pub fn dispatch(state: *Router, response: *Response, request: *const Request) Result {
  i: usize = 0
  for i < state.count {
    candidate := state.routes[i]
    if bytes_equal(candidate.method, request.method) && bytes_equal(candidate.target, request.target) {
      return candidate.handler(response, request)
    }
    i += 1
  }
  if state.fallback != nil { return state.fallback(response, request) }
  return respond(response, "not found\n", ResponseOptions{ status: StatusNotFound, content_type: "text/plain; charset=utf-8" })
}

pub fn server(input: stream.Reader, output: stream.Writer, storage: []u8) Server {
  return Server{ input: input, output: output, storage: storage }
}

pub fn connection_server(input: stream.Reader, output: stream.Writer, storage: []u8) Server {
  return server(input, output, storage)
}

fn shift_consumed(state: *Server) {
  if state.consumed == 0 { return }
  remaining := state.used - state.consumed
  i: usize = 0
  for i < remaining {
    state.storage[i] = state.storage[state.consumed + i]
    i += 1
  }
  state.used = remaining
  state.consumed = 0
}

fn request_parts(input: []const u8, head: HttpHead) Request {
  line_end: usize = 0
  for line_end + 1 < head.header_length && !(input[line_end] == '\r' && input[line_end + 1] == '\n') {
    line_end += 1
  }
  first_space: usize = 0
  for first_space < line_end && input[first_space] != ' ' { first_space += 1 }
  second_space := first_space + 1
  for second_space < line_end && input[second_space] != ' ' { second_space += 1 }
  if first_space == 0 || second_space <= first_space + 1 || second_space >= line_end { return Request{} }
  total := head.header_length + head.content_length
  return Request{
    raw: input[..total],
    method: input[..first_space],
    target: input[first_space + 1..second_space],
    body: input[head.header_length..total],
    header_length: head.header_length,
    keep_alive: head.keep_alive,
  }
}

// Returned request slices borrow state.storage and remain valid only until the next receive call.
pub fn receive(state: *Server) ReceiveResult {
  shift_consumed(state)
  for true {
    head := parse_request(state.storage[..state.used])
    if head.ok {
      if head.chunked {
        return ReceiveResult{ error: ErrorKind.Invalid, ok: false }
      }
      if head.content_length > #len(state.storage) - head.header_length {
        return ReceiveResult{ error: ErrorKind.Capacity, ok: false }
      }
      total := head.header_length + head.content_length
      if state.used >= total {
        request := request_parts(state.storage[..state.used], head)
        if #len(request.method) == 0 { return ReceiveResult{ error: ErrorKind.Invalid, ok: false } }
        state.consumed = total
        return ReceiveResult{
          request: request,
          response: Response{ output: state.output },
          error: ErrorKind.None,
          system_error: 0,
          ok: true,
        }
      }
    }
    if state.used == #len(state.storage) {
      return ReceiveResult{ error: ErrorKind.Capacity, ok: false }
    }
    input := stream.read(state.input, state.storage[state.used..])
    if input.transferred > #len(state.storage) - state.used {
      return ReceiveResult{ error: ErrorKind.Io, system_error: -5, ok: false }
    }
    state.used += input.transferred
    if input.status == stream.Status.Error {
      return ReceiveResult{ error: ErrorKind.Io, system_error: input.error, ok: false }
    }
    if input.transferred == 0 {
      if state.used == 0 { return ReceiveResult{ error: ErrorKind.End, ok: false } }
      return ReceiveResult{ error: ErrorKind.Invalid, ok: false }
    }
  }
  return ReceiveResult{}
}

fn status_reason(status: u16) []const u8 {
  if status == 200 { return "OK" }
  if status == 204 { return "No Content" }
  if status == 400 { return "Bad Request" }
  if status == 404 { return "Not Found" }
  if status == 413 { return "Payload Too Large" }
  if status == 500 { return "Internal Server Error" }
  return "Status"
}

fn decimal(destination: []u8, value: usize) []const u8 {
  end := #len(destination)
  number := value
  if number == 0 {
    if end == 0 { return destination[..0] }
    destination[end - 1] = '0'
    return destination[end - 1..]
  }
  for number > 0 && end > 0 {
    end -= 1
    destination[end] = #cast(u8) (number % 10) + '0'
    number /= 10
  }
  if number != 0 { return destination[..0] }
  return destination[end..]
}

fn write_output(destination: stream.Writer, bytes: []const u8) Result {
  written := stream.write_all(destination, bytes)
  if written.status == stream.Status.Error {
    return Result{ error: ErrorKind.Io, system_error: written.error, ok: false }
  }
  return Result{ error: ErrorKind.None, ok: true }
}

fn response_begin(response: *Response, options: ResponseOptions, body_length: usize, chunked: bool) Result {
  if response.started || response.finished { return Result{ error: ErrorKind.Invalid, ok: false } }
  status := options.status
  if status == 0 { status = StatusOk }
  reason := options.reason
  if #len(reason) == 0 { reason = status_reason(status) }
  content_type := options.content_type
  if #len(content_type) == 0 { content_type = "application/octet-stream" }
  number_storage: [20]u8 = []
  status_text := decimal(number_storage[..], #cast(usize) status)
  if !write_output(response.output, "HTTP/1.1 ").ok || !write_output(response.output, status_text).ok ||
    !write_output(response.output, " ").ok || !write_output(response.output, reason).ok ||
    !write_output(response.output, "\r\nContent-Type: ").ok || !write_output(response.output, content_type).ok {
    return Result{ error: ErrorKind.Io, system_error: -5, ok: false }
  }
  if chunked {
    if !write_output(response.output, "\r\nTransfer-Encoding: chunked").ok {
      return Result{ error: ErrorKind.Io, system_error: -5, ok: false }
    }
  } else {
    length_text := decimal(number_storage[..], body_length)
    if !write_output(response.output, "\r\nContent-Length: ").ok || !write_output(response.output, length_text).ok {
      return Result{ error: ErrorKind.Io, system_error: -5, ok: false }
    }
  }
  connection := "\r\nConnection: keep-alive\r\n\r\n"
  if options.close_connection { connection = "\r\nConnection: close\r\n\r\n" }
  result := write_output(response.output, connection)
  if result.ok { response.started = true }
  return result
}

pub fn respond(response: *Response, body: []const u8, options: ResponseOptions) Result {
  started := response_begin(response, options, #len(body), false)
  if !started.ok { return started }
  written := write_output(response.output, body)
  if written.ok { response.finished = true }
  return written
}

pub fn respond_stream(response: *Response, options: ResponseOptions) BodyResult {
  started := response_begin(response, options, 0, true)
  if !started.ok { return BodyResult{ result: started, ok: false } }
  response.finished = true
  return BodyResult{
    body: Body{ output: response.output },
    result: Result{ error: ErrorKind.None, ok: true },
    ok: true,
  }
}

fn hex_size(destination: []u8, value: usize) []const u8 {
  digits: []const u8 = "0123456789abcdef"
  end := #len(destination)
  number := value
  if number == 0 {
    destination[end - 1] = '0'
    return destination[end - 1..]
  }
  for number > 0 && end > 0 {
    end -= 1
    destination[end] = digits[number & 15]
    number >>= 4
  }
  if number != 0 { return destination[..0] }
  return destination[end..]
}

fn body_write(data: rawptr, source: []const u8) stream.Result {
  body := #cast(*Body) data
  if body.finished { return stream.Result{ error: -22, status: stream.Status.Error } }
  if #len(source) == 0 { return stream.Result{ status: stream.Status.Complete } }
  size_storage: [16]u8 = []
  size := hex_size(size_storage[..], #len(source))
  first := stream.write_all(body.output, size)
  if first.status == stream.Status.Error { return first }
  separator := stream.write_all(body.output, "\r\n")
  if separator.status == stream.Status.Error { return separator }
  content := stream.write_all(body.output, source)
  if content.status == stream.Status.Error { return content }
  ending := stream.write_all(body.output, "\r\n")
  if ending.status == stream.Status.Error { return ending }
  return stream.Result{ transferred: #len(source), status: stream.Status.Complete }
}

pub fn body_writer(body: *Body) stream.Writer {
  return stream.Writer{ data: #cast(rawptr) body, write: &body_write }
}

pub fn body_finish(body: *Body) Result {
  if body.finished { return Result{ error: ErrorKind.Invalid, ok: false } }
  result := write_output(body.output, "0\r\n\r\n")
  if result.ok { body.finished = true }
  return result
}

pub fn body_abort(body: *Body) Result {
  body.finished = true
  return Result{ error: ErrorKind.None, ok: true }
}

pub fn serve_connection(connection: *network.Connection, storage: []u8, handler: Handler) Result {
  return serve_stream(network.connection_reader(connection), network.connection_writer(connection), storage, handler)
}

// Stream seam shared by plain TCP, TLS, tests, and embedded transports.
pub fn serve_stream(input: stream.Reader, output: stream.Writer, storage: []u8, handler: Handler) Result {
  if handler == nil || #len(storage) == 0 { return Result{ error: ErrorKind.Invalid, ok: false } }
  state := connection_server(input, output, storage)
  for true {
    received := receive(&state)
    if !received.ok {
      if received.error == ErrorKind.End { return Result{ error: ErrorKind.None, ok: true } }
      return Result{ error: received.error, system_error: received.system_error, ok: false }
    }
    handled := handler(&received.response, &received.request)
    if !handled.ok { return handled }
    if !received.request.keep_alive { return Result{ error: ErrorKind.None, ok: true } }
  }
  return Result{ error: ErrorKind.None, ok: true }
}

// Performs one bounded HTTP/1.1 exchange over any stream pair. This is the HTTPS
// integration point: pass a TLS reader and writer. Returned slices borrow response_storage.
pub fn client_do(input: stream.Reader, output: stream.Writer, request_storage: []u8, response_storage: []u8,
  method: []const u8, target: []const u8, host: []const u8, body: []const u8) ClientResponse {
  request_bytes := write_request(request_storage, method, target, host, body)
  if #len(request_bytes) == 0 { return ClientResponse{ error: ErrorKind.Capacity } }
  sent := stream.write_all(output, request_bytes)
  if sent.status == stream.Status.Error { return ClientResponse{ error: ErrorKind.Io, system_error: sent.error } }
  used: usize = 0
  for used < #len(response_storage) {
    read_result := stream.read(input, response_storage[used..])
    if read_result.transferred > #len(response_storage) - used {
      return ClientResponse{ error: ErrorKind.Io, system_error: -5 }
    }
    used += read_result.transferred
    head := parse_response(response_storage[..used])
    if head.ok && !head.chunked && used >= head.header_length + head.content_length {
      total := head.header_length + head.content_length
      return ClientResponse{ raw: response_storage[..total], body: response_storage[head.header_length..total], status: head.code, ok: true }
    }
    if read_result.status == stream.Status.Error { return ClientResponse{ error: ErrorKind.Io, system_error: read_result.error } }
    if read_result.status == stream.Status.End || read_result.transferred == 0 {
      if head.ok && head.chunked {
        decoded := decode_chunked(response_storage[head.header_length..used], response_storage[head.header_length..])
        if decoded.ok {
          chunk_total := head.header_length + decoded.count
          return ClientResponse{ raw: response_storage[..chunk_total], body: response_storage[head.header_length..chunk_total], status: head.code, ok: true }
        }
      }
      return ClientResponse{ error: ErrorKind.Invalid }
    }
  }
  return ClientResponse{ error: ErrorKind.Capacity }
}

pub fn client_do_connection(connection: *network.Connection, request_storage: []u8, response_storage: []u8,
  method: []const u8, target: []const u8, host: []const u8, body: []const u8) ClientResponse {
  return client_do(network.connection_reader(connection), network.connection_writer(connection), request_storage,
    response_storage, method, target, host, body)
}
