// TLS for std/net/http/evented through std/net/tls (OpenSSL 3, Linux).
// Importing this module links libssl and libcrypto; evented itself does not.
//
//   context := tls.server_config_create(arena, &status, "cert.pem", "key.pem")
//   transport := https.transport(context)
//   spawner := posix.spawner()
//   config.transport = &transport
//   config.spawner = &spawner
//
// For HTTP/2 set Config.http2 and call offer_http2(context) before starting:
// browsers then negotiate "h2" through ALPN. For HTTP/3 also set
// Config.http3 and Config.quic to quic(quic_context(...)): QUIC needs its own
// context (OpenSSL's QUIC server method), with the same certificate.
//
// OpenSSL keeps per-thread state, so workers must be libc threads: evented
// refuses this transport without a spawner from std/thread/posix. The context,
// Transport and Spawner must outlive the workers: release the context with
// tls.config_release only after evented.join returns.
#target(kernel: linux)

use "std/fail"
use "std/mem" mem
use "std/net/http/evented" evented
use "std/net/tls" provider
use "vendor/openssl/tls" openssl

pub fn transport(context: provider.Context) evented.Transport {
  return evented.Transport{
    data: context,
    open: open,
    handshake: handshake,
    read: read,
    write: write,
    close: close,
    protocol: protocol,
    needs_native_threads: true,
  }
}

// ALPN preference for HTTP/2 servers: h2, then HTTP/1.1.
alpn_http2: []const u8 = "\x02h2\x08http/1.1"

// Offers HTTP/2 through ALPN on context; with Config.http2 the server then
// speaks HTTP/2 to clients that pick it. Without Config.http2 a client that
// picks h2 gets HTTP/1.1 it cannot read, so set both or neither.
pub fn offer_http2(context: provider.Context) bool {
  return provider.server_alpn(context, &alpn_http2)
}

fn protocol(session: rawptr) []const u8 {
  return provider.selected_alpn(session)
}

fn transport_io(status: *fail.Status, attempt: provider.Attempt) evented.TransportIo {
  if status.failed { return evented.TransportIo{ status: evented.TransportStatus.Failed } }
  if attempt.want == provider.Want.Read { return evented.TransportIo{ status: evented.TransportStatus.WouldRead } }
  if attempt.want == provider.Want.Write { return evented.TransportIo{ status: evented.TransportStatus.WouldWrite } }
  return evented.TransportIo{ count: attempt.count }
}

fn open(data: rawptr, descriptor: isize) rawptr {
  status: fail.Status
  return provider.server_connection_create(&status, data, #cast(i32, descriptor))
}

fn handshake(session: rawptr) evented.TransportIo {
  status: fail.Status
  wanted := provider.server_handshake(&status, session)
  return transport_io(&status, provider.Attempt{ want: wanted })
}

fn read(session: rawptr, destination: []u8) evented.TransportIo {
  status: fail.Status
  result := transport_io(&status, provider.read(&status, session, destination))
  // A successful zero-byte read is the peer's close_notify.
  if result.status == evented.TransportStatus.Ok && result.count == 0 && #len(destination) > 0 {
    return evented.TransportIo{ status: evented.TransportStatus.End }
  }
  return result
}

fn write(session: rawptr, source: []const u8) evented.TransportIo {
  status: fail.Status
  return transport_io(&status, provider.write(&status, session, source))
}

// Sends close_notify when the socket allows it without waiting, then frees
// the session.
fn close(session: rawptr) {
  connection := session
  status: fail.Status
  _ = provider.shutdown(&status, connection)
  provider.connection_release(&connection)
}

// ---------------------------------------------------------------- HTTP/3

alpn_h3: []const u8 = "\x02h3"

// A QUIC server context offering "h3" through ALPN, from PEM files. Release
// it with tls.config_release after evented.join returns.
pub fn quic_context(arena: *mem.Arena, status: *fail.Status, certificate: []const u8, key: []const u8) provider.Context {
  if status.failed { return nil }
  created := openssl.quic_server_context_create(arena, certificate, key)
  if created.value == nil || !openssl.set_server_alpn(created.value, &alpn_h3) {
    fail.set(status, fail.make(fail.Kind.System, "create QUIC server", certificate, "OpenSSL could not create the context"))
    return nil
  }
  return created.value
}

// The QUIC stack for Config.quic. context must outlive the workers.
pub fn quic(context: provider.Context) evented.Quic {
  return evented.Quic{
    data: context,
    listen: quic_listen,
    handle_events: openssl.quic_handle_events,
    accept_connection: openssl.quic_accept_connection,
    accept_stream: quic_accept_stream,
    open_stream: openssl.quic_open_stream,
    read: quic_read,
    write: quic_write,
    writable: openssl.quic_writable,
    reset: openssl.quic_reset_stream,
    closed: openssl.quic_closed,
    free: openssl.quic_free,
    close: openssl.quic_close,
    peer: openssl.quic_peer,
    close_listener: openssl.quic_free,
  }
}

fn quic_listen(data: rawptr, descriptor: isize) rawptr {
  return openssl.quic_listen(data, #cast(i32, descriptor))
}

fn quic_accept_stream(connection: rawptr) evented.QuicStream {
  accepted := openssl.quic_accept_stream(connection)
  return evented.QuicStream{ handle: accepted.handle, id: accepted.id, unidirectional: accepted.unidirectional }
}

fn quic_status(status: openssl.QuicStatus) evented.QuicStatus {
  case status {
    openssl.QuicStatus.Ok => { return evented.QuicStatus.Ok }
    openssl.QuicStatus.WouldBlock => { return evented.QuicStatus.WouldBlock }
    openssl.QuicStatus.End => { return evented.QuicStatus.End }
    openssl.QuicStatus.Reset => { return evented.QuicStatus.Reset }
    openssl.QuicStatus.Failed => { return evented.QuicStatus.Failed }
  }
}

fn quic_read(stream: rawptr, destination: []u8) evented.QuicIo {
  read := openssl.quic_read(stream, destination)
  return evented.QuicIo{ count: read.count, status: quic_status(read.status) }
}

fn quic_write(stream: rawptr, source: []const u8, conclude: bool) evented.QuicIo {
  written := openssl.quic_write(stream, source, conclude)
  return evented.QuicIo{ count: written.count, status: quic_status(written.status) }
}
