// Event-driven HTTP/1.1 server. Each worker thread runs one readiness loop
// (std/event: epoll or kqueue) over many nonblocking keep-alive connections, so
// idle or slow clients never hold a thread. Handlers use the ordinary
// http.Handler signature and run on the worker thread that owns the connection.
//
// All memory is caller-supplied and fixed at start: per connection one receive
// buffer and one send buffer, with an optional bounded per-worker overflow
// pool shared by active responses. Nothing allocates per request.
//
// Beyond request and response:
// - run hands slow work (password hashing, a slow query) to a thread pool. The
//   connection waits; the worker keeps serving the others. The response is
//   written by a finish function back on the worker thread.
// - open_stream starts a chunked response that stays open (Server-Sent Events,
//   long polling). upgrade switches a request to a WebSocket. Both return a
//   Peer. send, publish and close_peer reach peers from any thread through the
//   worker's inbox; Config.on_message receives WebSocket messages.
// - When every slot is busy, a new connection first evicts the longest idle
//   keep-alive connection, then (Overflow.Reject) gets 503 and is closed.
//
// Costs to know:
// - A handler that blocks stalls every connection on its worker. Use run.
// - A response larger than its send buffer leases an overflow block when
//   available. When the pool is exhausted or the block is too small, it is
//   flushed synchronously: the
//   worker waits (up to write_timeout_milliseconds) for the socket to drain.
// - A request larger than the receive buffer borrows an upload block; one
//   larger than that goes to the handler set with Config.large_body =
//   large_bodies(handler), which reads it in pieces with receive_body, or
//   gets 413. A program that never calls large_bodies links no code for it.
//
// Config.http2 = http2() adds HTTP/2 (see h2.dyn) for clients that ask for
// it, and Config.http3 = http3() adds HTTP/3 over QUIC (h3.dyn) on the same
// port, over UDP. A program that sets neither links no code for them.
//
// Config.transport replaces plain TCP reads and writes, for TLS. This module
// has no TLS dependency; std/net/http/evented/tls supplies an OpenSSL one.
#target(pointer_bits: 64)

use bytes "std/bytes"
use gzip "std/compress/gzip"
use event "std/event"
use format "std/fmt"
use "std/fail"
use io "std/io"
use log "std/log"
use mem "std/mem"
use network "std/net"
use http "std/net/http"
use websocket "std/net/websocket"
use signal "std/process/signal"
use sync "std/sync"
use threading "std/thread"
use tasks "std/thread/pool"
use clock "std/time"

pub struct Config {
  // Connections each worker can hold open at once. Further accepts wait in
  // the listen backlog.
  connections_per_worker: usize,
  receive_size: usize,
  send_size: usize,
  // Optional fixed overflow blocks shared by this worker's connections. Both
  // zero disables pooling. Blocks must exceed send_size. A drained or closed
  // connection returns its block; an exhausted pool uses synchronous flushing.
  overflow_send_size: usize,
  overflow_send_count: usize,
  // Optional per-worker pool of large receive blocks for request bodies
  // bigger than receive_size, up to upload_size bytes with the head. A
  // request borrows one block until it is handled; with none free it gets
  // 503. Both zero disables: larger requests get 413. Blocks must exceed
  // receive_size.
  upload_size: usize,
  upload_count: usize,
  // Closes connections with no complete request activity for this long. Zero disables.
  idle_timeout_milliseconds: i64,
  // Longest a worker waits on one client during a synchronous large flush.
  write_timeout_milliseconds: i32,
  stack_size: usize,
  // nil for plain TCP. Must stay alive and unchanged until join returns.
  transport: *const Transport,
  // nil starts std/thread threads. Workers that call C libraries need
  // threads with libc state: pass std/thread/posix spawner(). Must stay alive
  // until join returns.
  spawner: *const threading.Spawner,
  // What a new connection gets when every slot of its worker is busy and no
  // idle keep-alive connection can be evicted.
  overflow: Overflow,
  // A new client may close a keep-alive connection idle at least this long
  // when every slot is busy. Negative never evicts.
  evict_idle_milliseconds: i64,
  // Thread pool for run. nil: run fails with Unsupported. Work that calls C
  // libraries needs a pool started on threads with libc state. Must stay alive
  // until join returns.
  pool: *tasks.Pool,
  // Bytes of job storage per connection for run (see job).
  job_size: usize,
  // Per worker inbox for send, publish and close_peer: messages and payload
  // bytes accepted between two loop passes. A full inbox fails the post.
  inbox_messages: usize,
  inbox_bytes: usize,
  // WebSocket messages, on the worker thread. nil ignores them. The payload is
  // valid only during the call.
  on_message: fn(*const Message),
  // Message.context for on_message. Workers share it: synchronize what it
  // points to.
  message_context: rawptr,
  // Requests whose body is larger than any buffer here (upload_size, else
  // receive_size), set with large_bodies(handler): the handler is called
  // with the head only, and answers, or reads the body in pieces with
  // receive_body. Left zero, they get 413 and no streaming code is linked.
  large_body: LargeBodies,
  // Requests too large for the server that large_body does not take,
  // called with what was read of the request (the head when it fit). It
  // answers like any handler; the connection closes after. nil, or no
  // answer, sends 413.
  on_too_large: http.Handler,
  // Clients turned away for lack of room (Overflow.Reject, or no upload slot),
  // called with an empty request before anything is read. It answers like any
  // handler; the connection closes after. nil, or no answer, sends 503 with
  // Retry-After.
  on_busy: http.Handler,
  // HTTP/2: prior-knowledge cleartext clients, and TLS clients whose ALPN
  // chose "h2" (Transport.protocol). Needs receive_size of at least 17 KiB.
  // http2_connections state blocks (about 21 KiB each) bound the HTTP/2
  // connections per worker; http2_slots request slots (receive_size plus
  // job_size each) bound the streams in progress per worker.
  // Set with http2(); left zero, no HTTP/2 code is linked.
  http2: Http2,
  http2_connections: usize,
  http2_slots: usize,
  // HTTP/3 on a UDP socket at the TCP listener's address, through quic
  // (std/net/http/evented/tls supplies OpenSSL's). Needs http2: QUIC
  // connections take its state blocks and request slots. TCP responses then
  // carry Alt-Svc. quic must stay alive until join returns.
  // Set with http3(); left zero, no HTTP/3 code is linked.
  http3: Http3,
  quic: *const Quic,
  // Bytes of each worker's request arena (see arena): scratch a handler
  // allocates from and never frees, reset before the next handler runs.
  request_arena_size: usize,
  // When set, one line per answered request: client, method, path, status
  // and microseconds in the handler (and its finish, for run and later).
  access_log: *log.Logger,
  // When nonzero, a warning line for every handler that runs at least this
  // many microseconds, a sign of blocking work on the event loop (move it to
  // run). It goes to access_log, or to standard error without one.
  slow_handler_microseconds: u64,
  // gzip level (1-9) for respond_compressed; each worker keeps one encoder
  // workspace (about 300 KiB). Zero sends bodies uncompressed.
  compress_level: u8,
}

// Wait holds the client in a reserve slot until a regular one frees, then in
// the kernel backlog once reserve slots run out. Reject answers 503 with
// Retry-After from a reserve slot, so the client can read it.
pub enum Overflow { Wait, Reject }

// A stream or WebSocket connection, valid from any thread. A peer that has
// closed makes send and close_peer no-ops; its slot's next connection has a
// different generation.
pub struct Peer { worker: u32, index: u32, generation: u32,
  // An HTTP/2 stream on that connection; 0 for HTTP/1.1.
  stream: u32,
}

pub enum MessageKind { Text, Binary, Closed }

// A WebSocket message from peer. Closed arrives once when the connection ends.
pub struct Message { peer: Peer, kind: MessageKind, payload: []const u8, context: rawptr }


enum Mode { Http, Deferred, Stream, WebSocket, Body, Http2 }

// How a body read with receive_body ended, for its finish function.
// Stopped: chunk returned false. Invalid: malformed chunked framing. Closed:
// the client went away; the response then sends nothing. After anything but
// Complete the connection closes once finish has answered.
pub enum BodyEnd { Complete, Stopped, Invalid, Closed }

// Bodies too large for any buffer, for Config.large_body: the handler and
// the server code that streams to it. A program that never calls
// large_bodies reaches none of that code, so none of it is linked.
pub struct LargeBodies {
  handler: http.Handler,
  begin: fn(*Worker, usize, http.FrameResult) bool,
  feed: fn(*Worker, usize) bool,
  end: fn(*Worker, usize, BodyEnd) bool,
}

// Streams bodies too large for any buffer to handler, which answers from
// the head or reads the body with receive_body.
pub fn large_bodies(handler: http.Handler) LargeBodies {
  return LargeBodies{ handler: handler, begin: body_begin, feed: body_feed, end: body_end }
}

enum PostKind { Send, Publish, Close }
struct Post { kind: PostKind, binary: bool, index: u32, generation: u32, stream: u32, topic: u64, offset: usize, length: usize }

// Double-buffered inbox: other threads append to the pending half under lock;
// the worker swaps halves and reads the other one without the lock.
struct Inbox {
  lock: sync.Mutex,
  posts: [2][]Post,
  post_count: [2]usize,
  bytes: [2][]u8,
  byte_count: [2]usize,
  // Finished jobs: connection indices. Never full, one job per connection.
  done: [2][]usize,
  done_count: [2]usize,
  pending: usize,
}

pub enum TransportStatus { Ok, WouldRead, WouldWrite, End, Failed }
pub struct TransportIo { count: usize, status: TransportStatus }

// A byte-stream layer over each accepted nonblocking socket, such as TLS.
// open returns a session handle or nil; the worker calls handshake until Ok,
// then read and write. WouldRead and WouldWrite mean retry after that
// readiness, with the same arguments. close releases the session; the worker
// closes the socket itself. All functions run on the worker that owns the
// connection.
pub struct Transport {
  data: rawptr,
  open: fn(rawptr, isize) rawptr,
  handshake: fn(rawptr) TransportIo,
  read: fn(rawptr, []u8) TransportIo,
  write: fn(rawptr, []const u8) TransportIo,
  close: fn(rawptr),
  // The application protocol the handshake agreed on (TLS ALPN), such as
  // "h2"; nil when the transport has none.
  protocol: fn(rawptr) []const u8,
  // The transport calls C code that keeps per-thread state; start then
  // requires Config.spawner.
  needs_native_threads: bool,
}

pub fn default_config() Config {
  return Config{
    connections_per_worker: 1024,
    receive_size: 16 * mem.KiB,
    send_size: 16 * mem.KiB,
    idle_timeout_milliseconds: 30000,
    write_timeout_milliseconds: 5000,
    stack_size: 512 * mem.KiB,
    overflow: Overflow.Wait,
    evict_idle_milliseconds: 1000,
    job_size: 1 * mem.KiB,
    http2_connections: 256,
    http2_slots: 64,
    request_arena_size: 1 * mem.MiB,
    inbox_messages: 1024,
    inbox_bytes: 256 * mem.KiB,
  }
}

// Bytes of backing storage start needs for this many workers.
pub fn storage_size(config: Config, worker_count: usize) usize {
  return worker_count * worker_storage(config)
}

// One worker's block: start carves it from the arena in one piece, so the OS
// can be told up front that it is touched sparsely (see mem.advise_sparse).
fn worker_storage(config: Config) usize {
  slots := slot_count(config)
  per_connection := #sizeof(Connection) + config.receive_size + config.send_size
  // Per slot: its free-list and later-list entries.
  per_worker := slots * (per_connection + 2 * #sizeof(usize)) + config.stack_size + scratch_size(config) + 4096
  per_worker += config.overflow_send_count * (config.overflow_send_size + #sizeof(usize))
  per_worker += config.upload_count * (config.upload_size + #sizeof(usize))
  per_worker += slots * (config.job_size + mem.ArenaBufferOverhead + 2 * #sizeof(usize))
  per_worker += 2 * (config.inbox_messages * #sizeof(Post) + config.inbox_bytes) + 64
  if config.compress_level > 0 {
    per_worker += #sizeof(gzip.Encoder) + #alignof(gzip.Encoder)
  }
  if has_http2(config) {
    per_worker += config.http2.storage_size(config)
  }
  if has_http3(config) {
    per_worker += config.http3.storage_size(config)
  }
  per_worker += config.request_arena_size + mem.ArenaBufferOverhead + 8 * mem.KiB
  // The event queue (entry, free list, hash table per slot), thread records,
  // alignment padding.
  per_worker += (slots + 2) * 64 + 64 * mem.KiB
  return per_worker
}

// Reserve slots hold parked clients or answer 503: a reply drains like any
// rejected request, so the client reads it instead of a reset.
fn slot_count(config: Config) usize {
  return config.connections_per_worker + config.connections_per_worker / 16 + 2
}

fn scratch_size(config: Config) usize {
  // event.wait pushes the native array and the result array each call.
  return (slot_count(config) + 2) * 64 + 4 * mem.ArenaBufferOverhead + 4096
}


struct SendPool {
  backing: []u8,
  free: []usize,
  free_count: usize,
  block_size: usize,
}

struct Connection {
  descriptor: isize,
  active: bool,
  input: []u8,
  // input is base_input, or an upload block (input_slot is its one-based
  // index) while a large request is read and handled.
  base_input: []u8,
  input_slot: usize,
  uploads: *SendPool,
  // 100 Continue already sent for the request being read.
  continue_sent: bool,
  used: usize,
  output: []u8,
  base_output: []u8,
  pool: *SendPool,
  // One-based pool index; zero means output is base_output.
  overflow_slot: usize,
  // A transport retry must see the same source backing and length: bytes
  // queued after a would-block wait behind retry_end.
  write_pending: bool,
  retry_end: usize,
  body_reserved: bool,
  sent: usize,
  queued: usize,
  // Stop reading and parsing until queued output drains.
  writing: bool,
  close_after: bool,
  // Rejected: write side shut, unread input discarded until the peer closes,
  // so the kernel sends FIN, not RST, and the client sees the error reply.
  draining: bool,
  rejected: bool,
  failed: bool,
  last_active: i64,
  write_timeout: i32,
  transport: *const Transport,
  session: rawptr,
  handshaking: bool,
  // The last flush stopped for readable, not writable (TLS renegotiation).
  flush_wants_read: bool,
  // Events registered with the queue.
  interest: u32,
  worker: *Worker,
  index: usize,
  // Changes each time the slot closes, so stale Peers miss.
  generation: u32,
  mode: Mode,
  topic: u64,
  // run: the job, its functions and the request it answers. The request
  // borrows input, which stays put until finish runs.
  jobs: *mem.Arena,
  job_data: rawptr,
  job_work: fn(rawptr),
  job_finish: fn(*http.Response, *const http.Request, rawptr) !io.IoErr,
  job_request: http.Request,
  job_consumed: usize,
  job_running: bool,
  // Closed while its job ran: the slot is freed when the job reports back.
  zombie: bool,
  // The client's address, from accept.
  remote: network.Address,
  // A reserve slot answering 503, or holding a client until a regular slot
  // frees (Overflow.Wait); neither counts in Worker.serving.
  refusal: bool,
  parked: bool,
  // WebSocket: message assembly state; assembled bytes lead input.
  frames: websocket.WebSocketMessageState,
  // Set by upgrade: reads the WebSocket frames in input. A program that never
  // upgrades never reaches the frame code, so it is not linked.
  on_frames: fn(*Worker, usize) bool,
  close_sent: bool,
  // A large body: the request head stays at input[..body_head] while body
  // bytes pass through behind it. body_left counts Content-Length bytes.
  body_head: usize,
  body_left: usize,
  body_chunked: bool,
  body_reader: http.ChunkReader,
  body_expect: bool,
  body_started: bool,
  body_data: rawptr,
  body_chunk: fn(rawptr, []const u8) bool,
  body_finish: fn(*http.Response, *const http.Request, rawptr, BodyEnd) !io.IoErr,
  // HTTP/2 state, while mode is Http2.
  h2: *H2,
  // No request read yet: the HTTP/2 preface may still come.
  fresh: bool,
}

pub struct Worker {
  thread: *threading.Thread,
  // Handle from Config.spawner, instead of thread.
  native: rawptr,
  listener: *network.Listener,
  // Set by start_shared: this worker's own SO_REUSEPORT listener.
  own_listener: network.Listener,
  handler: http.Handler,
  context: rawptr,
  config: Config,
  connections: []Connection,
  free: []usize,
  free_count: usize,
  // Connections whose requests finish after this pass's events (later).
  later: []usize,
  later_count: usize,
  later_done: usize,
  // One past the highest slot ever taken. Free slots are reused last in,
  // first out, so scans over connections stop here, not at the capacity.
  slots_used: usize,
  send_pool: SendPool,
  upload_pool: SendPool,
  queue: event.Queue,
  // False while every slot is busy: the level-triggered listener would
  // otherwise wake the loop continuously.
  listening: bool,
  scratch: *mem.Arena,
  // Set by run and later on first use, and by open_stream: the loop reaches
  // job and stream code only through these, so a server that never defers or
  // streams does not link it.
  on_deferred: fn(*Worker, usize) bool,
  on_job_done: fn(*Worker, usize),
  on_later: fn(*Worker),
  on_deliver: fn(*Worker, usize, Post, []const u8),
  // Where response heads are composed: 8 KiB, reused by every response this
  // worker writes, so none zeroes a buffer of its own.
  head_staging: []u8,
  // Every slot's input and output buffers, receive_size and send_size each.
  slot_input: []u8,
  slot_output: []u8,
  // Job storage, job_stride bytes per slot. A slot's job arena is made on
  // its first job, so idle slots leave their pages untouched.
  job_bytes: []u8,
  job_stride: usize,
  // Why the loop stopped, reported by join.
  stop_failed: bool,
  stop_error: io.IoErr,
  // Set by invoke when the handler call just made failed; handled clears it.
  request_failed: bool,
  request_error: io.IoErr,
  stopping: sync.AtomicU32,
  // Counters are written by the worker only; read them after join.
  accepted: u64,
  requests: u64,
  rejected: u64,
  // Connections closed to make room, and connections refused with 503.
  evicted: u64,
  refused: u64,
  id: u32,
  waker: event.Waker,
  inbox: Inbox,
  // Jobs submitted and not yet finished; only the worker changes it.
  jobs_running: usize,
  // Connections in regular slots, at most connections_per_worker, and
  // clients parked in reserve slots.
  serving: usize,
  parked: usize,
  // All workers started together, and whether this one has no regular slot
  // free: on a shared listener, a full worker leaves accepting to the others.
  group: []Worker,
  full: sync.AtomicU32,
  // Current IMF-fixdate for Date headers, refreshed once per loop pass.
  date: [http.DateLength]u8,
  date_second: i64,
  // Workspace for respond_compressed; nil when Config.compress_level is zero.
  encoder: *gzip.Encoder,
  // The request arena; nil when Config.request_arena_size is zero.
  request_arena: *mem.Arena,
  h2: H2Pool,
  // HTTP/3: the UDP socket, QUIC listener, milliseconds to its next timer,
  // the QUIC connections' slots, and the Alt-Svc value for TCP responses.
  udp: isize,
  quic_listener: rawptr,
  quic_timer: i64,
  h3_connections: []usize,
  h3_count: usize,
  alt_svc: [48]u8,
  alt_svc_length: usize,
}

const ListenerToken: u64 = 0
const WakerToken: u64 = 0xffffffffffffffff

// A clock reading for the access log and the slow-handler warning, or 0
// when neither is on.
fn log_start(worker: *const Worker) i64 {
  if worker.config.access_log == nil && worker.config.slow_handler_microseconds == 0 { return 0 }
  now := clock.monotonic_now()
  return now.seconds * 1000000 + now.nanoseconds / 1000
}

fn log_request(worker: *const Worker, remote: *const network.Address, request: *const http.Request,
  response: *const http.Response, started: i64) {
  if started == 0 { return }
  elapsed := log_start(worker) - started
  if worker.config.slow_handler_microseconds > 0 && elapsed >= #cast(i64, worker.config.slow_handler_microseconds) {
    log_slow(worker, request, elapsed)
  }
  if worker.config.access_log == nil || response.status == 0 { return }
  address: [64]u8
  status: [8]u8
  micros: [24]u8
  // These fit their storage, so this status never fails.
  rendering: fail.Status
  status_text := format.buffer(&rendering, status[..])
  format.write_u64(&status_text, response.status)
  micros_text := format.buffer(&rendering, micros[..])
  format.write_i64(&micros_text, elapsed)
  fields: [5]log.Field = [
    log.Field{ name: "client", value: network.ip_text(address[..], network.address_ip(remote)) },
    log.Field{ name: "method", value: request.method },
    log.Field{ name: "path", value: request.path },
    log.Field{ name: "status", value: format.bytes(&status_text) },
    log.Field{ name: "us", value: format.bytes(&micros_text) },
  ]
  // A failed log write does not fail the request.
  logged: fail.Status
  log.write(&logged, worker.config.access_log, log.Level.Info, "request", fields[..])
}

fn log_slow(worker: *const Worker, request: *const http.Request, elapsed: i64) {
  micros: [24]u8
  rendering: fail.Status
  micros_text := format.buffer(&rendering, micros[..])
  format.write_i64(&micros_text, elapsed)
  fields: [3]log.Field = [
    log.Field{ name: "method", value: request.method },
    log.Field{ name: "path", value: request.path },
    log.Field{ name: "us", value: format.bytes(&micros_text) },
  ]
  standard := log.logger(io.stderr(), log.Level.Warning)
  destination := worker.config.access_log
  if destination == nil { destination = &standard }
  logged: fail.Status
  log.write(&logged, destination, log.Level.Warning, "slow handler", fields[..])
}

fn now_milliseconds() i64 {
  now := clock.monotonic_now()
  return now.seconds * 1000 + now.nanoseconds / clock.Millisecond
}

// Runs handler, remembering a failure for handled.
fn invoke(worker: *Worker, handler: http.Handler, response: *http.Response, request: *const http.Request) {
  handler(response, request) catch err {
    worker.request_failed = true
    worker.request_error = err
  }
}

// Whether the handler call just made failed (see invoke); clears it for the
// next call. A failed handler is logged to Config.access_log, and when it
// had not responded and still can (answerable: the request was not handed to
// a job, a body reader or a WebSocket), the server answers 500 for it. The
// failure closes the connection after the response.
fn handled(worker: *Worker, request: *const http.Request, response: *http.Response, answerable: bool) bool {
  if !worker.request_failed { return false }
  err := worker.request_error
  worker.request_failed = false
  log_failure(worker, request, err)
  if answerable && !response.started {
    response.closing = true
    http.respond(response, "internal server error\n", http.ResponseOptions{ status: http.StatusInternalServerError,
      content_type: "text/plain; charset=utf-8" }) catch {}
  }
  return true
}

fn log_failure(worker: *const Worker, request: *const http.Request, err: io.IoErr) {
  if worker.config.access_log == nil { return }
  fields: [3]log.Field = [
    log.Field{ name: "method", value: request.method },
    log.Field{ name: "path", value: request.path },
    log.Field{ name: "error", value: io.text(err) },
  ]
  // A failed log write does not fail the request.
  logged: fail.Status
  log.write(&logged, worker.config.access_log, log.Level.Error, "handler failed", fields[..])
}

fn connection_read(connection: *Connection, destination: []u8) TransportIo {
  if connection.transport != nil {
    return connection.transport.read(connection.session, destination)
  }
  worker := connection.worker
  received := network.try_receive(connection.descriptor, destination, 0) catch { return TransportIo{ status: TransportStatus.Failed } }
  if received.blocked { return TransportIo{ status: TransportStatus.WouldRead } }
  if received.count == 0 { return TransportIo{ status: TransportStatus.End } }
  return TransportIo{ count: received.count }
}

fn connection_write(connection: *Connection, source: []const u8) TransportIo {
  if connection.transport != nil { return connection.transport.write(connection.session, source) }
  worker := connection.worker
  sent := network.try_send(connection.descriptor, source, 0) catch { return TransportIo{ status: TransportStatus.Failed } }
  if sent.blocked { return TransportIo{ status: TransportStatus.WouldWrite } }
  return TransportIo{ count: sent.count }
}

// Zero events takes the descriptor out of the queue, as while a job runs.
fn set_interest(worker: *Worker, index: usize, events: u32) bool {
  connection := &worker.connections[index]
  if connection.interest == events { return true }
  previous := connection.interest
  connection.interest = events
  if events == 0 {
    event.remove(&worker.queue, connection.descriptor) catch { return false }
  } else if previous == 0 {
    event.add(&worker.queue, connection.descriptor, events, #cast(u64, index) + 1) catch { return false }
  } else {
    event.modify(&worker.queue, connection.descriptor, events, #cast(u64, index) + 1) catch { return false }
  }
  return true
}

// Returns an overflow block only after its queued bytes drain or the socket closes.
fn release_output(connection: *Connection) {
  if connection.overflow_slot == 0 { return }
  pool := connection.pool
  pool.free[pool.free_count] = connection.overflow_slot - 1
  pool.free_count += 1
  connection.overflow_slot = 0
  connection.output = connection.base_output
}

// Called only before transport IO or after a successful flush, never while a
// TLS write retry borrows the current output slice.
fn grow_output(connection: *Connection) bool {
  pool := connection.pool
  if pool == nil || connection.overflow_slot != 0 || pool.free_count == 0 || connection.write_pending {
    return false
  }
  pool.free_count -= 1
  slot := pool.free[pool.free_count]
  backing := pool.backing[slot * pool.block_size..(slot + 1) * pool.block_size]
  _ = mem.copy(backing[..connection.queued], connection.output[..connection.queued])
  connection.output = backing
  connection.overflow_slot = slot + 1
  return true
}

// Sends queued output without blocking. False means the socket must close.
fn flush(connection: *Connection) bool {
  connection.flush_wants_read = false
  for connection.sent < connection.queued {
    end := connection.queued
    if connection.write_pending {
      end = connection.retry_end
    }
    sent := connection_write(connection, connection.output[connection.sent..end])
    if sent.status == TransportStatus.WouldWrite {
      connection.write_pending = true
      connection.retry_end = end
      return true
    }
    if sent.status == TransportStatus.WouldRead {
      connection.write_pending = true
      connection.retry_end = end
      connection.flush_wants_read = true
      return true
    }
    if sent.status != TransportStatus.Ok { return false }
    connection.write_pending = false
    connection.sent += sent.count
  }
  connection.sent = 0
  connection.queued = 0
  connection.body_reserved = false
  release_output(connection)
  return true
}

// Drains queued output, waiting for the socket while the peer is slow. Used
// only when one response outgrows the send buffer.
fn flush_blocking(connection: *Connection) bool {
  for connection.queued > 0 {
    if !flush(connection) { return false }
    if connection.queued == 0 { return true }
    wanted := network.PollWritable
    if connection.flush_wants_read {
      wanted = network.PollReadable
    }
    ready := network.wait(connection.descriptor, wanted, connection.write_timeout) catch { return false }
    if ready == 0 { return false }
  }
  return true
}

// Queues source for the connection; the count queued. A failure, a full
// output that cannot be flushed, fails with WouldBlock and marks the
// connection failed; a failed connection fails with InvalidInput.
fn output_write(data: rawptr, source: []const u8) usize!io.IoErr {
  connection := #cast(*Connection, data)
  if connection.failed { fail .InvalidInput }
  connection.body_reserved = false
  written: usize = 0
  for written < source.len {
    room := connection.output.len - connection.queued
    if source.len - written > room && grow_output(connection) {
      room = connection.output.len - connection.queued
    }
    if room == 0 {
      if !flush_blocking(connection) {
        connection.failed = true
        fail .WouldBlock
      }
      room = connection.output.len
    }
    count := source.len - written
    if count > room {
      count = room
    }
    _ = mem.copy(connection.output[connection.queued..connection.queued + count], source[written..written + count])
    connection.queued += count
    written += count
  }
  return written
}

// A reserved body is borrowed only during the current handler. The prefix
// leaves room for a checked header, so commit queues both without moving body.
fn reserve_body(data: rawptr, capacity: usize) []u8 {
  connection := #cast(*Connection, data)
  if connection.failed || connection.body_reserved || connection.queued != 0 || connection.sent != 0 ||
    capacity > 0xffffffffffffffff - 8192 {
    return connection.output[..0]
  }
  required := capacity + 8192
  if required > connection.output.len {
    _ = grow_output(connection)
  }
  if required > connection.output.len { return connection.output[..0] }
  connection.body_reserved = true
  return connection.output[8192..required]
}

// No reserved body storage fails with InvalidInput.
fn commit_body(data: rawptr, head: []const u8, length: usize) usize!io.IoErr {
  connection := #cast(*Connection, data)
  if !connection.body_reserved || head.len > 8192 || length > connection.output.len - 8192 { fail .InvalidInput }
  connection.sent = 8192 - head.len
  connection.queued = 8192 + length
  _ = mem.copy(connection.output[connection.sent..8192], head)
  connection.body_reserved = false
  return head.len + length
}

fn new_response(connection: *Connection) http.Response {
  // Every handler call starts with an empty request arena.
  if connection.worker.request_arena != nil {
    mem.arena_reset(connection.worker.request_arena)
  }
  return http.Response{ output: io.Writer{ data: connection, write: output_write },
    reserve_body: reserve_body, commit_body: commit_body, date: connection.worker.date[..], alt_svc: alt_svc(connection.worker),
    staging: connection.worker.head_staging }
}

// Answers status and closes the connection: through Config.on_too_large
// (413) or on_busy (503) when set, else with body as text.
fn reject(connection: *Connection, status: u16, body: []const u8, input: []const u8) {
  worker := connection.worker
  response := http.Response{ output: io.Writer{ data: connection, write: output_write }, date: worker.date[..], closing: true }
  connection.close_after = true
  connection.rejected = true
  handler: http.Handler = nil
  if status == http.StatusPayloadTooLarge {
    handler = worker.config.on_too_large
  } else if status == http.StatusServiceUnavailable {
    handler = worker.config.on_busy
  }
  if handler != nil {
    // What was read of the request: its head when the head fit.
    request := http.Request{}
    head := http.frame_request_head(input, input.len + 1)
    if head.status == http.FrameStatus.Ready {
      request = head.request
    }
    request.context = worker.context
    handler(&response, &request) catch err { log_failure(worker, &request, err) }
    if response.started { return }
  }
  retry: [1]http.Header = [http.Header{ name: "Retry-After", value: "1" }]
  options := http.ResponseOptions{ status: status, content_type: "text/plain; charset=utf-8", close_connection: true }
  if status == http.StatusServiceUnavailable {
    options.headers = retry[..]
  }
  // Best effort: the connection closes either way.
  http.respond(&response, body, options) catch {}
}

fn close_connection(worker: *Worker, index: usize) {
  connection := &worker.connections[index]
  if !connection.active { return }
  if connection.interest != 0 {
    event.remove(&worker.queue, connection.descriptor) catch {}
  }
  if connection.session != nil {
    connection.transport.close(connection.session)
  }
  if connection.descriptor >= 0 {
    network.close(connection.descriptor)
  }
  release_output(connection)
  connection.failed = true
  if connection.h2 != nil && connection.h2.quic {
    worker.config.http3.close(worker, connection)
  }
  if connection.mode == Mode.Body && connection.body_started {
    // The finish function still owns its data: let it clean up.
    _ = worker.config.large_body.end(worker, index, BodyEnd.Closed)
  }
  if connection.mode == Mode.WebSocket && worker.config.on_message != nil {
    message := Message{ peer: peer_of(worker, index), kind: MessageKind.Closed, context: worker.config.message_context }
    worker.config.on_message(&message)
  }
  if connection.h2 != nil {
    worker.config.http2.close_all(worker, connection)
  }
  if connection.job_running || (connection.h2 != nil && connection.h2.jobs > 0) {
    // The pool still uses this slot's job storage; free it when the job ends.
    connection.active = false
    connection.zombie = true
    return
  }
  recycle(worker, index)
}

fn recycle(worker: *Worker, index: usize) {
  connection := &worker.connections[index]
  if has_http2(worker.config) {
    worker.config.http2.release(worker, connection)
  }
  connection.used = 0
  release_input(connection)
  input := connection.base_input
  uploads := connection.uploads
  output := connection.base_output
  pool := connection.pool
  jobs := connection.jobs
  generation := connection.generation + 1
  if generation == 0 {
    generation = 1
  }
  regular := !connection.refusal && !connection.parked
  if connection.parked {
    worker.parked -= 1
  }
  if regular {
    worker.serving -= 1
  }
  connection.* = Connection{ input: input, base_input: input, uploads: uploads, output: output, base_output: output, pool: pool,
    worker: worker, index: index, generation: generation, jobs: jobs }
  worker.free[worker.free_count] = index
  worker.free_count += 1
  if regular && sync.load_u32(&worker.stopping) == 0 {
    promote(worker)
  }
  if worker.serving < worker.config.connections_per_worker {
    sync.store_u32(&worker.full, 0)
  }
  if !worker.listening && sync.load_u32(&worker.stopping) == 0 {
    worker.listening = true
    event.add(&worker.queue, worker.listener.descriptor, event.Readable, ListenerToken) catch { worker.listening = false }
  }
}

// Runs every complete buffered request, then flushes. Returns false when the
// connection must close now.
fn serve_buffered(worker: *Worker, index: usize) bool {
  connection := &worker.connections[index]
  if connection.mode == Mode.Deferred { return worker.on_deferred(worker, index) }
  if connection.mode == Mode.Body { return worker.config.large_body.feed(worker, index) }
  if connection.mode == Mode.Http2 { return worker.config.http2.serve(worker, index) }
  if connection.fresh && connection.mode == Mode.Http && has_http2(worker.config) {
    // Prior knowledge (RFC 9113 3.3): the client starts with the preface.
    if preface_prefix(connection.input[..connection.used]) {
      if connection.used < Preface.len { return true }
      connection.fresh = false
      _ = worker.config.http2.begin(worker, index)
      return worker.config.http2.serve(worker, index)
    }
    connection.fresh = false
  }
  if connection.mode == Mode.Stream {
    // A stream's client has nothing more to say; discard what it sends.
    connection.used = 0
  }
  consumed: usize = 0
  capacity := connection.base_input.len
  if connection.uploads != nil && connection.uploads.block_size > capacity {
    capacity = connection.uploads.block_size
  }
  wanted: usize = 0
  for connection.mode == Mode.Http && !connection.writing && !connection.close_after && !connection.failed {
    framed := http.frame_request_decoding(connection.input[consumed..connection.used], capacity)
    if framed.status == http.FrameStatus.Incomplete {
      wanted = framed.total
      if framed.expect_continue && !connection.continue_sent && framed.total > 0 {
        connection.continue_sent = true
        if !push_bytes(connection, "HTTP/1.1 100 Continue\r\n\r\n") { return false }
      }
      break
    }
    if framed.status == http.FrameStatus.Invalid {
      worker.rejected += 1
      reject(connection, http.StatusBadRequest, "bad request\n", "")
      break
    }
    if framed.status == http.FrameStatus.Capacity {
      if worker.config.large_body.begin != nil {
        head := http.frame_request_head(connection.input[consumed..connection.used], capacity)
        if head.status == http.FrameStatus.Ready {
          shift_input(connection, consumed)
          return worker.config.large_body.begin(worker, index, head)
        }
      }
      worker.rejected += 1
      reject(connection, http.StatusPayloadTooLarge, "request too large\n", connection.input[consumed..connection.used])
      break
    }
    connection.continue_sent = false
    request := framed.request
    request.context = worker.context
    response := new_response(connection)
    response.head_only = bytes.equal(request.method, "HEAD")
    worker.requests += 1
    started := log_start(worker)
    invoke(worker, worker.handler, &response, &request)
    handler_failed := handled(worker, &request, &response, connection.mode == Mode.Http)
    log_request(worker, &connection.remote, &request, &response, started)
    consumed += framed.consumed
    if connection.mode == Mode.Deferred {
      // run took the request: it stays in input until finish answers it.
      connection.job_request = request
      connection.job_consumed = consumed
      return worker.on_deferred(worker, index)
    }
    if connection.mode == Mode.Stream || connection.mode == Mode.WebSocket { break }
    if handler_failed || !response.finished {
      // A handler that failed or never finished leaves the stream unframed.
      connection.close_after = true
    }
    if !request.keep_alive {
      connection.close_after = true
    }
  }
  shift_input(connection, consumed)
  // A request larger than the receive buffer moves to an upload block.
  if connection.mode == Mode.Http && !connection.close_after && wanted > connection.input.len &&
    !grow_input(connection, wanted) {
    if wanted <= capacity {
      worker.rejected += 1
      reject(connection, http.StatusServiceUnavailable, "upload slots busy\n", connection.input[..connection.used])
    } else {
      // No block could ever hold it (a chunked body with no upload pool).
      if worker.config.large_body.begin != nil {
        head := http.frame_request_head(connection.input[..connection.used], capacity)
        if head.status == http.FrameStatus.Ready { return worker.config.large_body.begin(worker, index, head) }
      }
      worker.rejected += 1
      reject(connection, http.StatusPayloadTooLarge, "request too large\n", connection.input[..connection.used])
    }
  }
  if connection.mode == Mode.WebSocket && !connection.writing && !connection.close_after {
    if !connection.on_frames(worker, index) { return false }
  }
  if connection.failed || !flush(connection) { return false }
  if connection.queued > 0 {
    connection.writing = true
    return set_interest(worker, index, write_interest(connection))
  }
  if connection.close_after {
    finish(worker, index)
  }
  return true
}

fn shift_input(connection: *Connection, consumed: usize) {
  if consumed == 0 { return }
  remaining := connection.used - consumed
  for i in 0..remaining {
    connection.input[i] = connection.input[consumed + i]
  }
  connection.used = remaining
  release_input(connection)
}

// Moves input into an upload block big enough for a request of total bytes.
fn grow_input(connection: *Connection, total: usize) bool {
  pool := connection.uploads
  if connection.input_slot != 0 || pool == nil || pool.free_count == 0 || total > pool.block_size {
    return false
  }
  pool.free_count -= 1
  slot := pool.free[pool.free_count]
  block := pool.backing[slot * pool.block_size..(slot + 1) * pool.block_size]
  _ = mem.copy(block[..connection.used], connection.input[..connection.used])
  connection.input = block
  connection.input_slot = slot + 1
  return true
}

// Back to the base buffer once what is left fits it. Never while a job's
// request still borrows the block.
fn release_input(connection: *Connection) {
  if connection.input_slot == 0 || connection.job_running || connection.used > connection.base_input.len {
    return
  }
  _ = mem.copy(connection.base_input[..connection.used], connection.input[..connection.used])
  pool := connection.uploads
  pool.free[pool.free_count] = connection.input_slot - 1
  pool.free_count += 1
  connection.input_slot = 0
  connection.input = connection.base_input
}

// After run: send what earlier pipelined requests queued, then read nothing
// until the job finishes. Hangups still arrive.
fn flush_and_wait(worker: *Worker, index: usize) bool {
  connection := &worker.connections[index]
  if connection.failed || !flush(connection) { return false }
  if connection.queued > 0 {
    connection.writing = true
    return set_interest(worker, index, write_interest(connection))
  }
  return set_interest(worker, index, 0)
}

fn write_interest(connection: *const Connection) u32 {
  if connection.flush_wants_read { return event.Readable }
  return event.Writable
}

// Output is fully sent and the connection is done. Rejected plain TCP
// connections drain first; TLS ones close at once, since a raw half-close
// would cut the TLS io.
fn finish(worker: *Worker, index: usize) {
  connection := &worker.connections[index]
  if !connection.rejected || connection.draining || connection.transport != nil {
    close_connection(worker, index)
    return
  }
  connection.draining = true
  connection.used = 0
  network.shutdown(connection.descriptor, network.ShutdownWrite) catch { close_connection(worker, index) }
}

fn drain(worker: *Worker, index: usize) {
  connection := &worker.connections[index]
  received := network.try_receive(connection.descriptor, connection.input, 0) catch {
    close_connection(worker, index)
    return
  }
  if !received.blocked && received.count == 0 {
    close_connection(worker, index)
  }
}

fn on_readable(worker: *Worker, index: usize) {
  connection := &worker.connections[index]
  if connection.draining {
    drain(worker, index)
    return
  }
  // TLS may hold decrypted bytes the socket no longer signals, so a transport
  // reads until it would block. Plain TCP reads again only after a full read.
  for rounds in 0..16 {
    if connection.used == connection.input.len {
      // Buffer full and nothing framed: serve_buffered already answered 413.
      close_connection(worker, index)
      return
    }
    room := connection.input.len - connection.used
    received := connection_read(connection, connection.input[connection.used..])
    if received.status == TransportStatus.WouldRead {
      if !set_interest(worker, index, event.Readable) {
        close_connection(worker, index)
      }
      return
    }
    if received.status == TransportStatus.WouldWrite {
      if !set_interest(worker, index, event.Writable) {
        close_connection(worker, index)
      }
      return
    }
    if received.status != TransportStatus.Ok || received.count == 0 {
      close_connection(worker, index)
      return
    }
    connection.used += received.count
    connection.last_active = now_milliseconds()
    if !serve_buffered(worker, index) {
      close_connection(worker, index)
      return
    }
    if !connection.active || connection.writing || connection.draining || connection.mode == Mode.Deferred {
      return
    }
    if connection.transport == nil && received.count < room { return }
  }
}

fn on_writable(worker: *Worker, index: usize) {
  connection := &worker.connections[index]
  if !flush(connection) {
    close_connection(worker, index)
    return
  }
  if connection.queued > 0 {
    if !set_interest(worker, index, write_interest(connection)) {
      close_connection(worker, index)
    }
    return
  }
  connection.last_active = now_milliseconds()
  connection.writing = false
  if !set_interest(worker, index, event.Readable) {
    close_connection(worker, index)
    return
  }
  if connection.close_after {
    finish(worker, index)
    return
  }
  // Pipelined requests may already be buffered.
  if !serve_buffered(worker, index) {
    close_connection(worker, index)
  }
}

fn on_handshake(worker: *Worker, index: usize) {
  connection := &worker.connections[index]
  step := connection.transport.handshake(connection.session)
  if step.status == TransportStatus.WouldRead {
    if !set_interest(worker, index, event.Readable) {
      close_connection(worker, index)
    }
    return
  }
  if step.status == TransportStatus.WouldWrite {
    if !set_interest(worker, index, event.Writable) {
      close_connection(worker, index)
    }
    return
  }
  if step.status != TransportStatus.Ok {
    close_connection(worker, index)
    return
  }
  connection.handshaking = false
  connection.last_active = now_milliseconds()
  if has_http2(worker.config) && connection.transport.protocol != nil &&
    bytes.equal(connection.transport.protocol(connection.session), "h2") {
    connection.fresh = false
    _ = worker.config.http2.begin(worker, index)
  }
  // The client's first request may arrive with its last handshake message.
  on_readable(worker, index)
}

// Closes the longest idle keep-alive connection, idle at least
// Config.evict_idle_milliseconds: between requests, nothing buffered or
// queued, plain HTTP. Closing an idle connection is allowed (RFC 9112 9.5);
// clients retry. The threshold keeps a client that sends requests back to back
// from losing its connection between two of them.
fn evict_idle(worker: *Worker, now: i64) bool {
  limit := worker.config.evict_idle_milliseconds
  if limit < 0 { return false }
  oldest: usize = worker.connections.len
  for i in 0..worker.slots_used {
    connection := &worker.connections[i]
    if !connection.active || connection.parked || connection.refusal || connection.mode != Mode.Http ||
      connection.writing || connection.used != 0 || connection.queued != 0 || connection.handshaking ||
      connection.draining || connection.close_after || now - connection.last_active < limit {
      continue
    }
    if oldest == worker.connections.len || connection.last_active < worker.connections[oldest].last_active {
      oldest = i
    }
  }
  if oldest == worker.connections.len { return false }
  close_connection(worker, oldest)
  worker.evicted += 1
  return true
}

fn stop_listening(worker: *Worker) {
  if !worker.listening { return }
  event.remove(&worker.queue, worker.listener.descriptor) catch { return }
  worker.listening = false
}

// Another worker on this listener still has a regular slot free.
fn other_has_room(worker: *const Worker) bool {
  if worker.own_listener.active { return false }
  for *other in worker.group {
    if other != worker && sync.load_u32(&other.full) == 0 { return true }
  }
  return false
}

// Starts serving a placed connection: reads, or a TLS handshake first.
fn begin(worker: *Worker, index: usize) {
  connection := &worker.connections[index]
  connection.last_active = now_milliseconds()
  connection.fresh = true
  if !set_interest(worker, index, event.Readable) {
    close_connection(worker, index)
    return
  }
  transport := worker.config.transport
  if transport != nil {
    connection.transport = transport
    connection.session = transport.open(transport.data, connection.descriptor)
    if connection.session == nil {
      close_connection(worker, index)
      return
    }
    connection.handshaking = true
    on_handshake(worker, index)
  }
}

// A regular slot is free: the longest parked client takes it.
fn promote(worker: *Worker) {
  if worker.parked == 0 || worker.serving >= worker.config.connections_per_worker { return }
  first: usize = worker.connections.len
  for i in 0..worker.slots_used {
    connection := &worker.connections[i]
    if connection.active && connection.parked &&
      (first == worker.connections.len || connection.last_active < worker.connections[first].last_active) {
      first = i
    }
  }
  if first == worker.connections.len { return }
  worker.connections[first].parked = false
  worker.parked -= 1
  worker.serving += 1
  begin(worker, first)
}

fn on_accept(worker: *Worker) {
  for true {
    // Full: another worker on this listener takes new clients; with no
    // reserve slot left they wait in the kernel backlog.
    crowded := worker.serving >= worker.config.connections_per_worker
    if crowded && (other_has_room(worker) || worker.free_count == 0) {
      sync.store_u32(&worker.full, 1)
      stop_listening(worker)
      return
    }
    remote := network.Address{}
    // Blocked: another worker won the race. Failures (EMFILE, ECONNABORTED)
    // are per-connection; keep serving.
    accepted := network.try_accept_address(worker.listener.descriptor, &remote, true) catch { return }
    if accepted.blocked { return }
    descriptor := accepted.descriptor
    network.no_delay(descriptor, true) catch {}
    worker.accepted += 1
    // Only now, with a client waiting, make room for it.
    regular := worker.serving < worker.config.connections_per_worker || evict_idle(worker, now_milliseconds())
    if !regular {
      sync.store_u32(&worker.full, 1)
    }
    refusal := !regular && worker.config.overflow == Overflow.Reject
    if refusal && worker.config.transport != nil {
      // A TLS client cannot read a reply before its handshake: just close.
      network.close(descriptor)
      worker.refused += 1
      continue
    }
    index := take_connection(worker)
    connection := &worker.connections[index]
    connection.descriptor = descriptor
    connection.active = true
    connection.remote = remote
    connection.last_active = now_milliseconds()
    connection.write_timeout = worker.config.write_timeout_milliseconds
    connection.interest = 0
    if regular {
      worker.serving += 1
      begin(worker, index)
      continue
    }
    if !refusal {
      // Overflow.Wait: hold the client, unread, until a slot frees.
      connection.parked = true
      worker.parked += 1
      continue
    }
    connection.refusal = true
    worker.refused += 1
    if !set_interest(worker, index, event.Readable) {
      close_connection(worker, index)
      continue
    }
    reject(connection, http.StatusServiceUnavailable, "server busy\n", "")
    settle(worker, index)
  }
}

fn sweep_idle(worker: *Worker, now: i64) {
  limit := worker.config.idle_timeout_milliseconds
  for i in 0..worker.slots_used {
    connection := &worker.connections[i]
    // Streams and WebSockets stay open until a side closes them; parked
    // clients wait for a slot.
    // QUIC keeps its own idle timeout.
    quiet_h2 := connection.mode == Mode.Http2 && (connection.h2 == nil ||
        (!connection.h2.quic && connection.h2.stream_count == 0 && connection.h2.jobs == 0))
    if connection.active && (connection.mode == Mode.Http || connection.mode == Mode.Body || quiet_h2) && !connection.parked &&
      now - connection.last_active > limit {
      close_connection(worker, i)
    }
  }
}

fn refresh_date(worker: *Worker) {
  now := clock.realtime_now()
  if now.seconds == worker.date_second { return }
  worker.date_second = now.seconds
  _ = http.format_date(worker.date[..], now.seconds)
}

fn worker_main(worker: *Worker) isize {
  last_sweep := now_milliseconds()
  refresh_date(worker)
  for sync.load_u32(&worker.stopping) == 0 {
    mark := mem.arena_mark(worker.scratch)
    timeout: i32 = 100
    if worker.quic_listener != nil && worker.quic_timer >= 0 && worker.quic_timer < 100 {
      // QUIC timers (acknowledgements, loss recovery) run in this loop.
      timeout = #cast(i32, worker.quic_timer)
    }
    waited := event.wait(worker.scratch, &worker.queue, timeout) catch err {
      worker.stop_failed = true
      worker.stop_error = err
      break
    }
    refresh_date(worker)
    for item in waited {
      if item.token == ListenerToken {
        on_accept(worker)
        continue
      }
      if item.token == WakerToken {
        event.waker_drain(&worker.waker)
        read_inbox(worker)
        continue
      }
      if item.token == QuicToken { continue }
      index := #cast(usize, item.token - 1)
      if !worker.connections[index].active { continue }
      if (item.events & (event.Error | event.Hangup)) != 0 && (item.events & event.Readable) == 0 {
        close_connection(worker, index)
      } else if worker.connections[index].handshaking {
        on_handshake(worker, index)
      } else if worker.connections[index].writing {
        on_writable(worker, index)
      } else {
        on_readable(worker, index)
      }
    }
    mem.arena_rewind(worker.scratch, mark)
    if worker.on_later != nil {
      worker.on_later(worker)
    }
    // Datagrams, timers, and whatever handlers and pushes wrote to QUIC.
    if has_http3(worker.config) {
      worker.config.http3.poll(worker)
    }
    // Parked clients take slots from connections that have since gone idle.
    if worker.parked > 0 {
      now := now_milliseconds()
      for worker.parked > 0 && evict_idle(worker, now) {
      }
    }
    if worker.config.idle_timeout_milliseconds > 0 {
      now := now_milliseconds()
      if now - last_sweep >= 1000 {
        sweep_idle(worker, now)
        last_sweep = now
      }
    }
  }
  if worker.on_later != nil {
    worker.on_later(worker)
  }
  // Slots past slots_used were never taken.
  for i in 0..worker.slots_used {
    close_connection(worker, i)
  }
  // Running jobs own their slots' storage: wait for every one to report back.
  for worker.jobs_running > 0 {
    mark := mem.arena_mark(worker.scratch)
    wait_quietly(worker)
    mem.arena_rewind(worker.scratch, mark)
    event.waker_drain(&worker.waker)
    read_inbox(worker)
  }
  if worker.listening {
    event.remove(&worker.queue, worker.listener.descriptor) catch {}
  }
  if has_http3(worker.config) {
    worker.config.http3.stop(worker)
  }
  event.remove(&worker.queue, worker.waker.descriptor) catch {}
  event.close(&worker.queue)
  event.waker_close(&worker.waker)
  return 0
}

// An invalid Config, or a worker still running, fails with InvalidInput.
// One wait while jobs finish; failures are ignored, the loop retries.
fn wait_quietly(worker: *Worker) {
  _ = event.wait(worker.scratch, &worker.queue, 100) catch { return }
}

fn valid_start(workers: []Worker, config: Config, handler: http.Handler) !io.IoErr {
  if workers.len == 0 || handler == nil || config.connections_per_worker == 0 ||
    config.receive_size < 512 || config.send_size < 512 || config.stack_size < 64 * mem.KiB ||
    (config.overflow_send_count == 0) != (config.overflow_send_size == 0) ||
    (config.overflow_send_count > 0 && config.overflow_send_size <= config.send_size) ||
    (config.upload_count == 0) != (config.upload_size == 0) || (config.upload_count > 0 && config.upload_size <= config.receive_size) ||
    config.compress_level > 9 || (has_http2(config) && !config.http2.valid(config)) ||
    (has_http3(config) && !config.http3.valid(config)) ||
    (config.transport != nil && config.transport.needs_native_threads && config.spawner == nil) ||
    workers.len > 0xffffffff || config.connections_per_worker > 0xffffffff { fail .InvalidInput }
  for *worker in workers {
    if worker.thread != nil || worker.native != nil { fail .InvalidInput }
  }
}

// Takes a free slot, setting it up the first time: its buffers and links.
// Slots taken before keep them through recycle.
fn take_connection(worker: *Worker) usize {
  worker.free_count -= 1
  index := worker.free[worker.free_count]
  if index >= worker.slots_used {
    worker.slots_used = index + 1
  }
  connection := &worker.connections[index]
  if connection.worker == nil {
    config := worker.config
    connection.input = worker.slot_input[index * config.receive_size..(index + 1) * config.receive_size]
    connection.base_input = connection.input
    if config.upload_count > 0 {
      connection.uploads = &worker.upload_pool
    }
    connection.output = worker.slot_output[index * config.send_size..(index + 1) * config.send_size]
    connection.base_output = connection.output
    connection.pool = &worker.send_pool
    connection.worker = worker
    connection.index = index
    connection.generation = 1
  }
  return index
}

// Allocates the worker's connections and queue, then spawns its thread.
// worker.listener and worker.own_listener are set by the caller.
fn start_worker(outer: *mem.Arena, worker: *Worker) !io.IoErr {
  config := worker.config
  count := slot_count(config)
  // Most of a worker's storage is per-slot buffers of which few are busy.
  // Advise before anything touches it: with transparent huge pages, a first
  // touch would otherwise make a whole 2 MiB page resident.
  // push_array on fresh pages leaves them untouched, and the worker's own
  // pushes then skip zeroing them, so only slots in use cost memory.
  backing := mem.push_array<u8>(outer, worker_storage(config))
  mem.advise_sparse(backing)
  arena := mem.arena_from_zeroed(backing)
  worker.connections = mem.push_array<Connection>(arena, count)
  worker.free = mem.push_array<usize>(arena, count)
  worker.later = mem.push_array<usize>(arena, count)
  worker.slot_input = mem.push_bytes(arena, count * config.receive_size)
  worker.slot_output = mem.push_bytes(arena, count * config.send_size)
  worker.send_pool.backing = mem.push_bytes(arena, config.overflow_send_count * config.overflow_send_size)
  worker.send_pool.free = mem.push_array<usize>(arena, config.overflow_send_count)
  worker.send_pool.free_count = config.overflow_send_count
  worker.send_pool.block_size = config.overflow_send_size
  for i in 0..config.overflow_send_count {
    worker.send_pool.free[i] = config.overflow_send_count - 1 - i
  }
  worker.upload_pool.backing = mem.push_bytes(arena, config.upload_count * config.upload_size)
  worker.upload_pool.free = mem.push_array<usize>(arena, config.upload_count)
  worker.upload_pool.free_count = config.upload_count
  worker.upload_pool.block_size = config.upload_size
  for i in 0..config.upload_count {
    worker.upload_pool.free[i] = config.upload_count - 1 - i
  }
  if config.job_size > 0 {
    worker.job_stride = config.job_size + mem.ArenaBufferOverhead
    worker.job_bytes = mem.push_bytes(arena, count * worker.job_stride)
  }
  // Slots are set up when first taken (take_connection).
  for c in 0..count {
    worker.free[c] = count - 1 - c
  }
  worker.free_count = count
  for half in 0..2 {
    worker.inbox.posts[half] = mem.push_array<Post>(arena, config.inbox_messages)
    worker.inbox.bytes[half] = mem.push_bytes(arena, config.inbox_bytes)
    worker.inbox.done[half] = mem.push_array<usize>(arena, count)
  }
  worker.scratch = mem.arena_from_buffer(mem.push_bytes(arena, scratch_size(config)))
  worker.head_staging = mem.push_bytes(arena, 8 * mem.KiB)
  if config.compress_level > 0 {
    worker.encoder = mem.push<gzip.Encoder>(arena)
  }
  if has_http2(config) {
    config.http2.start(arena, worker)
  }
  if config.request_arena_size > 0 {
    worker.request_arena = mem.arena_from_buffer(mem.push_bytes(arena, config.request_arena_size + mem.ArenaBufferOverhead))
  }
  try network.nonblocking(worker.listener.descriptor, true)
  worker.queue = try event.open(arena, count + 2)
  errdefer event.close(&worker.queue)
  worker.listening = true
  try event.add(&worker.queue, worker.listener.descriptor, event.Readable, ListenerToken)
  worker.waker = try event.waker_open()
  errdefer event.waker_close(&worker.waker)
  try event.add(&worker.queue, worker.waker.descriptor, event.Readable, WakerToken)
  if has_http3(config) {
    try config.http3.start(arena, worker)
  }
  if config.spawner != nil {
    worker.native = config.spawner.spawn(config.spawner.data, arena, config.stack_size, #cast(fn(rawptr) isize, worker_main), worker)
    // The spawner could not start a worker.
    if worker.native == nil { fail io.IoErr.System(0) }
  } else {
    stack := mem.push_bytes(arena, config.stack_size)
    spawning: fail.Status
    worker.thread = threading.spawn(arena, &spawning, stack, worker_main, worker)
    try io.check_status(&spawning)
  }
}

// After a failed start: stops the workers already running.
fn abandon(workers: []Worker, started: usize) usize {
  stop(workers[..started])
  join(workers[..started]) catch {}
  for *worker in workers[started..] {
    if worker.own_listener.active {
      network.listener_close(&worker.own_listener)
    }
  }
  return started
}

// Starts one event loop per worker, all accepting from listener (made
// nonblocking here). arena must hold storage_size(config, #len(workers)) and
// stay alive, unrewound, until join returns. Workers must be zeroed or joined.
// Every Request carries context; workers share it, so synchronize mutable state.
// After a failure the workers that started before it are stopped again. A
// listener that is not open fails with InvalidInput.
pub fn start(arena: *mem.Arena, workers: []Worker, listener: *network.Listener, config: Config,
  handler: http.Handler, context: rawptr) !io.IoErr {
  try valid_start(workers, config, handler)
  if listener == nil || !listener.active { fail .InvalidInput }
  for i in 0..workers.len {
    workers[i] = Worker{ listener: listener, handler: handler, context: context, config: config, id: #cast(u32, i), group: workers }
  }
  for i in 0..workers.len {
    start_worker(arena, &workers[i]) catch err {
      _ = abandon(workers, i)
      fail err
    }
  }
}

// Like start, but every worker owns a listener on address with SO_REUSEPORT,
// so the kernel spreads new connections across workers instead of waking all
// of them. Port 0 picks one free port shared by all; read it back with
// local_port. join closes the listeners. Linux only: elsewhere it fails with
// Unsupported; use start there, or serve, which does.
pub fn start_shared(arena: *mem.Arena, workers: []Worker, address: network.Ipv4Address, backlog: usize,
  config: Config, handler: http.Handler, context: rawptr) !io.IoErr {
  try valid_start(workers, config, handler)
  for i in 0..workers.len {
    workers[i] = Worker{ handler: handler, context: context, config: config, id: #cast(u32, i), group: workers }
  }
  for i in 0..workers.len {
    worker := &workers[i]
    worker.own_listener = network.tcp_listen_ipv4_shared(&address, backlog) catch err {
      _ = abandon(workers, i)
      fail err
    }
    worker.listener = &worker.own_listener
    if i == 0 {
      // Pin a kernel-chosen port so later listeners join the same group.
      bound := network.Address{}
      named := true
      network.local_address(worker.own_listener.descriptor, &bound) catch { named = false }
      if named {
        address.bytes[2] = bound.bytes[2]
        address.bytes[3] = bound.bytes[3]
      }
    }
  }
  for i in 0..workers.len {
    start_worker(arena, &workers[i]) catch err {
      _ = abandon(workers, i)
      fail err
    }
  }
}

// Local port of the first worker's listener, or 0.
pub fn local_port(workers: []Worker) u16 {
  if workers.len == 0 || workers[0].listener == nil { return 0 }
  bound := network.Address{}
  network.local_address(workers[0].listener.descriptor, &bound) catch { return 0 }
  return #cast(u16, bound.bytes[2]) * 256 + #cast(u16, bound.bytes[3])
}

// Asks every worker to finish its current loop pass (at most about 100 ms).
// Call stop, then join, then close the listener.
pub fn stop(workers: []Worker) {
  for *worker in workers {
    sync.store_u32(&worker.stopping, 1)
  }
}

// Always joins every worker. Each worker closes its connections and queue.
// The first failure, from joining or from a worker's loop, is the result;
// every worker is joined either way.
pub fn join(workers: []Worker) !io.IoErr {
  failed := false
  first := io.IoErr.System(0)
  for *worker in workers {
    if worker.thread == nil && worker.native == nil { continue }
    if worker.native != nil {
      if !worker.config.spawner.join(worker.config.spawner.data, worker.native) {
        // The spawner could not join a worker.
        if !failed {
          failed = true
          first = io.IoErr.System(0)
        }
        continue
      }
      worker.native = nil
    } else {
      joined: fail.Status
      threading.join(&joined, worker.thread)
      if joined.failed {
        if !failed {
          failed = true
          first = io.err_of(joined.failure)
        }
        continue
      }
    }
    worker.thread = nil
    if worker.own_listener.active {
      network.listener_close(&worker.own_listener)
    }
    if worker.stop_failed && !failed {
      failed = true
      first = worker.stop_error
    }
  }
  if failed { fail first }
}

// ---------------------------------------------------------------- peers

fn peer_of(worker: *const Worker, index: usize) Peer {
  return Peer{ worker: worker.id, index: #cast(u32, index), generation: worker.connections[index].generation }
}

// The connection behind an evented response, or nil for any other response.
fn connection_of(response: *http.Response) *Connection {
  if response.output.write != output_write && response.output.write != h2_write_stream { return nil }
  return #cast(*Connection, response.output.data)
}

fn live_peer(workers: []Worker, peer: Peer) bool {
  return peer.generation != 0 && #cast(usize, peer.worker) < workers.len &&
    #cast(usize, peer.index) < workers[peer.worker].connections.len
}

// Appends to the pending half. Fails with Capacity when it is full.
fn post(worker: *Worker, item: Post, payload: []const u8) !io.IoErr {
  inbox := &worker.inbox
  sync.lock(&inbox.lock)
  half := inbox.pending
  if inbox.post_count[half] == inbox.posts[half].len || payload.len > inbox.bytes[half].len - inbox.byte_count[half] {
    sync.unlock(&inbox.lock)
    fail .Capacity
  }
  entry := item
  entry.offset = inbox.byte_count[half]
  entry.length = payload.len
  _ = mem.copy(inbox.bytes[half][entry.offset..entry.offset + entry.length], payload)
  inbox.byte_count[half] += payload.len
  inbox.posts[half][inbox.post_count[half]] = entry
  inbox.post_count[half] += 1
  sync.unlock(&inbox.lock)
  event.wake(&worker.waker)
}

// Queues payload for peer from any thread: a WebSocket text frame (binary
// frame when binary), or a chunk of an open stream. Delivery is in order per
// worker. A closed peer drops it. Fails with Capacity when the inbox is full,
// InvalidInput for a malformed peer.
pub fn send(workers: []Worker, peer: Peer, payload: []const u8, binary: bool) !io.IoErr {
  // Not a peer of these workers.
  if !live_peer(workers, peer) { fail .InvalidInput }
  try post(&workers[peer.worker], Post{ kind: PostKind.Send, binary: binary, index: peer.index, generation: peer.generation,
    stream: peer.stream }, payload)
}

// Queues payload for every stream and WebSocket opened with topic, on every
// worker. Stops at the first worker whose inbox is full.
pub fn publish(workers: []Worker, topic: u64, payload: []const u8, binary: bool) !io.IoErr {
  for *worker in workers {
    try post(worker, Post{ kind: PostKind.Publish, binary: binary, topic: topic }, payload)
  }
}

// Ends a stream (final chunk) or WebSocket (close frame 1000), then closes it.
pub fn close_peer(workers: []Worker, peer: Peer) !io.IoErr {
  if !live_peer(workers, peer) { fail .InvalidInput }
  try post(&workers[peer.worker], Post{ kind: PostKind.Close, index: peer.index, generation: peer.generation,
    stream: peer.stream }, "")
}

// Queues bytes without ever blocking: a peer too slow to take them closes.
fn push_bytes(connection: *Connection, source: []const u8) bool {
  if connection.failed || connection.close_after { return false }
  if source.len > connection.output.len - connection.queued {
    _ = grow_output(connection)
  }
  if source.len > connection.output.len - connection.queued { return false }
  _ = mem.copy(connection.output[connection.queued..connection.queued + source.len], source)
  connection.queued += source.len
  return true
}

fn frame_head(destination: []u8, opcode: u8, length: usize) []u8 {
  destination[0] = 0x80 | opcode
  if length < 126 {
    destination[1] = #cast(u8, length)
    return destination[..2]
  }
  if length <= 0xffff {
    destination[1] = 126
    destination[2] = #cast(u8, length >> 8)
    destination[3] = #cast(u8, length)
    return destination[..4]
  }
  destination[1] = 127
  for i in 0..8 {
    destination[2 + i] = #cast(u8, length >> #cast(usize, 56 - 8 * i))
  }
  return destination[..10]
}

fn push_frame(connection: *Connection, opcode: u8, payload: []const u8) bool {
  head_storage: [10]u8
  head := frame_head(head_storage[..], opcode, payload.len)
  if head.len + payload.len > connection.output.len - connection.queued {
    _ = grow_output(connection)
  }
  return push_bytes(connection, head) && push_bytes(connection, payload)
}

fn push_chunk(connection: *Connection, payload: []const u8) bool {
  if payload.len == 0 { return true }
  size_storage: [24]u8
  digits := "0123456789abcdef"
  at := size_storage.len - 2
  size_storage[at] = '\r'
  size_storage[at + 1] = '\n'
  number := payload.len
  for number > 0 {
    at -= 1
    size_storage[at] = digits[number & 15]
    number >>= 4
  }
  if payload.len + 24 > connection.output.len - connection.queued {
    _ = grow_output(connection)
  }
  return push_bytes(connection, size_storage[at..]) && push_bytes(connection, payload) && push_bytes(connection, "\r\n")
}

fn deliver(worker: *Worker, index: usize, item: Post, payload: []const u8) {
  connection := &worker.connections[index]
  ok := true
  if item.kind == PostKind.Close {
    if connection.mode == Mode.WebSocket {
      ok = !connection.close_sent && push_frame(connection, 8, "\x03\xe8")
      connection.close_sent = true
    } else {
      ok = push_bytes(connection, "0\r\n\r\n")
    }
    connection.close_after = true
  } else if connection.mode == Mode.WebSocket {
    opcode: u8 = 1
    if item.binary {
      opcode = 2
    }
    ok = !connection.close_sent && push_frame(connection, opcode, payload)
  } else {
    ok = push_chunk(connection, payload)
  }
  if !ok {
    close_connection(worker, index)
  }
}

fn settle(worker: *Worker, index: usize) {
  connection := &worker.connections[index]
  if !connection.active { return }
  if !flush(connection) {
    close_connection(worker, index)
    return
  }
  if connection.queued > 0 {
    connection.writing = true
    if !set_interest(worker, index, write_interest(connection)) {
      close_connection(worker, index)
    }
    return
  }
  if connection.close_after {
    finish(worker, index)
  }
}

fn pushable(connection: *const Connection) bool {
  return connection.active && (connection.mode == Mode.Stream || connection.mode == Mode.WebSocket ||
      (connection.mode == Mode.Http2 && connection.h2 != nil))
}

fn read_inbox(worker: *Worker) {
  inbox := &worker.inbox
  sync.lock(&inbox.lock)
  half := inbox.pending
  inbox.pending = 1 - half
  sync.unlock(&inbox.lock)
  for i in 0..inbox.done_count[half] {
    entry := inbox.done[half][i]
    if (entry & SlotJob) != 0 {
      worker.config.http2.job_done(worker, entry & ~SlotJob)
    } else {
      worker.on_job_done(worker, entry)
    }
  }
  inbox.done_count[half] = 0
  touched := false
  for i in 0..inbox.post_count[half] {
    item := inbox.posts[half][i]
    payload := inbox.bytes[half][item.offset..item.offset + item.length]
    if item.kind == PostKind.Publish {
      for c in 0..worker.slots_used {
        connection := &worker.connections[c]
        if pushable(connection) && connection.mode == Mode.Http2 && !connection.close_after {
          worker.config.http2.deliver(worker, connection, item, payload)
        } else if pushable(connection) && connection.topic == item.topic && !connection.close_after {
          worker.on_deliver(worker, c, item, payload)
        }
      }
      touched = true
      continue
    }
    index := #cast(usize, item.index)
    connection := &worker.connections[index]
    if pushable(connection) && connection.generation == item.generation && !connection.close_after {
      if connection.mode == Mode.Http2 {
        worker.config.http2.deliver(worker, connection, item, payload)
      } else {
        worker.on_deliver(worker, index, item, payload)
      }
      touched = true
    }
  }
  inbox.post_count[half] = 0
  inbox.byte_count[half] = 0
  if !touched { return }
  for c in 0..worker.slots_used {
    connection := &worker.connections[c]
    if pushable(connection) && !connection.writing && (connection.queued > 0 || connection.close_after) {
      settle(worker, c)
    }
  }
}

// The client's IP and port for an evented response; empty bytes otherwise.
// Behind a proxy this is the proxy: read X-Forwarded-For only from proxies
// you trust.
pub fn client_ip(response: *http.Response) network.Ip {
  connection := connection_of(response)
  if connection == nil { return network.Ip{} }
  return network.address_ip(&connection.remote)
}

// http.respond_compressed with the worker's encoder at Config.compress_level:
// body is gzipped when the client accepts it and that helps. Uncompressed
// when compress_level is zero or response is not an evented response.
pub fn respond_compressed(response: *http.Response, request: *const http.Request, body: []const u8,
  options: http.ResponseOptions) !io.IoErr {
  connection := connection_of(response)
  if connection == nil {
    try http.respond_compressed(response, request, body, options, 0, nil)
    return
  }
  worker := connection.worker
  try http.respond_compressed(response, request, body, options, worker.config.compress_level, worker.encoder)
}

// Scratch for the current handler, in the worker's request arena: allocate
// from it and never free. It is emptied before the next handler runs on this
// worker, so nothing in it outlives the handler (use job storage for run).
// nil for a response that is not evented, or with Config.request_arena_size 0.
pub fn arena(response: *http.Response) *mem.Arena {
  connection := connection_of(response)
  if connection == nil { return nil }
  return connection.worker.request_arena
}

// Which of the started workers runs this handler, from 0: an index into
// per-worker state, such as one database connection each, which then needs
// no lock. Workers never share a handler call.
pub fn worker_index(response: *http.Response) usize {
  connection := connection_of(response)
  if connection == nil { return 0 }
  return connection.worker.id
}

// Runs the server until SIGINT or SIGTERM: watches the signals first (before
// any thread starts, as std/process/signal requires), starts workers with
// start_shared on address, waits for a signal, then stops and joins them.
// Where the kernel cannot balance SO_REUSEPORT listeners (macOS, Windows),
// the workers share one listener through start instead.
// arena must hold storage_size(config, #len(workers)).
pub fn serve(arena: *mem.Arena, workers: []Worker, address: network.Ipv4Address, config: Config, handler: http.Handler,
  context: rawptr) !io.IoErr {
  signals := try signal.watch(signal.Set{ interrupt: true, terminate: true })
  defer signal.close(&signals)
  listener := network.Listener{}
  defer network.listener_close(&listener)
  try serve_start(arena, workers, address, &listener, config, handler, context)
  _ = signal.wait(&signals) catch err {
    stop(workers)
    join(workers) catch {}
    fail err
  }
  stop(workers)
  try join(workers)
}

// start_shared, or one shared listener through start where the system
// cannot balance SO_REUSEPORT listeners.
fn serve_start(arena: *mem.Arena, workers: []Worker, address: network.Ipv4Address, listener: *network.Listener, config: Config,
  handler: http.Handler, context: rawptr) !io.IoErr {
  start_shared(arena, workers, address, 1024, config, handler, context) catch err {
    case err {
      .Unsupported => {
        listener.* = try network.tcp_listen_ipv4(&address, 1024)
        try start(arena, workers, listener, config, handler, context)
        return
      }
      _ => { fail err }
    }
  }
}

// ---------------------------------------------------------------- run

// Job storage for run, zeroed, in the connection's job arena: copy what the
// work needs into it. nil when response is not an evented response or a job
// is already running. Panics when T is larger than Config.job_size, which no
// request could change.
pub fn job<T>(response: *http.Response) *T {
  connection := connection_of(response)
  if connection != nil && #sizeof(T) > connection.worker.config.job_size {
    job_too_large(#typeof(T).name, #sizeof(T), connection.worker.config.job_size)
  }
  if connection != nil && connection.h2 != nil {
    jobs := connection.worker.config.http2.job(connection)
    if jobs == nil { return nil }
    mem.arena_reset(jobs)
    return mem.push<T>(jobs)
  }
  if connection == nil || connection.job_running || connection.worker.job_stride == 0 { return nil }
  // In Config.large_body, before receive_body: storage for the reader.
  large_head := connection.mode == Mode.Body && !connection.body_started
  if connection.mode != Mode.Http && !large_head { return nil }
  if connection.jobs == nil {
    worker := connection.worker
    at := connection.index * worker.job_stride
    connection.jobs = mem.arena_from_buffer(worker.job_bytes[at..at + worker.job_stride])
  }
  mem.arena_reset(connection.jobs)
  return mem.push<T>(connection.jobs)
}

fn job_too_large(name: []const u8, size: usize, limit: usize) {
  storage: [192]u8
  rendering: fail.Status
  message := format.buffer(&rendering, storage[..])
  format.print(&message, "evented.job: {} needs {} bytes, but Config.job_size is {}; raise job_size", name, size, limit)
  #panic(format.bytes(&message))
}

// Hands the request to Config.pool: work(data) runs on a pool thread, then
// finish answers the request on the worker thread with a fresh response and
// the same request. The handler returns right after run; the connection reads
// nothing until finish has run. data must point into job storage (see job) or
// other memory that outlives finish. Fails with Unsupported without a pool
// (Config.pool), Capacity when the pool's queue is full, InvalidInput
// outside an unanswered evented request or without work, finish and data.
pub fn run<J>(response: *http.Response, data: *J, work: fn(*J), finish: fn(*http.Response, *const http.Request, *J) !io.IoErr) !io.IoErr {
  connection := connection_of(response)
  if connection != nil && connection.h2 != nil && !response.started && !response.finished {
    if connection.worker.config.pool == nil { fail .Unsupported }
    if work == nil || finish == nil || data == nil { fail .InvalidInput }
    try connection.worker.config.http2.run(connection, data, #cast(fn(rawptr), work), #cast(fn(*http.Response, *const http.Request, rawptr) !io.IoErr, finish))
    response.finished = true
    return
  }
  if connection == nil || connection.mode != Mode.Http || connection.job_running || response.started || response.finished { fail .InvalidInput }
  worker := connection.worker
  if worker.config.pool == nil { fail .Unsupported }
  if work == nil || finish == nil || data == nil { fail .InvalidInput }
  connection.job_data = data
  connection.job_work = #cast(fn(rawptr), work)
  connection.job_finish = #cast(fn(*http.Response, *const http.Request, rawptr) !io.IoErr, finish)
  connection.job_running = true
  use_jobs(worker)
  if !tasks.submit(worker.config.pool, job_main, connection) {
    connection.job_running = false
    fail .Capacity
  }
  connection.mode = Mode.Deferred
  worker.jobs_running += 1
  // The handler returns before any response: mark it so the server waits.
  response.finished = true
}

// Finishes the request on this worker once every connection that is ready
// now has had its turn: finish(response, request, data) runs after the
// current pass over events, before the worker waits again. Group work across
// requests this way, such as one database transaction for many writes. data
// must outlive finish (see job). InvalidInput on HTTP/2 and HTTP/3 streams,
// outside a handler, with a job already running, or without finish and data.
pub fn later<J>(response: *http.Response, data: *J, finish: fn(*http.Response, *const http.Request, *J) !io.IoErr) !io.IoErr {
  connection := connection_of(response)
  if connection == nil || connection.h2 != nil || connection.mode != Mode.Http || connection.job_running || response.started ||
    response.finished { fail .InvalidInput }
  if finish == nil || data == nil { fail .InvalidInput }
  worker := connection.worker
  if worker.later_count == worker.later.len {
    // Requests deferred while finish_later runs: drop the finished prefix.
    pending := worker.later_count - worker.later_done
    for i in 0..pending {
      worker.later[i] = worker.later[worker.later_done + i]
    }
    worker.later_count = pending
    worker.later_done = 0
  }
  connection.job_data = data
  connection.job_finish = #cast(fn(*http.Response, *const http.Request, rawptr) !io.IoErr, finish)
  connection.job_running = true
  connection.mode = Mode.Deferred
  use_jobs(worker)
  worker.on_later = finish_later
  worker.jobs_running += 1
  worker.later[worker.later_count] = connection.index
  worker.later_count += 1
  response.finished = true
}

// Puts the job code within the loop's reach; see Worker.on_deferred.
fn use_jobs(worker: *Worker) {
  worker.on_deferred = flush_and_wait
  worker.on_job_done = job_done
}

// Requests deferred with later, including any that their finishing defers.
fn finish_later(worker: *Worker) {
  for worker.later_done < worker.later_count {
    index := worker.later[worker.later_done]
    worker.later_done += 1
    job_done(worker, index)
  }
  worker.later_count = 0
  worker.later_done = 0
}

// On a pool thread.
fn job_main(connection: *Connection) {
  connection.job_work(connection.job_data)
  worker := connection.worker
  inbox := &worker.inbox
  sync.lock(&inbox.lock)
  half := inbox.pending
  inbox.done[half][inbox.done_count[half]] = connection.index
  inbox.done_count[half] += 1
  sync.unlock(&inbox.lock)
  event.wake(&worker.waker)
}

fn job_done(worker: *Worker, index: usize) {
  connection := &worker.connections[index]
  worker.jobs_running -= 1
  connection.job_running = false
  if connection.zombie {
    recycle(worker, index)
    return
  }
  connection.mode = Mode.Http
  request := connection.job_request
  response := new_response(connection)
  response.head_only = bytes.equal(request.method, "HEAD")
  started := log_start(worker)
  connection.job_finish(&response, &request, connection.job_data) catch err {
    worker.request_failed = true
    worker.request_error = err
  }
  finish_failed := handled(worker, &request, &response, connection.mode == Mode.Http)
  log_request(worker, &connection.remote, &request, &response, started)
  if finish_failed || !response.finished || !request.keep_alive {
    connection.close_after = true
  }
  shift_input(connection, connection.job_consumed)
  connection.job_consumed = 0
  connection.writing = false
  if !set_interest(worker, index, event.Readable) {
    close_connection(worker, index)
    return
  }
  // Pipelined requests may be waiting behind the one just answered.
  if !serve_buffered(worker, index) {
    close_connection(worker, index)
  }
}

// ---------------------------------------------------------------- large bodies

// In Config.large_body: reads the request body as it arrives instead of
// buffering it. chunk(data, piece) runs on the worker thread for each piece,
// chunked framing already removed; keep it quick, as for any handler, and
// return false to stop reading. finish answers on the worker thread once the
// body has ended (see BodyEnd), with a fresh response and the same request;
// it may hand slow work to run with the same data. data must point into job
// storage (see job) or other memory that outlives finish. The client gets
// 100 Continue now if it asked for it. InvalidInput outside the large_body
// handler or without data, chunk and finish; Capacity without room for 100
// Continue.
pub fn receive_body<J>(response: *http.Response, data: *J, chunk: fn(*J, []const u8) bool, finish: fn(*http.Response, *const http.Request, *J, BodyEnd) !io.IoErr) !io.IoErr {
  connection := connection_of(response)
  if data == nil || chunk == nil || finish == nil { fail .InvalidInput }
  if connection != nil && connection.h2 != nil {
    try connection.worker.config.http2.receive_body(connection, response, data, #cast(fn(rawptr, []const u8) bool, chunk),
      #cast(fn(*http.Response, *const http.Request, rawptr, BodyEnd) !io.IoErr, finish))
    return
  }
  if connection == nil || connection.mode != Mode.Body || connection.body_started || response.started || response.finished { fail .InvalidInput }
  if connection.body_expect && !connection.continue_sent {
    if !push_bytes(connection, "HTTP/1.1 100 Continue\r\n\r\n") { fail .Capacity }
    connection.continue_sent = true
  }
  connection.body_data = data
  connection.body_chunk = #cast(fn(rawptr, []const u8) bool, chunk)
  connection.body_finish = #cast(fn(*http.Response, *const http.Request, rawptr, BodyEnd) !io.IoErr, finish)
  connection.body_started = true
  // The handler returns before any response: mark it so the server waits.
  response.finished = true
}

// A complete head whose body fits no buffer: input holds the head first.
// Config.large_body answers it or starts receive_body.
fn body_begin(worker: *Worker, index: usize, head: http.FrameResult) bool {
  connection := &worker.connections[index]
  connection.mode = Mode.Body
  connection.body_head = head.consumed
  connection.body_left = head.body_length
  connection.body_chunked = head.chunked
  connection.body_reader = http.chunk_reader()
  connection.body_expect = head.expect_continue
  connection.body_started = false
  request := head_request(connection)
  response := new_response(connection)
  response.head_only = bytes.equal(request.method, "HEAD")
  worker.requests += 1
  invoke(worker, worker.config.large_body.handler, &response, &request)
  _ = handled(worker, &request, &response, !connection.body_started && connection.mode != Mode.Deferred)
  if connection.body_started {
    if !body_feed(worker, index) { return false }
    return !connection.active || settle_body(worker, index)
  }
  // Answered from the head alone: close after the reply, draining the unread
  // body so the client sees it.
  connection.mode = Mode.Http
  connection.body_head = 0
  connection.close_after = true
  connection.rejected = true
  connection.used = 0
  if connection.failed || !flush(connection) { return false }
  if connection.queued > 0 {
    connection.writing = true
    return set_interest(worker, index, write_interest(connection))
  }
  finish(worker, index)
  return true
}

// The request whose head leads input, with an empty body.
fn head_request(connection: *Connection) http.Request {
  framed := http.frame_request_head(connection.input[..connection.body_head], connection.body_head)
  request := framed.request
  request.context = connection.worker.context
  return request
}

// Sends what receive_body queued (100 Continue) without blocking.
fn settle_body(worker: *Worker, index: usize) bool {
  connection := &worker.connections[index]
  if connection.failed || !flush(connection) { return false }
  if connection.queued > 0 {
    connection.writing = true
    return set_interest(worker, index, write_interest(connection))
  }
  return true
}

// Hands every buffered body byte to chunk, then drops it, keeping the head.
// False means close now.
fn body_feed(worker: *Worker, index: usize) bool {
  connection := &worker.connections[index]
  at := connection.body_head
  end := connection.used
  outcome := BodyEnd.Complete
  ended := false
  for at < end && !ended {
    piece: []const u8 = connection.input[at..at]
    if connection.body_chunked {
      step := http.chunk_step(&connection.body_reader, connection.input[at..end]) catch {
        outcome = BodyEnd.Invalid
        ended = true
        break
      }
      piece = step.data
      at += step.consumed
      ended = step.done
      if step.consumed == 0 { break }
    } else {
      count := end - at
      if count > connection.body_left {
        count = connection.body_left
      }
      piece = connection.input[at..at + count]
      connection.body_left -= count
      at += count
      ended = connection.body_left == 0
    }
    if piece.len > 0 && !connection.body_chunk(connection.body_data, piece) {
      outcome = BodyEnd.Stopped
      ended = true
    }
  }
  // Keep the head and whatever follows the body: the next request.
  rest := connection.used - at
  for i in 0..rest {
    connection.input[connection.body_head + i] = connection.input[at + i]
  }
  connection.used = connection.body_head + rest
  if !ended { return true }
  return body_end(worker, index, outcome)
}

// Runs finish once the body ended, then serves what follows it. False means
// close now.
fn body_end(worker: *Worker, index: usize, outcome: BodyEnd) bool {
  connection := &worker.connections[index]
  request := head_request(connection)
  response := new_response(connection)
  response.head_only = bytes.equal(request.method, "HEAD")
  data := connection.body_data
  done := connection.body_finish
  connection.body_started = false
  connection.continue_sent = false
  if outcome == BodyEnd.Closed {
    done(&response, &request, data, outcome) catch err {
      worker.request_failed = true
      worker.request_error = err
    }
    _ = handled(worker, &request, &response, false)
    return false
  }
  connection.mode = Mode.Http
  done(&response, &request, data, outcome) catch err {
    worker.request_failed = true
    worker.request_error = err
  }
  done_failed := handled(worker, &request, &response, connection.mode == Mode.Http)
  head := connection.body_head
  connection.body_head = 0
  if connection.mode == Mode.Deferred {
    // finish called run: the head stays in input until that job answers.
    connection.job_request = request
    connection.job_consumed = head
    return flush_and_wait(worker, index)
  }
  if outcome != BodyEnd.Complete {
    connection.rejected = true
    connection.close_after = true
  }
  if done_failed || !response.finished || !request.keep_alive {
    connection.close_after = true
  }
  shift_input(connection, head)
  if connection.close_after {
    connection.used = 0
    if connection.failed || !flush(connection) { return false }
    if connection.queued > 0 {
      connection.writing = true
      return set_interest(worker, index, write_interest(connection))
    }
    finish(worker, index)
    return true
  }
  // Pipelined requests may follow the body.
  return serve_buffered(worker, index)
}

// ---------------------------------------------------------------- streams

// Starts a chunked response that stays open after the handler returns, such
// as text/event-stream. Later bytes arrive through send and publish (topic,
// or 0 for none); close_peer or the client ends it. Idle timeouts do not
// apply. InvalidInput when response is not a fresh evented response.
pub fn open_stream(response: *http.Response, options: http.ResponseOptions, topic: u64) Peer!io.IoErr {
  connection := connection_of(response)
  if connection != nil && connection.h2 != nil {
    return try connection.worker.config.http2.open_stream(connection, response, options, topic)
  }
  if connection == nil || connection.mode != Mode.Http || response.started || response.finished || response.head_only { fail .InvalidInput }
  _ = try http.respond_stream(response, options)
  connection.mode = Mode.Stream
  connection.topic = topic
  connection.worker.on_deliver = deliver
  return peer_of(connection.worker, connection.index)
}

// Answers a WebSocket upgrade request (RFC 6455 4.2) with 101 and switches
// the connection to WebSocket frames; on HTTP/2, an extended CONNECT stream
// (RFC 8441) gets 200 and carries the frames. Messages from the client go to
// Config.on_message; send, publish (topic, or 0) and close_peer reach it.
// Pings are answered; a client close is echoed. InvalidInput when request is
// not a valid upgrade, or response is not a fresh evented response; the
// handler should then answer 400. Capacity without room for the 101 response.
pub fn upgrade(response: *http.Response, request: *const http.Request, topic: u64) Peer!io.IoErr {
  connection := connection_of(response)
  if connection != nil && connection.h2 != nil { return try connection.worker.config.http2.upgrade(connection, response, topic) }
  if connection == nil || connection.mode != Mode.Http || response.started || response.finished { fail .InvalidInput }
  if !bytes.equal(request.method, "GET") { fail .InvalidInput }
  key := try websocket.validate_upgrade_request(request.raw[..request.header_length])
  accept_storage: [64]u8
  accepted := websocket.accept(accept_storage[..], key)
  if accepted.len == 0 { fail .InvalidInput }
  head_storage: [256]u8
  head := append_text(head_storage[..], 0, "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ")
  head = append_text(head_storage[..], head.len, accepted)
  head = append_text(head_storage[..], head.len, "\r\n\r\n")
  if !push_bytes(connection, head) { fail .Capacity }
  response.started = true
  response.finished = true
  connection.mode = Mode.WebSocket
  connection.topic = topic
  connection.frames = websocket.message_state(true)
  connection.on_frames = websocket_frames
  connection.worker.on_deliver = deliver
  return peer_of(connection.worker, connection.index)
}

fn append_text(destination: []u8, at: usize, piece: []const u8) []u8 {
  end := at + piece.len
  if end > destination.len { return destination[..at] }
  _ = mem.copy(destination[at..end], piece)
  return destination[..end]
}

fn close_with(connection: *Connection, code: u16) {
  if !connection.close_sent {
    payload: [2]u8 = [#cast(u8, code >> 8), #cast(u8, code)]
    _ = push_frame(connection, 8, payload[..])
    connection.close_sent = true
  }
  connection.close_after = true
}

// Parses every complete frame in input. Assembled fragments lead input; each
// frame is removed once handled. False means close now.
fn websocket_frames(worker: *Worker, index: usize) bool {
  connection := &worker.connections[index]
  for !connection.close_after && !connection.failed {
    start := connection.frames.used
    frame := websocket.parse_frame(connection.input[start..connection.used]) catch {
      // A protocol violation in the frame.
      close_with(connection, 1002)
      connection.used = 0
      return true
    }
    if !frame.complete {
      if connection.used == connection.input.len {
        // The message cannot fit the receive buffer.
        close_with(connection, 1009)
      }
      return true
    }
    control: [125]u8
    // Decodes into input at start: the payload lies after its header, so the
    // forward copy never overwrites bytes it still has to read.
    received := websocket.receive(&connection.frames, connection.input[..start + frame.consumed], control[..], frame) catch {
      // A protocol violation in the message.
      close_with(connection, 1002)
      connection.used = 0
      return true
    }
    end := start + frame.consumed
    kept := start
    if received.detail == websocket.WebSocketEventKind.None {
      kept = connection.frames.used
    }
    if received.detail == websocket.WebSocketEventKind.Ping {
      if !push_frame(connection, 10, received.payload) { return false }
    } else if received.detail == websocket.WebSocketEventKind.Close {
      close_with(connection, 1000)
    } else if received.detail == websocket.WebSocketEventKind.Ready {
      if worker.config.on_message != nil {
        kind := MessageKind.Text
        if received.opcode == 2 {
          kind = MessageKind.Binary
        }
        message := Message{ peer: peer_of(worker, index), kind: kind, payload: received.payload, context: worker.config.message_context }
        worker.config.on_message(&message)
      }
      kept = 0
    }
    // Drop the frame's bytes; keep assembled fragments in front.
    remaining := connection.used - end
    for i in 0..remaining {
      connection.input[kept + i] = connection.input[end + i]
    }
    connection.used = kept + remaining
  }
  return true
}

