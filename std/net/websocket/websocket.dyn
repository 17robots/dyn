use io "std/io"
use mem "std/mem"
use base64 "std/encoding/base64"
use http "std/net/http"
use parse "std/parse"

// complete is false when input holds only part of a frame: read more.
pub struct WebSocketFrame { payload: []const u8, opcode: u8, mask: u32, consumed: usize, final: bool, masked: bool, complete: bool }
// A frame as parsed, before anyone is told: invalid with the offset where
// the input went wrong.
struct Scanned { frame: WebSocketFrame, invalid: bool, offset: usize }
// None: a fragment was stored and the message goes on.
pub enum WebSocketEventKind { None, Ready, Ping, Pong, Close }
pub struct WebSocketMessageState { used: usize, opcode: u8, fragmented: bool, closed: bool, enforce_mask: bool, masked: bool }
pub struct WebSocketEvent { payload: []u8, detail: WebSocketEventKind, opcode: u8, close_code: u16 }

pub struct WebSocketConnection {
  input: io.Reader,
  output: io.Writer,
  frames: []u8,
  // Retain unread wire bytes; compact only on the next receive.
  frame_used: usize,
  frame_consumed: usize,
  input_ended: bool,
  message: []u8,
  control: []u8,
  state: WebSocketMessageState,
  client: bool,
  active: bool,
  // After a failure the stream position is lost: later calls fail with
  // InvalidInput.
  failed: bool,
  close_sent: bool,
}


const WsU8Zero: u8 = 0
const WsU8Three: u8 = 3
const WsU8Seven: u8 = 7
const WsU8Eight: u8 = 8
const WsU8Ten: u8 = 10
const WsU8Mask15: u8 = 15
const WsU8Mask112: u8 = 112
const WsU8Mask127: u8 = 127
const WsU8Mask128: u8 = 128
const WsFour: usize = 4
const WsZero: usize = 0
const WsTwo: usize = 2
const WsThree: usize = 3
const WsSeven: usize = 7
const WsEight: usize = 8
const WsTen: usize = 10
const Ws125: usize = 125
const Ws126: usize = 126
const Ws127: usize = 127
const Ws255: usize = 255
const Ws256: usize = 256
const Ws65535: usize = 65535
const WsU16Byte: u16 = 256
const WsMax: usize = #max(usize)
const WsU32Byte: u32 = 256
const WsU32Word: u32 = 65536
const WsU32High: u32 = 16777216
const WsU64Byte: u64 = 256
const WsU64Word: u64 = 65536
const WsU64High: u64 = 16777216
// Std code wraps on overflow in every build mode, so + and << are mod 2^32.
fn ws_add32(left: u32, right: u32) u32 {
  return #wrapping(left + right)
}
fn ws_rol(value: u32, count: u32) u32 {
  return #wrapping(value << count) | (value >> (32 - count))
}
fn ws_sha1_block(state: []u32, block: []const u8) {
  words: [80]u32
  i: usize = 0
  for i < 16 {
    at := i * 4
    byte0: u32 = block[at]
    byte1: u32 = block[at + 1]
    byte2: u32 = block[at + 2]
    byte3: u32 = block[at + 3]
    words[i] = (byte0 << 24) | (byte1 << 16) | (byte2 << 8) | byte3
    i += 1
  }
  for i < 80 {
    words[i] = ws_rol(words[i - 3] ^ words[i - 8] ^ words[i - 14] ^ words[i - 16], 1)
    i += 1
  }
  a := state[0]
  b := state[1]
  c := state[2]
  d := state[3]
  e := state[4]
  i = 0
  for i < 80 {
    f: u32 = 0
    k: u32 = 0
    if i < 20 {
      f = (b & c) | ((b ^ 4294967295) & d)
      k = 1518500249
    } else if i < 40 {
      f = b ^ c ^ d
      k = 1859775393
    } else if i < 60 {
      f = (b & c) | (b & d) | (c & d)
      k = 2400959708
    } else {
      f = b ^ c ^ d
      k = 3395469782
    }
    temporary := ws_add32(ws_add32(ws_add32(ws_add32(ws_rol(a, 5), f), e), k), words[i])
    e = d
    d = c
    c = ws_rol(b, 30)
    b = a
    a = temporary
    i += 1
  }
  state[0] = ws_add32(state[0], a)
  state[1] = ws_add32(state[1], b)
  state[2] = ws_add32(state[2], c)
  state[3] = ws_add32(state[3], d)
  state[4] = ws_add32(state[4], e)
}

fn ws_equal(left: []const u8, right: []const u8) bool {
  if left.len != right.len { return false }
  for i in 0..left.len {
    if left[i] != right[i] { return false }
  }
  return true
}
fn ws_equal_case(left: []const u8, right: []const u8) bool {
  if left.len != right.len { return false }
  for i in 0..left.len {
    a := left[i]
    b := right[i]
    if a >= 'A' && a <= 'Z' {
      a += 32
    }
    if b >= 'A' && b <= 'Z' {
      b += 32
    }
    if a != b { return false }
  }
  return true
}
fn ws_append(destination: []u8, offset: usize, source: []const u8) usize {
  if offset > destination.len || source.len > destination.len - offset {
    return destination.len + 1
  }
  for i in 0..source.len {
    destination[offset + i] = source[i]
  }
  return offset + source.len
}

// Whether key is base64 for 16 bytes, as RFC 6455 requires.
fn key_decodes(arena: *mem.Arena, key: []const u8) bool {
  decoded := base64.decode(arena, key) catch { return false }
  return decoded.len == 16
}

// Computes RFC 6455 Sec-WebSocket-Accept into 28 caller-owned bytes.
fn websocket_accept(destination: []u8, key: []const u8) []u8 {
  decoded: [18 + mem.ArenaBufferOverhead]u8
  decoded_arena := mem.arena_from_buffer(decoded[..])
  if key.len != 24 || !key_decodes(decoded_arena, key) || destination.len < 28 {
    return destination[..0]
  }
  guid: []const u8 = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
  message: [128]u8
  i: usize = 0
  for i < key.len {
    message[i] = key[i]
    i += 1
  }
  for j in 0..guid.len {
    message[i + j] = guid[j]
  }
  message_length := key.len + guid.len
  message[message_length] = 128
  bit_length := message_length * 8
  message[126] = #cast(u8, (bit_length >> 8))
  message[127] = #cast(u8, bit_length)
  state: [5]u32 = [1732584193, 4023233417, 2562383102, 271733878, 3285377520]
  ws_sha1_block(state[..], message[..64])
  ws_sha1_block(state[..], message[64..])
  digest: [20]u8
  i = 0
  for i < 5 {
    digest[i * 4] = (state[i] >> 24)
    digest[i * 4 + 1] = #cast(u8, (state[i] >> 16))
    digest[i * 4 + 2] = #cast(u8, (state[i] >> 8))
    digest[i * 4 + 3] = #cast(u8, state[i])
    i += 1
  }
  encoding_storage: [28 + mem.ArenaBufferOverhead]u8
  encoded := mem.arena_from_buffer(encoding_storage[..])
  text := base64.encode(encoded, digest[..])
  for j in 0..text.len {
    destination[j] = text[j]
  }
  return destination[..text.len]
}

// Validates the HTTP request-side RFC 6455 upgrade fields. Returned key borrows request.
// Fails with InvalidInput.
fn websocket_validate_upgrade_request(request: []const u8) []const u8!io.IoErr {
  _ = http.parse_request(request) catch { fail .InvalidInput }
  // Not a GET request.
  if request.len < 4 || !ws_equal(request[..4], "GET ") { fail .InvalidInput }
  // A missing field is a bad handshake.
  upgrade := http.header(request, "Upgrade") catch { fail .InvalidInput }
  connection_header := http.header(request, "Connection") catch { fail .InvalidInput }
  version := http.header(request, "Sec-WebSocket-Version") catch { fail .InvalidInput }
  key := http.header(request, "Sec-WebSocket-Key") catch { fail .InvalidInput }
  scratch: [18 + mem.ArenaBufferOverhead]u8
  scratch_arena := mem.arena_from_buffer(scratch[..])
  if !ws_equal_case(upgrade, "websocket") || !ws_equal_case(connection_header, "Upgrade") || !ws_equal(version, "13") ||
    !key_decodes(scratch_arena, key) { fail .InvalidInput }
  return key
}

// Writes the server's complete 101 response. Empty means invalid key/capacity.
fn websocket_write_upgrade_response(destination: []u8, key: []const u8) []u8 {
  accept_storage: [28]u8
  accept_value := websocket_accept(accept_storage[..], key)
  if accept_value.len == 0 { return destination[..0] }
  at := ws_append(destination, 0, "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ")
  at = ws_append(destination, at, accept_value)
  at = ws_append(destination, at, "\r\n\r\n")
  if at > destination.len { return destination[..0] }
  return destination[..at]
}

fn websocket_validate_upgrade_response(response: []const u8, key: []const u8) bool {
  head := http.parse_response(response) catch { return false }
  if head.code != 101 { return false }
  upgrade := http.header(response, "Upgrade") catch { return false }
  connection_header := http.header(response, "Connection") catch { return false }
  accept_header := http.header(response, "Sec-WebSocket-Accept") catch { return false }
  expected: [28]u8
  expected_accept := websocket_accept(expected[..], key)
  return ws_equal_case(upgrade, "websocket") && ws_equal_case(connection_header, "Upgrade") && ws_equal(accept_header, expected_accept)
}

fn ws_put64(output: []u8, at: usize, value: usize) {
  i: usize = WsEight
  remaining := value
  for i > 0 {
    i -= 1
    output[at + i] = remaining % Ws256
    remaining /= Ws256
  }
}

// Writes one RFC 6455 frame. Client callers supply a fresh unpredictable mask.
fn websocket_write(destination: []u8, opcode: u8, payload: []const u8, final: bool, masked: bool, mask: u32) []u8 {
  opcode_value: usize = opcode
  control := opcode_value >= WsEight
  if opcode_value > WsTen || (opcode_value >= WsThree && opcode_value <= WsSeven) || (control && (!final || payload.len > Ws125)) {
    return destination[..0]
  }
  extended: usize = 0
  if payload.len >= Ws126 && payload.len <= Ws65535 {
    extended = WsTwo
  } else if payload.len > Ws65535 {
    extended = WsEight
  }
  header := WsTwo + extended
  if masked {
    header += 4
  }
  if header > destination.len || payload.len > destination.len - header { return destination[..0] }
  destination[0] = opcode
  if final {
    destination[0] = destination[0] | WsU8Mask128
  }
  length_value := payload.len % Ws256
  length: u8 = #cast(u8, length_value)
  if extended == WsTwo {
    length = 126
    high := payload.len / Ws256
    destination[2] = #cast(u8, high)
    low := payload.len % Ws256
    destination[3] = #cast(u8, low)
  } else if extended == WsEight {
    length = 127
    ws_put64(destination, WsTwo, payload.len)
  }
  destination[1] = length
  if masked {
    destination[1] = destination[1] | WsU8Mask128
  }
  mask_at: usize = 2
  mask_at += extended
  payload_at := mask_at
  if masked {
    wide_mask: u64 = mask
    mask0 := wide_mask / WsU64High
    mask1 := (wide_mask / WsU64Word) % WsU64Byte
    mask2 := (wide_mask / WsU64Byte) % WsU64Byte
    destination[mask_at] = #cast(u8, mask0)
    destination[mask_at + 1] = #cast(u8, mask1)
    destination[mask_at + 2] = #cast(u8, mask2)
    destination[mask_at + 3] = #cast(u8, mask)
    payload_at += 4
  }
  for i in 0..payload.len {
    byte := payload[i]
    if masked {
      byte = byte ^ destination[mask_at + i % WsFour]
    }
    destination[payload_at + i] = byte
  }
  return destination[..payload_at + payload.len]
}

// Offsets identify bytes in the supplied frame; semantic message/upgrade errors
// without a single source cursor use zero.
// Parses one complete frame prefix. Payload borrows input and remains masked.
fn websocket_parse(input: []const u8) Scanned {
  if input.len < 2 { return Scanned{} }
  if (input[0] & WsU8Mask112) != WsU8Zero { return Scanned{ invalid: true, offset: 0 } }
  opcode := input[0] & WsU8Mask15
  opcode_value: usize = opcode
  final := (input[0] & WsU8Mask128) != WsU8Zero
  masked := (input[1] & WsU8Mask128) != WsU8Zero
  if opcode_value > 10 || (opcode_value >= 3 && opcode_value <= 7) {
    return Scanned{ invalid: true, offset: 0 }
  }
  length_byte := input[1] & WsU8Mask127
  size: usize = length_byte
  at: usize = 2
  if size == Ws126 {
    if input.len < WsFour { return Scanned{} }
    high := #cast(usize, input[2])
    low := #cast(usize, input[3])
    size = high * Ws256 + low
    at = WsFour
    if size < Ws126 { return Scanned{ invalid: true, offset: 2 } }
  } else if size == 127 {
    if input.len < 10 { return Scanned{} }
    if (input[2] & WsU8Mask128) != WsU8Zero { return Scanned{ invalid: true, offset: 2 } }
    size = 0
    for i in 0..8 {
      next := #cast(usize, input[2 + i])
      if size > (WsMax - next) / Ws256 { return Scanned{ invalid: true, offset: 2 + i } }
      size = size * Ws256 + next
    }
    at = 10
    if size <= 65535 { return Scanned{ invalid: true, offset: 2 } }
  }
  if opcode_value >= 8 && (!final || size > 125) { return Scanned{ invalid: true, offset: 0 } }
  mask: u32 = 0
  if masked {
    if at + 4 > input.len { return Scanned{} }
    m0: u32 = input[at]
    m1: u32 = input[at + 1]
    m2: u32 = input[at + 2]
    m3: u32 = input[at + 3]
    mask = m0 * 16777216 + m1 * 65536 + m2 * 256 + m3
    at += 4
  }
  if at > input.len || size > input.len - at { return Scanned{} }
  return Scanned{ frame: WebSocketFrame{ payload: input[at..at + size], opcode: opcode, mask: mask, consumed: at + size, final: final, masked: masked, complete: true } }
}

fn websocket_decode(destination: []u8, frame: WebSocketFrame) []u8 {
  if !frame.complete || destination.len < frame.payload.len { return destination[..0] }
  fm0 := frame.mask >> 24
  fm1 := frame.mask >> 16
  fm2 := frame.mask >> 8
  keys: [4]u8
  keys[0] = #cast(u8, fm0)
  keys[1] = #cast(u8, fm1)
  keys[2] = #cast(u8, fm2)
  keys[3] = #cast(u8, frame.mask)
  i: usize = 0
  for i < frame.payload.len {
    destination[i] = frame.payload[i]
    if frame.masked {
      destination[i] = destination[i] ^ keys[i % WsFour]
    }
    i += 1
  }
  return destination[..frame.payload.len]
}

fn ws_decode_at(destination: []u8, at: usize, frame: WebSocketFrame) bool {
  if at > destination.len || frame.payload.len > destination.len - at { return false }
  keys: [4]u8 = [#cast(u8, (frame.mask >> 24)), #cast(u8, (frame.mask >> 16)), #cast(u8, (frame.mask >> 8)), #cast(u8, frame.mask)]
  i: usize = 0
  for i < frame.payload.len {
    destination[at + i] = frame.payload[i]
    if frame.masked {
      destination[at + i] = destination[at + i] ^ keys[i % WsFour]
    }
    i += 1
  }
  return true
}

fn ws_utf8(bytes: []const u8) bool {
  i: usize = 0
  for i < bytes.len {
    first := bytes[i]
    need: usize = 0
    minimum: u32 = 0
    value: u32 = 0
    if first < 128 {
      i += 1
      continue
    }
    if first >= 194 && first <= 223 {
      need = 1
      minimum = 128
      value = (first & 31)
    } else if first >= 224 && first <= 239 {
      need = 2
      minimum = 2048
      value = (first & 15)
    } else if first >= 240 && first <= 244 {
      need = 3
      minimum = 65536
      value = (first & 7)
    } else {
      return false
    }
    if need > bytes.len - i - 1 { return false }
    for j in 0..need {
      next := bytes[i + j + 1]
      if next < 128 || next > 191 { return false }
      value = value * 64 + (next & 63)
    }
    if value < minimum || value > 1114111 || (value >= 55296 && value <= 57343) { return false }
    i += need + 1
  }
  return true
}

fn ws_close_code(code: u16) bool {
  if code < 1000 || code >= 5000 { return false }
  if code == 1004 || code == 1005 || code == 1006 || code == 1015 { return false }
  return code <= 1014 || code >= 3000
}

// Server receivers require masked frames; client receivers require unmasked frames.
fn websocket_message_state(expect_masked: bool) WebSocketMessageState {
  return WebSocketMessageState{ enforce_mask: true, masked: expect_masked }
}

// Advances one RFC 6455 message io. All storage belongs to the caller.
// Message storage persists across fragments; control storage may be reused per call.
fn websocket_receive(state: *WebSocketMessageState, message: []u8, control: []u8, frame: WebSocketFrame) WebSocketEvent!io.IoErr {
  // The frame is incomplete, or the peer has closed.
  if !frame.complete || state.closed { fail .InvalidInput }
  if state.enforce_mask && frame.masked != state.masked { fail .InvalidInput }
  if frame.opcode >= WsU8Eight {
    if !ws_decode_at(control, 0, frame) { fail .Capacity }
    payload := control[..frame.payload.len]
    if frame.opcode == WsU8Eight {
      if payload.len == 1 { fail .InvalidInput }
      code: u16 = 0
      if payload.len >= 2 {
        first: u16 = payload[0]
        second: u16 = payload[1]
        code = first * WsU16Byte + second
      }
      if (payload.len >= 2 && !ws_close_code(code)) || (payload.len > 2 && !ws_utf8(payload[2..])) {
        fail .InvalidInput
      }
      state.closed = true
      return WebSocketEvent{ payload: payload, detail: WebSocketEventKind.Close, opcode: frame.opcode, close_code: code }
    }
    if frame.opcode == 9 {
      return WebSocketEvent{ payload: payload, detail: WebSocketEventKind.Ping, opcode: frame.opcode }
    }
    return WebSocketEvent{ payload: payload, detail: WebSocketEventKind.Pong, opcode: frame.opcode }
  }
  if frame.opcode == 0 {
    if !state.fragmented { fail .InvalidInput }
  } else {
    if state.fragmented || (frame.opcode != 1 && frame.opcode != 2) { fail .InvalidInput }
    state.used = 0
    state.opcode = frame.opcode
  }
  if !ws_decode_at(message, state.used, frame) { fail .Capacity }
  state.used += frame.payload.len
  if !frame.final {
    state.fragmented = true
    return WebSocketEvent{ detail: WebSocketEventKind.None, opcode: state.opcode }
  }
  state.fragmented = false
  result_payload := message[..state.used]
  message_opcode := state.opcode
  if message_opcode == 1 && !ws_utf8(result_payload) {
    state.used = 0
    fail .InvalidInput
  }
  state.used = 0
  return WebSocketEvent{ payload: result_payload, detail: WebSocketEventKind.Ready, opcode: message_opcode }
}

// Concise public names; websocket_* spellings remain as compatibility aliases.
pub fn accept(destination: []u8, key: []const u8) []u8 {
  return websocket_accept(destination, key)
}

// Checks the RFC 6455 upgrade fields of a request head; the client's key,
// borrowing request. Fails with InvalidInput.
pub fn validate_upgrade_request(request: []const u8) []const u8!io.IoErr {
  return try websocket_validate_upgrade_request(request)
}

// The 101 Switching Protocols response for key, in arena.
pub fn write_upgrade_response(arena: *mem.Arena, key: []const u8) []u8 {
  mark := mem.arena_mark(arena)
  space := mem.push_bytes(arena, 160)
  output := websocket_write_upgrade_response(space, key)
  mem.arena_rewind(arena, mark + output.len)
  return output
}

// Checks a server's 101 response for key. Fails with InvalidInput.
pub fn validate_upgrade_response(response: []const u8, key: []const u8) !io.IoErr {
  if !websocket_validate_upgrade_response(response, key) { fail .InvalidInput }
}

// One encoded frame, in arena.
pub fn write_frame(arena: *mem.Arena, opcode: u8, payload: []const u8, final: bool, masked: bool, mask: u32) []u8 {
  mark := mem.arena_mark(arena)
  space := mem.push_bytes(arena, payload.len + 14)
  output := websocket_write(space, opcode, payload, final, masked, mask)
  mem.arena_rewind(arena, mark + output.len)
  return output
}

// One frame at the start of input; payload borrows input and stays masked.
// complete is false when input holds only part of it. A malformed frame
// fails with Invalid at its offset.
pub fn parse_frame(input: []const u8) WebSocketFrame!parse.ParseErr {
  scanned := websocket_parse(input)
  if scanned.invalid { fail parse.ParseErr.Invalid(scanned.offset) }
  return scanned.frame
}
// The frame's payload, unmasked, in arena.
pub fn decode_frame(arena: *mem.Arena, frame: WebSocketFrame) []u8 {
  mark := mem.arena_mark(arena)
  space := mem.push_bytes(arena, frame.payload.len)
  output := websocket_decode(space, frame)
  mem.arena_rewind(arena, mark + output.len)
  return output
}
pub fn message_state(expect_masked: bool) WebSocketMessageState {
  return websocket_message_state(expect_masked)
}
// Adds a complete frame to the message under way. Protocol violations fail
// with InvalidInput, storage that is too small with Capacity.
pub fn receive(state: *WebSocketMessageState, message: []u8, control: []u8, frame: WebSocketFrame) WebSocketEvent!io.IoErr {
  return try websocket_receive(state, message, control, frame)
}

// Stateful stream wrapper. All buffers are caller-owned; client controls require
// a fresh unpredictable mask supplied to connection_send.
// A zero connection is inactive. After a failure the connection stays failed:
// later calls fail with InvalidInput. Close sends at most one frame and never
// closes the borrowed transport. After a peer Close, receive returns a Close
// event without reading again; a Close reply is still allowed. Other sends
// after either Close fail with InvalidInput and leave the connection usable.
// Reset by assigning a fresh connection(...) with fresh stream/buffer state.
pub fn connection(input: io.Reader, output: io.Writer, frames: []u8, message: []u8,
  control: []u8, client: bool) WebSocketConnection {
  return WebSocketConnection{
    input: input,
    output: output,
    frames: frames,
    message: message,
    control: control,
    state: websocket_message_state(!client),
    client: client,
    active: true,
  }
}

// Fails the connection for good: the stream position is lost.
fn connection_failed(state: *WebSocketConnection, err: io.IoErr) io.IoErr {
  state.failed = true
  return err
}

// An earlier failure, or a connection that is not set up, fails with
// InvalidInput.
fn connection_usable(state: *WebSocketConnection) !io.IoErr {
  if state.failed { fail .InvalidInput }
  if !state.active || state.frame_used > state.frames.len || state.frame_consumed > state.frame_used {
    fail connection_failed(state, io.IoErr.InvalidInput)
  }
}

pub fn connection_send(state: *WebSocketConnection, opcode: u8, payload: []const u8, final: bool, mask: u32) !io.IoErr {
  try connection_usable(state)
  // The connection is closing.
  if state.close_sent || (state.state.closed && opcode != WsU8Eight) { fail .InvalidInput }
  if state.output.write == nil { fail connection_failed(state, io.IoErr.InvalidInput) }
  opcode_value := #cast(usize, opcode)
  if opcode_value > 10 || (opcode_value >= 3 && opcode_value <= 7) || (opcode_value >= 8 && (!final || payload.len > 125)) {
    fail connection_failed(state, io.IoErr.InvalidInput)
  }
  // Sending must not overwrite wire bytes retained by receive.
  if state.frame_consumed == state.frame_used {
    state.frame_consumed = 0
    state.frame_used = 0
  }
  frame := websocket_write(state.frames[..state.frame_consumed], opcode, payload, final, state.client, mask)
  if frame.len == 0 {
    frame = websocket_write(state.frames[state.frame_used..], opcode, payload, final, state.client, mask)
  }
  // The frame does not fit frame storage.
  if frame.len == 0 { fail connection_failed(state, io.IoErr.Capacity) }
  io.write(state.output, frame) catch err { fail connection_failed(state, err) }
  if opcode == WsU8Eight {
    state.close_sent = true
  }
}

pub fn connection_ping(state: *WebSocketConnection, payload: []const u8, mask: u32) !io.IoErr {
  try connection_send(state, 9, payload, true, mask)
}

pub fn connection_pong(state: *WebSocketConnection, payload: []const u8, mask: u32) !io.IoErr {
  try connection_send(state, 10, payload, true, mask)
}

pub fn connection_close(state: *WebSocketConnection, payload: []const u8, mask: u32) !io.IoErr {
  // Closing twice, or closing a zero connection, does nothing; a failed one
  // reports why.
  if !state.failed && (!state.active || state.close_sent) { return }
  try connection_send(state, 8, payload, true, mask)
}

// The next message or control frame. Event payload borrows message/control
// until the next receive call.
pub fn connection_receive(state: *WebSocketConnection) WebSocketEvent!io.IoErr {
  try connection_usable(state)
  if state.state.closed { return WebSocketEvent{ detail: WebSocketEventKind.Close, opcode: 8 } }
  if state.input.read == nil { fail connection_failed(state, io.IoErr.InvalidInput) }
  remaining := state.frame_used - state.frame_consumed
  for i in 0..remaining {
    state.frames[i] = state.frames[state.frame_consumed + i]
  }
  state.frame_used = remaining
  state.frame_consumed = 0
  for true {
    scanned := websocket_parse(state.frames[..state.frame_used])
    if scanned.invalid { fail connection_failed(state, io.IoErr.InvalidInput) }
    if scanned.frame.complete {
      event := websocket_receive(&state.state, state.message, state.control, scanned.frame) catch err { fail connection_failed(state, err) }
      state.frame_consumed = scanned.frame.consumed
      if event.detail == WebSocketEventKind.None {
        remaining = state.frame_used - state.frame_consumed
        for i in 0..remaining {
          state.frames[i] = state.frames[state.frame_consumed + i]
        }
        state.frame_used = remaining
        state.frame_consumed = 0
        continue
      }
      return event
    }
    // The stream ended inside a frame.
    if state.input_ended { fail connection_failed(state, io.IoErr.InvalidInput) }
    // The frame does not fit frame storage.
    if state.frame_used == state.frames.len { fail connection_failed(state, io.IoErr.Capacity) }
    count := io.read(state.input, state.frames[state.frame_used..]) catch err { fail connection_failed(state, err) }
    state.frame_used += count
    state.input_ended = count == 0
  }
  return WebSocketEvent{}
}
