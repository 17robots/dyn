#target(kernel: linux)
// Linux epoll. Target-specific Event storage follows the kernel UAPI layout.
pub const EventReadable: u32 = 1
pub const EventWritable: u32 = 4
pub const EventError: u32 = 8
pub const EventHangup: u32 = 16
pub const EventEdgeTriggered: u32 = 2147483648
pub const EventAdd: usize = 1
pub const EventRemove: usize = 2
pub const EventModify: usize = 3


fn event_put_u32(bytes: []u8, value: u32) {
  bytes[0] = #cast(u8) value
  bytes[1] = #cast(u8) (value >> 8)
  bytes[2] = #cast(u8) (value >> 16)
  bytes[3] = #cast(u8) (value >> 24)
}

fn event_put_u64(bytes: []u8, value: u64) {
  event_put_u32(bytes[..4], #cast(u32) value)
  event_put_u32(bytes[4..8], #cast(u32) (value >> 32))
}

pub fn event(events: u32, data: u64) Event {
  value := Event{}
  event_put_u32(value.bytes[..4], events)
  event_put_u64(value.bytes[EventDataOffset..EventDataOffset + 8], data)
  return value
}

pub fn event_events(value: *const Event) u32 {
  a: u32 = #cast(u32) value.bytes[0]
  b: u32 = #cast(u32) value.bytes[1]
  c: u32 = #cast(u32) value.bytes[2]
  d: u32 = #cast(u32) value.bytes[3]
  return a | (b << 8) | (c << 16) | (d << 24)
}

fn event_u32_at(value: *const Event, offset: usize) u32 {
  a: u32 = #cast(u32) value.bytes[offset]
  b: u32 = #cast(u32) value.bytes[offset + 1]
  c: u32 = #cast(u32) value.bytes[offset + 2]
  d: u32 = #cast(u32) value.bytes[offset + 3]
  return a | (b << 8) | (c << 16) | (d << 24)
}

pub fn event_data(value: *const Event) u64 {
  low: u64 = #cast(u64) event_u32_at(value, EventDataOffset)
  high: u64 = #cast(u64) event_u32_at(value, EventDataOffset + 4)
  return low | (high << 32)
}

pub fn event_queue() Result {
  return result(#syscall(291, 0))
}

pub fn event_control(queue: isize, operation: usize, descriptor: isize, value: *Event) Result {
  return result(#syscall(233, queue, operation, descriptor, value))
}

// Registration helpers keep epoll's operation numbers and remove-event pointer
// convention out of application code. `data` is returned unchanged by event_wait.
pub fn event_add(queue: isize, descriptor: isize, events: u32, data: u64) Result {
  value := event(events, data)
  return event_control(queue, EventAdd, descriptor, &value)
}

pub fn event_modify(queue: isize, descriptor: isize, events: u32, data: u64) Result {
  value := event(events, data)
  return event_control(queue, EventModify, descriptor, &value)
}

pub fn event_remove(queue: isize, descriptor: isize) Result {
  // Linux ignores this argument for EPOLL_CTL_DEL, but using valid storage keeps
  // the language-level pointer contract explicit.
  value := Event{}
  return event_control(queue, EventRemove, descriptor, &value)
}

pub fn event_wait(queue: isize, events: []Event, timeout_milliseconds: i32) Result {
  if #len(events) == 0 {
    return Result{ value: -1, error: -22, ok: false }
  }
  start := clock.ClockResult{}
  if timeout_milliseconds > 0 {
    start = clock.try_monotonic_now()
    if !start.ok { return Result{ value: start.error, error: start.error } }
  }
  remaining := timeout_milliseconds
  value := #syscall(232, queue, &events[0], #len(events), remaining)
  for value == -4 {
    if timeout_milliseconds > 0 {
      retry := interrupted_timeout(start.value, timeout_milliseconds)
      if !retry.ok || retry.value == 0 { return retry }
      remaining = #cast(i32) retry.value
    }
    value = #syscall(232, queue, &events[0], #len(events), remaining)
  }
  return result(value)
}
