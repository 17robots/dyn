use "std/os/linux/sys"
#target(kernel: linux)
// Linux epoll. Target-specific Event storage follows the kernel UAPI layout.
pub const EventReadable: u32 = 1
pub const EventWritable: u32 = 4
pub const EventError: u32 = 8
pub const EventHangup: u32 = 16
pub const EventEdgeTriggered: u32 = 2147483648
pub const EventAdd: usize = 1
pub const EventRemove: usize = 2
pub const EventModify: usize = 3


fn event_put_u32(bytes: []u8, value: u32) {
  bytes[0] = #cast(u8, value)
  bytes[1] = #cast(u8, (value >> 8))
  bytes[2] = #cast(u8, (value >> 16))
  bytes[3] = (value >> 24)
}

fn event_put_u64(bytes: []u8, value: u64) {
  event_put_u32(bytes[..4], #cast(u32, value))
  event_put_u32(bytes[4..8], (value >> 32))
}

pub fn event(events: u32, data: u64) Event {
  value := Event{}
  event_put_u32(value.bytes[..4], events)
  event_put_u64(value.bytes[EventDataOffset..EventDataOffset + 8], data)
  return value
}

pub fn event_events(value: *const Event) u32 {
  a: u32 = value.bytes[0]
  b: u32 = value.bytes[1]
  c: u32 = value.bytes[2]
  d: u32 = value.bytes[3]
  return a | (b << 8) | (c << 16) | (d << 24)
}

fn event_u32_at(value: *const Event, offset: usize) u32 {
  a: u32 = value.bytes[offset]
  b: u32 = value.bytes[offset + 1]
  c: u32 = value.bytes[offset + 2]
  d: u32 = value.bytes[offset + 3]
  return a | (b << 8) | (c << 16) | (d << 24)
}

pub fn event_data(value: *const Event) u64 {
  low: u64 = event_u32_at(value, EventDataOffset)
  high: u64 = event_u32_at(value, EventDataOffset + 4)
  return low | (high << 32)
}

// A new epoll queue descriptor, or -1 after a failure.
pub fn event_queue(status: *fail.Status) isize {
  if status.failed { return -1 }
  return check(status, "epoll create", #syscall(sys.EpollCreate1, 0))
}

pub fn event_control(status: *fail.Status, queue: isize, operation: usize, descriptor: isize, value: *Event) {
  if status.failed { return }
  _ = check(status, "epoll control", #syscall(sys.EpollCtl, queue, operation, descriptor, value))
}

// Registration helpers keep epoll's operation numbers and remove-event pointer
// convention out of application code. `data` is returned unchanged by event_wait.
pub fn event_add(status: *fail.Status, queue: isize, descriptor: isize, events: u32, data: u64) {
  value := event(events, data)
  event_control(status, queue, EventAdd, descriptor, &value)
}

pub fn event_modify(status: *fail.Status, queue: isize, descriptor: isize, events: u32, data: u64) {
  value := event(events, data)
  event_control(status, queue, EventModify, descriptor, &value)
}

pub fn event_remove(status: *fail.Status, queue: isize, descriptor: isize) {
  // Linux ignores this argument for EPOLL_CTL_DEL, but using valid storage keeps
  // the language-level pointer contract explicit.
  value := Event{}
  event_control(status, queue, EventRemove, descriptor, &value)
}

// Waits for events; the number stored in events, 0 on timeout.
pub fn event_wait(status: *fail.Status, queue: isize, events: []Event, timeout_milliseconds: i32) usize {
  if status.failed { return 0 }
  if #len(events) == 0 {
    invalid(status, "epoll wait", "no room for events")
    return 0
  }
  start := clock.Instant{}
  if timeout_milliseconds > 0 {
    start = clock.monotonic_now()
  }
  remaining := timeout_milliseconds
  value := #syscall(sys.EpollWait, queue, &events[0], #len(events), remaining)
  for value == -4 {
    if timeout_milliseconds > 0 {
      remaining = interrupted_timeout(start, timeout_milliseconds)
      if remaining == 0 { return 0 }
    }
    value = #syscall(sys.EpollWait, queue, &events[0], #len(events), remaining)
  }
  if check(status, "epoll wait", value) < 0 { return 0 }
  return #cast(usize, value)
}
