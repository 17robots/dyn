use "vendor/openssl/tls" provider
use "std/mem" memory
use "std/fail"
use "std/io" io
pub type Context = provider.Context
pub type Connection = provider.Connection
pub type Certificate = provider.Certificate

// What a nonblocking connection waits for before the call can go on, and a
// read or write: the bytes moved, or what the connection waits for. Blocking
// connections never report a want.
pub type Want = provider.Want
pub type Attempt = provider.Attempt

// Calls that can fail take a *fail.Status: a bad argument fails with
// InvalidInput, a failed certificate check with PermissionDenied, anything
// else the provider reports with System and its error code in native.

// The provider copies the protocol wire bytes during this call.
pub fn set_alpn_protocols(status: *fail.Status, connection: Connection, protocols: []const u8) {
  provider.set_alpn_protocols(status, connection, protocols)
}
// Server ALPN: each handshake picks the first protocol of preference (wire
// format, such as "\x02h2\x08http/1.1") the client offers. preference must
// outlive the context; a string literal does.
pub fn server_alpn(status: *fail.Status, context: Context, preference: *const []const u8) {
  provider.set_server_alpn(status, context, preference)
}
// Borrows provider connection memory. Invalid after connection_release or a
// renegotiation that replaces the negotiated protocol; copy before either.
pub fn selected_alpn(connection: Connection) []const u8 {
  return provider.selected_alpn(connection)
}
// nil when the peer sent no certificate.
pub fn peer_certificate_owned(connection: Connection) Certificate {
  return provider.peer_certificate_owned(connection)
}
// Frees the certificate and clears the handle; releasing a cleared handle does nothing.
pub fn certificate_release(certificate: *Certificate) {
  value := certificate.*
  certificate.* = nil
  provider.certificate_free_owned(value)
}
// Complete provider-formatted subject copied into arena. Failure publishes an
// empty value and consumes no arena bytes. Exhaustion panics.
// https://github.com/openssl/openssl/blob/master/crypto/x509/x509_obj.c
pub fn certificate_subject(arena: *memory.Arena, status: *fail.Status, certificate: Certificate) []u8 {
  empty: []u8
  formatted := provider.subject_text_owned(status, certificate)
  if status.failed { return empty }
  defer provider.subject_text_free_owned(formatted)
  length: usize = 0
  for (#cast(*const u8, #cast(usize, formatted) + length)).* != 0 {
    length += 1
  }
  output := memory.push_bytes_uninit(arena, length)
  source := #slice(formatted, length)
  for i in 0..length {
    output[i] = source[i]
  }
  return output
}
// Runs the handshake. On a nonblocking socket it may stop with a want; call
// it again once the socket is ready. Want.Nothing means it completed.
pub fn handshake(status: *fail.Status, connection: Connection) Want {
  return provider.handshake(status, connection)
}
pub fn server_handshake(status: *fail.Status, connection: Connection) Want {
  return provider.server_handshake(status, connection)
}
// Reads what is available; count 0 with no want is the end of the stream.
pub fn read(status: *fail.Status, connection: Connection, destination: []u8) Attempt {
  return provider.read(status, connection, destination)
}
pub fn write(status: *fail.Status, connection: Connection, source: []const u8) Attempt {
  return provider.write(status, connection, source)
}
// Sends close_notify. Want.Read means it was sent and the peer's is pending;
// call again to finish the exchange, or close the socket.
// https://docs.openssl.org/3.4/man3/SSL_shutdown/
pub fn shutdown(status: *fail.Status, connection: Connection) Want {
  return provider.shutdown(status, connection)
}
// The provider's text for an error code, in arena.
pub fn error_string(arena: *memory.Arena, code: u64) []u8 {
  mark := memory.arena_mark(arena)
  space := memory.push_bytes_uninit(arena, 256)
  output := provider.error_string(space, code)
  memory.arena_rewind(arena, mark + #len(output))
  return output
}

pub fn client_config_create(status: *fail.Status) Context {
  return provider.context_create_owned(status)
}
pub fn server_config_create(
  arena: *memory.Arena,
  status: *fail.Status,
  certificate: []const u8,
  key: []const u8,
) Context {
  return provider.server_context_create(arena, status, certificate, key)
}
// Frees the configuration and clears the handle; releasing a cleared handle does nothing.
pub fn config_release(context: *Context) {
  value := context.*
  context.* = nil
  provider.context_free_owned(value)
}
pub fn client_connection_create(
  arena: *memory.Arena,
  status: *fail.Status,
  context: Context,
  descriptor: i32,
  hostname: []const u8,
) Connection {
  return provider.connection_create(arena, status, context, descriptor, hostname)
}
pub fn server_connection_create(status: *fail.Status, context: Context, descriptor: i32) Connection {
  return provider.server_connection_create_owned(status, context, descriptor)
}
// Frees the connection state and clears the handle. The socket stays open; close it separately.
pub fn connection_release(connection: *Connection) {
  value := connection.*
  connection.* = nil
  provider.connection_free_owned(value)
}

// Blocking adapters: a want here means the socket was nonblocking, which they
// report as WouldBlock.
fn blocked(status: *fail.Status, operation: []const u8) {
  fail.set(status, fail.make(fail.Kind.WouldBlock, operation, "", "the socket is nonblocking"))
}
fn reader_read(data: rawptr, status: *fail.Status, destination: []u8) usize {
  result := read(status, #cast(*Connection, data).*, destination)
  if result.want != Want.Nothing {
    blocked(status, "read")
  }
  return result.count
}

fn writer_write(data: rawptr, status: *fail.Status, source: []const u8) usize {
  connection := #cast(*Connection, data)
  total: usize = 0
  for total < #len(source) && !status.failed {
    result := write(status, connection.*, source[total..])
    if result.want != Want.Nothing {
      blocked(status, "write")
    } else if result.count == 0 && !status.failed {
      fail.set(status, fail.make(fail.Kind.System, "write", "", "the connection accepted no bytes"))
    }
    total += result.count
  }
  return total
}

// Blocking I/O adapters borrow the Connection slot and its live handle.
// Use read/write directly for nonblocking connections.
pub fn reader(connection: *Connection) io.Reader {
  return io.Reader{ data: connection, read: reader_read }
}

pub fn writer(connection: *Connection) io.Writer {
  return io.Writer{ data: connection, write: writer_write }
}
