use "vendor/openssl/tls" provider
use "std/io" stream
use "std/mem" memory
use "std/errors" errors

pub type Context = provider.Context
pub type Connection = provider.Connection
pub type Certificate = provider.Certificate
pub type ErrorKind = provider.ErrorKind
// Provider diagnostics are not OS errno values. error remains zero; detail and
// the exact unsigned provider_code/provider_status retain provider information.
pub struct ContextResult { value: Context, kind: errors.Kind, error: isize, detail: ErrorKind, provider_code: u64, ok: bool }
pub struct ConnectionResult { value: Connection, kind: errors.Kind, error: isize, detail: ErrorKind, provider_code: u64, ok: bool }
pub struct Result { count: usize, kind: errors.Kind, error: isize, detail: ErrorKind, provider_code: u64, provider_status: i32, ok: bool }
pub struct TextResult { value: []u8, kind: errors.Kind, error: isize, provider_code: u64, ok: bool }
fn portable(detail: ErrorKind) errors.Kind {
  if detail == ErrorKind.None {
    return errors.Kind.None
  }
  if detail == ErrorKind.InvalidArgument {
    return errors.Kind.InvalidInput
  }
  if detail == ErrorKind.WantRead || detail == ErrorKind.WantWrite {
    return errors.Kind.WouldBlock
  }
  if detail == ErrorKind.Verification {
    return errors.Kind.PermissionDenied
  }
  return errors.Kind.System
}
fn result(value: provider.Result) Result {
  return Result{count: value.count, kind: portable(value.error), detail: value.error,
    provider_code: value.provider_code, provider_status: value.provider_status, ok: value.ok}
}

// The provider copies the protocol wire bytes during this call.
pub fn set_alpn_protocols(connection: Connection, protocols: []const u8) Result {
  return result(provider.set_alpn_result(connection, protocols))
}
// Borrows provider connection memory. Invalid after connection_release or a
// renegotiation that replaces the negotiated protocol; copy before either.
pub fn selected_alpn(connection: Connection) []const u8 {
  return provider.selected_alpn(connection)
}
pub fn peer_certificate_owned(connection: Connection) Certificate {
  return provider.peer_certificate_owned(connection)
}
// Frees the certificate and clears the handle; releasing a cleared handle does nothing.
pub fn certificate_release(certificate: *Certificate) {
  value := certificate.*
  certificate.* = nil
  provider.certificate_free_owned(value)
}
// Complete provider-formatted subject copied into arena. The provider allocates
// the complete output when passed a nil buffer; always release it after copying.
// Failure publishes an empty value and consumes no arena bytes. Exhaustion panics.
// https://github.com/openssl/openssl/blob/master/crypto/x509/x509_obj.c
pub fn certificate_subject(arena: *memory.Arena, certificate: Certificate) TextResult {
  if certificate == nil {
    return TextResult{kind: errors.Kind.InvalidInput}
  }
  formatted := provider.subject_text_owned(certificate)
  if !formatted.ok {
    return TextResult{kind: errors.Kind.System, provider_code: formatted.provider_code}
  }
  defer provider.subject_text_free_owned(formatted.value)
  length: usize = 0
  for (#cast(*const u8, #cast(usize, formatted.value) + length)).* != 0 {
    length += 1
  }
  output := memory.push_bytes_uninit(arena, length)
  source := formatted.value[..length]
  for i in 0..length {
    output[i] = source[i]
  }
  return TextResult{value: output, ok: true}
}
pub fn handshake(connection: Connection) Result {
  return result(provider.handshake(connection))
}
pub fn server_handshake(connection: Connection) Result {
  return result(provider.server_handshake(connection))
}
pub fn read(connection: Connection, destination: []u8) Result {
  return result(provider.read(connection, destination))
}
pub fn write(connection: Connection, source: []const u8) Result {
  return result(provider.write(connection, source))
}
// A zero provider status means close_notify was sent but peer shutdown is
// pending. Return WouldBlock/WantRead so callers can resume the exchange.
// https://docs.openssl.org/3.4/man3/SSL_shutdown/
pub fn shutdown(connection: Connection) Result {
  return result(provider.shutdown_result(connection))
}
pub fn error_code(connection: Connection, provider_result: i32) i32 {
  return provider.error_code(connection, provider_result)
}
// The provider's text for an error code, in arena.
pub fn error_string(arena: *memory.Arena, code: u64) []u8 {
  mark := memory.arena_mark(arena)
  space := memory.push_bytes_uninit(arena, 256)
  output := provider.error_string(space, code)
  memory.arena_rewind(arena, mark + #len(output))
  return output
}

pub fn client_config_create() ContextResult {
  value := provider.context_create_owned()
  return ContextResult{value: value.value, kind: portable(value.error), detail: value.error, provider_code: value.provider_code, ok: value.ok}
}
pub fn server_config_create(
  arena: *memory.Arena,
  certificate: []const u8,
  key: []const u8,
) ContextResult {
  value := provider.server_context_create(arena, certificate, key)
  return ContextResult{value: value.value, kind: portable(value.error), detail: value.error, provider_code: value.provider_code, ok: value.ok}
}
// Frees the configuration and clears the handle; releasing a cleared handle does nothing.
pub fn config_release(context: *Context) {
  value := context.*
  context.* = nil
  provider.context_free_owned(value)
}
pub fn client_connection_create(
  arena: *memory.Arena,
  context: Context,
  descriptor: i32,
  hostname: []const u8,
) ConnectionResult {
  value := provider.connection_create(arena, context, descriptor, hostname)
  return ConnectionResult{value: value.value, kind: portable(value.error), detail: value.error, provider_code: value.provider_code, ok: value.ok}
}
pub fn server_connection_create(context: Context, descriptor: i32) ConnectionResult {
  value := provider.server_connection_create_owned(context, descriptor)
  return ConnectionResult{value: value.value, kind: portable(value.error), detail: value.error, provider_code: value.provider_code, ok: value.ok}
}
// Frees the connection state and clears the handle. The socket stays open; close it separately.
pub fn connection_release(connection: *Connection) {
  value := connection.*
  connection.* = nil
  provider.connection_free_owned(value)
}

fn reader_read(data: rawptr, destination: []u8) stream.Result {
  connection := #cast(*Connection, data)
  result := read(connection.*, destination)
  if !result.ok {
    return stream.Result{ kind: result.kind, error: result.error, status: stream.Status.Error }
  }
  status := stream.Status.Complete
  if result.count == 0 {
    status = stream.Status.End
  }
  return stream.Result{ transferred: result.count, status: status }
}

fn writer_write(data: rawptr, source: []const u8) stream.Result {
  connection := #cast(*Connection, data)
  result := write(connection.*, source)
  if !result.ok {
    return stream.Result{ transferred: result.count, kind: result.kind, error: result.error, status: stream.Status.Error }
  }
  return stream.Result{ transferred: result.count, status: stream.Status.Complete }
}

// Blocking I/O adapters borrow the Connection slot and its live handle.
// Use read/write directly for nonblocking WantRead/WantWrite handling.
pub fn reader(connection: *Connection) stream.Reader {
  return stream.Reader{ data: connection, read: &reader_read }
}

pub fn writer(connection: *Connection) stream.Writer {
  return stream.Writer{ data: connection, write: &writer_write }
}
