#target(kernel: linux)


use "std/io" stream

pub const AddressFamilyIpv4: usize = 2
pub const AddressFamilyUnix: usize = 1
pub const AddressFamilyIpv6: usize = 10
pub const SocketStream: usize = 1
pub const SocketDatagram: usize = 2
pub const PollReadable: i16 = 1
pub const PollWritable: i16 = 4
pub const PollError: i16 = 8
pub const PollHangup: i16 = 16
pub const ShutdownRead: usize = 0
pub const ShutdownWrite: usize = 1
pub const ShutdownBoth: usize = 2

pub struct Ipv4Address { bytes: [16]u8 }
pub struct Ipv6Address { bytes: [28]u8 }
pub struct UnixAddress { bytes: [110]u8, length: usize }
// Large enough for every supported sockaddr. `length` makes ownership and ABI size explicit.
pub struct Address { bytes: [128]u8, length: usize }
pub struct PollDescriptor { descriptor: i32, events: i16, returned: i16 }

pub struct Result { value: isize, error: isize, ok: bool }
pub struct Connection { descriptor: isize }
pub struct Listener { descriptor: isize }
pub struct ConnectionResult { connection: Connection, error: isize, ok: bool }
pub struct ListenerResult { listener: Listener, error: isize, ok: bool }
pub fn result_value(outcome: *const Result) isize { return outcome.value }
pub fn connection_result_value(outcome: *const ConnectionResult) Connection { return outcome.connection }
pub fn listener_result_value(outcome: *const ListenerResult) Listener { return outcome.listener }

fn result(value: isize) Result {
  if value < 0 { return Result{ value: value, error: value, ok: false } }
  return Result{ value: value, error: 0, ok: true }
}

pub fn socket(family: usize, kind: usize, protocol: usize) Result {
  return result(#syscall(41, family, kind, protocol))
}

pub fn close(descriptor: isize) Result { return result(#syscall(3, descriptor)) }
pub fn listen(descriptor: isize, backlog: usize) Result { return result(#syscall(50, descriptor, backlog)) }
pub fn shutdown(descriptor: isize, how: usize) Result { return result(#syscall(48, descriptor, how)) }

pub fn ipv4_address(destination: []u8, a: u8, b: u8, c: u8, d: u8, port: u16) []u8 {
  if #len(destination) < 16 { return destination[..0] }
  i: usize = 0
  for i < 16 {
    destination[i] = 0
    i += 1
  }
  destination[0] = 2
  destination[2] = #cast(u8) (port >> 8)
  destination[3] = #cast(u8) port
  destination[4] = a
  destination[5] = b
  destination[6] = c
  destination[7] = d
  return destination[..16]
}

pub fn ipv4(a: u8, b: u8, c: u8, d: u8, port: u16) Ipv4Address {
  address_result: Ipv4Address = Ipv4Address{}
  _ = ipv4_address(address_result.bytes[..], a, b, c, d, port)
  return address_result
}

pub fn ipv6(bytes: [16]u8, port: u16, scope: u32) Ipv6Address {
  value: Ipv6Address = Ipv6Address{}
  value.bytes[0] = 10
  value.bytes[2] = #cast(u8) (port >> 8)
  value.bytes[3] = #cast(u8) port
  i: usize = 0
  for i < 16 { value.bytes[8 + i] = bytes[i]
    i += 1
  }
  value.bytes[24] = #cast(u8) scope
  value.bytes[25] = #cast(u8) (scope >> 8)
  value.bytes[26] = #cast(u8) (scope >> 16)
  value.bytes[27] = #cast(u8) (scope >> 24)
  return value
}

// Linux sockaddr_un. Empty result means an empty/oversized path.
pub fn unix(path: []const u8) UnixAddress {
  value: UnixAddress = UnixAddress{}
  if #len(path) == 0 || #len(path) > 107 { return value }
  value.bytes[0] = 1
  i: usize = 0
  for i < #len(path) { value.bytes[2 + i] = path[i]
    i += 1
  }
  value.length = 3 + #len(path)
  return value
}

pub fn connect_ipv4(descriptor: isize, address: *const Ipv4Address) Result {
  return result(#syscall(42, descriptor, &address.bytes[0], 16))
}

pub fn bind_ipv4(descriptor: isize, address: *const Ipv4Address) Result {
  return result(#syscall(49, descriptor, &address.bytes[0], 16))
}

pub fn connect_ipv6(descriptor: isize, address: *const Ipv6Address) Result { return result(#syscall(42, descriptor, &address.bytes[0], 28)) }
pub fn bind_ipv6(descriptor: isize, address: *const Ipv6Address) Result { return result(#syscall(49, descriptor, &address.bytes[0], 28)) }
pub fn connect_unix(descriptor: isize, address: *const UnixAddress) Result {
  if address.length == 0 { return Result{ value: -1, error: -22, ok: false } }
  return result(#syscall(42, descriptor, &address.bytes[0], address.length))
}
pub fn bind_unix(descriptor: isize, address: *const UnixAddress) Result {
  if address.length == 0 { return Result{ value: -1, error: -22, ok: false } }
  return result(#syscall(49, descriptor, &address.bytes[0], address.length))
}

pub fn connect(descriptor: isize, address: []const u8) Result {
  if #len(address) == 0 { return Result{ value: -1, error: -22, ok: false } }
  return result(#syscall(42, descriptor, &address[0], #len(address)))
}

pub fn bind(descriptor: isize, address: []const u8) Result {
  if #len(address) == 0 { return Result{ value: -1, error: -22, ok: false } }
  return result(#syscall(49, descriptor, &address[0], #len(address)))
}

pub fn accept(descriptor: isize) Result { return result(#syscall(43, descriptor, 0, 0)) }

pub fn tcp_listen_ipv4(address: *const Ipv4Address, backlog: usize) ListenerResult {
  opened := socket(AddressFamilyIpv4, SocketStream, 0)
  if !opened.ok { return ListenerResult{ error: opened.error, ok: false } }
  descriptor := result_value(&opened)
  reused := reuse_address(descriptor, true)
  if !reused.ok { _ = close(descriptor) return ListenerResult{ error: reused.error, ok: false } }
  bound := bind_ipv4(descriptor, address)
  if !bound.ok { _ = close(descriptor) return ListenerResult{ error: bound.error, ok: false } }
  listening := listen(descriptor, backlog)
  if !listening.ok { _ = close(descriptor) return ListenerResult{ error: listening.error, ok: false } }
  return ListenerResult{ listener: Listener{ descriptor: descriptor }, ok: true }
}

pub fn tcp_connect_ipv4(address: *const Ipv4Address) ConnectionResult {
  opened := socket(AddressFamilyIpv4, SocketStream, 0)
  if !opened.ok { return ConnectionResult{ error: opened.error, ok: false } }
  descriptor := result_value(&opened)
  connected := connect_ipv4(descriptor, address)
  if !connected.ok { _ = close(descriptor) return ConnectionResult{ error: connected.error, ok: false } }
  return ConnectionResult{ connection: Connection{ descriptor: descriptor }, ok: true }
}

pub fn listener_accept(listener: *Listener) ConnectionResult {
  if listener.descriptor < 0 { return ConnectionResult{ error: -9, ok: false } }
  accepted := accept(listener.descriptor)
  if !accepted.ok { return ConnectionResult{ error: accepted.error, ok: false } }
  return ConnectionResult{ connection: Connection{ descriptor: result_value(&accepted) }, ok: true }
}

pub fn listener_close(listener: *Listener) Result {
  if listener.descriptor < 0 { return Result{ error: -9, ok: false } }
  closed := close(listener.descriptor)
  if closed.ok { listener.descriptor = -1 }
  return closed
}

pub fn connection_close(connection: *Connection) Result {
  if connection.descriptor < 0 { return Result{ error: -9, ok: false } }
  closed := close(connection.descriptor)
  if closed.ok { connection.descriptor = -1 }
  return closed
}

pub fn connection_read(connection: *Connection, destination: []u8) Result {
  if connection.descriptor < 0 { return Result{ error: -9, ok: false } }
  return receive(connection.descriptor, destination, 0)
}

pub fn connection_write(connection: *Connection, source: []const u8) Result {
  if connection.descriptor < 0 { return Result{ error: -9, ok: false } }
  total: usize = 0
  for total < #len(source) {
    sent := send(connection.descriptor, source[total..], 0)
    if !sent.ok { return Result{ value: #cast(isize) total, error: sent.error, ok: false } }
    if sent.value == 0 { return Result{ value: #cast(isize) total, error: -32, ok: false } }
    total += #cast(usize) sent.value
  }
  return Result{ value: #cast(isize) total, ok: true }
}

fn connection_reader_read(data: rawptr, destination: []u8) stream.Result {
  outcome := connection_read(#cast(*Connection) data, destination)
  if !outcome.ok { return stream.Result{ error: outcome.error, status: stream.Status.Error } }
  status := stream.Status.Complete
  if outcome.value == 0 { status = stream.Status.End }
  return stream.Result{ transferred: #cast(usize) outcome.value, status: status }
}

fn connection_writer_write(data: rawptr, source: []const u8) stream.Result {
  outcome := connection_write(#cast(*Connection) data, source)
  if !outcome.ok {
    transferred: usize = 0
    if outcome.value > 0 { transferred = #cast(usize) outcome.value }
    return stream.Result{ transferred: transferred, error: outcome.error, status: stream.Status.Error }
  }
  return stream.Result{ transferred: #cast(usize) outcome.value, status: stream.Status.Complete }
}

pub fn connection_reader(connection: *Connection) stream.Reader {
  return stream.Reader{ data: #cast(rawptr) connection, read: &connection_reader_read }
}

pub fn connection_writer(connection: *Connection) stream.Writer {
  return stream.Writer{ data: #cast(rawptr) connection, write: &connection_writer_write }
}

pub fn accept_address(descriptor: isize, address: *Address) Result {
  length: u32 = 128
  outcome := result(#syscall(43, descriptor, &address.bytes[0], &length))
  if outcome.ok { address.length = #cast(usize) length }
  return outcome
}

pub fn local_address(descriptor: isize, address: *Address) Result {
  length: u32 = 128
  outcome := result(#syscall(51, descriptor, &address.bytes[0], &length))
  if outcome.ok { address.length = #cast(usize) length }
  return outcome
}

pub fn peer_address(descriptor: isize, address: *Address) Result {
  length: u32 = 128
  outcome := result(#syscall(52, descriptor, &address.bytes[0], &length))
  if outcome.ok { address.length = #cast(usize) length }
  return outcome
}

pub fn send(descriptor: isize, bytes: []const u8, flags: usize) Result {
  if #len(bytes) == 0 { return Result{ value: 0, error: 0, ok: true } }
  value := #syscall(44, descriptor, &bytes[0], #len(bytes), flags, 0, 0)
  for value == -4 { value = #syscall(44, descriptor, &bytes[0], #len(bytes), flags, 0, 0) }
  return result(value)
}

pub fn receive(descriptor: isize, bytes: []u8, flags: usize) Result {
  if #len(bytes) == 0 { return Result{ value: 0, error: 0, ok: true } }
  value := #syscall(45, descriptor, &bytes[0], #len(bytes), flags, 0, 0)
  for value == -4 { value = #syscall(45, descriptor, &bytes[0], #len(bytes), flags, 0, 0) }
  return result(value)
}

pub fn send_to(descriptor: isize, bytes: []const u8, flags: usize, address: []const u8) Result {
  if #len(bytes) == 0 { return Result{ value: 0, error: 0, ok: true } }
  if #len(address) == 0 { return Result{ value: -1, error: -22, ok: false } }
  value := #syscall(44, descriptor, &bytes[0], #len(bytes), flags, &address[0], #len(address))
  for value == -4 { value = #syscall(44, descriptor, &bytes[0], #len(bytes), flags, &address[0], #len(address)) }
  return result(value)
}

pub fn receive_from(descriptor: isize, bytes: []u8, flags: usize, address: []u8, address_length: *u32) Result {
  if #len(bytes) == 0 { return Result{ value: 0, error: 0, ok: true } }
  address_raw: *u8 = nil
  if #len(address) > 0 {
    address_raw = &address[0]
    address_length.* = #cast(u32) #len(address)
  }
  value := #syscall(45, descriptor, &bytes[0], #len(bytes), flags, address_raw, address_length)
  for value == -4 { value = #syscall(45, descriptor, &bytes[0], #len(bytes), flags, address_raw, address_length) }
  return result(value)
}

pub fn reuse_address(descriptor: isize, enabled: bool) Result {
  value: i32 = 0
  if enabled { value = 1 }
  return result(#syscall(54, descriptor, 1, 2, &value, #sizeof(i32)))
}

// Completes a nonblocking connect by reading SO_ERROR. Zero means connected.
pub fn socket_error(descriptor: isize) Result {
  error: i32 = 0 length: u32 = #cast(u32) #sizeof(i32)
  queried := #syscall(55, descriptor, 1, 4, &error, &length)
  if queried < 0 { return result(queried) }
  if error != 0 { return result(0 - #cast(isize) error) }
  return result(0)
}

pub fn nonblocking(descriptor: isize, enabled: bool) Result {
  flags := #syscall(72, descriptor, 3, 0)
  if flags < 0 { return result(flags) }
  if enabled { flags = flags | 2048 }
  else { flags = flags & ~2048 }
  return result(#syscall(72, descriptor, 4, flags))
}

struct TimeValue { seconds: isize, microseconds: isize }

pub fn receive_timeout(descriptor: isize, milliseconds: usize) Result {
  timeout := TimeValue{ seconds: #cast(isize) (milliseconds / 1000), microseconds: #cast(isize) ((milliseconds % 1000) * 1000) }
  return result(#syscall(54, descriptor, 1, 20, &timeout, #sizeof(TimeValue)))
}

pub fn send_timeout(descriptor: isize, milliseconds: usize) Result {
  timeout := TimeValue{ seconds: #cast(isize) (milliseconds / 1000), microseconds: #cast(isize) ((milliseconds % 1000) * 1000) }
  return result(#syscall(54, descriptor, 1, 21, &timeout, #sizeof(TimeValue)))
}

pub fn would_block(outcome: *const Result) bool { return !outcome.ok && (outcome.error == -11 || outcome.error == -115) }


pub fn poll(descriptors: []PollDescriptor, timeout_milliseconds: i32) Result {
  value := poll_native(descriptors, timeout_milliseconds)
  for value == -4 { value = poll_native(descriptors, timeout_milliseconds) }
  return result(value)
}

pub fn wait(descriptor: isize, events: i16, timeout_milliseconds: i32) Result {
  item := PollDescriptor{ descriptor: #cast(i32) descriptor, events: events, returned: 0 }
  outcome := poll((&item)[..1], timeout_milliseconds)
  if !outcome.ok || outcome.value == 0 { return outcome }
  return Result{ value: #cast(isize) item.returned, error: 0, ok: true }
}

pub fn poll_has(item: *const PollDescriptor, events: i16) bool { return (item.returned & events) != 0 }


// Linux epoll. Target-specific Event storage follows the kernel UAPI layout.
pub const EventReadable: u32 = 1
pub const EventWritable: u32 = 4
pub const EventError: u32 = 8
pub const EventHangup: u32 = 16
pub const EventEdgeTriggered: u32 = 2147483648
pub const EventAdd: usize = 1
pub const EventRemove: usize = 2
pub const EventModify: usize = 3


fn event_put_u32(bytes: []u8, value: u32) {
  bytes[0] = #cast(u8) value
  bytes[1] = #cast(u8) (value >> 8)
  bytes[2] = #cast(u8) (value >> 16)
  bytes[3] = #cast(u8) (value >> 24)
}

fn event_put_u64(bytes: []u8, value: u64) {
  event_put_u32(bytes[..4], #cast(u32) value)
  event_put_u32(bytes[4..8], #cast(u32) (value >> 32))
}

pub fn event(events: u32, data: u64) Event {
  value := Event{}
  event_put_u32(value.bytes[..4], events)
  event_put_u64(value.bytes[EventDataOffset..EventDataOffset + 8], data)
  return value
}

pub fn event_events(value: *const Event) u32 {
  a: u32 = #cast(u32) value.bytes[0]
  b: u32 = #cast(u32) value.bytes[1]
  c: u32 = #cast(u32) value.bytes[2]
  d: u32 = #cast(u32) value.bytes[3]
  return a | (b << 8) | (c << 16) | (d << 24)
}

fn event_u32_at(value: *const Event, offset: usize) u32 {
  a: u32 = #cast(u32) value.bytes[offset]
  b: u32 = #cast(u32) value.bytes[offset + 1]
  c: u32 = #cast(u32) value.bytes[offset + 2]
  d: u32 = #cast(u32) value.bytes[offset + 3]
  return a | (b << 8) | (c << 16) | (d << 24)
}

pub fn event_data(value: *const Event) u64 {
  low: u64 = #cast(u64) event_u32_at(value, EventDataOffset)
  high: u64 = #cast(u64) event_u32_at(value, EventDataOffset + 4)
  return low | (high << 32)
}

pub fn event_queue() Result { return result(#syscall(291, 0)) }

pub fn event_control(queue: isize, operation: usize, descriptor: isize, value: *Event) Result {
  return result(#syscall(233, queue, operation, descriptor, value))
}

// Registration helpers keep epoll's operation numbers and remove-event pointer
// convention out of application code. `data` is returned unchanged by event_wait.
pub fn event_add(queue: isize, descriptor: isize, events: u32, data: u64) Result {
  value := event(events, data)
  return event_control(queue, EventAdd, descriptor, &value)
}

pub fn event_modify(queue: isize, descriptor: isize, events: u32, data: u64) Result {
  value := event(events, data)
  return event_control(queue, EventModify, descriptor, &value)
}

pub fn event_remove(queue: isize, descriptor: isize) Result {
  // Linux ignores this argument for EPOLL_CTL_DEL, but using valid storage keeps
  // the language-level pointer contract explicit.
  value := Event{}
  return event_control(queue, EventRemove, descriptor, &value)
}

pub fn event_wait(queue: isize, events: []Event, timeout_milliseconds: i32) Result {
  if #len(events) == 0 { return Result{ value: -1, error: -22, ok: false } }
  value := #syscall(232, queue, &events[0], #len(events), timeout_milliseconds)
  for value == -4 { value = #syscall(232, queue, &events[0], #len(events), timeout_milliseconds) }
  return result(value)
}
