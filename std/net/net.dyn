#target(pointer_bits: 64)


use "std/io" io
use "std/io" stream
use "std/time" clock

pub const AddressFamilyIpv4: usize = 2
pub const AddressFamilyUnix: usize = 1
pub const SocketStream: usize = 1
pub const SocketDatagram: usize = 2
pub const PollReadable: i16 = 1
pub const PollWritable: i16 = 4
pub const PollError: i16 = 8
pub const PollHangup: i16 = 16
pub const ShutdownRead: usize = 0
pub const ShutdownWrite: usize = 1
pub const ShutdownBoth: usize = 2

pub struct Ipv4Address { bytes: [16]u8 }
pub struct Ipv6Address { bytes: [28]u8 }
pub struct UnixAddress { bytes: [110]u8, length: usize }
// Large enough for every supported sockaddr. `length` makes ownership and ABI size explicit.
pub struct Address { bytes: [128]u8, length: usize }

// `error` keeps the native code; `kind` is its portable category.
pub type Result = io.Result(isize)
// `active` makes zeroed storage a closed handle; descriptor 0 is a valid descriptor.
pub struct Connection { descriptor: isize, active: bool }
pub struct Listener { descriptor: isize, active: bool }

// Wraps an open socket descriptor; the result owns it and must be closed once.
pub fn connection_from_descriptor(descriptor: isize) Connection {
  return Connection{ descriptor: descriptor, active: descriptor >= 0 }
}
pub fn listener_from_descriptor(descriptor: isize) Listener {
  return Listener{ descriptor: descriptor, active: descriptor >= 0 }
}
pub type ConnectionResult = io.Result(Connection)
pub type ListenerResult = io.Result(Listener)
pub fn result_value(outcome: *const Result) isize {
  return outcome.value
}
pub fn connection_result_value(outcome: *const ConnectionResult) Connection {
  return outcome.value
}
pub fn listener_result_value(outcome: *const ListenerResult) Listener {
  return outcome.value
}

// Portable category for a native socket error code returned by this module.
pub fn error_kind(code: isize) io.Kind {
  return native_kind(code)
}

fn result(value: isize) Result {
  if value < 0 {
    return Result{ value: value, failure: io.Failure{ kind: native_kind(value), native: value } }
  }
  return Result{ value: value }
}

pub fn socket(family: usize, kind: usize, protocol: usize) Result {
  return result(native_socket(family, kind, protocol))
}

pub fn close(descriptor: isize) {
  _ = result(native_close(descriptor))
}
pub fn listen(descriptor: isize, backlog: usize) Result {
  return result(native_listen(descriptor, backlog))
}
pub fn shutdown(descriptor: isize, how: usize) Result {
  return result(native_shutdown(descriptor, how))
}

pub fn ipv4_address(destination: []u8, a: u8, b: u8, c: u8, d: u8, port: u16) []u8 {
  if #len(destination) < 16 {
    return destination[..0]
  }
  for i in 0..16 {
    destination[i] = 0
  }
  address_family(destination, 16, 2)
  destination[2] = #cast(u8, (port >> 8))
  destination[3] = #cast(u8, port)
  destination[4] = a
  destination[5] = b
  destination[6] = c
  destination[7] = d
  return destination[..16]
}

pub fn ipv4(a: u8, b: u8, c: u8, d: u8, port: u16) Ipv4Address {
  address_result: Ipv4Address = Ipv4Address{}
  _ = ipv4_address(address_result.bytes[..], a, b, c, d, port)
  return address_result
}

pub fn ipv6(bytes: [16]u8, port: u16, scope: u32) Ipv6Address {
  value: Ipv6Address = Ipv6Address{}
  address_family(value.bytes[..], 28, AddressFamilyIpv6)
  value.bytes[2] = #cast(u8, (port >> 8))
  value.bytes[3] = #cast(u8, port)
  for i in 0..16 {
    value.bytes[8 + i] = bytes[i]
  }
  value.bytes[24] = #cast(u8, scope)
  value.bytes[25] = #cast(u8, (scope >> 8))
  value.bytes[26] = #cast(u8, (scope >> 16))
  value.bytes[27] = #cast(u8, (scope >> 24))
  return value
}

// Native sockaddr_un. Empty result means an empty/oversized path.
pub fn unix(path: []const u8) UnixAddress {
  value: UnixAddress = UnixAddress{}
  if #len(path) == 0 || #len(path) > UnixPathLimit {
    return value
  }
  for i in 0..#len(path) {
    if path[i] == 0 {
      return value
    }
  }
  address_family(value.bytes[..], 3 + #len(path), 1)
  for i in 0..#len(path) {
    value.bytes[2 + i] = path[i]
  }
  value.length = 3 + #len(path)
  return value
}

pub fn connect_ipv4(descriptor: isize, address: *const Ipv4Address) Result {
  return result(native_connect(descriptor, &address.bytes[0], 16))
}

pub fn bind_ipv4(descriptor: isize, address: *const Ipv4Address) Result {
  return result(native_bind(descriptor, &address.bytes[0], 16))
}

pub fn connect_ipv6(descriptor: isize, address: *const Ipv6Address) Result {
  return result(native_connect(descriptor, &address.bytes[0], 28))
}
pub fn bind_ipv6(descriptor: isize, address: *const Ipv6Address) Result {
  return result(native_bind(descriptor, &address.bytes[0], 28))
}
pub fn connect_unix(descriptor: isize, address: *const UnixAddress) Result {
  if address.length == 0 || address.length > #len(address.bytes) {
    return Result{ value: -1, failure: io.Failure{ kind: io.Kind.InvalidInput, native: -22 } }
  }
  return result(native_connect(descriptor, &address.bytes[0], address.length))
}
pub fn bind_unix(descriptor: isize, address: *const UnixAddress) Result {
  if address.length == 0 || address.length > #len(address.bytes) {
    return Result{ value: -1, failure: io.Failure{ kind: io.Kind.InvalidInput, native: -22 } }
  }
  return result(native_bind(descriptor, &address.bytes[0], address.length))
}

pub fn connect(descriptor: isize, address: []const u8) Result {
  if #len(address) == 0 {
    return Result{ value: -1, failure: io.Failure{ kind: io.Kind.InvalidInput, native: -22 } }
  }
  return result(native_connect(descriptor, &address[0], #len(address)))
}

pub fn bind(descriptor: isize, address: []const u8) Result {
  if #len(address) == 0 {
    return Result{ value: -1, failure: io.Failure{ kind: io.Kind.InvalidInput, native: -22 } }
  }
  return result(native_bind(descriptor, &address[0], #len(address)))
}

pub fn accept(descriptor: isize) Result {
  return result(native_accept(descriptor, nil, nil))
}

fn stream_listen(family: usize, address: []const u8, backlog: usize, shared: bool) ListenerResult {
  opened := socket(family, SocketStream, 0)
  if io.failed(opened.failure) {
    return ListenerResult{ value: Listener{}, failure: io.Failure{ kind: opened.failure.kind, native: opened.failure.native } }
  }
  descriptor := result_value(&opened)
  // Unix path ownership controls rebinding. SO_REUSEADDR is an Internet
  // option and is not supported by every AF_UNIX implementation.
  if family != AddressFamilyUnix {
    reused := reuse_address(descriptor, true)
    if io.failed(reused.failure) {
      close(descriptor)
      return ListenerResult{ value: Listener{}, failure: io.Failure{ kind: reused.failure.kind, native: reused.failure.native } }
    }
  }
  if shared {
    balanced := reuse_port(descriptor, true)
    if io.failed(balanced.failure) {
      close(descriptor)
      return ListenerResult{ value: Listener{}, failure: io.Failure{ kind: balanced.failure.kind, native: balanced.failure.native } }
    }
  }
  bound := bind(descriptor, address)
  if io.failed(bound.failure) {
    close(descriptor)
    return ListenerResult{ value: Listener{}, failure: io.Failure{ kind: bound.failure.kind, native: bound.failure.native } }
  }
  listening := listen(descriptor, backlog)
  if io.failed(listening.failure) {
    close(descriptor)
    return ListenerResult{ value: Listener{}, failure: io.Failure{ kind: listening.failure.kind, native: listening.failure.native } }
  }
  return ListenerResult{ value: listener_from_descriptor(descriptor) }
}

fn stream_connect(family: usize, address: []const u8) ConnectionResult {
  opened := socket(family, SocketStream, 0)
  if io.failed(opened.failure) {
    return ConnectionResult{ value: Connection{}, failure: io.Failure{ kind: opened.failure.kind, native: opened.failure.native } }
  }
  descriptor := result_value(&opened)
  connected := connect(descriptor, address)
  if io.failed(connected.failure) {
    close(descriptor)
    return ConnectionResult{ value: Connection{}, failure: io.Failure{ kind: connected.failure.kind, native: connected.failure.native } }
  }
  return ConnectionResult{ value: connection_from_descriptor(descriptor) }
}

pub fn tcp_listen_ipv4(address: *const Ipv4Address, backlog: usize) ListenerResult {
  return stream_listen(AddressFamilyIpv4, address.bytes[..], backlog, false)
}
// Like tcp_listen_ipv4 with SO_REUSEPORT set before bind. Several listeners on
// one address then share incoming connections, balanced by the kernel. Linux
// only: elsewhere the result fails with Unsupported.
pub fn tcp_listen_ipv4_shared(address: *const Ipv4Address, backlog: usize) ListenerResult {
  return stream_listen(AddressFamilyIpv4, address.bytes[..], backlog, true)
}
pub fn tcp_connect_ipv4(address: *const Ipv4Address) ConnectionResult {
  return stream_connect(AddressFamilyIpv4, address.bytes[..])
}
pub fn tcp_listen_ipv6(address: *const Ipv6Address, backlog: usize) ListenerResult {
  return stream_listen(AddressFamilyIpv6, address.bytes[..], backlog, false)
}
pub fn tcp_connect_ipv6(address: *const Ipv6Address) ConnectionResult {
  return stream_connect(AddressFamilyIpv6, address.bytes[..])
}
// The caller removes the filesystem socket path after closing the listener.
pub fn unix_listen(address: *const UnixAddress, backlog: usize) ListenerResult {
  if address.length == 0 || address.length > #len(address.bytes) {
    return ListenerResult{ failure: io.Failure{ kind: io.Kind.InvalidInput, native: -22 } }
  }
  return stream_listen(AddressFamilyUnix, address.bytes[..address.length], backlog, false)
}
pub fn unix_connect(address: *const UnixAddress) ConnectionResult {
  if address.length == 0 || address.length > #len(address.bytes) {
    return ConnectionResult{ failure: io.Failure{ kind: io.Kind.InvalidInput, native: -22 } }
  }
  return stream_connect(AddressFamilyUnix, address.bytes[..address.length])
}

// IPv4 multicast membership uses network-order octets for both addresses.
// An all-zero interface selects the system default interface.
pub fn multicast_join_ipv4(descriptor: isize, group: [4]u8, interface: [4]u8) Result {
  return multicast_membership(descriptor, group, interface, MulticastJoinOption)
}
pub fn multicast_leave_ipv4(descriptor: isize, group: [4]u8, interface: [4]u8) Result {
  return multicast_membership(descriptor, group, interface, MulticastLeaveOption)
}
fn multicast_membership(descriptor: isize, group: [4]u8, interface: [4]u8, option: usize) Result {
  if group[0] < 224 || group[0] > 239 {
    return Result{ failure: io.Failure{ kind: io.Kind.InvalidInput, native: -22 } }
  }
  request: [8]u8 = []
  for i in 0..4 {
    request[i] = group[i]
    request[4 + i] = interface[i]
  }
  return result(native_set_option(descriptor, 0, option, &request[0], 8))
}
pub fn multicast_interface_ipv4(descriptor: isize, interface: [4]u8) Result {
  return result(native_set_option(descriptor, 0, MulticastInterfaceOption, &interface[0], 4))
}
pub fn multicast_ttl_ipv4(descriptor: isize, ttl: u8) Result {
  return result(native_multicast_byte(descriptor, MulticastTtlOption, ttl))
}
// POSIX controls outgoing loopback; Windows controls receipt on this socket.
pub fn multicast_loop_ipv4(descriptor: isize, enabled: bool) Result {
  value: u8 = 0
  if enabled {
    value = 1
  }
  return result(native_multicast_byte(descriptor, MulticastLoopOption, value))
}

pub fn listener_accept(listener: *Listener) ConnectionResult {
  if !listener.active {
    return ConnectionResult{ value: Connection{}, failure: io.linux_failure(-9) }
  }
  accepted := accept(listener.descriptor)
  if io.failed(accepted.failure) {
    return ConnectionResult{ value: Connection{}, failure: io.Failure{ kind: accepted.failure.kind, native: accepted.failure.native } }
  }
  return ConnectionResult{ value: connection_from_descriptor(result_value(&accepted)) }
}

// Moves the listener out, leaving the source closed so only the result owns it.
pub fn listener_take(listener: *Listener) Listener {
  result := listener.*
  listener.* = Listener{}
  return result
}

// Moves the connection out, leaving the source closed so only the result owns it.
pub fn connection_take(connection: *Connection) Connection {
  result := connection.*
  connection.* = Connection{}
  return result
}

pub fn listener_close(listener: *Listener) {
  if !listener.active {
    return
  }
  descriptor := listener.descriptor
  // Never retry close: after a failure the descriptor may already be reused.
  listener.* = Listener{}
  close(descriptor)
}

pub fn connection_close(connection: *Connection) {
  if !connection.active {
    return
  }
  descriptor := connection.descriptor
  // Never retry close: after a failure the descriptor may already be reused.
  connection.* = Connection{}
  close(descriptor)
}

pub fn connection_read(connection: *Connection, destination: []u8) Result {
  if !connection.active {
    return Result{ failure: io.Failure{ kind: io.Kind.InvalidState, native: -9 } }
  }
  return receive(connection.descriptor, destination, 0)
}

pub fn connection_write(connection: *Connection, source: []const u8) Result {
  if !connection.active {
    return Result{ failure: io.Failure{ kind: io.Kind.InvalidState, native: -9 } }
  }
  total: usize = 0
  for total < #len(source) {
    sent := send(connection.descriptor, source[total..], 0)
    if io.failed(sent.failure) {
      return Result{ value: #cast(isize, total), failure: io.Failure{ kind: sent.failure.kind, native: sent.failure.native } }
    }
    if sent.value == 0 {
      return Result{ value: #cast(isize, total), failure: io.Failure{ kind: io.Kind.InvalidState, native: -32 } }
    }
    total += #cast(usize, sent.value)
  }
  return Result{ value: #cast(isize, total) }
}

fn connection_reader_read(data: rawptr, destination: []u8) stream.Transfer {
  outcome := connection_read(#cast(*Connection, data), destination)
  if io.failed(outcome.failure) {
    return stream.Transfer{ error: outcome.failure.native, status: stream.Status.Error }
  }
  status := stream.Status.Complete
  if outcome.value == 0 {
    status = stream.Status.End
  }
  return stream.Transfer{ transferred: #cast(usize, outcome.value), status: status }
}

fn connection_writer_write(data: rawptr, source: []const u8) stream.Transfer {
  outcome := connection_write(#cast(*Connection, data), source)
  if io.failed(outcome.failure) {
    transferred: usize = 0
    if outcome.value > 0 {
      transferred = #cast(usize, outcome.value)
    }
    return stream.Transfer{ transferred: transferred, error: outcome.failure.native, status: stream.Status.Error }
  }
  return stream.Transfer{ transferred: #cast(usize, outcome.value), status: stream.Status.Complete }
}

pub fn connection_reader(connection: *Connection) stream.Reader {
  return stream.Reader{ data: connection, read: connection_reader_read }
}

pub fn connection_writer(connection: *Connection) stream.Writer {
  return stream.Writer{ data: connection, write: connection_writer_write }
}

pub fn accept_address(descriptor: isize, address: *Address) Result {
  length: u32 = 128
  outcome := result(native_accept(descriptor, &address.bytes[0], &length))
  if !io.failed(outcome.failure) {
    address.length = length
  }
  return outcome
}

pub fn local_address(descriptor: isize, address: *Address) Result {
  length: u32 = 128
  outcome := result(native_local(descriptor, &address.bytes[0], &length))
  if !io.failed(outcome.failure) {
    address.length = length
  }
  return outcome
}

pub fn peer_address(descriptor: isize, address: *Address) Result {
  length: u32 = 128
  outcome := result(native_peer(descriptor, &address.bytes[0], &length))
  if !io.failed(outcome.failure) {
    address.length = length
  }
  return outcome
}

pub fn send(descriptor: isize, bytes: []const u8, flags: usize) Result {
  if #len(bytes) == 0 {
    return Result{ value: 0 }
  }
  // MSG_NOSIGNAL keeps a disconnected peer in the Result error channel.
  flags = flags | NoSignalFlag
  value := native_send(descriptor, &bytes[0], #len(bytes), flags, nil, 0)
  for native_interrupted(value) {
    value = native_send(descriptor, &bytes[0], #len(bytes), flags, nil, 0)
  }
  return result(value)
}

pub fn receive(descriptor: isize, bytes: []u8, flags: usize) Result {
  if #len(bytes) == 0 {
    return Result{ value: 0 }
  }
  value := native_receive(descriptor, &bytes[0], #len(bytes), flags, nil, nil)
  for native_interrupted(value) {
    value = native_receive(descriptor, &bytes[0], #len(bytes), flags, nil, nil)
  }
  return result(value)
}

pub fn send_to(descriptor: isize, bytes: []const u8, flags: usize, address: []const u8) Result {
  if #len(address) == 0 {
    return Result{ value: -1, failure: io.Failure{ kind: io.Kind.InvalidInput, native: -22 } }
  }
  // Empty UDP payloads are packets too; the kernel accepts a null buffer.
  data: *const u8 = nil
  if #len(bytes) > 0 {
    data = &bytes[0]
  }
  // This entry point can also send through a connected stream socket.
  flags = flags | NoSignalFlag
  value := native_send(descriptor, data, #len(bytes), flags, &address[0], #len(address))
  for native_interrupted(value) {
    value = native_send(descriptor, data, #len(bytes), flags, &address[0], #len(address))
  }
  return result(value)
}

pub fn receive_from(descriptor: isize, bytes: []u8, flags: usize, address: []u8, address_length: *u32) Result {
  if #len(bytes) == 0 {
    return Result{ value: 0 }
  }
  address_raw: *u8 = nil
  if #len(address) > 0 {
    address_raw = &address[0]
    address_length.* = #cast(u32, #len(address))
  }
  value := native_receive(descriptor, &bytes[0], #len(bytes), flags, address_raw, address_length)
  for native_interrupted(value) {
    value = native_receive(descriptor, &bytes[0], #len(bytes), flags, address_raw, address_length)
  }
  return result(value)
}

pub fn reuse_address(descriptor: isize, enabled: bool) Result {
  value: i32 = 0
  if enabled {
    value = 1
  }
  return result(native_set_option(descriptor, SocketLevel, ReuseOption, &value, #sizeof(i32)))
}

// TCP_NODELAY: send small segments at once instead of waiting for the peer's
// ACK. Request/response servers want this; bulk senders usually do not.
pub fn no_delay(descriptor: isize, enabled: bool) Result {
  value: i32 = 0
  if enabled {
    value = 1
  }
  return result(native_set_option(descriptor, TcpLevel, NoDelayOption, &value, #sizeof(i32)))
}

// SO_REUSEPORT with kernel load balancing. Unsupported where the platform has
// only the non-balancing variant (macOS) or none (Windows).
pub fn reuse_port(descriptor: isize, enabled: bool) Result {
  if ReusePortOption == 0 {
    return Result{ value: -95, failure: io.Failure{ kind: io.Kind.Unsupported, native: -95 } }
  }
  value: i32 = 0
  if enabled {
    value = 1
  }
  return result(native_set_option(descriptor, SocketLevel, ReusePortOption, &value, #sizeof(i32)))
}

// Completes a nonblocking connect by reading SO_ERROR. Zero means connected.
pub fn socket_error(descriptor: isize) Result {
  error: i32 = 0
  length: u32 = #cast(u32, #sizeof(i32))
  queried := native_get_option(descriptor, SocketLevel, ErrorOption, &error, &length)
  if queried < 0 {
    return result(queried)
  }
  if error != 0 {
    return result(0 - #cast(isize, error))
  }
  return result(0)
}

pub fn nonblocking(descriptor: isize, enabled: bool) Result {
  return result(native_nonblocking(descriptor, enabled))
}
pub fn receive_timeout(descriptor: isize, milliseconds: usize) Result {
  return result(native_timeout(descriptor, milliseconds, false))
}
pub fn send_timeout(descriptor: isize, milliseconds: usize) Result {
  return result(native_timeout(descriptor, milliseconds, true))
}

pub fn would_block(outcome: *const Result) bool {
  return io.failed(outcome.failure) && native_would_block(outcome.failure.native)
}


// Called only after EINTR for finite waits. Round remaining nanoseconds up so
// converting back to a millisecond timeout cannot expire the deadline early.
fn interrupted_timeout(start: clock.Instant, milliseconds: i32) Result {
  now := clock.monotonic_now()
  if io.failed(now.failure) {
    return Result{ value: now.failure.native, failure: io.Failure{ kind: now.failure.kind, native: now.failure.native } }
  }
  elapsed := clock.elapsed(start, now.value)
  if io.failed(elapsed.failure) || elapsed.value < 0 {
    return result(-75)
  }
  duration := #cast(i64, milliseconds) * clock.Millisecond
  if elapsed.value >= duration {
    return result(0)
  }
  return result(#cast(isize, ((duration - elapsed.value + clock.Millisecond - 1) / clock.Millisecond)))
}

pub fn poll(descriptors: []PollDescriptor, timeout_milliseconds: i32) Result {
  start := clock.ClockResult{}
  if timeout_milliseconds > 0 {
    start = clock.monotonic_now()
    if io.failed(start.failure) {
      return Result{ value: start.failure.native, failure: io.Failure{ kind: start.failure.kind, native: start.failure.native } }
    }
  }
  remaining := timeout_milliseconds
  value := poll_native(descriptors, remaining)
  for native_interrupted(value) {
    if timeout_milliseconds > 0 {
      retry := interrupted_timeout(start.value, timeout_milliseconds)
      if io.failed(retry.failure) {
        return retry
      }
      if retry.value == 0 {
        for i in 0..#len(descriptors) {
          descriptors[i].returned = 0
        }
        return result(0)
      }
      remaining = #cast(i32, retry.value)
    }
    value = poll_native(descriptors, remaining)
  }
  return result(value)
}

pub fn wait(descriptor: isize, events: i16, timeout_milliseconds: i32) Result {
  item := PollDescriptor{ descriptor: #cast(Descriptor, descriptor), events: events, returned: 0 }
  outcome := poll(#slice(&item, 1), timeout_milliseconds)
  if io.failed(outcome.failure) || outcome.value == 0 {
    return outcome
  }
  return Result{ value: item.returned }
}

pub fn poll_has(item: *const PollDescriptor, events: i16) bool {
  return (item.returned & events) != 0
}


