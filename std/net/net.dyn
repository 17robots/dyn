#target(pointer_bits: 64)


use io "std/io"
use clock "std/time"

pub const AddressFamilyIpv4: usize = 2
pub const AddressFamilyUnix: usize = 1
pub const SocketStream: usize = 1
pub const SocketDatagram: usize = 2
pub const PollReadable: i16 = 1
pub const PollWritable: i16 = 4
pub const PollError: i16 = 8
pub const PollHangup: i16 = 16
pub const ShutdownRead: usize = 0
pub const ShutdownWrite: usize = 1
pub const ShutdownBoth: usize = 2

pub struct Ipv4Address { bytes: [16]u8 }
pub struct Ipv6Address { bytes: [28]u8 }
pub struct UnixAddress { bytes: [110]u8, length: usize }
// Large enough for every supported sockaddr. `length` makes ownership and ABI size explicit.
pub struct Address { bytes: [128]u8, length: usize }

// `active` makes zeroed storage a closed handle; descriptor 0 is a valid descriptor.
// Connections and listeners are plain values, like files: copy them freely
// and close them once.
pub struct Connection { descriptor: isize, active: bool }
pub struct Listener { descriptor: isize, active: bool }

// Every call that can fail returns T!io.IoErr. A closed Connection or
// Listener fails with InvalidInput.

// Wraps an open socket descriptor; the result owns it and must be closed once.
pub fn connection_from_descriptor(descriptor: isize) Connection {
  return Connection{ descriptor: descriptor, active: descriptor >= 0 }
}
pub fn listener_from_descriptor(descriptor: isize) Listener {
  return Listener{ descriptor: descriptor, active: descriptor >= 0 }
}

// Fails with value's IoErr when value is a failure (negative); else value.
fn check(value: isize) isize!io.IoErr {
  if value < 0 { fail native_err(value) }
  return value
}

// A new socket descriptor.
pub fn socket(family: usize, kind: usize, protocol: usize) isize!io.IoErr {
  return try check(native_socket(family, kind, protocol))
}

// Closes descriptor. Never retry a close: after a failure the descriptor may
// already be reused.
pub fn close(descriptor: isize) {
  _ = native_close(descriptor)
}
pub fn listen(descriptor: isize, backlog: usize) !io.IoErr {
  _ = try check(native_listen(descriptor, backlog))
}
pub fn shutdown(descriptor: isize, how: usize) !io.IoErr {
  _ = try check(native_shutdown(descriptor, how))
}

pub fn ipv4_address(destination: []u8, a: u8, b: u8, c: u8, d: u8, port: u16) []u8 {
  if destination.len < 16 { return destination[..0] }
  for i in 0..16 {
    destination[i] = 0
  }
  address_family(destination, 16, 2)
  destination[2] = (port >> 8)
  destination[3] = #cast(u8, port)
  destination[4] = a
  destination[5] = b
  destination[6] = c
  destination[7] = d
  return destination[..16]
}

pub fn ipv4(a: u8, b: u8, c: u8, d: u8, port: u16) Ipv4Address {
  address_result: Ipv4Address = Ipv4Address{}
  _ = ipv4_address(address_result.bytes[..], a, b, c, d, port)
  return address_result
}

pub fn ipv6(bytes: [16]u8, port: u16, scope: u32) Ipv6Address {
  value: Ipv6Address = Ipv6Address{}
  address_family(value.bytes[..], 28, AddressFamilyIpv6)
  value.bytes[2] = (port >> 8)
  value.bytes[3] = #cast(u8, port)
  for i in 0..16 {
    value.bytes[8 + i] = bytes[i]
  }
  value.bytes[24] = #cast(u8, scope)
  value.bytes[25] = #cast(u8, (scope >> 8))
  value.bytes[26] = #cast(u8, (scope >> 16))
  value.bytes[27] = (scope >> 24)
  return value
}

// Native sockaddr_un. Empty result means an empty/oversized path.
pub fn unix(path: []const u8) UnixAddress {
  value: UnixAddress = UnixAddress{}
  if path.len == 0 || path.len > UnixPathLimit { return value }
  for i in 0..path.len {
    if path[i] == 0 { return value }
  }
  address_family(value.bytes[..], 3 + path.len, 1)
  for i in 0..path.len {
    value.bytes[2 + i] = path[i]
  }
  value.length = 3 + path.len
  return value
}

pub fn connect_ipv4(descriptor: isize, address: *const Ipv4Address) !io.IoErr {
  try connect(descriptor, address.bytes[..])
}
pub fn bind_ipv4(descriptor: isize, address: *const Ipv4Address) !io.IoErr {
  try bind(descriptor, address.bytes[..])
}
pub fn connect_ipv6(descriptor: isize, address: *const Ipv6Address) !io.IoErr {
  try connect(descriptor, address.bytes[..])
}
pub fn bind_ipv6(descriptor: isize, address: *const Ipv6Address) !io.IoErr {
  try bind(descriptor, address.bytes[..])
}
// An empty or oversized Unix address fails with InvalidInput.
fn unix_bytes(address: *const UnixAddress) []const u8!io.IoErr {
  if address.length == 0 || address.length > address.bytes.len { fail .InvalidInput }
  return address.bytes[..address.length]
}
pub fn connect_unix(descriptor: isize, address: *const UnixAddress) !io.IoErr {
  try connect(descriptor, try unix_bytes(address))
}
pub fn bind_unix(descriptor: isize, address: *const UnixAddress) !io.IoErr {
  try bind(descriptor, try unix_bytes(address))
}

// An empty address fails with InvalidInput.
pub fn connect(descriptor: isize, address: []const u8) !io.IoErr {
  if address.len == 0 { fail .InvalidInput }
  _ = try check(native_connect(descriptor, &address[0], address.len))
}

pub fn bind(descriptor: isize, address: []const u8) !io.IoErr {
  if address.len == 0 { fail .InvalidInput }
  _ = try check(native_bind(descriptor, &address[0], address.len))
}

// Accepts one connection: its descriptor.
pub fn accept(descriptor: isize) isize!io.IoErr {
  return try check(native_accept(descriptor, nil, nil, false))
}

fn stream_listen(family: usize, address: []const u8, backlog: usize, shared: bool) Listener!io.IoErr {
  descriptor := try socket(family, SocketStream, 0)
  errdefer close(descriptor)
  // Unix path ownership controls rebinding. SO_REUSEADDR is an Internet
  // option and is not supported by every AF_UNIX implementation.
  if family != AddressFamilyUnix {
    try reuse_address(descriptor, true)
  }
  if shared {
    try reuse_port(descriptor, true)
  }
  try bind(descriptor, address)
  try listen(descriptor, backlog)
  return listener_from_descriptor(descriptor)
}

fn stream_connect(family: usize, address: []const u8) Connection!io.IoErr {
  descriptor := try socket(family, SocketStream, 0)
  errdefer close(descriptor)
  try connect(descriptor, address)
  return connection_from_descriptor(descriptor)
}

pub fn tcp_listen_ipv4(address: *const Ipv4Address, backlog: usize) Listener!io.IoErr {
  return try stream_listen(AddressFamilyIpv4, address.bytes[..], backlog, false)
}
// Like tcp_listen_ipv4 with SO_REUSEPORT set before bind. Several listeners on
// one address then share incoming connections, balanced by the kernel. Linux
// only: elsewhere it fails with Unsupported.
pub fn tcp_listen_ipv4_shared(address: *const Ipv4Address, backlog: usize) Listener!io.IoErr {
  return try stream_listen(AddressFamilyIpv4, address.bytes[..], backlog, true)
}
pub fn tcp_connect_ipv4(address: *const Ipv4Address) Connection!io.IoErr {
  return try stream_connect(AddressFamilyIpv4, address.bytes[..])
}
pub fn tcp_listen_ipv6(address: *const Ipv6Address, backlog: usize) Listener!io.IoErr {
  return try stream_listen(AddressFamilyIpv6, address.bytes[..], backlog, false)
}
pub fn tcp_connect_ipv6(address: *const Ipv6Address) Connection!io.IoErr {
  return try stream_connect(AddressFamilyIpv6, address.bytes[..])
}
// The caller removes the filesystem socket path after closing the listener.
pub fn unix_listen(address: *const UnixAddress, backlog: usize) Listener!io.IoErr {
  return try stream_listen(AddressFamilyUnix, try unix_bytes(address), backlog, false)
}
pub fn unix_connect(address: *const UnixAddress) Connection!io.IoErr {
  return try stream_connect(AddressFamilyUnix, try unix_bytes(address))
}

// IPv4 multicast membership uses network-order octets for both addresses.
// An all-zero interface selects the system default interface. A group that
// is not a multicast address fails with InvalidInput.
pub fn multicast_join_ipv4(descriptor: isize, group: [4]u8, interface: [4]u8) !io.IoErr {
  try multicast_membership(descriptor, group, interface, MulticastJoinOption)
}
pub fn multicast_leave_ipv4(descriptor: isize, group: [4]u8, interface: [4]u8) !io.IoErr {
  try multicast_membership(descriptor, group, interface, MulticastLeaveOption)
}
fn multicast_membership(descriptor: isize, group: [4]u8, interface: [4]u8, option: usize) !io.IoErr {
  if group[0] < 224 || group[0] > 239 { fail .InvalidInput }
  request: [8]u8
  for i in 0..4 {
    request[i] = group[i]
    request[4 + i] = interface[i]
  }
  _ = try check(native_set_option(descriptor, 0, option, &request[0], 8))
}
pub fn multicast_interface_ipv4(descriptor: isize, interface: [4]u8) !io.IoErr {
  value := interface
  _ = try check(native_set_option(descriptor, 0, MulticastInterfaceOption, &value[0], 4))
}
pub fn multicast_ttl_ipv4(descriptor: isize, ttl: u8) !io.IoErr {
  _ = try check(native_multicast_byte(descriptor, MulticastTtlOption, ttl))
}
// POSIX controls outgoing loopback; Windows controls receipt on this socket.
pub fn multicast_loop_ipv4(descriptor: isize, enabled: bool) !io.IoErr {
  value: u8 = 0
  if enabled {
    value = 1
  }
  _ = try check(native_multicast_byte(descriptor, MulticastLoopOption, value))
}

pub fn listener_accept(listener: *Listener) Connection!io.IoErr {
  if !listener.active { fail .InvalidInput }
  return connection_from_descriptor(try accept(listener.descriptor))
}

pub fn listener_close(listener: *Listener) {
  if !listener.active { return }
  descriptor := listener.descriptor
  // Never retry close: after a failure the descriptor may already be reused.
  listener.* = Listener{}
  close(descriptor)
}

pub fn connection_close(connection: *Connection) {
  if !connection.active { return }
  descriptor := connection.descriptor
  // Never retry close: after a failure the descriptor may already be reused.
  connection.* = Connection{}
  close(descriptor)
}

// Reads what is available, up to destination; 0 at the end of the stream.
pub fn connection_read(connection: *Connection, destination: []u8) usize!io.IoErr {
  if !connection.active { fail .InvalidInput }
  return try receive(connection.descriptor, destination, 0)
}

// Writes all of source. A connection that takes no more bytes fails with
// System(-32), EPIPE.
pub fn connection_write(connection: *Connection, source: []const u8) !io.IoErr {
  if !connection.active { fail .InvalidInput }
  total: usize = 0
  for total < source.len {
    sent := try send(connection.descriptor, source[total..], 0)
    if sent == 0 { fail io.IoErr.System(-32) }
    total += sent
  }
}

fn connection_reader_read(data: rawptr, destination: []u8) usize!io.IoErr {
  return try connection_read(#cast(*Connection, data), destination)
}

fn connection_writer_write(data: rawptr, source: []const u8) usize!io.IoErr {
  try connection_write(#cast(*Connection, data), source)
  return source.len
}

pub fn connection_reader(connection: *Connection) io.Reader {
  return io.Reader{ data: connection, read: connection_reader_read }
}

pub fn connection_writer(connection: *Connection) io.Writer {
  return io.Writer{ data: connection, write: connection_writer_write }
}

// Accepts one connection and records its peer address. nonblocking sets the
// new socket nonblocking in the same step where the platform allows it.
// The new descriptor.
pub fn accept_address(descriptor: isize, address: *Address, nonblocking: bool) isize!io.IoErr {
  length: u32 = 128
  value := try check(native_accept(descriptor, &address.bytes[0], &length, nonblocking))
  address.length = length
  return value
}

// Like accept_address on a nonblocking listener, where no pending
// connection is no failure: -1 with blocked true.
pub fn try_accept_address(descriptor: isize, address: *Address, nonblocking: bool) Accepted!io.IoErr {
  length: u32 = 128
  value := native_accept(descriptor, &address.bytes[0], &length, nonblocking)
  if value < 0 {
    if native_would_block(value) { return Accepted{ descriptor: -1, blocked: true } }
    fail native_err(value)
  }
  address.length = length
  return Accepted{ descriptor: value }
}
pub struct Accepted { descriptor: isize, blocked: bool }

pub fn local_address(descriptor: isize, address: *Address) !io.IoErr {
  length: u32 = 128
  _ = try check(native_local(descriptor, &address.bytes[0], &length))
  address.length = length
}

pub fn peer_address(descriptor: isize, address: *Address) !io.IoErr {
  length: u32 = 128
  _ = try check(native_peer(descriptor, &address.bytes[0], &length))
  address.length = length
}

// Sends what the socket takes now, up to all of bytes; the count sent.
pub fn send(descriptor: isize, bytes: []const u8, flags: usize) usize!io.IoErr {
  if bytes.len == 0 { return 0 }
  return #cast(usize, try check(send_native(descriptor, bytes, flags)))
}

// Receives what is available, up to bytes; 0 at the end of a stream.
pub fn receive(descriptor: isize, bytes: []u8, flags: usize) usize!io.IoErr {
  if bytes.len == 0 { return 0 }
  return #cast(usize, try check(receive_native(descriptor, bytes, flags)))
}

// For nonblocking sockets, where a socket that is not ready is no failure:
// count is 0 and blocked is true. Otherwise as send and receive.
pub struct Attempt { count: usize, blocked: bool }
pub fn try_send(descriptor: isize, bytes: []const u8, flags: usize) Attempt!io.IoErr {
  if bytes.len == 0 { return Attempt{} }
  value := send_native(descriptor, bytes, flags)
  if value < 0 {
    if native_would_block(value) { return Attempt{ blocked: true } }
    fail native_err(value)
  }
  return Attempt{ count: #cast(usize, value) }
}
pub fn try_receive(descriptor: isize, bytes: []u8, flags: usize) Attempt!io.IoErr {
  if bytes.len == 0 { return Attempt{} }
  value := receive_native(descriptor, bytes, flags)
  if value < 0 {
    if native_would_block(value) { return Attempt{ blocked: true } }
    fail native_err(value)
  }
  return Attempt{ count: #cast(usize, value) }
}

fn send_native(descriptor: isize, bytes: []const u8, flags: usize) isize {
  // MSG_NOSIGNAL keeps a disconnected peer a failure instead of a signal.
  flags = flags | NoSignalFlag
  value := native_send(descriptor, &bytes[0], bytes.len, flags, nil, 0)
  for native_interrupted(value) {
    value = native_send(descriptor, &bytes[0], bytes.len, flags, nil, 0)
  }
  return value
}
fn receive_native(descriptor: isize, bytes: []u8, flags: usize) isize {
  value := native_receive(descriptor, &bytes[0], bytes.len, flags, nil, nil)
  for native_interrupted(value) {
    value = native_receive(descriptor, &bytes[0], bytes.len, flags, nil, nil)
  }
  return value
}

// Sends one datagram to address; the count sent. An empty address fails with
// InvalidInput.
pub fn send_to(descriptor: isize, bytes: []const u8, flags: usize, address: []const u8) usize!io.IoErr {
  if address.len == 0 { fail .InvalidInput }
  // Empty UDP payloads are packets too; the kernel accepts a null buffer.
  data: *const u8 = nil
  if bytes.len > 0 {
    data = &bytes[0]
  }
  // This entry point can also send through a connected stream socket.
  flags = flags | NoSignalFlag
  value := native_send(descriptor, data, bytes.len, flags, &address[0], address.len)
  for native_interrupted(value) {
    value = native_send(descriptor, data, bytes.len, flags, &address[0], address.len)
  }
  return #cast(usize, try check(value))
}

// Receives one datagram and its sender's address; the count received.
pub fn receive_from(descriptor: isize, bytes: []u8, flags: usize, address: []u8, address_length: *u32) usize!io.IoErr {
  if bytes.len == 0 { return 0 }
  address_raw: *u8 = nil
  if address.len > 0 {
    address_raw = &address[0]
    address_length.* = #cast(u32, address.len)
  }
  value := native_receive(descriptor, &bytes[0], bytes.len, flags, address_raw, address_length)
  for native_interrupted(value) {
    value = native_receive(descriptor, &bytes[0], bytes.len, flags, address_raw, address_length)
  }
  return #cast(usize, try check(value))
}

fn flag_option(descriptor: isize, level: usize, option: usize, enabled: bool) !io.IoErr {
  value: i32 = 0
  if enabled {
    value = 1
  }
  _ = try check(native_set_option(descriptor, level, option, &value, #sizeof(i32)))
}

pub fn reuse_address(descriptor: isize, enabled: bool) !io.IoErr {
  try flag_option(descriptor, SocketLevel, ReuseOption, enabled)
}

// TCP_NODELAY: send small segments at once instead of waiting for the peer's
// ACK. Request/response servers want this; bulk senders usually do not.
pub fn no_delay(descriptor: isize, enabled: bool) !io.IoErr {
  try flag_option(descriptor, TcpLevel, NoDelayOption, enabled)
}

// SO_REUSEPORT with kernel load balancing. Unsupported where the platform has
// only the non-balancing variant (macOS) or none (Windows).
pub fn reuse_port(descriptor: isize, enabled: bool) !io.IoErr {
  if ReusePortOption == 0 { fail .Unsupported }
  try flag_option(descriptor, SocketLevel, ReusePortOption, enabled)
}

// Completes a nonblocking connect: the connect's failure, read from SO_ERROR.
pub fn socket_error(descriptor: isize) !io.IoErr {
  error: i32 = 0
  length: u32 = #cast(u32, #sizeof(i32))
  _ = try check(native_get_option(descriptor, SocketLevel, ErrorOption, &error, &length))
  if error != 0 { fail native_err(0 - #cast(isize, error)) }
}

pub fn nonblocking(descriptor: isize, enabled: bool) !io.IoErr {
  _ = try check(native_nonblocking(descriptor, enabled))
}
pub fn receive_timeout(descriptor: isize, milliseconds: usize) !io.IoErr {
  _ = try check(native_timeout(descriptor, milliseconds, false))
}
pub fn send_timeout(descriptor: isize, milliseconds: usize) !io.IoErr {
  _ = try check(native_timeout(descriptor, milliseconds, true))
}

// Whether err is a socket timeout or a nonblocking socket that was not
// ready, rather than a broken connection.
pub fn would_block(err: io.IoErr) bool {
  case err {
    .WouldBlock => { return true }
    .System(code) => { return native_would_block(code) }
    _ => { return false }
  }
}

// Called only after EINTR for finite waits: the milliseconds left, rounded
// up so converting back cannot expire the deadline early; 0 once expired.
fn interrupted_timeout(start: clock.Instant, milliseconds: i32) i32 {
  elapsed := clock.elapsed(start, clock.monotonic_now())
  duration := milliseconds * clock.Millisecond
  if elapsed >= duration { return 0 }
  if elapsed < 0 { return milliseconds }
  return #cast(i32, ((duration - elapsed + clock.Millisecond - 1) / clock.Millisecond))
}

// Waits for readiness on descriptors; the number ready, 0 on timeout. A
// negative timeout waits indefinitely, zero polls.
pub fn poll(descriptors: []PollDescriptor, timeout_milliseconds: i32) usize!io.IoErr {
  start := clock.Instant{}
  if timeout_milliseconds > 0 {
    start = clock.monotonic_now()
  }
  remaining := timeout_milliseconds
  value := poll_native(descriptors, remaining)
  for native_interrupted(value) {
    if timeout_milliseconds > 0 {
      remaining = interrupted_timeout(start, timeout_milliseconds)
      if remaining == 0 {
        for i in 0..descriptors.len {
          descriptors[i].returned = 0
        }
        return 0
      }
    }
    value = poll_native(descriptors, remaining)
  }
  return #cast(usize, try check(value))
}

// Waits for events on one descriptor: the events that happened, 0 on timeout.
pub fn wait(descriptor: isize, events: i16, timeout_milliseconds: i32) i16!io.IoErr {
  item := PollDescriptor{ descriptor: #cast(Descriptor, descriptor), events: events, returned: 0 }
  if try poll(#slice(&item, 1), timeout_milliseconds) == 0 { return 0 }
  return item.returned
}

pub fn poll_has(item: *const PollDescriptor, events: i16) bool {
  return (item.returned & events) != 0
}

// The IP of an IPv4 or IPv6 socket address: 4 or 16 bytes in network order,
// and the port. Empty bytes for other families.
pub struct Ip { bytes: [16]u8, length: usize, port: u16 }

pub fn address_ip(address: *const Address) Ip {
  result := Ip{}
  if address.length < 8 { return result }
  family := read_family(address.bytes[..])
  result.port = #cast(u16, address.bytes[2]) << 8 | #cast(u16, address.bytes[3])
  if family == AddressFamilyIpv4 {
    for i in 0..4 {
      result.bytes[i] = address.bytes[4 + i]
    }
    result.length = 4
  } else if family == AddressFamilyIpv6 && address.length >= 24 {
    for i in 0..16 {
      result.bytes[i] = address.bytes[8 + i]
    }
    result.length = 16
  }
  return result
}

fn put_decimal(destination: []u8, at: usize, value: u32) usize {
  digits: [10]u8
  count: usize = 0
  rest := value
  for true {
    digits[count] = #cast(u8, '0' + rest % 10)
    count += 1
    rest /= 10
    if rest == 0 { break }
  }
  position := at
  for i in 0..count {
    if position < destination.len {
      destination[position] = digits[count - 1 - i]
    }
    position += 1
  }
  return position
}

// The IP as text: dotted IPv4, or IPv6 in RFC 5952 form (lowercase, the
// longest run of zero groups as ::). Empty when destination is shorter than
// 46 bytes or ip is empty.
pub fn ip_text(destination: []u8, ip: Ip) []u8 {
  if destination.len < 46 || (ip.length != 4 && ip.length != 16) { return destination[..0] }
  at: usize = 0
  if ip.length == 4 {
    for i in 0..4 {
      if i > 0 {
        destination[at] = '.'
        at += 1
      }
      at = put_decimal(destination, at, ip.bytes[i])
    }
    return destination[..at]
  }
  groups: [8]u32
  for i in 0..8 {
    groups[i] = #cast(u32, ip.bytes[2 * i]) << 8 | #cast(u32, ip.bytes[2 * i + 1])
  }
  best_start: usize = 8
  best_length: usize = 0
  i: usize = 0
  for i < 8 {
    if groups[i] != 0 {
      i += 1
      continue
    }
    start := i
    for i < 8 && groups[i] == 0 {
      i += 1
    }
    if i - start > best_length && i - start >= 2 {
      best_start = start
      best_length = i - start
    }
  }
  digits := "0123456789abcdef"
  g: usize = 0
  for g < 8 {
    if g == best_start {
      destination[at] = ':'
      destination[at + 1] = ':'
      at += 2
      g += best_length
      continue
    }
    if g > 0 && g != best_start + best_length {
      destination[at] = ':'
      at += 1
    }
    value := groups[g]
    started := false
    for shift in 0..4 {
      nibble := (value >> #cast(u32, 12 - 4 * shift)) & 15
      if nibble != 0 || started || shift == 3 {
        destination[at] = digits[nibble]
        at += 1
        started = true
      }
    }
    g += 1
  }
  return destination[..at]
}
