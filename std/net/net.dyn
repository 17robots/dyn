#target(pointer_bits: 64)


use "std/io" stream
use "std/time" clock

pub const AddressFamilyIpv4: usize = 2
pub const AddressFamilyUnix: usize = 1
pub const SocketStream: usize = 1
pub const SocketDatagram: usize = 2
pub const PollReadable: i16 = 1
pub const PollWritable: i16 = 4
pub const PollError: i16 = 8
pub const PollHangup: i16 = 16
pub const ShutdownRead: usize = 0
pub const ShutdownWrite: usize = 1
pub const ShutdownBoth: usize = 2

pub struct Ipv4Address { bytes: [16]u8 }
pub struct Ipv6Address { bytes: [28]u8 }
pub struct UnixAddress { bytes: [110]u8, length: usize }
// Large enough for every supported sockaddr. `length` makes ownership and ABI size explicit.
pub struct Address { bytes: [128]u8, length: usize }

pub struct Result { value: isize, error: isize, ok: bool }
pub struct Connection { descriptor: isize = -1 }
pub struct Listener { descriptor: isize = -1 }
pub struct ConnectionResult { connection: Connection, error: isize, ok: bool }
pub struct ListenerResult { listener: Listener, error: isize, ok: bool }
pub fn result_value(outcome: *const Result) isize {
  return outcome.value
}
pub fn connection_result_value(outcome: *const ConnectionResult) Connection {
  return outcome.connection
}
pub fn listener_result_value(outcome: *const ListenerResult) Listener {
  return outcome.listener
}

fn result(value: isize) Result {
  if value < 0 {
    return Result{ value: value, error: value, ok: false }
  }
  return Result{ value: value, error: 0, ok: true }
}

pub fn socket(family: usize, kind: usize, protocol: usize) Result {
  return result(native_socket(family, kind, protocol))
}

pub fn close(descriptor: isize) Result {
  return result(native_close(descriptor))
}
pub fn listen(descriptor: isize, backlog: usize) Result {
  return result(native_listen(descriptor, backlog))
}
pub fn shutdown(descriptor: isize, how: usize) Result {
  return result(native_shutdown(descriptor, how))
}

pub fn ipv4_address(destination: []u8, a: u8, b: u8, c: u8, d: u8, port: u16) []u8 {
  if #len(destination) < 16 {
    return destination[..0]
  }
  for i in 0..16 {
    destination[i] = 0
  }
  address_family(destination, 16, 2)
  destination[2] = #cast(u8) (port >> 8)
  destination[3] = #cast(u8) port
  destination[4] = a
  destination[5] = b
  destination[6] = c
  destination[7] = d
  return destination[..16]
}

pub fn ipv4(a: u8, b: u8, c: u8, d: u8, port: u16) Ipv4Address {
  address_result: Ipv4Address = Ipv4Address{}
  _ = ipv4_address(address_result.bytes[..], a, b, c, d, port)
  return address_result
}

pub fn ipv6(bytes: [16]u8, port: u16, scope: u32) Ipv6Address {
  value: Ipv6Address = Ipv6Address{}
  address_family(value.bytes[..], 28, AddressFamilyIpv6)
  value.bytes[2] = #cast(u8) (port >> 8)
  value.bytes[3] = #cast(u8) port
  for i in 0..16 {
    value.bytes[8 + i] = bytes[i]
  }
  value.bytes[24] = #cast(u8) scope
  value.bytes[25] = #cast(u8) (scope >> 8)
  value.bytes[26] = #cast(u8) (scope >> 16)
  value.bytes[27] = #cast(u8) (scope >> 24)
  return value
}

// Native sockaddr_un. Empty result means an empty/oversized path.
pub fn unix(path: []const u8) UnixAddress {
  value: UnixAddress = UnixAddress{}
  if #len(path) == 0 || #len(path) > UnixPathLimit {
    return value
  }
  address_family(value.bytes[..], 3 + #len(path), 1)
  for i in 0..#len(path) {
    value.bytes[2 + i] = path[i]
  }
  value.length = 3 + #len(path)
  return value
}

pub fn connect_ipv4(descriptor: isize, address: *const Ipv4Address) Result {
  return result(native_connect(descriptor, &address.bytes[0], 16))
}

pub fn bind_ipv4(descriptor: isize, address: *const Ipv4Address) Result {
  return result(native_bind(descriptor, &address.bytes[0], 16))
}

pub fn connect_ipv6(descriptor: isize, address: *const Ipv6Address) Result {
  return result(native_connect(descriptor, &address.bytes[0], 28))
}
pub fn bind_ipv6(descriptor: isize, address: *const Ipv6Address) Result {
  return result(native_bind(descriptor, &address.bytes[0], 28))
}
pub fn connect_unix(descriptor: isize, address: *const UnixAddress) Result {
  if address.length == 0 {
    return Result{ value: -1, error: -22, ok: false }
  }
  return result(native_connect(descriptor, &address.bytes[0], address.length))
}
pub fn bind_unix(descriptor: isize, address: *const UnixAddress) Result {
  if address.length == 0 {
    return Result{ value: -1, error: -22, ok: false }
  }
  return result(native_bind(descriptor, &address.bytes[0], address.length))
}

pub fn connect(descriptor: isize, address: []const u8) Result {
  if #len(address) == 0 {
    return Result{ value: -1, error: -22, ok: false }
  }
  return result(native_connect(descriptor, &address[0], #len(address)))
}

pub fn bind(descriptor: isize, address: []const u8) Result {
  if #len(address) == 0 {
    return Result{ value: -1, error: -22, ok: false }
  }
  return result(native_bind(descriptor, &address[0], #len(address)))
}

pub fn accept(descriptor: isize) Result {
  return result(native_accept(descriptor, nil, nil))
}

pub fn tcp_listen_ipv4(address: *const Ipv4Address, backlog: usize) ListenerResult {
  opened := socket(AddressFamilyIpv4, SocketStream, 0)
  if !opened.ok {
    return ListenerResult{ listener: Listener{}, error: opened.error, ok: false }
  }
  descriptor := result_value(&opened)
  reused := reuse_address(descriptor, true)
  if !reused.ok {
    _ = close(descriptor)
    return ListenerResult{ listener: Listener{}, error: reused.error, ok: false }
  }
  bound := bind_ipv4(descriptor, address)
  if !bound.ok {
    _ = close(descriptor)
    return ListenerResult{ listener: Listener{}, error: bound.error, ok: false }
  }
  listening := listen(descriptor, backlog)
  if !listening.ok {
    _ = close(descriptor)
    return ListenerResult{ listener: Listener{}, error: listening.error, ok: false }
  }
  return ListenerResult{ listener: Listener{ descriptor: descriptor }, ok: true }
}

pub fn tcp_connect_ipv4(address: *const Ipv4Address) ConnectionResult {
  opened := socket(AddressFamilyIpv4, SocketStream, 0)
  if !opened.ok {
    return ConnectionResult{ connection: Connection{}, error: opened.error, ok: false }
  }
  descriptor := result_value(&opened)
  connected := connect_ipv4(descriptor, address)
  if !connected.ok {
    _ = close(descriptor)
    return ConnectionResult{ connection: Connection{}, error: connected.error, ok: false }
  }
  return ConnectionResult{ connection: Connection{ descriptor: descriptor }, ok: true }
}

pub fn listener_accept(listener: *Listener) ConnectionResult {
  if listener.descriptor < 0 {
    return ConnectionResult{ connection: Connection{}, error: -9, ok: false }
  }
  accepted := accept(listener.descriptor)
  if !accepted.ok {
    return ConnectionResult{ connection: Connection{}, error: accepted.error, ok: false }
  }
  return ConnectionResult{ connection: Connection{ descriptor: result_value(&accepted) }, ok: true }
}

pub fn listener_close(listener: *Listener) Result {
  if listener.descriptor < 0 {
    return Result{ error: -9, ok: false }
  }
  closed := close(listener.descriptor)
  if closed.ok {
    listener.descriptor = -1
  }
  return closed
}

pub fn connection_close(connection: *Connection) Result {
  if connection.descriptor < 0 {
    return Result{ error: -9, ok: false }
  }
  closed := close(connection.descriptor)
  if closed.ok {
    connection.descriptor = -1
  }
  return closed
}

pub fn connection_read(connection: *Connection, destination: []u8) Result {
  if connection.descriptor < 0 {
    return Result{ error: -9, ok: false }
  }
  return receive(connection.descriptor, destination, 0)
}

pub fn connection_write(connection: *Connection, source: []const u8) Result {
  if connection.descriptor < 0 {
    return Result{ error: -9, ok: false }
  }
  total: usize = 0
  for total < #len(source) {
    sent := send(connection.descriptor, source[total..], 0)
    if !sent.ok {
      return Result{ value: #cast(isize) total, error: sent.error, ok: false }
    }
    if sent.value == 0 {
      return Result{ value: #cast(isize) total, error: -32, ok: false }
    }
    total += #cast(usize) sent.value
  }
  return Result{ value: #cast(isize) total, ok: true }
}

fn connection_reader_read(data: rawptr, destination: []u8) stream.Result {
  outcome := connection_read(#cast(*Connection) data, destination)
  if !outcome.ok {
    return stream.Result{ error: outcome.error, status: stream.Status.Error }
  }
  status := stream.Status.Complete
  if outcome.value == 0 {
    status = stream.Status.End
  }
  return stream.Result{ transferred: #cast(usize) outcome.value, status: status }
}

fn connection_writer_write(data: rawptr, source: []const u8) stream.Result {
  outcome := connection_write(#cast(*Connection) data, source)
  if !outcome.ok {
    transferred: usize = 0
    if outcome.value > 0 {
      transferred = #cast(usize) outcome.value
    }
    return stream.Result{ transferred: transferred, error: outcome.error, status: stream.Status.Error }
  }
  return stream.Result{ transferred: #cast(usize) outcome.value, status: stream.Status.Complete }
}

pub fn connection_reader(connection: *Connection) stream.Reader {
  return stream.Reader{ data: #cast(rawptr) connection, read: &connection_reader_read }
}

pub fn connection_writer(connection: *Connection) stream.Writer {
  return stream.Writer{ data: #cast(rawptr) connection, write: &connection_writer_write }
}

pub fn accept_address(descriptor: isize, address: *Address) Result {
  length: u32 = 128
  outcome := result(native_accept(descriptor, &address.bytes[0], &length))
  if outcome.ok {
    address.length = #cast(usize) length
  }
  return outcome
}

pub fn local_address(descriptor: isize, address: *Address) Result {
  length: u32 = 128
  outcome := result(native_local(descriptor, &address.bytes[0], &length))
  if outcome.ok {
    address.length = #cast(usize) length
  }
  return outcome
}

pub fn peer_address(descriptor: isize, address: *Address) Result {
  length: u32 = 128
  outcome := result(native_peer(descriptor, &address.bytes[0], &length))
  if outcome.ok {
    address.length = #cast(usize) length
  }
  return outcome
}

pub fn send(descriptor: isize, bytes: []const u8, flags: usize) Result {
  if #len(bytes) == 0 {
    return Result{ value: 0, error: 0, ok: true }
  }
  // MSG_NOSIGNAL keeps a disconnected peer in the Result error channel.
  flags = flags | NoSignalFlag
  value := native_send(descriptor, &bytes[0], #len(bytes), flags, nil, 0)
  for native_interrupted(value) {
    value = native_send(descriptor, &bytes[0], #len(bytes), flags, nil, 0)
  }
  return result(value)
}

pub fn receive(descriptor: isize, bytes: []u8, flags: usize) Result {
  if #len(bytes) == 0 {
    return Result{ value: 0, error: 0, ok: true }
  }
  value := native_receive(descriptor, &bytes[0], #len(bytes), flags, nil, nil)
  for native_interrupted(value) {
    value = native_receive(descriptor, &bytes[0], #len(bytes), flags, nil, nil)
  }
  return result(value)
}

pub fn send_to(descriptor: isize, bytes: []const u8, flags: usize, address: []const u8) Result {
  if #len(address) == 0 {
    return Result{ value: -1, error: -22, ok: false }
  }
  // Empty UDP payloads are packets too; the kernel accepts a null buffer.
  data: *const u8 = nil
  if #len(bytes) > 0 {
    data = &bytes[0]
  }
  // This entry point can also send through a connected stream socket.
  flags = flags | NoSignalFlag
  value := native_send(descriptor, data, #len(bytes), flags, &address[0], #len(address))
  for native_interrupted(value) {
    value = native_send(descriptor, data, #len(bytes), flags, &address[0], #len(address))
  }
  return result(value)
}

pub fn receive_from(descriptor: isize, bytes: []u8, flags: usize, address: []u8, address_length: *u32) Result {
  if #len(bytes) == 0 {
    return Result{ value: 0, error: 0, ok: true }
  }
  address_raw: *u8 = nil
  if #len(address) > 0 {
    address_raw = &address[0]
    address_length.* = #cast(u32) #len(address)
  }
  value := native_receive(descriptor, &bytes[0], #len(bytes), flags, address_raw, address_length)
  for native_interrupted(value) {
    value = native_receive(descriptor, &bytes[0], #len(bytes), flags, address_raw, address_length)
  }
  return result(value)
}

pub fn reuse_address(descriptor: isize, enabled: bool) Result {
  value: i32 = 0
  if enabled {
    value = 1
  }
  return result(native_set_option(descriptor, SocketLevel, ReuseOption, #cast(rawptr) &value, #sizeof(i32)))
}

// Completes a nonblocking connect by reading SO_ERROR. Zero means connected.
pub fn socket_error(descriptor: isize) Result {
  error: i32 = 0
  length: u32 = #cast(u32) #sizeof(i32)
  queried := native_get_option(descriptor, SocketLevel, ErrorOption, #cast(rawptr) &error, &length)
  if queried < 0 {
    return result(queried)
  }
  if error != 0 {
    return result(0 - #cast(isize) error)
  }
  return result(0)
}

pub fn nonblocking(descriptor: isize, enabled: bool) Result {
  return result(native_nonblocking(descriptor, enabled))
}
pub fn receive_timeout(descriptor: isize, milliseconds: usize) Result {
  return result(native_timeout(descriptor, milliseconds, false))
}
pub fn send_timeout(descriptor: isize, milliseconds: usize) Result {
  return result(native_timeout(descriptor, milliseconds, true))
}

pub fn would_block(outcome: *const Result) bool {
  return !outcome.ok && native_would_block(outcome.error)
}


// Called only after EINTR for finite waits. Round remaining nanoseconds up so
// converting back to a millisecond timeout cannot expire the deadline early.
fn interrupted_timeout(start: clock.Instant, milliseconds: i32) Result {
  now := clock.try_monotonic_now()
  if !now.ok {
    return Result{ value: now.error, error: now.error }
  }
  elapsed := clock.elapsed(start, now.value)
  if !elapsed.ok || elapsed.value < 0 {
    return result(-75)
  }
  duration := #cast(i64) milliseconds * clock.Millisecond
  if elapsed.value >= duration {
    return result(0)
  }
  return result(#cast(isize) ((duration - elapsed.value + clock.Millisecond - 1) / clock.Millisecond))
}

pub fn poll(descriptors: []PollDescriptor, timeout_milliseconds: i32) Result {
  start := clock.ClockResult{}
  if timeout_milliseconds > 0 {
    start = clock.try_monotonic_now()
    if !start.ok { return Result{ value: start.error, error: start.error } }
  }
  remaining := timeout_milliseconds
  value := poll_native(descriptors, remaining)
  for native_interrupted(value) {
    if timeout_milliseconds > 0 {
      retry := interrupted_timeout(start.value, timeout_milliseconds)
      if !retry.ok { return retry }
      if retry.value == 0 {
        for i in 0..#len(descriptors) { descriptors[i].returned = 0 }
        return result(0)
      }
      remaining = #cast(i32) retry.value
    }
    value = poll_native(descriptors, remaining)
  }
  return result(value)
}

pub fn wait(descriptor: isize, events: i16, timeout_milliseconds: i32) Result {
  item := PollDescriptor{ descriptor: #cast(Descriptor) descriptor, events: events, returned: 0 }
  outcome := poll((&item)[..1], timeout_milliseconds)
  if !outcome.ok || outcome.value == 0 {
    return outcome
  }
  return Result{ value: #cast(isize) item.returned, error: 0, ok: true }
}

pub fn poll_has(item: *const PollDescriptor, events: i16) bool {
  return (item.returned & events) != 0
}


