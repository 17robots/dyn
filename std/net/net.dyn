#target(pointer_bits: 64)


use "std/fail"
use io "std/io"
use clock "std/time"

pub const AddressFamilyIpv4: usize = 2
pub const AddressFamilyUnix: usize = 1
pub const SocketStream: usize = 1
pub const SocketDatagram: usize = 2
pub const PollReadable: i16 = 1
pub const PollWritable: i16 = 4
pub const PollError: i16 = 8
pub const PollHangup: i16 = 16
pub const ShutdownRead: usize = 0
pub const ShutdownWrite: usize = 1
pub const ShutdownBoth: usize = 2

pub struct Ipv4Address { bytes: [16]u8 }
pub struct Ipv6Address { bytes: [28]u8 }
pub struct UnixAddress { bytes: [110]u8, length: usize }
// Large enough for every supported sockaddr. `length` makes ownership and ABI size explicit.
pub struct Address { bytes: [128]u8, length: usize }

// `active` makes zeroed storage a closed handle; descriptor 0 is a valid descriptor.
// Connections and listeners are plain values, like files: copy them freely
// and close them once.
pub struct Connection { descriptor: isize, active: bool }
pub struct Listener { descriptor: isize, active: bool }

// Structured network error enum for T!NetErr APIs.
pub enum NetErr {
  Refused,
  TimedOut,
  Reset,
  AddressInUse,
  Closed,
  InvalidAddress,
  System(isize),
}

// Wraps an open socket descriptor; the result owns it and must be closed once.
pub fn connection_from_descriptor(descriptor: isize) Connection {
  return Connection{ descriptor: descriptor, active: descriptor >= 0 }
}
pub fn listener_from_descriptor(descriptor: isize) Listener {
  return Listener{ descriptor: descriptor, active: descriptor >= 0 }
}

// Records a negative native result as a failure of operation; returns value.
fn check(status: *fail.Status, operation: []const u8, value: isize) isize {
  if value < 0 {
    fail.set(status, native_failure(operation, value))
  }
  return value
}
fn invalid(status: *fail.Status, operation: []const u8, message: []const u8) {
  failure := fail.make(fail.Kind.InvalidInput, operation, "", message)
  failure.native = -22
  fail.set(status, failure)
}
fn closed(status: *fail.Status, operation: []const u8) {
  failure := fail.make(fail.Kind.InvalidState, operation, "", "the socket is closed")
  failure.native = -9
  fail.set(status, failure)
}

// A new socket descriptor, or -1 after a failure.
pub fn socket(status: *fail.Status, family: usize, kind: usize, protocol: usize) isize {
  if status == nil { return socket(&fail.Status{}, family, kind, protocol) }
  if status.failed { return -1 }
  return check(status, "socket", native_socket(family, kind, protocol))
}

// Closes descriptor. Never retry a close: after a failure the descriptor may
// already be reused.
pub fn close(descriptor: isize) {
  _ = native_close(descriptor)
}
pub fn listen(status: *fail.Status, descriptor: isize, backlog: usize) {
  if status == nil {
    listen(&fail.Status{}, descriptor, backlog)
    return
  }
  if status.failed { return }
  _ = check(status, "listen", native_listen(descriptor, backlog))
}
pub fn shutdown(status: *fail.Status, descriptor: isize, how: usize) {
  if status == nil {
    shutdown(&fail.Status{}, descriptor, how)
    return
  }
  if status.failed { return }
  _ = check(status, "shutdown", native_shutdown(descriptor, how))
}

pub fn ipv4_address(destination: []u8, a: u8, b: u8, c: u8, d: u8, port: u16) []u8 {
  if destination.len < 16 { return destination[..0] }
  for i in 0..16 {
    destination[i] = 0
  }
  address_family(destination, 16, 2)
  destination[2] = (port >> 8)
  destination[3] = #cast(u8, port)
  destination[4] = a
  destination[5] = b
  destination[6] = c
  destination[7] = d
  return destination[..16]
}

pub fn ipv4(a: u8, b: u8, c: u8, d: u8, port: u16) Ipv4Address {
  address_result: Ipv4Address = Ipv4Address{}
  _ = ipv4_address(address_result.bytes[..], a, b, c, d, port)
  return address_result
}

pub fn ipv6(bytes: [16]u8, port: u16, scope: u32) Ipv6Address {
  value: Ipv6Address = Ipv6Address{}
  address_family(value.bytes[..], 28, AddressFamilyIpv6)
  value.bytes[2] = (port >> 8)
  value.bytes[3] = #cast(u8, port)
  for i in 0..16 {
    value.bytes[8 + i] = bytes[i]
  }
  value.bytes[24] = #cast(u8, scope)
  value.bytes[25] = #cast(u8, (scope >> 8))
  value.bytes[26] = #cast(u8, (scope >> 16))
  value.bytes[27] = (scope >> 24)
  return value
}

// Native sockaddr_un. Empty result means an empty/oversized path.
pub fn unix(path: []const u8) UnixAddress {
  value: UnixAddress = UnixAddress{}
  if path.len == 0 || path.len > UnixPathLimit { return value }
  for i in 0..path.len {
    if path[i] == 0 { return value }
  }
  address_family(value.bytes[..], 3 + path.len, 1)
  for i in 0..path.len {
    value.bytes[2 + i] = path[i]
  }
  value.length = 3 + path.len
  return value
}

pub fn connect_ipv4(status: *fail.Status, descriptor: isize, address: *const Ipv4Address) {
  if status == nil {
    connect_ipv4(&fail.Status{}, descriptor, address)
    return
  }
  connect(status, descriptor, address.bytes[..])
}
pub fn bind_ipv4(status: *fail.Status, descriptor: isize, address: *const Ipv4Address) {
  if status == nil {
    bind_ipv4(&fail.Status{}, descriptor, address)
    return
  }
  bind(status, descriptor, address.bytes[..])
}
pub fn connect_ipv6(status: *fail.Status, descriptor: isize, address: *const Ipv6Address) {
  if status == nil {
    connect_ipv6(&fail.Status{}, descriptor, address)
    return
  }
  connect(status, descriptor, address.bytes[..])
}
pub fn bind_ipv6(status: *fail.Status, descriptor: isize, address: *const Ipv6Address) {
  if status == nil {
    bind_ipv6(&fail.Status{}, descriptor, address)
    return
  }
  bind(status, descriptor, address.bytes[..])
}
fn unix_bytes(status: *fail.Status, operation: []const u8, address: *const UnixAddress) []const u8 {
  if address.length == 0 || address.length > address.bytes.len {
    invalid(status, operation, "the Unix address is empty or too long")
    return address.bytes[..0]
  }
  return address.bytes[..address.length]
}
pub fn connect_unix(status: *fail.Status, descriptor: isize, address: *const UnixAddress) {
  if status == nil {
    connect_unix(&fail.Status{}, descriptor, address)
    return
  }
  connect(status, descriptor, unix_bytes(status, "connect", address))
}
pub fn bind_unix(status: *fail.Status, descriptor: isize, address: *const UnixAddress) {
  if status == nil {
    bind_unix(&fail.Status{}, descriptor, address)
    return
  }
  bind(status, descriptor, unix_bytes(status, "bind", address))
}

pub fn connect(status: *fail.Status, descriptor: isize, address: []const u8) {
  if status == nil {
    connect(&fail.Status{}, descriptor, address)
    return
  }
  if status.failed { return }
  if address.len == 0 {
    invalid(status, "connect", "empty address")
    return
  }
  _ = check(status, "connect", native_connect(descriptor, &address[0], address.len))
}

pub fn bind(status: *fail.Status, descriptor: isize, address: []const u8) {
  if status == nil {
    bind(&fail.Status{}, descriptor, address)
    return
  }
  if status.failed { return }
  if address.len == 0 {
    invalid(status, "bind", "empty address")
    return
  }
  _ = check(status, "bind", native_bind(descriptor, &address[0], address.len))
}

// Accepts one connection: its descriptor, or -1 after a failure.
pub fn accept(status: *fail.Status, descriptor: isize) isize {
  if status == nil { return accept(&fail.Status{}, descriptor) }
  if status.failed { return -1 }
  return check(status, "accept", native_accept(descriptor, nil, nil, false))
}

fn stream_listen(status: *fail.Status, family: usize, address: []const u8, backlog: usize, shared: bool) Listener {
  descriptor := socket(status, family, SocketStream, 0)
  // Unix path ownership controls rebinding. SO_REUSEADDR is an Internet
  // option and is not supported by every AF_UNIX implementation.
  if family != AddressFamilyUnix {
    reuse_address(status, descriptor, true)
  }
  if shared {
    reuse_port(status, descriptor, true)
  }
  bind(status, descriptor, address)
  listen(status, descriptor, backlog)
  if status.failed {
    if descriptor >= 0 {
      close(descriptor)
    }
    return Listener{}
  }
  return listener_from_descriptor(descriptor)
}

fn stream_connect(status: *fail.Status, family: usize, address: []const u8) Connection {
  descriptor := socket(status, family, SocketStream, 0)
  connect(status, descriptor, address)
  if status.failed {
    if descriptor >= 0 {
      close(descriptor)
    }
    return Connection{}
  }
  return connection_from_descriptor(descriptor)
}

pub fn tcp_listen_ipv4(status: *fail.Status, address: *const Ipv4Address, backlog: usize) Listener {
  if status == nil { return tcp_listen_ipv4(&fail.Status{}, address, backlog) }
  return stream_listen(status, AddressFamilyIpv4, address.bytes[..], backlog, false)
}
// Like tcp_listen_ipv4 with SO_REUSEPORT set before bind. Several listeners on
// one address then share incoming connections, balanced by the kernel. Linux
// only: elsewhere it fails with Unsupported.
pub fn tcp_listen_ipv4_shared(status: *fail.Status, address: *const Ipv4Address, backlog: usize) Listener {
  if status == nil { return tcp_listen_ipv4_shared(&fail.Status{}, address, backlog) }
  return stream_listen(status, AddressFamilyIpv4, address.bytes[..], backlog, true)
}
pub fn tcp_connect_ipv4(status: *fail.Status, address: *const Ipv4Address) Connection {
  if status == nil { return tcp_connect_ipv4(&fail.Status{}, address) }
  return stream_connect(status, AddressFamilyIpv4, address.bytes[..])
}
pub fn tcp_listen_ipv6(status: *fail.Status, address: *const Ipv6Address, backlog: usize) Listener {
  if status == nil { return tcp_listen_ipv6(&fail.Status{}, address, backlog) }
  return stream_listen(status, AddressFamilyIpv6, address.bytes[..], backlog, false)
}
pub fn tcp_connect_ipv6(status: *fail.Status, address: *const Ipv6Address) Connection {
  if status == nil { return tcp_connect_ipv6(&fail.Status{}, address) }
  return stream_connect(status, AddressFamilyIpv6, address.bytes[..])
}
// The caller removes the filesystem socket path after closing the listener.
pub fn unix_listen(status: *fail.Status, address: *const UnixAddress, backlog: usize) Listener {
  if status == nil { return unix_listen(&fail.Status{}, address, backlog) }
  return stream_listen(status, AddressFamilyUnix, unix_bytes(status, "listen", address), backlog, false)
}
pub fn unix_connect(status: *fail.Status, address: *const UnixAddress) Connection {
  if status == nil { return unix_connect(&fail.Status{}, address) }
  return stream_connect(status, AddressFamilyUnix, unix_bytes(status, "connect", address))
}

// IPv4 multicast membership uses network-order octets for both addresses.
// An all-zero interface selects the system default interface.
pub fn multicast_join_ipv4(status: *fail.Status, descriptor: isize, group: [4]u8, interface: [4]u8) {
  if status == nil {
    multicast_join_ipv4(&fail.Status{}, descriptor, group, interface)
    return
  }
  multicast_membership(status, descriptor, group, interface, MulticastJoinOption)
}
pub fn multicast_leave_ipv4(status: *fail.Status, descriptor: isize, group: [4]u8, interface: [4]u8) {
  if status == nil {
    multicast_leave_ipv4(&fail.Status{}, descriptor, group, interface)
    return
  }
  multicast_membership(status, descriptor, group, interface, MulticastLeaveOption)
}
fn multicast_membership(status: *fail.Status, descriptor: isize, group: [4]u8, interface: [4]u8, option: usize) {
  if status.failed { return }
  if group[0] < 224 || group[0] > 239 {
    invalid(status, "multicast membership", "the group is not a multicast address")
    return
  }
  request: [8]u8
  for i in 0..4 {
    request[i] = group[i]
    request[4 + i] = interface[i]
  }
  _ = check(status, "multicast membership", native_set_option(descriptor, 0, option, &request[0], 8))
}
pub fn multicast_interface_ipv4(status: *fail.Status, descriptor: isize, interface: [4]u8) {
  if status == nil {
    multicast_interface_ipv4(&fail.Status{}, descriptor, interface)
    return
  }
  if status.failed { return }
  _ = check(status, "multicast interface", native_set_option(descriptor, 0, MulticastInterfaceOption, &interface[0], 4))
}
pub fn multicast_ttl_ipv4(status: *fail.Status, descriptor: isize, ttl: u8) {
  if status == nil {
    multicast_ttl_ipv4(&fail.Status{}, descriptor, ttl)
    return
  }
  if status.failed { return }
  _ = check(status, "multicast ttl", native_multicast_byte(descriptor, MulticastTtlOption, ttl))
}
// POSIX controls outgoing loopback; Windows controls receipt on this socket.
pub fn multicast_loop_ipv4(status: *fail.Status, descriptor: isize, enabled: bool) {
  if status == nil {
    multicast_loop_ipv4(&fail.Status{}, descriptor, enabled)
    return
  }
  if status.failed { return }
  value: u8 = 0
  if enabled {
    value = 1
  }
  _ = check(status, "multicast loop", native_multicast_byte(descriptor, MulticastLoopOption, value))
}

pub fn listener_accept(status: *fail.Status, listener: *Listener) Connection {
  if status == nil { return listener_accept(&fail.Status{}, listener) }
  if status.failed { return Connection{} }
  if !listener.active {
    closed(status, "accept")
    return Connection{}
  }
  accepted := accept(status, listener.descriptor)
  if status.failed { return Connection{} }
  return connection_from_descriptor(accepted)
}

pub fn listener_close(listener: *Listener) {
  if !listener.active { return }
  descriptor := listener.descriptor
  // Never retry close: after a failure the descriptor may already be reused.
  listener.* = Listener{}
  close(descriptor)
}

pub fn connection_close(connection: *Connection) {
  if !connection.active { return }
  descriptor := connection.descriptor
  // Never retry close: after a failure the descriptor may already be reused.
  connection.* = Connection{}
  close(descriptor)
}

// Reads what is available, up to destination; 0 at the end of the stream.
pub fn connection_read(status: *fail.Status, connection: *Connection, destination: []u8) usize {
  if status == nil { return connection_read(&fail.Status{}, connection, destination) }
  if status.failed { return 0 }
  if !connection.active {
    closed(status, "read")
    return 0
  }
  return receive(status, connection.descriptor, destination, 0)
}

// Writes all of source; the count written, short only after a failure.
pub fn connection_write(status: *fail.Status, connection: *Connection, source: []const u8) usize {
  if status == nil { return connection_write(&fail.Status{}, connection, source) }
  if status.failed { return 0 }
  if !connection.active {
    closed(status, "write")
    return 0
  }
  total: usize = 0
  for total < source.len {
    sent := send(status, connection.descriptor, source[total..], 0)
    if status.failed { return total }
    if sent == 0 {
      failure := fail.make(fail.Kind.InvalidState, "write", "", "the connection accepts no more bytes")
      failure.native = -32
      fail.set(status, failure)
      return total
    }
    total += sent
  }
  return total
}

fn connection_reader_read(data: rawptr, status: *fail.Status, destination: []u8) usize {
  return connection_read(status, #cast(*Connection, data), destination)
}

fn connection_writer_write(data: rawptr, status: *fail.Status, source: []const u8) usize {
  return connection_write(status, #cast(*Connection, data), source)
}

pub fn connection_reader(connection: *Connection) io.Reader {
  return io.Reader{ data: connection, read: connection_reader_read }
}

pub fn connection_writer(connection: *Connection) io.Writer {
  return io.Writer{ data: connection, write: connection_writer_write }
}

// Accepts one connection and records its peer address. nonblocking sets the
// new socket nonblocking in the same step where the platform allows it.
// The new descriptor, or -1 after a failure.
pub fn accept_address(status: *fail.Status, descriptor: isize, address: *Address, nonblocking: bool) isize {
  if status == nil { return accept_address(&fail.Status{}, descriptor, address, nonblocking) }
  if status.failed { return -1 }
  length: u32 = 128
  value := check(status, "accept", native_accept(descriptor, &address.bytes[0], &length, nonblocking))
  if value >= 0 {
    address.length = length
  }
  return value
}

// Like accept_address on a nonblocking listener, where no pending
// connection is no failure: -1 with blocked true.
pub fn try_accept_address(status: *fail.Status, descriptor: isize, address: *Address, nonblocking: bool) Accepted {
  if status == nil { return try_accept_address(&fail.Status{}, descriptor, address, nonblocking) }
  if status.failed { return Accepted{ descriptor: -1 } }
  length: u32 = 128
  value := native_accept(descriptor, &address.bytes[0], &length, nonblocking)
  if value < 0 {
    if native_would_block(value) { return Accepted{ descriptor: -1, blocked: true } }
    fail.set(status, native_failure("accept", value))
    return Accepted{ descriptor: -1 }
  }
  address.length = length
  return Accepted{ descriptor: value }
}
pub struct Accepted { descriptor: isize, blocked: bool }

pub fn local_address(status: *fail.Status, descriptor: isize, address: *Address) {
  if status == nil {
    local_address(&fail.Status{}, descriptor, address)
    return
  }
  if status.failed { return }
  length: u32 = 128
  if check(status, "local address", native_local(descriptor, &address.bytes[0], &length)) >= 0 {
    address.length = length
  }
}

pub fn peer_address(status: *fail.Status, descriptor: isize, address: *Address) {
  if status == nil {
    peer_address(&fail.Status{}, descriptor, address)
    return
  }
  if status.failed { return }
  length: u32 = 128
  if check(status, "peer address", native_peer(descriptor, &address.bytes[0], &length)) >= 0 {
    address.length = length
  }
}

// Sends what the socket takes now, up to all of bytes; the count sent.
pub fn send(status: *fail.Status, descriptor: isize, bytes: []const u8, flags: usize) usize {
  if status == nil { return send(&fail.Status{}, descriptor, bytes, flags) }
  if status.failed || bytes.len == 0 { return 0 }
  value := send_native(descriptor, bytes, flags)
  if check(status, "send", value) < 0 { return 0 }
  return #cast(usize, value)
}

// Receives what is available, up to bytes; 0 at the end of a stream.
pub fn receive(status: *fail.Status, descriptor: isize, bytes: []u8, flags: usize) usize {
  if status == nil { return receive(&fail.Status{}, descriptor, bytes, flags) }
  if status.failed || bytes.len == 0 { return 0 }
  value := receive_native(descriptor, bytes, flags)
  if check(status, "receive", value) < 0 { return 0 }
  return #cast(usize, value)
}

// For nonblocking sockets, where a socket that is not ready is no failure:
// count is 0 and blocked is true. Otherwise as send and receive.
pub struct Attempt { count: usize, blocked: bool }
pub fn try_send(status: *fail.Status, descriptor: isize, bytes: []const u8, flags: usize) Attempt {
  if status == nil { return try_send(&fail.Status{}, descriptor, bytes, flags) }
  if status.failed || bytes.len == 0 { return Attempt{} }
  value := send_native(descriptor, bytes, flags)
  if value < 0 {
    if native_would_block(value) { return Attempt{ blocked: true } }
    fail.set(status, native_failure("send", value))
    return Attempt{}
  }
  return Attempt{ count: #cast(usize, value) }
}
pub fn try_receive(status: *fail.Status, descriptor: isize, bytes: []u8, flags: usize) Attempt {
  if status == nil { return try_receive(&fail.Status{}, descriptor, bytes, flags) }
  if status.failed || bytes.len == 0 { return Attempt{} }
  value := receive_native(descriptor, bytes, flags)
  if value < 0 {
    if native_would_block(value) { return Attempt{ blocked: true } }
    fail.set(status, native_failure("receive", value))
    return Attempt{}
  }
  return Attempt{ count: #cast(usize, value) }
}

fn send_native(descriptor: isize, bytes: []const u8, flags: usize) isize {
  // MSG_NOSIGNAL keeps a disconnected peer a failure instead of a signal.
  flags = flags | NoSignalFlag
  value := native_send(descriptor, &bytes[0], bytes.len, flags, nil, 0)
  for native_interrupted(value) {
    value = native_send(descriptor, &bytes[0], bytes.len, flags, nil, 0)
  }
  return value
}
fn receive_native(descriptor: isize, bytes: []u8, flags: usize) isize {
  value := native_receive(descriptor, &bytes[0], bytes.len, flags, nil, nil)
  for native_interrupted(value) {
    value = native_receive(descriptor, &bytes[0], bytes.len, flags, nil, nil)
  }
  return value
}

// Sends one datagram to address; the count sent.
pub fn send_to(status: *fail.Status, descriptor: isize, bytes: []const u8, flags: usize, address: []const u8) usize {
  if status == nil { return send_to(&fail.Status{}, descriptor, bytes, flags, address) }
  if status.failed { return 0 }
  if address.len == 0 {
    invalid(status, "send", "empty address")
    return 0
  }
  // Empty UDP payloads are packets too; the kernel accepts a null buffer.
  data: *const u8 = nil
  if bytes.len > 0 {
    data = &bytes[0]
  }
  // This entry point can also send through a connected stream socket.
  flags = flags | NoSignalFlag
  value := native_send(descriptor, data, bytes.len, flags, &address[0], address.len)
  for native_interrupted(value) {
    value = native_send(descriptor, data, bytes.len, flags, &address[0], address.len)
  }
  if check(status, "send", value) < 0 { return 0 }
  return #cast(usize, value)
}

// Receives one datagram and its sender's address; the count received.
pub fn receive_from(status: *fail.Status, descriptor: isize, bytes: []u8, flags: usize, address: []u8, address_length: *u32) usize {
  if status == nil { return receive_from(&fail.Status{}, descriptor, bytes, flags, address, address_length) }
  if status.failed || bytes.len == 0 { return 0 }
  address_raw: *u8 = nil
  if address.len > 0 {
    address_raw = &address[0]
    address_length.* = #cast(u32, address.len)
  }
  value := native_receive(descriptor, &bytes[0], bytes.len, flags, address_raw, address_length)
  for native_interrupted(value) {
    value = native_receive(descriptor, &bytes[0], bytes.len, flags, address_raw, address_length)
  }
  if check(status, "receive", value) < 0 { return 0 }
  return #cast(usize, value)
}

fn flag_option(status: *fail.Status, operation: []const u8, descriptor: isize, level: usize, option: usize, enabled: bool) {
  if status.failed { return }
  value: i32 = 0
  if enabled {
    value = 1
  }
  _ = check(status, operation, native_set_option(descriptor, level, option, &value, #sizeof(i32)))
}

pub fn reuse_address(status: *fail.Status, descriptor: isize, enabled: bool) {
  if status == nil {
    reuse_address(&fail.Status{}, descriptor, enabled)
    return
  }
  flag_option(status, "reuse address", descriptor, SocketLevel, ReuseOption, enabled)
}

// TCP_NODELAY: send small segments at once instead of waiting for the peer's
// ACK. Request/response servers want this; bulk senders usually do not.
pub fn no_delay(status: *fail.Status, descriptor: isize, enabled: bool) {
  if status == nil {
    no_delay(&fail.Status{}, descriptor, enabled)
    return
  }
  flag_option(status, "no delay", descriptor, TcpLevel, NoDelayOption, enabled)
}

// SO_REUSEPORT with kernel load balancing. Unsupported where the platform has
// only the non-balancing variant (macOS) or none (Windows).
pub fn reuse_port(status: *fail.Status, descriptor: isize, enabled: bool) {
  if status == nil {
    reuse_port(&fail.Status{}, descriptor, enabled)
    return
  }
  if status.failed { return }
  if ReusePortOption == 0 {
    failure := fail.make(fail.Kind.Unsupported, "reuse port", "", "this system has no balancing SO_REUSEPORT")
    failure.native = -95
    fail.set(status, failure)
    return
  }
  flag_option(status, "reuse port", descriptor, SocketLevel, ReusePortOption, enabled)
}

// Completes a nonblocking connect: the connect's failure, read from SO_ERROR.
pub fn socket_error(status: *fail.Status, descriptor: isize) {
  if status == nil {
    socket_error(&fail.Status{}, descriptor)
    return
  }
  if status.failed { return }
  error: i32 = 0
  length: u32 = #cast(u32, #sizeof(i32))
  queried := native_get_option(descriptor, SocketLevel, ErrorOption, &error, &length)
  if check(status, "connect", queried) < 0 { return }
  if error != 0 {
    _ = check(status, "connect", 0 - #cast(isize, error))
  }
}

pub fn nonblocking(status: *fail.Status, descriptor: isize, enabled: bool) {
  if status == nil {
    nonblocking(&fail.Status{}, descriptor, enabled)
    return
  }
  if status.failed { return }
  _ = check(status, "set nonblocking", native_nonblocking(descriptor, enabled))
}
pub fn receive_timeout(status: *fail.Status, descriptor: isize, milliseconds: usize) {
  if status == nil {
    receive_timeout(&fail.Status{}, descriptor, milliseconds)
    return
  }
  if status.failed { return }
  _ = check(status, "set receive timeout", native_timeout(descriptor, milliseconds, false))
}
pub fn send_timeout(status: *fail.Status, descriptor: isize, milliseconds: usize) {
  if status == nil {
    send_timeout(&fail.Status{}, descriptor, milliseconds)
    return
  }
  if status.failed { return }
  _ = check(status, "set send timeout", native_timeout(descriptor, milliseconds, true))
}

// Whether a failure is a socket timeout or a nonblocking socket that was not
// ready, rather than a broken connection.
pub fn would_block(failure: *const fail.Failure) bool {
  return failure.kind == fail.Kind.WouldBlock || native_would_block(failure.native)
}

// Called only after EINTR for finite waits: the milliseconds left, rounded
// up so converting back cannot expire the deadline early; 0 once expired.
fn interrupted_timeout(start: clock.Instant, milliseconds: i32) i32 {
  elapsed := clock.elapsed(start, clock.monotonic_now())
  duration := milliseconds * clock.Millisecond
  if elapsed >= duration { return 0 }
  if elapsed < 0 { return milliseconds }
  return #cast(i32, ((duration - elapsed + clock.Millisecond - 1) / clock.Millisecond))
}

// Waits for readiness on descriptors; the number ready, 0 on timeout. A
// negative timeout waits indefinitely, zero polls.
pub fn poll(status: *fail.Status, descriptors: []PollDescriptor, timeout_milliseconds: i32) usize {
  if status == nil { return poll(&fail.Status{}, descriptors, timeout_milliseconds) }
  if status.failed { return 0 }
  start := clock.Instant{}
  if timeout_milliseconds > 0 {
    start = clock.monotonic_now()
  }
  remaining := timeout_milliseconds
  value := poll_native(descriptors, remaining)
  for native_interrupted(value) {
    if timeout_milliseconds > 0 {
      remaining = interrupted_timeout(start, timeout_milliseconds)
      if remaining == 0 {
        for i in 0..descriptors.len {
          descriptors[i].returned = 0
        }
        return 0
      }
    }
    value = poll_native(descriptors, remaining)
  }
  if check(status, "poll", value) < 0 { return 0 }
  return #cast(usize, value)
}

// Waits for events on one descriptor: the events that happened, 0 on timeout.
pub fn wait(status: *fail.Status, descriptor: isize, events: i16, timeout_milliseconds: i32) i16 {
  if status == nil { return wait(&fail.Status{}, descriptor, events, timeout_milliseconds) }
  item := PollDescriptor{ descriptor: #cast(Descriptor, descriptor), events: events, returned: 0 }
  if poll(status, #slice(&item, 1), timeout_milliseconds) == 0 { return 0 }
  return item.returned
}

pub fn poll_has(item: *const PollDescriptor, events: i16) bool {
  return (item.returned & events) != 0
}



// The IP of an IPv4 or IPv6 socket address: 4 or 16 bytes in network order,
// and the port. Empty bytes for other families.
pub struct Ip { bytes: [16]u8, length: usize, port: u16 }

pub fn address_ip(address: *const Address) Ip {
  result := Ip{}
  if address.length < 8 { return result }
  family := read_family(address.bytes[..])
  result.port = #cast(u16, address.bytes[2]) << 8 | #cast(u16, address.bytes[3])
  if family == AddressFamilyIpv4 {
    for i in 0..4 {
      result.bytes[i] = address.bytes[4 + i]
    }
    result.length = 4
  } else if family == AddressFamilyIpv6 && address.length >= 24 {
    for i in 0..16 {
      result.bytes[i] = address.bytes[8 + i]
    }
    result.length = 16
  }
  return result
}

fn put_decimal(destination: []u8, at: usize, value: u32) usize {
  digits: [10]u8
  count: usize = 0
  rest := value
  for true {
    digits[count] = #cast(u8, '0' + rest % 10)
    count += 1
    rest /= 10
    if rest == 0 { break }
  }
  position := at
  for i in 0..count {
    if position < destination.len {
      destination[position] = digits[count - 1 - i]
    }
    position += 1
  }
  return position
}

// The IP as text: dotted IPv4, or IPv6 in RFC 5952 form (lowercase, the
// longest run of zero groups as ::). Empty when destination is shorter than
// 46 bytes or ip is empty.
pub fn ip_text(destination: []u8, ip: Ip) []u8 {
  if destination.len < 46 || (ip.length != 4 && ip.length != 16) { return destination[..0] }
  at: usize = 0
  if ip.length == 4 {
    for i in 0..4 {
      if i > 0 {
        destination[at] = '.'
        at += 1
      }
      at = put_decimal(destination, at, ip.bytes[i])
    }
    return destination[..at]
  }
  groups: [8]u32
  for i in 0..8 {
    groups[i] = #cast(u32, ip.bytes[2 * i]) << 8 | #cast(u32, ip.bytes[2 * i + 1])
  }
  best_start: usize = 8
  best_length: usize = 0
  i: usize = 0
  for i < 8 {
    if groups[i] != 0 {
      i += 1
      continue
    }
    start := i
    for i < 8 && groups[i] == 0 {
      i += 1
    }
    if i - start > best_length && i - start >= 2 {
      best_start = start
      best_length = i - start
    }
  }
  digits := "0123456789abcdef"
  g: usize = 0
  for g < 8 {
    if g == best_start {
      destination[at] = ':'
      destination[at + 1] = ':'
      at += 2
      g += best_length
      continue
    }
    if g > 0 && g != best_start + best_length {
      destination[at] = ':'
      at += 1
    }
    value := groups[g]
    started := false
    for shift in 0..4 {
      nibble := (value >> #cast(u32, 12 - 4 * shift)) & 15
      if nibble != 0 || started || shift == 3 {
        destination[at] = digits[nibble]
        at += 1
        started = true
      }
    }
    g += 1
  }
  return destination[..at]
}
