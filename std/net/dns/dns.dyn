use mem "std/mem"
use network "std/net"
use io "std/io"
use "std/fail"
use random "std/crypto/random"
use time "std/time"
use bytes "std/bytes"

pub struct Ipv4 { a: u8, b: u8, c: u8, d: u8 }
pub struct Ipv6 { bytes: [16]u8 }

// Reject borrowed input anywhere in pending backing, before typed pushes zero it.
fn conflicts(arena: *mem.Arena, input: []const u8) bool {
  return mem.arena_overlaps_unallocated(arena, input)
}

fn load_u16(data: []const u8, offset: usize) u16 {
  return #cast(u16, data[offset]) * 256 + #cast(u16, data[offset + 1])
}
fn store_u16(data: []u8, offset: usize, value: u16) {
  data[offset] = (value >> 8)
  data[offset + 1] = #cast(u8, value)
}
struct Name { end: usize, length: usize, ok: bool, offset: usize }
fn read_name(packet: []const u8, start: usize, destination: []u8) Name {
  cursor := start
  end: usize = 0
  used: usize = 0
  hops: usize = 0
  for cursor < packet.len && hops < 128 {
    length := packet[cursor]
    if length == 0 {
      if end == 0 {
        end = cursor + 1
      }
      return Name{ end: end, length: used, ok: true }
    }
    if (length & 192) == 192 {
      if cursor + 1 >= packet.len { return Name{} }
      target := #cast(usize, (length & 63)) * 256 + #cast(usize, packet[cursor + 1])
      // RFC compression points to a prior occurrence. This also excludes cycles.
      if target < 12 || target >= cursor { return Name{} }
      if end == 0 {
        end = cursor + 2
      }
      cursor = target
      hops += 1
    } else {
      amount := #cast(usize, length)
      if length > 63 || amount > packet.len - cursor - 1 { return Name{} }
      if used == destination.len { return Name{} }
      destination[used] = length
      used += 1
      if amount > destination.len - used { return Name{} }
      for i in 0..amount {
        byte := packet[cursor + 1 + i]
        if byte >= 'A' && byte <= 'Z' {
          byte += 32
        }
        destination[used + i] = byte
      }
      used += amount
      cursor += amount + 1
      hops += 1
    }
  }
  return Name{}
}
fn skip_name(packet: []const u8, start: usize) usize {
  storage: [254]u8
  parsed := read_name(packet, start, storage[..])
  if !parsed.ok { return 0 }
  return parsed.end
}
fn question_matches(packet: []const u8, name: []const u8) bool {
  storage: [254]u8
  parsed := read_name(packet, 12, storage[..])
  encoded: [512]u8
  canonical: [254]u8
  request := query(encoded[..], name, 0, 1)
  if request.len == 0 { return false }
  expected := read_name(request, 12, canonical[..])
  return parsed.ok && expected.ok && same_name(storage[..parsed.length], canonical[..expected.length])
}

// An A query for name, in arena. A name that is not a valid DNS name, or that
// lies in the arena's free space, fails with InvalidInput.
pub fn query_ipv4(arena: *mem.Arena, name: []const u8, identifier: u16) []u8!io.IoErr {
  return try query_arena(arena, name, identifier, 1)
}
// An AAAA query for name, in arena, by the rules of query_ipv4.
pub fn query_ipv6(arena: *mem.Arena, name: []const u8, identifier: u16) []u8!io.IoErr {
  return try query_arena(arena, name, identifier, 28)
}
fn query_arena(arena: *mem.Arena, name: []const u8, identifier: u16, kind: u16) []u8!io.IoErr {
  if conflicts(arena, name) { fail .InvalidInput }
  storage: [272]u8
  encoded := query(storage[..], name, identifier, kind)
  if encoded.len == 0 { fail .InvalidInput }
  output := mem.push_bytes(arena, encoded.len)
  _ = mem.copy(output, encoded)
  return output
}
fn query(destination: []u8, name: []const u8, identifier: u16, kind: u16) []u8 {
  if destination.len < 17 || name.len == 0 || name.len > 253 { return destination[..0] }
  for i in 0..12 {
    destination[i] = 0
  }
  store_u16(destination, 0, identifier)
  store_u16(destination, 2, 256)
  store_u16(destination, 4, 1)
  input: usize = 0
  output: usize = 12
  for input < name.len {
    label_start := input
    for input < name.len && name[input] != '.' {
      input += 1
    }
    length := input - label_start
    if length == 0 || length > 63 || output + 1 + length + 5 > destination.len {
      return destination[..0]
    }
    destination[output] = #cast(u8, length)
    output += 1
    for j in 0..length {
      destination[output + j] = name[label_start + j]
    }
    output += length
    if input < name.len {
      input += 1
    }
  }
  destination[output] = 0
  store_u16(destination, output + 1, kind)
  store_u16(destination, output + 3, 1)
  return destination[..output + 5]
}

// Complete arena-owned answers, invalidated by rewind/reset/release. Failures
// publish no addresses and consume no arena bytes. Exhaustion panics. A
// malformed response fails with InvalidInput; a DNS error code with NotFound
// (NXDOMAIN) or System(-code).
pub fn parse_ipv4(arena: *mem.Arena, packet: []const u8, identifier: u16, name: []const u8) []Ipv4!io.IoErr {
  empty4: []Ipv4
  empty6: []Ipv6
  if conflicts(arena, packet) || conflicts(arena, name) { fail .InvalidInput }
  count := try parse(packet, identifier, name, empty4, empty6, 1, false)
  output := mem.push_array<Ipv4>(arena, count)
  _ = try parse(packet, identifier, name, output, empty6, 1, true)
  return output
}
pub fn parse_ipv6(arena: *mem.Arena, packet: []const u8, identifier: u16, name: []const u8) []Ipv6!io.IoErr {
  empty4: []Ipv4
  empty6: []Ipv6
  if conflicts(arena, packet) || conflicts(arena, name) { fail .InvalidInput }
  count := try parse(packet, identifier, name, empty4, empty6, 28, false)
  output := mem.push_array<Ipv6>(arena, count)
  _ = try parse(packet, identifier, name, empty4, output, 28, true)
  return output
}
fn same_name(left: []const u8, right: []const u8) bool {
  if left.len != right.len { return false }
  for i in 0..left.len {
    if left[i] != right[i] { return false }
  }
  return true
}
// Resolve the answer's canonical owner before collecting addresses. Re-scan the
// bounded packet so records may arrive in any order without heap allocation.
fn canonical_owner(packet: []const u8, start: usize, answers: usize, owner: []u8) Name {
  current := read_name(packet, 12, owner)
  if !current.ok { return Name{offset: 12} }
  hop: usize = 0
  for hop <= answers && hop < 128 {
    cursor := start
    index: usize = 0
    found: bool = false
    target_length: usize = 0
    target: [254]u8
    for index < answers {
      record_start := cursor
      record_name: [254]u8
      parsed := read_name(packet, cursor, record_name[..])
      if !parsed.ok || parsed.end + 10 > packet.len { return Name{offset: record_start} }
      cursor = parsed.end
      kind := load_u16(packet, cursor)
      class := load_u16(packet, cursor + 2)
      length := #cast(usize, load_u16(packet, cursor + 8))
      cursor += 10
      if length > packet.len - cursor { return Name{offset: record_start} }
      if kind == 5 && class == 1 && same_name(record_name[..parsed.length], owner[..current.length]) {
        candidate: [254]u8
        alias := read_name(packet, cursor, candidate[..])
        if !alias.ok || alias.end != cursor + length { return Name{offset: record_start} }
        if found && !same_name(target[..target_length], candidate[..alias.length]) {
          return Name{offset: record_start}
        }
        target_length = alias.length
        for j in 0..target_length {
          target[j] = candidate[j]
        }
        found = true
      }
      cursor += length
      index += 1
    }
    if !found { return current }
    for k in 0..target_length {
      owner[k] = target[k]
    }
    current.length = target_length
    hop += 1
  }
  return Name{offset: start}
}
// A malformed response fails with InvalidInput.
fn parse(packet: []const u8, identifier: u16, name: []const u8, addresses: []Ipv4, ipv6: []Ipv6, query_kind: u16, writing: bool) usize!io.IoErr {
  if packet.len < 12 { fail .InvalidInput }
  if load_u16(packet, 0) != identifier { fail .InvalidInput }
  if (load_u16(packet, 2) & 32768) == 0 { fail .InvalidInput }
  flags := load_u16(packet, 2)
  if (flags & 31232) != 0 { fail .InvalidInput }
  if (flags & 15) != 0 {
    code := flags & 15
    // NXDOMAIN.
    if code == 3 { fail .NotFound }
    fail io.IoErr.System(0 - #cast(isize, code))
  }
  questions := #cast(usize, load_u16(packet, 4))
  answers := #cast(usize, load_u16(packet, 6))
  if questions != 1 { fail .InvalidInput }
  if !question_matches(packet, name) { fail .InvalidInput }
  cursor: usize = 12
  for q in 0..questions {
    cursor = skip_name(packet, cursor)
    if cursor == 0 || cursor + 4 > packet.len { fail .InvalidInput }
    if load_u16(packet, cursor) != query_kind || load_u16(packet, cursor + 2) != 1 {
      fail .InvalidInput
    }
    cursor += 4
  }
  scan := cursor
  for index in 0..answers {
    record := scan
    end := skip_name(packet, scan)
    if end == 0 || end + 10 > packet.len { fail .InvalidInput }
    length := #cast(usize, load_u16(packet, end + 8))
    scan = end + 10
    if length > packet.len - scan { fail .InvalidInput }
    kind := load_u16(packet, end)
    if load_u16(packet, end + 2) == 1 {
      if (kind == 1 && length != 4) || (kind == 28 && length != 16) { fail .InvalidInput }
      if kind == 5 {
        target := skip_name(packet, scan)
        if target == 0 || target != scan + length { fail .InvalidInput }
      }
    }
    scan += length
  }
  owner: [254]u8
  canonical := canonical_owner(packet, cursor, answers, owner[..])
  if !canonical.ok { fail .InvalidInput }
  count: usize = 0
  for answer in 0..answers {
    record_owner: [254]u8
    parsed_owner := read_name(packet, cursor, record_owner[..])
    if !parsed_owner.ok { fail .InvalidInput }
    matches := same_name(record_owner[..parsed_owner.length], owner[..canonical.length])
    cursor = parsed_owner.end
    if cursor == 0 || cursor + 10 > packet.len { fail .InvalidInput }
    kind := load_u16(packet, cursor)
    class := load_u16(packet, cursor + 2)
    length := #cast(usize, load_u16(packet, cursor + 8))
    cursor += 10
    if cursor + length > packet.len { fail .InvalidInput }
    if matches && kind == 1 && query_kind == 1 && class == 1 && length == 4 {
      if writing {
        addresses[count] = Ipv4{ a: packet[cursor], b: packet[cursor + 1], c: packet[cursor + 2], d: packet[cursor + 3] }
      }
      count += 1
    }
    if matches && kind == 28 && query_kind == 28 && class == 1 && length == 16 {
      if writing {
        for i in 0..16 {
          ipv6[count].bytes[i] = packet[cursor + i]
        }
      }
      count += 1
    }
    cursor += length
  }
  return count
}

// The server transport address is IPv4; IPv6 refers to AAAA result records.
// One deadline covers UDP, TCP connect, framing, and every partial transfer.
// Running out of time fails with Interrupted.
pub fn resolve_ipv4(arena: *mem.Arena, name: []const u8, server: *const network.Ipv4Address,
  timeout_milliseconds: i32) []Ipv4!io.IoErr {
  if conflicts(arena, name) { fail .InvalidInput }
  packet: [65535]u8
  received := try exchange(name, server, packet[..], timeout_milliseconds, 1)
  return try parse_ipv4(arena, packet[..received.length], received.identifier, name)
}
pub fn resolve_ipv6(arena: *mem.Arena, name: []const u8, server: *const network.Ipv4Address,
  timeout_milliseconds: i32) []Ipv6!io.IoErr {
  if conflicts(arena, name) { fail .InvalidInput }
  packet: [65535]u8
  received := try exchange(name, server, packet[..], timeout_milliseconds, 28)
  return try parse_ipv6(arena, packet[..received.length], received.identifier, name)
}

struct Packet { length: usize, identifier: u16 }

// Waits until descriptor is ready for events, within the deadline.
fn ready(descriptor: isize, events: i16, deadline: *const time.Deadline, finite: bool) !io.IoErr {
  timeout: i32 = -1
  if finite {
    remaining := time.deadline_remaining(deadline)
    if remaining == 0 { fail .Interrupted }
    timeout = #cast(i32, ((remaining + time.Millisecond - 1) / time.Millisecond))
  }
  if try network.wait(descriptor, events, timeout) == 0 { fail .Interrupted }
}
// A server that closes the connection early fails with InvalidInput.
fn transfer(descriptor: isize, buffer: []u8, sending: bool, deadline: *const time.Deadline, finite: bool) !io.IoErr {
  at: usize = 0
  for at < buffer.len {
    events := network.PollReadable
    if sending {
      events = network.PollWritable
    }
    try ready(descriptor, events, deadline, finite)
    moved := network.Attempt{}
    if sending {
      moved = try network.try_send(descriptor, buffer[at..], 0)
    } else {
      moved = try network.try_receive(descriptor, buffer[at..], 0)
    }
    if moved.blocked { continue }
    if moved.count == 0 { fail .InvalidInput }
    at += moved.count
  }
}
fn tcp(name: []const u8, server: *const network.Ipv4Address, packet: []u8,
  identifier: u16, kind: u16, deadline: *const time.Deadline, finite: bool) Packet!io.IoErr {
  request := query(packet, name, identifier, kind)
  if request.len == 0 { fail .InvalidInput }
  descriptor := try network.socket(network.AddressFamilyIpv4, network.SocketStream, 0)
  defer {
    network.close(descriptor)
  }
  try network.nonblocking(descriptor, true)
  pending := false
  network.connect_ipv4(descriptor, server) catch err {
    if !network.would_block(err) { fail err }
    pending = true
  }
  if pending {
    try ready(descriptor, network.PollWritable, deadline, finite)
    try network.socket_error(descriptor)
  }
  prefix: [2]u8
  store_u16(prefix[..], 0, #cast(u16, request.len))
  try transfer(descriptor, prefix[..], true, deadline, finite)
  try transfer(descriptor, request, true, deadline, finite)
  try transfer(descriptor, prefix[..], false, deadline, finite)
  length := #cast(usize, load_u16(prefix[..], 0))
  if length > packet.len { fail .Capacity }
  if length < 12 { fail .InvalidInput }
  try transfer(descriptor, packet[..length], false, deadline, finite)
  return Packet{ length: length, identifier: identifier }
}
fn exchange(name: []const u8, server: *const network.Ipv4Address, packet: []u8,
  timeout_milliseconds: i32, kind: u16) Packet!io.IoErr {
  finite := timeout_milliseconds >= 0
  deadline := time.Deadline{}
  if finite {
    deadline = time.deadline_after(timeout_milliseconds * time.Millisecond)
  }
  entropy: [2]u8
  drawing: fail.Status
  random.fill(&drawing, entropy[..])
  try io.check_status(&drawing)
  identifier := load_u16(entropy[..], 0)
  request := query(packet, name, identifier, kind)
  if request.len == 0 { fail .InvalidInput }
  descriptor := try network.socket(network.AddressFamilyIpv4, network.SocketDatagram, 0)
  defer {
    network.close(descriptor)
  }
  try network.nonblocking(descriptor, true)
  try network.connect_ipv4(descriptor, server)
  sent := try network.send(descriptor, request, 0)
  // The query was cut short: EIO.
  if sent != request.len { fail io.IoErr.System(-5) }
  for {
    try ready(descriptor, network.PollReadable, &deadline, finite)
    length := network.receive_packet(descriptor, packet) catch err {
      case err {
        .Interrupted => { continue }
        _ => {
          if network.would_block(err) { continue }
          fail err
        }
      }
    }
    stored := length
    if stored > packet.len {
      stored = packet.len
    }
    response := packet[..stored]
    if stored < 12 || load_u16(response, 0) != identifier || (load_u16(response, 2) & 32768) == 0 {
      continue
    }
    // The response does not answer the question.
    if (load_u16(response, 2) & 30720) != 0 || load_u16(response, 4) != 1 || !question_matches(response, name) { fail .InvalidInput }
    question_end := skip_name(response, 12)
    if question_end == 0 || question_end + 4 > stored || load_u16(response, question_end) != kind || load_u16(response, question_end + 2) != 1 { fail .InvalidInput }
    if length > packet.len || (load_u16(response, 2) & 512) != 0 {
      return try tcp(name, server, packet, identifier, kind, &deadline, finite)
    }
    return Packet{ length: length, identifier: identifier }
  }
  empty: Packet
  return empty
}
