use "std/mem" mem
use "std/net" network
use "std/io" io
use "std/fail"
use "std/crypto/random" random
use "std/time" time
use "std/bytes" bytes

pub struct Ipv4 { a: u8, b: u8, c: u8, d: u8 }
pub struct Ipv6 { bytes: [16]u8 }

// Records a malformed response, at offset when one applies.
fn malformed(status: *fail.Status, message: []const u8, offset: usize, located: bool) usize {
  failure := fail.make(fail.Kind.InvalidInput, "parse DNS response", "", message)
  failure.offset = offset
  failure.has_offset = located
  fail.set(status, failure)
  return 0
}

// Reject borrowed input anywhere in pending backing, before typed pushes zero it.
fn conflicts(arena: *mem.Arena, input: []const u8) bool {
  return mem.arena_overlaps_unallocated(arena, input)
}

fn load_u16(data: []const u8, offset: usize) u16 {
  return #cast(u16, data[offset]) * 256 + #cast(u16, data[offset + 1])
}
fn store_u16(data: []u8, offset: usize, value: u16) {
  data[offset] = (value >> 8)
  data[offset + 1] = #cast(u8, value)
}
struct Name { end: usize, length: usize, ok: bool, offset: usize }
fn read_name(packet: []const u8, start: usize, destination: []u8) Name {
  cursor := start
  end: usize = 0
  used: usize = 0
  hops: usize = 0
  for cursor < #len(packet) && hops < 128 {
    length := packet[cursor]
    if length == 0 {
      if end == 0 {
        end = cursor + 1
      }
      return Name{ end: end, length: used, ok: true }
    }
    if (length & 192) == 192 {
      if cursor + 1 >= #len(packet) { return Name{} }
      target := #cast(usize, (length & 63)) * 256 + #cast(usize, packet[cursor + 1])
      // RFC compression points to a prior occurrence. This also excludes cycles.
      if target < 12 || target >= cursor { return Name{} }
      if end == 0 {
        end = cursor + 2
      }
      cursor = target
      hops += 1
    } else {
      amount := #cast(usize, length)
      if length > 63 || amount > #len(packet) - cursor - 1 { return Name{} }
      if used == #len(destination) { return Name{} }
      destination[used] = length
      used += 1
      if amount > #len(destination) - used { return Name{} }
      for i in 0..amount {
        byte := packet[cursor + 1 + i]
        if byte >= 'A' && byte <= 'Z' {
          byte += 32
        }
        destination[used + i] = byte
      }
      used += amount
      cursor += amount + 1
      hops += 1
    }
  }
  return Name{}
}
fn skip_name(packet: []const u8, start: usize) usize {
  storage: [254]u8
  parsed := read_name(packet, start, storage[..])
  if !parsed.ok { return 0 }
  return parsed.end
}
fn question_matches(packet: []const u8, name: []const u8) bool {
  storage: [254]u8
  parsed := read_name(packet, 12, storage[..])
  encoded: [512]u8
  canonical: [254]u8
  request := query(encoded[..], name, 0, 1)
  if #len(request) == 0 { return false }
  expected := read_name(request, 12, canonical[..])
  return parsed.ok && expected.ok && same_name(storage[..parsed.length], canonical[..expected.length])
}

// An A query for name, in arena. Empty when name is not a valid DNS name.
pub fn query_ipv4(arena: *mem.Arena, name: []const u8, identifier: u16) []u8 {
  return query_arena(arena, name, identifier, 1)
}
// An AAAA query for name, in arena. Empty when name is not a valid DNS name.
pub fn query_ipv6(arena: *mem.Arena, name: []const u8, identifier: u16) []u8 {
  return query_arena(arena, name, identifier, 28)
}
fn query_arena(arena: *mem.Arena, name: []const u8, identifier: u16, kind: u16) []u8 {
  if conflicts(arena, name) {
    empty: []u8
    return empty
  }
  storage: [272]u8
  encoded := query(storage[..], name, identifier, kind)
  output := mem.push_bytes_uninit(arena, #len(encoded))
  _ = mem.copy(output, encoded)
  return output
}
fn query(destination: []u8, name: []const u8, identifier: u16, kind: u16) []u8 {
  if #len(destination) < 17 || #len(name) == 0 || #len(name) > 253 { return destination[..0] }
  for i in 0..12 {
    destination[i] = 0
  }
  store_u16(destination, 0, identifier)
  store_u16(destination, 2, 256)
  store_u16(destination, 4, 1)
  input: usize = 0
  output: usize = 12
  for input < #len(name) {
    label_start := input
    for input < #len(name) && name[input] != '.' {
      input += 1
    }
    length := input - label_start
    if length == 0 || length > 63 || output + 1 + length + 5 > #len(destination) {
      return destination[..0]
    }
    destination[output] = #cast(u8, length)
    output += 1
    for j in 0..length {
      destination[output + j] = name[label_start + j]
    }
    output += length
    if input < #len(name) {
      input += 1
    }
  }
  destination[output] = 0
  store_u16(destination, output + 1, kind)
  store_u16(destination, output + 3, 1)
  return destination[..output + 5]
}

// Complete arena-owned answers, invalidated by rewind/reset/release. Failures
// publish no addresses and consume no arena bytes. Exhaustion panics. A
// malformed response fails with InvalidInput at the malformed record (or
// header or question field); a DNS error code with NotFound (NXDOMAIN) or
// System, the negative code in native.
pub fn parse_ipv4(arena: *mem.Arena, status: *fail.Status, packet: []const u8, identifier: u16, name: []const u8) []Ipv4 {
  empty4: []Ipv4
  empty6: []Ipv6
  if status.failed { return empty4 }
  if conflicts(arena, packet) || conflicts(arena, name) {
    fail.invalid(status, "parse DNS response", name, "the input lies in the arena's free space")
    return empty4
  }
  count := parse(status, packet, identifier, name, empty4, empty6, 1, false)
  if status.failed { return empty4 }
  output := mem.push_array(Ipv4, arena, count)
  _ = parse(status, packet, identifier, name, output, empty6, 1, true)
  return output
}
pub fn parse_ipv6(arena: *mem.Arena, status: *fail.Status, packet: []const u8, identifier: u16, name: []const u8) []Ipv6 {
  empty4: []Ipv4
  empty6: []Ipv6
  if status.failed { return empty6 }
  if conflicts(arena, packet) || conflicts(arena, name) {
    fail.invalid(status, "parse DNS response", name, "the input lies in the arena's free space")
    return empty6
  }
  count := parse(status, packet, identifier, name, empty4, empty6, 28, false)
  if status.failed { return empty6 }
  output := mem.push_array(Ipv6, arena, count)
  _ = parse(status, packet, identifier, name, empty4, output, 28, true)
  return output
}
fn same_name(left: []const u8, right: []const u8) bool {
  if #len(left) != #len(right) { return false }
  for i in 0..#len(left) {
    if left[i] != right[i] { return false }
  }
  return true
}
// Resolve the answer's canonical owner before collecting addresses. Re-scan the
// bounded packet so records may arrive in any order without heap allocation.
fn canonical_owner(packet: []const u8, start: usize, answers: usize, owner: []u8) Name {
  current := read_name(packet, 12, owner)
  if !current.ok { return Name{offset: 12} }
  hop: usize = 0
  for hop <= answers && hop < 128 {
    cursor := start
    index: usize = 0
    found: bool = false
    target_length: usize = 0
    target: [254]u8
    for index < answers {
      record_start := cursor
      record_name: [254]u8
      parsed := read_name(packet, cursor, record_name[..])
      if !parsed.ok || parsed.end + 10 > #len(packet) { return Name{offset: record_start} }
      cursor = parsed.end
      kind := load_u16(packet, cursor)
      class := load_u16(packet, cursor + 2)
      length := #cast(usize, load_u16(packet, cursor + 8))
      cursor += 10
      if length > #len(packet) - cursor { return Name{offset: record_start} }
      if kind == 5 && class == 1 && same_name(record_name[..parsed.length], owner[..current.length]) {
        candidate: [254]u8
        alias := read_name(packet, cursor, candidate[..])
        if !alias.ok || alias.end != cursor + length { return Name{offset: record_start} }
        if found && !same_name(target[..target_length], candidate[..alias.length]) {
          return Name{offset: record_start}
        }
        target_length = alias.length
        for j in 0..target_length {
          target[j] = candidate[j]
        }
        found = true
      }
      cursor += length
      index += 1
    }
    if !found { return current }
    for k in 0..target_length {
      owner[k] = target[k]
    }
    current.length = target_length
    hop += 1
  }
  return Name{offset: start}
}
fn parse(status: *fail.Status, packet: []const u8, identifier: u16, name: []const u8, addresses: []Ipv4, ipv6: []Ipv6, query_kind: u16, writing: bool) usize {
  if #len(packet) < 12 { return malformed(status, "shorter than a header", #len(packet), true) }
  if load_u16(packet, 0) != identifier {
    return malformed(status, "the identifier does not match", 0, false)
  }
  if (load_u16(packet, 2) & 32768) == 0 { return malformed(status, "malformed response", 2, true) }
  flags := load_u16(packet, 2)
  if (flags & 31232) != 0 { return malformed(status, "malformed response", 2, true) }
  if (flags & 15) != 0 {
    code := flags & 15
    failure := fail.make(fail.Kind.System, "resolve", name, "the server failed")
    if code == 3 {
      failure = fail.make(fail.Kind.NotFound, "resolve", name, "no such name")
    }
    failure.native = 0 - #cast(isize, code)
    fail.set(status, failure)
    return 0
  }
  questions := #cast(usize, load_u16(packet, 4))
  answers := #cast(usize, load_u16(packet, 6))
  if questions != 1 { return malformed(status, "malformed response", 4, true) }
  if !question_matches(packet, name) { return malformed(status, "malformed response", 12, true) }
  cursor: usize = 12
  for q in 0..questions {
    cursor = skip_name(packet, cursor)
    if cursor == 0 || cursor + 4 > #len(packet) {
      return malformed(status, "malformed response", 12, true)
    }
    if load_u16(packet, cursor) != query_kind || load_u16(packet, cursor + 2) != 1 {
      return malformed(status, "malformed response", cursor, true)
    }
    cursor += 4
  }
  scan := cursor
  for index in 0..answers {
    record := scan
    end := skip_name(packet, scan)
    if end == 0 || end + 10 > #len(packet) {
      return malformed(status, "malformed response", record, true)
    }
    length := #cast(usize, load_u16(packet, end + 8))
    scan = end + 10
    if length > #len(packet) - scan { return malformed(status, "malformed response", record, true) }
    kind := load_u16(packet, end)
    if load_u16(packet, end + 2) == 1 {
      if (kind == 1 && length != 4) || (kind == 28 && length != 16) {
        return malformed(status, "malformed response", record, true)
      }
      if kind == 5 {
        target := skip_name(packet, scan)
        if target == 0 || target != scan + length {
          return malformed(status, "malformed response", record, true)
        }
      }
    }
    scan += length
  }
  owner: [254]u8
  canonical := canonical_owner(packet, cursor, answers, owner[..])
  if !canonical.ok { return malformed(status, "malformed response", canonical.offset, true) }
  count: usize = 0
  for answer in 0..answers {
    record_owner: [254]u8
    parsed_owner := read_name(packet, cursor, record_owner[..])
    if !parsed_owner.ok { return malformed(status, "malformed owner name", 0, false) }
    matches := same_name(record_owner[..parsed_owner.length], owner[..canonical.length])
    cursor = parsed_owner.end
    if cursor == 0 || cursor + 10 > #len(packet) {
      return malformed(status, "a record runs past the packet", cursor, true)
    }
    kind := load_u16(packet, cursor)
    class := load_u16(packet, cursor + 2)
    length := #cast(usize, load_u16(packet, cursor + 8))
    cursor += 10
    if cursor + length > #len(packet) {
      return malformed(status, "a record runs past the packet", cursor, true)
    }
    if matches && kind == 1 && query_kind == 1 && class == 1 && length == 4 {
      if writing {
        addresses[count] = Ipv4{ a: packet[cursor], b: packet[cursor + 1], c: packet[cursor + 2], d: packet[cursor + 3] }
      }
      count += 1
    }
    if matches && kind == 28 && query_kind == 28 && class == 1 && length == 16 {
      if writing {
        for i in 0..16 {
          ipv6[count].bytes[i] = packet[cursor + i]
        }
      }
      count += 1
    }
    cursor += length
  }
  return count
}

// The server transport address is IPv4; IPv6 refers to AAAA result records.
// One deadline covers UDP, TCP connect, framing, and every partial transfer.
pub fn resolve_ipv4(arena: *mem.Arena, status: *fail.Status, name: []const u8, server: *const network.Ipv4Address,
  timeout_milliseconds: i32) []Ipv4 {
  empty: []Ipv4
  if status.failed { return empty }
  if conflicts(arena, name) {
    fail.invalid(status, "resolve", name, "the name lies in the arena's free space")
    return empty
  }
  packet: [65535]u8
  received := exchange(status, name, server, packet[..], timeout_milliseconds, 1)
  if status.failed { return empty }
  return parse_ipv4(arena, status, packet[..received.length], received.identifier, name)
}
pub fn resolve_ipv6(arena: *mem.Arena, status: *fail.Status, name: []const u8, server: *const network.Ipv4Address,
  timeout_milliseconds: i32) []Ipv6 {
  empty: []Ipv6
  if status.failed { return empty }
  if conflicts(arena, name) {
    fail.invalid(status, "resolve", name, "the name lies in the arena's free space")
    return empty
  }
  packet: [65535]u8
  received := exchange(status, name, server, packet[..], timeout_milliseconds, 28)
  if status.failed { return empty }
  return parse_ipv6(arena, status, packet[..received.length], received.identifier, name)
}

struct Packet { length: usize, identifier: u16 }

fn timed_out(status: *fail.Status) {
  failure := fail.make(fail.Kind.Interrupted, "resolve", "", "timed out")
  failure.native = -110
  fail.set(status, failure)
}
fn exchange_failed(status: *fail.Status, kind: fail.Kind, message: []const u8, native: isize) Packet {
  failure := fail.make(kind, "resolve", "", message)
  failure.native = native
  fail.set(status, failure)
  return Packet{}
}

// Waits until descriptor is ready for events, within the deadline.
fn ready(status: *fail.Status, descriptor: isize, events: i16, deadline: *const time.Deadline, finite: bool) {
  timeout: i32 = -1
  if finite {
    remaining := time.deadline_remaining(deadline)
    if remaining == 0 {
      timed_out(status)
      return
    }
    timeout = #cast(i32, ((remaining + time.Millisecond - 1) / time.Millisecond))
  }
  if network.wait(status, descriptor, events, timeout) == 0 && !status.failed {
    timed_out(status)
  }
}
fn transfer(status: *fail.Status, descriptor: isize, buffer: []u8, sending: bool, deadline: *const time.Deadline, finite: bool) {
  at: usize = 0
  for at < #len(buffer) && !status.failed {
    events := network.PollReadable
    if sending {
      events = network.PollWritable
    }
    ready(status, descriptor, events, deadline, finite)
    if status.failed { return }
    moved := network.Attempt{}
    if sending {
      moved = network.try_send(status, descriptor, buffer[at..], 0)
    } else {
      moved = network.try_receive(status, descriptor, buffer[at..], 0)
    }
    if status.failed || moved.blocked { continue }
    if moved.count == 0 {
      failure := fail.make(fail.Kind.InvalidInput, "resolve", "", "the server closed the connection early")
      failure.native = -74
      fail.set(status, failure)
      return
    }
    at += moved.count
  }
}
fn tcp(status: *fail.Status, name: []const u8, server: *const network.Ipv4Address, packet: []u8,
  identifier: u16, kind: u16, deadline: *const time.Deadline, finite: bool) Packet {
  request := query(packet, name, identifier, kind)
  if #len(request) == 0 { return exchange_failed(status, fail.Kind.InvalidInput, "invalid name", -22) }
  descriptor := network.socket(status, network.AddressFamilyIpv4, network.SocketStream, 0)
  if status.failed { return Packet{} }
  defer {
    network.close(descriptor)
  }
  network.nonblocking(status, descriptor, true)
  if status.failed { return Packet{} }
  connecting: fail.Status
  network.connect_ipv4(&connecting, descriptor, server)
  if connecting.failed {
    if !network.would_block(&connecting.failure) {
      fail.set(status, connecting.failure)
      return Packet{}
    }
    ready(status, descriptor, network.PollWritable, deadline, finite)
    network.socket_error(status, descriptor)
    if status.failed { return Packet{} }
  }
  prefix: [2]u8
  store_u16(prefix[..], 0, #cast(u16, #len(request)))
  transfer(status, descriptor, prefix[..], true, deadline, finite)
  transfer(status, descriptor, request, true, deadline, finite)
  transfer(status, descriptor, prefix[..], false, deadline, finite)
  if status.failed { return Packet{} }
  length := #cast(usize, load_u16(prefix[..], 0))
  if length > #len(packet) { return exchange_failed(status, fail.Kind.Capacity, "the response is too large", -28) }
  if length < 12 { return exchange_failed(status, fail.Kind.InvalidInput, "the response is shorter than a header", -74) }
  transfer(status, descriptor, packet[..length], false, deadline, finite)
  if status.failed { return Packet{} }
  return Packet{ length: length, identifier: identifier }
}
fn exchange(status: *fail.Status, name: []const u8, server: *const network.Ipv4Address, packet: []u8,
  timeout_milliseconds: i32, kind: u16) Packet {
  finite := timeout_milliseconds >= 0
  deadline := time.Deadline{}
  if finite {
    deadline = time.deadline_after(timeout_milliseconds * time.Millisecond)
  }
  entropy: [2]u8
  if !random.fill(entropy[..]) { return exchange_failed(status, fail.Kind.System, "no random identifier", -5) }
  identifier := load_u16(entropy[..], 0)
  request := query(packet, name, identifier, kind)
  if #len(request) == 0 { return exchange_failed(status, fail.Kind.InvalidInput, "invalid name", -22) }
  descriptor := network.socket(status, network.AddressFamilyIpv4, network.SocketDatagram, 0)
  if status.failed { return Packet{} }
  defer {
    network.close(descriptor)
  }
  network.nonblocking(status, descriptor, true)
  network.connect_ipv4(status, descriptor, server)
  sent := network.send(status, descriptor, request, 0)
  if status.failed { return Packet{} }
  if sent != #len(request) { return exchange_failed(status, fail.Kind.System, "the query was cut short", -5) }
  for {
    ready(status, descriptor, network.PollReadable, &deadline, finite)
    if status.failed { return Packet{} }
    attempt: fail.Status
    length := network.receive_packet(&attempt, descriptor, packet)
    if attempt.failed {
      if attempt.failure.native == -4 || network.would_block(&attempt.failure) { continue }
      fail.set(status, attempt.failure)
      return Packet{}
    }
    stored := length
    if stored > #len(packet) {
      stored = #len(packet)
    }
    response := packet[..stored]
    if stored < 12 || load_u16(response, 0) != identifier || (load_u16(response, 2) & 32768) == 0 {
      continue
    }
    if (load_u16(response, 2) & 30720) != 0 || load_u16(response, 4) != 1 || !question_matches(response, name) {
      return exchange_failed(status, fail.Kind.InvalidInput, "the response does not answer the question", -74)
    }
    question_end := skip_name(response, 12)
    if question_end == 0 || question_end + 4 > stored || load_u16(response, question_end) != kind || load_u16(response, question_end + 2) != 1 {
      return exchange_failed(status, fail.Kind.InvalidInput, "the response does not answer the question", -74)
    }
    if length > #len(packet) || (load_u16(response, 2) & 512) != 0 {
      return tcp(status, name, server, packet, identifier, kind, &deadline, finite)
    }
    return Packet{ length: length, identifier: identifier }
  }
  return Packet{}
}
