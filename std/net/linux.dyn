#target(kernel: linux)
pub const AddressFamilyIpv6: usize = 10
pub type Descriptor = i32
pub struct PollDescriptor { descriptor: Descriptor, events: i16, returned: i16 }
const UnixPathLimit: usize = 107
const SocketLevel: usize = 1
const ReuseOption: usize = 2
const ErrorOption: usize = 4
const NoSignalFlag: usize = 16384
fn native_interrupted(code: isize) bool { return code == -4 }
fn native_would_block(code: isize) bool { return code == -11 || code == -115 }
fn address_family(bytes: []u8, length: usize, family: usize) {
  _ = length bytes[0] = #cast(u8) family
}
fn native_socket(family: usize, kind: usize, protocol: usize) isize { return #syscall(41, family, kind, protocol) }
fn native_close(descriptor: isize) isize { return #syscall(3, descriptor) }
fn native_listen(descriptor: isize, backlog: usize) isize { return #syscall(50, descriptor, backlog) }
fn native_shutdown(descriptor: isize, how: usize) isize { return #syscall(48, descriptor, how) }
fn native_connect(descriptor: isize, address: *const u8, length: usize) isize { return #syscall(42, descriptor, address, length) }
fn native_bind(descriptor: isize, address: *const u8, length: usize) isize { return #syscall(49, descriptor, address, length) }
fn native_accept(descriptor: isize, address: *u8, length: *u32) isize { return #syscall(43, descriptor, address, length) }
fn native_local(descriptor: isize, address: *u8, length: *u32) isize { return #syscall(51, descriptor, address, length) }
fn native_peer(descriptor: isize, address: *u8, length: *u32) isize { return #syscall(52, descriptor, address, length) }
fn native_send(descriptor: isize, data: *const u8, length: usize, flags: usize, address: *const u8, address_length: usize) isize { return #syscall(44, descriptor, data, length, flags, address, address_length) }
fn native_receive(descriptor: isize, data: *u8, length: usize, flags: usize, address: *u8, address_length: *u32) isize { return #syscall(45, descriptor, data, length, flags, address, address_length) }
fn native_set_option(descriptor: isize, level: usize, option: usize, data: rawptr, length: usize) isize { return #syscall(54, descriptor, level, option, #cast(usize) data, length) }
fn native_get_option(descriptor: isize, level: usize, option: usize, data: rawptr, length: *u32) isize { return #syscall(55, descriptor, level, option, #cast(usize) data, length) }
fn native_nonblocking(descriptor: isize, enabled: bool) isize {
  flags := #syscall(72, descriptor, 3, 0)
  if flags < 0 { return flags }
  if enabled { flags = flags | 2048 } else { flags = flags & ~2048 }
  return #syscall(72, descriptor, 4, flags)
}
struct TimeValue { seconds: isize, microseconds: isize }
fn native_timeout(descriptor: isize, milliseconds: usize, sending: bool) isize {
  if milliseconds / 1000 > 9223372036854775807 { return -22 }
  timeout := TimeValue{ seconds: #cast(isize) (milliseconds / 1000), microseconds: #cast(isize) ((milliseconds % 1000) * 1000) }
  option: usize = 20
  if sending { option = 21 }
  return native_set_option(descriptor, SocketLevel, option, &timeout, #sizeof(TimeValue))
}

// A value greater than capacity means the datagram was truncated.
pub fn receive_packet(descriptor: isize, bytes: []u8) Result {
  data: *u8 = nil if #len(bytes) > 0 { data = &bytes[0] }
  value := native_receive(descriptor, data, #len(bytes), 32, nil, nil)
  for value == -4 { value = native_receive(descriptor, data, #len(bytes), 32, nil, nil) }
  return result(value)
}
