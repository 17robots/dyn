#target(kernel: linux)
use "std/os/linux/sys"
pub const AddressFamilyIpv6: usize = 10
pub type Descriptor = i32
pub struct PollDescriptor { descriptor: Descriptor, events: i16, returned: i16 }
const UnixPathLimit: usize = 107
const SocketLevel: usize = 1
const ReuseOption: usize = 2
const ErrorOption: usize = 4
const TcpLevel: usize = 6
const NoDelayOption: usize = 1
// Zero: no load-balancing SO_REUSEPORT on this platform.
const ReusePortOption: usize = 15
const NoSignalFlag: usize = 16384
fn native_interrupted(code: isize) bool {
  return code == -4
}
fn native_would_block(code: isize) bool {
  return code == -11 || code == -115
}
fn address_family(bytes: []u8, _length: usize, family: usize) {
  bytes[0] = #cast(u8, family)
}
fn read_family(bytes: []const u8) usize {
  return bytes[0]
}
// SOCK_CLOEXEC: sockets, like files, do not leak into spawned programs.
fn native_socket(family: usize, kind: usize, protocol: usize) isize {
  return #syscall(sys.Socket, family, kind | 524288, protocol)
}
fn native_close(descriptor: isize) isize {
  return #syscall(sys.Close, descriptor)
}
fn native_listen(descriptor: isize, backlog: usize) isize {
  return #syscall(sys.Listen, descriptor, backlog)
}
fn native_shutdown(descriptor: isize, how: usize) isize {
  return #syscall(sys.Shutdown, descriptor, how)
}
fn native_connect(descriptor: isize, address: *const u8, length: usize) isize {
  return #syscall(sys.Connect, descriptor, address, length)
}
fn native_bind(descriptor: isize, address: *const u8, length: usize) isize {
  return #syscall(sys.Bind, descriptor, address, length)
}
// One accept4 sets SOCK_CLOEXEC, and SOCK_NONBLOCK when asked.
fn native_accept(descriptor: isize, address: *u8, length: *u32, nonblocking: bool) isize {
  flags: usize = 524288
  if nonblocking { flags = flags | 2048 }
  return #syscall(sys.Accept4, descriptor, address, length, flags)
}
fn native_local(descriptor: isize, address: *u8, length: *u32) isize {
  return #syscall(sys.Getsockname, descriptor, address, length)
}
fn native_peer(descriptor: isize, address: *u8, length: *u32) isize {
  return #syscall(sys.Getpeername, descriptor, address, length)
}
fn native_send(descriptor: isize, data: *const u8, length: usize, flags: usize, address: *const u8, address_length: usize) isize {
  return #syscall(sys.Sendto, descriptor, data, length, flags, address, address_length)
}
fn native_receive(descriptor: isize, data: *u8, length: usize, flags: usize, address: *u8, address_length: *u32) isize {
  return #syscall(sys.Recvfrom, descriptor, data, length, flags, address, address_length)
}
fn native_set_option(descriptor: isize, level: usize, option: usize, data: rawptr, length: usize) isize {
  return #syscall(sys.Setsockopt, descriptor, level, option, #cast(usize, data), length)
}
fn native_get_option(descriptor: isize, level: usize, option: usize, data: rawptr, length: *u32) isize {
  return #syscall(sys.Getsockopt, descriptor, level, option, #cast(usize, data), length)
}
fn native_nonblocking(descriptor: isize, enabled: bool) isize {
  flags := #syscall(sys.Fcntl, descriptor, 3, 0)
  if flags < 0 { return flags }
  if enabled { flags = flags | 2048 } else { flags = flags & ~2048 }
  return #syscall(sys.Fcntl, descriptor, 4, flags)
}
struct TimeValue { seconds: isize, microseconds: isize }
fn native_timeout(descriptor: isize, milliseconds: usize, sending: bool) isize {
  if milliseconds / 1000 > 9223372036854775807 { return -22 }
  timeout := TimeValue{ seconds: #cast(isize, (milliseconds / 1000)), microseconds: #cast(isize, ((milliseconds % 1000) * 1000)) }
  option: usize = 20
  if sending {
    option = 21
  }
  return native_set_option(descriptor, SocketLevel, option, &timeout, #sizeof(TimeValue))
}

// A value greater than capacity means the datagram was truncated.
pub fn receive_packet(status: *fail.Status, descriptor: isize, bytes: []u8) usize {
  if status.failed { return 0 }
  data: *u8 = nil
  if #len(bytes) > 0 {
    data = &bytes[0]
  }
  value := native_receive(descriptor, data, #len(bytes), 32, nil, nil)
  for value == -4 {
    value = native_receive(descriptor, data, #len(bytes), 32, nil, nil)
  }
  if check(status, "receive", value) < 0 { return 0 }
  return #cast(usize, value)
}

fn native_failure(operation: []const u8, code: isize) fail.Failure {
  return io.from_linux(operation, "", code)
}

const MulticastJoinOption: usize = 35
const MulticastLeaveOption: usize = 36
const MulticastInterfaceOption: usize = 32
const MulticastTtlOption: usize = 33
const MulticastLoopOption: usize = 34
fn native_multicast_byte(descriptor: isize, option: usize, value: u8) isize {
  native: u8 = value
  return native_set_option(descriptor, 0, option, &native, #sizeof(u8))
}
