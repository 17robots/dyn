pub struct Ipv4 {
  a: u8,
  b: u8,
  c: u8,
  d: u8,
}

pub struct DnsResult {
  count: usize,
  error: isize,
  ok: bool,
}

pub struct HttpHead {
  code: u16,
  header_length: usize,
  content_length: usize,
  keep_alive: bool,
  ok: bool,
}

pub struct HttpIoResult {
  count: usize,
  error: isize,
  ok: bool,
}

fn net_u16(bytes: []const u8, offset: usize) u16 {
  high: u16 = #cast(u16) bytes[offset]
  low: u16 = #cast(u16) bytes[offset + 1]
  return high * 256 + low
}

fn put_u16(bytes: []u8, offset: usize, value: u16) {
  bytes[offset] = #cast(u8) (value >> 8)
  bytes[offset + 1] = #cast(u8) value
}

fn dns_skip_name(packet: []const u8, start: usize) usize {
  cursor := start
  labels: usize = 0
  for cursor < #len(packet) && labels < 128 {
    length := packet[cursor]
    if length == 0 { return cursor + 1 }
    if (length & 192) == 192 {
      if cursor + 1 >= #len(packet) { return 0 }
      return cursor + 2
    }
    length_usize: usize = #cast(usize) length
    if length > 63 || cursor + 1 + length_usize > #len(packet) { return 0 }
    cursor += 1 + length_usize
    labels += 1
  }
  return 0
}

// Writes one RFC 1035 A query. Empty result means invalid name or insufficient storage.
pub fn dns_query_ipv4(destination: []u8, name: []const u8, identifier: u16) []u8 {
  if #len(destination) < 17 || #len(name) == 0 || #len(name) > 253 { return destination[..0] }
  i: usize = 0
  for i < 12 {
    destination[i] = 0
    i += 1
  }
  put_u16(destination, 0, identifier)
  put_u16(destination, 2, 256)
  put_u16(destination, 4, 1)
  input: usize = 0
  output: usize = 12
  for input < #len(name) {
    label_start := input
    for input < #len(name) && name[input] != '.' { input += 1 }
    length := input - label_start
    if length == 0 || length > 63 || output + 1 + length + 5 > #len(destination) { return destination[..0] }
    destination[output] = #cast(u8) length
    output += 1
    j: usize = 0
    for j < length {
      destination[output + j] = name[label_start + j]
      j += 1
    }
    output += length
    if input < #len(name) { input += 1 }
  }
  destination[output] = 0
  put_u16(destination, output + 1, 1)
  put_u16(destination, output + 3, 1)
  return destination[..output + 5]
}

// Parses A answers into caller storage. CNAME/unknown records are safely skipped.
pub fn dns_parse_ipv4(packet: []const u8, identifier: u16, addresses: []Ipv4) DnsResult {
  if #len(packet) < 12 || net_u16(packet, 0) != identifier || (net_u16(packet, 2) & 32768) == 0 {
    return DnsResult{ count: 0, error: -22, ok: false }
  }
  flags := net_u16(packet, 2)
  if (flags & 15) != 0 { return DnsResult{ count: 0, error: 0 - #cast(isize) (flags & 15), ok: false } }
  questions := #cast(usize) net_u16(packet, 4)
  answers := #cast(usize) net_u16(packet, 6)
  cursor: usize = 12
  q: usize = 0
  for q < questions {
    cursor = dns_skip_name(packet, cursor)
    if cursor == 0 || cursor + 4 > #len(packet) { return DnsResult{ count: 0, error: -22, ok: false } }
    cursor += 4
    q += 1
  }
  count: usize = 0
  answer: usize = 0
  for answer < answers {
    cursor = dns_skip_name(packet, cursor)
    if cursor == 0 || cursor + 10 > #len(packet) { return DnsResult{ count: count, error: -22, ok: false } }
    kind := net_u16(packet, cursor)
    class := net_u16(packet, cursor + 2)
    length := #cast(usize) net_u16(packet, cursor + 8)
    cursor += 10
    if cursor + length > #len(packet) { return DnsResult{ count: count, error: -22, ok: false } }
    if kind == 1 && class == 1 && length == 4 && count < #len(addresses) {
      addresses[count] = Ipv4{ a: packet[cursor], b: packet[cursor + 1], c: packet[cursor + 2], d: packet[cursor + 3] }
      count += 1
    }
    cursor += length
    answer += 1
  }
  return DnsResult{ count: count, error: 0, ok: true }
}

// Resolves through caller-selected IPv4 DNS server. Packet scratch is caller-owned.
pub fn resolve_ipv4(name: []const u8, server: *const Ipv4Address, addresses: []Ipv4, packet: []u8, timeout_milliseconds: i32) DnsResult {
  query := dns_query_ipv4(packet, name, 54849)
  if #len(query) == 0 { return DnsResult{ count: 0, error: -22, ok: false } }
  opened := socket(AddressFamilyIpv4, SocketDatagram, 0)
  if !opened.ok { return DnsResult{ count: 0, error: opened.error, ok: false } }
  descriptor := result_value(&opened)
  connected := connect_ipv4(descriptor, server)
  if !connected.ok {
    _ = close(descriptor)
    return DnsResult{ count: 0, error: connected.error, ok: false }
  }
  sent := send(descriptor, query, 0)
  if !sent.ok {
    _ = close(descriptor)
    return DnsResult{ count: 0, error: sent.error, ok: false }
  }
  ready := wait(descriptor, PollReadable, timeout_milliseconds)
  if !ready.ok || ready.value == 0 {
    _ = close(descriptor)
    return DnsResult{ count: 0, error: ready.error, ok: false }
  }
  received := receive(descriptor, packet, 0)
  _ = close(descriptor)
  if !received.ok { return DnsResult{ count: 0, error: received.error, ok: false } }
  return dns_parse_ipv4(packet[..#cast(usize) received.value], 54849, addresses)
}

fn append_bytes(destination: []u8, offset: usize, source: []const u8) usize {
  if offset > #len(destination) || #len(source) > #len(destination) - offset { return #len(destination) + 1 }
  i: usize = 0
  for i < #len(source) {
    destination[offset + i] = source[i]
    i += 1
  }
  return offset + #len(source)
}

fn append_usize(destination: []u8, offset: usize, value: usize) usize {
  digits: [20]u8 = []
  count: usize = 0
  number := value
  if number == 0 {
    digits[0] = '0'
    count = 1
  }
  for number > 0 {
    digit: u8 = #cast(u8) (number % 10)
    digits[count] = '0' + digit
    count += 1
    number /= 10
  }
  if offset > #len(destination) || count > #len(destination) - offset { return #len(destination) + 1 }
  i: usize = 0
  for i < count {
    destination[offset + i] = digits[count - i - 1]
    i += 1
  }
  return offset + count
}

pub fn http_write_request(destination: []u8, method: []const u8, target: []const u8, host: []const u8, body: []const u8) []u8 {
  offset := append_bytes(destination, 0, method)
  offset = append_bytes(destination, offset, " ")
  offset = append_bytes(destination, offset, target)
  offset = append_bytes(destination, offset, " HTTP/1.1\r\nHost: ")
  offset = append_bytes(destination, offset, host)
  offset = append_bytes(destination, offset, "\r\nConnection: close\r\nContent-Length: ")
  offset = append_usize(destination, offset, #len(body))
  offset = append_bytes(destination, offset, "\r\n\r\n")
  offset = append_bytes(destination, offset, body)
  if offset > #len(destination) { return destination[..0] }
  return destination[..offset]
}

pub fn http_write_response(destination: []u8, code: u16, reason: []const u8, content_type: []const u8, body: []const u8) []u8 {
  offset := append_bytes(destination, 0, "HTTP/1.1 ")
  offset = append_usize(destination, offset, #cast(usize) code)
  offset = append_bytes(destination, offset, " ")
  offset = append_bytes(destination, offset, reason)
  offset = append_bytes(destination, offset, "\r\nContent-Type: ")
  offset = append_bytes(destination, offset, content_type)
  offset = append_bytes(destination, offset, "\r\nConnection: close\r\nContent-Length: ")
  offset = append_usize(destination, offset, #len(body))
  offset = append_bytes(destination, offset, "\r\n\r\n")
  offset = append_bytes(destination, offset, body)
  if offset > #len(destination) { return destination[..0] }
  return destination[..offset]
}

fn ascii_lower(value: u8) u8 {
  if value >= 'A' && value <= 'Z' { return value + 32 }
  return value
}

fn starts_ascii_case(input: []const u8, at: usize, expected: []const u8) bool {
  if at > #len(input) || #len(expected) > #len(input) - at { return false }
  i: usize = 0
  for i < #len(expected) {
    if ascii_lower(input[at + i]) != ascii_lower(expected[i]) { return false }
    i += 1
  }
  return true
}

fn parse_decimal(input: []const u8, start: usize, end: usize) usize {
  value: usize = 0
  i := start
  if start == end { return 0 }
  for i < end {
    if input[i] < '0' || input[i] > '9' { return 0 }
    digit := #cast(usize) (input[i] - '0')
    if value > (18446744073709551615 - digit) / 10 { return 0 }
    value = value * 10 + digit
    i += 1
  }
  return value
}

fn http_parse_head(input: []const u8, response: bool) HttpHead {
  line_end: usize = 0
  for line_end + 1 < #len(input) && !(input[line_end] == '\r' && input[line_end + 1] == '\n') { line_end += 1 }
  if line_end + 1 >= #len(input) { return HttpHead{} }
  code: u16 = 0
  if response {
    if line_end < 12 || !starts_ascii_case(input, 0, "HTTP/1.") { return HttpHead{} }
    space: usize = 0
    for space < line_end && input[space] != ' ' { space += 1 }
    if space + 4 > line_end { return HttpHead{} }
    code = #cast(u16) parse_decimal(input, space + 1, space + 4)
    if code == 0 { return HttpHead{} }
  } else {
    if line_end < 10 || !starts_ascii_case(input, line_end - 8, "HTTP/1.") { return HttpHead{} }
  }
  cursor := line_end + 2
  content_length: usize = 0
  keep_alive := false
  for cursor + 1 < #len(input) {
    if input[cursor] == '\r' && input[cursor + 1] == '\n' {
      return HttpHead{ code: code, header_length: cursor + 2, content_length: content_length, keep_alive: keep_alive, ok: true }
    }
    end := cursor
    for end + 1 < #len(input) && !(input[end] == '\r' && input[end + 1] == '\n') { end += 1 }
    if end + 1 >= #len(input) { return HttpHead{} }
    if starts_ascii_case(input, cursor, "Content-Length:") {
      length_start := cursor + 15
      for length_start < end && (input[length_start] == ' ' || input[length_start] == '\t') { length_start += 1 }
      content_length = parse_decimal(input, length_start, end)
    }
    if starts_ascii_case(input, cursor, "Connection:") {
      connection_start := cursor + 11
      for connection_start < end && (input[connection_start] == ' ' || input[connection_start] == '\t') { connection_start += 1 }
      keep_alive = starts_ascii_case(input, connection_start, "keep-alive")
    }
    cursor = end + 2
  }
  return HttpHead{}
}

pub fn http_parse_response(input: []const u8) HttpHead { return http_parse_head(input, true) }
pub fn http_parse_request(input: []const u8) HttpHead { return http_parse_head(input, false) }

pub fn http_send_all(descriptor: isize, bytes: []const u8) HttpIoResult {
  count: usize = 0
  for count < #len(bytes) {
    sent := send(descriptor, bytes[count..], 0)
    if !sent.ok { return HttpIoResult{ count: count, error: sent.error, ok: false } }
    if sent.value == 0 { return HttpIoResult{ count: count, error: -32, ok: false } }
    count += #cast(usize) sent.value
  }
  return HttpIoResult{ count: count, error: 0, ok: true }
}

// Plain HTTP/1 over IPv4. No TLS, redirects, chunk decoding, or implicit allocation.
pub fn http_exchange_ipv4(address: *const Ipv4Address, request: []const u8, response: []u8, timeout_milliseconds: i32) HttpIoResult {
  opened := socket(AddressFamilyIpv4, SocketStream, 0)
  if !opened.ok { return HttpIoResult{ count: 0, error: opened.error, ok: false } }
  descriptor := result_value(&opened)
  connected := connect_ipv4(descriptor, address)
  if !connected.ok {
    _ = close(descriptor)
    return HttpIoResult{ count: 0, error: connected.error, ok: false }
  }
  sent := http_send_all(descriptor, request)
  if !sent.ok {
    _ = close(descriptor)
    return sent
  }
  count: usize = 0
  for count < #len(response) {
    ready := wait(descriptor, PollReadable, timeout_milliseconds)
    if !ready.ok {
      _ = close(descriptor)
      return HttpIoResult{ count: count, error: ready.error, ok: false }
    }
    if ready.value == 0 {
      _ = close(descriptor)
      return HttpIoResult{ count: count, error: -110, ok: false }
    }
    received := receive(descriptor, response[count..], 0)
    if !received.ok {
      _ = close(descriptor)
      return HttpIoResult{ count: count, error: received.error, ok: false }
    }
    if received.value == 0 {
      _ = close(descriptor)
      return HttpIoResult{ count: count, error: 0, ok: true }
    }
    count += #cast(usize) received.value
  }
  _ = close(descriptor)
  return HttpIoResult{ count: count, error: 0, ok: true }
}
