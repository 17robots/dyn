use "std/mem" mem
use "std/fail"
use "std/bytes/builder" builder

// Handles are native descriptors/HANDLE values. -1 inherits that standard stream.
// Arguments include argv[0]. Environment is explicit NAME=value entries; empty
// means an empty child environment. Empty directory inherits the parent directory. No shell parsing or PATH search is performed.
// A standard stream for the child. The zero value inherits the parent's.
pub struct Redirect { handle: isize, set: bool }
// Connects the child's stream to handle.
pub fn redirect(handle: isize) Redirect {
  return Redirect{ handle: handle, set: true }
}
// The handle to pass to the OS: the redirected one, or -1 to inherit.
fn native_stream(stream: Redirect) isize {
  if stream.set { return stream.handle }
  return -1
}
// Zero is valid: inherit all three streams, the parent's environment and directory.
pub struct Options { input: Redirect, output: Redirect, error: Redirect, environment: [][]const u8, directory: []const u8 }
// A running child process, in the arena spawn was given; pass the pointer
// around rather than copying the Child.
pub struct Child { handle: isize, active: bool }
// How a child ended. finished is false when a nonblocking wait found it
// still running. A child killed by a signal has signal set and code 0.
pub struct Exit { code: u32, signal: u32, finished: bool }
pub struct Pipe { input: isize, output: isize }
// What the platform reads: the value, and whether the variable is set.
struct Variable { value: []u8, found: bool }
struct Read { count: usize, ended: bool }
pub struct Captured { output: []u8, errors: []u8, exit: Exit, timed_out: bool, limit_reached: bool }

fn invalid(status: *fail.Status, operation: []const u8, path: []const u8, message: []const u8) {
  failure := fail.make(fail.Kind.InvalidInput, operation, path, message)
  failure.native = -22
  fail.set(status, failure)
}

// Starts path with arguments (argv[0] first). The Child lives in arena; on
// failure it is inactive, so wait and terminate on it do nothing.
pub fn spawn(arena: *mem.Arena, status: *fail.Status, path: []const u8, arguments: [][]const u8, configuration: Options) *Child {
  child := mem.push(Child, arena)
  if status.failed { return child }
  if #len(path) == 0 || #len(arguments) == 0 {
    invalid(status, "spawn", path, "a program needs a path and argv[0]")
    return child
  }
  for byte in path {
    if byte == 0 {
      invalid(status, "spawn", path, "the path holds NUL")
      return child
    }
  }
  for directory_byte in configuration.directory {
    if directory_byte == 0 {
      invalid(status, "spawn", path, "the directory holds NUL")
      return child
    }
  }
  for argument in arguments {
    for argument_byte in argument {
      if argument_byte == 0 {
        invalid(status, "spawn", path, "an argument holds NUL")
        return child
      }
    }
  }
  for entry in configuration.environment {
    equal: bool = false
    at: usize = 0
    for environment_byte in entry {
      if environment_byte == 0 || (environment_byte == '=' && at == 0) {
        invalid(status, "spawn", path, "an environment entry holds NUL or starts with '='")
        return child
      }
      if environment_byte == '=' {
        equal = true
      }
      at += 1
    }
    if !equal {
      invalid(status, "spawn", path, "an environment entry has no '='")
      return child
    }
  }
  child.* = spawn_native(arena, status, path, arguments, configuration)
  return child
}
// Waits for child to end; nonblocking returns at once with finished false
// while it runs. Waiting on a child that already ended is InvalidState.
pub fn wait(status: *fail.Status, child: *Child, nonblocking: bool) Exit {
  if status.failed { return Exit{} }
  if !child.active {
    failure := fail.make(fail.Kind.InvalidState, "wait", "", "the child has already been waited for")
    failure.native = -22
    fail.set(status, failure)
    return Exit{}
  }
  return wait_native(status, child, nonblocking)
}
// Kills child. It still needs a wait to be reaped.
pub fn terminate(status: *fail.Status, child: *Child) {
  if status.failed { return }
  if !child.active {
    failure := fail.make(fail.Kind.InvalidState, "terminate", "", "the child has already been waited for")
    failure.native = -22
    fail.set(status, failure)
    return
  }
  terminate_native(status, child)
}
// A pipe: write to output, read from input. Close both with close_pipe.
pub fn pipe(status: *fail.Status) Pipe {
  if status.failed { return Pipe{ input: -1, output: -1 } }
  return pipe_native(status)
}
pub fn close_pipe(handle: isize) {
  close_native(handle)
}
// The variable's value in arena, or fallback when it is unset or unreadable.
pub fn environment_or(arena: *mem.Arena, name: []const u8, fallback: []const u8) []const u8 {
  status: fail.Status
  found := find_environment(arena, &status, name)
  if status.failed || !found.found { return fallback }
  return found.value
}

// The value of environment variable name, in arena; empty when it cannot be
// read, and then the status says why: NotFound when it is unset. Read an
// optional variable with a status of its own, or use environment_or.
pub fn environment(arena: *mem.Arena, status: *fail.Status, name: []const u8) []u8 {
  found := find_environment(arena, status, name)
  if !status.failed && !found.found {
    fail.set(status, fail.make(fail.Kind.NotFound, "read environment", name, "not set"))
  }
  return found.value
}

fn find_environment(arena: *mem.Arena, status: *fail.Status, name: []const u8) Variable {
  if status.failed { return Variable{} }
  if #len(name) == 0 {
    invalid(status, "read environment", name, "empty variable name")
    return Variable{}
  }
  for byte in name {
    if byte == 0 || byte == '=' {
      invalid(status, "read environment", name, "variable names cannot hold '=' or NUL")
      return Variable{}
    }
  }
  room := mem.arena_room(arena)
  capacity := #cast(usize, 256)
  if capacity > room {
    capacity = room
  }
  for capacity <= #max(usize) / 4 {
    mark := mem.arena_mark(arena)
    // Too small a buffer is retried bigger, so it gets a status of its own.
    attempt: fail.Status
    result := environment_native(&attempt, name, mem.push_bytes(arena, capacity))
    if !attempt.failed {
      mem.arena_rewind(arena, mark + #len(result.value))
      return result
    }
    mem.arena_rewind(arena, mark)
    if attempt.failure.kind != fail.Kind.Capacity {
      fail.set(status, attempt.failure)
      return Variable{}
    }
    if capacity == room {
      #panic("arena exhausted: the output does not fit")
    }
    capacity = capacity * 2
    if capacity > room {
      capacity = room
    }
  }
  #panic("output size overflows")
}

// Zero limits are unlimited. A zero or negative timeout is infinite; no_wait
// stops at the first check instead.
pub struct CaptureOptions { timeout_milliseconds: i64, no_wait: bool, output_limit: usize, error_limit: usize }

// Reject inputs in the arena's unallocated tail before native setup can overwrite
// them. Already allocated arena inputs stay stable throughout capture.
fn capture_input_overlap(arena: *mem.Arena, path: []const u8, arguments: [][]const u8, configuration: Options) bool {
  if mem.arena_overlaps_unallocated(arena, path) || mem.arena_overlaps_unallocated(arena, configuration.directory) {
    return true
  }
  if #len(arguments) > 0 {
    slots := #slice(#cast(*const u8, &arguments[0]), #len(arguments) * #sizeof([]const u8))
    if mem.arena_overlaps_unallocated(arena, slots) { return true }
  }
  if #len(configuration.environment) > 0 {
    slots := #slice(#cast(*const u8, &configuration.environment[0]), #len(configuration.environment) * #sizeof([]const u8))
    if mem.arena_overlaps_unallocated(arena, slots) { return true }
  }
  for argument in arguments {
    if mem.arena_overlaps_unallocated(arena, argument) { return true }
  }
  for entry in configuration.environment {
    if mem.arena_overlaps_unallocated(arena, entry) { return true }
  }
  return false
}

// Drains both streams fairly into growing arena slices, valid until caller
// rewind/reset/release. Exhaustion panics and deferred cleanup reaps the child.
// A timeout or limit fails the capture but keeps the output so far (timed_out
// or limit_reached says which); other failures keep nothing and rewind the
// capture's allocations. Limits terminate and reap the direct child;
// descendants are not killed. A nonzero exit code is a successful capture.
pub fn capture(arena: *mem.Arena, status: *fail.Status, path: []const u8, arguments: [][]const u8,
  configuration: Options, policy: CaptureOptions) Captured {
  if status.failed { return Captured{} }
  if capture_input_overlap(arena, path, arguments, configuration) {
    invalid(status, "capture", path, "an input lies in the arena's free space")
    return Captured{}
  }
  mark := mem.arena_mark(arena)
  published: bool = false
  defer {
    if !published {
      mem.arena_rewind(arena, mark)
    }
  }
  config := configuration
  borrowed_input: isize = -1
  if config.input.set {
    borrowed_input = duplicate_native(status, config.input.handle)
    if status.failed { return Captured{} }
    config.input = redirect(borrowed_input)
  }
  defer {
    if borrowed_input >= 0 {
      close_native(borrowed_input)
    }
  }
  stdout := pipe(status)
  if status.failed { return Captured{} }
  defer close_native(stdout.input)
  stderr := pipe(status)
  if status.failed {
    close_native(stdout.output)
    return Captured{}
  }
  defer close_native(stderr.input)
  config.output = redirect(stdout.output)
  config.error = redirect(stderr.output)
  child := spawn(arena, status, path, arguments, config)
  close_native(stdout.output)
  close_native(stderr.output)
  if status.failed { return Captured{} }
  defer reap(child)
  has_deadline := policy.no_wait || policy.timeout_milliseconds > 0
  wait_limit: u64 = 0
  if !policy.no_wait && has_deadline {
    wait_limit = #cast(u64, policy.timeout_milliseconds)
  }
  started := milliseconds_native()
  output := builder.Builder{}
  errors := builder.Builder{}
  out_end: bool = false
  err_end: bool = false
  result := Captured{}
  buffer: [65536]u8
  for !status.failed {
    progress: bool = false
    for stream_index in 0..2 {
      ended := out_end
      handle := stdout.input
      state := &output
      limit := policy.output_limit
      if stream_index == 1 {
        ended = err_end
        handle = stderr.input
        state = &errors
        limit = policy.error_limit
      }
      if !ended && !status.failed {
        destination := buffer[..]
        probing := limit > 0 && state.length == limit
        if probing {
          destination = destination[..1]
        } else {
          if limit > 0 && limit - state.length < #len(destination) {
            destination = destination[..limit - state.length]
          }
        }
        read := read_native(status, handle, destination)
        if probing && read.count > 0 {
          result.limit_reached = true
          failure := fail.make(fail.Kind.Capacity, "capture", path, "the output limit was reached")
          failure.native = -28
          fail.set(status, failure)
        } else if read.count > 0 {
          progress = true
          builder.append_grow(arena, state, destination[..read.count])
        }
        if stream_index == 0 { out_end = read.ended } else { err_end = read.ended }
      }
    }
    if status.failed { break }
    if child.active {
      exited := wait(status, child, true)
      if exited.finished {
        result.exit = exited
      }
    }
    if out_end && err_end && !child.active { break }
    if has_deadline && milliseconds_native() - started >= wait_limit {
      result.timed_out = true
      failure := fail.make(fail.Kind.Interrupted, "capture", path, "timed out")
      failure.native = -110
      fail.set(status, failure)
    }
    if !progress && !status.failed {
      sleep_native()
    }
  }
  if !status.failed || result.timed_out || result.limit_reached {
    result.output = output.storage[..output.length]
    result.errors = errors.storage[..errors.length]
    published = true
  }
  return result
}

// Cleanup for capture: kills and waits for a child still running.
fn reap(child: *Child) {
  if !child.active { return }
  cleanup: fail.Status
  terminate(&cleanup, child)
  _ = wait(&cleanup, child, false)
}

// What process.start() returns: an arena that lives for the
// whole program and the arguments, argv[0] first, stored in it.
pub struct Program { arena: *mem.Arena, args: [][]const u8 }

// Call it on main's first line: `program := process.start()`. It panics only
// when the arguments cannot be read.
pub fn start() Program {
  arena := mem.arena_alloc(0)
  status := fail.Status{ on_failure: fail.panic_on_failure }
  args := arguments(arena, &status)
  return Program{ arena: arena, args: args }
}

// Includes argv[0]. Descriptors and argument bytes belong to arena.
// Unix preserves native bytes; Windows converts UTF-16 to UTF-8.
// Failure rewinds arena; success lives until its next reset/rewind/destroy.
pub fn arguments(arena: *mem.Arena, status: *fail.Status) [][]const u8 {
  empty: [][]const u8
  if status.failed { return empty }
  mark := mem.arena_mark(arena)
  result := arguments_native(arena, status)
  if status.failed {
    mem.arena_rewind(arena, mark)
    return empty
  }
  return result
}
fn argument_slots(arena: *mem.Arena, count: usize) [][]const u8 {
  empty: [][]const u8
  if count == 0 { return empty }
  return mem.push_array([]const u8, arena, count)
}
