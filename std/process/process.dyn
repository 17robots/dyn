use "std/mem" mem
use "std/errors" error_kinds
use "std/bytes" bytes
use "std/bytes/builder" builder

// Handles are native descriptors/HANDLE values. -1 inherits that standard stream.
// Arguments include argv[0]. Environment is explicit NAME=value entries; empty
// means an empty child environment. Empty directory inherits the parent directory. No shell parsing or PATH search is performed.
// A standard stream for the child. The zero value inherits the parent's.
pub struct Redirect { handle: isize, set: bool }
// Connects the child's stream to handle.
pub fn redirect(handle: isize) Redirect {
  return Redirect{ handle: handle, set: true }
}
// The handle to pass to the OS: the redirected one, or -1 to inherit.
fn native_stream(stream: Redirect) isize {
  if stream.set {
    return stream.handle
  }
  return -1
}
// Zero is valid: inherit all three streams, the parent's environment and directory.
pub struct Options { input: Redirect, output: Redirect, error: Redirect, environment: [][]const u8, directory: []const u8 }
pub struct Child { handle: isize, active: bool }
pub struct SpawnResult { value: Child, error: isize, kind: error_kinds.Kind, ok: bool }
pub struct ExitResult { code: u32, signal: u32, finished: bool, error: isize, kind: error_kinds.Kind, ok: bool }
pub struct Status { error: isize, kind: error_kinds.Kind, ok: bool }
pub struct Pipe { input: isize, output: isize, error: isize, kind: error_kinds.Kind, ok: bool }
pub struct EnvironmentResult { value: []u8, found: bool, error: isize, kind: error_kinds.Kind, ok: bool }
pub struct CaptureResult { output: []u8, errors: []u8, exit: ExitResult, timed_out: bool, limit_reached: bool, error: isize, kind: error_kinds.Kind, ok: bool }
struct HandleResult { value: isize, error: isize, kind: error_kinds.Kind, ok: bool }
struct MillisecondsResult { value: u64, error: isize, kind: error_kinds.Kind, ok: bool }
struct ReadResult { count: usize, ended: bool, error: isize, kind: error_kinds.Kind, ok: bool }

pub fn spawn(arena: *mem.Arena, path: []const u8, arguments: [][]const u8, configuration: Options) SpawnResult {
  if #len(path) == 0 || #len(arguments) == 0 {
    return SpawnResult{ error: -22, kind: error_kinds.Kind.InvalidInput }
  }
  for byte in path {
    if byte == 0 {
      return SpawnResult{ error: -22, kind: error_kinds.Kind.InvalidInput }
    }
  }
  for directory_byte in configuration.directory {
    if directory_byte == 0 {
      return SpawnResult{ error: -22, kind: error_kinds.Kind.InvalidInput }
    }
  }
  for argument in arguments {
    for argument_byte in argument {
      if argument_byte == 0 {
        return SpawnResult{ error: -22, kind: error_kinds.Kind.InvalidInput }
      }
    }
  }
  for entry in configuration.environment {
    equal: bool = false
    at: usize = 0
    for environment_byte in entry {
      if environment_byte == 0 || (environment_byte == '=' && at == 0) {
        return SpawnResult{ error: -22, kind: error_kinds.Kind.InvalidInput }
      }
      if environment_byte == '=' {
        equal = true
      }
      at += 1
    }
    if !equal {
      return SpawnResult{ error: -22, kind: error_kinds.Kind.InvalidInput }
    }
  }
  return spawn_native(arena, path, arguments, configuration)
}
// Transfer the owned child handle. Copies are aliases, not independent owners.
pub fn take(child: *Child) Child {
  result := child.*
  child.* = Child{}
  return result
}
pub fn wait(child: *Child, nonblocking: bool) ExitResult {
  if !child.active {
    return ExitResult{ error: -22, kind: error_kinds.Kind.InvalidState }
  }
  return wait_native(child, nonblocking)
}
pub fn terminate(child: *Child) Status {
  if !child.active {
    return Status{ error: -22, kind: error_kinds.Kind.InvalidState }
  }
  return terminate_native(child)
}
pub fn pipe() Pipe {
  return pipe_native()
}
pub fn close_pipe(handle: isize) Status {
  return close_native(handle)
}
// The value of environment variable name, in arena. A missing variable is ok
// with found false.
pub fn environment(arena: *mem.Arena, name: []const u8) EnvironmentResult {
  capacity := mem.trial_size(arena, 256)
  for capacity > 0 {
    mark := mem.arena_mark(arena)
    result := environment_into(name, mem.push_bytes_uninit(arena, capacity))
    if result.error != -28 {
      if result.ok {
        mem.arena_rewind(arena, mark + #len(result.value))
      } else {
        mem.arena_rewind(arena, mark)
      }
      return result
    }
    mem.arena_rewind(arena, mark)
    capacity = mem.trial_next(arena, capacity)
  }
  #panic("arena exhausted")
}

fn environment_into(name: []const u8, destination: []u8) EnvironmentResult {
  if #len(name) == 0 {
    return EnvironmentResult{ error: -22, kind: error_kinds.Kind.InvalidInput }
  }
  for byte in name {
    if byte == 0 || byte == '=' {
      return EnvironmentResult{ error: -22, kind: error_kinds.Kind.InvalidInput }
    }
  }
  return environment_native(name, destination)
}
// Zero limits are unlimited; every negative timeout is infinite.
pub struct CaptureOptions { timeout_milliseconds: i64 = -1, output_limit: usize, error_limit: usize }

// Reject inputs in the arena's unallocated tail before native setup can overwrite
// them. Already allocated arena inputs stay stable throughout capture.
fn capture_input_overlap(arena: *mem.Arena, path: []const u8, arguments: [][]const u8, configuration: Options) bool {
  if mem.arena_overlaps_unallocated(arena, path) || mem.arena_overlaps_unallocated(arena, configuration.directory) {
    return true
  }
  if #len(arguments) > 0 {
    slots := (#cast(*const u8, &arguments[0]))[..#len(arguments) * #sizeof([]const u8)]
    if mem.arena_overlaps_unallocated(arena, slots) {
      return true
    }
  }
  if #len(configuration.environment) > 0 {
    slots := (#cast(*const u8, &configuration.environment[0]))[..#len(configuration.environment) * #sizeof([]const u8)]
    if mem.arena_overlaps_unallocated(arena, slots) {
      return true
    }
  }
  for argument in arguments {
    if mem.arena_overlaps_unallocated(arena, argument) {
      return true
    }
  }
  for entry in configuration.environment {
    if mem.arena_overlaps_unallocated(arena, entry) {
      return true
    }
  }
  return false
}

// Drains both streams fairly into growing arena slices, valid until caller
// rewind/reset/release. Exhaustion panics and deferred cleanup reaps the child.
// Timeout/limit failures publish partial output; other failures publish nothing
// and rewind capture allocations. Limits terminate and reap the direct child;
// descendants are not killed. Nonzero child exit is a successful capture.
pub fn capture(arena: *mem.Arena, path: []const u8, arguments: [][]const u8,
  configuration: Options, policy: CaptureOptions) CaptureResult {
  if capture_input_overlap(arena, path, arguments, configuration) {
    return CaptureResult{ error: -22, kind: error_kinds.Kind.InvalidInput }
  }
  mark := mem.arena_mark(arena)
  published: bool = false
  defer {
    if !published {
      mem.arena_rewind(arena, mark)
    }
  }
  config := configuration
  borrowed_input: isize = -1
  if config.input.set {
    copied := duplicate_native(config.input.handle)
    if !copied.ok {
      return CaptureResult{ error: copied.error, kind: copied.kind }
    }
    borrowed_input = copied.value
    config.input = redirect(copied.value)
  }
  defer {
    if borrowed_input >= 0 {
      _ = close_native(borrowed_input)
    }
  }
  stdout := pipe_native()
  if !stdout.ok {
    return CaptureResult{ error: stdout.error, kind: stdout.kind }
  }
  defer _ = close_native(stdout.input)
  stderr := pipe_native()
  if !stderr.ok {
    _ = close_native(stdout.output)
    return CaptureResult{ error: stderr.error, kind: stderr.kind }
  }
  defer _ = close_native(stderr.input)
  config.output = redirect(stdout.output)
  config.error = redirect(stderr.output)
  child := spawn(arena, path, arguments, config)
  _ = close_native(stdout.output)
  _ = close_native(stderr.output)
  if !child.ok {
    return CaptureResult{ error: child.error, kind: child.kind }
  }
  defer {
    if child.value.active {
      _ = terminate(&child.value)
      _ = wait(&child.value, false)
    }
  }
  started := MillisecondsResult{ok: true}
  if policy.timeout_milliseconds >= 0 {
    started = milliseconds_native()
    if !started.ok {
      return CaptureResult{error: started.error, kind: started.kind}
    }
  }
  output := builder.Builder{}
  errors := builder.Builder{}
  out_end: bool = false
  err_end: bool = false
  result := CaptureResult{}
  buffer: [65536]u8 = []
  for {
    progress: bool = false
    for stream_index in 0..2 {
      ended := out_end
      handle := stdout.input
      state := &output
      limit := policy.output_limit
      if stream_index == 1 {
        ended = err_end
        handle = stderr.input
        state = &errors
        limit = policy.error_limit
      }
      if !ended {
        destination := buffer[..]
        probing := limit > 0 && state.length == limit
        if probing {
          destination = destination[..1]
        } else {
          if limit > 0 && limit - state.length < #len(destination) {
            destination = destination[..limit - state.length]
          }
        }
        read := read_native(handle, destination)
        if !read.ok {
          result.error = read.error
          result.kind = read.kind
          break
        }
        if probing && read.count > 0 {
          result.limit_reached = true
          result.error = -28
          result.kind = error_kinds.Kind.Capacity
          break
        }
        if read.count > 0 {
          progress = true
          if builder.append_grow(state, arena, destination[..read.count]) != builder.ErrorKind.None {
            result.kind = error_kinds.Kind.Overflow
            break
          }
        }
        if stream_index == 0 {
          out_end = read.ended
        }
        else {
          err_end = read.ended
        }
      }
    }
    if result.kind != error_kinds.Kind.None {
      break
    }
    if child.value.active {
      exited := wait(&child.value, true)
      if !exited.ok {
        result.error = exited.error
        result.kind = exited.kind
        break
      }
      if exited.finished {
        result.exit = exited
      }
    }
    if out_end && err_end && !child.value.active {
      result.ok = true
      break
    }
    if policy.timeout_milliseconds >= 0 {
      now := milliseconds_native()
      if !now.ok {
        result.error = now.error
        result.kind = now.kind
        break
      }
      if now.value - started.value >= #cast(u64, policy.timeout_milliseconds) {
        result.timed_out = true
        result.error = -110
        result.kind = error_kinds.Kind.System
        break
      }
    }
    if !progress {
      sleep_native()
    }
  }
  if result.ok || result.timed_out || result.limit_reached {
    result.output = output.storage[..output.length]
    result.errors = errors.storage[..errors.length]
    published = true
  }
  return result
}

// Includes argv[0]. Descriptors and argument bytes belong to arena.
// Unix preserves native bytes; Windows converts UTF-16 to UTF-8.
// Failure rewinds arena; success lives until its next reset/rewind/destroy.
pub struct ArgumentsResult { value: [][]const u8, error: isize, kind: error_kinds.Kind, ok: bool }
pub fn arguments(arena: *mem.Arena) ArgumentsResult {
  mark := mem.arena_mark(arena)
  result := arguments_native(arena)
  if !result.ok {
    mem.arena_rewind(arena, mark)
  }
  return result
}
fn argument_slots(arena: *mem.Arena, count: usize) ArgumentsResult {
  if count == 0 {
    return ArgumentsResult{ ok: true }
  }
  if count > (~#cast(usize, 0)) / #sizeof([]const u8) {
    return ArgumentsResult{ kind: error_kinds.Kind.Overflow }
  }
  allocation := mem.arena_push_uninit(arena, count * #sizeof([]const u8), #alignof([]const u8))
  return ArgumentsResult{ value: (#cast(*[]const u8, allocation))[..count], ok: true }
}
