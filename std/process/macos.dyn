#target(kernel: darwin)
#link("System")
// Native Darwin adapter. libSystem handles OS calls; buffers use the caller arena.
use io "std/io"
use c "std/c"
extern fn native_chdir "chdir"(path: *const u8) i32
extern fn native_fork "fork"() i32
extern fn native_pipe "pipe"(descriptors: *i32) i32
// Darwin arm64 passes variadic arguments on the stack, not as fixed parameters.
extern fn native_fcntl "fcntl"(descriptor: i32, command: i32, ...) i32
extern fn native_dup "dup2"(source: i32, destination: i32) i32
extern fn native_exec "execve"(path: *const u8, arguments: rawptr, environment: rawptr) i32
extern fn native_exit "_exit"(code: i32)
extern fn native_wait "waitpid"(child: i32, status: *i32, flags: i32) i32
extern fn native_kill "kill"(child: i32, signal: i32) i32
extern fn native_read "read"(descriptor: i32, destination: *u8, count: usize) isize
extern fn native_write "write"(descriptor: i32, source: rawptr, count: usize) isize
extern fn native_close "close"(descriptor: i32) i32
extern fn native_errno "__error"() *i32
extern fn native_clock "clock_gettime"(clock: i32, output: *Timespec) i32
extern fn native_sleep "nanosleep"(requested: *const Timespec, remaining: *Timespec) i32
extern fn native_environment "getenv"(name: *const u8) *const u8
struct Timespec { seconds: i64, nanoseconds: i64 }
struct CString { value: *const u8 }
fn mac_error() isize {
  return 0 - #cast(isize, native_errno().*)
}
// nil for text holding NUL.
fn c_string(arena: *mem.Arena, value: []const u8) *const u8 {
  status: fail.Status
  return c.string_from_bytes(arena, &status, value)
}
fn c_vector(arena: *mem.Arena, values: [][]const u8) *CString {
  if values.len > 2305843009213693950 { return nil }
  slots := mem.push_array<CString>(arena, values.len+1)
  for at in 0..values.len {
    slots[at].value = c_string(arena, values[at])
    if slots[at].value == nil { return nil }
  }
  return &slots[0]
}
fn spawn_native(arena: *mem.Arena, status: *fail.Status, path: []const u8, arguments: [][]const u8, configuration: Options) Child {
  mark := mem.arena_mark(arena)
  defer mem.arena_rewind(arena, mark)
  executable := c_string(arena, path)
  argv := c_vector(arena, arguments)
  env := c_vector(arena, configuration.environment)
  if executable == nil || argv == nil || env == nil { return spawn_failed(status, -28) }
  directory: *const u8 = nil
  if configuration.directory.len > 0 {
    directory = c_string(arena, configuration.directory)
    if directory == nil { return spawn_failed(status, -28) }
  }
  sources: [3]isize = [native_stream(configuration.input), native_stream(configuration.output), native_stream(configuration.error)]
  copies: [3]i32 = [-1, -1, -1]
  defer {
    for descriptor in copies {
      if descriptor >= 0 {
        _ = native_close(descriptor)
      }
    }
  }
  for source_index in 0..3 {
    if sources[source_index] >= 0 {
      copies[source_index] = native_fcntl(#cast(i32, sources[source_index]), 67, 3)
      if copies[source_index] < 0 {
        duplicate_error := mac_error()
        return spawn_failed(status, duplicate_error)
      }
    }
  }
  channel: [2]i32
  if native_pipe(&channel[0]) != 0 {
    pipe_error := mac_error()
    return spawn_failed(status, pipe_error)
  }
  reader := native_fcntl(channel[0], 67, 3)
  writer := native_fcntl(channel[1], 67, 3)
  _ = native_close(channel[0])
  _ = native_close(channel[1])
  if reader < 0 || writer < 0 {
    if reader >= 0 {
      _ = native_close(reader)
    }
    if writer >= 0 {
      _ = native_close(writer)
    }
    return spawn_failed(status, -24)
  }
  child := native_fork()
  if child < 0 {
    failure := mac_error()
    _ = native_close(reader)
    _ = native_close(writer)
    return spawn_failed(status, failure)
  }
  if child == 0 {
    _ = native_close(reader)
    failed: bool = false
    if copies[0] >= 0 && native_dup(copies[0], 0) < 0 {
      failed = true
    }
    if !failed && copies[1] >= 0 && native_dup(copies[1], 1) < 0 {
      failed = true
    }
    if !failed && copies[2] >= 0 && native_dup(copies[2], 2) < 0 {
      failed = true
    }
    if !failed && directory != nil && native_chdir(directory) < 0 {
      failed = true
    }
    if !failed {
      _ = native_exec(executable, argv, env)
    }
    error := mac_error()
    _ = native_write(writer, &error, #sizeof(isize))
    native_exit(127)
    #panic("exit returned")
  }
  _ = native_close(writer)
  reported: isize = 0
  amount := native_read(reader, #cast(*u8, &reported), #sizeof(isize))
  for amount < 0 && native_errno().* == 4 {
    amount = native_read(reader, #cast(*u8, &reported), #sizeof(isize))
  }
  _ = native_close(reader)
  if amount != 0 {
    _ = native_kill(child, 9)
    wait_status: i32 = 0
    _ = native_wait(child, &wait_status, 0)
    if amount != #cast(isize, #sizeof(isize)) {
      reported = -5
    }
    return spawn_failed(status, reported)
  }
  return Child{ handle: child, active: true }
}
fn spawn_failed(status: *fail.Status, code: isize) Child {
  fail.set(status, io.from_darwin("spawn", "", code))
  return Child{}
}
fn darwin_failed(status: *fail.Status, operation: []const u8) {
  fail.set(status, io.from_darwin(operation, "", mac_error()))
}
fn wait_native(status: *fail.Status, child: *Child, nonblocking: bool) Exit {
  wait_status: i32 = 0
  flags: i32 = 0
  if nonblocking {
    flags = 1
  }
  value := native_wait(#cast(i32, child.handle), &wait_status, flags)
  for value < 0 && native_errno().* == 4 {
    value = native_wait(#cast(i32, child.handle), &wait_status, flags)
  }
  if value < 0 {
    darwin_failed(status, "wait")
    return Exit{}
  }
  if value == 0 { return Exit{} }
  child.active = false
  if (wait_status & 127) == 0 {
    return Exit{ code: #cast(u32, ((wait_status >> 8) & 255)), finished: true }
  }
  return Exit{ signal: #cast(u32, (wait_status & 127)), finished: true }
}
fn terminate_native(status: *fail.Status, child: *Child) {
  if native_kill(#cast(i32, child.handle), 9) < 0 {
    darwin_failed(status, "terminate")
  }
}
fn close_native(handle: isize) {
  _ = native_close(#cast(i32, handle))
}
fn pipe_native(status: *fail.Status) Pipe {
  descriptors: [2]i32
  if native_pipe(&descriptors[0]) != 0 {
    darwin_failed(status, "pipe")
    return Pipe{ input: -1, output: -1 }
  }
  if native_fcntl(descriptors[0], 2, 1) < 0 || native_fcntl(descriptors[1], 2, 1) < 0 || native_fcntl(descriptors[0], 4, 4) < 0 {
    darwin_failed(status, "pipe")
    _ = native_close(descriptors[0])
    _ = native_close(descriptors[1])
    return Pipe{ input: -1, output: -1 }
  }
  return Pipe{ input: descriptors[0], output: descriptors[1] }
}
// A pipe with nothing to read yet is no failure: count 0, not ended.
fn read_native(status: *fail.Status, handle: isize, destination: []u8) Read {
  amount := native_read(#cast(i32, handle), &destination[0], destination.len)
  for amount < 0 && native_errno().* == 4 {
    amount = native_read(#cast(i32, handle), &destination[0], destination.len)
  }
  if amount < 0 {
    if native_errno().* != 35 {
      darwin_failed(status, "read")
    }
    return Read{}
  }
  return Read{ count: #cast(usize, amount), ended: amount == 0 }
}
fn milliseconds_native() u64 {
  time := Timespec{}
  _ = native_clock(6, &time)
  return #cast(u64, time.seconds)*1000 + #cast(u64, (time.nanoseconds/1000000))
}
fn sleep_native() {
  delay := Timespec{ nanoseconds: 1000000 }
  _ = native_sleep(&delay, nil)
}
fn environment_too_long(status: *fail.Status, name: []const u8) []u8 {
  failure := fail.make(fail.Kind.Capacity, "read environment", name, "the value does not fit the storage")
  failure.native = -28
  fail.set(status, failure)
  empty: []u8
  return empty
}
fn environment_native(status: *fail.Status, name: []const u8, destination: []u8) []u8 {
  buffer: [4096]u8
  key := c.string_into(status, buffer[..], name)
  if status.failed { return destination[..0] }
  value := native_environment(key)
  if value == nil {
    fail.set(status, fail.make(fail.Kind.NotFound, "read environment", name, "not set"))
    return destination[..0]
  }
  limited: fail.Status
  parsed := c.bytes_from_string(&limited, value, destination.len+1)
  if limited.failed || parsed.len > destination.len { return environment_too_long(status, name) }
  i: usize = 0
  for i < parsed.len {
    destination[i] = parsed[i]
    i += 1
  }
  return destination[..i]
}

fn duplicate_native(status: *fail.Status, value: isize) isize {
  copied := native_fcntl(#cast(i32, value), 67, 3)
  if copied < 0 {
    darwin_failed(status, "duplicate")
    return -1
  }
  return copied
}

extern fn argument_count "dyn_arguments_count"() *i32
extern fn argument_length "dyn_arguments_length"(value: *const u8) usize
extern fn argument_vector "dyn_arguments_vector"() ***const u8
fn arguments_native(arena: *mem.Arena, status: *fail.Status) [][]const u8 {
  count := argument_count().*
  if count < 0 {
    fail.set(status, fail.make(fail.Kind.InvalidState, "read arguments", "", "the argument count is negative"))
    empty: [][]const u8
    return empty
  }
  result := argument_slots(arena, #cast(usize, count))
  vector := #slice(argument_vector().*, count)
  at: usize = 0
  for at < #cast(usize, count) {
    source := vector[at]
    size := argument_length(source)
    destination := mem.push_bytes(arena, size)
    _ = mem.copy(destination, #slice(source, size))
    result[at] = destination
    at += 1
  }
  return result
}
