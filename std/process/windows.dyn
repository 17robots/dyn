struct Startup {
  size: u32, reserved: rawptr, desktop: rawptr, title: rawptr,
  x: u32, y: u32, width: u32, height: u32, columns: u32, rows: u32,
  fill: u32, flags: u32, show: u16, reserved_size: u16, reserved_bytes: rawptr,
  input: rawptr, output: rawptr, error: rawptr, attributes: rawptr,
}
struct ProcessInformation { process: rawptr, thread: rawptr, process_id: u32, thread_id: u32 }
struct Wide { data: []u16, ok: bool }
fn win_failure() isize { return 0 - #cast(isize) win_error() }
fn handle(value: isize) rawptr { return #cast(rawptr) #cast(usize) value }
fn encode_wide(destination: []u16, source: []const u8) usize {
  used: usize = 0 at: usize = 0
  for at < #len(source) {
    decoded := utf8.decode(source,at) if !decoded.ok { return 0 }
    width := utf16.encode(destination[used..],decoded.codepoint) if width == 0 { return 0 }
    used += width at += decoded.width
  }
  if used == #len(destination) { return 0 }
  destination[used] = 0 return used + 1
}
fn wide(arena: *mem.Arena, source: []const u8) Wide {
  if #len(source) > 32766 { return Wide{} }
  allocation := mem.arena_try_push_uninit(arena,(#len(source)+1)*2,2)
  if !allocation.ok { return Wide{} }
  destination := (#cast(*u16) allocation.memory)[..#len(source)+1]
  length := encode_wide(destination,source) if length == 0 { return Wide{} }
  return Wide{ data: destination[..length], ok: true }
}
fn spawn_native(arena: *mem.Arena, path: []const u8, arguments: [][]const u8, configuration: Options) SpawnResult {
  mark := mem.arena_mark(arena) defer mem.arena_rewind(arena,mark)
  application := wide(arena,path) if !application.ok { return SpawnResult{ error: -28, kind: error_kinds.Kind.Capacity } }
  capacity: usize = 1
