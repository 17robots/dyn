    capacity += #len(argument)*2+3
  }
  allocation := mem.arena_try_push_uninit(arena,capacity*2,2) if !allocation.ok { return SpawnResult{ error: -28, kind: error_kinds.Kind.Capacity } }
  command := (#cast(*u16) allocation.memory)[..capacity] used: usize = 0 argument_index: usize = 0
  for argument_text in arguments {
    if argument_index > 0 { command[used] = 32 used += 1 }
    // Microsoft CRT argv convention; argv[0] has special quote processing.
    if argument_index == 0 {
      for first_byte in argument_text { if first_byte == 34 { return SpawnResult{ error: -22, kind: error_kinds.Kind.InvalidInput } } }
    }
    command[used] = 34 used += 1 at: usize = 0 slashes: usize = 0
    for at < #len(argument_text) {
      byte := argument_text[at]
      if byte == 92 && argument_index > 0 { slashes += 1 at += 1 continue }
      if byte == 34 { slashes = slashes*2+1 }
      for slashes > 0 { command[used] = 92 used += 1 slashes -= 1 }
      decoded := utf8.decode(argument_text,at) if !decoded.ok { return SpawnResult{ error: -22, kind: error_kinds.Kind.InvalidInput } }
      width := utf16.encode(command[used..],decoded.codepoint) used += width at += decoded.width
    }
    slashes *= 2 for slashes > 0 { command[used] = 92 used += 1 slashes -= 1 }
    command[used] = 34 used += 1 argument_index += 1
  }
  command[used] = 0
  environment_capacity: usize = 2
  for item in configuration.environment {
    if #len(item) > 32766 || environment_capacity > 32767 - #len(item) - 1 { return SpawnResult{ error: -28, kind: error_kinds.Kind.Capacity } }
    environment_capacity += #len(item)+1
  }
  environment_allocation := mem.arena_try_push(arena,environment_capacity*2,2)
  if !environment_allocation.ok { return SpawnResult{ error: -28, kind: error_kinds.Kind.Capacity } }
  environment := (#cast(*u16) environment_allocation.memory)[..environment_capacity] environment_used: usize = 0
  entries_allocation := mem.arena_try_push(arena,#len(configuration.environment)*#sizeof(Wide),#alignof(Wide))
  if !entries_allocation.ok { return SpawnResult{ error: -28, kind: error_kinds.Kind.Capacity } }
  entries := (#cast(*Wide) entries_allocation.memory)[..#len(configuration.environment)]
  entry_index: usize = 0
  for entry in configuration.environment {
    converted := wide(arena,entry) if !converted.ok { return SpawnResult{ error: -28, kind: error_kinds.Kind.Capacity } }
    position := entry_index
    for position > 0 && win_compare(&entries[position-1].data[0],#cast(i32) #len(entries[position-1].data)-1,&converted.data[0],#cast(i32) #len(converted.data)-1,1) == 3 {
      entries[position] = entries[position-1] position -= 1
    }
    entries[position] = converted entry_index += 1
  }
  for sorted_entry in entries {
    for unit in sorted_entry.data { environment[environment_used] = unit environment_used += 1 }
  }
  handles: [3]rawptr = [] sources: [3]isize = [configuration.input,configuration.output,configuration.error]
  inherited_count: usize = 0
  defer { for owned in handles { if owned != nil { _ = win_close(owned) } } }
  startup := Startup{ size: #cast(u32) #sizeof(Startup), flags: 256 }
  index: usize = 0
  for index < 3 {
    source: rawptr = nil
    if sources[index] == -1 { source = win_std(4294967286 - #cast(u32) index) }
    else { source = handle(sources[index]) }
    duplicate: rawptr = nil
    if source != nil && #cast(usize) source != 18446744073709551615 {
      if win_duplicate(win_current(),source,win_current(),&duplicate,0,1,2) == 0 { duplicate_error := win_failure() return SpawnResult{ error: duplicate_error, kind: error_kinds.windows(duplicate_error) } }
      handles[inherited_count] = duplicate inherited_count += 1
    }
    if index == 0 { startup.input = duplicate } else if index == 1 { startup.output = duplicate } else { startup.error = duplicate }
    index += 1
  }
  size: usize = 0 _ = win_init_attributes(nil,1,0,&size)
  attributes := mem.arena_try_push_uninit(arena,size,8)
  if !attributes.ok { return SpawnResult{ error: -28, kind: error_kinds.Kind.Capacity } }
  startup.attributes = #cast(rawptr) attributes.memory
  if win_init_attributes(startup.attributes,1,0,&size) == 0 { initialize_error := win_failure() return SpawnResult{ error: initialize_error, kind: error_kinds.windows(initialize_error) } }
  defer win_delete_attributes(startup.attributes)
