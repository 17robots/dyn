fn wait_native(child: *Child, nonblocking: bool) ExitResult {
  timeout: u32 = 4294967295 if nonblocking { timeout = 0 }
  value := win_wait(handle(child.handle),timeout)
  if value == 258 { return ExitResult{ ok: true } }
  if value != 0 { wait_error := win_failure() return ExitResult{ error: wait_error, kind: error_kinds.windows(wait_error) } }
  code: u32 = 0 if win_exit_code(handle(child.handle),&code) == 0 { exit_error := win_failure() return ExitResult{ error: exit_error, kind: error_kinds.windows(exit_error) } }
  _ = win_close(handle(child.handle)) child.active = false
  return ExitResult{ code: code, finished: true, ok: true }
}
fn terminate_native(child: *Child) Status { if win_terminate(handle(child.handle),1) == 0 { terminate_error := win_failure() return Status{ error: terminate_error, kind: error_kinds.windows(terminate_error) } } return Status{ ok: true } }
fn close_native(value: isize) Status { if win_close(handle(value)) == 0 { close_error := win_failure() return Status{ error: close_error, kind: error_kinds.windows(close_error) } } return Status{ ok: true } }
fn pipe_native() Pipe {
  input: rawptr = nil output: rawptr = nil
  if win_pipe(&input,&output,nil,0) == 0 { pipe_error := win_failure() return Pipe{ error: pipe_error, kind: error_kinds.windows(pipe_error) } }
  return Pipe{ input: #cast(isize) #cast(usize) input, output: #cast(isize) #cast(usize) output, ok: true }
}
fn read_native(value: isize, destination: []u8) ReadResult {
  available: u32 = 0
  if win_peek(handle(value),nil,0,nil,&available,nil) == 0 {
    error := win_error() if error == 109 { return ReadResult{ ended: true, ok: true } }
    return ReadResult{ error: 0 - #cast(isize) error, kind: error_kinds.windows(0 - #cast(isize) error) }
  }
  if available == 0 { return ReadResult{ ok: true } }
  amount := #cast(usize) available if amount > #len(destination) { amount = #len(destination) }
  read: u32 = 0
  if win_read(handle(value),&destination[0],#cast(u32) amount,&read,nil) == 0 { read_error := win_failure() return ReadResult{ error: read_error, kind: error_kinds.windows(read_error) } }
  return ReadResult{ count: #cast(usize) read, ok: true }
}
fn milliseconds_native() u64 { return win_ticks() }
fn sleep_native() { win_sleep(1) }
fn environment_native(name: []const u8, destination: []u8) EnvironmentResult {
  key: [32768]u16 = [] value: [32768]u16 = []
  if encode_wide(key[..],name) == 0 { return EnvironmentResult{ error: -28, kind: error_kinds.Kind.Capacity } }
  win_set_error(0) length := win_environment(&key[0],&value[0],32768)
  if length == 0 {
    error := win_error()
    if error == 203 { return EnvironmentResult{ value: destination[..0], ok: true } }
    if error != 0 { return EnvironmentResult{ error: 0 - #cast(isize) error, kind: error_kinds.windows(0 - #cast(isize) error) } }
  }
  if length >= 32768 { return EnvironmentResult{ error: -28, kind: error_kinds.Kind.Capacity } }
  at: usize = 0 used: usize = 0
  for at < #cast(usize) length {
    decoded := utf16.decode(value[..#cast(usize) length],at)
    if !decoded.ok { return EnvironmentResult{ error: -22, kind: error_kinds.Kind.InvalidInput } }
    width := utf8.encode(destination[used..],decoded.codepoint)
    if width == 0 { return EnvironmentResult{ error: -28, kind: error_kinds.Kind.Capacity } }
    used += width at += decoded.width
  }
  return EnvironmentResult{ value: destination[..used], found: true, ok: true }
}

fn duplicate_native(value: isize) HandleResult {
  copied: rawptr = nil
  if win_duplicate(win_current(),handle(value),win_current(),&copied,0,0,2) == 0 { duplicate_error := win_failure() return HandleResult{ error: duplicate_error, kind: error_kinds.windows(duplicate_error) } }
