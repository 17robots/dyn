#target(kernel: linux)
use "std/io" io
use "std/os/linux" os
use "std/fs" fs
use "std/time" time
use "std/os/linux/sys"
fn spawn_native(arena: *mem.Arena, path: []const u8, arguments: [][]const u8, configuration: Options) SpawnResult {
  native := os.spawn_environment(arena, path, arguments, configuration.environment,
    os.SpawnOptions{ input: native_stream(configuration.input), output: native_stream(configuration.output), error: native_stream(configuration.error), directory: configuration.directory })
  return SpawnResult{ value: Child{ handle: native.process, active: native.ok }, failure: io.linux_failure(native.error) }
}
fn wait_native(child: *Child, nonblocking: bool) ExitResult {
  value := os.wait(child.handle, nonblocking)
  if !value.ok {
    return ExitResult{ failure: io.linux_failure(value.error) }
  }
  if value.process == 0 {
    return ExitResult{}
  }
  child.active = false
  if os.exited(value.status) {
    return ExitResult{ code: os.exit_status(value.status), finished: true }
  }
  return ExitResult{ signal: os.termination_signal(value.status), finished: true }
}
fn terminate_native(child: *Child) Status {
  result := os.send_signal(child.handle, 9)
  return Status{ failure: io.linux_failure(result.error) }
}
fn close_native(handle: isize) Status {
  result := os.close_descriptor(handle)
  return Status{ failure: io.linux_failure(result.error) }
}
fn pipe_native() Pipe {
  descriptors: [2]i32
  result := #syscall(sys.Pipe2, &descriptors[0], 524288)
  if result < 0 {
    return Pipe{ failure: io.linux_failure(result) }
  }
  flags := #syscall(sys.Fcntl, descriptors[0], 3, 0)
  changed := #syscall(sys.Fcntl, descriptors[0], 4, flags | 2048)
  if changed < 0 {
    _ = close_native(descriptors[0])
    _ = close_native(descriptors[1])
    return Pipe{ failure: io.linux_failure(changed) }
  }
  return Pipe{ input: descriptors[0], output: descriptors[1] }
}
fn read_native(handle: isize, destination: []u8) ReadResult {
  file := fs.borrow_handle(handle)
  result := fs.read(&file, destination)
  if io.failed(result.failure) && result.failure.native == -11 {
    return ReadResult{ ok: true }
  }
  return ReadResult{ count: result.transferred, ended: !io.failed(result.failure) && result.transferred == 0, error: result.failure.native, kind: result.failure.kind, ok: !io.failed(result.failure) }
}
fn milliseconds_native() MillisecondsResult {
  now := time.monotonic_now()
  if io.failed(now.failure) {
    return MillisecondsResult{error: now.failure.native, kind: now.failure.kind}
  }
  return MillisecondsResult{value: #cast(u64, now.value.seconds) * 1000 + #cast(u64, (now.value.nanoseconds / 1000000)), ok: true}
}
fn sleep_native() {
  _ = time.sleep(time.Millisecond)
}
fn environment_native(name: []const u8, destination: []u8) EnvironmentResult {
  result := os.environment_get(name, destination)
  return EnvironmentResult{ value: result.value, found: result.found, failure: io.linux_failure(result.error) }
}

fn duplicate_native(value: isize) HandleResult {
  copied := #syscall(sys.Fcntl, value, 1030, 3)
  if copied < 0 {
    return HandleResult{ error: copied, kind: io.linux(copied) }
  }
  return HandleResult{ value: copied, ok: true }
}

fn arguments_native(arena: *mem.Arena) ArgumentsResult {
  raw := fs.read_all(arena, "/proc/self/cmdline", #max(usize))
  if io.failed(raw.failure) {
    return ArgumentsResult{ failure: io.Failure{ kind: raw.failure.kind, native: raw.failure.native } }
  }
  count: usize = 0
  for byte in raw.value {
    if byte == 0 {
      count += 1
    }
  }
  if #len(raw.value) > 0 && raw.value[#len(raw.value) - 1] != 0 {
    return ArgumentsResult{ failure: io.Failure{ kind: io.Kind.InvalidState } }
  }
  result := argument_slots(arena, count)
  if io.failed(result.failure) {
    return result
  }
  at: usize = 0
  start: usize = 0
  index: usize = 0
  for at < #len(raw.value) {
    if raw.value[at] == 0 {
      result.value[index] = raw.value[start..at]
      index += 1
      start = at + 1
    }
    at += 1
  }
  return result
}
