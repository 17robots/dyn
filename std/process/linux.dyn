#target(kernel: linux)
use "std/io" io
use "std/os/linux" os
use "std/fs" fs
use "std/time" time
use "std/os/linux/sys"
fn spawn_native(arena: *mem.Arena, status: *fail.Status, path: []const u8, arguments: [][]const u8, configuration: Options) Child {
  process := os.spawn_environment(arena, status, path, arguments, configuration.environment,
    os.SpawnOptions{ input: native_stream(configuration.input), output: native_stream(configuration.output), error: native_stream(configuration.error), directory: configuration.directory })
  if status.failed { return Child{} }
  return Child{ handle: process, active: true }
}
fn wait_native(status: *fail.Status, child: *Child, nonblocking: bool) Exit {
  value := os.wait(status, child.handle, nonblocking)
  if status.failed || value.process == 0 { return Exit{} }
  child.active = false
  if os.exited(value.wait_status) {
    return Exit{ code: os.exit_status(value.wait_status), finished: true }
  }
  return Exit{ signal: os.termination_signal(value.wait_status), finished: true }
}
fn terminate_native(status: *fail.Status, child: *Child) {
  os.send_signal(status, child.handle, 9)
}
fn close_native(handle: isize) {
  ignored: fail.Status
  os.close_descriptor(&ignored, handle)
}
fn pipe_native(status: *fail.Status) Pipe {
  descriptors: [2]i32
  result := #syscall(sys.Pipe2, &descriptors[0], 524288)
  if result < 0 {
    fail.set(status, io.from_linux("pipe", "", result))
    return Pipe{ input: -1, output: -1 }
  }
  flags := #syscall(sys.Fcntl, descriptors[0], 3, 0)
  changed := #syscall(sys.Fcntl, descriptors[0], 4, flags | 2048)
  if changed < 0 {
    close_native(descriptors[0])
    close_native(descriptors[1])
    fail.set(status, io.from_linux("pipe", "", changed))
    return Pipe{ input: -1, output: -1 }
  }
  return Pipe{ input: descriptors[0], output: descriptors[1] }
}
// A pipe with nothing to read yet is no failure: count 0, not ended.
fn read_native(status: *fail.Status, handle: isize, destination: []u8) Read {
  file := fs.adopt_handle(handle)
  attempt: fail.Status
  count := fs.read(&attempt, &file, destination)
  if attempt.failed {
    if attempt.failure.native != -11 {
      fail.set(status, attempt.failure)
    }
    return Read{}
  }
  return Read{ count: count, ended: file.ended }
}
fn milliseconds_native() u64 {
  now := time.monotonic_now()
  return #cast(u64, now.seconds) * 1000 + #cast(u64, (now.nanoseconds / 1000000))
}
fn sleep_native() {
  time.sleep(time.Millisecond)
}
fn environment_native(status: *fail.Status, name: []const u8, destination: []u8) Variable {
  result := os.environment_get(status, name, destination)
  return Variable{ value: result.value, found: result.found }
}

fn duplicate_native(status: *fail.Status, value: isize) isize {
  copied := #syscall(sys.Fcntl, value, 1030, 3)
  if copied < 0 {
    fail.set(status, io.from_linux("duplicate", "", copied))
    return -1
  }
  return copied
}

fn arguments_native(arena: *mem.Arena, status: *fail.Status) [][]const u8 {
  raw := fs.read_all(arena, status, "/proc/self/cmdline", #max(usize))
  empty: [][]const u8
  if status.failed { return empty }
  count: usize = 0
  for byte in raw {
    if byte == 0 {
      count += 1
    }
  }
  if #len(raw) > 0 && raw[#len(raw) - 1] != 0 {
    fail.set(status, fail.make(fail.Kind.InvalidState, "read arguments", "/proc/self/cmdline", "the last argument has no end"))
    return empty
  }
  result := argument_slots(arena, count)
  at: usize = 0
  start: usize = 0
  index: usize = 0
  for at < #len(raw) {
    if raw[at] == 0 {
      result[index] = raw[start..at]
      index += 1
      start = at + 1
    }
    at += 1
  }
  return result
}
