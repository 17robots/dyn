use io "std/io"
#target(kernel: windows)
extern fn argument_command "dyn_arguments_command"() *const u16
// The process's own command line, split by the C runtime's rules
// (split_wide in command_line.dyn).
fn arguments_native(arena: *mem.Arena) [][]const u8!io.IoErr {
  raw := argument_command()
  if raw == nil { fail .InvalidInput }
  native := #slice(raw, 32767)
  length: usize = 0
  for length < 32767 && native[length] != 0 {
    length += 1
  }
  if length == 32767 { fail .Capacity }
  return try split_wide(arena, #slice(raw, length))
}
