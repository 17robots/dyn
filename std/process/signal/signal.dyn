use io "std/io"
// Process signals as events, not handlers. watch routes the chosen signals to
// a queue that the program reads at a safe point; no code runs inside a signal
// handler. On Linux and macOS, call watch on the main thread before starting
// other threads, so every thread inherits the blocked mask.
//
// Interrupt is SIGINT or Ctrl-C (and Ctrl-Break on Windows). Terminate is
// SIGTERM, or a console close, logoff or shutdown event on Windows. Hangup is
// SIGHUP and never arrives on Windows.
//
// WindowChange is SIGWINCH: the controlling terminal changed size. On Windows
// a watch notices the console window's size changing on its own, within 100
// milliseconds, because the console reports resizes only as input records,
// which belong to whoever reads standard input.
//
// Suspend is SIGTSTP, a stop request such as Ctrl-Z in a cooked terminal.
// While it is watched it no longer stops the process: the program chooses
// when to stop, usually by restoring its terminal and calling stop_job.
// Continue is SIGCONT, sent when a stopped job resumes (fg or bg); the
// process continues whether or not it is watched. Neither arrives on
// Windows, which has no job control.
pub enum Kind { None, Interrupt, Terminate, Hangup, WindowChange, Suspend, Continue }

// Kinds to watch.
pub struct Set {
  interrupt: bool,
  terminate: bool,
  hangup: bool,
  window_change: bool,
  suspend: bool,
  continue: bool,
}

// An open watch. handle is the readable descriptor (signalfd or kqueue) or the
// Windows event handle, for use with an event loop.
pub struct Watch { handle: isize, set: Set, active: bool }

// Fails with InvalidInput when set chooses no signal.
pub fn watch(set: Set) Watch!io.IoErr {
  if !set.interrupt && !set.terminate && !set.hangup && !set.window_change && !set.suspend && !set.continue {
    fail .InvalidInput
  }
  return try platform_watch(set)
}

// The next pending signal without blocking; None when nothing is pending.
// A closed watch fails with InvalidInput.
pub fn poll(state: *Watch) Kind!io.IoErr {
  if state == nil || !state.active { fail .InvalidInput }
  return try platform_next(state, false)
}

// Blocks until a watched signal arrives. A closed watch fails with
// InvalidInput.
pub fn wait(state: *Watch) Kind!io.IoErr {
  if state == nil || !state.active { fail .InvalidInput }
  return try platform_next(state, true)
}

// Restores default signal behavior and releases the handle. Closing a zero
// Watch does nothing.
pub fn close(state: *Watch) {
  if state == nil { return }
  if !state.active { return }
  if platform_close(state) {
    state.* = Watch{}
  }
}

// Stops the process's job the way Ctrl-Z does in a cooked terminal: sends
// SIGTSTP with its default action to the process group, and returns once the
// job is continued. It works while Suspend is watched; a watch does not
// report the Suspend this sends, but does report the Continue that follows.
// A process in an orphaned process group is not stopped, and returns at
// once. Restore the terminal first; see terminal.suspend. Fails with
// Unsupported on Windows, which has no job control.
pub fn stop_job() !io.IoErr {
  try platform_stop()
}
