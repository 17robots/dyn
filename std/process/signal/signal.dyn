use "std/io" io
use "std/fail"
// Process signals as events, not handlers. watch routes the chosen signals to
// a queue that the program reads at a safe point; no code runs inside a signal
// handler. On Linux and macOS, call watch on the main thread before starting
// other threads, so every thread inherits the blocked mask.
//
// Interrupt is SIGINT or Ctrl-C (and Ctrl-Break on Windows). Terminate is
// SIGTERM, or a console close, logoff or shutdown event on Windows. Hangup is
// SIGHUP and never arrives on Windows.
pub enum Kind { None, Interrupt, Terminate, Hangup }

// Kinds to watch.
pub struct Set { interrupt: bool, terminate: bool, hangup: bool }

// An open watch. handle is the readable descriptor (signalfd or kqueue) or the
// Windows event handle, for use with an event loop.
pub struct Watch { handle: isize, set: Set, active: bool }

pub fn watch(status: *fail.Status, set: Set) Watch {
  if status == nil { return watch(&fail.Status{}, set) }
  if status.failed { return Watch{} }
  if !set.interrupt && !set.terminate && !set.hangup {
    fail.invalid(status, "watch signals", "", "no signal chosen")
    return Watch{}
  }
  return platform_watch(status, set)
}

fn closed(status: *fail.Status) Kind {
  fail.set(status, fail.make(fail.Kind.InvalidState, "read signal", "", "the watch is closed"))
  return Kind.None
}

// The next pending signal without blocking; None when nothing is pending.
pub fn poll(status: *fail.Status, state: *Watch) Kind {
  if status == nil { return poll(&fail.Status{}, state) }
  if status.failed { return Kind.None }
  if state == nil || !state.active { return closed(status) }
  return platform_next(status, state, false)
}

// Blocks until a watched signal arrives.
pub fn wait(status: *fail.Status, state: *Watch) Kind {
  if status == nil { return wait(&fail.Status{}, state) }
  if status.failed { return Kind.None }
  if state == nil || !state.active { return closed(status) }
  return platform_next(status, state, true)
}

// Restores default signal behavior and releases the handle. Closing a zero
// Watch does nothing.
pub fn close(state: *Watch) {
  if state == nil { return }
  if !state.active { return }
  if platform_close(state) {
    state.* = Watch{}
  }
}
