use io "std/io"
use "std/os/linux/sys"
#target(kernel: linux)

// Blocked signals are read from a signalfd. Numbers: SIGHUP 1, SIGINT 2,
// SIGTERM 15, SIGCONT 18, SIGTSTP 20, SIGWINCH 28; bit n - 1 of the mask is
// signal n.
fn mask_of(set: Set) u64 {
  mask: u64 = 0
  if set.hangup {
    mask |= 1
  }
  if set.interrupt {
    mask |= 2
  }
  if set.terminate {
    mask |= 16384
  }
  if set.continue {
    mask |= 131072
  }
  if set.suspend {
    mask |= 524288
  }
  if set.window_change {
    mask |= 134217728
  }
  return mask
}

fn platform_watch(set: Set) Watch!io.IoErr {
  mask := mask_of(set)
  code := #syscall(sys.RtSigprocmask, 0, &mask, 0, 8)
  if code < 0 { fail io.linux_err(code) }
  // SFD_NONBLOCK | SFD_CLOEXEC.
  descriptor := #syscall(sys.Signalfd4, -1, &mask, 8, 526336)
  if descriptor < 0 {
    _ = #syscall(sys.RtSigprocmask, 1, &mask, 0, 8)
    fail io.linux_err(descriptor)
  }
  return Watch{ handle: descriptor, set: set, active: true }
}

fn kind_of(number: u32) Kind {
  if number == 1 { return Kind.Hangup }
  if number == 2 { return Kind.Interrupt }
  if number == 15 { return Kind.Terminate }
  if number == 18 { return Kind.Continue }
  if number == 20 { return Kind.Suspend }
  if number == 28 { return Kind.WindowChange }
  return Kind.None
}

fn platform_next(state: *Watch, block: bool) Kind!io.IoErr {
  info: [128]u8
  for true {
    count := #syscall(sys.Read, state.handle, &info[0], 128)
    if count == 128 {
      number := #cast(u32, info[0]) | #cast(u32, info[1]) << 8 | #cast(u32, info[2]) << 16 | #cast(u32, info[3]) << 24
      return kind_of(number)
    }
    if count == -11 {
      if !block { return Kind.None }
      // Wait for readability: ppoll on one descriptor with no timeout.
      entry: [8]u8
      descriptor := #cast(u32, state.handle)
      entry[0] = descriptor & 255
      entry[1] = descriptor >> 8 & 255
      entry[2] = descriptor >> 16 & 255
      entry[3] = descriptor >> 24
      entry[4] = 1
      waited := #syscall(sys.Ppoll, &entry[0], 1, 0, 0, 8)
      if waited < 0 && waited != -4 { fail io.linux_err(waited) }
    } else if count != -4 {
      if count >= 0 { fail io.linux_err(-5) }
      fail io.linux_err(count)
    }
  }
  return Kind.None
}

fn platform_close(state: *Watch) bool {
  code := #syscall(sys.Close, state.handle)
  if code < 0 { return false }
  mask := mask_of(state.set)
  _ = #syscall(sys.RtSigprocmask, 1, &mask, 0, 8)
  return true
}

// The kernel's sigaction is at most four words on every Linux architecture;
// the disposition is only read whole and written back.
struct Disposition { words: [4]u64 }

// SIGTSTP may be blocked for a watch, which would leave it queued for the
// signalfd: this thread unblocks it, with the default action, until the job
// continues. kill(0, ...) stops the whole process group, as the shell does.
fn platform_stop() !io.IoErr {
  previous: Disposition
  code := #syscall(sys.RtSigaction, 20, 0, &previous, 8)
  if code < 0 { fail io.linux_err(code) }
  changed := previous.words[0] != 0
  if changed {
    standard := Disposition{}
    code = #syscall(sys.RtSigaction, 20, &standard, 0, 8)
    if code < 0 { fail io.linux_err(code) }
  }
  bit: u64 = 524288
  mask: u64 = 0
  // SIG_UNBLOCK 1, then SIG_SETMASK 2.
  _ = #syscall(sys.RtSigprocmask, 1, &bit, &mask, 8)
  sent := #syscall(sys.Kill, 0, 20)
  _ = #syscall(sys.RtSigprocmask, 2, &mask, 0, 8)
  if changed {
    _ = #syscall(sys.RtSigaction, 20, &previous, 0, 8)
  }
  if sent < 0 { fail io.linux_err(sent) }
}
