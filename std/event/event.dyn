#target(pointer_bits: 64)
use "std/mem" mem
use "std/fail"
use "std/net" net
use "std/time" clock

pub const Readable: u32 = 1
pub const Writable: u32 = 4
pub const Error: u32 = 8
pub const Hangup: u32 = 16
pub struct Event { descriptor: isize, token: u64, events: u32 }
struct Entry { descriptor: isize, token: u64, events: u32, active: bool }
// One owner, one thread. Storage belongs to the opening arena. Remove each
// descriptor before closing/reusing it. A queue never owns its descriptors.
// A native control failure poisons the queue: later calls fail with
// InvalidState. Close and rebuild it, since a platform may have applied part
// of a multi-filter update.
// Lookups are O(1): free entry indices are a stack, and an open-addressed
// table maps descriptor to entry. wait asks the kernel for at most batch
// events; level triggering reports the rest on the next call.
pub struct Queue {
  handle: isize, active: bool, entries: []Entry,
  failed: bool,
  free: []u32, free_count: usize,
  table: []u32, used_slots: usize,
  batch: usize,
  // Where the system writes up to batch ready events: made once by open, so
  // a wait neither allocates nor zeroes it. Empty where the platform builds
  // its list per wait.
  native: []u64,
}
const SlotEmpty: u32 = 0
const SlotRemoved: u32 = 4294967295
const MaxBatch: usize = 512

pub fn open(arena: *mem.Arena, status: *fail.Status, capacity: usize) Queue {
  if status == nil { return open(arena, &fail.Status{}, capacity) }
  if status.failed { return Queue{} }
  if capacity == 0 || capacity > 2147483647 {
    fail.invalid(status, "open event queue", "", "capacity must be 1 to 2147483647")
    return Queue{}
  }
  handle := native_open(status)
  if status.failed { return Queue{} }
  table_size: usize = 8
  for table_size < 2 * capacity {
    table_size *= 2
  }
  batch := capacity
  if batch > MaxBatch {
    batch = MaxBatch
  }
  queue := Queue{
    handle: handle, active: true, entries: mem.push_array(Entry, arena, capacity),
    free: mem.push_array(u32, arena, capacity), free_count: capacity,
    table: mem.push_array(u32, arena, table_size), batch: batch,
    native: mem.push_array(u64, arena, (batch * NativeEventSize + 7) / 8),
  }
  for i in 0..capacity {
    queue.free[i] = #cast(u32, capacity - 1 - i)
  }
  return queue
}
fn slot_start(queue: *const Queue, descriptor: isize) usize {
  // Fibonacci hashing spreads consecutive descriptors.
  hashed := #wrapping(#cast(u64, descriptor) * 11400714819323198485)
  return #cast(usize, hashed >> 32) & (#len(queue.table) - 1)
}
// Table slot holding descriptor, or #len(queue.table).
fn find_slot(queue: *const Queue, descriptor: isize) usize {
  mask := #len(queue.table) - 1
  at := slot_start(queue, descriptor)
  for _ in 0..#len(queue.table) {
    value := queue.table[at]
    if value == SlotEmpty { return #len(queue.table) }
    if value != SlotRemoved && queue.entries[value - 1].descriptor == descriptor { return at }
    at = (at + 1) & mask
  }
  return #len(queue.table)
}
fn find(queue: *Queue, descriptor: isize) usize {
  slot := find_slot(queue, descriptor)
  if slot == #len(queue.table) { return #len(queue.entries) }
  return queue.table[slot] - 1
}
fn table_place(queue: *Queue, descriptor: isize, index: usize) {
  mask := #len(queue.table) - 1
  at := slot_start(queue, descriptor)
  for queue.table[at] != SlotEmpty && queue.table[at] != SlotRemoved {
    at = (at + 1) & mask
  }
  if queue.table[at] == SlotEmpty {
    queue.used_slots += 1
  }
  queue.table[at] = #cast(u32, index + 1)
}
// Removed markers only shorten probes when cleared; rebuild once live plus
// removed slots pass three quarters of the table.
fn table_rebuild(queue: *Queue) {
  for i in 0..#len(queue.table) {
    queue.table[i] = SlotEmpty
  }
  queue.used_slots = 0
  for i in 0..#len(queue.entries) {
    if queue.entries[i].active {
      table_place(queue, queue.entries[i].descriptor, i)
    }
  }
}
// Whether queue can take a call; records why not.
fn usable(status: *fail.Status, queue: *Queue, operation: []const u8) bool {
  if status.failed { return false }
  if !queue.active {
    fail.set(status, fail.make(fail.Kind.InvalidState, operation, "", "the queue is closed"))
    return false
  }
  if queue.failed {
    fail.set(status, fail.make(fail.Kind.InvalidState, operation, "", "an earlier change failed; close and rebuild the queue"))
    return false
  }
  return true
}
fn control(status: *fail.Status, queue: *Queue, index: usize, entry: Entry) {
  native_control(status, queue, index, entry)
  if status.failed {
    queue.failed = true
    return
  }
  queue.entries[index] = entry
}
pub fn add(status: *fail.Status, queue: *Queue, descriptor: isize, events: u32, token: u64) {
  if status == nil {
    add(&fail.Status{}, queue, descriptor, events, token)
    return
  }
  if !usable(status, queue, "add") { return }
  if descriptor < 0 || #cast(net.Descriptor, descriptor) != descriptor || events == 0 || (events & ~#cast(u32, 5)) != 0 {
    fail.invalid(status, "add", "", "events must be Readable and/or Writable on a valid descriptor")
    return
  }
  if find(queue, descriptor) != #len(queue.entries) {
    fail.set(status, fail.make(fail.Kind.AlreadyExists, "add", "", "the descriptor is already in the queue"))
    return
  }
  if queue.free_count == 0 {
    fail.set(status, fail.make(fail.Kind.Capacity, "add", "", "the queue is full"))
    return
  }
  index := #cast(usize, queue.free[queue.free_count - 1])
  control(status, queue, index, Entry{ descriptor: descriptor, token: token, events: events, active: true })
  if status.failed { return }
  queue.free_count -= 1
  if 4 * (queue.used_slots + 1) > 3 * #len(queue.table) {
    table_rebuild(queue)
  }
  table_place(queue, descriptor, index)
}
pub fn modify(status: *fail.Status, queue: *Queue, descriptor: isize, events: u32, token: u64) {
  if status == nil {
    modify(&fail.Status{}, queue, descriptor, events, token)
    return
  }
  if !usable(status, queue, "modify") { return }
  if events == 0 || (events & ~#cast(u32, 5)) != 0 {
    fail.invalid(status, "modify", "", "events must be Readable and/or Writable")
    return
  }
  index := find(queue, descriptor)
  if index == #len(queue.entries) {
    fail.set(status, fail.make(fail.Kind.NotFound, "modify", "", "the descriptor is not in the queue"))
    return
  }
  control(status, queue, index, Entry{ descriptor: descriptor, token: token, events: events, active: true })
}
pub fn remove(status: *fail.Status, queue: *Queue, descriptor: isize) {
  if status == nil {
    remove(&fail.Status{}, queue, descriptor)
    return
  }
  if !usable(status, queue, "remove") { return }
  slot := find_slot(queue, descriptor)
  if slot == #len(queue.table) {
    fail.set(status, fail.make(fail.Kind.NotFound, "remove", "", "the descriptor is not in the queue"))
    return
  }
  index := #cast(usize, queue.table[slot] - 1)
  control(status, queue, index, Entry{})
  if status.failed { return }
  queue.table[slot] = SlotRemoved
  queue.free[queue.free_count] = #cast(u32, index)
  queue.free_count += 1
}
// Level-triggered readiness. Use nonblocking descriptors; readiness can become
// stale before I/O. timeout < 0 waits indefinitely, zero polls. Each call's
// output and temporary arrays belong to arena; use a separate scratch arena
// from the queue's storage. No callbacks or hidden threads run here. An
// interrupted wait continues with the time left; at the end of it the result
// is empty.
pub fn wait(arena: *mem.Arena, status: *fail.Status, queue: *Queue, timeout_milliseconds: i32) []Event {
  if status == nil { return wait(arena, &fail.Status{}, queue, timeout_milliseconds) }
  empty: []Event
  if !usable(status, queue, "wait") { return empty }
  start := clock.Instant{}
  if timeout_milliseconds > 0 {
    start = clock.monotonic_now()
  }
  remaining := timeout_milliseconds
  mark := mem.arena_mark(arena)
  for {
    attempt: fail.Status
    events := native_wait(arena, &attempt, queue, remaining)
    if !attempt.failed { return events }
    if attempt.failure.kind != fail.Kind.Interrupted {
      fail.set(status, attempt.failure)
      return empty
    }
    mem.arena_rewind(arena, mark)
    if timeout_milliseconds > 0 {
      elapsed := clock.elapsed(start, clock.monotonic_now())
      duration := timeout_milliseconds * clock.Millisecond
      if elapsed >= duration { return empty }
      remaining = #cast(i32, ((duration - elapsed + clock.Millisecond - 1) / clock.Millisecond))
    }
  }
  return empty
}
pub fn close(queue: *Queue) {
  if !queue.active { return }
  native_close(queue.handle)
  queue.* = Queue{}
}

// Wakes a queue's owner from another thread. The waker is a loopback datagram
// socket connected to itself, so it works with every queue backend. The owner
// adds descriptor to its queue for Readable and calls waker_drain when it
// fires; any thread may call wake. One wake may cover several posts: drain,
// then look at everything posted.
pub struct Waker { descriptor: isize, active: bool }

pub fn waker_open(status: *fail.Status) Waker {
  if status == nil { return waker_open(&fail.Status{}) }
  descriptor := net.socket(status, net.AddressFamilyIpv4, net.SocketDatagram, 0)
  local := net.ipv4(127, 0, 0, 1, 0)
  net.bind_ipv4(status, descriptor, &local)
  address := net.Address{}
  net.local_address(status, descriptor, &address)
  net.connect(status, descriptor, address.bytes[..address.length])
  net.nonblocking(status, descriptor, true)
  if status.failed {
    if descriptor >= 0 {
      net.close(descriptor)
    }
    return Waker{}
  }
  return Waker{ descriptor: descriptor, active: true }
}

// Never blocks. A full socket buffer means wakes are already pending.
pub fn wake(waker: *const Waker) {
  if !waker.active { return }
  signal: [1]u8 = [1]
  ignored: fail.Status
  _ = net.try_send(&ignored, waker.descriptor, signal[..], 0)
}

// Discards pending wakes. Call on the owner's thread before reading posts.
pub fn waker_drain(waker: *const Waker) {
  if !waker.active { return }
  storage: [64]u8
  for i in 0..1024 {
    drained: fail.Status
    received := net.try_receive(&drained, waker.descriptor, storage[..], 0)
    if drained.failed || received.count == 0 { return }
  }
}

pub fn waker_close(waker: *Waker) {
  if !waker.active { return }
  net.close(waker.descriptor)
  waker.* = Waker{}
}
