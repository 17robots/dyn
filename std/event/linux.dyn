#target(kernel: linux)
fn native_open(status: *fail.Status) isize {
  return net.event_queue(status)
}
fn native_close(handle: isize) {
  net.close(handle)
}
fn native_control(status: *fail.Status, queue: *Queue, index: usize, entry: Entry) {
  old := queue.entries[index]
  if !entry.active {
    net.event_remove(status, queue.handle, old.descriptor)
  } else if old.active {
    net.event_modify(status, queue.handle, entry.descriptor, entry.events, index)
  } else {
    net.event_add(status, queue.handle, entry.descriptor, entry.events, index)
  }
}
fn native_wait(arena: *mem.Arena, status: *fail.Status, queue: *Queue, timeout: i32) []Event {
  native := mem.push_array(net.Event, arena, queue.batch)
  count := net.event_wait(status, queue.handle, native, timeout)
  events := mem.push_array(Event, arena, count)
  for i in 0..#len(events) {
    index := #cast(usize, net.event_data(&native[i]))
    entry := queue.entries[index]
    events[i] = Event{ descriptor: entry.descriptor, token: entry.token, events: net.event_events(&native[i]) & 29 }
  }
  return events
}
