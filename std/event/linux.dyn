#target(kernel: linux)
fn native_open() isize!io.IoErr {
  return try net.event_queue()
}
fn native_close(handle: isize) {
  net.close(handle)
}
fn native_control(queue: *Queue, index: usize, entry: Entry) !io.IoErr {
  old := queue.entries[index]
  if !entry.active {
    try net.event_remove(queue.handle, old.descriptor)
  } else if old.active {
    try net.event_modify(queue.handle, entry.descriptor, entry.events, index)
  } else {
    try net.event_add(queue.handle, entry.descriptor, entry.events, index)
  }
}
const NativeEventSize: usize = #sizeof(net.Event)

fn native_wait(arena: *mem.Arena, queue: *Queue, timeout: i32) []Event!io.IoErr {
  native := #slice(#cast(*net.Event, &queue.native[0]), queue.batch)
  count := try net.event_wait(queue.handle, native, timeout)
  events := mem.push_array<Event>(arena, count)
  for i in 0..events.len {
    index := #cast(usize, net.event_data(&native[i]))
    entry := queue.entries[index]
    events[i] = Event{ descriptor: entry.descriptor, token: entry.token, events: net.event_events(&native[i]) & 29 }
  }
  return events
}
