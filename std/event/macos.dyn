use "std/io" io
use "std/os/macos/sys"
#target(kernel: darwin)
struct Kevent { ident: u64, filter: i16, flags: u16, filter_flags: u32, data: i64, user: u64 }
struct Timeout { seconds: i64, nanoseconds: i64 }
fn native_open(status: *fail.Status) isize {
  value := #syscall(sys.Kqueue)
  if value < 0 {
    fail.set(status, io.from_darwin("open event queue", "", value))
    return -1
  }
  return value
}
fn native_close(handle: isize) {
  _ = #syscall(sys.Close, handle)
}
fn native_control(status: *fail.Status, queue: *Queue, index: usize, entry: Entry) {
  old := queue.entries[index]
  changes: [2]Kevent
  count: usize = 0
  for i in 0..2 {
    bit: u32 = Readable
    filter: i16 = -1
    if i == 1 {
      bit = Writable
      filter = -2
    }
    before := old.active && (old.events & bit) != 0
    after := entry.active && (entry.events & bit) != 0
    if before || after {
      flags: u16 = 2
      descriptor := old.descriptor
      if after {
        flags = 1
        descriptor = entry.descriptor
      }
      changes[count] = Kevent{ ident: #cast(u64, descriptor), filter: filter, flags: flags, user: index }
      count += 1
    }
  }
  code := #syscall(sys.Kevent, queue.handle, &changes[0], count, 0, 0, 0)
  if code < 0 {
    fail.set(status, io.from_darwin("change event queue", "", code))
  }
}
const NativeEventSize: usize = #sizeof(Kevent)

fn native_wait(arena: *mem.Arena, status: *fail.Status, queue: *Queue, milliseconds: i32) []Event {
  native := #slice(#cast(*Kevent, &queue.native[0]), queue.batch)
  timeout := Timeout{}
  pointer: *Timeout = nil
  if milliseconds >= 0 {
    timeout.seconds = (milliseconds / 1000)
    timeout.nanoseconds = #cast(i64, (milliseconds % 1000)) * 1000000
    pointer = &timeout
  }
  code := #syscall(sys.Kevent, queue.handle, 0, 0, &native[0], #len(native), pointer)
  if code < 0 {
    fail.set(status, io.from_darwin("wait", "", code))
    empty: []Event
    return empty
  }
  events := mem.push_array(Event, arena, #cast(usize, code))
  for i in 0..#len(events) {
    entry := queue.entries[#cast(usize, native[i].user)]
    flags := Readable
    if native[i].filter == -2 {
      flags = Writable
    }
    if (native[i].flags & 32768) != 0 {
      flags |= Hangup
    }
    if (native[i].flags & 16384) != 0 {
      flags |= Error
    }
    events[i] = Event{ descriptor: entry.descriptor, token: entry.token, events: flags }
  }
  return events
}
