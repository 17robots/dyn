module env

os := use "std/os"

pub EnvError := enum {
    CurrentDirUnavailable,
}

pub args_len := () usize => os.env_argc()

pub arg := (index: usize) ?[]u8 => {
    value := os.env_argv(index)
    if value == 0 null else value
}

pub get := (name: []u8) ?[]u8 => {
    value := os.env_get(name)
    if value == 0 null else value
}

pub cwd := () []u8!EnvError => {
    value := os.env_cwd()
    if value == 0 .CurrentDirUnavailable else value
}
