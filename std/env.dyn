module env

os := use "std/os"

pub EnvError := enum {
    CurrentDirUnavailable,
}

value_or_null_bytes := (value: []u8) ?[]u8 => if value == 0 null else value

require_bytes := (value: []u8, err: EnvError) []u8!EnvError {
    if value == 0 return err
    return value
}

pub args_len := () usize => os.env_argc()

pub arg := (index: usize) ?[]u8 => value_or_null_bytes(os.env_argv(index))

pub get := (name: []u8) ?[]u8 => value_or_null_bytes(os.env_get(name))

pub cwd := () []u8!EnvError => require_bytes(os.env_cwd(), .CurrentDirUnavailable)
