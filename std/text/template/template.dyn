use byte_ops "std/bytes"
use stream "std/io"
use memory "std/mem"
use parse "std/parse"

pub struct Template { source: []const u8 }
pub struct Field { name: []const u8, value: []const u8 }

fn trim(source: []const u8) []const u8 {
  start: usize = 0
  end := source.len
  for start < end && (source[start] == ' ' || source[start] == '\t' || source[start] == '\n' || source[start] == '\r') {
    start += 1
  }
  for end > start && (source[end - 1] == ' ' || source[end - 1] == '\t' || source[end - 1] == '\n' || source[end - 1] == '\r') {
    end -= 1
  }
  return source[start..end]
}

fn valid_name(name: []const u8) bool {
  if name.len == 0 { return false }
  for i in 0..name.len {
    byte := name[i]
    if !((byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z') ||
        (byte >= '0' && byte <= '9') || byte == '_' || byte == '.') {
      return false
    }
  }
  return true
}

// Validates before allocating; the retained source borrows the arena's lifetime.
// Required storage exhaustion panics, including for nonempty literal templates.
// A malformed {{field}} fails with Invalid at its offset.
pub fn parse(arena: *memory.Arena, source: []const u8) Template!parse.ParseErr {
  cursor: usize = 0
  for cursor < source.len {
    if cursor + 1 < source.len && source[cursor] == '{' && source[cursor + 1] == '{' {
      end := cursor + 2
      for end + 1 < source.len && !(source[end] == '}' && source[end + 1] == '}') {
        end += 1
      }
      if end + 1 >= source.len || !valid_name(trim(source[cursor + 2..end])) { fail parse.ParseErr.Invalid(cursor) }
      cursor = end + 2
    } else {
      cursor += 1
    }
  }
  retained := memory.push_bytes(arena, source.len)
  _ = memory.copy(retained, source)
  return Template{ source: retained }
}

fn value(fields: []const Field, name: []const u8) []const u8 {
  for field in fields {
    if byte_ops.equal(field.name, name) { return field.value }
  }
  return ""
}

fn write(destination: stream.Writer, source: []const u8) !stream.IoErr {
  try stream.write(destination, source)
}

pub fn render(destination: stream.Writer, template: *const Template, fields: []const Field) !stream.IoErr {
  try render_with(destination, template, fields, write)
}

// Field rendering seam shared by plain-text and HTML templates. Literal text
// is unchanged. A malformed field fails with InvalidInput, as does a nil
// template or renderer.
pub fn render_with(destination: stream.Writer, template: *const Template, fields: []const Field,
  render_field: fn(stream.Writer, []const u8) !stream.IoErr) !stream.IoErr {
  if template == nil || render_field == nil { fail .InvalidInput }
  cursor: usize = 0
  literal: usize = 0
  for cursor < template.source.len {
    if cursor + 1 < template.source.len && template.source[cursor] == '{' && template.source[cursor + 1] == '{' {
      if cursor > literal {
        try stream.write(destination, template.source[literal..cursor])
      }
      end := cursor + 2
      for end + 1 < template.source.len && !(template.source[end] == '}' && template.source[end + 1] == '}') {
        end += 1
      }
      if end + 1 >= template.source.len || !valid_name(trim(template.source[cursor + 2..end])) { fail .InvalidInput }
      try render_field(destination, value(fields, trim(template.source[cursor + 2..end])))
      cursor = end + 2
      literal = cursor
    } else {
      cursor += 1
    }
  }
  if literal < template.source.len {
    try stream.write(destination, template.source[literal..])
  }
}
