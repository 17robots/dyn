use "std/bytes" byte_ops
use "std/io" stream
use "std/mem" memory
use "std/errors" errors

pub enum ErrorKind { None, Syntax, OutOfMemory, Io }

pub struct Template { source: []const u8 }
pub struct Field { name: []const u8, value: []const u8 }
// Offsets identify source positions when known; zero also represents unknown.
pub struct ParseResult { value: Template, kind: errors.Kind, error: isize, detail: ErrorKind, offset: usize, ok: bool }
pub struct RenderResult { kind: errors.Kind, error: isize, detail: ErrorKind, offset: usize, ok: bool }



fn trim(source: []const u8) []const u8 {
  start: usize = 0
  end := #len(source)
  for start < end && (source[start] == ' ' || source[start] == '\t' || source[start] == '\n' || source[start] == '\r') {
    start += 1
  }
  for end > start && (source[end - 1] == ' ' || source[end - 1] == '\t' || source[end - 1] == '\n' || source[end - 1] == '\r') {
    end -= 1
  }
  return source[start..end]
}

fn valid_name(name: []const u8) bool {
  if #len(name) == 0 {
    return false
  }
  for i in 0..#len(name) {
    byte := name[i]
    if !((byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z') ||
        (byte >= '0' && byte <= '9') || byte == '_' || byte == '.') {
      return false
    }
  }
  return true
}

// Validates before allocating; the retained source borrows the arena's lifetime.
// Required storage exhaustion panics, including for nonempty literal templates.
pub fn parse(arena: *memory.Arena, source: []const u8) ParseResult {
  cursor: usize = 0
  for cursor < #len(source) {
    if cursor + 1 < #len(source) && source[cursor] == '{' && source[cursor + 1] == '{' {
      end := cursor + 2
      for end + 1 < #len(source) && !(source[end] == '}' && source[end + 1] == '}') {
        end += 1
      }
      if end + 1 >= #len(source) || !valid_name(trim(source[cursor + 2..end])) {
        return ParseResult{ kind: errors.Kind.InvalidInput, detail: ErrorKind.Syntax, offset: cursor, ok: false }
      }
      cursor = end + 2
    } else {
      cursor += 1
    }
  }
  retained: []u8
  if #len(source) > 0 {
    retained = memory.arena_push(arena, #len(source), 1)[..#len(source)]
    for i in 0..#len(source) {
      retained[i] = source[i]
    }
  }
  return ParseResult{ value: Template{ source: retained }, kind: errors.Kind.None, ok: true }
}

fn value(fields: []const Field, name: []const u8) []const u8 {
  for field in fields {
    if byte_ops.equal(field.name, name) {
      return field.value
    }
  }
  return ""
}

fn write(destination: stream.Writer, source: []const u8) RenderResult {
  result := stream.write_all(destination, source)
  if result.status == stream.Status.Error {
    return RenderResult{ kind: result.kind, error: result.error, detail: ErrorKind.Io, ok: false }
  }
  return RenderResult{ kind: errors.Kind.None, ok: true }
}

// Literal output maps directly to source bytes, unlike expanded field values.
fn write_literal(destination: stream.Writer, source: []const u8, offset: usize) RenderResult {
  result := stream.write_all(destination, source)
  if result.status == stream.Status.Error {
    return RenderResult{ kind: result.kind, error: result.error, detail: ErrorKind.Io,
      offset: offset + result.transferred }
  }
  return RenderResult{ ok: true }
}

pub fn render(destination: stream.Writer, template: *const Template, fields: []const Field) RenderResult {
  return render_with(destination, template, fields, &write)
}

// Field rendering seam shared by plain-text and HTML templates. Literal text is unchanged.
pub fn render_with(destination: stream.Writer, template: *const Template, fields: []const Field,
  render_field: fn(stream.Writer, []const u8) RenderResult) RenderResult {
  if template == nil || render_field == nil {
    return RenderResult{ kind: errors.Kind.InvalidInput, detail: ErrorKind.Syntax }
  }
  cursor: usize = 0
  literal: usize = 0
  for cursor < #len(template.source) {
    if cursor + 1 < #len(template.source) && template.source[cursor] == '{' && template.source[cursor + 1] == '{' {
      if cursor > literal {
        literal_result := write_literal(destination, template.source[literal..cursor], literal)
        if !literal_result.ok {
          return literal_result
        }
      }
      end := cursor + 2
      for end + 1 < #len(template.source) && !(template.source[end] == '}' && template.source[end + 1] == '}') {
        end += 1
      }
      if end + 1 >= #len(template.source) || !valid_name(trim(template.source[cursor + 2..end])) {
        return RenderResult{ kind: errors.Kind.InvalidInput, detail: ErrorKind.Syntax, offset: cursor }
      }
      field_result := render_field(destination, value(fields, trim(template.source[cursor + 2..end])))
      if !field_result.ok {
        return field_result
      }
      cursor = end + 2
      literal = cursor
    } else {
      cursor += 1
    }
  }
  if literal < #len(template.source) {
    return write_literal(destination, template.source[literal..], literal)
  }
  return RenderResult{ kind: errors.Kind.None, ok: true }
}
