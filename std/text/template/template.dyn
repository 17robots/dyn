use byte_ops "std/bytes"
use stream "std/io"
use memory "std/mem"
use "std/fail"

pub struct Template { source: []const u8 }
pub struct Field { name: []const u8, value: []const u8 }

fn trim(source: []const u8) []const u8 {
  start: usize = 0
  end := source.len
  for start < end && (source[start] == ' ' || source[start] == '\t' || source[start] == '\n' || source[start] == '\r') {
    start += 1
  }
  for end > start && (source[end - 1] == ' ' || source[end - 1] == '\t' || source[end - 1] == '\n' || source[end - 1] == '\r') {
    end -= 1
  }
  return source[start..end]
}

fn valid_name(name: []const u8) bool {
  if name.len == 0 { return false }
  for i in 0..name.len {
    byte := name[i]
    if !((byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z') ||
        (byte >= '0' && byte <= '9') || byte == '_' || byte == '.') {
      return false
    }
  }
  return true
}

// Validates before allocating; the retained source borrows the arena's lifetime.
// Required storage exhaustion panics, including for nonempty literal templates.
// A malformed {{field}} fails with InvalidInput at its offset.
pub fn parse(arena: *memory.Arena, status: *fail.Status, source: []const u8) Template {
  if status == nil { return parse(arena, &fail.Status{}, source) }
  if status.failed { return Template{} }
  cursor: usize = 0
  for cursor < source.len {
    if cursor + 1 < source.len && source[cursor] == '{' && source[cursor + 1] == '{' {
      end := cursor + 2
      for end + 1 < source.len && !(source[end] == '}' && source[end + 1] == '}') {
        end += 1
      }
      if end + 1 >= source.len || !valid_name(trim(source[cursor + 2..end])) {
        fail.at(status, fail.Kind.InvalidInput, "parse template", "malformed field", cursor)
        return Template{}
      }
      cursor = end + 2
    } else {
      cursor += 1
    }
  }
  retained := memory.push_bytes(arena, source.len)
  _ = memory.copy(retained, source)
  return Template{ source: retained }
}

fn value(fields: []const Field, name: []const u8) []const u8 {
  for field in fields {
    if byte_ops.equal(field.name, name) { return field.value }
  }
  return ""
}

fn write(status: *fail.Status, destination: stream.Writer, source: []const u8) {
  stream.write_status(status, destination, source)
}

pub fn render(status: *fail.Status, destination: stream.Writer, template: *const Template, fields: []const Field) {
  if status == nil {
    render(&fail.Status{}, destination, template, fields)
    return
  }
  render_with(status, destination, template, fields, write)
}

// Field rendering seam shared by plain-text and HTML templates. Literal text
// is unchanged. A malformed field fails with InvalidInput at its offset.
pub fn render_with(status: *fail.Status, destination: stream.Writer, template: *const Template, fields: []const Field,
  render_field: fn(*fail.Status, stream.Writer, []const u8)) {
  if status == nil {
    render_with(&fail.Status{}, destination, template, fields, render_field)
    return
  }
  if status.failed { return }
  if template == nil || render_field == nil {
    fail.invalid(status, "render template", "", "no template or field renderer")
    return
  }
  cursor: usize = 0
  literal: usize = 0
  for cursor < template.source.len {
    if cursor + 1 < template.source.len && template.source[cursor] == '{' && template.source[cursor + 1] == '{' {
      if cursor > literal {
        stream.write_status(status, destination, template.source[literal..cursor])
        if status.failed { return }
      }
      end := cursor + 2
      for end + 1 < template.source.len && !(template.source[end] == '}' && template.source[end + 1] == '}') {
        end += 1
      }
      if end + 1 >= template.source.len || !valid_name(trim(template.source[cursor + 2..end])) {
        fail.at(status, fail.Kind.InvalidInput, "render template", "malformed field", cursor)
        return
      }
      render_field(status, destination, value(fields, trim(template.source[cursor + 2..end])))
      if status.failed { return }
      cursor = end + 2
      literal = cursor
    } else {
      cursor += 1
    }
  }
  if literal < template.source.len {
    stream.write_status(status, destination, template.source[literal..])
  }
}
