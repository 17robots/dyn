// line and column are zero-based, so a zero Scanner{ source: text } is ready to use.
// Add one to each for display. ended turns true when next_line or next_field
// finds nothing left; that call returns "".
pub struct Scanner { source: []const u8, offset: usize, line: usize, column: usize, ended: bool }

pub fn scanner(source: []const u8) Scanner {
  return Scanner{ source: source }
}

pub fn finished(state: *const Scanner) bool {
  return state.offset == #len(state.source)
}
pub fn rest(state: *const Scanner) []const u8 {
  return state.source[state.offset..]
}

pub fn advance(state: *Scanner, amount: usize) bool {
  if amount > #len(state.source) - state.offset { return false }
  end := state.offset + amount
  for state.offset < end {
    if state.source[state.offset] == '\n' {
      state.line += 1
      state.column = 0
    } else {
      state.column += 1
    }
    state.offset += 1
  }
  return true
}

// The next line without its \n or \r\n. Sets state.ended at the end.
pub fn next_line(state: *Scanner) []const u8 {
  if finished(state) {
    state.ended = true
    return ""
  }
  start := state.offset
  for state.offset < #len(state.source) && state.source[state.offset] != '\n' {
    state.offset += 1
    state.column += 1
  }
  end := state.offset
  if end > start && state.source[end - 1] == '\r' {
    end -= 1
  }
  line := state.source[start..end]
  if state.offset < #len(state.source) {
    state.offset += 1
    state.line += 1
    state.column = 0
  }
  return line
}

// The next run of bytes without spaces, tabs or line breaks.
// Sets state.ended when only those are left.
pub fn next_field(state: *Scanner) []const u8 {
  for state.offset < #len(state.source) {
    byte := state.source[state.offset]
    if byte != ' ' && byte != '\t' && byte != '\n' && byte != '\r' { break }
    _ = advance(state, 1)
  }
  if finished(state) {
    state.ended = true
    return ""
  }
  start := state.offset
  for state.offset < #len(state.source) {
    field_byte := state.source[state.offset]
    if field_byte == ' ' || field_byte == '\t' || field_byte == '\n' || field_byte == '\r' { break }
    _ = advance(state, 1)
  }
  return state.source[start..state.offset]
}
