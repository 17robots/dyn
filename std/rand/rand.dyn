// Deterministic caller-owned PRNG. Not suitable for cryptography.

pub struct State { value: u64 }

pub fn seeded(seed: u64) State {
  seed %= 2147483647
  if seed == 0 {
    seed = 1
  }
  return State{ value: seed }
}

pub fn next_u64(state: *State) u64 {
  state.value = (state.value * 48271) % 2147483647
  return state.value
}

// Unbiased result in [0, limit). Panics when limit is zero or above
// 2147483646, the generator's range.
pub fn below(state: *State, limit: u64) u64 {
  range: u64 = 2147483646
  if limit == 0 || limit > range {
    #panic("rand.below: limit must be in 1..2147483646")
  }
  usable := range - range % limit
  value := next_u64(state) - 1
  for value >= usable {
    value = next_u64(state) - 1
  }
  return value % limit
}

pub fn fill(state: *State, destination: []u8) {
  for *byte in destination {
    byte.* = #cast(u8, (next_u64(state) % 256))
  }
}
