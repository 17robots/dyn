// Strict UTF-8 over byte slices. Invalid decoding consumes one byte for recovery.
use "std/encoding/binary"


pub struct Decode {
  codepoint: u32,
  width: usize,
  valid: bool,
}

pub fn decode(text: []const u8, offset: usize) Decode {
  if offset >= text.len { return Decode{ codepoint: 0, width: 0, valid: false } }
  first := text[offset]
  if first < 128 { return Decode{ codepoint: first, width: 1, valid: true } }
  width: usize = 0
  value: u32 = 0
  minimum: u32 = 0
  if first >= 194 && first <= 223 {
    width = 2
    value = (first & 31)
    minimum = 128
  } else if first >= 224 && first <= 239 {
    width = 3
    value = (first & 15)
    minimum = 2048
  } else if first >= 240 && first <= 244 {
    width = 4
    value = (first & 7)
    minimum = 65536
  } else {
    return Decode{ codepoint: 0, width: 1, valid: false }
  }
  if width > text.len - offset { return Decode{ codepoint: 0, width: 1, valid: false } }
  for i in 1..width {
    byte := text[offset + i]
    if byte < 128 || byte > 191 { return Decode{ codepoint: 0, width: 1, valid: false } }
    value = (value << 6) | (byte & 63)
  }
  if value < minimum || value > 1114111 || (value >= 55296 && value <= 57343) {
    return Decode{ codepoint: 0, width: 1, valid: false }
  }
  return Decode{ codepoint: value, width: width, valid: true }
}

pub fn valid(text: []const u8) bool {
  offset: usize = 0
  for offset < text.len {
    // Eight ASCII bytes at a time: none has its high bit set.
    if text.len - offset >= 8 && (binary.load_u64_le(text[offset..offset + 8]) & 0x8080808080808080) == 0 {
      offset += 8
      continue
    }
    // ASCII bytes are complete code points; avoid constructing Decode for each.
    if text[offset] < 128 {
      offset += 1
      continue
    }
    decoded := decode(text, offset)
    if !decoded.valid { return false }
    offset += decoded.width
  }
  return true
}

// Code points in text, counting each byte of invalid UTF-8 as one (the
// U+FFFD it would decode to). Use valid to reject invalid text.
pub fn codepoint_count(text: []const u8) usize {
  offset: usize = 0
  total: usize = 0
  for offset < text.len {
    // Eight ASCII bytes at a time: none has its high bit set.
    if text.len - offset >= 8 && (binary.load_u64_le(text[offset..offset + 8]) & 0x8080808080808080) == 0 {
      offset += 8
      total += 8
      continue
    }
    if text[offset] < 128 {
      offset += 1
      total += 1
      continue
    }
    decoded := decode(text, offset)
    if decoded.valid {
      offset += decoded.width
    } else {
      offset += 1
    }
    total += 1
  }
  return total
}

pub fn encoded_width(codepoint: u32) usize {
  if codepoint <= 127 { return 1 }
  if codepoint <= 2047 { return 2 }
  if codepoint >= 55296 && codepoint <= 57343 { return 0 }
  if codepoint <= 65535 { return 3 }
  if codepoint <= 1114111 { return 4 }
  return 0
}

pub fn encode(destination: []u8, codepoint: u32) usize {
  width := encoded_width(codepoint)
  if width == 0 || destination.len < width { return 0 }
  continuation: u32 = 128
  mask: u32 = 63
  lead2: u32 = 192
  lead3: u32 = 224
  lead4: u32 = 240
  if width == 1 {
    destination[0] = #cast(u8, codepoint)
  } else if width == 2 {
    destination[0] = #cast(u8, (lead2 | (codepoint >> 6)))
    destination[1] = #cast(u8, (continuation | (codepoint & mask)))
  } else if width == 3 {
    destination[0] = #cast(u8, (lead3 | (codepoint >> 12)))
    destination[1] = #cast(u8, (continuation | ((codepoint >> 6) & mask)))
    destination[2] = #cast(u8, (continuation | (codepoint & mask)))
  } else {
    destination[0] = #cast(u8, (lead4 | (codepoint >> 18)))
    destination[1] = #cast(u8, (continuation | ((codepoint >> 12) & mask)))
    destination[2] = #cast(u8, (continuation | ((codepoint >> 6) & mask)))
    destination[3] = #cast(u8, (continuation | (codepoint & mask)))
  }
  return width
}

pub struct Iterator {
  text: []const u8,
  offset: usize,
  // Set by the next call that finds no code point left; it returns 0.
  ended: bool,
}

pub fn iterator(text: []const u8) Iterator {
  return Iterator{ text: text, offset: 0, ended: false }
}

// The next code point; sets state.ended at the end. A byte of invalid UTF-8
// gives U+FFFD and is skipped. Use valid to reject invalid text.
pub fn next(state: *Iterator) u32 {
  if state.offset >= state.text.len {
    state.ended = true
    return 0
  }
  decoded := decode(state.text, state.offset)
  if !decoded.valid {
    state.offset += 1
    return 0xfffd
  }
  state.offset += decoded.width
  return decoded.codepoint
}

// The longest prefix of text that is at most limit bytes long and does not
// end inside a code point: a valid multi-byte sequence that would cross limit
// is left out whole. Bytes of invalid UTF-8 count as one-byte code points, so
// the result is never shorter than limit - 3 when text is longer than limit.
// Ownership: the result borrows text.
pub fn truncate(text: []const u8, limit: usize) []const u8 {
  if text.len <= limit { return text }
  // A sequence crossing limit starts at most three bytes before it.
  back: usize = 1
  for back <= 3 && back <= limit {
    start := limit - back
    lead := text[start]
    if lead < 128 || lead >= 192 {
      decoded := decode(text, start)
      if decoded.valid && decoded.width > back { return text[..start] }
      return text[..limit]
    }
    back += 1
  }
  return text[..limit]
}
