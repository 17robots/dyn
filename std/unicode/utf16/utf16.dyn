pub const Replacement: u32 = 65533

pub struct Decode { codepoint: u32, width: usize, valid: bool }

pub fn decode(source: []const u16, offset: usize) Decode {
  if offset >= #len(source) { return Decode{} }
  first := source[offset]
  if first < 55296 || first > 57343 { return Decode{ codepoint: first, width: 1, valid: true } }
  if first >= 56320 || offset + 1 >= #len(source) {
    return Decode{ codepoint: Replacement, width: 1, valid: false }
  }
  second := source[offset + 1]
  if second < 56320 || second > 57343 {
    return Decode{ codepoint: Replacement, width: 1, valid: false }
  }
  high := #cast(u32, (first - 55296))
  low := #cast(u32, (second - 56320))
  return Decode{ codepoint: 65536 + high * 1024 + low, width: 2, valid: true }
}

pub fn encode(destination: []u16, codepoint: u32) usize {
  if codepoint > 1114111 || (codepoint >= 55296 && codepoint <= 57343) { return 0 }
  if codepoint < 65536 {
    if #len(destination) < 1 { return 0 }
    destination[0] = #cast(u16, codepoint)
    return 1
  }
  if #len(destination) < 2 { return 0 }
  value := codepoint - 65536
  destination[0] = #cast(u16, (55296 + value / 1024))
  destination[1] = #cast(u16, (56320 + value % 1024))
  return 2
}

pub fn valid(source: []const u16) bool {
  offset: usize = 0
  for offset < #len(source) {
    decoded := decode(source, offset)
    if !decoded.valid { return false }
    offset += decoded.width
  }
  return true
}

// Code points in source, counting each unit of invalid UTF-16 (an unpaired
// surrogate) as one. Use valid to reject invalid text.
pub fn codepoint_count(source: []const u16) usize {
  count: usize = 0
  offset: usize = 0
  for offset < #len(source) {
    decoded := decode(source, offset)
    if decoded.valid {
      offset += decoded.width
    } else {
      offset += 1
    }
    count += 1
  }
  return count
}
