module page_allocator

__dyn_os_alloc := extern fn(i32, i32) i32
__dyn_os_free := extern fn(i32, i32, i32) i32
__dyn_os_realloc := extern fn(i32, i32, i32, i32, i32) i32
__dyn_os_load_i32 := extern fn(i32, i32) i32
__dyn_os_store_i32 := extern fn(i32, i32, i32) i32

pub alloc := (size: i32, align: i32) i32 => __dyn_os_alloc(size, align)
pub free := (ptr: i32, size: i32, align: i32) i32 => __dyn_os_free(ptr, size, align)
pub realloc := (ptr: i32, old_size: i32, old_align: i32, new_size: i32, new_align: i32) i32 => __dyn_os_realloc(ptr, old_size, old_align, new_size, new_align)
pub load_i32 := (ptr: i32, index: i32) i32 => __dyn_os_load_i32(ptr, index)
pub store_i32 := (ptr: i32, index: i32, value: i32) i32 => __dyn_os_store_i32(ptr, index, value)
