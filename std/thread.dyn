module thread

pthread_create  := extern (thread: *any, attr: *any, start: fn(*any) *any, arg: *any) i32 = "pthread_create"
pthread_join    := extern (thread: usize, retval: *any) i32 = "pthread_join"
pthread_self    := extern () usize = "pthread_self"
pthread_detach  := extern (thread: usize) i32 = "pthread_detach"

/// A handle to a spawned OS thread (pthread_t).
pub Thread := struct {
    _handle: usize,
    /// Block until this thread finishes.
    join := (self: Thread) {
        pthread_join(self._handle, $as(*any, 0))
    }

    /// Detach this thread so its resources are automatically reclaimed when it exits.
    /// After calling detach(), join() must not be called.
    detach := (self: Thread) {
        pthread_detach(self._handle)
    }
}

/// Entry point called by pthreads. Casts arg back to fn() void and calls it.
thread_entry := (arg: *any) *any {
    f := $as(fn() void, arg)
    f()
    return $as(*any, 0)
}

/// Spawn a new thread that calls f().
/// Returns null if thread creation fails.
///
/// Note: f must outlive the thread. For heap-allocated closures,
/// use spawn_ptr which takes a *any and a wrapper function.
pub spawn := (f: fn() void) ?Thread {
    mut handle: usize = 0
    ret := pthread_create(
        $as(*any, &handle),
        $as(*any, 0),
        thread_entry,
        $as(*any, f),
    )
    if ret != 0 return null
    return .{ _handle: handle }
}

/// Spawn a thread with an explicit context pointer and entry function.
/// entry receives ctx and returns null. Useful for closures over heap data.
pub spawn_with := (ctx: *any, entry: fn(*any) *any) ?Thread {
    mut handle: usize = 0
    ret := pthread_create(
        $as(*any, &handle),
        $as(*any, 0),
        entry,
        ctx,
    )
    if ret != 0 return null
    return .{ _handle: handle }
}

/// Return the pthread_t of the calling thread.
pub current_id := () usize => pthread_self()
