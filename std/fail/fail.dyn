// Failure as state you pass in. A function that can fail takes a
// *fail.Status, the way a function that allocates takes a *mem.Arena, so the
// signature says which calls can fail.
//
// The first failure is recorded in the status and stays there. Every function
// given a failed status does nothing and returns zero or empty. So code does
// not check after each call: it checks status.failed once, before it acts on
// the results, and prints status.failure with describe:
//
//   status: fail.Status
//   text := fs.read_all(arena, &status, "app.json", 1 << 20)
//   ...
//   if status.failed {
//     storage: [512]u8
//     io.eprintln("app: {}", fail.describe(storage[..], status.failure))
//   }
//
// The rules, for every std and vendor call:
// 1. If it can fail, it takes the status, and returns zero or empty after a
//    failure.
// 2. A lookup always returns a usable value: zero or empty when it is not
//    there, with NotFound on the status. Read an optional value with a status
//    of its own, or pass nil when you do not care why: the call records
//    nothing and returns zero or empty. An iterator returns its value too,
//    and sets ended on its state when it has nothing left.
// 3. Check status.failed before you use what you got: before printing
//    results, or using a computed number as a size or index.
// In a loop that keeps going after a failure, give each item its own status.
// Cleanup functions take none, so they work after a failure. To react to one
// kind of failure, give that step its own status and look at failure.kind.
// Record your own failures with invalid (bad input), at (a place in the
// input) or set(make(...)) (anything else).

// The portable reason. Kind.Ok is the zero value.
pub enum Kind { Ok, InvalidInput, InvalidState, NotFound, PermissionDenied, AlreadyExists, Capacity, Overflow, Interrupted, WouldBlock, Unsupported, System }

// What went wrong, where, and doing what. 32 bytes, so a Status is 56.
//
// The text (operation, message and path) is kept in a ring that the whole
// process shares, so a Failure stays small and copying one is cheap. A
// failure keeps up to 1 KiB of text (256 bytes on 32-bit targets); a longer
// path keeps its end, after "...". The text stays readable until about 4 KiB
// of newer failure text has been recorded on the same part of the ring
// (threads mostly use parts of their own). After that the *_text functions
// return "" and describe gives the kind and the system's code instead.
pub struct Failure {
  kind: Kind,
  has_offset: bool,
  operation_length: u16,
  message_length: u16,
  path_length: u16,
  // The system's own code, when the system gave one.
  native: isize,
  // For text input: where it went wrong, in bytes from the start.
  offset: usize,
  // Where the text starts in the ring.
  text_at: u64,
}

pub struct Status {
  failed: bool,
  failure: Failure,
  // Optional. Called once, inside the call that failed, when the first
  // failure is recorded, with context. It cannot undo the failure.
  on_failure: fn(rawptr, *const Failure),
  context: rawptr,
}

// A failure of kind with its text copied into the ring. operation is what
// was being done ("open", "parse"), path the file, address or document
// involved, and message the specific reason; empty parts are left out of
// describe. Set native or offset on the result when there is one.
pub fn make(kind: Kind, operation: []const u8, path: []const u8, message: []const u8) Failure {
  result := Failure{ kind: kind }
  // Operation and message are short and say the most; the path gets the rest.
  operation_kept := smaller(#len(operation), MaxText)
  message_kept := smaller(#len(message), MaxText - operation_kept)
  room := MaxText - operation_kept - message_kept
  path_kept := #len(path)
  cut := path_kept > room
  if cut {
    path_kept = room
    if room < 4 {
      path_kept = 0
    }
  }
  total := operation_kept + message_kept + path_kept
  if total == 0 { return result }
  result.text_at = ring_reserve(total)
  base := ring_offset(result.text_at)
  text := ring[base..base + total]
  _ = keep(text, operation[..operation_kept])
  _ = keep(text[operation_kept..], message[..message_kept])
  path_start := operation_kept + message_kept
  if cut && path_kept > 0 {
    _ = keep(text[path_start..], "...")
    _ = keep(text[path_start + 3..], path[#len(path) - (path_kept - 3)..])
  } else {
    _ = keep(text[path_start..], path[..path_kept])
  }
  result.operation_length = #cast(u16, operation_kept)
  result.message_length = #cast(u16, message_kept)
  result.path_length = #cast(u16, path_kept)
  return result
}

fn smaller(a: usize, b: usize) usize {
  if a < b { return a }
  return b
}

// Copies as much of text as fits into storage; the count copied.
fn keep(storage: []u8, text: []const u8) usize {
  count := #len(text)
  if count > #len(storage) {
    count = #len(storage)
  }
  for i in 0..count {
    storage[i] = text[i]
  }
  return count
}

// All of a failure's text, or "" once newer text has taken its place in
// the ring.
fn text_of(failure: *const Failure) []const u8 {
  total: usize = #cast(usize, failure.operation_length) + failure.message_length + failure.path_length
  if total == 0 || !text_kept(failure) { return ring[..0] }
  base := ring_offset(failure.text_at)
  return ring[base..base + total]
}

fn text_kept(failure: *const Failure) bool {
  return ring_kept(failure.text_at)
}

// The parts of a failure's text. Each borrows the ring: use it before many
// newer failures are recorded, or copy it. "" once the text is gone.
pub fn operation_text(failure: *const Failure) []const u8 {
  text := text_of(failure)
  if #len(text) == 0 { return text }
  return text[..failure.operation_length]
}
pub fn message_text(failure: *const Failure) []const u8 {
  text := text_of(failure)
  if #len(text) == 0 { return text }
  start: usize = failure.operation_length
  return text[start..start + failure.message_length]
}
pub fn path_text(failure: *const Failure) []const u8 {
  text := text_of(failure)
  if #len(text) == 0 { return text }
  start: usize = #cast(usize, failure.operation_length) + failure.message_length
  return text[start..start + failure.path_length]
}

// Records failure unless status already holds one; later failures are
// consequences of the first. A failure of Kind.Ok records nothing, and a nil
// status (the caller does not care why) nothing at all.
pub fn set(status: *Status, failure: Failure) {
  if status == nil || status.failed || failure.kind == Kind.Ok { return }
  status.failed = true
  // Field by field: a whole-struct copy through the pointer would also check
  // for overlap, and set is inlined at every site that records a failure.
  status.failure.kind = failure.kind
  status.failure.has_offset = failure.has_offset
  status.failure.operation_length = failure.operation_length
  status.failure.message_length = failure.message_length
  status.failure.path_length = failure.path_length
  status.failure.native = failure.native
  status.failure.offset = failure.offset
  status.failure.text_at = failure.text_at
  if status.on_failure != nil {
    status.on_failure(status.context, &status.failure)
  }
}

// Records a problem your own code found in its input, such as
// invalid(&status, "config", path, "port out of range").
pub fn invalid(status: *Status, operation: []const u8, path: []const u8, message: []const u8) {
  if status == nil || status.failed { return }
  set(status, make(Kind.InvalidInput, operation, path, message))
}

// Records a failure of kind at offset bytes into the input being read, such
// as at(&status, Kind.InvalidInput, "parse config", "expected '='", 41).
pub fn at(status: *Status, kind: Kind, operation: []const u8, message: []const u8, offset: usize) {
  if status == nil || status.failed { return }
  failure := make(kind, operation, "", message)
  failure.offset = offset
  failure.has_offset = true
  set(status, failure)
}

// For on_failure: ends the program at the first failure, with its description.
pub fn panic_on_failure(context: rawptr, failure: *const Failure) {
  storage: [512]u8
  #panic(describe(storage[..], failure.*))
}
// A short description of kind: "not found", "permission denied".
pub fn kind_text(kind: Kind) []const u8 {
  case kind {
    Kind.Ok => { return "ok" }
    Kind.InvalidInput => { return "invalid input" }
    Kind.InvalidState => { return "invalid state" }
    Kind.NotFound => { return "not found" }
    Kind.PermissionDenied => { return "permission denied" }
    Kind.AlreadyExists => { return "already exists" }
    Kind.Capacity => { return "out of space" }
    Kind.Overflow => { return "too large" }
    Kind.Interrupted => { return "interrupted" }
    Kind.WouldBlock => { return "would block" }
    Kind.Unsupported => { return "unsupported" }
    Kind.System => { return "system error" }
  }
}

// "operation path: reason" in storage, such as
// "open /etc/app.conf: no such file or directory" or
// "parse app.json at 41: expected ','". Empty parts are left out; the reason
// is the message, else the kind. Once the text is gone from the ring it is
// the kind and the system's code: "not found (code -2)". Truncated to
// storage.
pub fn describe(storage: []u8, failure: Failure) []u8 {
  has_text := failure.operation_length != 0 || failure.message_length != 0 || failure.path_length != 0
  if has_text && !text_kept(&failure) { return describe_bare(storage, failure) }
  used: usize = 0
  used = put(storage, used, operation_text(&failure))
  if failure.path_length != 0 {
    if used != 0 {
      used = put(storage, used, " ")
    }
    used = put(storage, used, path_text(&failure))
  }
  if failure.has_offset {
    if used != 0 {
      used = put(storage, used, " ")
    }
    used = put(storage, used, "at ")
    used = put_number(storage, used, failure.offset)
  }
  if used != 0 {
    used = put(storage, used, ": ")
  }
  if failure.message_length != 0 {
    used = put(storage, used, message_text(&failure))
  } else {
    used = put(storage, used, kind_text(failure.kind))
  }
  // Another thread may have taken the ring space while this copied it.
  if has_text && !text_kept(&failure) { return describe_bare(storage, failure) }
  return storage[..used]
}

fn describe_bare(storage: []u8, failure: Failure) []u8 {
  used := put(storage, 0, kind_text(failure.kind))
  if failure.has_offset {
    used = put(storage, used, " at ")
    used = put_number(storage, used, failure.offset)
  }
  if failure.native != 0 {
    used = put(storage, used, " (code ")
    if failure.native < 0 {
      used = put(storage, used, "-")
      used = put_number(storage, used, #cast(usize, 0 - failure.native))
    } else {
      used = put_number(storage, used, #cast(usize, failure.native))
    }
    used = put(storage, used, ")")
  }
  return storage[..used]
}

fn put(storage: []u8, at: usize, text: []const u8) usize {
  used := at
  for byte in text {
    if used == #len(storage) { return used }
    storage[used] = byte
    used += 1
  }
  return used
}

fn put_number(storage: []u8, at: usize, value: usize) usize {
  digits: [20]u8
  count: usize = 0
  rest := value
  for {
    digits[count] = '0' + rest % 10
    count += 1
    rest /= 10
    if rest == 0 { break }
  }
  used := at
  for i in #reverse(0..count) {
    if used == #len(storage) { return used }
    storage[used] = digits[i]
    used += 1
  }
  return used
}
