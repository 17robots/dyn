// Failure as state you pass in. A function that can fail takes a
// *fail.Status, the way a function that allocates takes a *mem.Arena, so the
// signature says which calls can fail.
//
// The first failure is recorded in the status and stays there. Every function
// given a failed status does nothing and returns zero or empty. So code does
// not check after each call: it checks status.failed once, before it acts on
// the results, and prints status.failure with describe:
//
//   status: fail.Status
//   text := fs.read_all(arena, &status, "app.json", 1 << 20)
//   ...
//   if status.failed {
//     storage: [512]u8
//     io.eprintln("app: {}", fail.describe(storage[..], status.failure))
//   }
//
// The rules, for every std and vendor call:
// 1. If it can fail, it takes the status, and returns zero or empty after a
//    failure.
// 2. A lookup always returns a usable value: zero or empty when it is not
//    there, with NotFound on the status. Read an optional value with a status
//    of its own. Iterators report the end of their input with found.
// 3. Check status.failed before you use what you got: before printing
//    results, or using a computed number as a size or index.
// In a loop that keeps going after a failure, give each item its own status.
// Cleanup functions take none, so they work after a failure. To react to one
// kind of failure, give that step its own status and look at failure.kind.
// Record your own failures with invalid (bad input), at (a place in the
// input) or set(make(...)) (anything else).

// The portable reason. Kind.Ok is the zero value.
pub enum Kind { Ok, InvalidInput, InvalidState, NotFound, PermissionDenied, AlreadyExists, Capacity, Overflow, Interrupted, WouldBlock, Unsupported, System }

// What went wrong, where, and doing what. A Failure owns its text: failure
// copies the operation, path and message in, so a failure stays readable
// after the text it came from is gone, and copying it copies the text. Read
// the parts with operation_text, path_text and message_text. Text longer than the storage
// is cut short: a long path keeps its end, after "...".
pub struct Failure {
  kind: Kind,
  // The system's own code, when the system gave one.
  native: isize,
  // For text input: where it went wrong, in bytes from the start.
  offset: usize,
  has_offset: bool,
  operation_length: u8,
  path_length: u8,
  message_length: u8,
  // operation, then message, then path.
  text: [228]u8,
}

pub struct Status {
  failed: bool,
  failure: Failure,
  // Optional. Called once, inside the call that failed, when the first
  // failure is recorded, with context. It cannot undo the failure.
  on_failure: fn(rawptr, *const Failure),
  context: rawptr,
}

// A failure of kind with its text copied in. operation is what was being
// done ("open", "parse"), path the file, address or document involved, and
// message the specific reason; empty parts are left out of describe. Set
// native or offset on the result when there is one.
pub fn make(kind: Kind, operation: []const u8, path: []const u8, message: []const u8) Failure {
  result := Failure{ kind: kind }
  used: usize = 0
  // Operation and message are short and say the most; the path gets the rest.
  operation_kept := keep(result.text[used..], operation)
  result.operation_length = #cast(u8, operation_kept)
  used += operation_kept
  message_kept := keep(result.text[used..], message)
  result.message_length = #cast(u8, message_kept)
  used += message_kept
  room := #len(result.text) - used
  if #len(path) <= room {
    result.path_length = #cast(u8, keep(result.text[used..], path))
    return result
  }
  if room < 4 { return result }
  _ = keep(result.text[used..], "...")
  tail := path[#len(path) - (room - 3)..]
  _ = keep(result.text[used + 3..], tail)
  result.path_length = #cast(u8, room)
  return result
}

// Copies as much of text as fits into storage; the count copied.
fn keep(storage: []u8, text: []const u8) usize {
  count := #len(text)
  if count > #len(storage) {
    count = #len(storage)
  }
  for i in 0..count {
    storage[i] = text[i]
  }
  return count
}

// The parts of a failure's text. Each borrows the failure.
pub fn operation_text(failure: *const Failure) []const u8 {
  return failure.text[..failure.operation_length]
}
pub fn message_text(failure: *const Failure) []const u8 {
  start: usize = failure.operation_length
  return failure.text[start..start + failure.message_length]
}
pub fn path_text(failure: *const Failure) []const u8 {
  start: usize = failure.operation_length + failure.message_length
  return failure.text[start..start + failure.path_length]
}

// Records failure unless status already holds one; later failures are
// consequences of the first. A failure of Kind.Ok records nothing.
pub fn set(status: *Status, failure: Failure) {
  if status.failed || failure.kind == Kind.Ok { return }
  status.failed = true
  status.failure = failure
  if status.on_failure != nil {
    status.on_failure(status.context, &status.failure)
  }
}

// Records a problem your own code found in its input, such as
// invalid(&status, "config", path, "port out of range").
pub fn invalid(status: *Status, operation: []const u8, path: []const u8, message: []const u8) {
  if status.failed { return }
  set(status, make(Kind.InvalidInput, operation, path, message))
}

// Records a failure of kind at offset bytes into the input being read, such
// as at(&status, Kind.InvalidInput, "parse config", "expected '='", 41).
pub fn at(status: *Status, kind: Kind, operation: []const u8, message: []const u8, offset: usize) {
  if status.failed { return }
  failure := make(kind, operation, "", message)
  failure.offset = offset
  failure.has_offset = true
  set(status, failure)
}

// For on_failure: ends the program at the first failure, with its description.
pub fn panic_on_failure(context: rawptr, failure: *const Failure) {
  storage: [512]u8
  #panic(describe(storage[..], failure.*))
}
// A short description of kind: "not found", "permission denied".
pub fn kind_text(kind: Kind) []const u8 {
  case kind {
    Kind.Ok => { return "ok" }
    Kind.InvalidInput => { return "invalid input" }
    Kind.InvalidState => { return "invalid state" }
    Kind.NotFound => { return "not found" }
    Kind.PermissionDenied => { return "permission denied" }
    Kind.AlreadyExists => { return "already exists" }
    Kind.Capacity => { return "out of space" }
    Kind.Overflow => { return "too large" }
    Kind.Interrupted => { return "interrupted" }
    Kind.WouldBlock => { return "would block" }
    Kind.Unsupported => { return "unsupported" }
    Kind.System => { return "system error" }
  }
}

// "operation path: reason" in storage, such as
// "open /etc/app.conf: no such file or directory" or
// "parse app.json at 41: expected ','". Empty parts are left out; the reason
// is the message, else the kind. Truncated to storage.
pub fn describe(storage: []u8, failure: Failure) []u8 {
  used: usize = 0
  used = put(storage, used, operation_text(&failure))
  if failure.path_length != 0 {
    if used != 0 {
      used = put(storage, used, " ")
    }
    used = put(storage, used, path_text(&failure))
  }
  if failure.has_offset {
    used = put(storage, used, " at ")
    used = put_number(storage, used, failure.offset)
  }
  if used != 0 {
    used = put(storage, used, ": ")
  }
  if failure.message_length != 0 {
    used = put(storage, used, message_text(&failure))
  } else {
    used = put(storage, used, kind_text(failure.kind))
  }
  return storage[..used]
}

fn put(storage: []u8, at: usize, text: []const u8) usize {
  used := at
  for byte in text {
    if used == #len(storage) { return used }
    storage[used] = byte
    used += 1
  }
  return used
}

fn put_number(storage: []u8, at: usize, value: usize) usize {
  digits: [20]u8
  count: usize = 0
  rest := value
  for {
    digits[count] = '0' + rest % 10
    count += 1
    rest /= 10
    if rest == 0 { break }
  }
  used := at
  for i in #reverse(0..count) {
    if used == #len(storage) { return used }
    storage[used] = digits[i]
    used += 1
  }
  return used
}
