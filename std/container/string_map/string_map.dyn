use "std/mem" memory
use "std/bytes" bytes
use "std/hash" hashing

// Keys are copied; values are caller-defined integer IDs/indices. Arena must
// outlive the map. Removal/growth do not reclaim storage. Do not mutate entries
// directly or copy a live map and then mutate both copies. No internal locking.
pub enum ErrorKind { None, Capacity, Overflow }
pub struct Entry { key: []const u8, value: usize, hash: u64, state: u8 }
pub struct Map { entries: []Entry, length: usize }
pub struct Lookup { value: usize, found: bool }
pub struct Item { key: []const u8, value: usize, found: bool }

fn locate(entries: []Entry, key: []const u8, hash: u64) usize {
  if #len(entries) == 0 {
    return 0
  }
  index := #cast(usize) (hash % #cast(u64) #len(entries))
  for scanned in 0..#len(entries) {
    entry := entries[index]
    if entry.state == 0 {
      return index
    }
    if entry.state == 1 && entry.hash == hash && bytes.equal(entry.key, key) {
      return index
    }
    index += 1
    if index == #len(entries) {
      index = 0
    }
  }
  return #len(entries)
}

pub fn get(state: *const Map, key: []const u8) Lookup {
  index := locate(state.entries, key, hashing.hash64(key))
  if index == #len(state.entries) || state.entries[index].state != 1 {
    return Lookup{}
  }
  return Lookup{ value: state.entries[index].value, found: true }
}

// Transactional insertion: allocation failure preserves map, keys and arena mark.
// Updates of existing keys allocate nothing. Growth keeps existing key bytes stable.
pub fn put(state: *Map, arena: *memory.Arena, key: []const u8, value: usize) ErrorKind {
  hash := hashing.hash64(key)
  index := locate(state.entries, key, hash)
  if index < #len(state.entries) && state.entries[index].state == 1 {
    state.entries[index].value = value
    return ErrorKind.None
  }
  mark := memory.arena_mark(arena)
  entries := state.entries
  if state.length >= #len(entries) - #len(entries) / 4 {
    capacity: usize = 8
    maximum := #cast(usize) -1
    if #len(entries) > 0 {
      if #len(entries) > maximum / 2 {
        return ErrorKind.Overflow
      }
      capacity = #len(entries) * 2
    }
    if capacity > maximum / #sizeof(Entry) {
      return ErrorKind.Overflow
    }
    allocated := memory.arena_push(arena, capacity * #sizeof(Entry), #alignof(Entry))
    if !allocated.ok {
      return ErrorKind.Capacity
    }
    entries = (#cast(*Entry) allocated.memory)[..capacity]
    for old in state.entries {
      if old.state == 1 {
        entries[locate(entries, old.key, old.hash)] = old
      }
    }
    index = locate(entries, key, hash)
  }
  copied := memory.arena_push_uninit(arena, #len(key), 1)
  if !copied.ok {
    memory.arena_rewind(arena, mark)
    return ErrorKind.Capacity
  }
  stored := arena.data[..0]
  if #len(key) > 0 {
    stored = copied.memory[..#len(key)]
  }
  _ = memory.copy(stored, key)
  entries[index] = Entry{ key: stored, value: value, hash: hash, state: 1 }
  state.entries = entries
  state.length += 1
  return ErrorKind.None
}

// Allocation: none; removal does not reclaim key bytes from the arena.
// Failure: missing key returns false without changing the map.
// Invalidation: entry positions can change; reacquire views after mutation.
pub fn remove(state: *Map, key: []const u8) bool {
  index := locate(state.entries, key, hashing.hash64(key))
  if index == #len(state.entries) || state.entries[index].state != 1 {
    return false
  }
  // Move entries whose probe path crosses the hole. Stop at the first empty
  // bucket, preserving lookup chains without leaving permanent tombstones.
  hole := index
  scan := index
  capacity := #len(state.entries)
  for scanned in 0..capacity - 1 {
    scan += 1
    if scan == capacity {
      scan = 0
    }
    entry := state.entries[scan]
    if entry.state == 0 {
      break
    }
    home := #cast(usize) (entry.hash % #cast(u64) capacity)
    scan_distance: usize = 0
    if scan >= home {
      scan_distance = scan - home
    }
    else {
      scan_distance = capacity - home + scan
    }
    hole_distance: usize = 0
    if hole >= home {
      hole_distance = hole - home
    }
    else {
      hole_distance = capacity - home + hole
    }
    if hole_distance < scan_distance {
      state.entries[hole] = entry
      hole = scan
    }
  }
  state.entries[hole] = Entry{}
  state.length -= 1
  return true
}

// Begin with cursor=0. Mutation invalidates iteration; returned key bytes remain
// borrowed from the arena. Iteration order is unspecified.
pub fn next(state: *const Map, cursor: *usize) Item {
  for cursor.* < #len(state.entries) {
    index := cursor.*
    cursor.* += 1
    if state.entries[index].state == 1 {
      return Item{ key: state.entries[index].key, value: state.entries[index].value, found: true }
    }
  }
  return Item{}
}

// Reserve room for at least count live keys at the normal load factor.
// Avoids intermediate arena tables when a workload's size is known. Existing
// keys remain stable; failure preserves map and arena mark. Old tables remain
// allocated until arena reset/rewind. Mutation invalidates iteration.
pub fn reserve(state: *Map, arena: *memory.Arena, count: usize) ErrorKind {
  capacity := #len(state.entries)
  if count <= capacity - capacity / 4 { return ErrorKind.None }
  if capacity == 0 { capacity = 8 }
  maximum := #cast(usize) -1
  for count > capacity - capacity / 4 {
    if capacity > maximum / 2 { return ErrorKind.Overflow }
    capacity *= 2
  }
  if capacity > maximum / #sizeof(Entry) { return ErrorKind.Overflow }
  allocated := memory.arena_push(arena, capacity * #sizeof(Entry), #alignof(Entry))
  if !allocated.ok { return ErrorKind.Capacity }
  entries := (#cast(*Entry) allocated.memory)[..capacity]
  for old in state.entries {
    if old.state == 1 { entries[locate(entries, old.key, old.hash)] = old }
  }
  state.entries = entries
  return ErrorKind.None
}

// Reuse the table without allocating. Key bytes stay in the arena; repeated
// clear/refill cycles still consume key storage. Never rewind a live map's arena.
pub fn clear(state: *Map) {
  for index in 0..#len(state.entries) { state.entries[index] = Entry{} }
  state.length = 0
}
