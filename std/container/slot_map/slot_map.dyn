// Generation handles into the caller's slot array. Each slot struct carries
// `generation: u32`; an odd generation means the slot is live, an even one
// means it is free. A handle remembers the index and generation it was made
// with, so it stops resolving once its slot is retired, even after reuse.
//
//   struct Enemy { generation: u32, free_next: *Enemy, hp: i32 }
//   enemies: []Enemy
//
// Combine with list.free_push/free_pop for slot reuse. Handles are process
// local; they are not stable IDs to serialize or a security capability.

pub struct Handle { index: u32, generation: u32 }

// Prepares a fresh or reused slot: zeroes every field except generation and
// marks the slot live.
pub fn reset(node: *$T) {
  generation := node.generation
  bytes := (#cast(*u8, node))[..#sizeof(T)]
  for i in 0..#len(bytes) {
    bytes[i] = 0
  }
  if generation % 2 == 0 {
    generation = #wrap(generation + 1)
  }
  node.generation = generation
}

// Marks a live slot free. Outstanding handles to it stop resolving.
pub fn retire(node: *$T) {
  if node.generation % 2 == 1 {
    node.generation = #wrap(node.generation + 1)
  }
}

pub fn is_live(node: *const $T) bool {
  return node.generation % 2 == 1
}

// The handle for node, which must be an element of slots.
pub fn handle_of(slots: []$T, node: *const T) Handle {
  base := #cast(usize, &slots[0])
  address := #cast(usize, node)
  if address < base || (address - base) % #sizeof(T) != 0 || (address - base) / #sizeof(T) >= #len(slots) {
    #panic("handle_of: node is not an element of slots")
  }
  return Handle{ index: #cast(u32, (address - base) / #sizeof(T)), generation: node.generation }
}

// The live slot the handle was made for, or nil_node when the handle is stale,
// zero, or out of range.
pub fn resolve(slots: []$T, handle: Handle, nil_node: *const T) *T {
  index := #cast(usize, handle.index)
  if index >= #len(slots) || handle.generation % 2 == 0 || slots[index].generation != handle.generation {
    return #cast(*T, nil_node)
  }
  return &slots[index]
}
