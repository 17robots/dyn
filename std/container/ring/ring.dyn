pub struct Ring {
  data: []u8,
  read: usize,
  length: usize,
}

pub fn init(backing: []u8) Ring {
  return Ring{ data: backing, read: 0, length: 0 }
}
pub fn length(state: *const Ring) usize {
  return state.length
}

// A full ring fails and keeps its bytes.
pub fn push(state: *Ring, byte: u8) ! {
  if state.length == state.data.len || state.data.len == 0 { fail }
  state.data[(state.read + state.length) % state.data.len] = byte
  state.length += 1
}

// The oldest byte, or 0 when the ring is empty. Check length first where
// empty is possible.
pub fn pop(state: *Ring) u8 {
  if state.length == 0 { return 0 }
  value := state.data[state.read]
  state.read = (state.read + 1) % state.data.len
  state.length -= 1
  return value
}
