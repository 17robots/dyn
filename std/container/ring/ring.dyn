use "std/fail"
pub struct Ring {
  data: []u8,
  read: usize,
  length: usize,
}

pub fn init(backing: []u8) Ring {
  return Ring{ data: backing, read: 0, length: 0 }
}
pub fn length(state: *const Ring) usize {
  return state.length
}

// A full ring fails with Capacity and keeps its bytes.
pub fn push(status: *fail.Status, state: *Ring, byte: u8) {
  if status == nil {
    push(&fail.Status{}, state, byte)
    return
  }
  if status.failed { return }
  if state.length == #len(state.data) || #len(state.data) == 0 {
    fail.set(status, fail.make(fail.Kind.Capacity, "push", "", "the ring is full"))
    return
  }
  state.data[(state.read + state.length) % #len(state.data)] = byte
  state.length += 1
}

// The oldest byte, or 0 when the ring is empty. Check length first where
// empty is possible.
pub fn pop(state: *Ring) u8 {
  if state.length == 0 { return 0 }
  value := state.data[state.read]
  state.read = (state.read + 1) % #len(state.data)
  state.length -= 1
  return value
}
