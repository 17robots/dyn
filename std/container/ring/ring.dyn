pub struct Ring {
  data: []u8,
  read: usize,
  length: usize,
}

pub fn init(backing: []u8) Ring {
  return Ring{ data: backing, read: 0, length: 0 }
}
pub fn length(state: *const Ring) usize {
  return state.length
}

pub fn push(state: *Ring, byte: u8) bool {
  if state.length == #len(state.data) || #len(state.data) == 0 {
    return false
  }
  state.data[(state.read + state.length) % #len(state.data)] = byte
  state.length += 1
  return true
}

pub struct Popped { value: u8, ok: bool }

// The oldest byte. ok is false when the ring is empty.
pub fn pop(state: *Ring) Popped {
  if state.length == 0 {
    return Popped{}
  }
  value := state.data[state.read]
  state.read = (state.read + 1) % #len(state.data)
  state.length -= 1
  return Popped{ value: value, ok: true }
}
