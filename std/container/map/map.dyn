// Growing hash maps on an arena, for keys of any type. init takes the arena and
// the key's hash and equality functions; std has them for text and integers:
//
//   ages: map.Map([]const u8, i32)
//   map.init(&ages, arena, map.text_hash, map.text_equal)
//   map.insert(&ages, "ada", 36)
//   age := map.get(&ages, "ada")
//
// For other keys, write your own pair: fn(seed: u64, key: K) u64 and
// fn(a: K, b: K) bool. get returns a pointer to the value, or nil when the key
// is absent; the pointer goes stale at the next insert. Text keys are borrowed,
// not copied, so they must outlive the map. Growth leaves old slots in the arena.
//
// init uses a fixed seed. For keys an attacker chooses, use init_seeded with a
// seed from std/crypto/random. Slots are in no useful order; walk them with
// `for slot in m.slots` and skip those whose code is 0.

use "std/container/hash" hash
use "std/mem" mem

// code is the key's hash with the top bit set, or 0 for an empty slot.
pub struct Slot($K: type, $V: type) { key: K, value: V, code: u64 }
pub struct Map($K: type, $V: type) {
  slots: []Slot(K, V),
  count: usize,
  arena: *mem.Arena,
  seed: u64,
  hash_key: fn(u64, K) u64,
  equal_key: fn(K, K) bool,
}

// Sets up an empty map. Nothing is allocated until the first insert.
pub fn init(m: *Map($K, $V), arena: *mem.Arena, hash_key: fn(u64, K) u64, equal_key: fn(K, K) bool) {
  init_seeded(m, arena, 0x243f6a8885a308d3, hash_key, equal_key)
}

// init with a chosen seed, passed to every hash_key call.
pub fn init_seeded(m: *Map($K, $V), arena: *mem.Arena, seed: u64, hash_key: fn(u64, K) u64, equal_key: fn(K, K) bool) {
  empty: Map(K, V)
  m.* = empty
  m.arena = arena
  m.seed = seed
  m.hash_key = hash_key
  m.equal_key = equal_key
}

pub fn text_hash(seed: u64, key: []const u8) u64 {
  return hash.hash_bytes(seed, key)
}

pub fn text_equal(left: []const u8, right: []const u8) bool {
  if #len(left) != #len(right) {
    return false
  }
  for i in 0..#len(left) {
    if left[i] != right[i] {
      return false
    }
  }
  return true
}

// Finalizer from MurmurHash3: sequential integers must not cluster. Cast other
// integer keys to u64.
pub fn integer_hash(seed: u64, key: u64) u64 {
  mixed := key ^ seed
  mixed = mixed ^ (mixed >> 33)
  mixed = mixed * 0xff51afd7ed558ccd
  mixed = mixed ^ (mixed >> 33)
  mixed = mixed * 0xc4ceb9fe1a85ec53
  return mixed ^ (mixed >> 33)
}

pub fn integer_equal(left: u64, right: u64) bool {
  return left == right
}

fn code_of(m: *const Map($K, $V), key: K) u64 {
  return m.hash_key(m.seed, key) | 0x8000000000000000
}

// The slot holding key, or the empty slot where it belongs.
fn locate(m: *const Map($K, $V), key: K, code: u64) *Slot(K, V) {
  slots := m.slots
  mask := #len(slots) - 1
  at := #cast(usize, code) & mask
  for true {
    slot := &slots[at]
    if slot.code == 0 {
      return slot
    }
    if slot.code == code {
      if m.equal_key(slot.key, key) {
        return slot
      }
    }
    at = (at + 1) & mask
  }
  return nil
}

fn grow(m: *Map($K, $V)) {
  capacity := #len(m.slots) * 2
  if capacity == 0 {
    capacity = 8
  }
  old := m.slots
  fresh := mem.push_array(Slot(K, V), m.arena, capacity)
  mask := capacity - 1
  for slot in old {
    if slot.code != 0 {
      at := #cast(usize, slot.code) & mask
      for fresh[at].code != 0 {
        at = (at + 1) & mask
      }
      fresh[at] = slot
    }
  }
  m.slots = fresh
}

// Sets key to value, adding it when absent. Returns the value's address.
pub fn insert(m: *Map($K, $V), key: K, value: V) *V {
  if m.arena == nil {
    #panic("call map.init before map.insert")
  }
  if (m.count + 1) * 4 > #len(m.slots) * 3 {
    grow(m)
  }
  code := code_of(m, key)
  slot := locate(m, key, code)
  if slot.code == 0 {
    slot.key = key
    slot.code = code
    m.count += 1
  }
  slot.value = value
  return &slot.value
}

// The value for key, or nil when key is absent. An empty map needs no init.
pub fn get(m: *const Map($K, $V), key: K) *V {
  if m.count == 0 {
    return nil
  }
  slot := locate(m, key, code_of(m, key))
  if slot.code == 0 {
    return nil
  }
  return &slot.value
}

// Removes key. Returns false when it was absent. Later entries of the probe run
// shift back, so no tombstones build up.
pub fn remove(m: *Map($K, $V), key: K) bool {
  if m.count == 0 {
    return false
  }
  slots := m.slots
  mask := #len(slots) - 1
  code := code_of(m, key)
  at := #cast(usize, code) & mask
  for slots[at].code != code || !m.equal_key(slots[at].key, key) {
    if slots[at].code == 0 {
      return false
    }
    at = (at + 1) & mask
  }
  next := (at + 1) & mask
  for slots[next].code != 0 {
    home := #cast(usize, slots[next].code) & mask
    if ((next - home) & mask) >= ((next - at) & mask) {
      slots[at] = slots[next]
      at = next
    }
    next = (next + 1) & mask
  }
  empty: Slot(K, V)
  slots[at] = empty
  m.count -= 1
  return true
}
