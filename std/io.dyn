        } else if ($typeof(value1) == usize) {
            $fmt_usize($as(usize, value1))
        } else {
            "<unsupported>"
        }
        $bytes_concat3(prefix1, rendered1, suffix1)
    }

    marker2 := $bytes_index_of(out1, "{}")
    out2 := if marker2 < 0 {
        out1
    } else {
        start2 := $as(usize, marker2)
        stop2 := start2 + 2
        prefix2 := $bytes_slice(out1, 0, start2)
        suffix2 := $bytes_slice(out1, stop2, $bytes_len(out1))
        rendered2 := if ($typeof(value2) == u1) {
