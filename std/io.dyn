module io

pub IoError := enum {
    WriteFailed,
    UnsupportedType,
}

pub print := (T: type, value: T) u32!IoError =>
    if T == bytes __dyn_io_write($as(bytes, value), 0)
    else if T == i32 __dyn_io_write_i32($as(i32, value), 0)
    else .UnsupportedType

pub println := (T: type, value: T) u32!IoError =>
    if T == bytes __dyn_io_write($as(bytes, value), 1)
    else if T == i32 __dyn_io_write_i32($as(i32, value), 1)
    else .UnsupportedType
