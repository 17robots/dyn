module io

os := use "std/os"

pub IoError := enum {
    WriteFailed
}

pub print_i32 := (value: i32) u32!IoError => os.io_write_i32(value, 0)

pub println_i32 := (value: i32) u32!IoError => os.io_write_i32(value, 1)

pub print := inline (
