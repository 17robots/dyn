        $bytes_concat3(prefix2, rendered2, suffix2)
    }

    marker3 := $bytes_index_of(out2, "{}")
    out3 := if marker3 < 0 {
        out2
    } else {
        start3 := $as(usize, marker3)
        stop3 := start3 + 2
        prefix3 := $bytes_slice(out2, 0, start3)
        suffix3 := $bytes_slice(out2, stop3, $bytes_len(out2))
        rendered3 := if ($typeof(value3) == u1) {
            if $as(u1, value3) "true" else "false"
        } else if ($typeof(value3) == i32) {
            $fmt_i32($as(i32, value3))
        } else if ($typeof(value3) == u64) {
            $fmt_u64($as(u64, value3))
        } else if ($typeof(value3) == usize) {
