    value0: ?any = null,
    value1: ?any = null,
    value2: ?any = null,
    value3: ?any = null,
    value4: ?any = null,
    value5: ?any = null,
) u32!IoError => {
    marker0 := $bytes_index_of(template, "{}")
    out0 := if marker0 < 0 template else {
        start0 := $as(usize, marker0)
        stop0 := start0 + 2
        prefix0 := $bytes_slice(template, 0, start0)
        suffix0 := $bytes_slice(template, stop0, $bytes_len(template))
        rendered0 := if ($typeof(value0) == u1) {
            if $as(u1, value0) "true" else "false"
        } else if ($typeof(value0) == i32) {
            $fmt_i32($as(i32, value0))
        } else if ($typeof(value0) == u64) {
            $fmt_u64($as(u64, value0))
        } else if ($typeof(value0) == usize) {
            $fmt_usize($as(usize, value0))
