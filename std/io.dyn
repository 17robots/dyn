        } else {
            "<unsupported>"
        }
        $bytes_concat3(prefix3, rendered3, suffix3)
    }

    marker4 := $bytes_index_of(out3, "{}")
    out4 := if marker4 < 0 {
        out3
    } else {
        start4 := $as(usize, marker4)
        stop4 := start4 + 2
        prefix4 := $bytes_slice(out3, 0, start4)
        suffix4 := $bytes_slice(out3, stop4, $bytes_len(out3))
        rendered4 := if ($typeof(value4) == u1) {
            if $as(u1, value4) "true" else "false"
        } else if ($typeof(value4) == i32) {
            $fmt_i32($as(i32, value4))
        } else if ($typeof(value4) == u64) {
            $fmt_u64($as(u64, value4))
        } else if ($typeof(value4) == usize) {
            $fmt_usize($as(usize, value4))
        } else {
            "<unsupported>"
        }
        $bytes_concat3(prefix4, rendered4, suffix4)
    }

    marker5 := $bytes_index_of(out4, "{}")
    out5 := if marker5 < 0 {
        out4
    } else {
        start5 := $as(usize, marker5)
        stop5 := start5 + 2
        prefix5 := $bytes_slice(out4, 0, start5)
        suffix5 := $bytes_slice(out4, stop5, $bytes_len(out4))
        rendered5 := if ($typeof(value5) == u1) {
            if $as(u1, value5) "true" else "false"
        } else if ($typeof(value5) == i32) {
