module str

bytes_mod := use "std/bytes"

pub len := (value: []u8) usize => bytes_mod.len(value)
pub eq := (lhs: []u8, rhs: []u8) u32 => bytes_mod.eq(lhs, rhs)
pub starts_with := (value: []u8, prefix: []u8) u32 => bytes_mod.starts_with(value, prefix)
pub ends_with := (value: []u8, suffix: []u8) u32 => bytes_mod.ends_with(value, suffix)
pub contains := (value: []u8, needle: []u8) u1 => if bytes_mod.index_of(value, needle) >= 0 true else false
pub concat := (lhs: []u8, rhs: []u8) []u8 => bytes_mod.concat(lhs, rhs)
pub concat3 := (a: []u8, b: []u8, c: []u8) []u8 => bytes_mod.concat3(a, b, c)
pub trim_prefix := (value: []u8, prefix: []u8) []u8 {
    if bytes_mod.starts_with(value, prefix) == 0 return value
    prefix_len := bytes_mod.len(prefix)
    total := bytes_mod.len(value)
    return bytes_mod.slice(value, prefix_len, total)
}
pub trim_suffix := (value: []u8, suffix: []u8) []u8 {
    if bytes_mod.ends_with(value, suffix) == 0 return value
    suffix_len := bytes_mod.len(suffix)
    total := bytes_mod.len(value)
    if suffix_len > total return value
    return bytes_mod.slice(value, 0, total - suffix_len)
}
