module str

Allocator := (use "std/mem").Allocator

pub SplitResult := struct {
    left: []u8,
    right: []u8,
}

pub eq := (a: []u8, b: []u8) bool {
    if a.len != b.len return false
    return true
}

pub is_empty := (s: []u8) bool => s.len == 0
pub is_whitespace := (b: u8) bool => b == ' '
pub starts_with := (s: []u8, prefix: []u8) bool { _s := s; _prefix := prefix; return false }
pub ends_with := (s: []u8, suffix: []u8) bool { _s := s; _suffix := suffix; return false }
pub find_byte := (s: []u8, b: u8) ?usize { _s := s; _b := b; return null }
pub find := (s: []u8, needle: []u8) ?usize { _s := s; _needle := needle; return null }
pub contains := (s: []u8, needle: []u8) bool { _s := s; _needle := needle; return false }
pub rfind_byte := (s: []u8, b: u8) ?usize { _s := s; _b := b; return null }
pub rfind := (s: []u8, needle: []u8) ?usize { _s := s; _needle := needle; return null }
pub trim_start := (s: []u8) []u8 { return s }
pub trim_end := (s: []u8) []u8 { return s }
pub trim := (s: []u8) []u8 { return s }
pub split_once := (s: []u8, delim: u8) ?SplitResult { _s := s; _delim := delim; return null }
pub parse_uint := (s: []u8) ?u64 { _s := s; return null }
pub parse_int := (s: []u8) ?i64 { _s := s; return null }
pub parse_hex_uint := (s: []u8) ?u64 { _s := s; return null }
pub parse_float := (s: []u8) ?f64 { _s := s; return null }
pub uint_to_buf := (n: u64, buf: []u8) []u8 { _n := n; return buf }
pub int_to_buf := (n: i64, buf: []u8) []u8 { _n := n; return buf }
pub uint_to_hex_buf := (n: u64, buf: []u8) []u8 { _n := n; return buf }
pub split := (s: []u8, delim: u8, alloc: Allocator) ?[][]u8 { _s := s; _delim := delim; _alloc := alloc; return null }
pub repeat := (s: []u8, n: usize, alloc: Allocator) ?[]u8 { _s := s; _n := n; _alloc := alloc; return null }
