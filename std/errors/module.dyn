// Cross-package error categories. Modules keep domain-specific enums, then map
// them to these stable categories at application boundaries.
pub enum Kind {
  None,
  Invalid,
  Unsupported,
  NotFound,
  Permission,
  Exists,
  Busy,
  Timeout,
  Interrupted,
  End,
  Capacity,
  Corrupt,
  Io,
  System,
}

pub struct Error {
  kind: Kind,
  code: isize,
}

pub fn none() Error { return Error{ kind: Kind.None } }
pub fn make(kind: Kind, code: isize) Error { return Error{ kind: kind, code: code } }
pub fn failed(error: Error) bool { return error.kind != Kind.None }

