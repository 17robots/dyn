    "const nil_symbol: Symbol = Symbol{}\n",
    "\n",
    "fn define(table: []*Symbol, symbol: *Symbol, seed: u64) {\n",
    "  symbol.hash = hash.hash_bytes(seed, symbol.key)\n",
