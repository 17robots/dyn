// Loading and saving the task list. The text of the file is loaded into an
// arena and the tasks borrow it: nothing is copied or freed one by one.

use "std/container/array"
use "std/fail"
use "std/fs"
use "std/mem"
use "std/parse"
use "std/strings"

const MaxFileBytes: usize = 1 << 20

// Loads the list at path into tasks. A missing file is not a failure: it is
// an empty list. A line that is not a task fails with its line number.
fn load(tasks: *array.Array(Task), arena: *mem.Arena, status: *fail.Status, path: []const u8) {
  // Reading gets its own status, so that "not found" can mean an empty list
  // while any other failure goes on to the caller.
  reading: fail.Status
  read := fs.read_all(arena, &reading, path, MaxFileBytes)
  if reading.failed {
    if reading.failure.kind != fail.Kind.NotFound {
      fail.set(status, reading.failure)
    }
    return
  }
  line_number: usize = 0
  scan := strings.scanner(read)
  for {
    line := strings.scan_line(&scan)
    if !line.found { break }
    line_number += 1
    if #len(line.value) == 0 { continue }
    parsed := parse_task(line.value)
    if parse.failed(parsed.failure) {
      message := strings.format(arena, "line {}: {}", line_number, parsed.failure.message)
      fail.invalid(status, "read", path, message)
      return
    }
    array.push(tasks, parsed.value)
  }
}

// Writes the whole list to a temporary file, then renames it over the old
// one, so a crash halfway never leaves a half-written list behind. If the
// write fails, the rename does nothing: it takes the same status. (On Linux,
// fs.write_atomic does both steps and can also make them durable.)
fn save(tasks: []const Task, arena: *mem.Arena, status: *fail.Status, path: []const u8) {
  text: array.Array(u8)
  array.init(&text, arena)
  for task in tasks {
    array.push_all(&text, marker(task.state))
    array.push_all(&text, task.text)
    array.push(&text, '\n')
  }
  temporary := strings.format(arena, "{}.tmp", path)
  fs.write_all(status, temporary, text.items)
  fs.rename(status, temporary, path)
}
