// Loading and saving the task list. The text of the file is loaded into an
// arena and the tasks borrow it: nothing is copied or freed one by one.

use "std/container/array"
use "std/fs"
use "std/io"
use "std/mem"
use "std/strings"

const MaxFileBytes: usize = 1 << 20

// What load fails with besides a failed read: a line that is not a task,
// with its line number.
enum StoreErr { BadLine(usize) }

// Loads the list at path into tasks. A missing file is not a failure: it is
// an empty list. A line that is not a task fails with its line number.
fn load(tasks: *array.Array<Task>, arena: *mem.Arena, path: []const u8) !(io.IoErr | StoreErr) {
  // "Not found" means an empty list; any other failure goes on to the
  // caller.
  read := fs.read_all(arena, path, MaxFileBytes) catch err {
    case err {
      .NotFound => { return }
      _ => { fail err }
    }
  }
  line_number: usize = 0
  scan := strings.scanner(read)
  for {
    line := strings.scan_line(&scan)
    if scan.ended { break }
    line_number += 1
    if line.len == 0 { continue }
    // The parser's offset matters less than the line, so load fails with
    // the line number instead.
    task := parse_task(line) catch {
      fail StoreErr.BadLine(line_number)
    }
    array.push(tasks, task)
  }
}

// Writes the whole list to a temporary file, then renames it over the old
// one, so a crash halfway never leaves a half-written list behind. If the
// write fails, try returns before the rename. (On Linux, fs.write_atomic
// does both steps and can also make them durable.)
fn save(tasks: []const Task, arena: *mem.Arena, path: []const u8) !io.IoErr {
  text: array.Array<u8>
  array.init(&text, arena)
  for task in tasks {
    array.push_all(&text, marker(task.state))
    array.push_all(&text, task.text)
    array.push(&text, '\n')
  }
  temporary := strings.format(arena, "{}.tmp", path)
  try fs.write_all(temporary, text.items)
  try fs.rename(temporary, path)
}
