// One task and its line in the save file. Every .dyn file in a directory
// belongs to the same module, so main.dyn and store.dyn see these names
// without importing anything.

use "std/parse"

// The first variant is the zero value, so a zero Task is an open task.
enum State {
  Open,
  Done,
}

struct Task {
  text: []const u8,
  state: State,
}

// A task's line in the save file: "[ ] text" or "[x] text".
fn marker(state: State) []const u8 {
  case state {
    State.Open => { return "[ ] " }
    State.Done => { return "[x] " }
  }
}

// Parses one saved line. The result is {value, failure}: on failure the
// value is a zero Task and failure says what went wrong and where.
fn parse_task(line: []const u8) parse.Result(Task) {
  if #len(line) < 4 {
    return parse.Result(Task){
      failure: parse.Failure{ kind: parse.Kind.Truncated, offset: #len(line), message: "a task needs a marker and text" },
    }
  }
  task := Task{ text: line[4..] }
  case line[..4] {
    "[ ] " => {}
    "[x] " => {
      task.state = State.Done
    }
    _ => {
      return parse.Result(Task){
        failure: parse.Failure{ kind: parse.Kind.Syntax, message: "a task starts with [ ] or [x]" },
      }
    }
  }
  return parse.Result(Task){ value: task }
}
