// One task and its line in the save file. Every .dyn file in a directory
// belongs to the same module, so main.dyn and store.dyn see these names
// without importing anything.

use "std/fail"
use "std/parse"

// The first variant is the zero value, so a zero Task is an open task.
enum State {
  Open,
  Done,
}

struct Task {
  text: []const u8,
  state: State,
}

// A task's line in the save file: "[ ] text" or "[x] text".
fn marker(state: State) []const u8 {
  case state {
    State.Open => { return "[ ] " }
    State.Done => { return "[x] " }
  }
}

// Parses one saved line. A bad line fails like anything else that can fail:
// parse.malformed records InvalidInput, a message and the byte offset where
// the line went wrong, and the task is zero.
fn parse_task(status: *fail.Status, line: []const u8) Task {
  if line.len < 4 {
    fail.at(status, fail.Kind.InvalidInput, "read task", "a task needs a marker and text", line.len)
    return Task{}
  }
  task := Task{ text: line[4..] }
  case line[..4] {
    "[ ] " => {}
    "[x] " => {
      task.state = State.Done
    }
    _ => {
      fail.at(status, fail.Kind.InvalidInput, "read task", "a task starts with [ ] or [x]", 0)
      return Task{}
    }
  }
  return task
}
