// One task and its line in the save file. Every .dyn file in a directory
// belongs to the same module, so main.dyn and store.dyn see these names
// without importing anything.

use "std/parse"

// The first variant is the zero value, so a zero Task is an open task.
enum State {
  Open,
  Done,
}

struct Task {
  text: []const u8,
  state: State,
}

// A task's line in the save file: "[ ] text" or "[x] text".
fn marker(state: State) []const u8 {
  case state {
    State.Open => { return "[ ] " }
    State.Done => { return "[x] " }
  }
}

// Parses one saved line. A bad line fails like any other parser: with
// parse.ParseErr.Invalid and the byte offset where the line went wrong.
fn parse_task(line: []const u8) Task!parse.ParseErr {
  if line.len < 4 { fail .Invalid(line.len) }
  task := Task{ text: line[4..] }
  case line[..4] {
    "[ ] " => {}
    "[x] " => {
      task.state = State.Done
    }
    _ => {
      fail .Invalid(0)
    }
  }
  return task
}
