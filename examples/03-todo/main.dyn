// todo: a task list kept in a text file.
//
//   todo list              show every task
//   todo add TEXT...       add a task
//   todo done N            mark task N done
//   todo remove N          delete task N
//   todo clear             delete every done task
//
// Tasks live in ./todo.txt, or in the file named by TODO_FILE.
//
// Run: dyn run examples/03-todo -- add learn Dyn

use "std/container/array"
use "std/fail"
use "std/io"
use "std/mem"
use "std/parse"
use "std/process"
use "std/strings"

fn usage() i32 {
  io.eprintln("usage: todo list | add TEXT... | done N | remove N | clear")
  return 2
}

fn show(tasks: []const Task) {
  if tasks.len == 0 {
    io.println("nothing to do")
    return
  }
  for task, i in tasks {
    io.println("{}. {}{}", i + 1, marker(task.state), task.text)
  }
}

// Task numbers start at 1 on the command line and at 0 in the array.
// parse.u64_decimal fails instead of guessing at bad text.
fn task_index(text: []const u8, count: usize) usize {
  status: fail.Status
  number := parse.u64_decimal(&status, text)
  if status.failed || number == 0 || number > count {
    return count       // the miss value: one past the end, as find does
  }
  return #cast(usize, number - 1)
}

// The task named by "todo done N", or count after reporting why not.
fn chosen(args: [][]const u8, count: usize) usize {
  if args.len != 3 {
    _ = usage()
    return count
  }
  index := task_index(args[2], count)
  if index == count {
    io.eprintln("todo: no task {}", args[2])
  }
  return index
}

fn remove_at(tasks: *array.Array<Task>, index: usize) {
  for i in index + 1..tasks.items.len {
    tasks.items[i - 1] = tasks.items[i]
  }
  _ = array.pop(tasks)
}

fn main() i32 {
  program := process.start()
  arena := program.arena
  args := program.args
  if args.len < 2 { return usage() }

  path := process.environment_or(arena, "TODO_FILE", "todo.txt")

  tasks: array.Array<Task>
  array.init(&tasks, arena)
  // Loading can fail; it takes this status. Check it before acting on what
  // load returned.
  status: fail.Status
  load(&tasks, arena, &status, path)
  if status.failed { return report(status) }

  changed := false
  command := args[1]
  // case on text compares bytes; _ takes every other command.
  case command {
    "list" => {
      show(tasks.items)
    }
    "add" => {
      if args.len < 3 { return usage() }
      text := strings.join(arena, args[2..], " ")
      array.push(&tasks, Task{ text: text })
      io.println("added {}. {}", tasks.items.len, text)
      changed = true
    }
    "done" => {
      index := chosen(args, tasks.items.len)
      if index == tasks.items.len { return 1 }
      task := &tasks.items[index]     // a pointer into the array
      task.state = State.Done
      io.println("done {}. {}", index + 1, task.text)
      changed = true
    }
    "remove" => {
      index := chosen(args, tasks.items.len)
      if index == tasks.items.len { return 1 }
      io.println("removed {}. {}", index + 1, tasks.items[index].text)
      remove_at(&tasks, index)
      changed = true
    }
    "clear" => {
      kept: usize = 0
      for task in tasks.items {
        if task.state == State.Open {
          tasks.items[kept] = task
          kept += 1
        }
      }
      io.println("cleared {} done", tasks.items.len - kept)
      for tasks.items.len > kept {
        _ = array.pop(&tasks)
      }
      changed = true
    }
    _ => {
      return usage()
    }
  }

  if changed {
    save(tasks.items, arena, path) catch err {
      io.eprintln("todo: save {}: {}", path, err)
      return 1
    }
  }
  return 0
}

// Prints what failed, such as "todo: open todo.txt: permission denied".
fn report(status: fail.Status) i32 {
  storage: [512]u8
  io.eprintln("todo: {}", fail.describe(storage[..], status.failure))
  return 1
}
