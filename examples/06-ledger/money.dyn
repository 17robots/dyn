// Money as whole cents. A distinct type has i64's representation but is its
// own type: a Cents never mixes with a plain i64, or with a count, by
// accident. Converting either way takes an explicit #cast.

use "std/bytes"
use "std/fmt"
use "std/parse"

distinct type Cents = i64

// "12", "12.5", "12.50" or "-3.25" as cents. Bad text fails with Invalid,
// an amount too large to add up safely with TooLarge.
fn parse_cents(text: []const u8) Cents!parse.ParseErr {
  negative := text.len > 0 && text[0] == '-'
  digits := text
  if negative {
    digits = text[1..]
  }
  dot := bytes.find_byte(digits, '.')       // #len(digits) when absent
  whole := try parse.u64_decimal(digits[..dot])
  fraction: u64 = 0
  if dot < digits.len {
    decimals := digits[dot + 1..]
    // An amount has at most two decimals.
    if decimals.len > 2 { fail parse.ParseErr.Invalid(dot + 1) }
    fraction = try parse.u64_decimal(decimals)
    if decimals.len == 1 {
      fraction *= 10
    }
  }
  // A debug build checks every + and * for overflow; a release build wraps.
  // An amount this large is bad input, not a reason to crash, so test it.
  if whole > 1000000000000 { fail parse.ParseErr.TooLarge(0) }
  cents := #cast(Cents, whole * 100 + fraction)
  if negative {
    cents = -cents
  }
  return cents
}

// 1234 as "12.34", into a sticky fmt.Buffer.
fn write_cents(buffer: *fmt.Buffer, amount: Cents) {
  value := #cast(i64, amount)
  if value < 0 {
    fmt.write_byte(buffer, '-')
    value = -value
  }
  magnitude := #cast(u64, value)
  fmt.write_u64(buffer, magnitude / 100)
  fmt.write_byte(buffer, '.')
  fmt.write_u64_width(buffer, magnitude % 100, 2, '0')
}
