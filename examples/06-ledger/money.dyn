// Money as whole cents. A distinct type has i64's representation but is its
// own type: a Cents never mixes with a plain i64, or with a count, by
// accident. Converting either way takes an explicit #cast.

use "std/bytes"
use "std/fail"
use "std/fmt"
use "std/parse"

distinct type Cents = i64

// "12", "12.5", "12.50" or "-3.25" as cents. Bad text fails with
// InvalidInput, an amount too large to add up safely with Overflow.
fn parse_cents(status: *fail.Status, text: []const u8) Cents {
  negative := #len(text) > 0 && text[0] == '-'
  digits := text
  if negative {
    digits = text[1..]
  }
  dot := bytes.find_byte(digits, '.')       // #len(digits) when absent
  whole := parse.u64_decimal(status, digits[..dot])
  fraction: u64 = 0
  if dot < #len(digits) {
    decimals := digits[dot + 1..]
    if #len(decimals) > 2 {
      fail.at(status, fail.Kind.InvalidInput, "parse amount", "an amount has at most two decimals", dot + 1)
      return #cast(Cents, 0)
    }
    fraction = parse.u64_decimal(status, decimals)
    if #len(decimals) == 1 {
      fraction *= 10
    }
  }
  // A debug build checks every + and * for overflow; a release build wraps.
  // An amount this large is bad input, not a reason to crash, so test it.
  if status.failed { return #cast(Cents, 0) }
  if whole > 1000000000000 {
    fail.set(status, fail.make(fail.Kind.Overflow, "parse amount", "", "amount too large"))
    return #cast(Cents, 0)
  }
  cents := #cast(Cents, whole * 100 + fraction)
  if negative {
    cents = -cents
  }
  return cents
}

// 1234 as "12.34", into a sticky fmt.Buffer.
fn write_cents(buffer: *fmt.Buffer, amount: Cents) {
  value := #cast(i64, amount)
  if value < 0 {
    fmt.write_byte(buffer, '-')
    value = -value
  }
  magnitude := #cast(u64, value)
  fmt.write_u64(buffer, magnitude / 100)
  fmt.write_byte(buffer, '.')
  fmt.write_u64_width(buffer, magnitude % 100, 2, '0')
}
