import io; // std lib items are shorthanded to this and do not need aliases

void main() {
	// there are several pieces used in control flow
	// the if statement
	if(5 > 3) {} // contents to run surrounded by {}
	
	// if statements can only accept boolean expressions 
	i32 mine = 12;
	// if(mine) {} - not allowed
	if(mine == 0) {} // allowed
	
	// ifs can be paired with elses
	bool condition = true;
	if(condition) {
		// do something
	} else {
		// do something else
	}
	// and if else is possible
	
	// loops
	
	// there are 2 loops: while and for
	
	while(boolExp) { // code to run }
	
	do { // code to run } while(boolExp); // do ensures a one time run
	
	// for loops also possible
	
	for(i32 i = 0; i < 256; ++i) { // code to run } // i will be accessible in the loop and have its val incremented each time
	// can also do this with dyn
	for(dyn<int> i = 0; i < 256; ++i) {} // this will only store i as a u16 since it never goes negative and the val doesnt warrant an i32
	
	// for can also be used on ranges
	for (dyn<int> i in 0..256) {} // makes it cleaner
	
	// fors can also be used for iteration through objects or collections which is covered in a different section
	
	// dyn supports the standard break and continue in loops as well
	// loops can also be named to make controlling things easier
	outer: while(true) {
		inner: for(i32 i = 0; i < 12; ++i) {
			if(i % 2 == 0) {
				break outer;
			}
		}
	}
	
	// also switch statement
	switch(item) {
		// switch can take any val or expression
		// the branches inside are matched against the item and the code is run accordingly
		// all statements that match the item will be run so breaks will be necessary
		pattern => codeToRun(), // this can be a function and then ends with a ,
		pattern2 => { // or a block of code to run
			// we are running some code here
		}, // still end things with a ,
		_ => {} // _ acts as a default specifier and will always get run
	}
	
	// switches work for all data types and can work for user-defined types
	type Animal {}
	
	type Dog: Animal;
	type Cat: Animal;
	Cat x = Cat();
	void item(dyn<Animal> animal) {
		switch(animal) {
			Cat => { /* Some code */ },
			Dog => { /* some other code */ }
		}
	}
	item(x);
	
	Enum Directions {
		North,
		South,
		East,
		West
	}
	
	type Latitude: Directions::North | Directions::South;
	let dir = Directions::North;
	
	void handleLat(Latitude dir) {
		switch(dir) {
			North => {},
			South => {},
		}
	}
}
