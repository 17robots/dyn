import io;

type Person {
	char* name: *char,
	i32 age,
	JobType job?,
	void() ageUp { self.age++ } // default fn behavior
	void() ageDown, // non default behavior
}

void main() {
	// stack version 1
	X item1 = X();
	X item2 = { name: "name", age: 21 };
	i32 age = 41;
	
	item2.age = age;
	
	item1.name = "Steve";
	item1.age = 12;
	
	io::print(item1.name);
}

dyn<int> returnNum() { // returns either i8, i16, i32, i64
	return 1 + 1;
	// can also do 1 + 1
}

dyn<fn> wrapper(dyn<fn> runner, char* message) {
	fn lambda = void() {
		io::println(message);
		runner();
	}
	lambda
}

Person newPerson(char* name, dyn<i8,i16> age) {
	{ name, age as i32 }
}
