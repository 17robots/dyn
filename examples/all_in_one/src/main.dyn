// learn dyn in one file <- single line comment
import io; // import items with import and the package name, imports all items from io accessible with the io package keyword
import { something, somethingelse } from otherpkg; // import selective items from package


/*
  this is the main function and the order doesnt matter. if not included, the file you run with during interpretation will be read as though the body of the file is the main fn
*/
void main() {
  io.println("Hello world");
  variable_specifics();
  types();
  operators();
  control_flow();
  functions();
  error_handling();
  memory_management();
}

void variable_specifics() {
  // variables are mutable when created
  i32 x = 0;
  x = 1; // valid

  // specify const with ! at the end of the type: [type]!
  i32! y = 1;
  y = 1; // will be caught by the compiler and flagged

  // specify static with !! at the end of the type: [type]!!
  i32!! z = 1000; 

  // here is a breakdown of the different types and what they do in the program
  // normal var: can change, bound by scope. can be left uninitialized
  // const var: cannot change, bound by scope, needs to be initialized. can be dynamically initialized
  // static var: cannot change, scoped for entire program, needs to be initialized. cannot be dynamically initialized, needs to be something calculatable at compile time. vals baked into binary
  // also good practice for statics to be named in all caps
}

void types() {
  // primitive types
  u8 short_short_unsigned; // unsigned 8 bit int
  u16 short_unsigned; // unsigned 16 bit int
  u32 unsigned; // unsigned 32 bit int
  u64 long_unsigned; // unsigned 64 bit int
  u128 long_long_unsigned; // unsigned 128 bit int
  i8 short_short_signed; // signed int 8 bits
  i16 short_signed; // signed int 16 bits
  i32 signed; // signed int 32 bits
  i64 long_signed; // signed int 64 bits
  i128 long_long_signed; // signed int 128 bits
  f32 single_float; // ieee single precision floating point number
  f64 double_float; // ieee double precision floating point number
  char utf; // 256 ascii char
  bool ean; // true | false

  // compound types
  i32[] array;
  arrays(); // more on arrays

  tuple tup;
  tuples(); // more on tuples
}

void operators() {
  // dyn provides a couple different operators

  /*
    Arithmetic operators
    ====================
    +  used for addition of ints, floats; used for string concatenation; can be used with operator overloading
    -  used for subtration of ints, floats; can be used with operator overloading
    *  used for multiplication of ints, floats; can be used with operator overloading
    /  used for division of ints, floats; can be used with operator overloading
    %  used for modulus of ints, floats; can be used with operator overloading
    ++ used for increment of ints, floats; can be used with operator overloading
    -- used for decrement of ints, floats; can be used with operator overloading
  */
  
  /*
    Logical operators
    ====================
    &&  used for logical and of 2 boolean expressions ex true && false = false;
    ||  used for logical or of 2 boolean expressions ex true && false = true;
    !   used for logical not of a boolean expression ex !true = false;
  */
  
  /*
    Relational operators
    ====================
    ==  used for equal to for 2 expressions ex 1 == 1 = true;
    !=  used for not equal for 2 expressions ex 1 != 1 = false;
    >   used for greater than for 2 expressions ex 2 > 1 = true;
    <   used for less than for 2 expressions ex 2 < 1 = false;
    >=   used for greater than or equal for 2 expressions ex 2 >= 1 = true;
    <=   used for less than or equal for 2 expressions ex 2 <= 1 = false;
  */
  
  /*
    Bitwise operators
    ====================
    &  used for bitwise and of 2 bit patterns ex 0101 & 1111 = 0101;
    |  used for bitwise or of 2 bit patterns ex 0101 | 1111 = 1111;
    ^  used for bitwise xor of 2 bit patterns ex 0101 | 1111 = 1010;
    ~  used for bitwise flipping a bit pattern ex ~0101 = 1010;
    << used for bitwise left shift ex 1111 << 1 = 11110;
    >> used for bitwise left shift ex 1111 >> 1 = 111;
  */
  
  /*
    Pointer operators
    ====================
    *   used for dereferencing a pointer;
    &   used for providing a reference to a variable's memory address;
    +   used for shifting over an iterator amount to the next val in memory
    -   used for shifting over an iterator amount to the prev val in memory
    new used for allocating on the heap
  */
  
  /*
    Assignment operators
    ====================
    =    used for assigning a value to a var;
    +=   used for adding a value to a var and saving it to that same var;
    -=   used for subtracting a value to a var and saving it to that same var;
    *=   used for multiplying a value to a var and saving it to that same var;
    /=   used for dividing a value to a var and saving it to that same var;
    %=   used for modulusing a value to a var and saving it to that same var;
    &=   used for logical anding a value to a var and saving it to that same var;
    |=   used for logical oring a value to a var and saving it to that same var;
    ^=   used for logical xoring a value to a var and saving it to that same var;
    <<=  used for logical left shifting a value to a var and saving it to that same var;
    >>=  used for logical right shifting a value to a var and saving it to that same var;
  */
  
  /*
    Misc operators
    ====================
    ?  used for dereferencing a pointer;
    ,  used for providing a reference to a variable's memory address;
    |> used for piping a val through a series of fns, pairs with the _ symbol to hold value
  */
}

void arrays() {
  // arrays are contiguous blocks of the same type
  // arrays can be made of any type
  i32[] arr1; // valid
  i32[][] arr2; // also valid
  char[] arr3; // also also valid

  // initialize an array with values
  i32[] arr4 = [1,2,3,4];
  i32[] arr5 = [4; 0]; // initialize 4 elements with the value of 0, same as = [0,0,0,0];

  // access array
  io.println(arr4[0]); // prints 1

  // set array elems with accessor
  arr5[1] = 1;
  arr5[2] = 2;
  arr5[3] = 3;

  // arrays have a couple other features built in:
  io.println(arr4.sum()); // sums array
  io.println(arr4.len()); // gets len of array in exact size
}

void tuples() {
  // define tuple with tuple vals
  (i8, char, bool) x = (0,'a',false);

  // access tuple vals
  io.println(y.0); // prints 1
  x.0 = 1;
  x.1 = 'b';
  x.2 = true;
  // tuple vals can only be set to vals contained within their type, so this doenst work:
  // x.0 = 'z' -> doesnt work because x.0 is an i8 not a char
}

void functions() {
  // functions are an integral to the language
  // functions can be declared in global scope or in the scope of other functions
  // define a fn
  void example_fn() {} // include type, name and parens with the body of fn

  // call the fn with just parens
  example_fn();

  // this function only exists in the functions scope
  

  // function that returns something
  i32 five() {
    return 5;
  }

  io.println(five()); // call fn that returns a val in place of actual val

  // parameters in fns
  void print_sum(i32 x, i32 y) {
    io.println(x + y);
  }

  // parameters are pass by reference by default but ints are pass by copy since it's more performant to do it that way

  // any type can be passed as a parameter, including arrs, tuples, and other fns, which can also be the return type
  // arrs as parameters
  void print_arr(i32[] x) {
    for(y in x) {
      io.println(y);
    }
  }
  // call this fn using an arr literal
  print_arr([1,2,3,4,5]);

  // tuples as parameters
  void print_tuple((i32,char,bool) my_tup) {
    io.println(my_tup.0);
    io.println(my_tup.1);
    io.println(my_tup.2);
  }

  // call the fn - need to be careful since the tuple type becomes (i32,char,bool), the tuple passed needs these fields in this order, can still use a tuple literal as long as it matches the type
  print_tuple((1,'a',true)); // anything other than these val types in this order will fail

  // defining a fn that returns a fn and takes one as an argument
  void(i32,i32) chained_fn(void(i32,i32) x) {
    void a(i32 y, i32 z) {
      io.println("Calling arg fn x on {y} {z}");
      x(y,z);
    }
    return a;
  }
  // to call this fn 
  chained_fn(print_sum)(1,2); // we can use the above fn as an argument since it matches the same type for that fn, the (1,2) is just calling the fn directly
  // fn types are written differently than actual fn declarations, the fn type is [type]([type1],[type2]) [var name]
  // this is done so that they can be passed as args more easily and flexibly

  // inline fns(lambdas) can work too as long as it matches the fn signature passed as the arg for the fn
  chained_fn(void(i32 x, i32 y) {
    io.println(x);
    io.println(y);
  })(0,1);

  // anonymous fns are created like normal fn declarations except they do not have a name
  // for example
  i32[] filter(i32[] to_filter, bool(i32) filter_fn) {
    i32[] results = [];
    for(x in to_filter) {
      if(filter_fn(x)) {
        results.push(x);
      }
    }
    return results;
  }

  // then we can call
  io.println(filter([1,2,3,4,5], bool(i32 y) {
    return y > 1;
  })); // prints [2,3,4,5]

  // functions can also return different types if specified
  i32 | string something(i32 | string x) {
    return x;
  }
}

void control_flow() {
  // there are 3 different control flow structures:
  //  - loops
  //  - branches

  /* branches */
  // branches are different strategies for making choices
  // if branch
  if 3 > 1 {
    io.println("We got the bigger number");
  }

  // can also do else and else if
  if 3 > 1 {}
  else if 3 == 1 {}
  else {}

  // match branch
  match 4 {
    1 => {},
    2 => {},
    3 => {},
    4 => {},
    _ => {},
  }
  // match will run the code in {} for each statement that's true
  // _ represents catch all default case that will run if other branches do not
  
  // can use conditionals in match too
  // fizbuzz
  match 15 {
    % 5 == 0 {io.print("fizz");}, // will run
    % 3 == 0 {io.print("buzz")}, // will run
    _ => {}, // will not run since other branches ran
  } // first term in conditional is omitted in place of the item being matched, where it gets added instead when comparing
  

  /* loops */
  // there are different loops
  i32 counter = 0;
  loop counter < 3 { // loop while a consition is true, not providing condition defaults to run forever
    io.println(counter);
    counter++;
  }

  // for loops are easier way to write the above loop
  for i8 x in 1..10  { // range syntax
    io.println(x);
  }
  for(i8 i = 0; i < 10; i*=2) { // loop structure for finer control
    // do something
  }

  // easier result with range syntax
  for(i8 x in 0..10..2) {} // 3rd number is the step to account for in the range, when not specified it defaults to 1

  for(i8 x in 10..0..2) {} // can be done in reverse too

  i32 counting = 100;
  for(i8 x in counting..0..2) {} // can be done with vars
}

void error_handling() {
  // since fns and control flow have been covered, we can look at how to handle errors
  // to be more flexible, dyn provides 2 structures for handling errors: Some and Optional
  // these are ideas taken from rust but with their own spin to them to keep it unique
  Optional(i32) divide(i32 x, i32 y) {
    if y == 0 {
      return Error("Cannot divide by 0");
    } else {
      return Success(x / y);
    }
  }

  // so now what does this look like?
  // we can match it
  match divide(1,0) {
    Error(msg) => { io.println(msg);},
    Success(val) => { io.println(val); },
  } // this includes extra pattern matching called placeholders which give named vars for the items in () to be extrapolated out in the body of the scope
  // can also check with if
  i32 res = divide(1,0);
  if res.success() { io.println(res.val); } // contains a success method to check if the res of the fn is Success() or error
  else { io.println(res.msg); }
  // best way that was copied from what rust did:
  if Error(msg) == divide(1,0) {
    println(msg);
  } // doesnt handle the val here though, so if you wanted to include both options then the above if or the match are the better way to go

  // the Some version is the exact same except with Thing(val) or None
  // item.thing(), item.none()

  // these vals can be propogated or passed up the chain to handle them properly, and it doesnt require the program to crash to do so
  // this lets you clean up and properly shut down the program if there is an issue and gives you control, but there is a way to immediately cease execution of the code, and that's with abort();
  // for example i32 val = abort(divide(1,0)); // if the code in abort is successful then the res is returned, otherwise the code will cease execution without cleanup
}

void memory_management() {
  // everything discussed so far is said to be stored on the stack
  // so how do we get heap access? How do we share memory
  // one of the core pieces we can do that with are pointers
  // pointers are memory addresses, and they can point to anything, from the heap or the stack
  // in languages like c and c++, you are able to control and create your own raw pointers whenever and wherever but you were responsible for managing them yourself
  
  // direct memory access will be allowed, but the compiler will check the scope of the pointer and after the last time that it is used, a clear instruction will be added to reclaim the memory
  // this is all done at compile time and will not need a garbage collector
  // Also, the code will track the specific memory address, and not just the pointer that referenced it, so if other pointers point to that address, the compiler will not add the free command until all references are out of scope
  // Since the compiler keeps track of the address and who points to it, the lifetime doesnt need considered
  
  // create a pointer
  i32* p = new(3); // create a new i32 pointer and give it the value of 3
  // print the mem address and value of the pointer
  io.println("This is ${*p} stored at {p}");

  // heres how to declare a pointer to a value on the stack
  i32 np = 4;
  // free(p); p = null; // artificially added here per below comment
  p = &np; // nobody points to the old referenced memory starting here, so the free is added to free space on the heap
  // stack pointer claims are different since they will be removed when all vars from the stack are freed, so no extra frees need to happen, but pointers are invalidated at the end so this works fine

  i32* yes;
  i32 yes2 = 1;
  yes = &yes2;

  // see below to understand how memory references work atomically to provide access to shared memory
}

void user_types() {
  // There are 2 user defined types in Dyn: Enum and struct

  /* Enum */
  // Enums are simple in dyn, but they provide flexibility to build more complex types without needing something like a struct
  // c style enums
  enum DaysOfWeek {
    MONDAY,
    TUESDAY,
    WEDNESDAY,
    THURSDAY,
    FRIDAY,
    SATURDAY,
    SUNDAY
  }

  // you can also specify values for each of the enum variants
  enum Numbers = {
    ONE = 1,
    TEN = 10,
    HUNDRED = 100,
    ONEOONE = 101
  }

  // This can be extended by assigning a partner that can be associated with that type
  enum Command {
    string DownloadFile,
    (i32, i32) MouseClick,
    (string, string) UploadFile,
    Handshake, // doesnt need to have a partner to it
  }

  // instantiating variants
  Numbers one = Numbers.One;
  Numbers hundred = .Hundred; // shorthand

  Command download = .DownloadFile("hello.txt"); // assign partner to variant instance

  // can be used in matching
  match download {
    DownloadFile(x) => io.println("Downloading File"),
    MouseClick(x, y) => io.println("Mouse clicked"),
    UploadFile(x, y) => io.println("Uploading File"),
    Handshake => io.prinln("hi"),
  } // matching an enum without all of the variants or a _ branch will cause the switch to do nothing if none of the cases are hit, but it is good documentation to include that, either with _ => {} or adding a comment to express intent

  /* structs */
  // structs are a little different than enums, as they have fields that can be accessed and modified
  struct Animal {
    u16 age,
    u32 weight,
    string name,
    string sound,
  }

  // make an animal
  Animal cow = { name: "Bessie", age: 12, weight: 200, sound: "Moo" }; // struct block

  // Types can also inherit things from other types
  struct Cow : Animal {
    // has all attributes of animal
    sound = "moo", // can provide a default value or overrides
    bool utters, // can add extra on top of parent params
  }

  // heres how to handle functions with structs
  struct AnimalWithFunctions {
    void() eat, // specifies a void function with no arguments
    string() speak, // specifies another fn that returns a string
    void(i32) sleep, // specifies a fn with a parameter
  }

  // you can define default behavior for a fn as well
  struct Rectangle {
    f64 l,
    f64 w,
    f64 area() = f64 (self) { return self.l * self.w; }, // can access the members with self
    f64 perimeter() = f64 (self) { return 2 * self.l + 2 * self.w; } 
  }

  // if a fn doesnt have any default value, the value can be rewritten when instantiated

  struct WeCanDoThings {
    string msg,
    void() something,
    string() tostring,
  }

  WeCanDoThings we = {msg: "Hello world", something: void () {}, tostring: string(self) { return "Message is" + self.msg}}
  we.something(); // call the fn
  io.println(we.tostring());

  // structs can inherit multiple structs; not just one
  struct Cube : Rectangle, WeCanDoThings {
    // define things here
  }
  
  // this extends into inheritence too

  // we can pass on the member fns to the children and we can exclude behavior
  struct OverrideThis {
    i32 one,
    i32 two,
    i32() three,
  }

  struct OverridingIt : OverrideThis {
    i32() three = i32() { return 3; }, // if no default was specified then the instantiation would need to include it
    void() other, // we can also include other member fns that dont have defaults as well
    i32 four = 4, // and then including default members as well too
  }

  // this leads into how interfaces work in dyn
  struct CoolInterface {
    i32() funcOne,
    i32() funcTwo,
    i32() funcThree,
  }

  // to implelment an interface, just include it in the extension list
  // extending multiple types mean that instantiating different structs of various lengths could become tedious
  // example
  struct ManyMembers {
    i32 member1,
    i32 member2,
    i32 member3,
    i32 member4,
    i32 member5,
    i32 member6,
    i32 member7,
    // more
    i32 member50,
  }

  // instantiating this struct would be very tedious, so the defaults of unspecified vars can be used, as specified on the different members
  // also, there's shorthand for specifying multiple members of the same type
  struct ShortHandMembers {
    i32 mem1, mem2, mem3, mem4, mem5 = 1,// can specify defaults for multiple members at one time
    i32 mem21 = 2, // different override,
    i32 mem22, // no override
    string mem6, mem7, mem8, mem9, mem10 = "",
    f32 mem11, mem12, mem13, mem14, mem15 0.,
    f64 mem16, mem17, mem18, mem19, mem20 = 0.,
    ManyMembers mm1, mm2, mm3, mm4, mm5, mm6 = {}, // uses default member values for ManyMembers
  }
}

void metaprogramming() {
  // dyn contains several mechanisms for metaprogramming

  /* macros */
  // dyn supports the creation of macros that can be called and generated
  // define a macro
  macro something {
    
  }
  
  /* generics */
  // generics are a way to work with multiple types of arguments in a function without having to write multiple functions for each type
  // this also applies to user-made types as well 
  // define a function using a generic
  void print_arg<T>(T arg) {
    io.println(arg);
  }

  // define a generic function that returns the type
  T return_arg<T>(T arg) { return arg; }

  // we can also constrain the types that it generates for
  T print_only_ints<T: i8 | i16 | i32 | i64 | i128>(T arg) { io.println(arg); }

  // using multiple generics
  void print_multi_vars<T, U>(T arg1, U arg2) { io.println("{arg1} {arg2}"); }

  /* type aliasing */
  // define a type alias

  type AdderFunc = i32(i32,i32)

  // we can now use this in a function definition
  void printSum(AdderFunc a) {
    io.println(a(1,2));
  }

  // generics can be used with interface types to denote types that extend those interfaces
  struct SomeInterface {
    void() needthis,
    void() needthistoo,
  }
  void exclusiveToInterfaces<T: SomeInterface>(T item) {
    // do something or call some fn
  }

  // generics can also be used for user defined types
  enum GenericsType<T> {
    T Something,
    SomethingElse = 2,
  }

  // and generics can be used in a struct too
  struct WeNeedGenerics<T> {
    T woah, woah1, woah2,
  }

  // heres an example of instantiating the generics struct and the enum
  GenericsType gen = .Something<i32>(2);
  WeNeedGenerics<i32> gen2 = { woah, woah1, woah2: 3 };

  // can use the dyn keyword in the same way as generics here (see below for general usage)
}

void dyn_keyword() {
  // the dyn keyword was introduced as it reflects the core idea of dyn being flexible and easy, yet powerful
  // it serves a couple functions
  // 1. it serves as a shorthand for repetitive code to make it simpler and faster to write
  // 2. it allows for finer optimization of space during runtime
  // 3. it allows for more fluid generics binding
  // 4. it creates a system of polymorphism for different user-defined types

  // the dyn keyword only works for types that can have different types, ints (both signed and unsigned), and floats, and user types that have a root type

  // define a fn using the dyn keyword
  dyn<I> any_signed_int(i32 arg) { return arg; } 
  dyn<U> any_unsigned_int(u32 arg) { return arg; }
  dyn<F> any_float(f32 arg) { return arg; }
  dyn<A> any_value<T: dyn<A>>(T x) { return x; }

  // one key feature of the dyn keyword is that when it is used it will return the smallest needed size based on usage and value.
  // this can be overridden by using a specific type when calling the fn, but the size must be able to account for the possible value returned from the function
  dyn<I> val = any_signed_int(3);

  // override example
  i32 val = any_signed_int(3);

  // usage with user defined types

  // usage with generic binding
  // syntactically correct version
  dyn<I> something<T: dyn<I>>(T arg) {}

  // this can be tedious, for example:
  dyn<I> something_else<T: dyn<I>, U: dyn<I>, V: dyn<I>>(T arg1, T arg2, U arg3, U arg3, V arg4, V arg5) {}

  // so we have syntactical sugar to make things a little nicer if youre returning a dyn var and using the type in fns
  dyn<I> something_else_else(I arg1, I arg2, I arg3, I arg4, I arg5) {}

  // a syntactical sugar version when not returning a dyn or overriding a dyn type
  i32 something_else_else_else<T: dyn<I>>(T arg1, T arg2, T arg3, T arg4, T arg5) {}
}

void concurrency() {
  // so concurrency in dyn is interesting
  // there are 2 ways to achieve concurrency: threads and processes

  // processes - individual calls running with their own memory
  import proc; // local imports so it doesnt need global scope, cool
  void procFn() { // we need a fn to run something, but we can also specify a fn literal
    // we can do things in a fork here
  }

  proc.Pool pool = {initsize: 3}; // create 3 processes without a fn to run
  pool.use(procFn, []); // pass the fn and then an arr of any args the fn takes

  pool.spawn(); // spawns another process using the same parameters and fn, even if the other processes are complete

  pool = {initSize: 5}; // reinitialize with a new pool size

  for i in 0..pool.len() {
    p.use(i32(i32 i) {
      return i * 2;
    }, [i]); // can iterate through the different threads itll spawn and use individually if they need different args, the queue 
  }

  // now to read from the queue to get our results
  io.println(pool.results().sum());

  // all results are managed by the pool

  // can also spawn individual process
  proc.Process individual_process = {};
  individual_process.use(i32() { io.println(2); return 2;}, []);

  io.println(individual_process.result()); // 2
  
  // threads - individual calls running with shared memory
  // threads are a little trickier, but the shared memory can be locked and managed
  // each thread contains a locking mechanism if it needs to maintain the data
  void easyThreadFn(string msg) {
    io.println(msg);
  }

  import thread;

  
  thread.Thread[] threads = [{},{},{},{}]; // generate 4 threads

  for i in 0..threads.length() {
    threads[i].run(easyThread, [i]); // run the threads
  }

  for thread in threads { thread.join(); } // wait for the threads to finish doing their job

  // heres how to manage data
  int sum = 0;
  thread.Lock l = {};
  threads = [{lock: &l}; 3]; // shorthand because its gonna be repeated
  for i in 0..threads.length() {
    threads[i].run(void(i32 x) { sum += x; }, [i]); // we can use fns that reference local context variable
  }

  io.println(sum); // 3

  // heres whats happening under the hood
  Optional<T> threads.run<T,U: dyn<A>>(self, T(U[] args) fn, U[] vals) {
    loop self.lock.locked(); // wait till the lock is available, dont need {} since nothing happens
    if args.length() != vals.length() { return Error("Arguments passed must be the same number as whats needed by the fn"); }
    T val;
    self.lock.lock();
    val = vals.lengh() == 0 ? fn() : fn(vals);
    val = fn();
    self.lock.unlock();
    return Success(val);
  }
}

void testing() {
  import testing;
  // define a test
  #(test) // use the testing directive for the compiler to handle
  testing.test(void() {
    i32 x() { return 2; }
    testing.eq(2,2);
    testing.neq(2,3);
    testing.eq(x(), 2);
    testing.returns(x(), "i32");
    testing.returns(i32|i64() {return 3 as i64;}, "i32|i64");
  });
  // when running `dyn test` the compiler will find the #(test) directive calls and run them in its own testing suite
}

void multiparadigm() {
  // dyn can be used for multiple paradigms:
  /* oop */
  // Encapsulation - Dyn supports struct types that can also include behaviors (both default and specified at instantiation)
  // Inheritance - Dyn supports inheritance of types through the struct [type] : [supertype] syntax and includes passing those methods to the inheriting types
  // Polymorphism - Since dyn supports the dyn keyword, which allows for polymorphism: 1 passing the template argument as T: dyn<Shape> func(T shape) { io.println t.area(); }
  // Abstraction - dyn provides the ability to add empty function types as struct members to provide the ability to create interfaces and allow for abstraction
  
  /* functional */
  // Immutable data - Data can be flagged as const to disallow it to be edited, adding const is as easy as [type]! var_name; but the const need their value assigned at creation
  // Higher-Order Functions - Functions in dyn can take functions as arguments or return functions, this allows support for things like callbacks and function literals are also supported
  // Pure Functions - functions in dyn support being pure and not having side effects, but that becomes the design of the programmer, but iterator methods are also supported
  // Recursion - Dyn functions support recursion
  // Lazy Evaluation - Dyn supports lazy functions by default
  // Type System - Dyn's type system is static and allows for robust checking at compile time
  // Algebraic Data Types - Dyns type system supports algabrainc types
  
  /* procedural */
  // By its very nature given the functions and variables allow it to support procedural programming
}

