// journal: keep notes for one session, reading commands from standard input.
//
//   note TEXT    keep TEXT until the program ends
//   find WORD    show the notes that contain WORD, ignoring case
//   undo         forget the newest note and give back its memory
//   list         show every note
//   stats        show how much memory each arena holds
//
// The point of this program is lifetimes. Every allocation goes to an arena
// chosen by how long the data must live:
//
//   line buffer  on the stack, overwritten by every line read
//   frame        an arena reset after every command
//   permanent    an arena that lives until main returns
//
// Run: dyn run examples/04-journal < examples/04-journal/commands.txt

use "std/bufio"
use "std/fail"
use "std/bytes"
use "std/io"
use "std/mem"
use "std/strings"

// Notes form a linked list, newest first. Each note and its text are pushed
// onto the permanent arena right after mark, so rewinding the arena to mark
// frees exactly that note: arena memory is released in reverse order.
struct Note {
  text: []const u8,
  previous: *Note,
  mark: usize,
  number: u32,
}

struct Journal {
  permanent: *mem.Arena,
  newest: *Note,
  count: u32,
  // The most the frame arena held at the end of any command.
  frame_peak: usize,
}

fn add_note(journal: *Journal, text: []const u8) {
  mark := mem.arena_mark(journal.permanent)
  note := mem.push(Note, journal.permanent)
  // text points into the line buffer, which the next line overwrites. Keep
  // a copy in the arena that lives as long as the note.
  note.text = strings.clone(journal.permanent, text)
  note.previous = journal.newest
  note.mark = mark
  journal.count += 1
  note.number = journal.count
  journal.newest = note
  io.println("noted #{}", note.number)
}

fn undo(journal: *Journal) {
  note := journal.newest
  if note == nil {
    io.println("nothing to undo")
    return
  }
  io.println("forgot #{}: {}", note.number, note.text)
  journal.newest = note.previous
  journal.count -= 1
  // After the rewind, note and note.text point at freed memory. Read
  // everything you need from them first.
  mem.arena_rewind(journal.permanent, note.mark)
}

// A lowercase copy in the frame arena: it only has to last for this command.
fn lower(frame: *mem.Arena, text: []const u8) []const u8 {
  copy := strings.clone(frame, text)
  for *byte in copy {
    byte.* = strings.ascii_to_lower(byte.*)
  }
  return copy
}

fn find(journal: *const Journal, frame: *mem.Arena, word: []const u8) {
  needle := lower(frame, word)
  matches: u32 = 0
  note := journal.newest
  for note != nil {
    if bytes.contains(lower(frame, note.text), needle) {
      io.println("  #{} {}", note.number, note.text)
      matches += 1
    }
    note = note.previous
  }
  io.println("{} found", matches)
}

fn list(journal: *const Journal) {
  // for with only a condition is a while loop.
  note := journal.newest
  for note != nil {
    io.println("  #{} {}", note.number, note.text)
    note = note.previous
  }
}

fn stats(journal: *const Journal) {
  // The permanent arena grows and shrinks with the notes. The frame arena
  // never holds more than one command's worth, however long the session.
  io.println("notes: {}, permanent: {} bytes, frame peak: {} bytes", journal.count,
    mem.arena_used(journal.permanent), journal.frame_peak)
}

// Splits "find cat" into "find" and "cat".
struct Command {
  name: []const u8,
  rest: []const u8,
}

fn split_command(line: []const u8) Command {
  text := strings.trim(line)
  space := bytes.find_byte(text, ' ')   // #len(text) when there is no space
  if space == #len(text) { return Command{ name: text } }
  return Command{ name: text[..space], rest: strings.trim(text[space + 1..]) }
}

fn run(journal: *Journal, frame: *mem.Arena, line: []const u8) {
  command := split_command(line)
  case command.name {
    "" => {}
    "note" => {
      add_note(journal, command.rest)
    }
    "find" => {
      find(journal, frame, command.rest)
    }
    "undo" => {
      undo(journal)
    }
    "list" => {
      list(journal)
    }
    "stats" => {
      stats(journal)
    }
    _ => {
      io.println("unknown command: {}", command.name)
    }
  }
}

fn main() {
  // Arenas are created explicitly and released explicitly. defer runs the
  // release when main returns.
  permanent := mem.arena_alloc(0)
  defer mem.arena_release(permanent)
  frame := mem.arena_alloc(0)
  defer mem.arena_release(frame)
  journal := Journal{ permanent: permanent }

  // Fixed storage on the stack for bufio. Each line borrows it until the
  // next read.
  input_storage: [512]u8
  reader := bufio.reader(io.stdin(), input_storage[..])
  for {
    // Each read has its own status: a line too long for the storage is
    // skipped, but input that cannot be read stops the journal.
    input: fail.Status
    line := bufio.read_line(&input, &reader)
    if input.failed && input.failure.kind == fail.Kind.Capacity {
      io.println("line too long")
      continue
    }
    if input.failed {
      storage: [512]u8
      io.eprintln("journal: {}", fail.describe(storage[..], input.failure))
      return
    }
    if reader.ended { return }
    run(&journal, frame, line)
    if mem.arena_used(frame) > journal.frame_peak {
      journal.frame_peak = mem.arena_used(frame)
    }
    // Everything the command put in frame is gone now, all at once.
    mem.arena_reset(frame)
  }
}
