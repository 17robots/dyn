import { io, Result } from "std";
import { create_publisher, QueuePublisher } from "borsh";
import { UserCreatedEvent } from "events";

void main() {
    Result<QueuePublisher> pub = create_publisher("link");
    if pub = .Ok(p) {
        p.publish("user_created", UserCreatedEvent {
            id: "1",
            name: "bob",
        });
        p.publish("user_created", UserCreatedEvent {
            id: "2",
            name: "bill",
        });
        p.publish("user_created", UserCreatedEvent {
            id: "3",
            name: "burt",
        });
        p.publish("user_created", UserCreatedEvent {
            id: "4",
            name: "boe",
        });
    } else {
        io.println("Failed to create publisher");
    }
}
