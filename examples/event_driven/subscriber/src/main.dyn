import io;
import { Crosstown, QueueProperties } from "crosstown";
import { UserCreatedEvent } from "events";

void main() {
  Maybe<QueueListener> listener = Crosstown.createListener("rabbitmq link");
  match listener {
    Yes(l) {
      l.listen("user_created", Maybe<void, Error>(UserCreatedEvent* e) { 
        io.println("message: {}", *message);
        return Yes(());
      }, QueueProperties { auto_delete: false, durable: false, use_dead_letter: true});
    },
    No(e) {
