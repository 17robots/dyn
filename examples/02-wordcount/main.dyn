// wordcount: count lines, words, characters and bytes, like wc.
//
//   wordcount [FILE...]
//
// With no files it reads standard input. Each input streams through one
// fixed buffer on the stack, so a file of any size uses the same memory.
//
// Run: dyn run examples/02-wordcount -- examples/02-wordcount/poem.txt

use "std/fail"
use "std/fmt"
use "std/fs"
use "std/io"
use "std/process"

// Counts for one input. Every field starts at zero.
struct Counts {
  lines: u64,
  words: u64,
  characters: u64,
  bytes: u64,
  in_word: bool,   // carries a word across the end of one chunk
}

fn is_space(byte: u8) bool {
  case byte {
    ' ', '\t', '\n', '\r' => { return true }
    _ => { return false }
  }
}

// Counting happens chunk by chunk, so the state lives in Counts, not in a
// local of this function.
fn count_chunk(counts: *Counts, chunk: []const u8) {
  counts.bytes += chunk.len
  for byte in chunk {
    if byte == '\n' {
      counts.lines += 1
    }
    // UTF-8 continuation bytes look like 10xxxxxx. Every other byte starts
    // a character. Mixing & with == needs parentheses.
    if (byte & 0xC0) != 0x80 {
      counts.characters += 1
    }
    if is_space(byte) {
      counts.in_word = false
    } else if !counts.in_word {
      counts.in_word = true
      counts.words += 1
    }
  }
}

// io.Reader is the seam every input shares: a file, standard input, a
// socket or bytes in memory. io.read returns 0 at the end of the input, and
// try passes a failure on to the caller.
fn count_reader(reader: io.Reader, counts: *Counts) !io.IoErr {
  chunk: [64 * 1024]u8
  for {
    count := try io.read(reader, chunk[..])
    if count == 0 { break }
    count_chunk(counts, chunk[..count])
  }
}

// Counts one file through the same reader code.
fn count_file(name: []const u8, counts: *Counts) !io.IoErr {
  file := try fs.open(name)
  // defer runs when this function returns, however it returns.
  defer fs.close(&file)
  try count_reader(fs.reader(&file), counts)
}

fn add(total: *Counts, part: Counts) {
  total.lines += part.lines
  total.words += part.words
  total.characters += part.characters
  total.bytes += part.bytes
}

// One right-aligned row. A fmt.Buffer writes into storage you give it and
// records into a status: after one write does not fit, the rest do nothing,
// and the status says so once at the end.
fn show(counts: Counts, name: []const u8) {
  storage: [256]u8
  rendering: fail.Status
  row := fmt.buffer(&rendering, storage[..])
  fmt.write_u64_width(&row, counts.lines, 8, ' ')
  fmt.write_u64_width(&row, counts.words, 8, ' ')
  fmt.write_u64_width(&row, counts.characters, 8, ' ')
  fmt.write_u64_width(&row, counts.bytes, 8, ' ')
  if name.len > 0 {
    fmt.write(&row, " ")
    fmt.write(&row, name)
  }
  if rendering.failed {
    #panic("a row is longer than its buffer")
  }
  io.println("{}", fmt.bytes(&row))
}

// Prints what failed, such as "wordcount: missing.txt: not found".
fn report(name: []const u8, err: io.IoErr) {
  io.eprintln("wordcount: {}: {}", name, err)
}

// main may return an i32: the process exit code.
fn main() i32 {
  // process.start gives the arguments, argv[0] first, and an arena that
  // lives for the whole program. Call it on main's first line.
  program := process.start()
  files := program.args[1..]

  if files.len == 0 {
    counts: Counts
    count_reader(io.stdin(), &counts) catch err {
      report("standard input", err)
      return 1
    }
    show(counts, "")
    return 0
  }

  total: Counts
  exit_code: i32 = 0
  for name in files {
    // A file that cannot be read does not stop the others.
    counts: Counts
    count_file(name, &counts) catch err {
      report(name, err)
      exit_code = 1
      continue
    }
    show(counts, name)
    add(&total, counts)
  }
  if files.len > 1 {
    show(total, "total")
  }
  return exit_code
}
