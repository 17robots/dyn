// site: build a small static website from a directory of text pages.
//
//   site SOURCE OUTPUT
//
// Every SOURCE/NAME.txt becomes OUTPUT/NAME.html, and OUTPUT/index.html
// links to every page, sorted by title.
//
// Run: dyn run examples/08-site -- examples/08-site/pages build/site

use "std/bytes"
use "std/container/array"
use "std/fail"
use "std/fs"
use "std/html"
use "std/io"
use "std/mem"
use "std/path"
use "std/process"
use "std/sort"
use "std/strings"

const MaxPageBytes: usize = 1 << 20

struct Page {
  name: []const u8,    // "intro" for intro.txt
  title: []const u8,
}

// The names of SOURCE/*.txt, in arena.
fn list_pages(arena: *mem.Arena, status: *fail.Status, source: []const u8) [][]const u8 {
  names: array.Array([]const u8)
  array.init(&names, arena)
  for entry in fs.list(arena, status, source) {
    if bytes.equal(path.extension(entry.name), ".txt") {
      array.push(&names, entry.name)
    }
  }
  return names.items
}

fn earlier_title(a: Page, b: Page) bool {
  return bytes.compare(a.title, b.title) < 0
}

// Builds one page. Everything this needs only while it runs goes in
// scratch: the file's text, the HTML and the paths. The mark and the
// deferred rewind give all of it back when the function returns, so a site
// of a thousand pages needs no more scratch than its largest page. What
// must outlive the call, the page's name and title, goes in keep.
fn build_page(keep: *mem.Arena, scratch: *mem.Arena, status: *fail.Status, source: []const u8, output: []const u8, file_name: []const u8) Page {
  mark := mem.arena_mark(scratch)
  defer mem.arena_rewind(scratch, mark)

  // The paths go in keep, not scratch: a failure borrows its path, and main
  // prints the failure after this function has given scratch back.
  input := path.join(keep, source, file_name)
  read := fs.read_all(scratch, status, input, MaxPageBytes)
  // Escaping turns one byte into at most six ("&quot;"), plus room for tags.
  // Sized for the worst case of escaping, so status only fails here if the
  // read did.
  writer := html.writer(status, mem.push_bytes(scratch, 6 * #len(read) + 1024))
  render_page(&writer, read)

  stem := file_name[..#len(file_name) - #len(".txt")]
  page_name := strings.format(scratch, "{}.html", stem)
  target := path.join(keep, output, page_name)
  fs.write_all(status, target, html.output(&writer).bytes)
  return Page{ name: strings.clone(keep, stem), title: strings.clone(keep, page_title(read)) }
}

fn build_index(keep: *mem.Arena, scratch: *mem.Arena, status: *fail.Status, output: []const u8, pages: []const Page) {
  mark := mem.arena_mark(scratch)
  defer mem.arena_rewind(scratch, mark)
  size: usize = 1024
  for page in pages {
    size += 6 * (#len(page.name) + #len(page.title)) + 64
  }
  writer := html.writer(status, mem.push_bytes(scratch, size))
  header(&writer, "All pages")
  open_tag(&writer, "<ul>\n")
  for page in pages {
    open_tag(&writer, "<li><a href=\"")
    html.text(&writer, page.name)
    open_tag(&writer, ".html\">")
    html.text(&writer, page.title)
    open_tag(&writer, "</a></li>\n")
  }
  open_tag(&writer, "</ul>\n")
  footer(&writer)
  target := path.join(keep, output, "index.html")
  fs.write_all(status, target, html.output(&writer).bytes)
}

fn main() i32 {
  program := process.start()
  if #len(program.args) != 3 {
    io.eprintln("usage: site SOURCE OUTPUT")
    return 2
  }
  source := program.args[1]
  output := program.args[2]
  keep := program.arena
  scratch := mem.arena_alloc(0)
  defer mem.arena_release(scratch)

  // One status for the whole build: after the first failure every later
  // step does nothing, so the only check is before reporting success.
  status: fail.Status
  names := list_pages(keep, &status, source)
  fs.make_directory(&status, output)
  pages: array.Array(Page)
  array.init(&pages, keep)
  for file_name in names {
    array.push(&pages, build_page(keep, scratch, &status, source, output, file_name))
  }
  sort.sort_by(pages.items, earlier_title)
  build_index(keep, scratch, &status, output, pages.items)
  if status.failed {
    storage: [512]u8
    io.eprintln("site: {}", fail.describe(storage[..], status.failure))
    return 1
  }
  for page in pages.items {
    io.println("{}.html  {}", page.name, page.title)
  }
  // Every function gave its scratch back, so nothing is left in it.
  io.println("{} pages, {} scratch bytes left", #len(pages.items), mem.arena_used(scratch))
  return 0
}
