// calc: a calculator that reads one expression per line.
//
//   > let r = 2.5
//   r = 2.5
//   > 3.14159 * r ^ 2
//   19.6349
//
// Run: dyn run examples/05-calc < examples/05-calc/input.txt

use "std/bufio"
use "std/container/map"
use "std/io"
use "std/math"
use "std/mem"
use "std/strings"

// Prints the line with a caret under offset.
fn point_at(offset: usize, message: []const u8) {
  storage: [256]u8
  indent := storage[..math.min(offset, storage.len)]
  for *byte in indent {
    byte.* = ' '
  }
  io.println("  {}^ {}", indent, message)
}

fn main() {
  // The tree for each line lives in frame, reset after every line. The
  // variables outlive their line, so their names go in permanent.
  permanent := mem.arena_alloc(0)
  defer mem.arena_release(permanent)
  frame := mem.arena_alloc(0)
  defer mem.arena_release(frame)

  names: map.Map<[]const u8, f64>
  map.init(&names, permanent)
  map.insert(&names, "pi", 3.141592653589793)

  input_storage: [4096]u8
  reader := bufio.reader(io.stdin(), input_storage[..])
  for {
    line := bufio.read_line(&reader) catch err {
      io.eprintln("calc: {}", err)
      return
    }
    if reader.ended { return }
    if strings.trim(line).len == 0 { continue }
    io.println("> {}", line)

    // Everything a line puts in frame is gone at the end of the iteration.
    defer mem.arena_reset(frame)
    statement := parse_line(frame, line) catch err {
      point_at(syntax_offset(err), syntax_text(err))
      continue
    }
    value := evaluate(statement.value, &names)
    if value.problem != Problem.None {
      point_at(value.offset, problem_text(value.problem))
    } else if statement.name.len > 0 {
      // The name points into the reader's storage. Copy it before keeping it.
      name: []const u8 = strings.clone(permanent, statement.name)
      map.insert(&names, name, value.number)
      io.println("{} = {}", statement.name, value.number)
    } else {
      io.println("{}", value.number)
    }
  }
}
