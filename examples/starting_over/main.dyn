void primitive() {
  i8 signed_short_short_int;
  i16 signed_short_int;
  i32 signed_int;
  i64 signed_long_int;
  i128 signed_long_long_int;

  u8 unsigned_short_short_int;
  u16 unsigned_short_int;
  u32 unsigned_int;
  u64 unsigned_long_int;
  u128 unsigned_long_long_int;

  f32 single_float;
  f64 double_float;

  char character;

  bool boolean;
}
void string() { // fill this out
  // strings are collections of characters represented as a vector in a wrapper
  // strings follow the same rules as variables above, strings just provide a convenient wrapper over whats actually happening
}
void array() { // rework this
  // arrays are collections of similarly typed elements
  i32[] nums = [1,2,3,4];
  mut i32[] nums2 = [5,6,7,8];
  io.println(nums.concat(nums2));
  io.println(nums.len());
  io.println(nums[0]);
}
void tuple() {
  // tuples are ordered collections of different types of data (all unnamed)
  (i32, bool, char) items = (1,true,'a');
  mut (i32, bool, char) mutable_items = (2,false,'b'); // all items mutable
  (mut i32, bool, mut char) conditional_mut = (3,true,'c'); // only the i32 and char are mutable
  mutable_items.2 = 'd'; // valid
  // conditional_mut.1 = false; - not valid
}
