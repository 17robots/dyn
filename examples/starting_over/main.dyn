void structs() {
  // example struct
  struct Animal {
    u16 age;
    f32 weight;
  }
  func Animal {
    // general functions for Animal
    void something_animals_can_do(self) {}

    Animal new() {} // no self means abstract method
    Living { // implement traits in the func block
      void speak(self) {
        io.println("I am an animal");
      }
    }
  }

  // traits
  trait Living {
    void breathe(self) { io.println("Breathing"); }
    void eat(self) { io.println("Eating"); }
    void speak(self);
  }

  // composition
  enum DogKind {
    CHIHUAHUA,
    CORGI,
    GERMAN_SHEPHARD,
    GREYHOUND,
  }
  struct Dog {
    Animal animal;
    bool collared;
    DogKind kind;
  }

  func Dog {
    Living { // implement traits in the func block
      void speak(self) {
        io.println("I am a dog");
      }
    }
  }

  enum CatKind {
    SIAMESE,
    MAINECOONE,
    TUXEDO,
    ORANGE,
  }
  struct Cat {
    Animal animal;
    CatKind kind;
    bool indoor;
  }
  func Cat {
    Living { // implement traits in the func block
      void speak(self) {
        io.println("I am a cat");
      }
    }
  }

  void speak_things(Living thing) { // anything that uses the Living trait can be used here
    thing.speak();
  }
  speak_things(Dog { kind: .CHIHUAHUA, collared: true, animal: Animal { age: 3, weight: 102.4 }});
  speak_things(Cat { kind: .SIAMESE, indoor: true, animal: Animal { age: 5, weight: 35.2 }});

  // anonymous structs
  enum FishKind {
    BETA,
    GOLDFISH,
    BASS,
  }
  speak_things(
    struct {
      Animal animal = Animal {};
      FishKind kind = .BASS;
      bool owned = false;
      func { // func can also be inlined in the struct definition as well
        Living {
          void speak(self) {
            io.println("I am a fish");
          }
        }
      }
    });

  // structs in functions
  trait Shape {
    f32 area(self);
    f32 perimeter(self);
  }

  struct Circle {
    f32 radius;
    func {
      Circle new(f32 r) => Circle { radius: r };
      Shape {
        f32 area(self) {
          return Math.PI * self.radius * self.radius;
        }
        f32 perimeter(self) {
          return Math.PI * self.radius * 2;
        }
      }
    }
  }
  struct Triangle {
    f32 base, height;
    func {
      Triangle new(f32 b, Optional<f32> h) => Triangle { base: b, height: match height {
        .Some(val): val,
        None: base,
      }};
      Shape {
        f32 area(self) => .5 * base * height;
        f32 perimeter(self) => 0.0;
      }
    }
  }
  struct Rectangle {
    f32 length,width;
    func {
      Rectangle new(f32 l, Optional<f32> w) => Rectangle { length: l, width: match w {
        .Some(val): val,
        .None: l,
      };}
      Shape {
        f32 area(self) => length * width;
        f32 perimeter(self) => (2 * length) + (2 * width);
      }
    }
  }
  enum ShapeType {
    CIRCLE,
    TRIANGLE,
    RECTANGLE,
  }
  Shape factory(ShapeType type, f32 base, Optional<f32> height) => match type {
    .Circle: Circle.new(base),
    .TRIANGLE: Triangle.new(base, height),
    .RECTANGLE: Rectangle.new(base, height),
  };
} // work on this more

void struct_rework() {
  struct AStruct {
    i32 something, something2;
    AStruct new(i32 x, i32 y) => AStruct { something = x, something2 = y };
    void some_fn(self) {
      io.println(self.something, self.something2);
    }
  }
  trait ATrait {
    void we() {}
    void do();
    void things();
  }
}

