}
void array() { // rework this
  // arrays are collections of similarly typed elements
  i32[] nums = [1,2,3,4];
  mut i32[] nums2 = [5,6,7,8];
  io.println(nums.concat(nums2));
  io.println(nums.len());
  io.println(nums[0]);
}
void tuple() {
  // tuples are ordered collections of different types of data (all unnamed)
  (i32, bool, char) items = (1,true,'a');
  mut (i32, bool, char) mutable_items = (2,false,'b'); // all items mutable
  (mut i32, bool, mut char) conditional_mut = (3,true,'c'); // only the i32 and char are mutable
  mutable_items.2 = 'd'; // valid
  // conditional_mut.1 = false; - not valid
}

void statements() {
  if_statement();
  match_statement();
  for_statement();
}
void if_statement() {
  // if [boolean] { do stuff }
  if true {
    io.println("We did stuff");
  }
  if false {

  } else {
    io.println("We did something else");
  }
  if 1 == 2 {}
  else if 1 == 3 {}
  else io.println("math is not broken"); // if single line, no {} needed

  if i32 x = 5; x > 4 {} // assign var and then check if
}
void match_statement() { // flesh this out based on other stuff
  // match uses pattern matching to compare cases of a variable

  i32 num = 10;
  match num {
    1: {io.println("something");},
    2: io.println("look ma no {}");,
    3: {
      // we do some more stuff here
      io.println("Do thing 1");
      io.println("Do thing 2");
    },
    10: {io.println("this one will run");},
    _: {}, // used to catch all other cases - default
  }

  i32 other_result = match num {
    1: 5,
    10: 10,
    100: 20,
    _: -1
  }; // used to assign var but needs to all return same type
  match num {
    1 | 2 | 3 | 4 | 5 | 6 | 8 | 9: {}, // or range 
    10..20: {}, // standard range
    _: {}
  }
}
void for_statement() {
  for u32 i = 0; i < 10; i++ {} // standard for loop
  for {} // infinite loop
  while i32 condition = 0; condition > 5 {} // while
  i32[] items = [1,2,3,4];
  for i32 i : items {} // for loop in array
  string name = "bobby";
  for char i : name.chars() {} // loop chars 
}

void functions() {
  // [return type] [name]([...params]) {}
  i32 x() {} // basic fn
  const i32() y = x; // secondary way to define them
  i32 z(i32 x,y) {} // params with similar types
  void a(i32 x, i32 y, mut resuslt) {} // mutable args
  i32[] map(i32[] arr, i32() fn) {} // passing fns as params
  i32() functor(i32 val) {} // return a fn
  i32 sum(i32 x,y) => x + y; // arrow functions for immediate returns
  i32 mult(i32 x,y) => x * y; // arrow functions for immediate returns
}

