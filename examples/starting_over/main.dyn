void structs() {
  trait ATrait {
    void we() {} // default implementation
    void do();
    void things();
  }
  #[use(Print, Clone)]
  struct AStruct : ATrait {
    i32 something, something2;
    void something(self) {}
    AStruct new(i32 something, something2) => AStruct { something, something2 };
    do() {}
    things() {}
  }

  // animal example
  trait Living {
    void speak();
  }
  struct Cat : Living {
    void speak() {
      io.println("meow");
    }
  }
  struct Dog : Living {
    void speak() {
      io.println("woof");
    }
  }
  struct Bird : Living {
    void speak() {
      io.println("chirp");
    }
  }
  void livingSpeak(Living &l) {
    l.speak();
  }

  // shape example
  trait Shape {
    f64 area(self);
  }
  struct Triangle : Shape {
    f32 base, height;
    f32 area(self) => (1/2) * base * height;
  }
  struct Circle : Shape {
    f32 radius;
    f32 area(self) => math.PI * radius * radius;
  }
  struct Rectangle : Shape {
    f32 length, width;
    f32 area(self) => length * width;
  }
  void printArea(Shape &s) {
    io.println(s.area());
  }
  printArea(&Rectangle { length: 2, height: 5 });
  printArea(&Circle { radius: 2 });
  printArea(&Triangle { base: 2, height: 5 });
  printArea(&struct : Shape { // anon struct
    f32 area() => 100.;
  });

  // no direct inheritence, need to use composition
  struct InheritMe {
    i32 else; // will inherit all members, no such thing as private
    // heres a new fn that doesnt rely on self
    InheritMe new() => InheritMe{}; // doesnt get inherited
    void do_something(self) {} // this one gets inherited 
    void override_behavior() {} // all fns in a struct need to be defined and have a body, to share other behavior use a trait
  }
  struct WillInherit {
    InheritMe; // will only inherit the self methods from the struct
    i32 something;
    void override_behavior(self) {
      io.println(self.something);
    }
  }
}

