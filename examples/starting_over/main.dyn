}
void type_alias() {
  // type [name] = [definition]
  type sortingFn = bool(i32,i32); // uses fn type
  void sort(i32[] x, sortingFn fn) {} // used in place of fn to improve readability

  type Pair = (i32,i32);
  Pair x = (1,2);

  type newInt = i32;
  newInt y = 3;
  io.println(y);
}
void enum() {
  enum Weekdays {
    MONDAY,
    TUESDAY = 3,
    WEDNESDAY = 10,
    THURSDAY,
    FRIDAY,
    SATURDAY,
    SUNDAY,
  }
  Weekdays mon = .MONDAY; // shorthand when working with vars of that enum type

  enum Partnered {
    Event1(string),
    Event2(i32,i32),
    Event3(string,boolean,string),
    Event4,
  }

  Partnered my_partner = .Event1("test");

  match my_partner {
    Event1(x): {},
    Event2(x,_): {}, // or Event2(x,..)
    Event3(_,x,..): {},
    Event4: {},
  }

  match my_partner { // again
    Event1(x): {},
    _: {}, // so we dont need to have all of the variants
  }

  Partnered x() => .Event1("Event");

  if Partnered.Event1(y) = x() {
    io.println(y); // templating like in match
  } else {} // optional in case

  while Partnered.Event2(x,y) = x() {}
}
void union() { // flesh this out more
  i32|f32 divide(i32|f32 x, i32|f32 y) => x / y;

  i32 x = divide(2,1);
  f32 y = divide(1,2);
  mut i32|f32 z; // i32|f32
  i32|f32 z = divide(1,4); // takes on result of operation - f32
  io.println(z); // f32

  type Imprecise = i32|f32;

  Imprecise a = divide(3,1); 
}
