void variables() {
  i32 normal_variable = example + 1; // immutable by default
  i32 uninitialized;
  uninitialized = 4; // can be done
  mut i32 example = 1 + 2;
  con i32 DRINKING_AGE = 3.14;
  // const variables can be assigned once but not updated and can be calculated at runtime
  // static variables can be assigned once but not updated and needs to be calculated at compile time
}
