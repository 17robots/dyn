import { io } from "std";

pub void functions() {
    // function syntax <type> <name>(<args>) { <stuff> }
    i32 local, state = 0;
    mut i32 result;
    void internal_fn() {
        // we can access local state here
        io.println(local, state);
        do_something();
        io.println(some_number());
        io.println(some_number_2());
        io.println(some_math(1,2));
        io.println(some_more_math(1,2));
        io.println(math_with_references(&local,&state)); // only works with vars that can be referenced
        manipulate_numbers(&mut result, &local, &state);
    }
    internal_fn();
    io.println(result); // gets set with the manipulate_numnbers fn

    // fns can also return any type including user-defined types
}

void do_something() {
    io.println("This function doesnt return anything");
}

i32 some_number() {
    return 100;
}

i32 some_number_2() => 100; // other way to return one liners
i32 some_math(i32 x, i32 y) => x + y;
i32 some_more_math(i32 x, y) => x * y; // can omit if same type
i32 math_with_references(&i32 x, y) => x * y; // pass by reference instead of copy, this is preferred instead of pointers
i32 math_with_pointers(*i32 x, y) => *x * *y; // pass by pointers instead of copy, this is preferred instead of pointers

void manipulate_numbers(&mut i32 result, i32 x, y) { // can pass by mutable ref to manipulate params
    result = x + y; 
}

// fns can also return pointers, but cannot return references as the references would be lost after fn scope
