type Animal {
	required bool dead, // tells the compiler the item needs to be included in the types definition, this extends to all types that extend this one
	readonly bool cool, // tells the compiler the item can only be set once and cannot be changed
	bool notcool: !cool, // when defining props that are based off other props, the item can still be modified like the other types
	hidden char* firstName, // tells the compiler people cannot access this directly
	hidden char* lastName,
	char* fullName: firstName + lastName, // can access hidden properties in other properties
	void setfirstName(char* name): () { self.firstName = name }, // can access in setter fns
	char* getLastName(): () { return self.lastName; } // all default definition fns have an implied self in them
}

// since types can be compoundly built, types can be broken up and defined to make things cleaner if the types get too large
type ReallyLargeType {
	i32 item1,
	i32 item2,
	i32 item3,
	i32 item4,
	i32 item5,
	i32 item6,
	i32 item7,
	i32 item8,
	i32 item9,
	i32 item10,
	i32 item11,
	i32 item12,
	i32 item13,
	i32 item14,
	i32 item15,
	i32 item16,
	i32 item17,
	i32 item18,
	i32 item19,
	i32 item20,
}

typeReallyLargeType {
	void fn1(),
	void fn2(),
	void fn3(),
	void fn4(),
	void fn5(),
	void fn6(),
	void fn7(),
	void fn8(),
	void fn9(),
	void fn10(),
}

type ReallyLargeType {

}

// to make things even cleaner though you can do something like this
type ReallyLargeVars {
	// all vars and modifiers
}

type ReallyLargeNonDefaultMethods {
	// method headers
}

type ReallyLargeDefinedFns {
	// default fns
}

type MyReallyLargeType: ReallyLargeVars & ReallyLargeNonDefaultMethods & ReallyLargeDefinedFns;

// when defining types that have readonly types, those get copied over exactly as modified, so to override, you can extend and add a manual definition
type Pig: Animal {
	char* firstName, // unhides first name only on Pig
	bool dead: false, // makes it not required, and sets a default val
	hidden bool notcool, // hides given val from Animal
}

// to extend, use :  and the super class name
type Dog: Animal {
	// other props here
}

// interfaces reserved for groupings of fns
type Alive {
	int age: 0, // default an arg in a type
	char* name, // this will need to be set later
	void eat(): () { io::println("Im eating"); },
	void sleep(): () { io::println("Im sleeping"); }
	void speak(), // no default behavior
	void other(): otherFn, // other fns can be used as behavior here
}

// needs to match the parameters of the fn definition in order to work
void otherFn() {

}

// to implement an interface, just extend and implement all the ones you want to override
// redeclaring a type will add on to the types that the interface inherits from
type Dog: Alive {

}

// this could also have been done above since order doesnt matter
// you can initialize multiple inheritences with one type definition
type Cat: Animal & Alive {

}

// meta arguments can be created with the metaprogramming to make those lists a lot easier to manage

type SuperCoolItem: Animal & Alive; // doesnt need body

type Fish: SuperCoolItem { // makes managing multiple pieces of inheritence easier and less verbose

}

// fns can be written that take any of the types as args

void speak(Alive animal) {
	animal.speak(); // calls the animal that was passed in's speak fn
}

// if the animal doesnt have a speak fn defined, including a default, the fn will error. The fns only have access to the listed param type's attributes
// that means that this isnt possible
void make_animal_speak(Animal a) {
	a.speak(); // this would only work if the animal extended the alive interface
}

// this is valid though
void make_animal_speak(Cat a) {
	a.speak(); // this does work since the type does have this in its context
}

void main() {
	Cat mine = Cat();

	mine.speak(); // valid

	speak(mine); // valid

	make_animal_speak(mine); // even though the Cat has the speak fn, this still would not be valid since the base type doesnt have the required fn

	// there are several ways to define an object
	Dog x = Dog(); // only assigns default vals, others left as junk, will not work if there are required vars without defaults
	x.y = 3; // can set the pieces individually

	Dog y = { x: 5, y: 2, z: 'c' }; // used to set different params, setting defaults will override them

	Dog z = y; // direct assignment but will change both if one is changed: tangles them together

	Dog a = ...z; // destructure the objects into copies and put them into a, this can also be surrounded by {}

	// you can destructure objects like so
	Dog { int x, int y } = y; // to get x and y from Dog y;

	Dog b { ...a, z: 'd' }; // this takes all from a and overrides the z attirbute
}

// types can also be an alias to other types
type x = (i32, i64, i128)

// ENUMS ARE ALSO A THING HOLD ON
enum Directions {
	North,
	South,
	East,
	West
}

// by default enums are stored as bits based on the options available and can be masked

// however enums can be expanded to provide more functionality

enum EventType {
	MouseMoved(i32 x, i32 y),
	ScreenClicked(i32 x, i32 y),
	MessageSent(char* message),
	MessageReceived(char* message)
}

// switches can be done on enums
void enumSwitch(EventType e) {
	switch(e) {
		MouseMoved => io::println(e.x, e.y),
		MessageSent => io::println(e.message),
		_ => io::println("Event Type Not Supported Yet"),
	}
}

// these can also be extended with different types as well too

type MouseEvent = EventType::MouseMoved | EventType::ScreenClicked;

// so now rather than needing to check for different things you can simplify the workload by using specific types (the above makes it easier to manage the differences of types but it would be the same as the following)
void handleMouseEvent(EventType::MouseMoved | EventType::ScreenClicked e) { // do stuff }
void handleMouseEvent(MouseEvent e) { // do stuff } // this also means the switch statements wont have to be as large either

