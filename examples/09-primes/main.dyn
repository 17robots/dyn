// primes: count the primes below a limit on several threads.
//
//   primes [LIMIT] [WORKERS]
//
// The numbers are cut into blocks. Each worker takes the next block from a
// shared atomic counter until none are left, so a fast worker simply takes
// more blocks. Each worker counts into its own struct; the only value the
// threads share is that counter.
//
// Run: dyn run examples/09-primes --release -- 10000000 8

use "std/io"
use "std/math"
use "std/mem"
use "std/parse"
use "std/process"
use "std/sync"
use "std/thread"

const MaxWorkers: usize = 64
const BlockSize: u64 = 10000

// What every worker shares. Atomic operations make each fetch_add one
// indivisible step, so no two workers ever get the same block.
struct Shared {
  next_block: sync.AtomicU64,
  limit: u64,
}

// One worker's own state. Only its thread touches it until join returns.
struct Worker {
  shared: *Shared,
  primes: u64,
  largest: u64,
  blocks: u64,
}

fn is_prime(n: u64) bool {
  if n < 4 { return n >= 2 }
  if n % 2 == 0 || n % 3 == 0 { return false }
  // Every prime above 3 is 6k - 1 or 6k + 1.
  d: u64 = 5
  for d * d <= n {
    if n % d == 0 || n % (d + 2) == 0 { return false }
    d += 6
  }
  return true
}

// A thread's entry point takes a pointer to its context, typed: thread.spawn
// infers C from the function and checks that the context is a *C.
fn work(w: *Worker) isize {
  limit := w.shared.limit
  for {
    block := sync.fetch_add_u64(&w.shared.next_block, 1)
    start := block * BlockSize
    if start >= limit { break }
    end := math.min(start + BlockSize, limit)
    for n in start..end {
      if is_prime(n) {
        w.primes += 1
        w.largest = n
      }
    }
    w.blocks += 1
  }
  return 0
}

fn argument(args: [][]const u8, index: usize, fallback: u64) u64 {
  if index >= args.len { return fallback }
  value := parse.u64_decimal(args[index]) catch {
    io.eprintln("primes: {} is not a number", args[index])
    return fallback
  }
  return value
}

fn main() i32 {
  program := process.start()
  limit := argument(program.args, 1, 1000000)
  wanted := argument(program.args, 2, thread.cpu_count())
  count := MaxWorkers
  if wanted < MaxWorkers {
    count = math.max(#cast(usize, wanted), 1)
  }

  shared := Shared{ limit: limit }
  // The workers live in main's frame, which outlives every thread: main
  // joins them all before it returns. Each thread gets its own stack.
  workers: [MaxWorkers]Worker
  threads: [MaxWorkers]*thread.Thread
  // A thread that cannot start or join ends the program.
  for i in 0..count {
    workers[i].shared = &shared
    threads[i] = thread.spawn_with_size(program.arena, 256 * mem.KiB, work, &workers[i]) catch {
      #panic("cannot start a worker thread")
    }
  }

  total: u64 = 0
  largest: u64 = 0
  for i in 0..count {
    thread.join(threads[i]) catch {
      #panic("cannot join a worker thread")
    }
    // After join, the worker's thread is done: reading its struct is safe.
    total += workers[i].primes
    largest = math.max(largest, workers[i].largest)
    io.eprintln("worker {}: {} blocks, {} primes", i + 1, workers[i].blocks, workers[i].primes)
  }
  io.println("{} primes below {}; the largest is {}", total, limit, largest)
  return 0
}
