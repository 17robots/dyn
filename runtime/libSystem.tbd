--- !tapi-tbd
# Dyn runtime libSystem ABI surface; declarative link metadata, not an Apple SDK.
tbd-version: 4
targets: [ arm64-macos ]
install-name: '/usr/lib/libSystem.B.dylib'
current-version: 1.0.0
compatibility-version: 1.0.0
exports:
  - targets: [ arm64-macos ]
    symbols: [ ___error, _clock_gettime, _nanosleep, __NSGetArgc, __NSGetArgv,
               _fork, _chdir, _pipe, _fcntl, _dup2, _execve, __exit, _waitpid, _kill,
               _read, _write, _close, _getenv, _strlen, _pthread_self, _pthread_attr_init, _pthread_attr_setstacksize,
               _pthread_attr_destroy, _pthread_create, _pthread_join,
               _pthread_mach_thread_np, _sched_yield, _dlopen, _dlsym, _dlclose,
               _dispatch_queue_create, _dispatch_sync_f, _dispatch_release, _os_sync_wait_on_address,
               _os_sync_wake_by_address_any, _os_sync_wake_by_address_all,
               _os_unfair_lock_lock, _os_unfair_lock_trylock, _os_unfair_lock_unlock, _getentropy ]
...
