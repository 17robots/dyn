// name is "function (path:line)" for the function's first line. line is the
// line the frame is running, stored by the compiled code at each statement.
struct Frame { name: *const u8, length: u32, line: u32 }
struct TraceSlot { tid: u64, count: u64, frames: [64]Frame }
// Debug builds trace calls; release builds never call trace_push, so they
// reserve nothing. Chunks come from the platform on first use and are reused.
struct TraceChunk { next: u64, slots: [trace_chunk_slots]TraceSlot }
trace_first: u64
fn trace_chunk(address: u64) *TraceChunk {
  return #cast(*TraceChunk, #cast(usize, address))
}
fn trace_grow() bool {
  fresh := runtime_pages(#cast(u64, #sizeof(TraceChunk)))
  if fresh == 0 {
    return false
  }
  link := &trace_first
  for true {
    if atomic_claim(link, 0, fresh) {
      return true
    }
    link = &trace_chunk(atomic_load(link)).next
  }
  return false
}
fn trace_slot(id: u64, claim: bool) *TraceSlot {
  for true {
    chunk := atomic_load(&trace_first)
    for chunk != 0 {
      for i in 0..trace_chunk_slots {
        slot := &trace_chunk(chunk).slots[i]
        seen := atomic_load(&slot.tid)
        if seen == id {
          return slot
        }
        if claim && seen == 0 && atomic_claim(&slot.tid, 0, id) {
          trace_thread_started()
          return slot
        }
      }
      chunk = atomic_load(&trace_chunk(chunk).next)
    }
    if !claim || !trace_grow() {
      return nil
    }
  }
  return nil
}
// Frames past the 64th, and threads without a slot, write their lines here.
trace_spare_line: u32
// Returns where the caller stores the line it is running.
fn trace_push(name: *const u8, length: u64) *u32 {
  slot := trace_slot(thread_id(), true)
  if slot == nil {
    return &trace_spare_line
  }
  line := &trace_spare_line
  if slot.count < 64 {
    frame := &slot.frames[slot.count]
    frame.name = name
    frame.length = #cast(u32, length)
    frame.line = 0
    line = &frame.line
  }
  slot.count += 1
  return line
}
fn trace_pop() {
  slot := trace_slot(thread_id(), false)
  if slot != nil && slot.count != 0 {
    slot.count -= 1
    if slot.count == 0 {
      atomic_store(&slot.tid, 0)
    }
  }
}
fn write_string(text: []const u8) {
  trace_write(&text[0], #cast(u64, #len(text)))
}
fn trace_dump() {
  slot := trace_slot(thread_id(), false)
  if slot == nil || slot.count == 0 {
    return
  }
  write_string("stack trace:\n")
  count := slot.count
  if count > 64 {
    count = 64
  }
  for count != 0 {
    count -= 1
    frame := &slot.frames[count]
    write_string("  at ")
    write_frame(frame)
    write_string("\n")
  }
}
// "function (path:line)", with the line the frame was running in place of
// the function's first line when one was stored.
fn write_frame(frame: *Frame) {
  length := #cast(u64, frame.length)
  name := #slice(frame.name, #cast(usize, length))
  colon := length
  for i in #reverse(0..#len(name)) {
    if name[i] == ':' {
      colon = #cast(u64, i)
      break
    }
  }
  if frame.line == 0 || colon == length {
    trace_write(frame.name, length)
    return
  }
  trace_write(frame.name, colon + 1)
  digits: [10]u8 = []
  at: usize = 10
  value := frame.line
  for value != 0 {
    at -= 1
    digits[at] = #cast(u8, value % 10) + '0'
    value /= 10
  }
  trace_write(&digits[at], #cast(u64, 10 - at))
  write_string(")")
}
