#target(kernel: darwin)
// This target retains thread lookup when unlinking an unwind frame.
fn unwind_owner_offset() usize {
  return 0
}
extern fn pthread_self "pthread_self"() rawptr
extern fn syscall_raw "dyn_syscall6"(n: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) i64
// Runtime slot chunks: 64 threads per chunk, more chunks on demand.
const unwind_chunk_slots: usize = 64
const unwind_hint_count: usize = 64
// Private anonymous read-write pages through the mmap syscall; zero on failure.
fn runtime_pages(bytes: u64) u64 {
  address := syscall_raw(197, 0, #cast(i64, bytes), 3, 4098, -1, 0)
  if address <= 0 {
    return 0
  }
  return #cast(u64, address)
}
fn thread_id() u64 {
  return #cast(u64, #cast(usize, pthread_self()))
}
fn trace_write(data: *const u8, size: u64) {
  if size == 0 {
    return
  }
  bytes := #slice(data, #cast(usize, size))
  offset: usize = 0
  for offset < #len(bytes) {
    written := syscall_raw(4, 2, #cast(i64, #cast(usize, &bytes[offset])), #cast(i64, (#len(bytes) - offset)), 0, 0, 0)
    if written <= 0 {
      return
    }
    offset += #cast(usize, written)
  }
}
// Resumes unwinding after a frame's cleanup has run.
pub fn dyn_unwind_continue() {
  slot := unwind_slot(false)
  if slot != nil && slot.top != nil {
    frame := slot.top
    slot.top = frame.previous
    jump(frame)
  }
  if slot != nil {
    panic_raw(slot.message, slot.length)
  }
  panic_raw(nil, 0)
}
// Debug programs report a memory fault like a panic. The handler runs on its
// own stack, so a stack overflow reports too, and never returns.
struct SignalAction { handler: usize, mask: u32, flags: i32 }
struct SignalStack { base: usize, size: usize, flags: i32 }
extern fn signal_action "sigaction"(signal: i32, action: *const SignalAction, previous: rawptr) i32
extern fn signal_stack "sigaltstack"(stack: *const SignalStack, previous: rawptr) i32
extern fn exit_now "_exit"(code: i32)
const fault_stack_size: u64 = 65536
const signal_on_stack: i32 = 1
const signal_information: i32 = 0x40
const signal_bus: i32 = 10
const signal_segv: i32 = 11
// The ucontext points at the machine context, which holds the faulting
// instruction and frame pointer (fault_pc and fault_fp, per architecture).
fn fault_handler(signal: i32, information: rawptr, context: rawptr) {
  _ = signal
  _ = information
  write_string("memory fault: invalid address\n")
  machine := #cast(*const usize, #cast(usize, context) + 48).*
  trace_fault(fault_pc(machine), fault_fp(machine))
  exit_now(101)
}
fn trace_thread_started() {
  base := runtime_pages(fault_stack_size)
  if base == 0 {
    return
  }
  stack := SignalStack{ base: #cast(usize, base), size: #cast(usize, fault_stack_size) }
  _ = signal_stack(&stack, nil)
  action := SignalAction{ handler: #cast(usize, #cast(rawptr, fault_handler)), flags: signal_on_stack | signal_information }
  _ = signal_action(signal_segv, &action, nil)
  _ = signal_action(signal_bus, &action, nil)
}
