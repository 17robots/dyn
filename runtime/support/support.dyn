// Freestanding runtime compiled by Dyn's independent backend.
// No std imports, allocations, defer, or tracing may be introduced here.
// A thread's slot: trace holds the frames of its panic (see trace_walk).
struct UnwindSlot {
  tid: u64, trace_total: u64, trace: [trace_frames]usize
}
// Slots live in chunks obtained from the platform on first use, so programs
// that never register a cleanup frame reserve nothing. Chunks are never
// returned: a finished thread's slot is reused by the next thread. Links are
// addresses stored as u64 so the 64-bit atomics serve every target.
struct UnwindChunk { next: u64, slots: [unwind_chunk_slots]UnwindSlot }
unwind_first: u64
// A hint is one atomic word: the full eligible thread identity and slot index
// in the first chunk. Collisions only discard hints. The owning thread is the
// only writer of a hint with its identity, so a matching hint names its latest
// known slot. Always validate/claim the slot atomically; never retain slot
// ownership here. Large opaque identities use the complete search.
unwind_hints: [unwind_hint_count]u64
fn unwind_remember(tid: u64, index: usize) {
  if tid != 0 && tid >> 58 == 0 && index < 64 {
    atomic_store(&unwind_hints[#cast(usize, tid % unwind_hint_count)], (tid << 6) | index)
  }
}
extern fn atomic_load "dyn_atomic_load_u64"(p: *const u64) u64
extern fn atomic_store "dyn_atomic_store_u64"(p: *u64, value: u64)
extern fn atomic_claim "dyn_atomic_compare_exchange_u64"(p: *u64, expected: u64, desired: u64) bool
extern fn panic_raw "dyn_panic"(message: *const u8, length: u64)

fn chunk_at(address: u64) *UnwindChunk {
  return #cast(*UnwindChunk, #cast(usize, address))
}

// Appends a fresh chunk after the last one. A thread that loses the race
// keeps searching; its chunk is released to the platform.
fn unwind_grow() bool {
  bytes := #cast(u64, #sizeof(UnwindChunk))
  fresh := runtime_pages(bytes)
  if fresh == 0 { return false }
  link := &unwind_first
  for true {
    if atomic_claim(link, 0, fresh) { return true }
    link = &chunk_at(atomic_load(link)).next
  }
  return false
}

fn unwind_slot(claim: bool) *UnwindSlot {
  tid := thread_id()
  first := atomic_load(&unwind_first)
  if first == 0 {
    if !claim || !unwind_grow() { return nil }
    first = atomic_load(&unwind_first)
  }
  head := chunk_at(first)
  // Nested cleanup on the first owner already needs only one atomic read.
  // Keep that path ahead of the hint, which benefits empty-stack registration.
  first_seen := atomic_load(&head.slots[0].tid)
  if first_seen == tid { return &head.slots[0] }
  if tid != 0 && tid >> 58 == 0 {
    hint := atomic_load(&unwind_hints[#cast(usize, tid % unwind_hint_count)])
    index := #cast(usize, hint & 63)
    if hint >> 6 == tid && index < unwind_chunk_slots {
      candidate := &head.slots[index]
      seen := first_seen
      if index != 0 {
        seen = atomic_load(&candidate.tid)
      }
      if seen == tid { return candidate }
      if claim && seen == 0 && atomic_claim(&candidate.tid, 0, tid) { return candidate }
    }
  }
  for true {
    empty: *UnwindSlot = nil
    empty_index: usize = 0
    // Find an existing owner before claiming a vacancy. A lower slot may
    // have become empty while this thread still owns a higher slot.
    chunk := first
    base: usize = 0
    for chunk != 0 {
      for i in 0..unwind_chunk_slots {
        slot := &chunk_at(chunk).slots[i]
        seen := atomic_load(&slot.tid)
        if seen == tid {
          unwind_remember(tid, base + i)
          return slot
        }
        if seen == 0 && empty == nil {
          empty = slot
          empty_index = base + i
        }
      }
      chunk = atomic_load(&chunk_at(chunk).next)
      base += unwind_chunk_slots
    }
    if !claim { return nil }
    if empty == nil {
      if !unwind_grow() { return nil }
    } else if atomic_claim(&empty.tid, 0, tid) {
      unwind_remember(tid, empty_index)
      return empty
    }
    // Another thread won the vacancy, or a chunk was added; search again.
  }
  return nil
}
// The process panic hook, set through std/process.on_panic. It runs once,
// after cleanups, right before an unhandled panic reports and exits.
panic_hook: fn(*const u8, u64)
pub fn dyn_set_panic_hook(hook: fn(*const u8, u64)) {
  panic_hook = hook
}
// Replaces the panic hook and returns the one it replaced. std/fiber uses it
// to catch panics inside isolated fibers.
pub fn dyn_swap_panic_hook(hook: fn(*const u8, u64)) fn(*const u8, u64) {
  previous := panic_hook
  panic_hook = hook
  return previous
}
fn run_panic_hook(message: *const u8, length: u64) {
  hook := panic_hook
  if hook != nil {
    panic_hook = nil
    hook(message, length)
  }
}
// A panic does not run defers: it runs the handler set with
// panic.set_handler and returns, and dyn_panic reports and exits.
pub fn dyn_unwind_begin(message: *const u8, length: u64) {
  run_panic_hook(message, length)
}
fn check_name(kind: u64) []const u8 {
  case kind {
    0 => {
      return "overflow.ok"
    }
    1 => {
      return "divide.ok"
    }
    2 => {
      return "division.overflow.ok"
    }
    3 => {
      return "shift.count.ok"
    }
    4 => {
      return "function.nonnull.ok"
    }
    5 => {
      return "pointer.nonnull.ok"
    }
    6 => {
      return "pointer.aligned.ok"
    }
    7 => {
      return "index.ok"
    }
    8 => {
      return "slice.order.ok"
    }
    9 => {
      return "slice.bounds.ok"
    }
    10 => {
      return "enum.cast.ok"
    }
    11 => {
      return "enum.tag.ok"
    }
    _ => {
      return "unknown"
    }
  }
}
fn append_bytes(buffer: []u8, at: u64, text: []const u8) u64 {
  for i in 0..text.len {
    buffer[at + i] = text[i]
  }
  return at + text.len
}
// Failed runtime checks pass the function name and kind << 24 | name length
// rather than a full message, so each function stores its name once. The
// compiler caps names at 800 bytes, so the message always fits.
// Debug builds set bit 23 for an index check and pass the index and the
// length it had to be below.
pub fn dyn_check_failed(name: *const u8, packed_value: u64, index: u64, limit: u64) {
  length := packed_value & 0x7fffff
  storage: [1024]u8
  buffer := storage[..]
  used := append_bytes(buffer, 0, "runtime check failed (")
  used = append_bytes(buffer, used, check_name(packed_value >> 24))
  used = append_bytes(buffer, used, ") in ")
  if length != 0 && length <= 800 {
    used = append_bytes(buffer, used, #slice(name, #cast(usize, length)))
  }
  if (packed_value & 0x800000) != 0 {
    used = append_bytes(buffer, used, ": index ")
    used = append_index(buffer, used, index)
    used = append_bytes(buffer, used, ", length ")
    used = append_index(buffer, used, limit)
  }
  panic_raw(&storage[0], used)
}
// A negative signed index arrives as a huge unsigned one; no real index or
// length reaches 2^63, so the top bit means negative.
fn append_index(buffer: []u8, at: u64, value: u64) u64 {
  used := at
  magnitude := value
  if (value >> 63) != 0 {
    buffer[used] = '-'
    used += 1
    magnitude = 0 - value
  }
  digits: [20]u8
  count: u64 = 0
  for true {
    digits[count] = #cast(u8, magnitude % 10) + '0'
    count += 1
    magnitude /= 10
    if magnitude == 0 { break }
  }
  for count != 0 {
    count -= 1
    buffer[used] = digits[count]
    used += 1
  }
  return used
}

// Exact binary scaling: each subtraction is exact, including subnormals.
pub fn fmod(input: f64, divisor: f64) f64 {
  sign := (#bitcast(u64, input)) & 0x8000000000000000
  x := #bitcast(f64, ((#bitcast(u64, input)) & 0x7fffffffffffffff))
  y := #bitcast(f64, ((#bitcast(u64, divisor)) & 0x7fffffffffffffff))
  if x - x != 0.0 || y != y || y == 0.0 { return (input * divisor) / (input * divisor) }
  scale := y
  for scale <= x * 0.5 {
    scale *= 2.0
  }
  for true {
    if x >= scale {
      x -= scale
    }
    if scale <= y { break }
    scale *= 0.5
  }
  return #bitcast(f64, ((#bitcast(u64, x)) | sign))
}
pub fn fmodf(input: f32, divisor: f32) f32 {
  sign := (#bitcast(u32, input)) & 0x80000000
  x := #bitcast(f32, ((#bitcast(u32, input)) & 0x7fffffff))
  y := #bitcast(f32, ((#bitcast(u32, divisor)) & 0x7fffffff))
  if x - x != 0.0 || y != y || y == 0.0 { return (input * divisor) / (input * divisor) }
  scale := y
  for scale <= x * 0.5 {
    scale *= 2.0
  }
  for true {
    if x >= scale {
      x -= scale
    }
    if scale <= y { break }
    scale *= 0.5
  }
  return #bitcast(f32, ((#bitcast(u32, x)) | sign))
}

// Device register access for std/mmio. This object is compiled apart from the
// program, so a call here is opaque: the optimizer can neither remove, merge
// nor reorder the access across other calls.
pub fn dyn_mmio_load_u8(address: usize) u8 {
  return (#cast(*u8, address)).*
}
pub fn dyn_mmio_load_u16(address: usize) u16 {
  return (#cast(*u16, address)).*
}
pub fn dyn_mmio_load_u32(address: usize) u32 {
  return (#cast(*u32, address)).*
}
pub fn dyn_mmio_load_u64(address: usize) u64 {
  return (#cast(*u64, address)).*
}
pub fn dyn_mmio_store_u8(address: usize, value: u8) {
  (#cast(*u8, address)).* = value
}
pub fn dyn_mmio_store_u16(address: usize, value: u16) {
  (#cast(*u16, address)).* = value
}
pub fn dyn_mmio_store_u32(address: usize, value: u32) {
  (#cast(*u32, address)).* = value
}
pub fn dyn_mmio_store_u64(address: usize, value: u64) {
  (#cast(*u64, address)).* = value
}

// Dynamic data-race detector (--race) and lifetime-check flag (--check-lifetimes).
// Zero pages are allocated unless --race actually executes instrumented accesses.
race_table: u64
race_epoch: u64
lifetime_checks_flag: u64
const race_slots: usize = 65536
const race_table_bytes: u64 = 524288

fn race_ensure_table() u64 {
  tbl := atomic_load(&race_table)
  if tbl != 0 { return tbl }
  pages := runtime_pages(race_table_bytes)
  if pages == 0 { return 0 }
  if atomic_claim(&race_table, 0, pages) { return pages }
  return atomic_load(&race_table)
}

pub fn dyn_race_sync() {
  if atomic_load(&race_table) == 0 { return }
  for true {
    cur := atomic_load(&race_epoch)
    if atomic_claim(&race_epoch, cur, cur + 1) { return }
  }
}

fn race_access(address: u64, size: u64, is_write: u64) {
  if address == 0 || size == 0 { return }
  tbl := race_ensure_table()
  if tbl == 0 { return }
  tid := thread_id() & 0xffff
  if tid == 0 { tid = 1 }
  epoch := atomic_load(&race_epoch) & 0x7fff
  word_addr := address >> 3
  hash := #wrapping(word_addr * 0x9e3779b97f4a7c15)
  slot_idx := #cast(usize, (hash >> 48) & 0xffff)
  tag := (word_addr ^ (word_addr >> 32)) & 0xffffffff
  slots := #slice(#cast(*u64, #cast(usize, tbl)), race_slots)
  slot := &slots[slot_idx]
  prev := atomic_load(slot)
  if prev != 0 {
    prev_tag := prev >> 32
    prev_epoch := (prev >> 17) & 0x7fff
    prev_write := (prev >> 16) & 1
    prev_tid := prev & 0xffff
    if prev_tag == tag && prev_tid != tid && prev_epoch == epoch && (is_write != 0 || prev_write != 0) {
      msg := "WARNING: DATA RACE detected between threads"
      panic_raw(&msg[0], #cast(u64, msg.len))
    }
  }
  entry := (tag << 32) | (epoch << 17) | (is_write << 16) | tid
  atomic_store(slot, entry)
}

pub fn dyn_race_read(address: u64, size: u64) {
  race_access(address, size, 0)
}

pub fn dyn_race_write(address: u64, size: u64) {
  race_access(address, size, 1)
}

pub fn dyn_set_lifetime_checks(enabled: u64) {
  atomic_store(&lifetime_checks_flag, enabled)
}

pub fn dyn_lifetime_checks_enabled() bool {
  return atomic_load(&lifetime_checks_flag) != 0
}
