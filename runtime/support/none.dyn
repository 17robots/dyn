#target(kernel: none)
// This target retains thread lookup when unlinking an unwind frame.
fn unwind_owner_offset() usize {
  return 0
}
// Bare metal: one hart, output through the board console in the start runtime.
extern fn console_write "dyn_console_write"(data: *const u8, size: u64)
// One hart: one unwind slot and one trace slot, in fixed storage.
const unwind_chunk_slots: usize = 1
const unwind_hint_count: usize = 1
const trace_chunk_slots: usize = 1
none_unwind: UnwindChunk
none_trace: TraceChunk
none_unwind_taken: bool
none_trace_taken: bool
fn runtime_pages(bytes: u64) u64 {
  if bytes == #cast(u64, #sizeof(UnwindChunk)) && !none_unwind_taken {
    none_unwind_taken = true
    return #cast(u64, #cast(usize, &none_unwind))
  }
  if bytes == #cast(u64, #sizeof(TraceChunk)) && !none_trace_taken {
    none_trace_taken = true
    return #cast(u64, #cast(usize, &none_trace))
  }
  return 0
}
fn thread_id() u64 {
  return 1
}
fn trace_write(data: *const u8, size: u64) {
  if size != 0 {
    console_write(data, size)
  }
}
pub fn dyn_trace_push(name: *const u8, length: u64) {
  trace_push(name, length)
}
pub fn dyn_trace_pop() {
  trace_pop()
}
pub fn dyn_trace_dump() {
  trace_dump()
}
// Resumes unwinding after a frame's cleanup has run.
pub fn dyn_unwind_continue() {
  slot := unwind_slot(false)
  if slot != nil && slot.top != nil {
    frame := slot.top
    slot.top = frame.previous
    jump(frame)
  }
  if slot != nil {
    panic_raw(slot.message, slot.length)
  }
  panic_raw(nil, 0)
}
