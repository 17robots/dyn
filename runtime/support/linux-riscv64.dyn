#target(kernel: linux, arch: riscv64)
// This target retains thread lookup when unlinking an unwind frame.
fn unwind_owner_offset() usize {
  return 0
}
fn exit_number() i64 {
  return 94
}
fn sigaltstack_number() i64 {
  return 132
}
fn sigaction_number() i64 {
  return 134
}
fn signal_restorer_flag() u64 {
  return 0
}
fn signal_restorer(handler: usize) usize {
  return 0
}
// The faulting instruction and frame pointer (s0) in a signal's ucontext.
fn fault_pc(context: usize) usize {
  return #cast(*const usize, context + 176).*
}
fn fault_fp(context: usize) usize {
  return #cast(*const usize, context + 240).*
}
fn thread_number() i64 {
  return 178
}
fn mmap_number() i64 {
  return 222
}
fn write_number() i64 {
  return 64
}
// Resumes unwinding after a frame's cleanup has run.
pub fn dyn_unwind_continue() {
  slot := unwind_slot(false)
  if slot != nil && slot.top != nil {
    frame := slot.top
    slot.top = frame.previous
    jump(frame)
  }
  if slot != nil {
    panic_raw(slot.message, slot.length)
  }
  panic_raw(nil, 0)
}
