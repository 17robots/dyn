#target(kernel: linux, arch: x86_64)
// Linux x64 saves registers through byte 71 in a 128-byte context.
fn unwind_owner_offset() usize {
  return 72
}
fn exit_number() i64 {
  return 231
}
fn sigaltstack_number() i64 {
  return 131
}
fn sigaction_number() i64 {
  return 13
}
fn signal_restorer_flag() u64 {
  return 0x04000000
}
fn signal_restorer(handler: usize) usize {
  return handler
}
// The faulting instruction and frame pointer in a signal's ucontext.
fn fault_pc(context: usize) usize {
  return #cast(*const usize, context + 168).*
}
fn fault_fp(context: usize) usize {
  return #cast(*const usize, context + 120).*
}
fn thread_number() i64 {
  return 186
}
fn mmap_number() i64 {
  return 9
}
fn write_number() i64 {
  return 1
}

// Registers dyn_panic captures from its caller; the trace starts there.
struct UnwindState {
  previous: *Unwind, rbx: u64, rbp: u64, r12: u64, r13: u64, r14: u64, r15: u64, rsp: u64, rip: u64
}
// A panic does not run defers: it records the trace, runs the handler set
// with panic.set_handler, and returns so dyn_panic reports and exits.
pub fn dyn_unwind_begin_state(message: *const u8, length: u64, state: *UnwindState) {
  dyn_trace_capture(#cast(usize, state.rip), #cast(usize, state.rbp))
  run_panic_hook(message, length)
}
