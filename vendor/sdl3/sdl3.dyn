use "std/fail"
use "std/c"
use "std/mem"
#link("SDL3")

// Optional SDL3 adapter; importing this package links SDL3. Handles are
// SDL-owned allocations with matching destroy_owned operations.
pub type Window = rawptr
pub type Renderer = rawptr
pub const InitAudio: u32 = 16
pub const InitVideo: u32 = 32
pub const WindowResizable: u64 = 32
pub const WindowHidden: u64 = 8
pub const EventQuit: u32 = 256
pub const EventWindowCloseRequested: u32 = 528
pub const EventWindowDestroyed: u32 = 537
// SDL_Event has a stable 128-byte ABI. u64 words preserve its required
// eight-byte alignment while keeping the large C union out of Dyn's API.
pub struct Event { words: [16]u64 }


pub fn init_video(status: *fail.Status) {
  if status == nil {
    init_video(&fail.Status{})
    return
  }
  if status.failed { return }
  checked(status, "start SDL video", native_init(InitVideo))
}
pub fn init_audio(status: *fail.Status) {
  if status == nil {
    init_audio(&fail.Status{})
    return
  }
  if status.failed { return }
  checked(status, "start SDL audio", native_init(InitAudio))
}
pub fn quit() {
  native_quit()
}
// Records SDL's last error for operation, as a System failure.
pub fn record_error(status: *fail.Status, operation: []const u8) {
  if status == nil {
    record_error(&fail.Status{}, operation)
    return
  }
  fail.set(status, fail.make(fail.Kind.System, operation, "", last_error(160)))
}
// Records SDL's last error for operation when the SDL call returned false.
fn checked(status: *fail.Status, operation: []const u8, ok: bool) {
  if !ok {
    record_error(status, operation)
  }
}

// Handles below are nil after a failure, which carries SDL's message.
pub fn window_create(status: *fail.Status, title: []const u8, title_buffer: []u8, width: i32, height: i32, flags: u64) Window {
  if status == nil { return window_create(&fail.Status{}, title, title_buffer, width, height, flags) }
  if status.failed { return nil }
  if width <= 0 || height <= 0 {
    fail.invalid(status, "create window", "", "the size must be positive")
    return nil
  }
  native_title := c.string_into(status, title_buffer, title)
  if status.failed { return nil }
  value := native_create_window(native_title, width, height, flags)
  if value == nil {
    record_error(status, "create window")
  }
  return value
}
pub fn window_destroy_owned(window: Window) {
  if window != nil {
    native_destroy_window(window)
  }
}
pub fn renderer_create_default_owned(status: *fail.Status, window: Window) Renderer {
  if status == nil { return renderer_create_default_owned(&fail.Status{}, window) }
  if status.failed { return nil }
  if window == nil {
    fail.invalid(status, "create renderer", "", "no window")
    return nil
  }
  value := native_create_renderer(window, nil)
  if value == nil {
    record_error(status, "create renderer")
  }
  return value
}
pub fn renderer_destroy_owned(renderer: Renderer) {
  if renderer != nil {
    native_destroy_renderer(renderer)
  }
}
pub fn clear(status: *fail.Status, renderer: Renderer, red: u8, green: u8, blue: u8, alpha: u8) {
  if status == nil {
    clear(&fail.Status{}, renderer, red, green, blue, alpha)
    return
  }
  if status.failed { return }
  if renderer == nil {
    fail.invalid(status, "clear", "", "no renderer")
    return
  }
  checked(status, "clear", native_set_draw_color(renderer, red, green, blue, alpha) && native_clear(renderer))
}
pub fn present(status: *fail.Status, renderer: Renderer) {
  if status == nil {
    present(&fail.Status{}, renderer)
    return
  }
  if status.failed { return }
  if renderer == nil {
    fail.invalid(status, "present", "", "no renderer")
    return
  }
  checked(status, "present", native_present(renderer))
}
pub fn event_type(event: *const Event) u32 {
  if event == nil { return 0 }
  return (event.words[0] & 4294967295)
}
pub fn poll_event(event: *Event) bool {
  return event != nil && native_poll_event(#cast(rawptr, event))
}
// Blocks until an event arrives and stores it in event.
pub fn wait_event(status: *fail.Status, event: *Event) {
  if status == nil {
    wait_event(&fail.Status{}, event)
    return
  }
  if status.failed { return }
  if event == nil {
    fail.invalid(status, "wait for event", "", "no event storage")
    return
  }
  checked(status, "wait for event", native_wait_event(#cast(rawptr, event)))
}
pub fn event_requests_close(event: *const Event) bool {
  kind := event_type(event)
  return kind == EventQuit || kind == EventWindowCloseRequested || kind == EventWindowDestroyed
}
// Borrows SDL thread-local buffer until the next SDL call.
pub fn last_error(maximum: usize) []const u8 {
  reading: fail.Status
  return c.bytes_from_string(&reading, native_error(), maximum)
}

pub type AudioStream = rawptr
pub type AudioDevice = u32
pub type AudioCallback = fn(rawptr, AudioStream, i32, i32)
pub const AudioDeviceDefaultPlayback: AudioDevice = 4294967295
pub const AudioU8: u32 = 8
pub const AudioS16: u32 = 32784
pub const AudioF32: u32 = 33056
pub struct AudioSpec { format: u32, channels: i32, frequency: i32 }


// SDL owns the stream allocation. nil callbacks select explicitly queued audio.
pub fn stream_open_playback_owned(status: *fail.Status, spec: *const AudioSpec) AudioStream {
  if status == nil { return stream_open_playback_owned(&fail.Status{}, spec) }
  if status.failed { return nil }
  if spec == nil {
    fail.invalid(status, "open audio stream", "", "no audio spec")
    return nil
  }
  value := native_open_audio_stream(AudioDeviceDefaultPlayback, spec, nil, nil)
  if value == nil {
    record_error(status, "open audio stream")
  }
  return value
}
pub fn stream_open_playback_callback_owned(status: *fail.Status, spec: *const AudioSpec, callback: AudioCallback, context: rawptr) AudioStream {
  if status == nil { return stream_open_playback_callback_owned(&fail.Status{}, spec, callback, context) }
  if status.failed { return nil }
  if spec == nil || callback == nil {
    fail.invalid(status, "open audio stream", "", "no audio spec or callback")
    return nil
  }
  value := native_open_audio_stream(AudioDeviceDefaultPlayback, spec, #cast(rawptr, callback), context)
  if value == nil {
    record_error(status, "open audio stream")
  }
  return value
}
// SDL copies source before return; source stays caller-owned.
pub fn stream_put(status: *fail.Status, stream: AudioStream, source: []const u8) {
  if status == nil {
    stream_put(&fail.Status{}, stream, source)
    return
  }
  if status.failed { return }
  if stream == nil || #len(source) > 2147483647 {
    fail.invalid(status, "queue audio", "", "no stream, or more than 2 GiB")
    return
  }
  if #len(source) == 0 { return }
  checked(status, "queue audio", native_put_audio(stream, #cast(rawptr, &source[0]), #cast(i32, #len(source))))
}
pub fn stream_resume(status: *fail.Status, stream: AudioStream) {
  if status == nil {
    stream_resume(&fail.Status{}, stream)
    return
  }
  if status.failed { return }
  if stream == nil {
    fail.invalid(status, "resume audio", "", "no stream")
    return
  }
  checked(status, "resume audio", native_resume_audio(stream))
}
pub fn stream_pause(status: *fail.Status, stream: AudioStream) {
  if status == nil {
    stream_pause(&fail.Status{}, stream)
    return
  }
  if status.failed { return }
  if stream == nil {
    fail.invalid(status, "pause audio", "", "no stream")
    return
  }
  checked(status, "pause audio", native_pause_audio(stream))
}
// Bytes queued and not yet played.
pub fn stream_available(status: *fail.Status, stream: AudioStream) usize {
  if status == nil { return stream_available(&fail.Status{}, stream) }
  if status.failed { return 0 }
  if stream == nil {
    fail.invalid(status, "queued audio", "", "no stream")
    return 0
  }
  count := native_audio_available(stream)
  if count < 0 {
    record_error(status, "queued audio")
    return 0
  }
  return #cast(usize, count)
}
pub fn stream_flush(status: *fail.Status, stream: AudioStream) {
  if status == nil {
    stream_flush(&fail.Status{}, stream)
    return
  }
  if status.failed { return }
  if stream == nil {
    fail.invalid(status, "flush audio", "", "no stream")
    return
  }
  checked(status, "flush audio", native_flush_audio(stream))
}
pub fn stream_clear(status: *fail.Status, stream: AudioStream) {
  if status == nil {
    stream_clear(&fail.Status{}, stream)
    return
  }
  if status.failed { return }
  if stream == nil {
    fail.invalid(status, "clear audio", "", "no stream")
    return
  }
  checked(status, "clear audio", native_clear_audio(stream))
}
pub struct AudioFormats { source: AudioSpec, destination: AudioSpec }
pub fn stream_format(status: *fail.Status, stream: AudioStream) AudioFormats {
  if status == nil { return stream_format(&fail.Status{}, stream) }
  if status.failed { return AudioFormats{} }
  if stream == nil {
    fail.invalid(status, "audio format", "", "no stream")
    return AudioFormats{}
  }
  formats: AudioFormats
  checked(status, "audio format", native_audio_format(stream, &formats.source, &formats.destination))
  if status.failed { return AudioFormats{} }
  return formats
}
pub fn stream_destroy_owned(stream: AudioStream) {
  if stream != nil {
    native_destroy_audio(stream)
  }
}

pub type GpuDevice = rawptr
pub type GpuCommandBuffer = rawptr
pub type GpuTexture = rawptr
pub type GpuRenderPass = rawptr
pub type GpuShader = rawptr
pub type GpuBuffer = rawptr
pub const ShaderSpirv: u32 = 2
pub const ShaderDxbc: u32 = 4
pub const ShaderDxil: u32 = 8
pub const ShaderMsl: u32 = 16
pub const ShaderMetallib: u32 = 32
pub const ShaderStageVertex: i32 = 0
pub const ShaderStageFragment: i32 = 1
pub const BufferVertex: u32 = 1
pub const BufferIndex: u32 = 2
pub const TextureSampler: u32 = 1
pub const TextureColorTarget: u32 = 2
// texture is nil while the window is minimized.
pub struct GpuSwapchain { texture: GpuTexture, width: u32, height: u32 }
pub struct FColor { red: f32, green: f32, blue: f32, alpha: f32 }
pub struct GpuColorTargetInfo {
  texture: GpuTexture, mip_level: u32, layer_or_depth_plane: u32, clear_color: FColor,
  load_op: i32, store_op: i32, resolve_texture: GpuTexture, resolve_mip_level: u32,
  resolve_layer: u32, cycle: bool, cycle_resolve_texture: bool, padding1: u8, padding2: u8,
}
pub struct GpuShaderInfo {
  code_size: usize, code: *const u8, entrypoint: c.string, format: u32, stage: i32,
  samplers: u32, buffer_textures: u32, buffer_buffers: u32, uniform_buffers: u32, properties: u32,
}
pub struct GpuTextureInfo {
  kind: i32, format: i32, usage: u32, width: u32, height: u32, layers_or_depth: u32,
  levels: u32, samples: i32, properties: u32,
}
pub struct GpuBufferInfo { usage: u32, size: u32, properties: u32 }


pub fn gpu_create_default_owned(status: *fail.Status, formats: u32, debug: bool) GpuDevice {
  if status == nil { return gpu_create_default_owned(&fail.Status{}, formats, debug) }
  if status.failed { return nil }
  value := native_gpu_create(formats, debug, nil)
  if value == nil {
    record_error(status, "create GPU device")
  }
  return value
}
pub fn gpu_destroy_owned(device: GpuDevice) {
  if device != nil {
    native_gpu_destroy(device)
  }
}
pub fn gpu_claim_window(status: *fail.Status, device: GpuDevice, window: Window) {
  if status == nil {
    gpu_claim_window(&fail.Status{}, device, window)
    return
  }
  if status.failed { return }
  if device == nil || window == nil {
    fail.invalid(status, "claim window", "", "no device or window")
    return
  }
  checked(status, "claim window", native_gpu_claim_window(device, window))
}
pub fn gpu_release_window(device: GpuDevice, window: Window) {
  if device != nil && window != nil {
    native_gpu_release_window(device, window)
  }
}
pub fn gpu_commands(status: *fail.Status, device: GpuDevice) GpuCommandBuffer {
  if status == nil { return gpu_commands(&fail.Status{}, device) }
  if status.failed { return nil }
  if device == nil {
    fail.invalid(status, "acquire commands", "", "no device")
    return nil
  }
  value := native_gpu_acquire(device)
  checked(status, "acquire commands", value != nil)
  return value
}
pub fn gpu_wait_swapchain(status: *fail.Status, commands: GpuCommandBuffer, window: Window) GpuSwapchain {
  if status == nil { return gpu_wait_swapchain(&fail.Status{}, commands, window) }
  if status.failed { return GpuSwapchain{} }
  texture: GpuTexture = nil
  width: u32 = 0
  height: u32 = 0
  if commands == nil || window == nil {
    fail.invalid(status, "acquire swapchain", "", "no commands or window")
    return GpuSwapchain{}
  }
  checked(status, "acquire swapchain", native_gpu_swapchain(commands, window, &texture, &width, &height))
  if status.failed { return GpuSwapchain{} }
  return GpuSwapchain{ texture: texture, width: width, height: height }
}
// Submission consumes the command buffer regardless of success.
pub fn gpu_submit(status: *fail.Status, commands: GpuCommandBuffer) {
  if status == nil {
    gpu_submit(&fail.Status{}, commands)
    return
  }
  if status.failed { return }
  if commands == nil {
    fail.invalid(status, "submit commands", "", "no commands")
    return
  }
  checked(status, "submit commands", native_gpu_submit(commands))
}
pub fn gpu_shader_create_owned(status: *fail.Status, device: GpuDevice, info: *const GpuShaderInfo) GpuShader {
  if status == nil { return gpu_shader_create_owned(&fail.Status{}, device, info) }
  if status.failed { return nil }
  if device == nil || info == nil {
    fail.invalid(status, "create shader", "", "no device or shader info")
    return nil
  }
  value := native_gpu_shader_create(device, info)
  checked(status, "create shader", value != nil)
  return value
}
pub fn gpu_shader_release_owned(device: GpuDevice, shader: GpuShader) {
  if device != nil && shader != nil {
    native_gpu_shader_release(device, shader)
  }
}
pub fn gpu_texture_create_owned(status: *fail.Status, device: GpuDevice, info: *const GpuTextureInfo) GpuTexture {
  if status == nil { return gpu_texture_create_owned(&fail.Status{}, device, info) }
  if status.failed { return nil }
  if device == nil || info == nil {
    fail.invalid(status, "create texture", "", "no device or texture info")
    return nil
  }
  value := native_gpu_texture_create(device, info)
  checked(status, "create texture", value != nil)
  return value
}
pub fn gpu_texture_release_owned(device: GpuDevice, texture: GpuTexture) {
  if device != nil && texture != nil {
    native_gpu_texture_release(device, texture)
  }
}
pub fn gpu_buffer_create_owned(status: *fail.Status, device: GpuDevice, info: *const GpuBufferInfo) GpuBuffer {
  if status == nil { return gpu_buffer_create_owned(&fail.Status{}, device, info) }
  if status.failed { return nil }
  if device == nil || info == nil {
    fail.invalid(status, "create buffer", "", "no device or buffer info")
    return nil
  }
  value := native_gpu_buffer_create(device, info)
  checked(status, "create buffer", value != nil)
  return value
}
pub fn gpu_buffer_release_owned(device: GpuDevice, buffer: GpuBuffer) {
  if device != nil && buffer != nil {
    native_gpu_buffer_release(device, buffer)
  }
}

// Clears and presents one swapchain frame, consuming commands on success.
// A minimized window may have no texture; submit the empty buffer successfully.
pub fn gpu_clear_swapchain(status: *fail.Status, commands: GpuCommandBuffer, window: Window, color: FColor) {
  if status == nil {
    gpu_clear_swapchain(&fail.Status{}, commands, window, color)
    return
  }
  acquired := gpu_wait_swapchain(status, commands, window)
  if status.failed { return }
  if acquired.texture != nil {
    target := GpuColorTargetInfo{ texture: acquired.texture, clear_color: color, load_op: 1, store_op: 0 }
    render_pass := native_gpu_begin_render(commands, &target, 1, nil)
    checked(status, "begin render pass", render_pass != nil)
    if status.failed { return }
    native_gpu_end_render(render_pass)
  }
  gpu_submit(status, commands)
}
