use "std/c"
use "std/fail"
use "vendor/sdl3"
#link("SDL3_image")
// SDL_image 3.x. The surface is provider-owned; use sdl3.surface_destroy_owned.
// nil after a failure, which carries SDL's message.
pub fn load_owned(status: *fail.Status, path: []const u8, path_buffer: []u8) sdl3.Surface {
  if status == nil { return load_owned(&fail.Status{}, path, path_buffer) }
  if status.failed { return nil }
  encoded := c.string_into(status, path_buffer, path)
  if status.failed { return nil }
  value := native_load(encoded)
  if value == nil {
    sdl3.record_error(status, "load image")
  }
  return value
}
// Bytes borrowed only during synchronous decode. Decoder closes its temporary IO.
pub fn decode_owned(status: *fail.Status, bytes: []const u8) sdl3.Surface {
  if status == nil { return decode_owned(&fail.Status{}, bytes) }
  if status.failed { return nil }
  if bytes.len == 0 {
    fail.invalid(status, "decode image", "", "no data")
    return nil
  }
  stream := native_io(#cast(rawptr, &bytes[0]), bytes.len)
  value: sdl3.Surface = nil
  if stream != nil {
    value = native_load_io(stream, true)
  }
  if value == nil {
    sdl3.record_error(status, "decode image")
  }
  return value
}
extern fn native_load "IMG_Load"(path: c.string) sdl3.Surface
extern fn native_io "SDL_IOFromConstMem"(bytes: rawptr, length: usize) rawptr
extern fn native_load_io "IMG_Load_IO"(stream: rawptr, close: bool) sdl3.Surface
