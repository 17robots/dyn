use io "std/io"
use "std/c"
use "vendor/sdl3"
#link("SDL3_ttf")
pub type Font = rawptr
pub struct Size { width: i32, height: i32 }
// Init/quit must be balanced; destroy fonts before quit. Use each font on its
// creating thread. SDL owns rendered surfaces; destroy them separately.
pub fn init() !io.IoErr {
  if !native_init() {
    try sdl3.record_error("start SDL_ttf")
  }
}
pub fn quit() {
  native_quit()
}
pub fn open_owned(path: []const u8, buffer: []u8, points: f32) Font!io.IoErr {
  if !(points > 0.0) { fail .InvalidInput }
  encoded := try c.string_into(buffer, path)
  value := native_open(encoded, points)
  if value == nil {
    try sdl3.record_error("open font")
  }
  return value
}
pub fn destroy_owned(font: Font) {
  if font != nil {
    native_close(font)
  }
}
// Empty text passed as an actual NUL string because SDL interprets length 0 as
// NUL-terminated. Nonempty text uses byte length, never scans past the slice.
pub fn measure(font: Font, text: []const u8) Size!io.IoErr {
  if font == nil { fail .InvalidInput }
  empty: [1]u8
  pointer: *const u8 = &empty[0]
  if text.len > 0 {
    pointer = &text[0]
  }
  width: i32 = 0
  height: i32 = 0
  if !native_measure(font, pointer, text.len, &width, &height) {
    try sdl3.record_error("measure text")
    return Size{}
  }
  return Size{ width: width, height: height }
}
pub fn render_owned(font: Font, text: []const u8, color: sdl3.Color) sdl3.Surface!io.IoErr {
  if font == nil || text.len == 0 { fail .InvalidInput }
  value := native_render(font, &text[0], text.len, color)
  if value == nil {
    try sdl3.record_error("render text")
  }
  return value
}
extern fn native_init "TTF_Init"() bool
extern fn native_quit "TTF_Quit"()
extern fn native_open "TTF_OpenFont"(path: c.string, points: f32) Font
extern fn native_close "TTF_CloseFont"(font: Font)
extern fn native_measure "TTF_GetStringSize"(font: Font, text: *const u8, length: usize, width: *i32, height: *i32) bool
extern fn native_render "TTF_RenderText_Blended"(font: Font, text: *const u8, length: usize, color: sdl3.Color) sdl3.Surface
