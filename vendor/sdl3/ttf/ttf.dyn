use "std/c"
use "std/fail"
use "vendor/sdl3"
#link("SDL3_ttf")
pub type Font = rawptr
pub struct Size { width: i32, height: i32 }
// Init/quit must be balanced; destroy fonts before quit. Use each font on its
// creating thread. SDL owns rendered surfaces; destroy them separately.
pub fn init(status: *fail.Status) {
  if status == nil {
    init(&fail.Status{})
    return
  }
  if status.failed { return }
  if !native_init() {
    sdl3.record_error(status, "start SDL_ttf")
  }
}
pub fn quit() {
  native_quit()
}
pub fn open_owned(status: *fail.Status, path: []const u8, buffer: []u8, points: f32) Font {
  if status == nil { return open_owned(&fail.Status{}, path, buffer, points) }
  if status.failed { return nil }
  if !(points > 0.0) {
    fail.invalid(status, "open font", path, "the size must be positive")
    return nil
  }
  encoded := c.string_into(status, buffer, path)
  if status.failed { return nil }
  value := native_open(encoded, points)
  if value == nil {
    sdl3.record_error(status, "open font")
  }
  return value
}
pub fn destroy_owned(font: Font) {
  if font != nil {
    native_close(font)
  }
}
// Empty text passed as an actual NUL string because SDL interprets length 0 as
// NUL-terminated. Nonempty text uses byte length, never scans past the slice.
pub fn measure(status: *fail.Status, font: Font, text: []const u8) Size {
  if status == nil { return measure(&fail.Status{}, font, text) }
  if status.failed { return Size{} }
  if font == nil {
    fail.invalid(status, "measure text", "", "no font")
    return Size{}
  }
  empty: [1]u8
  pointer: *const u8 = &empty[0]
  if #len(text) > 0 {
    pointer = &text[0]
  }
  width: i32 = 0
  height: i32 = 0
  if !native_measure(font, pointer, #len(text), &width, &height) {
    sdl3.record_error(status, "measure text")
    return Size{}
  }
  return Size{ width: width, height: height }
}
pub fn render_owned(status: *fail.Status, font: Font, text: []const u8, color: sdl3.Color) sdl3.Surface {
  if status == nil { return render_owned(&fail.Status{}, font, text, color) }
  if status.failed { return nil }
  if font == nil || #len(text) == 0 {
    fail.invalid(status, "render text", "", "no font or text")
    return nil
  }
  value := native_render(font, &text[0], #len(text), color)
  if value == nil {
    sdl3.record_error(status, "render text")
  }
  return value
}
extern fn native_init "TTF_Init"() bool
extern fn native_quit "TTF_Quit"()
extern fn native_open "TTF_OpenFont"(path: c.string, points: f32) Font
extern fn native_close "TTF_CloseFont"(font: Font)
extern fn native_measure "TTF_GetStringSize"(font: Font, text: *const u8, length: usize, width: *i32, height: *i32) bool
extern fn native_render "TTF_RenderText_Blended"(font: Font, text: *const u8, length: usize, color: sdl3.Color) sdl3.Surface
