use io "std/io"
use "vendor/sdl3"
#link("SDL3_mixer")
// SDL_mixer 3.2.4. Balance init/quit after destroying mixers and audio.
// SDL owns these allocations. Destroy tracks before mixers; destroying a mixer
// also destroys its remaining tracks. Track pointers then become invalid.
pub type Mixer = rawptr
pub type Audio = rawptr
pub type Track = rawptr
pub fn init() !io.IoErr {
  if !native_init() {
    try sdl3.record_error("start SDL_mixer")
  }
}
pub extern fn quit "MIX_Quit"()
extern fn native_init "MIX_Init"() bool
// Offline stereo f32 at 48 kHz, no device. Pull audio into caller storage.
pub fn create_owned() Mixer!io.IoErr {
  spec := sdl3.AudioSpec{ format: sdl3.AudioF32, channels: 2, frequency: 48000 }
  value := native_create(&spec)
  if value == nil {
    try sdl3.record_error("create mixer")
  }
  return value
}
// Default playback device; availability and output latency are device-dependent.
// Use playing/stop with this mixer; generate is only for offline mixers.
pub fn create_device_owned() Mixer!io.IoErr {
  value := native_device(sdl3.AudioDeviceDefaultPlayback, nil)
  if value == nil {
    try sdl3.record_error("open mixer device")
  }
  return value
}
pub fn destroy_owned(mixer: Mixer) {
  if mixer != nil {
    native_destroy(mixer)
  }
}
// Source borrowed only during synchronous predecode; provider owns the audio.
// Audio can outlive the originating mixer and must be destroyed separately.
pub fn decode_owned(mixer: Mixer, bytes: []const u8) Audio!io.IoErr {
  if mixer == nil || bytes.len == 0 { fail .InvalidInput }
  input := native_io(#cast(rawptr, &bytes[0]), bytes.len)
  if input == nil {
    try sdl3.record_error("decode audio")
    return nil
  }
  value := native_load(mixer, input, true, true)
  if value == nil {
    try sdl3.record_error("decode audio")
  }
  return value
}
pub fn audio_destroy_owned(audio: Audio) {
  if audio != nil {
    native_audio_destroy(audio)
  }
}
pub fn track_create(mixer: Mixer) Track!io.IoErr {
  if mixer == nil { fail .InvalidInput }
  value := native_track(mixer)
  if value == nil {
    try sdl3.record_error("create track")
  }
  return value
}
pub fn track_destroy(track: Track) {
  if track != nil {
    native_track_destroy(track)
  }
}
pub fn play(track: Track, audio: Audio) !io.IoErr {
  if track == nil || audio == nil { fail .InvalidInput }
  if !native_set(track, audio) || !native_play(track, 0) {
    try sdl3.record_error("play")
  }
}
pub fn stop(track: Track) !io.IoErr {
  if track == nil { fail .InvalidInput }
  if !native_stop(track, 0) {
    try sdl3.record_error("stop")
  }
}
pub fn playing(track: Track) bool {
  return track != nil && native_playing(track)
}
// Samples are interleaved stereo f32. Length must be even. Returns the count
// of meaningful samples; the provider fills the rest with silence.
pub fn generate(mixer: Mixer, samples: []f32) usize!io.IoErr {
  if mixer == nil || samples.len == 0 || samples.len % 2 != 0 || samples.len > 536870911 {
    fail .InvalidInput
  }
  code := native_generate(mixer, #cast(rawptr, &samples[0]), #cast(i32, (samples.len * 4)))
  if code < 0 {
    try sdl3.record_error("generate audio")
    return 0
  }
  return #cast(usize, code) / 4
}
extern fn native_create "MIX_CreateMixer"(spec: *const sdl3.AudioSpec) Mixer
extern fn native_destroy "MIX_DestroyMixer"(mixer: Mixer)
extern fn native_io "SDL_IOFromConstMem"(bytes: rawptr, length: usize) rawptr
extern fn native_load "MIX_LoadAudio_IO"(mixer: Mixer, stream: rawptr, predecode: bool, close: bool) Audio
extern fn native_audio_destroy "MIX_DestroyAudio"(audio: Audio)
extern fn native_track "MIX_CreateTrack"(mixer: Mixer) Track
extern fn native_track_destroy "MIX_DestroyTrack"(track: Track)
extern fn native_set "MIX_SetTrackAudio"(track: Track, audio: Audio) bool
extern fn native_play "MIX_PlayTrack"(track: Track, properties: u32) bool
extern fn native_stop "MIX_StopTrack"(track: Track, frames: i64) bool
extern fn native_playing "MIX_TrackPlaying"(track: Track) bool
extern fn native_generate "MIX_Generate"(mixer: Mixer, bytes: rawptr, length: i32) i32

extern fn native_device "MIX_CreateMixerDevice"(device: sdl3.AudioDevice, spec: *const sdl3.AudioSpec) Mixer
