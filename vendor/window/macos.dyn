#target(kernel: darwin)
use native "vendor/window/native"
use "std/fail"
use box "std/ui/box"
pub type Window = native.Window
pub fn open(status: *fail.Status, window: *Window, title: []const u8, width, height: i32) {
  if status == nil {
    open(&fail.Status{}, window, title, width, height)
    return
  }
  native.open(status, window, title, width, height)
}
pub fn close(window: *Window) {
  native.close(window)
}
pub fn poll(status: *fail.Status, window: *Window) {
  if status == nil {
    poll(&fail.Status{}, window)
    return
  }
  native.poll(status, window)
}
pub fn make_current(status: *fail.Status, window: *Window) {
  if status == nil {
    make_current(&fail.Status{}, window)
    return
  }
  native.make_current(status, window)
}
pub fn swap(status: *fail.Status, window: *Window) {
  if status == nil {
    swap(&fail.Status{}, window)
    return
  }
  native.swap(status, window)
}
pub fn gl_proc(name: *const u8) rawptr {
  return native.gl_proc(name)
}
pub type Cursor = native.Cursor
pub fn set_clipboard(window: *Window, text: []const u8) {
  native.set_clipboard(window, text)
}
pub fn request_paste(window: *Window) {
  native.request_paste(window)
}
pub fn set_cursor(window: *Window, cursor: Cursor) {
  native.set_cursor(window, cursor)
}
pub fn scale(window: *const Window) f32 {
  return native.scale(window)
}
pub fn wait(window: *Window, timeout: i32) {
  native.wait(window, timeout)
}
pub fn box_input(window: *const Window) box.Input {
  return native.box_input(window)
}

// Ordered events retain all supported raw input; box_input remains a summary.
pub type Event = native.OrderedEvent
pub type EventKind = native.EventKind
pub fn next_event(window: *Window, output: *Event) bool {
  return native.next_event(window, output)
}
// The owner must outlive all worker wake calls; stop/join them before close.
pub fn wake(status: *fail.Status, window: *const Window) {
  if status == nil {
    wake(&fail.Status{}, window)
    return
  }
  native.wake(status, window)
}

// Ordered listening is disabled initially. Enable before polling input;
// changing this flag clears the queue without changing box_input summaries.
pub fn listen_events(window: *Window, enabled: bool) {
  native.listen_events(window, enabled)
}
pub type Composition = native.Composition
pub fn composition(window: *const Window) Composition {
  return native.composition(window)
}
pub fn set_text_input(window: *Window, enabled: bool, x, y, width, height: i32) {
  native.set_text_input(window, enabled, x, y, width, height)
}
pub fn clipboard(window: *const Window) []const u8 {
  return native.clipboard(window)
}

pub type Surrounding = native.Surrounding
pub fn set_surrounding_text(status: *fail.Status, window: *Window, context: Surrounding) {
  if status == nil {
    set_surrounding_text(&fail.Status{}, window, context)
    return
  }
  native.set_surrounding_text(status, window, context)
}

pub fn set_title(status: *fail.Status, window: *Window, title: []const u8) {
  if status == nil {
    set_title(&fail.Status{}, window, title)
    return
  }
  native.set_title(status, window, title)
}
pub fn set_size(status: *fail.Status, window: *Window, width, height: i32) {
  if status == nil {
    set_size(&fail.Status{}, window, width, height)
    return
  }
  native.set_size(status, window, width, height)
}
pub fn set_swap_interval(status: *fail.Status, window: *Window, interval: i32) {
  if status == nil {
    set_swap_interval(&fail.Status{}, window, interval)
    return
  }
  native.set_swap_interval(status, window, interval)
}
pub fn try_set_clipboard(status: *fail.Status, window: *Window, text: []const u8) {
  if status == nil {
    try_set_clipboard(&fail.Status{}, window, text)
    return
  }
  native.try_set_clipboard(status, window, text)
}
pub fn request_paste_snapshot(window: *Window) {
  native.request_paste_snapshot(window)
}
pub fn paste_pending(window: *const Window) bool {
  return native.paste_pending(window)
}
pub fn paste_status(status: *fail.Status, window: *const Window) {
  if status == nil {
    paste_status(&fail.Status{}, window)
    return
  }
  native.paste_status(status, window)
}
