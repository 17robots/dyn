use "std/fail"
use surrounding_edit "std/text/edit"
use ordered "vendor/window/events"
pub type OrderedEvent = ordered.Event
pub type EventKind = ordered.Kind
use mem "std/mem"
use c "std/c"
use utf8 "std/unicode/utf8"
use io "std/io"
use ui "std/ui"
use box "std/ui/box"
#link("dyn_window")
// Native bridge owns its OS allocations. Keep the owning Window on its GUI
// thread, close renderer resources before close, and never copy a live owner.
pub struct Window { handle: rawptr, width: i32, height: i32, input: ui.Input, close_requested: bool, desktop: Desktop, composition: Composition }
// The in-progress input method text, drawn by the application at its caret.
// Mirrors dyn_window_composition: cursor offsets are bytes into text, -1 hides
// the cursor.
pub type Composition = ordered.Composition
// Mirrors dyn_window_desktop in window.h.
struct Desktop { text: [256]u8, text_length: u32, keys: u32, scroll_x: f32, scroll_y: f32, scale: f32, clipboard: *const u8, clipboard_length: u32 }
pub enum Cursor { Arrow, Text, Hand, ResizeX, ResizeY }
struct Frame { width: i32, height: i32, x: i32, y: i32, flags: u32 }
extern fn native_open "dyn_window_open"(title: *const u8, width: i32, height: i32) rawptr
extern fn native_close "dyn_window_close"(handle: rawptr)
extern fn native_poll "dyn_window_poll"(handle: rawptr, frame: *Frame) i32
extern fn native_set_title "dyn_window_set_title"(handle: rawptr, text: *const u8, length: u32) i32
extern fn native_set_size "dyn_window_set_size"(handle: rawptr, width: i32, height: i32) i32
extern fn native_swap_interval "dyn_window_set_swap_interval"(handle: rawptr, interval: i32) i32
extern fn native_try_clipboard "dyn_window_try_set_clipboard"(handle: rawptr, text: *const u8, length: u32) i32
extern fn native_snapshot "dyn_window_request_paste_snapshot"(handle: rawptr)
extern fn native_paste_pending "dyn_window_paste_pending"(handle: rawptr) i32
extern fn native_paste_status "dyn_window_paste_status"(handle: rawptr) i32
extern fn native_current "dyn_window_current"(handle: rawptr) i32
extern fn native_swap "dyn_window_swap"(handle: rawptr) i32
pub extern fn gl_proc "dyn_window_proc"(name: *const u8) rawptr
extern fn native_desktop "dyn_window_desktop_take"(handle: rawptr, desktop: *Desktop)
extern fn native_set_clipboard "dyn_window_set_clipboard"(handle: rawptr, text: *const u8, length: u32)
extern fn native_request_paste "dyn_window_request_paste"(handle: rawptr)
extern fn native_set_cursor "dyn_window_set_cursor"(handle: rawptr, cursor: i32)
extern fn native_wait "dyn_window_wait"(handle: rawptr, timeout: i32)
extern fn native_surrounding "dyn_window_set_surrounding_text"(handle: rawptr, text: *const u8, length: u32, cursor: u32, anchor: u32, token: u64, cause: u32) i32
extern fn native_composition "dyn_window_composition_get"(handle: rawptr, composition: *Composition)
extern fn native_clipboard "dyn_window_clipboard_get"(handle: rawptr, text: **const u8) u32
extern fn native_text_input "dyn_window_set_text_input"(handle: rawptr, enabled: i32, x: i32, y: i32, width: i32, height: i32)
extern fn native_listen_events "dyn_window_listen_events"(handle: rawptr, enabled: i32)
extern fn native_next_event "dyn_window_next_event"(handle: rawptr, event: *OrderedEvent) i32
extern fn native_wake "dyn_window_wake"(handle: rawptr) i32
pub fn open(status: *fail.Status, window: *Window, title: []const u8, width, height: i32) {
  if status == nil {
    open(&fail.Status{}, window, title, width, height)
    return
  }
  if status.failed { return }
  if window.handle != nil {
    window_failed(status, fail.Kind.InvalidState, "open")
    return
  }
  if width <= 0 || height <= 0 || title.len > 4095 {
    window_failed(status, fail.Kind.InvalidInput, "open")
    return
  }
  storage: [4096]u8
  converting: fail.Status
  name := c.string_into(&converting, storage[..], title)
  if converting.failed {
    window_failed(status, fail.Kind.InvalidInput, "open")
    return
  }
  handle := native_open(name, width, height)
  if handle == nil {
    window_failed(status, fail.Kind.System, "open")
    return
  }
  window.* = Window{handle:handle, width:width, height:height}
  poll(status, window)
  if status.failed {
    close(window)
  }
}
pub fn close(window: *Window) {
  if window.handle != nil {
    native_close(window.handle)
    window.* = Window{}
  }
}
pub fn poll(status: *fail.Status, window: *Window) {
  if status == nil {
    poll(&fail.Status{}, window)
    return
  }
  if status.failed { return }
  if window.handle == nil {
    window_failed(status, fail.Kind.InvalidState, "poll")
    return
  }
  previous_composition := window.composition.active != 0
  frame := Frame{}
  if native_poll(window.handle, &frame) == 0 {
    window_failed(status, fail.Kind.System, "poll")
    return
  }
  window.width = frame.width
  window.height = frame.height
  window.close_requested = (frame.flags & 128) != 0
  window.input = ui.Input{x:frame.x, y:frame.y, down:(frame.flags&1)!=0, pressed:(frame.flags&2)!=0, released:(frame.flags&4)!=0, tab:(frame.flags&8)!=0, activate:(frame.flags&16)!=0, left:(frame.flags&32)!=0, right:(frame.flags&64)!=0}
  native_desktop(window.handle, &window.desktop)
  native_composition(window.handle, &window.composition)
  if previous_composition || window.composition.active != 0 {
    window.desktop.keys |= 32768
  }
}
pub fn make_current(status: *fail.Status, window: *Window) {
  if status == nil {
    make_current(&fail.Status{}, window)
    return
  }
  if status.failed { return }
  if window.handle == nil {
    window_failed(status, fail.Kind.InvalidState, "make current")
    return
  }
  if native_current(window.handle) == 0 {
    window_failed(status, fail.Kind.System, "make current")
    return
  }
}
pub fn swap(status: *fail.Status, window: *Window) {
  if status == nil {
    swap(&fail.Status{}, window)
    return
  }
  if status.failed { return }
  if window.handle == nil {
    window_failed(status, fail.Kind.InvalidState, "swap")
    return
  }
  if native_swap(window.handle) == 0 {
    window_failed(status, fail.Kind.System, "swap")
    return
  }
}

// Offers text on the clipboard; longer text is truncated to 64 KiB.
pub fn set_clipboard(window: *Window, text: []const u8) {
  if window.handle == nil { return }
  length := text.len
  if length > 65536 {
    length = 65536
  }
  if length == 0 {
    empty: [1]u8
    native_set_clipboard(window.handle, &empty[0], 0)
    return
  }
  native_set_clipboard(window.handle, &text[0], #cast(u32, length))
}

// Asks for the clipboard; the text arrives in box_input as a paste.
pub fn request_paste(window: *Window) {
  if window.handle != nil {
    native_request_paste(window.handle)
  }
}

pub fn set_cursor(window: *Window, cursor: Cursor) {
  if window.handle != nil {
    native_set_cursor(window.handle, #cast(u8, cursor))
  }
}

// Display scale relative to 96 DPI (or the platform's base scale).
pub fn scale(window: *const Window) f32 {
  if window.desktop.scale <= 0.0 { return 1.0 }
  return window.desktop.scale
}

// Blocks until input arrives or timeout milliseconds pass; negative waits
// indefinitely.
pub fn wait(window: *Window, timeout: i32) {
  if window.handle != nil {
    native_wait(window.handle, timeout)
  }
}

// The box input for this frame. Text and clipboard views borrow the window
// until the next poll.
pub fn box_input(window: *const Window) box.Input {
  desktop := &window.desktop
  keys := desktop.keys
  value := box.Input{
    x: #cast(f32, window.input.x), y: #cast(f32, window.input.y), down: window.input.down,
    scroll_x: desktop.scroll_x, scroll_y: desktop.scroll_y,
    text: desktop.text[..desktop.text_length],
    backspace: (keys & 1) != 0, delete: (keys & 2) != 0, left: (keys & 4) != 0, right: (keys & 8) != 0,
    home: (keys & 16) != 0, end: (keys & 32) != 0, enter: (keys & 64) != 0, escape: (keys & 128) != 0,
    tab: (keys & 256) != 0, shift: (keys & 512) != 0, control: (keys & 16384) != 0, select_all: (keys & 1024) != 0,
    composition_handled: (keys & 32768) != 0,
    copy: (keys & 2048) != 0, cut: (keys & 4096) != 0, paste: (keys & 8192) != 0,
  }
  if value.paste && desktop.clipboard != nil {
    value.clipboard = #slice(desktop.clipboard, desktop.clipboard_length)
  }
  value.composition_cursor = -1
  if window.composition.active != 0 && window.composition.text_length <= 256 {
    value.composition = window.composition.text[..window.composition.text_length]
    value.composition_cursor = window.composition.cursor_begin
  }
  return value
}

// Copies one queued event into caller storage; independent of box_input.
pub fn next_event(window: *Window, output: *OrderedEvent) bool {
  return window.handle != nil && native_next_event(window.handle, output) != 0
}
// Thread-safe; join all wake callers before close. Wakes may coalesce.
pub fn wake(status: *fail.Status, window: *const Window) {
  if status == nil {
    wake(&fail.Status{}, window)
    return
  }
  if status.failed { return }
  if window.handle == nil {
    window_failed(status, fail.Kind.InvalidState, "wake")
    return
  }
  if native_wake(window.handle) == 0 {
    window_failed(status, fail.Kind.System, "wake")
    return
  }
}

// Opt-in before poll. Toggling clears queued events; disabled by default.
pub fn listen_events(window: *Window, enabled: bool) {
  if window.handle != nil {
    value: i32 = 0
    if enabled {
      value = 1
    }
    native_listen_events(window.handle, value)
  }
}

pub fn composition(window: *const Window) Composition {
  return window.composition
}

// Enables text input and places the caret rectangle (window pixels) where the
// input method shows its candidates.
pub fn set_text_input(window: *Window, enabled: bool, x, y, width, height: i32) {
  if window.handle == nil { return }
  on: i32 = 0
  if enabled {
    on = 1
  }
  native_text_input(window.handle, on, x, y, width, height)
  native_composition(window.handle, &window.composition)
}

// The most recent pasted text, borrowed until the next paste request/reply or close.
pub fn clipboard(window: *const Window) []const u8 {
  if window.handle == nil { return "" }
  text: *const u8 = nil
  length := native_clipboard(window.handle, &text)
  if text == nil { return "" }
  return #slice(text, length)
}

pub type Surrounding = surrounding_edit.Context
// Publish after enabling ordered listening and before enabling a newly focused
// field. The protocol copies text synchronously. Failure preserves old context.
pub fn set_surrounding_text(status: *fail.Status, window: *Window, context: Surrounding) {
  if status == nil {
    set_surrounding_text(&fail.Status{}, window, context)
    return
  }
  if status.failed { return }
  if window.handle == nil {
    window_failed(status, fail.Kind.InvalidState, "set surrounding text")
    return
  }
  surrounding_edit.validate(status, &context)
  if status.failed { return }
  for byte in context.text {
    if byte == 0 {
      window_failed(status, fail.Kind.InvalidInput, "set surrounding text")
      return
    }
  }
  empty: [1]u8
  pointer: *const u8 = &empty[0]
  if context.text.len != 0 {
    pointer = &context.text[0]
  }
  cause: u32 = 0
  if context.cause == surrounding_edit.Cause.InputMethod {
    cause = 1
  }
  code := native_surrounding(window.handle, pointer, #cast(u32, context.text.len), #cast(u32, context.cursor), #cast(u32, context.anchor), context.token, cause)
  if code == 1 { return }
  if code == -1 {
    window_failed(status, fail.Kind.Unsupported, "set surrounding text")
    return
  }
  if code == -2 {
    window_failed(status, fail.Kind.Capacity, "set surrounding text")
    return
  }
  window_failed(status, fail.Kind.InvalidState, "set surrounding text")
}

// The native layer's status: 1 succeeds, negative codes name the failure.
fn checked_status(status: *fail.Status, operation: []const u8, code: i32) {
  if status.failed || code == 1 { return }
  kind := fail.Kind.System
  if code == -1 {
    kind = fail.Kind.Unsupported
  } else if code == -2 {
    kind = fail.Kind.Capacity
  } else if code == -3 {
    kind = fail.Kind.InvalidInput
  } else if code == -4 {
    kind = fail.Kind.InvalidState
  }
  window_failed(status, kind, operation)
}
pub fn set_title(status: *fail.Status, window: *Window, title: []const u8) {
  if status == nil {
    set_title(&fail.Status{}, window, title)
    return
  }
  if status.failed { return }
  if window.handle == nil {
    window_failed(status, fail.Kind.InvalidState, "set title")
    return
  }
  if title.len > 4096 {
    window_failed(status, fail.Kind.Capacity, "set title")
    return
  }
  if !utf8.valid(title) {
    window_failed(status, fail.Kind.InvalidInput, "set title")
    return
  }
  for byte in title {
    if byte == 0 {
      window_failed(status, fail.Kind.InvalidInput, "set title")
      return
    }
  }
  empty: [1]u8
  pointer: *const u8 = &empty[0]
  if title.len != 0 {
    pointer = &title[0]
  }
  checked_status(status, "set title", native_set_title(window.handle, pointer, #cast(u32, title.len)))
}
pub fn set_size(status: *fail.Status, window: *Window, width, height: i32) {
  if status == nil {
    set_size(&fail.Status{}, window, width, height)
    return
  }
  if status.failed { return }
  if window.handle == nil {
    window_failed(status, fail.Kind.InvalidState, "set size")
    return
  }
  if width <= 0 || height <= 0 {
    window_failed(status, fail.Kind.InvalidInput, "set size")
    return
  }
  checked_status(status, "set size", native_set_size(window.handle, width, height))
  poll(status, window)
}
pub fn set_swap_interval(status: *fail.Status, window: *Window, interval: i32) {
  if status == nil {
    set_swap_interval(&fail.Status{}, window, interval)
    return
  }
  if status.failed { return }
  if window.handle == nil {
    window_failed(status, fail.Kind.InvalidState, "set swap interval")
    return
  }
  if interval < 0 {
    window_failed(status, fail.Kind.InvalidInput, "set swap interval")
    return
  }
  checked_status(status, "set swap interval", native_swap_interval(window.handle, interval))
}
// Checked publication copies all text or reports failure; no truncation.
pub fn try_set_clipboard(status: *fail.Status, window: *Window, text: []const u8) {
  if status == nil {
    try_set_clipboard(&fail.Status{}, window, text)
    return
  }
  if status.failed { return }
  if window.handle == nil {
    window_failed(status, fail.Kind.InvalidState, "try set clipboard")
    return
  }
  if text.len > 4294967295 {
    window_failed(status, fail.Kind.Capacity, "try set clipboard")
    return
  }
  empty: [1]u8
  pointer: *const u8 = &empty[0]
  if text.len != 0 {
    pointer = &text[0]
  }
  checked_status(status, "try set clipboard", native_try_clipboard(window.handle, pointer, #cast(u32, text.len)))
}
// Snapshot replies update clipboard without entering the ordered event stream.
pub fn request_paste_snapshot(window: *Window) {
  if window.handle != nil {
    native_snapshot(window.handle)
  }
}
pub fn paste_pending(window: *const Window) bool {
  return window.handle != nil && native_paste_pending(window.handle) != 0
}
pub fn paste_status(status: *fail.Status, window: *const Window) {
  if status == nil {
    paste_status(&fail.Status{}, window)
    return
  }
  if status.failed { return }
  if window.handle == nil {
    window_failed(status, fail.Kind.InvalidState, "paste status")
    return
  }
  checked_status(status, "paste status", native_paste_status(window.handle))
}

// Records a window-system failure of kind for operation.
fn window_failed(status: *fail.Status, kind: fail.Kind, operation: []const u8) {
  message: []const u8 = "the window system failed"
  if kind == fail.Kind.InvalidState {
    message = "the window is not in a state to do this"
  } else if kind == fail.Kind.InvalidInput {
    message = "invalid argument"
  } else if kind == fail.Kind.Capacity {
    message = "too large"
  } else if kind == fail.Kind.Unsupported {
    message = "not supported by this window system"
  }
  fail.set(status, fail.make(kind, operation, "", message))
}
