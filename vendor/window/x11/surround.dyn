#target(kernel: linux)

// XIM string conversion cannot safely provide surrounding corrections through
// the libX11 protocol transport currently audited. Do not register a callback
// that only works under a synthetic test: see the source evidence in
// docs/internals/xim-surrounding-support.md. Preedit remains independent.
pub fn set_surrounding_text(window: *Window, text: []const u8, cursor, anchor: usize, token: u64) !io.IoErr {
  if window.display == nil || window.handle == 0 { fail .InvalidInput }
  if text.len > 4096 { fail .Capacity }
  if token == 0 || cursor > text.len || anchor > text.len || !utf8.valid(text) {
    fail .InvalidInput
  }
  if (cursor < text.len && (text[cursor] & 0xc0) == 0x80) || (anchor < text.len && (text[anchor] & 0xc0) == 0x80) {
    fail .InvalidInput
  }
  for byte in text {
    if byte == 0 { fail .InvalidInput }
  }
  if !window.events_enabled { fail .InvalidInput }
  fail .Unsupported
}
