#link("zstd")

pub const ContentSizeUnknown: u64 = 18446744073709551615
pub const ContentSizeError: u64 = 18446744073709551614
pub struct Result { written: usize, provider_code: usize, ok: bool }
pub struct SizeResult { size: u64, known: bool, ok: bool }
pub fn version() u32 { return zstd_version_number() }
pub fn compress_bound(source_size: usize) usize { return zstd_compress_bound(source_size) }
pub fn compress(destination: []u8, source: []const u8, level: i32) Result {
  destination_pointer: rawptr = nil source_pointer: rawptr = nil
  if #len(destination) > 0 { destination_pointer = #cast(rawptr) &destination[0] }
  if #len(source) > 0 { source_pointer = #cast(rawptr) &source[0] }
  code := zstd_compress(destination_pointer, #len(destination), source_pointer, #len(source), level)
  return result_from_code(code)
}
pub fn decompress(destination: []u8, source: []const u8) Result {
  destination_pointer: rawptr = nil source_pointer: rawptr = nil
  if #len(destination) > 0 { destination_pointer = #cast(rawptr) &destination[0] }
  if #len(source) > 0 { source_pointer = #cast(rawptr) &source[0] }
  code := zstd_decompress(destination_pointer, #len(destination), source_pointer, #len(source))
  return result_from_code(code)
}
pub fn frame_size(source: []const u8) SizeResult {
  if #len(source) == 0 { return SizeResult{} }
  size := zstd_frame_content_size(#cast(rawptr) &source[0], #len(source))
  if size == ContentSizeError { return SizeResult{ size: size } }
  return SizeResult{ size: size, known: size != ContentSizeUnknown, ok: true }
}
pub fn error_name(code: usize, maximum: usize) []const u8 {
  pointer := zstd_error_name(code)
  if pointer == nil { return "" }
  bytes := pointer[..maximum]
  length: usize = 0
  for length < maximum && bytes[length] != 0 { length += 1 }
  if length == maximum { return "" }
  return bytes[..length]
}

// Provider error codes are not byte counts. Failed output must be discarded.
fn result_from_code(code: usize) Result {
  if zstd_is_error(code) != 0 { return Result{ provider_code: code } }
  return Result{ written: code, provider_code: code, ok: true }
}

// Static provider context borrows workspace; never allocates or frees heap memory.
// Advanced zstd ABI: build and run against the same supported provider version.
pub struct StreamContext { value: rawptr, provider_code: usize, ok: bool }
pub struct StreamResult { written: usize, consumed: usize, provider_code: usize, ended: bool, ok: bool }
pub fn stream_workspace_size(window_log: u32) usize {
  if window_log < 10 || window_log > 30 { return 0 }
  window: usize = 1 window <<= window_log
  size := zstd_estimate_dstream_size(window)
  if zstd_is_error(size) != 0 || size > #cast(usize) -1 - 7 { return 0 }
  return size + 7
}
pub fn stream_context(workspace: []u8, window_log: u32) StreamContext {
  required := stream_workspace_size(window_log)
  if required == 0 || #len(workspace) < required { return StreamContext{} }
  address := #cast(usize) &workspace[0]
  eight: usize = 8
  padding := (eight - (address & 7)) & 7
  value := zstd_init_static_dstream(#cast(rawptr) &workspace[padding], #len(workspace) - padding)
  if value == nil { return StreamContext{} }
  code := zstd_dctx_set_parameter(value, 100, #cast(i32) window_log)
  if zstd_is_error(code) != 0 { return StreamContext{ provider_code: code } }
  return StreamContext{ value: value, ok: true }
}
pub fn stream_decode(context: *StreamContext, destination: []u8, source: []const u8) StreamResult {
  if !context.ok { return StreamResult{ provider_code: context.provider_code } }
  output_pointer: rawptr = nil input_pointer: rawptr = nil
  if #len(destination) != 0 { output_pointer = #cast(rawptr) &destination[0] }
  if #len(source) != 0 { input_pointer = #cast(rawptr) &source[0] }
  written: usize = 0 consumed: usize = 0
  code := zstd_decompress_stream(context.value, output_pointer, #len(destination), &written, input_pointer, #len(source), &consumed)
  if zstd_is_error(code) != 0 { context.ok = false context.provider_code = code return StreamResult{ provider_code: code } }
  return StreamResult{ written: written, consumed: consumed, ended: code == 0, provider_code: code, ok: true }
}
