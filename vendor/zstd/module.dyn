#link("zstd")

pub const ContentSizeUnknown: u64 = 18446744073709551615
pub const ContentSizeError: u64 = 18446744073709551614
pub struct Result { written: usize, provider_code: usize, ok: bool }
pub struct SizeResult { size: u64, known: bool, ok: bool }
pub fn version() u32 { return zstd_version_number() }
pub fn compress_bound(source_size: usize) usize { return zstd_compress_bound(source_size) }
pub fn compress(destination: []u8, source: []const u8, level: i32) Result {
  destination_pointer: rawptr = nil source_pointer: rawptr = nil
  if #len(destination) > 0 { destination_pointer = #cast(rawptr) &destination[0] }
  if #len(source) > 0 { source_pointer = #cast(rawptr) &source[0] }
  code := zstd_compress(destination_pointer, #len(destination), source_pointer, #len(source), level)
  return Result{ written: code, provider_code: code, ok: zstd_is_error(code) == 0 }
}
pub fn decompress(destination: []u8, source: []const u8) Result {
  destination_pointer: rawptr = nil source_pointer: rawptr = nil
  if #len(destination) > 0 { destination_pointer = #cast(rawptr) &destination[0] }
  if #len(source) > 0 { source_pointer = #cast(rawptr) &source[0] }
  code := zstd_decompress(destination_pointer, #len(destination), source_pointer, #len(source))
  return Result{ written: code, provider_code: code, ok: zstd_is_error(code) == 0 }
}
pub fn frame_size(source: []const u8) SizeResult {
  if #len(source) == 0 { return SizeResult{} }
  size := zstd_frame_content_size(#cast(rawptr) &source[0], #len(source))
  if size == ContentSizeError { return SizeResult{ size: size } }
  return SizeResult{ size: size, known: size != ContentSizeUnknown, ok: true }
}
pub fn error_name(code: usize, maximum: usize) []const u8 {
  pointer := zstd_error_name(code)
  if pointer == nil { return "" }
  bytes := pointer[..maximum]
  length: usize = 0
  for length < maximum && bytes[length] != 0 { length += 1 }
  if length == maximum { return "" }
  return bytes[..length]
}
