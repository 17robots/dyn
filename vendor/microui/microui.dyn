use "std/fail"
use "std/mem"
use "std/c"
#link("dyn_microui")
// Fixed-capacity UI state lives entirely in caller arena. No provider heap.
// Keep arena alive; reset only when finished. Single-threaded. Initial text
// metrics are 8x16 monospace bytes; renderer must match (not Unicode shaping).
pub type Context = rawptr
pub type Command = rawptr
pub const Clip: i32 = 2
pub const Rect: i32 = 3
pub const Text: i32 = 4
pub const Icon: i32 = 5
pub struct Rectangle { x: i32, y: i32, width: i32, height: i32 }
// Calls out of order (begin twice, a widget outside a window, end inside a
// window) fail with InvalidState; text over 4096 bytes or a full command list
// with InvalidInput.
pub fn create(arena: *mem.Arena, status: *fail.Status) Context {
  if status == nil { return create(arena, &fail.Status{}) }
  if status.failed { return nil }
  if arena == nil {
    fail.invalid(status, "create UI", "", "no arena")
    return nil
  }
  state := native_storage(arena, native_size(), native_align())
  native_init(state)
  return state
}

// Zeroed storage for a native state from arena, at the alignment the native
// side reports. Panics when the arena is exhausted.
fn native_storage(arena: *mem.Arena, size: usize, alignment: usize) rawptr {
  if alignment == 0 || (alignment & (alignment - 1)) != 0 || alignment > 4096 || size > #max(usize) - alignment {
    #panic("native state has an invalid size or alignment")
  }
  storage := mem.push_bytes(arena, size + alignment - 1)
  mem.zero(storage)
  skip := (alignment - (#cast(usize, &storage[0]) & (alignment - 1))) & (alignment - 1)
  return &storage[skip]
}
pub fn begin(status: *fail.Status, context: Context) {
  if status == nil {
    begin(&fail.Status{}, context)
    return
  }
  ui_checked(status, "begin frame", native_begin(context))
}
pub fn end(status: *fail.Status, context: Context) {
  if status == nil {
    end(&fail.Status{}, context)
    return
  }
  ui_checked(status, "end frame", native_end(context))
}
// Whether the window is open; widgets go inside an open window.
pub fn window(status: *fail.Status, context: Context, title: []const u8, buffer: []u8, bounds: Rectangle) bool {
  if status == nil { return window(&fail.Status{}, context, title, buffer, bounds) }
  encoded := ui_text(status, "window", title, buffer)
  if status.failed { return false }
  if bounds.width <= 0 || bounds.height <= 0 {
    fail.invalid(status, "window", "", "the size must be positive")
    return false
  }
  return native_window(context, encoded, bounds.x, bounds.y, bounds.width, bounds.height)
}
pub fn window_end(status: *fail.Status, context: Context) {
  if status == nil {
    window_end(&fail.Status{}, context)
    return
  }
  ui_checked(status, "end window", native_window_end(context))
}
pub fn label(status: *fail.Status, context: Context, text: []const u8, buffer: []u8) {
  if status == nil {
    label(&fail.Status{}, context, text, buffer)
    return
  }
  encoded := ui_text(status, "label", text, buffer)
  if status.failed { return }
  ui_checked(status, "label", native_label(context, encoded))
}
// Whether the button was clicked this frame. Inputs must arrive before begin().
pub fn button(status: *fail.Status, context: Context, text: []const u8, buffer: []u8) bool {
  if status == nil { return button(&fail.Status{}, context, text, buffer) }
  encoded := ui_text(status, "button", text, buffer)
  if status.failed { return false }
  clicked := native_button(context, encoded)
  if clicked < 0 {
    fail.set(status, fail.make(fail.Kind.InvalidState, "button", "", "outside a window, or the command list is full"))
    return false
  }
  return clicked == 1
}
fn ui_text(status: *fail.Status, operation: []const u8, text: []const u8, buffer: []u8) c.string {
  if status.failed { return nil }
  if text.len > 4096 {
    fail.invalid(status, operation, "", "text over 4096 bytes")
    return nil
  }
  return c.string_into(status, buffer, text)
}
fn ui_checked(status: *fail.Status, operation: []const u8, ok: bool) {
  if status.failed { return }
  if !ok {
    fail.set(status, fail.make(fail.Kind.InvalidState, operation, "", "called out of order, or the command list is full"))
  }
}
extern fn native_begin "dyn_mu_begin"(context: Context) bool
extern fn native_end "dyn_mu_end"(context: Context) bool
extern fn native_window_end "dyn_mu_window_end"(context: Context) bool
// action 0 move, 1 left press, 2 left release.
pub extern fn mouse "dyn_mu_mouse"(context: Context, x: i32, y: i32, action: i32)
// Iterate after end(). Commands/text borrow context storage until next begin().
// Renderer handles clipping, rectangles, text and icons using the accessors.
pub extern fn next "dyn_mu_next"(context: Context) Command
pub extern fn kind "dyn_mu_kind"(command: Command) i32
pub fn text(command: Command) []const u8 {
  reading: fail.Status
  return c.bytes_from_string(&reading, native_text(command), 4097)
}
pub fn rectangle(command: Command) Rectangle {
  result := Rectangle{}
  native_rect(command, &result.x, &result.y, &result.width, &result.height)
  return result
}
// RGBA packed with red in bits 31..24; independent of host byte order.
pub extern fn color "dyn_mu_color"(command: Command) u32
pub extern fn icon "dyn_mu_icon"(command: Command) i32
extern fn native_size "dyn_mu_size"() usize
extern fn native_align "dyn_mu_align"() usize
extern fn native_init "dyn_mu_init"(context: Context)
extern fn native_window "dyn_mu_window"(context: Context, title: c.string, x: i32, y: i32, w: i32, h: i32) bool
extern fn native_label "dyn_mu_label"(context: Context, text: c.string) bool
extern fn native_button "dyn_mu_button"(context: Context, text: c.string) i32
extern fn native_text "dyn_mu_text"(command: Command) c.string
extern fn native_rect "dyn_mu_rect"(command: Command, x: *i32, y: *i32, w: *i32, h: *i32)
