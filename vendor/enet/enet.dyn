use "std/c"
use "std/fail"
#link("dyn_enet")
// ENet 1.3.18, configurable reliable channels. Provider owns hosts/packets. Initialize once
// before creating hosts and deinitialize after destroying all hosts. Hosts and
// their borrowed peer handles are single-threaded. This is not encrypted transport.
pub type Host = rawptr
pub type Peer = rawptr
pub type Packet = rawptr
pub const Connected: i32 = 1
pub const Disconnected: i32 = 2
pub const Received: i32 = 3
// kind is zero when no event came in time.
pub struct Event { kind: i32, peer: Peer, packet: Packet, channel: u8, data: u32 }
pub fn init(status: *fail.Status) {
  if status == nil {
    init(&fail.Status{})
    return
  }
  if status.failed { return }
  if native_init() != 0 {
    fail.set(status, fail.make(fail.Kind.System, "start ENet", "", "initialization failed"))
  }
}
pub extern fn quit "enet_deinitialize"()
// Convenience listener uses loopback and one channel; port=0 is ephemeral.
pub fn listen_owned(status: *fail.Status, port: u16, peers: usize) Host {
  if status == nil { return listen_owned(&fail.Status{}, port, peers) }
  buffer: [16]u8
  return listen_at_owned(status, "127.0.0.1", port, peers, 1, buffer[..])
}
pub fn client_owned(status: *fail.Status, peers: usize) Host {
  if status == nil { return client_owned(&fail.Status{}, peers) }
  return client_channels_owned(status, peers, 1)
}
pub fn destroy_owned(host: Host) {
  if host != nil {
    native_destroy(host)
  }
}
pub extern fn port "dyn_enet_port"(host: Host) u16
pub fn connect(status: *fail.Status, host: Host, ip: []const u8, port: u16, buffer: []u8) Peer {
  if status == nil { return connect(&fail.Status{}, host, ip, port, buffer) }
  return connect_channels(status, host, ip, port, 1, buffer)
}
// Service both endpoints. Every received packet must be destroyed, including
// packets the app ignores. A socket failure fails with System.
pub fn service(status: *fail.Status, host: Host, timeout_ms: u32) Event {
  if status == nil { return service(&fail.Status{}, host, timeout_ms) }
  if status.failed { return Event{} }
  event := Event{}
  code := native_service(host, timeout_ms, &event.kind, &event.peer, &event.packet, &event.channel, &event.data)
  if code < 0 {
    failure := fail.make(fail.Kind.System, "service ENet host", "", "the host failed")
    failure.native = code
    fail.set(status, failure)
    return Event{}
  }
  if code == 0 { return Event{} }
  return event
}
// Copies bytes; successful send transfers the private packet to ENet. Maximum
// 1 MiB. No peer, a channel the connection lacks, or a larger packet fails with
// InvalidInput.
pub fn send(status: *fail.Status, peer: Peer, bytes: []const u8) {
  if status == nil {
    send(&fail.Status{}, peer, bytes)
    return
  }
  send_channel(status, peer, 0, bytes)
}
pub fn send_channel(status: *fail.Status, peer: Peer, channel: u8, bytes: []const u8) {
  if status == nil {
    send_channel(&fail.Status{}, peer, channel, bytes)
    return
  }
  if status.failed { return }
  data: rawptr = nil
  if #len(bytes) != 0 {
    data = #cast(rawptr, &bytes[0])
  }
  if !native_send(peer, data, #len(bytes), channel) {
    fail.invalid(status, "send", "", "no peer, no such channel, or more than 1 MiB")
  }
}
// Borrow expires at packet_destroy. Received packet can be copied into an arena
// if it needs to survive event handling.
pub fn packet_bytes(packet: Packet) []const u8 {
  data := native_data(packet)
  size := native_size(packet)
  if data == nil { return "" }
  return #slice(data, size)
}
pub fn packet_destroy(packet: Packet) {
  if packet != nil {
    native_packet_destroy(packet)
  }
}
pub fn disconnect(peer: Peer) {
  if peer != nil {
    native_disconnect(peer, 0)
  }
}
extern fn native_init "enet_initialize"() i32
extern fn native_host "dyn_enet_host"(ip: c.string, port: u16, peers: usize, channels: usize) Host
extern fn native_destroy "enet_host_destroy"(host: Host)
extern fn native_connect "dyn_enet_connect"(host: Host, ip: c.string, port: u16, channels: usize) Peer
extern fn native_service "dyn_enet_service"(host: Host, timeout: u32, kind: *i32, peer: *Peer, packet: *Packet, channel: *u8, data: *u32) i32
extern fn native_send "dyn_enet_send"(peer: Peer, data: rawptr, size: usize, channel: u8) bool
extern fn native_data "dyn_enet_data"(packet: Packet) *const u8
extern fn native_size "dyn_enet_size"(packet: Packet) usize
extern fn native_packet_destroy "enet_packet_destroy"(packet: Packet)
extern fn native_disconnect "enet_peer_disconnect"(peer: Peer, data: u32)

// Numeric IPv4 only. Use "0.0.0.0" to accept connections on all interfaces.
// channels must be 1..255. No DNS lookup or hidden filesystem/network work.
// A bad address, channel count or port in use fails with InvalidInput.
pub fn listen_at_owned(status: *fail.Status, ip: []const u8, port: u16, peers: usize, channels: usize, buffer: []u8) Host {
  if status == nil { return listen_at_owned(&fail.Status{}, ip, port, peers, channels, buffer) }
  encoded := c.string_into(status, buffer, ip)
  if status.failed { return nil }
  host := native_host(encoded, port, peers, channels)
  if host == nil {
    fail.invalid(status, "listen", ip, "bad address or channel count, or the port is in use")
  }
  return host
}
pub fn client_channels_owned(status: *fail.Status, peers: usize, channels: usize) Host {
  if status == nil { return client_channels_owned(&fail.Status{}, peers, channels) }
  if status.failed { return nil }
  host := native_host(nil, 0, peers, channels)
  if host == nil {
    fail.invalid(status, "create client", "", "bad peer or channel count")
  }
  return host
}
pub fn connect_channels(status: *fail.Status, host: Host, ip: []const u8, port: u16, channels: usize, buffer: []u8) Peer {
  if status == nil { return connect_channels(&fail.Status{}, host, ip, port, channels, buffer) }
  encoded := c.string_into(status, buffer, ip)
  if status.failed { return nil }
  peer := native_connect(host, encoded, port, channels)
  if peer == nil {
    fail.invalid(status, "connect", ip, "no host, bad address, or no free peer")
  }
  return peer
}
// Graceful disconnect is asynchronous. Continue service until Disconnected or
// an application deadline, then destroy the host. Event.data carries the reason.
pub fn disconnect_with_reason(peer: Peer, reason: u32) {
  if peer != nil {
    native_disconnect(peer, reason)
  }
}
