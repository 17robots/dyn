use "std/unicode/utf8"

// A statement owns its provider handle. Do not copy live statements or access
// fields directly. Database must remain open until every statement is finalized.
pub enum State { Ready, Row, Done, Failed }
// columns is the result column count, fixed when the statement is prepared.
pub struct Statement { handle: rawptr, state: State, code: i32, columns: usize }
// A compiled statement, the SQL bytes it took, and empty when the SQL held
// only whitespace or comments (then there is no statement to step).
pub struct Prepared { statement: Statement, consumed: usize, empty: bool }
pub enum ColumnKind { Null, Integer, Float, Text, Blob }
pub struct Column { kind: ColumnKind, integer: i64, real: f64, bytes: []const u8 }

// Negative codes are wrapper failures; positive codes are unchanged SQLite codes.
pub const InvalidArgument: i32 = -1
pub const Capacity: i32 = -2
pub const Overflow: i32 = -3

// Compiles the first statement, reporting bytes consumed. Call again with the
// remaining SQL to process a script. Empty/comment-only input succeeds with empty=true.
// SQL is borrowed only during this call and needs no terminating NUL or scratch.
pub fn prepare(database: Database, sql: []const u8) Prepared!io.IoErr {
  if database == nil { fail .InvalidInput }
  if sql.len > 2147483647 { fail .Capacity }
  for byte in sql {
    if byte == 0 { fail .InvalidInput }
  }
  if sql.len == 0 { return Prepared{ empty: true } }
  handle: rawptr = nil
  tail: c.string = nil
  code := sqlite_prepare(database, &sql[0], #cast(i32, sql.len), &handle, &tail)
  if code != 0 {
    if handle != nil {
      _ = sqlite_finalize(handle)
    }
    fail sqlite_err(code)
  }
  consumed := #cast(usize, tail) - #cast(usize, &sql[0])
  columns: usize = 0
  if handle != nil {
    columns = #cast(usize, sqlite_column_count(handle))
  }
  return Prepared{ statement: Statement{ handle: handle, columns: columns }, consumed: consumed, empty: handle == nil }
}

// Row and Done are successful, distinct outcomes. A failed step leaves the
// statement Failed with its code; repeated calls after Done or a failure do
// not re-execute SQL. reset is required before reuse.
pub fn step(statement: *Statement) State!io.IoErr {
  if statement == nil || statement.handle == nil { fail .InvalidInput }
  if statement.state == State.Done { return State.Done }
  if statement.state != State.Failed {
    statement.code = sqlite_step(statement.handle)
    if statement.code == 100 {
      statement.state = State.Row
    } else if statement.code == 101 {
      statement.state = State.Done
    } else {
      statement.state = State.Failed
    }
  }
  if statement.state == State.Failed { fail sqlite_err(statement.code) }
  return statement.state
}

// Always resets execution state, even when reporting the preceding execution's
// error. Parameter values survive reset; use clear_bindings to release them.
pub fn reset(statement: *Statement) !io.IoErr {
  if statement == nil || statement.handle == nil { fail .InvalidInput }
  code := sqlite_reset(statement.handle)
  statement.state = State.Ready
  statement.code = 0
  try checked(code)
}

// Releases ownership and zeros the caller's slot. Finalizing the same slot
// again does nothing. Cleanup cannot fail: an error here only repeats the
// last step's.
pub fn finalize(statement: *Statement) {
  if statement == nil { return }
  handle := statement.handle
  statement.* = Statement{}
  if handle != nil {
    _ = sqlite_finalize(handle)
  }
}

fn can_bind(statement: *const Statement) bool {
  return statement != nil && statement.handle != nil && statement.state == State.Ready
}
// Binding needs a prepared statement that is Ready (fresh or reset);
// otherwise it fails with InvalidInput.
pub fn clear_bindings(statement: *Statement) !io.IoErr {
  if !can_bind(statement) { fail .InvalidInput }
  try checked(sqlite_clear_bindings(statement.handle))
}
pub fn bind_null(statement: *Statement, index: usize) !io.IoErr {
  if !can_bind(statement) { fail .InvalidInput }
  try checked(sqlite_bind_null(statement.handle, native_index(index)))
}
pub fn bind_i64(statement: *Statement, index: usize, value: i64) !io.IoErr {
  if !can_bind(statement) { fail .InvalidInput }
  try checked(sqlite_bind_integer(statement.handle, native_index(index), value))
}
pub fn bind_f64(statement: *Statement, index: usize, value: f64) !io.IoErr {
  if !can_bind(statement) { fail .InvalidInput }
  try checked(sqlite_bind_float(statement.handle, native_index(index), value))
}
fn bind_bytes(statement: *Statement, index: usize, value: []const u8, text: bool) i32 {
  if !can_bind(statement) { return InvalidArgument }
  if value.len > 2147483647 { return Overflow }
  // Empty data must have a non-null pointer so it is not bound as SQL NULL.
  empty: [1]u8
  pointer := #cast(rawptr, &empty[0])
  if value.len > 0 {
    pointer = #cast(rawptr, &value[0])
  }
  transient := #cast(rawptr, #cast(isize, -1))
  if text {
    return sqlite_bind_text(statement.handle, native_index(index), pointer, #cast(i32, value.len), transient)
  }
  return sqlite_bind_blob(statement.handle, native_index(index), pointer, #cast(i32, value.len), transient)
}
// SQLite copies bindings before return. Text must be valid UTF-8 without NUL;
// use blobs for arbitrary bytes. Inputs may be changed immediately after binding.
pub fn bind_text(statement: *Statement, index: usize, value: []const u8) !io.IoErr {
  if !utf8.valid(value) { fail .InvalidInput }
  for byte in value {
    if byte == 0 { fail .InvalidInput }
  }
  try checked(bind_bytes(statement, index, value, true))
}
pub fn bind_blob(statement: *Statement, index: usize, value: []const u8) !io.IoErr {
  try checked(bind_bytes(statement, index, value, false))
}

// Values for bind_values: Blob binds bytes as a blob, Null binds SQL NULL.
pub struct Blob { bytes: []const u8 }
pub struct Null {}

// Binds values to parameters 1, 2, ... in order. Each value is an integer
// (bound as i64), f32 or f64, bool (0 or 1), []const u8 or []u8 (text),
// Blob or Null. Stops at the first failure; an unsupported type fails with
// InvalidInput, an integer past i64 with Capacity.
pub fn bind_values(statement: *Statement, values: ...any) !io.IoErr {
  try bind_list(statement, values)
}

fn bind_list(statement: *Statement, values: []const any) !io.IoErr {
  for i in 0..values.len {
    index := i + 1
    case values[i] {
      i64(value) => { try bind_i64(statement, index, value) }
      i32(value) => { try bind_i64(statement, index, value) }
      i16(value) => { try bind_i64(statement, index, value) }
      i8(value) => { try bind_i64(statement, index, value) }
      u32(value) => { try bind_i64(statement, index, value) }
      u16(value) => { try bind_i64(statement, index, value) }
      u8(value) => { try bind_i64(statement, index, value) }
      u64(value) => {
        if value > 9223372036854775807 { fail .Capacity }
        try bind_i64(statement, index, #cast(i64, value))
      }
      usize(value) => {
        if #cast(u64, value) > 9223372036854775807 { fail .Capacity }
        try bind_i64(statement, index, #cast(i64, value))
      }
      isize(value) => { try bind_i64(statement, index, value) }
      f64(value) => { try bind_f64(statement, index, value) }
      f32(value) => { try bind_f64(statement, index, value) }
      bool(value) => {
        flag: i64 = 0
        if value {
          flag = 1
        }
        try bind_i64(statement, index, flag)
      }
      []const u8(value) => { try bind_text(statement, index, value) }
      []u8(value) => { try bind_text(statement, index, value) }
      Blob(value) => { try bind_blob(statement, index, value.bytes) }
      Null(value) => { try bind_null(statement, index) }
      _ => {
        fail .InvalidInput
      }
    }
  }
}

// Returns statement to Ready and drops its bindings, ready for the next
// use: defer sqlite.done(&statement) right after taking it. Errors are not
// reported; step already reported them. A nil statement does nothing.
pub fn done(statement: *Statement) {
  if statement == nil || statement.handle == nil { return }
  _ = sqlite_reset(statement.handle)
  statement.state = State.Ready
  statement.code = 0
  _ = sqlite_clear_bindings(statement.handle)
}

pub fn column_count(statement: *const Statement) usize {
  if statement == nil || statement.handle == nil { return 0 }
  return #cast(usize, sqlite_column_count(statement.handle))
}

// SQLite's int for a parameter or column index; past its range, 0, which
// SQLite rejects as out of range.
fn native_index(index: usize) i32 {
  if index > 2147483647 { return 0 }
  return #cast(i32, index)
}
// Columns are zero-based and available only after Row. No implicit conversions:
// kind distinguishes NULL, empty text, empty blob and numeric zero. Returned bytes
// borrow SQLite storage until step/reset/finalize; clone them into an arena to retain.
// Off a row or out of range fails with InvalidInput.
pub fn column(statement: *const Statement, index: usize) Column!io.IoErr {
  if statement == nil || statement.handle == nil || statement.state != State.Row || index >= statement.columns {
    fail .InvalidInput
  }
  kind := sqlite_column_type(statement.handle, native_index(index))
  if kind == 5 { return Column{ kind: ColumnKind.Null } }
  if kind == 1 {
    return Column{ kind: ColumnKind.Integer, integer: sqlite_column_integer(statement.handle, native_index(index)) }
  }
  if kind == 2 {
    return Column{ kind: ColumnKind.Float, real: sqlite_column_float(statement.handle, native_index(index)) }
  }
  pointer: *const u8 = nil
  result_kind := ColumnKind.Text
  if kind == 3 {
    pointer = sqlite_column_text(statement.handle, native_index(index))
  } else if kind == 4 {
    pointer = sqlite_column_blob(statement.handle, native_index(index))
    result_kind = ColumnKind.Blob
  } else {
    fail .InvalidInput
  }
  length := sqlite_column_bytes(statement.handle, native_index(index))
  if pointer == nil && (length != 0 || kind == 3) { fail .Capacity }
  if length == 0 { return Column{ kind: result_kind, bytes: "" } }
  return Column{ kind: result_kind, bytes: #slice(pointer, length) }
}
