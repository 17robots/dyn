use "std/c"
use "std/mem"
#link("sqlite3")

pub type Database = rawptr
pub struct OpenResult { database: Database, code: i32, ok: bool }


// Provider allocates database. Caller must close every successful result.
pub fn open_into(name: []const u8, storage: []u8) OpenResult {
  encoded := c.string_from_bytes(storage, name)
  if !encoded.ok { return OpenResult{ code: -1 } }
  database: rawptr = nil code := sqlite_open(encoded.value, &database)
  return OpenResult{ database: database, code: code, ok: code == 0 }
}
pub fn open(arena: *mem.Arena, name: []const u8) OpenResult {
  mark := mem.arena_mark(arena)
  encoded := c.string_from_arena(arena, name)
  if !encoded.ok { return OpenResult{ code: -1 } }
  database: rawptr = nil code := sqlite_open(encoded.value, &database)
  mem.arena_reset_to(arena, mark)
  return OpenResult{ database: database, code: code, ok: code == 0 }
}
pub fn close(database: Database) i32 { if database == nil { return 0 } return sqlite_close(database) }

// SQL is borrowed only for call. SQLite owns returned error; wrapper releases it.
pub fn execute_into(database: Database, sql: []const u8, storage: []u8) i32 {
  encoded := c.string_from_bytes(storage, sql)
  if !encoded.ok { return -1 }
  error: rawptr = nil code := sqlite_exec(database, encoded.value, nil, nil, &error)
  if error != nil { sqlite_free(error) }
  return code
}
pub fn execute(arena: *mem.Arena, database: Database, sql: []const u8) i32 {
  mark := mem.arena_mark(arena)
  encoded := c.string_from_arena(arena, sql)
  if !encoded.ok { return -1 }
  error: rawptr = nil code := sqlite_exec(database, encoded.value, nil, nil, &error)
  if error != nil { sqlite_free(error) }
  mem.arena_reset_to(arena, mark)
  return code
}

// Returned bytes borrow database and expire at next SQLite call or close.
pub fn error_message(database: Database, maximum: usize) []const u8 {
  value := c.bytes_from_string(sqlite_error_message(database), maximum)
  if !value.ok { return "" }
  return value.value
}
