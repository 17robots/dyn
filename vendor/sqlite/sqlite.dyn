use io "std/io"
use "std/c"
#link("sqlite3")

pub type Database = rawptr

extern fn sqlite_error_text "sqlite3_errstr"(code: i32) c.string

// The io.IoErr for a SQLite result code, or for one of the wrapper's negative
// codes below. A code with no portable meaning, a constraint among them, stays
// System with SQLite's extended code, which constraint and error_text read.
fn sqlite_err(code: i32) io.IoErr {
  primary := code & 255
  if code == InvalidArgument { return io.IoErr.InvalidInput }
  if code == Capacity || code == Overflow { return io.IoErr.Capacity }
  if primary == 7 || primary == 13 || primary == 18 { return io.IoErr.Capacity }
  if primary == 3 || primary == 8 || primary == 23 { return io.IoErr.PermissionDenied }
  if primary == 5 || primary == 6 { return io.IoErr.WouldBlock }
  if primary == 14 { return io.IoErr.NotFound }
  if primary == 20 || primary == 21 || primary == 25 { return io.IoErr.InvalidInput }
  return io.IoErr.System(#cast(isize, code))
}
fn checked(code: i32) !io.IoErr {
  if code != 0 { fail sqlite_err(code) }
}

// SQLite's text for the code of a System failure.
pub fn error_text(code: isize) []const u8 {
  return c.bytes_from_string(sqlite_error_text(#cast(i32, code)), 160) catch ""
}

// Opens or creates the database at name; buffer holds name as a C string.
// The connection must be closed; a failure leaves nothing to close.
pub fn open(name: []const u8, buffer: []u8) Database!io.IoErr {
  path := try c.string_into(buffer, name)
  database: rawptr = nil
  code := sqlite_open(path, &database)
  if code != 0 {
    if database != nil {
      _ = sqlite_close(database)
    }
    fail sqlite_err(code)
  }
  return database
}
// Opt in only when the caller serializes every connection/statement operation,
// including borrowed views, from publication until all workers have stopped.
// The provider's default mutex mode remains the default for all existing calls.
pub struct OpenOptions { caller_serialized: bool }
extern fn sqlite_open_flags "sqlite3_open_v2"(name: c.string, database: *rawptr, flags: i32, vfs: c.string) i32
pub fn open_with_options(name: []const u8, buffer: []u8, options: OpenOptions) Database!io.IoErr {
  if !options.caller_serialized { return try open(name, buffer) }
  path := try c.string_into(buffer, name)
  database: rawptr = nil
  // READWRITE | CREATE | NOMUTEX: file locking/durability are unchanged.
  code := sqlite_open_flags(path, &database, 0x8006, nil)
  if code != 0 {
    if database != nil { _ = sqlite_close(database) }
    fail sqlite_err(code)
  }
  return database
}
// Fails with WouldBlock while statements are still open.
pub fn close(database: Database) !io.IoErr {
  if database == nil { return }
  try checked(sqlite_close(database))
}

// SQL is borrowed only for the call; buffer holds it as a C string.
// error_message(database) gives SQLite's description of a failure.
pub fn execute(database: Database, sql: []const u8, buffer: []u8) !io.IoErr {
  if database == nil { fail .InvalidInput }
  text := try c.string_into(buffer, sql)
  code := sqlite_exec(database, text, nil, nil, nil)
  try checked(code)
}

// Returned bytes borrow database and expire at next SQLite call or close.
pub fn error_message(database: Database, maximum: usize) []const u8 {
  if database == nil { return "" }
  return c.bytes_from_string(sqlite_error_message(database), maximum) catch ""
}
