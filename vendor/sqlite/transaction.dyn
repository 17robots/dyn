use "std/time"
pub enum TransactionMode { Deferred, Immediate, Exclusive }
pub struct IntegerResult { value: i64, code: i32, failure: io.Failure }
// Applies to subsequent busy waits on this connection. Zero disables waiting.
pub fn busy_timeout(database: Database, milliseconds: i32) io.Failure {
  if database == nil || milliseconds < 0 { return code_failure(InvalidArgument) }
  return code_failure(sqlite_busy_timeout(database, milliseconds))
}
extern fn sqlite_busy_handler "sqlite3_busy_handler"(database: rawptr, handler: fn(rawptr, i32) i32, argument: rawptr) i32

// Waits for another connection's write lock in short steps: 20 microseconds,
// doubling to 1 millisecond, for about five seconds in all. SQLite's
// busy_timeout sleeps whole milliseconds from the first retry, so threads
// writing to one database wait far longer than the writes take.
pub fn busy_wait(database: Database) io.Failure {
  if database == nil { return code_failure(InvalidArgument) }
  return code_failure(sqlite_busy_handler(database, busy_step, nil))
}

fn busy_step(_argument: rawptr, attempts: i32) i32 {
  if attempts >= 5000 { return 0 }
  step: i64 = 1000 * time.Microsecond
  if attempts < 6 { step = (20 * time.Microsecond) << #cast(u64, attempts) }
  _ = time.sleep(step)
  return 1
}

pub fn changes(database: Database) IntegerResult {
  if database == nil {
    return IntegerResult{ code: InvalidArgument, failure: io.Failure{ kind: io.Kind.System } }
  }
  return IntegerResult{ value: sqlite_changes(database) }
}
pub fn last_insert_rowid(database: Database) IntegerResult {
  if database == nil {
    return IntegerResult{ code: InvalidArgument, failure: io.Failure{ kind: io.Kind.System } }
  }
  return IntegerResult{ value: sqlite_last_rowid(database) }
}
// Transactions belong to the connection. A failed commit may leave one active;
// query in_transaction, retry or roll back before reusing the connection.
pub fn in_transaction(database: Database) bool {
  return database != nil && sqlite_autocommit(database) == 0
}
fn transaction_command(database: Database, command: *const u8) i32 {
  if database == nil { return InvalidArgument }
  return sqlite_exec(database, command, nil, nil, nil)
}
pub fn begin(database: Database, mode: TransactionMode) io.Failure {
  command := "BEGIN DEFERRED\0"
  if mode == TransactionMode.Immediate {
    command = "BEGIN IMMEDIATE\0"
  } else if mode == TransactionMode.Exclusive {
    command = "BEGIN EXCLUSIVE\0"
  }
  return code_failure(transaction_command(database, &command[0]))
}
pub fn commit(database: Database) io.Failure {
  command := "COMMIT\0"
  return code_failure(transaction_command(database, &command[0]))
}
pub fn rollback(database: Database) io.Failure {
  command := "ROLLBACK\0"
  return code_failure(transaction_command(database, &command[0]))
}
