use "std/mem"

// Shorter forms for the usual statement life: run a write, read a first row,
// walk rows. Each gives the statement back ready for its next use, also when
// it fails.

// Binds values to parameters 1, 2, ... (see bind_values), steps to the end
// and gives the statement back. To react to a constraint (such as a UNIQUE
// column), catch the failure and ask constraint(err).
pub fn run(statement: *Statement, values: ...any) !io.IoErr {
  try run_list(statement, values)
}

fn run_list(statement: *Statement, values: []const any) !io.IoErr {
  done(statement)
  defer done(statement)
  try bind_list(statement, values)
  for try step(statement) == State.Row {}
}

// Binds values and steps to the first row: true when a row is ready for the
// column readers below. Read it, then done(statement), or defer that.
pub fn first(statement: *Statement, values: ...any) bool!io.IoErr {
  return try first_list(statement, values)
}

fn first_list(statement: *Statement, values: []const any) bool!io.IoErr {
  done(statement)
  try bind_list(statement, values)
  return try step(statement) == State.Row
}

// Binds values for a query walked with next: for try sqlite.next(statement) { ... }.
// Call done(statement) after the walk, or defer it.
pub fn query(statement: *Statement, values: ...any) !io.IoErr {
  done(statement)
  try bind_list(statement, values)
}

// Steps to the next row; false at the end.
pub fn next(statement: *Statement) bool!io.IoErr {
  return try step(statement) == State.Row
}

// Column index of the current row as an integer, converted the way SQLite
// converts (NULL is 0, text is parsed, a real is truncated); 0 off a row.
pub fn integer(statement: *const Statement, index: usize) i64 {
  if !readable(statement, index) { return 0 }
  return sqlite_column_integer(statement.handle, native_index(index))
}
// Column index of the current row as bytes, borrowed until the next step:
// text and blobs as stored, NULL empty, numbers as SQLite writes them.
pub fn bytes(statement: *const Statement, index: usize) []const u8 {
  if !readable(statement, index) { return "" }
  // Text and blobs come back as stored; column_bytes must follow column_blob.
  pointer := sqlite_column_blob(statement.handle, native_index(index))
  length := sqlite_column_bytes(statement.handle, native_index(index))
  if pointer == nil || length <= 0 { return "" }
  return #slice(pointer, length)
}
pub fn text(arena: *mem.Arena, statement: *const Statement, index: usize) []const u8 {
  value := bytes(statement, index)
  copy := mem.push_bytes(arena, value.len)
  _ = mem.copy(copy, value)
  return copy
}

// Whether err is SQLite's SQLITE_CONSTRAINT, such as a UNIQUE column.
pub fn constraint(err: io.IoErr) bool {
  case err {
    .System(code) => { return (code & 255) == 19 }
    _ => { return false }
  }
}

// Prepared statements of one connection, keyed by their SQL: each is
// prepared on first use and kept. sql must outlive the cache (a string
// literal does).
pub const CacheSize: usize = 64

struct CacheEntry { sql: []const u8, statement: Statement }

pub struct Cache {
  database: Database,
  entries: [CacheSize]CacheEntry,
  count: usize,
}

pub fn cache(database: Database) Cache {
  return Cache{ database: database }
}

// The statement for sql, prepared on first use. It fails when the SQL does
// not prepare, holds no statement (InvalidInput), or the cache is full
// (Capacity).
pub fn cached(statements: *Cache, sql: []const u8) *Statement!io.IoErr {
  for i in 0..statements.count {
    entry := &statements.entries[i]
    if entry.sql.len == sql.len && (sql.len == 0 || &entry.sql[0] == &sql[0] || equal(entry.sql, sql)) {
      return &entry.statement
    }
  }
  if statements.count == CacheSize { fail .Capacity }
  prepared := try prepare(statements.database, sql)
  if prepared.empty { fail .InvalidInput }
  entry := &statements.entries[statements.count]
  entry.* = CacheEntry{ sql: sql, statement: prepared.statement }
  statements.count += 1
  return &entry.statement
}

fn readable(statement: *const Statement, index: usize) bool {
  return statement != nil && statement.handle != nil && statement.state == State.Row && index < statement.columns
}

// Finalizes every cached statement. Call before closing the database.
pub fn cache_close(statements: *Cache) {
  for i in 0..statements.count {
    finalize(&statements.entries[i].statement)
  }
  statements.count = 0
}

fn equal(left: []const u8, right: []const u8) bool {
  for i in 0..left.len {
    if left[i] != right[i] { return false }
  }
  return true
}

// A connection for one thread, ready to use: no SQLite mutex (only its
// thread may use it), busy_wait for other connections' writes, and each
// schema statement run (CREATE TABLE IF NOT EXISTS ..., PRAGMA ...). On
// failure the connection is closed.
pub fn open_schema(path: []const u8, schema: []const []const u8) Database!io.IoErr {
  scratch: [1024]u8
  database := try open_with_options(path, scratch[..], OpenOptions{ caller_serialized: true })
  errdefer close(database) catch {}
  for sql in schema {
    try execute(database, sql, scratch[..])
  }
  try busy_wait(database)
  return database
}

// Calls write for each of rows inside one IMMEDIATE transaction and commits.
// When it cannot commit, the transaction is rolled back; write records each
// row's own outcome.
pub fn transaction<R>(database: Database, rows: []R, write: fn(*R)) !io.IoErr {
  try begin(database, TransactionMode.Immediate)
  errdefer rollback(database) catch {}
  for i in 0..rows.len {
    write(&rows[i])
  }
  try commit(database)
}
