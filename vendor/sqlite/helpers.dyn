use "std/mem"

// Shorter forms for the usual statement life: run a write, read a first row,
// walk rows. Each takes the status, and each gives the statement back ready
// for its next use, so the caller checks the status once where it matters.

// Binds values to parameters 1, 2, ... (see bind_values), steps to the end
// and gives the statement back. To react to a constraint (such as a UNIQUE
// column), give the call its own status and ask constraint(&status.failure).
pub fn run(status: *fail.Status, statement: *Statement, values: ...any) {
  done(statement)
  bind_list(status, statement, values)
  for !status.failed {
    if step(status, statement) != State.Row { break }
  }
  done(statement)
}

// Binds values and steps to the first row: true when a row is ready for the
// column readers below. Read it, then done(statement), or defer that.
pub fn first(status: *fail.Status, statement: *Statement, values: ...any) bool {
  done(statement)
  bind_list(status, statement, values)
  return step(status, statement) == State.Row
}

// Binds values for a query walked with next: for sqlite.next(&status, statement) { ... }.
// Call done(statement) after the walk, or defer it.
pub fn query(status: *fail.Status, statement: *Statement, values: ...any) {
  done(statement)
  bind_list(status, statement, values)
}

// Steps to the next row; false at the end or after a failure.
pub fn next(status: *fail.Status, statement: *Statement) bool {
  return step(status, statement) == State.Row
}

// Column index of the current row as an integer, converted the way SQLite
// converts (NULL is 0, text is parsed, a real is truncated); 0 off a row.
pub fn integer(statement: *const Statement, index: i32) i64 {
  if !readable(statement, index) { return 0 }
  return sqlite_column_integer(statement.handle, index)
}
// Column index of the current row as bytes, borrowed until the next step:
// text and blobs as stored, NULL empty, numbers as SQLite writes them.
pub fn bytes(statement: *const Statement, index: i32) []const u8 {
  if !readable(statement, index) { return "" }
  // Text and blobs come back as stored; column_bytes must follow column_blob.
  pointer := sqlite_column_blob(statement.handle, index)
  length := sqlite_column_bytes(statement.handle, index)
  if pointer == nil || length <= 0 { return "" }
  return #slice(pointer, length)
}
pub fn text(arena: *mem.Arena, statement: *const Statement, index: i32) []const u8 {
  value := bytes(statement, index)
  copy := mem.push_bytes_uninit(arena, #len(value))
  _ = mem.copy(copy, value)
  return copy
}

// Whether failure is SQLite's SQLITE_CONSTRAINT, such as a UNIQUE column.
pub fn constraint(failure: *const fail.Failure) bool {
  return failure.kind == fail.Kind.InvalidInput && (failure.native & 255) == 19
}

// Prepared statements of one connection, keyed by their SQL: each is
// prepared on first use and kept. sql must outlive the cache (a string
// literal does).
pub const CacheSize: usize = 64

struct CacheEntry { sql: []const u8, statement: Statement }

pub struct Cache {
  database: Database,
  entries: [CacheSize]CacheEntry,
  count: usize,
}

pub fn cache(database: Database) Cache {
  return Cache{ database: database }
}

// The statement for sql, prepared on first use. nil after a failure: the SQL
// does not prepare, holds no statement (InvalidInput), or the cache is full
// (Capacity).
pub fn cached(status: *fail.Status, statements: *Cache, sql: []const u8) *Statement {
  if status.failed { return nil }
  for i in 0..statements.count {
    entry := &statements.entries[i]
    if #len(entry.sql) == #len(sql) && (#len(sql) == 0 || &entry.sql[0] == &sql[0] || equal(entry.sql, sql)) {
      return &entry.statement
    }
  }
  if statements.count == CacheSize {
    fail.set(status, fail.make(fail.Kind.Capacity, "prepare", "", "the statement cache is full"))
    return nil
  }
  prepared := prepare(status, statements.database, sql)
  if status.failed { return nil }
  if prepared.empty {
    fail.invalid(status, "prepare", "", "the SQL holds no statement")
    return nil
  }
  entry := &statements.entries[statements.count]
  entry.* = CacheEntry{ sql: sql, statement: prepared.statement }
  statements.count += 1
  return &entry.statement
}

fn readable(statement: *const Statement, index: i32) bool {
  return statement.handle != nil && statement.state == State.Row && index >= 0 && index < statement.columns
}

// Finalizes every cached statement. Call before closing the database.
pub fn cache_close(statements: *Cache) {
  for i in 0..statements.count {
    finalize(&statements.entries[i].statement)
  }
  statements.count = 0
}

fn equal(left: []const u8, right: []const u8) bool {
  for i in 0..#len(left) {
    if left[i] != right[i] { return false }
  }
  return true
}

// A connection for one thread, ready to use: no SQLite mutex (only its
// thread may use it), busy_wait for other connections' writes, and each
// schema statement run (CREATE TABLE IF NOT EXISTS ..., PRAGMA ...). On
// failure the connection is closed and nil returned.
pub fn open_schema(status: *fail.Status, path: []const u8, schema: []const []const u8) Database {
  scratch: [1024]u8
  database := open_with_options(status, path, scratch[..], OpenOptions{ caller_serialized: true })
  for sql in schema {
    execute(status, database, sql, scratch[..])
  }
  busy_wait(status, database)
  if status.failed {
    closing: fail.Status
    close(&closing, database)
    return nil
  }
  return database
}

// Calls write for each of rows inside one IMMEDIATE transaction and commits.
// When it cannot begin or commit, the transaction is rolled back; write
// records each row's own outcome.
pub fn transaction(status: *fail.Status, database: Database, rows: []$R, write: fn(*$R)) {
  begin(status, database, TransactionMode.Immediate)
  if status.failed { return }
  for i in 0..#len(rows) {
    write(&rows[i])
  }
  commit(status, database)
  if status.failed {
    rolling: fail.Status
    rollback(&rolling, database)
  }
}
