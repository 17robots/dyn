use "std/mem"
use "std/fail"
#link("dyn_stb")
// Integer skyline packing, no rotation. Caller owns rectangles; scratch arena is
// rewound before return. Inputs must not overlap newly allocated scratch storage.
pub struct Rectangle { width: i32, height: i32, x: i32, y: i32, was_packed: i32 }
// The count packed; was_packed marks each one. Not every rectangle fitting is
// not a failure: compare the count. Bad sizes fail with InvalidInput, too
// little scratch with Capacity.
pub fn pack(scratch: *mem.Arena, status: *fail.Status, width: i32, height: i32, rectangles: []Rectangle) usize {
  if status.failed { return 0 }
  if scratch == nil {
    fail.invalid(status, "pack rectangles", "", "no scratch arena")
    return 0
  }
  size := native_size(width, #len(rectangles))
  if size == 0 {
    fail.invalid(status, "pack rectangles", "", "bad width or count")
    return 0
  }
  mark := mem.arena_mark(scratch)
  defer mem.arena_rewind(scratch, mark)
  work := mem.arena_try_push(scratch, size, 64)
  if !work.ok {
    fail.set(status, fail.make(fail.Kind.Capacity, "pack rectangles", "", "the scratch arena is full"))
    return 0
  }
  data: *Rectangle = nil
  if #len(rectangles) != 0 {
    data = &rectangles[0]
  }
  code := native_pack(width, height, data, #len(rectangles), #cast(rawptr, work.memory), size)
  if code < 0 {
    fail.invalid(status, "pack rectangles", "", "bad rectangle sizes")
    return 0
  }
  count: usize = 0
  if code >= 0 {
    for rectangle in rectangles {
      if rectangle.was_packed != 0 {
        count += 1
      }
    }
  }
  return count
}
extern fn native_size "dyn_stb_pack_size"(width: i32, count: usize) usize
extern fn native_pack "dyn_stb_pack"(width: i32, height: i32, rectangles: *Rectangle, count: usize, work: rawptr, size: usize) i32
