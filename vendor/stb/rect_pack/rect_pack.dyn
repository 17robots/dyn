use io "std/io"
use "std/mem"
#link("dyn_stb")
// Integer skyline packing, no rotation. Caller owns rectangles; scratch arena is
// rewound before return. Inputs must not overlap newly allocated scratch storage.
pub struct Rectangle { width: i32, height: i32, x: i32, y: i32, was_packed: i32 }
// The count packed; was_packed marks each one. A partial fit is not a
// failure: compare the count. Bad sizes fail with InvalidInput. An exhausted
// scratch arena panics.
pub fn pack(scratch: *mem.Arena, width: usize, height: usize, rectangles: []Rectangle) usize!io.IoErr {
  if scratch == nil { fail .InvalidInput }
  if width > 32768 || height > 32768 { fail .InvalidInput }
  size := native_size(#cast(i32, width), rectangles.len)
  if size == 0 { fail .InvalidInput }
  mark := mem.arena_mark(scratch)
  defer mem.arena_rewind(scratch, mark)
  work := aligned_work(scratch, size)
  data: *Rectangle = nil
  if rectangles.len != 0 {
    data = &rectangles[0]
  }
  code := native_pack(#cast(i32, width), #cast(i32, height), data, rectangles.len, #cast(rawptr, &work[0]), size)
  if code < 0 { fail .InvalidInput }
  count: usize = 0
  for rectangle in rectangles {
    if rectangle.was_packed != 0 {
      count += 1
    }
  }
  return count
}
extern fn native_size "dyn_stb_pack_size"(width: i32, count: usize) usize
extern fn native_pack "dyn_stb_pack"(width: i32, height: i32, rectangles: *Rectangle, count: usize, work: rawptr, size: usize) i32

// size bytes from arena at a 64-byte boundary, for provider work memory.
fn aligned_work(arena: *mem.Arena, size: usize) []u8 {
  if size > #max(usize) - 63 {
    #panic("work size overflow")
  }
  storage := mem.push_bytes(arena, size + 63)
  skip := (64 - (#cast(usize, &storage[0]) & 63)) & 63
  return storage[skip..skip + size]
}
