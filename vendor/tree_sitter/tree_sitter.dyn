use io "std/io"
use "std/c"
#link("tree-sitter")

// Tree-sitter C ABI. Parser/Tree are provider-owned; Node borrows its Tree.
pub type Parser = rawptr
pub type Tree = rawptr
pub type Language = rawptr
pub struct Point { row: u32, column: u32 }
pub struct Edit { start_byte: u32, old_end_byte: u32, new_end_byte: u32, start_point: Point, old_end_point: Point, new_end_point: Point }
pub struct Node { context: [4]u32, id: rawptr, tree: Tree }

pub fn parser_create_owned() Parser!io.IoErr {
  parser := native_parser_new()
  if parser == nil { fail .Capacity }
  return parser
}
pub fn parser_destroy_owned(parser: Parser) {
  if parser != nil {
    native_parser_delete(parser)
  }
}
// A grammar built for an incompatible Tree-sitter ABI fails with Unsupported.
pub fn parser_language(parser: Parser, language: Language) !io.IoErr {
  if parser == nil || language == nil { fail .InvalidInput }
  if !native_set_language(parser, language) { fail .Unsupported }
}
// Source borrowed only during call. Old tree remains caller-owned. Edit it first
// when reparsing changed source. Syntax errors are represented in a successful
// tree; the tree is the caller's to destroy. Without a language, or when the
// parse is cancelled, fails with InvalidState.
pub fn parse(parser: Parser, old_tree: Tree, source: []const u8) Tree!io.IoErr {
  if parser == nil || source.len > 4294967295 { fail .InvalidInput }
  empty: [1]u8
  pointer: *const u8 = &empty[0]
  if source.len > 0 {
    pointer = &source[0]
  }
  tree := native_parse(parser, old_tree, pointer, #cast(u32, source.len))
  if tree == nil { fail .InvalidInput }
  return tree
}
pub fn tree_destroy_owned(tree: Tree) {
  if tree != nil {
    native_tree_delete(tree)
  }
}
pub fn tree_copy_owned(tree: Tree) Tree!io.IoErr {
  if tree == nil { fail .InvalidInput }
  copy := native_tree_copy(tree)
  if copy == nil { fail .Capacity }
  return copy
}
// Coordinates are UTF-8 byte columns, not code points. Nodes obtained before an
// edit must be reacquired (this wrapper does not expose ts_node_edit).
// An edit whose start comes after its ends fails with InvalidInput.
pub fn tree_edit(tree: Tree, edit: *const Edit) !io.IoErr {
  if tree == nil || edit == nil || edit.start_byte > edit.old_end_byte || edit.start_byte > edit.new_end_byte ||
    !point_before(edit.start_point, edit.old_end_point) || !point_before(edit.start_point, edit.new_end_point) {
    fail .InvalidInput
  }
  native_tree_edit(tree, edit)
}
fn point_before(a: Point, b: Point) bool {
  return a.row < b.row || (a.row == b.row && a.column <= b.column)
}
pub fn root(tree: Tree) Node {
  if tree == nil { return Node{} }
  return native_root(tree)
}
pub fn node_valid(node: Node) bool {
  return node.id != nil && node.tree != nil
}
pub fn node_start(node: Node) usize {
  if !node_valid(node) { return 0 }
  return #cast(usize, native_start(node))
}
pub fn node_end(node: Node) usize {
  if !node_valid(node) { return 0 }
  return #cast(usize, native_end(node))
}
pub fn node_has_error(node: Node) bool {
  return node_valid(node) && native_has_error(node)
}
pub fn child_count(node: Node) usize {
  if !node_valid(node) { return 0 }
  return #cast(usize, native_child_count(node))
}
pub fn child(node: Node, index: usize) Node {
  if !node_valid(node) || index > 4294967295 { return Node{} }
  return native_child(node, #cast(u32, index))
}
// Type name borrows grammar storage; grammar must remain loaded.
// The node's grammar name; empty for an invalid node.
pub fn node_type(node: Node, maximum: usize) []const u8 {
  if !node_valid(node) { return "" }
  return c.bytes_from_string(native_type(node), maximum) catch ""
}
