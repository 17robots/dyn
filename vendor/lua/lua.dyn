use "std/fail"
#link("lua5.4")
// Lua 5.4 default ABI (64-bit integers, double numbers). State is provider-owned.
// No standard libraries are opened automatically. This is not a sandbox.
pub type State = rawptr
pub fn create_owned(status: *fail.Status) State {
  if status == nil { return create_owned(&fail.Status{}) }
  if status.failed { return nil }
  state := native_new()
  if state == nil {
    fail.set(status, fail.make(fail.Kind.Capacity, "create Lua state", "", "out of memory"))
  }
  return state
}
pub fn destroy_owned(state: State) {
  if state != nil {
    native_close(state)
  }
}
pub fn stack_size(state: State) usize {
  if state == nil { return 0 }
  return #cast(usize, native_top(state))
}
// Only remove values; never grow the stack through this API. Popping more
// than the stack holds fails with InvalidInput and changes nothing.
pub fn pop(status: *fail.Status, state: State, count: usize) {
  if status == nil {
    pop(&fail.Status{}, state, count)
    return
  }
  if status.failed { return }
  if state == nil || count > #cast(usize, native_top(state)) {
    fail.invalid(status, "pop Lua stack", "", "no state, or more values than the stack holds")
    return
  }
  native_settop(state, native_top(state) - #cast(i32, count))
}
// Text-only protected execution. On success leaves exactly one result (nil if
// chunk returns none); on failure leaves one error. Earlier stack values survive.
// Chunk source borrowed only during call. Caller must pop result/error.
// A syntax error fails with InvalidInput, a runtime error with System, running
// out of memory with Capacity; the message is Lua's and native its code. With
// no state, or no stack room, the stack is unchanged.
pub fn execute(status: *fail.Status, state: State, source: []const u8) {
  if status == nil {
    execute(&fail.Status{}, state, source)
    return
  }
  if status.failed { return }
  if state == nil {
    fail.invalid(status, "run Lua", "", "no state")
    return
  }
  if native_checkstack(state, 2) == 0 {
    fail.set(status, fail.make(fail.Kind.Capacity, "run Lua", "", "no stack room"))
    return
  }
  name: [4]u8 = ['d', 'y', 'n', 0]
  mode: [2]u8 = ['t', 0]
  empty: [1]u8
  pointer: *const u8 = &empty[0]
  if source.len > 0 {
    pointer = &source[0]
  }
  code := native_load(state, pointer, source.len, &name[0], &mode[0])
  if code == 0 {
    code = native_pcall(state, 0, 1, 0, 0, nil)
  }
  if code != 0 {
    kind := fail.Kind.System
    if code == 3 {
      kind = fail.Kind.InvalidInput
    } else if code == 4 {
      kind = fail.Kind.Capacity
    }
    message: []const u8 = "Lua failed"
    if native_type(state, -1) == 4 {
      length: usize = 0
      text := native_string(state, -1, &length)
      if text != nil {
        message = #slice(text, length)
      }
    }
    failure := fail.make(kind, "run Lua", "", message)
    failure.native = code
    fail.set(status, failure)
  }
}
fn valid_index(state: State, index: i32) bool {
  if state == nil || index == 0 { return false }
  top := native_top(state)
  return (index > 0 && index <= top) || (index < 0 && index >= 0 - top)
}
// A missing slot or a value that is not an integer fails with InvalidInput.
pub fn integer(status: *fail.Status, state: State, index: i32) i64 {
  if status == nil { return integer(&fail.Status{}, state, index) }
  if status.failed { return 0 }
  if !valid_index(state, index) {
    fail.invalid(status, "read Lua value", "", "no such stack slot")
    return 0
  }
  ok: i32 = 0
  value := native_integer(state, index, &ok)
  if ok == 0 {
    fail.invalid(status, "read Lua value", "", "not an integer")
    return 0
  }
  return value
}
// Borrows an existing string while it remains on the stack and state stays alive.
// No numeric conversion: that could allocate outside a protected Lua call.
// A missing slot or a value that is not a string fails with InvalidInput.
pub fn bytes(status: *fail.Status, state: State, index: i32) []const u8 {
  if status == nil { return bytes(&fail.Status{}, state, index) }
  if status.failed { return "" }
  if !valid_index(state, index) || native_type(state, index) != 4 {
    fail.invalid(status, "read Lua value", "", "not a string")
    return ""
  }
  length: usize = 0
  pointer := native_string(state, index, &length)
  if pointer == nil {
    fail.invalid(status, "read Lua value", "", "not a string")
    return ""
  }
  return #slice(pointer, length)
}
extern fn native_new "luaL_newstate"() State
extern fn native_close "lua_close"(state: State)
extern fn native_top "lua_gettop"(state: State) i32
extern fn native_settop "lua_settop"(state: State, index: i32)
extern fn native_checkstack "lua_checkstack"(state: State, extra: i32) i32
extern fn native_load "luaL_loadbufferx"(state: State, source: *const u8, size: usize, name: *const u8, mode: *const u8) i32
extern fn native_pcall "lua_pcallk"(state: State, nargs: i32, nresults: i32, error_function: i32, context: isize, continuation: rawptr) i32
extern fn native_integer "lua_tointegerx"(state: State, index: i32, ok: *i32) i64
extern fn native_type "lua_type"(state: State, index: i32) i32
extern fn native_string "lua_tolstring"(state: State, index: i32, length: *usize) *const u8
