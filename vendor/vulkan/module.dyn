use "std/c"
use "std/mem"
#link("vulkan")

// Vulkan deliberately exposes one stable loader seam. Applications generate typed
// commands/structures for the header version they target instead of coupling SDK releases.
pub type Instance = rawptr
pub type Procedure = rawptr
pub struct ProcedureResult { value: Procedure, ok: bool }

pub fn make_version(variant, major, minor, patch: u32) u32 {
  return (variant << 29) | (major << 22) | (minor << 12) | patch
}
pub fn version_variant(version: u32) u32 { return version >> 29 }
pub fn version_major(version: u32) u32 { return (version >> 22) & 127 }
pub fn version_minor(version: u32) u32 { return (version >> 12) & 1023 }
pub fn version_patch(version: u32) u32 { return version & 4095 }

// name_storage receives a temporary NUL-terminated copy. Returned function is loader-owned.
pub fn procedure_into(instance: Instance, name: []const u8, name_storage: []u8) ProcedureResult {
  encoded := c.string_from_bytes(name_storage, name)
  if !encoded.ok { return ProcedureResult{} }
  value := vulkan_get_instance_proc_address(instance, encoded.value)
  return ProcedureResult{ value: value, ok: value != nil }
}
pub fn procedure(arena: *mem.Arena, instance: Instance, name: []const u8) ProcedureResult {
  mark := mem.arena_mark(arena)
  encoded := c.string_from_arena(arena, name)
  if !encoded.ok { return ProcedureResult{} }
  value := vulkan_get_instance_proc_address(instance, encoded.value)
  mem.arena_reset_to(arena, mark)
  return ProcedureResult{ value: value, ok: value != nil }
}
pub fn global_procedure_into(name: []const u8, storage: []u8) ProcedureResult { return procedure_into(nil, name, storage) }
pub fn global_procedure(arena: *mem.Arena, name: []const u8) ProcedureResult { return procedure(arena, nil, name) }
