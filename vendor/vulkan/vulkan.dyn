use io "std/io"
use "std/c"
#link("vulkan")

// Vulkan deliberately exposes one stable loader seam. Applications generate typed
// commands/structures for the header version they target instead of coupling SDK releases.
pub type Instance = rawptr
pub type Procedure = rawptr

pub fn make_version(variant, major, minor, patch: u32) u32 {
  return (variant << 29) | (major << 22) | (minor << 12) | patch
}
pub fn version_variant(version: u32) u32 {
  return version >> 29
}
pub fn version_major(version: u32) u32 {
  return (version >> 22) & 127
}
pub fn version_minor(version: u32) u32 {
  return (version >> 12) & 1023
}
pub fn version_patch(version: u32) u32 {
  return version & 4095
}

// name_buffer receives a temporary NUL-terminated copy. Returned function is
// loader-owned. A name the loader does not know fails with NotFound.
pub fn procedure(instance: Instance, name: []const u8, name_buffer: []u8) Procedure!io.IoErr {
  encoded := try c.string_into(name_buffer, name)
  value := vulkan_get_instance_proc_address(instance, encoded)
  if value == nil { fail .NotFound }
  return value
}
pub fn global_procedure(name: []const u8, buffer: []u8) Procedure!io.IoErr {
  return try procedure(nil, name, buffer)
}
