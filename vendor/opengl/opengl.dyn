pub const BlendEquationAlpha: u32 = 34877
pub const ActiveTexture: u32 = 34016
pub const TextureBinding2d: u32 = 32873
pub const SamplerBinding: u32 = 35097
pub const ScissorBox: u32 = 3088
pub const Viewport: u32 = 2978
pub const CurrentProgram: u32 = 35725
pub const VertexArrayBinding: u32 = 34229
pub const ArrayBufferBinding: u32 = 34964
pub const DepthTest: u32 = 2929
pub const CullFace: u32 = 2884
pub const StencilTest: u32 = 2960
pub const FramebufferSrgb: u32 = 36281
pub const ColorLogicOp: u32 = 3058
pub const RasterizerDiscard: u32 = 35977
pub const Dither: u32 = 3024
pub const FrontAndBack: u32 = 1032
pub const Fill: u32 = 6914
pub const PolygonSmooth: u32 = 2881
pub const Multisample: u32 = 32925
pub const SampleAlphaToCoverage: u32 = 32926
pub const SampleCoverage: u32 = 32928
pub const SampleMask: u32 = 36433
pub const MaxTextureSize: u32 = 3379
pub const MaxClipDistances: u32 = 3378
pub const ClipDistance0: u32 = 12288
pub struct Api {
  color_mask: fn(u8, u8, u8, u8),
  polygon_mode: fn(u32, u32),
  enable: fn(u32),
  disable: fn(u32),
  is_enabled: fn(u32) u8,
  scissor: fn(i32, i32, i32, i32),
  blend_func_separate: fn(u32, u32, u32, u32),
  blend_equation_separate: fn(u32, u32),
  active_texture: fn(u32),
  bind_sampler: fn(u32, u32),
  gen_textures: fn(i32, *u32),
  bind_texture: fn(u32, u32),
  delete_textures: fn(i32, *const u32),
  tex_image_2d: fn(u32, i32, i32, i32, i32, i32, u32, u32, rawptr),
  tex_sub_image_2d: fn(u32, i32, i32, i32, i32, i32, u32, u32, rawptr),
  tex_parameter_i: fn(u32, u32, i32),
  pixel_store_i: fn(u32, i32),
  get_uniform_location: fn(u32, *const u8) i32,
  uniform_1i: fn(i32, i32),
  uniform_2f: fn(i32, f32, f32),
  uniform_4f: fn(i32, f32, f32, f32, f32),

  clear_color: fn(f32, f32, f32, f32),
  clear: fn(u32),
  viewport: fn(i32, i32, i32, i32),
  get_error: fn() u32,
  get_integer: fn(u32, *i32),
  create_shader: fn(u32) u32,
  shader_source: fn(u32, i32, **const u8, *const i32),
  compile_shader: fn(u32),
  get_shader_iv: fn(u32, u32, *i32),
  get_shader_log: fn(u32, i32, *i32, *u8),
  delete_shader: fn(u32),
  create_program: fn() u32,
  attach_shader: fn(u32, u32),
  link_program: fn(u32),
  get_program_iv: fn(u32, u32, *i32),
  get_program_log: fn(u32, i32, *i32, *u8),
  use_program: fn(u32),
  delete_program: fn(u32),
  gen_vertex_arrays: fn(i32, *u32),
  bind_vertex_array: fn(u32),
  delete_vertex_arrays: fn(i32, *const u32),
  gen_buffers: fn(i32, *u32),
  bind_buffer: fn(u32, u32),
  buffer_data: fn(u32, isize, rawptr, u32),
  delete_buffers: fn(i32, *const u32),
  enable_vertex_attribute: fn(u32),
  vertex_attribute: fn(u32, i32, u32, u8, i32, rawptr),
  draw_arrays: fn(u32, i32, i32),
  read_pixels: fn(i32, i32, i32, i32, u32, u32, rawptr),
}
fn symbol(loader: Loader, name: []const u8) rawptr {
  buffer: [64]u8
  converting: fail.Status
  encoded := c.string_into(&converting, buffer[..], name)
  if converting.failed { return nil }
  return loader(encoded)
}
// Loader must be usable synchronously with a current GL 3.3+ core context.
// A missing function fails with NotFound, its name as the failure's path, and
// returns no callable table.
fn missing(status: *fail.Status, name: []const u8) Api {
  message: []const u8 = "the OpenGL loader lacks this function"
  if name[0] != 'g' {
    message = "no loader"
  }
  fail.set(status, fail.make(fail.Kind.NotFound, "load OpenGL", name, message))
  return Api{}
}
pub fn load(status: *fail.Status, loader: Loader) Api {
  if status == nil { return load(&fail.Status{}, loader) }
  if status.failed { return Api{} }
  if loader == nil { return missing(status, "loader") }
  api := Api{}
  api.clear_color = #cast(fn(f32, f32, f32, f32), symbol(loader, "glClearColor"))
  if api.clear_color == nil { return missing(status, "glClearColor") }
  api.clear = #cast(fn(u32), symbol(loader, "glClear"))
  if api.clear == nil { return missing(status, "glClear") }
  api.viewport = #cast(fn(i32, i32, i32, i32), symbol(loader, "glViewport"))
  if api.viewport == nil { return missing(status, "glViewport") }
  api.get_error = #cast(fn() u32, symbol(loader, "glGetError"))
  if api.get_error == nil { return missing(status, "glGetError") }
  api.create_shader = #cast(fn(u32) u32, symbol(loader, "glCreateShader"))
  if api.create_shader == nil { return missing(status, "glCreateShader") }
  api.shader_source = #cast(fn(u32, i32, **const u8, *const i32), symbol(loader, "glShaderSource"))
  if api.shader_source == nil { return missing(status, "glShaderSource") }
  api.compile_shader = #cast(fn(u32), symbol(loader, "glCompileShader"))
  if api.compile_shader == nil { return missing(status, "glCompileShader") }
  api.get_shader_iv = #cast(fn(u32, u32, *i32), symbol(loader, "glGetShaderiv"))
  if api.get_shader_iv == nil { return missing(status, "glGetShaderiv") }
  api.get_shader_log = #cast(fn(u32, i32, *i32, *u8), symbol(loader, "glGetShaderInfoLog"))
  if api.get_shader_log == nil { return missing(status, "glGetShaderInfoLog") }
  api.delete_shader = #cast(fn(u32), symbol(loader, "glDeleteShader"))
  if api.delete_shader == nil { return missing(status, "glDeleteShader") }
  api.create_program = #cast(fn() u32, symbol(loader, "glCreateProgram"))
  if api.create_program == nil { return missing(status, "glCreateProgram") }
  api.attach_shader = #cast(fn(u32, u32), symbol(loader, "glAttachShader"))
  if api.attach_shader == nil { return missing(status, "glAttachShader") }
  api.link_program = #cast(fn(u32), symbol(loader, "glLinkProgram"))
  if api.link_program == nil { return missing(status, "glLinkProgram") }
  api.get_program_iv = #cast(fn(u32, u32, *i32), symbol(loader, "glGetProgramiv"))
  if api.get_program_iv == nil { return missing(status, "glGetProgramiv") }
  api.get_program_log = #cast(fn(u32, i32, *i32, *u8), symbol(loader, "glGetProgramInfoLog"))
  if api.get_program_log == nil { return missing(status, "glGetProgramInfoLog") }
  api.use_program = #cast(fn(u32), symbol(loader, "glUseProgram"))
  if api.use_program == nil { return missing(status, "glUseProgram") }
  api.delete_program = #cast(fn(u32), symbol(loader, "glDeleteProgram"))
  if api.delete_program == nil { return missing(status, "glDeleteProgram") }
  api.gen_vertex_arrays = #cast(fn(i32, *u32), symbol(loader, "glGenVertexArrays"))
  if api.gen_vertex_arrays == nil { return missing(status, "glGenVertexArrays") }
  api.bind_vertex_array = #cast(fn(u32), symbol(loader, "glBindVertexArray"))
  if api.bind_vertex_array == nil { return missing(status, "glBindVertexArray") }
  api.delete_vertex_arrays = #cast(fn(i32, *const u32), symbol(loader, "glDeleteVertexArrays"))
  if api.delete_vertex_arrays == nil { return missing(status, "glDeleteVertexArrays") }
  api.gen_buffers = #cast(fn(i32, *u32), symbol(loader, "glGenBuffers"))
  if api.gen_buffers == nil { return missing(status, "glGenBuffers") }
  api.bind_buffer = #cast(fn(u32, u32), symbol(loader, "glBindBuffer"))
  if api.bind_buffer == nil { return missing(status, "glBindBuffer") }
  api.buffer_data = #cast(fn(u32, isize, rawptr, u32), symbol(loader, "glBufferData"))
  if api.buffer_data == nil { return missing(status, "glBufferData") }
  api.delete_buffers = #cast(fn(i32, *const u32), symbol(loader, "glDeleteBuffers"))
  if api.delete_buffers == nil { return missing(status, "glDeleteBuffers") }
  api.enable_vertex_attribute = #cast(fn(u32), symbol(loader, "glEnableVertexAttribArray"))
  if api.enable_vertex_attribute == nil { return missing(status, "glEnableVertexAttribArray") }
  api.vertex_attribute = #cast(fn(u32, i32, u32, u8, i32, rawptr), symbol(loader, "glVertexAttribPointer"))
  if api.vertex_attribute == nil { return missing(status, "glVertexAttribPointer") }
  api.draw_arrays = #cast(fn(u32, i32, i32), symbol(loader, "glDrawArrays"))
  if api.draw_arrays == nil { return missing(status, "glDrawArrays") }
  api.read_pixels = #cast(fn(i32, i32, i32, i32, u32, u32, rawptr), symbol(loader, "glReadPixels"))
  if api.read_pixels == nil { return missing(status, "glReadPixels") }
  api.get_integer = #cast(fn(u32, *i32), symbol(loader, "glGetIntegerv"))
  if api.get_integer == nil { return missing(status, "glGetIntegerv") }
  api.enable = #cast(fn(u32), symbol(loader, "glEnable"))
  if api.enable == nil { return missing(status, "glEnable") }
  api.disable = #cast(fn(u32), symbol(loader, "glDisable"))
  if api.disable == nil { return missing(status, "glDisable") }
  api.is_enabled = #cast(fn(u32) u8, symbol(loader, "glIsEnabled"))
  if api.is_enabled == nil { return missing(status, "glIsEnabled") }
  api.scissor = #cast(fn(i32, i32, i32, i32), symbol(loader, "glScissor"))
  if api.scissor == nil { return missing(status, "glScissor") }
  api.blend_func_separate = #cast(fn(u32, u32, u32, u32), symbol(loader, "glBlendFuncSeparate"))
  if api.blend_func_separate == nil { return missing(status, "glBlendFuncSeparate") }
  api.blend_equation_separate = #cast(fn(u32, u32), symbol(loader, "glBlendEquationSeparate"))
  if api.blend_equation_separate == nil { return missing(status, "glBlendEquationSeparate") }
  api.active_texture = #cast(fn(u32), symbol(loader, "glActiveTexture"))
  if api.active_texture == nil { return missing(status, "glActiveTexture") }
  api.bind_sampler = #cast(fn(u32, u32), symbol(loader, "glBindSampler"))
  if api.bind_sampler == nil { return missing(status, "glBindSampler") }
  api.gen_textures = #cast(fn(i32, *u32), symbol(loader, "glGenTextures"))
  if api.gen_textures == nil { return missing(status, "glGenTextures") }
  api.bind_texture = #cast(fn(u32, u32), symbol(loader, "glBindTexture"))
  if api.bind_texture == nil { return missing(status, "glBindTexture") }
  api.delete_textures = #cast(fn(i32, *const u32), symbol(loader, "glDeleteTextures"))
  if api.delete_textures == nil { return missing(status, "glDeleteTextures") }
  api.tex_image_2d = #cast(fn(u32, i32, i32, i32, i32, i32, u32, u32, rawptr), symbol(loader, "glTexImage2D"))
  if api.tex_image_2d == nil { return missing(status, "glTexImage2D") }
  api.tex_sub_image_2d = #cast(fn(u32, i32, i32, i32, i32, i32, u32, u32, rawptr), symbol(loader, "glTexSubImage2D"))
  if api.tex_sub_image_2d == nil { return missing(status, "glTexSubImage2D") }
  api.tex_parameter_i = #cast(fn(u32, u32, i32), symbol(loader, "glTexParameteri"))
  if api.tex_parameter_i == nil { return missing(status, "glTexParameteri") }
  api.pixel_store_i = #cast(fn(u32, i32), symbol(loader, "glPixelStorei"))
  if api.pixel_store_i == nil { return missing(status, "glPixelStorei") }
  api.get_uniform_location = #cast(fn(u32, *const u8) i32, symbol(loader, "glGetUniformLocation"))
  if api.get_uniform_location == nil { return missing(status, "glGetUniformLocation") }
  api.uniform_1i = #cast(fn(i32, i32), symbol(loader, "glUniform1i"))
  if api.uniform_1i == nil { return missing(status, "glUniform1i") }
  api.uniform_2f = #cast(fn(i32, f32, f32), symbol(loader, "glUniform2f"))
  if api.uniform_2f == nil { return missing(status, "glUniform2f") }
  api.uniform_4f = #cast(fn(i32, f32, f32, f32, f32), symbol(loader, "glUniform4f"))
  if api.uniform_4f == nil { return missing(status, "glUniform4f") }
  api.color_mask = #cast(fn(u8, u8, u8, u8), symbol(loader, "glColorMask"))
  if api.color_mask == nil { return missing(status, "glColorMask") }
  api.polygon_mode = #cast(fn(u32, u32), symbol(loader, "glPolygonMode"))
  if api.polygon_mode == nil { return missing(status, "glPolygonMode") }
  return api
}
