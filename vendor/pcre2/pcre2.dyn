#link("pcre2-8")
// PCRE2 8-bit API. Compiled patterns and match data are provider-owned.
pub type Pattern = rawptr
pub type MatchData = rawptr
pub const Utf: u32 = 524288
pub const Ucp: u32 = 131072
pub const Caseless: u32 = 8
pub const NoMatch: i32 = -1
pub struct CompileResult { pattern: Pattern, code: i32, offset: usize, ok: bool }
pub struct MatchResult { code: i32, matched: bool, ok: bool }
pub struct Span { start: usize, end: usize, set: bool }
pub fn compile_owned(pattern: []const u8, options: u32) CompileResult {
  empty: [1]u8 = [] pointer: *const u8 = &empty[0]
  if #len(pattern) > 0 { pointer = &pattern[0] }
  code: i32 = 0 offset: usize = 0
  value := native_compile(pointer, #len(pattern), options, &code, &offset, nil)
  return CompileResult{ pattern: value, code: code, offset: offset, ok: value != nil }
}
pub fn pattern_destroy_owned(pattern: Pattern) { if pattern != nil { native_code_free(pattern) } }
pub fn match_data_create_owned(pattern: Pattern) MatchData { if pattern == nil { return nil } return native_data_create(pattern, nil) }
pub fn match_data_destroy_owned(data: MatchData) { if data != nil { native_data_free(data) } }
// Subject borrowed for call; offsets refer to caller subject. Match data is mutable
// and thread-confined. Captures are meaningful only after a successful match.
pub fn match(pattern: Pattern, data: MatchData, subject: []const u8, start: usize) MatchResult {
  if pattern == nil || data == nil || start > #len(subject) { return MatchResult{ code: -33 } }
  empty: [1]u8 = [] pointer: *const u8 = &empty[0]
  if #len(subject) > 0 { pointer = &subject[0] }
  code := native_match(pattern, pointer, #len(subject), start, 0, data, nil)
  return MatchResult{ code: code, matched: code >= 0, ok: code >= 0 || code == NoMatch }
}
pub fn capture(data: MatchData, index: u32) Span {
  if data == nil || index >= native_count(data) { return Span{} }
  offsets := native_offsets(data)
  pair := offsets[..#cast(usize) native_count(data) * 2]
  start := pair[#cast(usize) index * 2] end := pair[#cast(usize) index * 2 + 1]
  return Span{ start: start, end: end, set: start != #cast(usize) -1 && end != #cast(usize) -1 }
}
extern fn native_compile "pcre2_compile_8"(pattern: *const u8, length: usize, options: u32, code: *i32, offset: *usize, context: rawptr) Pattern
extern fn native_code_free "pcre2_code_free_8"(pattern: Pattern)
extern fn native_data_create "pcre2_match_data_create_from_pattern_8"(pattern: Pattern, context: rawptr) MatchData
extern fn native_data_free "pcre2_match_data_free_8"(data: MatchData)
extern fn native_match "pcre2_match_8"(pattern: Pattern, subject: *const u8, length: usize, start: usize, options: u32, data: MatchData, context: rawptr) i32
extern fn native_offsets "pcre2_get_ovector_pointer_8"(data: MatchData) *usize
extern fn native_count "pcre2_get_ovector_count_8"(data: MatchData) u32
