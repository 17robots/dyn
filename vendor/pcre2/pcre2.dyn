use io "std/io"
use parse "std/parse"
#link("pcre2-8")
// PCRE2 8-bit API. Compiled patterns and match data are provider-owned.
pub type Pattern = rawptr
pub type MatchData = rawptr
pub const Utf: u32 = 524288
pub const Ucp: u32 = 131072
pub const Caseless: u32 = 8
pub const NoMatch: i32 = -1
// Where a group matched, as a half-open interval.
pub struct Span { start: usize, end: usize }
extern fn native_error_message "pcre2_get_error_message_8"(code: i32, buffer: *u8, size: usize) i32

// A malformed pattern fails with Invalid at its offset.
pub fn compile_owned(pattern: []const u8, options: u32) Pattern!parse.ParseErr {
  empty: [1]u8
  pointer: *const u8 = &empty[0]
  if pattern.len > 0 {
    pointer = &pattern[0]
  }
  code: i32 = 0
  offset: usize = 0
  value := native_compile(pointer, pattern.len, options, &code, &offset, nil)
  if value == nil { fail parse.ParseErr.Invalid(offset) }
  return value
}
pub fn pattern_destroy_owned(pattern: Pattern) {
  if pattern != nil {
    native_code_free(pattern)
  }
}
pub fn match_data_create_owned(pattern: Pattern) MatchData {
  if pattern == nil { return nil }
  return native_data_create(pattern, nil)
}
pub fn match_data_destroy_owned(data: MatchData) {
  if data != nil {
    native_data_free(data)
  }
}
// Subject borrowed for call; offsets refer to caller subject. Match data is mutable
// and thread-confined. Captures are meaningful only after a match. Whether it
// matched; a match error (such as a resource limit) fails with System and
// PCRE2's code, and no pattern or data, or a start past the subject, with
// InvalidInput.
pub fn match(pattern: Pattern, data: MatchData, subject: []const u8, start: usize) bool!io.IoErr {
  if pattern == nil || data == nil || start > subject.len { fail .InvalidInput }
  empty: [1]u8
  pointer: *const u8 = &empty[0]
  if subject.len > 0 {
    pointer = &subject[0]
  }
  code := native_match(pattern, pointer, subject.len, start, 0, data, nil)
  if code < 0 && code != NoMatch { fail io.IoErr.System(code) }
  return code >= 0
}
// Where group index matched (0 is the whole match). NotFound for a group that
// took no part in the match or an index past the pattern's groups.
pub fn capture(data: MatchData, index: usize) Span!io.IoErr {
  if data == nil || index >= #cast(usize, native_count(data)) { fail .NotFound }
  offsets := native_offsets(data)
  pair := #slice(offsets, #cast(usize, native_count(data)) * 2)
  start := pair[index * 2]
  end := pair[index * 2 + 1]
  if start == #cast(usize, -1) || end == #cast(usize, -1) { fail .NotFound }
  return Span{ start: start, end: end }
}

extern fn native_compile "pcre2_compile_8"(pattern: *const u8, length: usize, options: u32, code: *i32, offset: *usize, context: rawptr) Pattern
extern fn native_code_free "pcre2_code_free_8"(pattern: Pattern)
extern fn native_data_create "pcre2_match_data_create_from_pattern_8"(pattern: Pattern, context: rawptr) MatchData
extern fn native_data_free "pcre2_match_data_free_8"(data: MatchData)
extern fn native_match "pcre2_match_8"(pattern: Pattern, subject: *const u8, length: usize, start: usize, options: u32, data: MatchData, context: rawptr) i32
extern fn native_offsets "pcre2_get_ovector_pointer_8"(data: MatchData) *usize
extern fn native_count "pcre2_get_ovector_count_8"(data: MatchData) u32
