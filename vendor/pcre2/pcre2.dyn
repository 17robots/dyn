use "std/fail"
#link("pcre2-8")
// PCRE2 8-bit API. Compiled patterns and match data are provider-owned.
pub type Pattern = rawptr
pub type MatchData = rawptr
pub const Utf: u32 = 524288
pub const Ucp: u32 = 131072
pub const Caseless: u32 = 8
pub const NoMatch: i32 = -1
// Where a group matched, as a half-open interval.
pub struct Span { start: usize, end: usize }
extern fn native_error_message "pcre2_get_error_message_8"(code: i32, buffer: *u8, size: usize) i32

// Records PCRE2's message for code, keeping the code in native.
fn provider_failed(status: *fail.Status, kind: fail.Kind, operation: []const u8, code: i32, offset: usize, located: bool) {
  text: [120]u8
  length := native_error_message(code, &text[0], text.len)
  message: []const u8 = "PCRE2 failed"
  if length > 0 {
    message = text[..#cast(usize, length)]
  }
  failure := fail.make(kind, operation, "", message)
  failure.native = code
  failure.offset = offset
  failure.has_offset = located
  fail.set(status, failure)
}
// A malformed pattern fails with InvalidInput at its offset.
pub fn compile_owned(status: *fail.Status, pattern: []const u8, options: u32) Pattern {
  if status == nil { return compile_owned(&fail.Status{}, pattern, options) }
  if status.failed { return nil }
  empty: [1]u8
  pointer: *const u8 = &empty[0]
  if pattern.len > 0 {
    pointer = &pattern[0]
  }
  code: i32 = 0
  offset: usize = 0
  value := native_compile(pointer, pattern.len, options, &code, &offset, nil)
  if value == nil {
    provider_failed(status, fail.Kind.InvalidInput, "compile pattern", code, offset, true)
  }
  return value
}
pub fn pattern_destroy_owned(pattern: Pattern) {
  if pattern != nil {
    native_code_free(pattern)
  }
}
pub fn match_data_create_owned(pattern: Pattern) MatchData {
  if pattern == nil { return nil }
  return native_data_create(pattern, nil)
}
pub fn match_data_destroy_owned(data: MatchData) {
  if data != nil {
    native_data_free(data)
  }
}
// Subject borrowed for call; offsets refer to caller subject. Match data is mutable
// and thread-confined. Captures are meaningful only after a match. Whether it
// matched; a match error (such as a resource limit) fails with System.
pub fn match(status: *fail.Status, pattern: Pattern, data: MatchData, subject: []const u8, start: usize) bool {
  if status == nil { return match(&fail.Status{}, pattern, data, subject, start) }
  if status.failed { return false }
  if pattern == nil || data == nil || start > subject.len {
    provider_failed(status, fail.Kind.InvalidInput, "match", -33, 0, false)
    return false
  }
  empty: [1]u8
  pointer: *const u8 = &empty[0]
  if subject.len > 0 {
    pointer = &subject[0]
  }
  code := native_match(pattern, pointer, subject.len, start, 0, data, nil)
  if code < 0 && code != NoMatch {
    provider_failed(status, fail.Kind.System, "match", code, 0, false)
    return false
  }
  return code >= 0
}
// Where group index matched (0 is the whole match). NotFound for a group that
// took no part in the match or an index past the pattern's groups.
pub fn capture(status: *fail.Status, data: MatchData, index: usize) Span {
  if status == nil { return capture(&fail.Status{}, data, index) }
  if status.failed { return Span{} }
  if data == nil || index >= #cast(usize, native_count(data)) { return no_capture(status) }
  offsets := native_offsets(data)
  pair := #slice(offsets, #cast(usize, native_count(data)) * 2)
  start := pair[index * 2]
  end := pair[index * 2 + 1]
  if start == #cast(usize, -1) || end == #cast(usize, -1) { return no_capture(status) }
  return Span{ start: start, end: end }
}
fn no_capture(status: *fail.Status) Span {
  fail.set(status, fail.make(fail.Kind.NotFound, "read capture", "", "the group took no part in the match"))
  return Span{}
}
extern fn native_compile "pcre2_compile_8"(pattern: *const u8, length: usize, options: u32, code: *i32, offset: *usize, context: rawptr) Pattern
extern fn native_code_free "pcre2_code_free_8"(pattern: Pattern)
extern fn native_data_create "pcre2_match_data_create_from_pattern_8"(pattern: Pattern, context: rawptr) MatchData
extern fn native_data_free "pcre2_match_data_free_8"(data: MatchData)
extern fn native_match "pcre2_match_8"(pattern: Pattern, subject: *const u8, length: usize, start: usize, options: u32, data: MatchData, context: rawptr) i32
extern fn native_offsets "pcre2_get_ovector_pointer_8"(data: MatchData) *usize
extern fn native_count "pcre2_get_ovector_count_8"(data: MatchData) u32
