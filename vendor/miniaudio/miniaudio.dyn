use "std/fail"
use "std/mem"
use "std/c"
#link("dyn_miniaudio")
// miniaudio 0.11.23. Context bytes belong to caller arena. Provider owns its
// internal allocations/workers. Close before resetting arena; never move state.
// Input bytes must remain alive and unchanged until decoder_close.
// samples counts interleaved stereo values; ended is the end of the input.
pub struct Read { samples: usize, ended: bool }

// Records miniaudio's result code: -2 bad arguments, -4 out of memory, any
// other code a system failure, kept in native.
fn audio_failed(status: *fail.Status, operation: []const u8, code: i32) {
  kind := fail.Kind.System
  message: []const u8 = "miniaudio failed"
  if code == -2 {
    kind = fail.Kind.InvalidInput
    message = "invalid argument"
  } else if code == -4 {
    kind = fail.Kind.Capacity
    message = "out of memory"
  }
  failure := fail.make(kind, operation, "", message)
  failure.native = code
  fail.set(status, failure)
}
// A decoder in arena; nil on failure. Undecodable bytes fail with System.
pub fn decoder_create(arena: *mem.Arena, status: *fail.Status, bytes: []const u8) rawptr {
  if status == nil { return decoder_create(arena, &fail.Status{}, bytes) }
  if status.failed { return nil }
  if arena == nil || #len(bytes) == 0 {
    audio_failed(status, "open decoder", -2)
    return nil
  }
  mark := mem.arena_mark(arena)
  state := native_storage(arena, decoder_size(), decoder_align())
  code := decoder_init(state, #cast(rawptr, &bytes[0]), #len(bytes))
  if code != 0 {
    mem.arena_rewind(arena, mark)
    audio_failed(status, "open decoder", code)
    return nil
  }
  return state
}
// output holds interleaved stereo; its length must be even.
pub fn decoder_read(status: *fail.Status, decoder: rawptr, output: []f32) Read {
  if status == nil { return decoder_read(&fail.Status{}, decoder, output) }
  if status.failed { return Read{} }
  if decoder == nil || #len(output) == 0 || #len(output) % 2 != 0 {
    audio_failed(status, "decode", -2)
    return Read{}
  }
  frames: u64 = 0
  code := native_read(decoder, &output[0], (#len(output) / 2), &frames)
  if code != 0 && code != -17 {
    audio_failed(status, "decode", code)
    return Read{}
  }
  return Read{ samples: #cast(usize, frames) * 2, ended: code == -17 }
}
pub extern fn decoder_close "dyn_ma_decoder_close"(decoder: rawptr)
// device=false gives deterministic offline mixing. device=true opens the default
// playback device; its availability/latency require hardware qualification.
pub fn engine_create(arena: *mem.Arena, status: *fail.Status, device: bool) rawptr {
  if status == nil { return engine_create(arena, &fail.Status{}, device) }
  if status.failed { return nil }
  if arena == nil {
    audio_failed(status, "open engine", -2)
    return nil
  }
  mark := mem.arena_mark(arena)
  state := native_storage(arena, engine_size(), engine_align())
  code := engine_init(state, device)
  if code != 0 {
    mem.arena_rewind(arena, mark)
    audio_failed(status, "open engine", code)
    return nil
  }
  return state
}
// Starts playing the file at path; buffer holds the C copy of path.
pub fn play_file(status: *fail.Status, engine: rawptr, path: []const u8, buffer: []u8) {
  if status == nil {
    play_file(&fail.Status{}, engine, path, buffer)
    return
  }
  if status.failed { return }
  if engine == nil {
    audio_failed(status, "play file", -2)
    return
  }
  encoded := c.string_into(status, buffer, path)
  if status.failed { return }
  code := native_play(engine, encoded)
  if code != 0 {
    audio_failed(status, "play file", code)
  }
}
// Offline engine only. Outputs interleaved stereo f32 at 48 kHz; the count
// of values written.
pub fn mix(status: *fail.Status, engine: rawptr, output: []f32) usize {
  if status == nil { return mix(&fail.Status{}, engine, output) }
  if status.failed { return 0 }
  if engine == nil || #len(output) == 0 || #len(output) % 2 != 0 {
    audio_failed(status, "mix", -2)
    return 0
  }
  frames: u64 = 0
  code := native_mix(engine, &output[0], (#len(output) / 2), &frames)
  if code != 0 {
    audio_failed(status, "mix", code)
    return 0
  }
  return #cast(usize, frames) * 2
}
pub extern fn engine_close "dyn_ma_engine_close"(engine: rawptr)

// Sound state lives in arena; provider synchronously decodes the file. Close
// sounds BEFORE their engine, then rewind/release storage. Starts paused.
pub fn sound_create(arena: *mem.Arena, status: *fail.Status, engine: rawptr, path: []const u8, buffer: []u8) rawptr {
  if status == nil { return sound_create(arena, &fail.Status{}, engine, path, buffer) }
  if status.failed { return nil }
  if arena == nil || engine == nil {
    audio_failed(status, "open sound", -2)
    return nil
  }
  encoded := c.string_into(status, buffer, path)
  if status.failed { return nil }
  mark := mem.arena_mark(arena)
  state := native_storage(arena, sound_size(), sound_align())
  code := sound_init(state, engine, encoded)
  if code != 0 {
    mem.arena_rewind(arena, mark)
    audio_failed(status, "open sound", code)
    return nil
  }
  return state
}
// stop preserves position; rewind explicitly seeks to the start. Query ended
// to distinguish EOF from a stop. A closed sound fails with InvalidInput.
pub fn sound_start(status: *fail.Status, sound: rawptr) {
  if status == nil {
    sound_start(&fail.Status{}, sound)
    return
  }
  sound_checked(status, "start sound", native_sound_start(sound))
}
pub fn sound_stop(status: *fail.Status, sound: rawptr) {
  if status == nil {
    sound_stop(&fail.Status{}, sound)
    return
  }
  sound_checked(status, "stop sound", native_sound_stop(sound))
}
pub fn sound_rewind(status: *fail.Status, sound: rawptr) {
  if status == nil {
    sound_rewind(&fail.Status{}, sound)
    return
  }
  sound_checked(status, "rewind sound", native_sound_rewind(sound))
}
// volume must be finite and not negative.
pub fn sound_volume(status: *fail.Status, sound: rawptr, volume: f32) {
  if status == nil {
    sound_volume(&fail.Status{}, sound, volume)
    return
  }
  if status.failed { return }
  if !native_sound_volume(sound, volume) {
    audio_failed(status, "set volume", -2)
  }
}
fn sound_checked(status: *fail.Status, operation: []const u8, code: i32) {
  if status.failed { return }
  if code != 0 {
    audio_failed(status, operation, code)
  }
}
pub extern fn sound_playing "dyn_ma_sound_playing"(sound: rawptr) bool
pub extern fn sound_ended "dyn_ma_sound_ended"(sound: rawptr) bool
extern fn native_sound_start "dyn_ma_sound_start"(sound: rawptr) i32
extern fn native_sound_stop "dyn_ma_sound_stop"(sound: rawptr) i32
extern fn native_sound_rewind "dyn_ma_sound_rewind"(sound: rawptr) i32
extern fn native_sound_volume "dyn_ma_sound_volume"(sound: rawptr, volume: f32) bool
pub extern fn sound_close "dyn_ma_sound_close"(sound: rawptr)
extern fn sound_size "dyn_ma_sound_size"() usize
extern fn sound_align "dyn_ma_sound_align"() usize
extern fn sound_init "dyn_ma_sound_init"(state: rawptr, engine: rawptr, path: c.string) i32
extern fn decoder_size "dyn_ma_decoder_size"() usize
extern fn decoder_align "dyn_ma_decoder_align"() usize
extern fn decoder_init "dyn_ma_decoder_init"(state: rawptr, data: rawptr, size: usize) i32
extern fn native_read "dyn_ma_decoder_read"(state: rawptr, output: *f32, frames: u64, read: *u64) i32
extern fn engine_size "dyn_ma_engine_size"() usize
extern fn engine_align "dyn_ma_engine_align"() usize
extern fn engine_init "dyn_ma_engine_init"(state: rawptr, device: bool) i32
extern fn native_play "dyn_ma_play"(state: rawptr, path: c.string) i32
extern fn native_mix "dyn_ma_mix"(state: rawptr, output: *f32, frames: u64, read: *u64) i32

// Zeroed storage for a native state from arena, at the alignment the native
// side reports. Panics when the arena is exhausted.
fn native_storage(arena: *mem.Arena, size: usize, alignment: usize) rawptr {
  if alignment == 0 || (alignment & (alignment - 1)) != 0 || alignment > 4096 || size > #max(usize) - alignment {
    #panic("native state has an invalid size or alignment")
  }
  storage := mem.push_bytes(arena, size + alignment - 1)
  mem.zero(storage)
  skip := (alignment - (#cast(usize, &storage[0]) & (alignment - 1))) & (alignment - 1)
  return &storage[skip]
}
