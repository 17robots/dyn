use "std/fail"
#link("lz4")
// Raw LZ4 blocks, not the framed format. Caller supplies the decompressed bound.
// Buffers must not overlap. Failure may modify destination; discard its contents.
// Failures keep the library's return code in native.
pub const MaxInput: usize = 2113929216
pub fn compress_bound(size: usize) usize {
  if size > MaxInput { return 0 }
  return #cast(usize, native_bound(#cast(i32, size)))
}
fn failed(status: *fail.Status, kind: fail.Kind, operation: []const u8, message: []const u8, code: i32) usize {
  failure := fail.make(kind, operation, "", message)
  failure.native = code
  fail.set(status, failure)
  return 0
}
// The compressed size; a destination too small fails with Capacity.
pub fn compress(status: *fail.Status, destination: []u8, source: []const u8) usize {
  if status.failed { return 0 }
  if #len(source) > MaxInput || #len(destination) == 0 || #len(destination) > 2147483647 {
    return failed(status, fail.Kind.InvalidInput, "compress", "bad buffer sizes", 0)
  }
  empty: [1]u8
  input: *const u8 = &empty[0]
  if #len(source) != 0 {
    input = &source[0]
  }
  code := native_compress(input, &destination[0], #cast(i32, #len(source)), #cast(i32, #len(destination)))
  if code <= 0 { return failed(status, fail.Kind.Capacity, "compress", "the destination is too small", code) }
  return #cast(usize, code)
}
// The decompressed size; malformed input, or output past destination, fails
// with InvalidInput.
pub fn decompress(status: *fail.Status, destination: []u8, source: []const u8) usize {
  if status.failed { return 0 }
  if #len(source) == 0 || #len(source) > 2147483647 || #len(destination) > 2147483647 {
    return failed(status, fail.Kind.InvalidInput, "decompress", "bad buffer sizes", -1)
  }
  empty: [1]u8
  output := &empty[0]
  if #len(destination) != 0 {
    output = &destination[0]
  }
  code := native_decompress(&source[0], output, #cast(i32, #len(source)), #cast(i32, #len(destination)))
  if code < 0 { return failed(status, fail.Kind.InvalidInput, "decompress", "malformed LZ4 block", code) }
  return #cast(usize, code)
}
extern fn native_bound "LZ4_compressBound"(size: i32) i32
extern fn native_compress "LZ4_compress_default"(source: *const u8, destination: *u8, size: i32, capacity: i32) i32
extern fn native_decompress "LZ4_decompress_safe"(source: *const u8, destination: *u8, size: i32, capacity: i32) i32
