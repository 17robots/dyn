use io "std/io"
use "std/c"
use "std/mem"
#link("curl")

// The response bytes written to destination and the HTTP status.
pub struct Response { written: usize, http_status: c.long }
struct Sink { destination: []u8, used: usize, full: bool }
// Call once before starting worker threads; cleanup only after all transfers end.
pub fn init() !io.IoErr {
  code := native_init(#cast(c.long, 3))
  if code != 0 { fail io.IoErr.System(code) }
}
// curl's text for a code from a System failure.
pub fn error_text(code: isize) []const u8 {
  return c.bytes_from_string(native_error_text(#cast(i32, code)), 160) catch ""
}
pub fn cleanup() {
  native_cleanup()
}
fn receive(data: *const u8, size: usize, count: usize, context: rawptr) usize {
  if context == nil { return 0 }
  sink := #cast(*Sink, context)
  if size != 0 && count > (#cast(usize, -1)) / size {
    sink.full = true
    return 0
  }
  length := size * count
  if length > sink.destination.len - sink.used {
    sink.full = true
    return 0
  }
  if length > 0 {
    if data == nil { return 0 }
    _ = mem.copy(sink.destination[sink.used..], #slice(data, length))
    sink.used += length
  }
  return length
}
// Synchronous HTTP(S) GET. URL copied through caller scratch; response goes into
// caller storage. TLS verification remains enabled. Redirects are not followed.
// An HTTP error response is not a failure: inspect http_status. A response
// larger than destination fails with Capacity; a timeout with Interrupted, an
// unknown host with NotFound, a bad URL with InvalidInput, and other transport
// failures with System and curl's code (error_text gives curl's message). On
// failure destination holds partial bytes, not a response. No borrows escape.
pub fn get_into(url: []const u8, url_buffer: []u8, destination: []u8, timeout_ms: i32) Response!io.IoErr {
  if timeout_ms <= 0 { fail .InvalidInput }
  encoded := try c.string_into(url_buffer, url)
  easy := native_easy_init()
  if easy == nil { fail .Capacity }
  defer native_easy_cleanup(easy)
  sink := Sink{ destination: destination }
  protocols: [11]u8 = ['h', 't', 't', 'p', ',', 'h', 't', 't', 'p', 's', 0]
  code := native_setopt(easy, 10002, encoded)
  if code == 0 {
    code = native_setopt(easy, 10318, &protocols[0])
  }
  if code == 0 {
    code = native_setopt(easy, 99, #cast(c.long, 1))
  }
  if code == 0 {
    code = native_setopt(easy, 155, #cast(c.long, timeout_ms))
  }
  if code == 0 {
    code = native_setopt(easy, 20011, receive)
  }
  if code == 0 {
    code = native_setopt(easy, 10001, &sink)
  }
  if code == 0 {
    code = native_perform(easy)
  }
  http_status: c.long = 0
  if code == 0 {
    code = native_getinfo(easy, 2097154, &http_status)
  }
  if sink.full {
    fail .Capacity
  } else if code != 0 {
    if code == 28 { fail .Interrupted }
    if code == 6 { fail .NotFound }
    if code == 1 || code == 3 { fail .InvalidInput }
    fail io.IoErr.System(code)
  }
  return Response{ written: sink.used, http_status: http_status }
}
extern fn native_init "curl_global_init"(flags: c.long) i32
extern fn native_cleanup "curl_global_cleanup"()
extern fn native_easy_init "curl_easy_init"() rawptr
extern fn native_easy_cleanup "curl_easy_cleanup"(easy: rawptr)
extern fn native_setopt "curl_easy_setopt"(easy: rawptr, option: i32, ...) i32
extern fn native_perform "curl_easy_perform"(easy: rawptr) i32
extern fn native_getinfo "curl_easy_getinfo"(easy: rawptr, info: i32, ...) i32
extern fn native_error_text "curl_easy_strerror"(code: i32) c.string
