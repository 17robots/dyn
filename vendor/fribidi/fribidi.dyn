use "std/fail"
use "std/dynlib" dynlib
use "std/mem" mem
use "std/io" io
use "std/unicode/utf8" utf8

// FriBidi's fixed-width public C ABI. The API table borrows a caller-owned
// loader handle. Keep it loaded during calls; all helper results are copied
// into the caller arena and outlive native temporary storage/library closure.
pub const Auto: u32 = 64
pub const LeftToRight: u32 = 272
pub const RightToLeft: u32 = 273
pub struct Api {
  log2vis: fn(*const u32, i32, *u32, *u32, *i32, *i32, *i8) i8,
  get_bidi_types: fn(*const u32, i32, *u32),
  reorder_line: fn(u32, *const u32, i32, i32, u32, *i8, *u32, *i32) i8,
}
pub struct Paragraph {
  logical: []u32,
  visual: []u32,
  starts: []usize,
  ends: []usize,
  logical_to_visual: []i32,
  visual_to_logical: []i32,
  levels: []i8,
  types: []u32,
  base: u32,
}
// Map values are global paragraph scalar indexes. levels remains in logical
// order for [start,end), after line-specific UAX #9 rule L1 reset.
pub struct Line { visual_to_logical: []i32, levels: []i8 }

fn missing(status: *fail.Status, name: []const u8) Api {
  fail.set(status, fail.make(fail.Kind.NotFound, "load FriBidi", name, "the library lacks this function"))
  return Api{}
}
fn symbol(handle: dynlib.Handle, name: []const u8) rawptr {
  status: fail.Status
  return dynlib.symbol(&status, handle, name)
}
// A missing function fails with NotFound, its name as the failure's path.
pub fn load(status: *fail.Status, handle: dynlib.Handle) Api {
  if status == nil { return load(&fail.Status{}, handle) }
  if status.failed { return Api{} }
  api := Api{}
  api.log2vis = #cast(fn(*const u32, i32, *u32, *u32, *i32, *i32, *i8)i8, symbol(handle, "fribidi_log2vis"))
  if api.log2vis == nil { return missing(status, "fribidi_log2vis") }
  api.get_bidi_types = #cast(fn(*const u32, i32, *u32), symbol(handle, "fribidi_get_bidi_types"))
  if api.get_bidi_types == nil { return missing(status, "fribidi_get_bidi_types") }
  api.reorder_line = #cast(fn(u32, *const u32, i32, i32, u32, *i8, *u32, *i32)i8, symbol(handle, "fribidi_reorder_line"))
  if api.reorder_line == nil { return missing(status, "fribidi_reorder_line") }
  return api
}
fn direction(base: u32) bool {
  return base == Auto || base == LeftToRight || base == RightToLeft
}
fn separator(cp: u32) bool {
  return cp == 10 || cp == 13 || cp == 28 || cp == 29 || cp == 30 || cp == 133 || cp == 8232 || cp == 8233
}
// Resolves one single-line paragraph. Invalid UTF-8, separators and invalid
// direction fail before allocation. Explicit bidi/isolate controls are retained
// in the source and maps. visual is FriBidi's convenience presentation output;
// shape original logical source, not visual (which may contain mirrored or
// Arabic presentation-form characters). Use levels/maps to position shaped runs.
pub fn resolve(arena: *mem.Arena, status: *fail.Status, api: *const Api, text: []const u8, base: u32) Paragraph {
  if status == nil { return resolve(arena, &fail.Status{}, api, text, base) }
  if status.failed { return Paragraph{} }
  if !direction(base) || #len(text) > 2147483647 {
    bidi_failed(status, fail.Kind.InvalidInput, "resolve", 0)
    return Paragraph{}
  }
  count: usize = 0
  offset: usize = 0
  for offset < #len(text) {
    decoded := utf8.decode(text, offset)
    if !decoded.valid || separator(decoded.codepoint) {
      bidi_failed(status, fail.Kind.InvalidInput, "resolve", 0)
      return Paragraph{}
    }
    count += 1
    offset += decoded.width
  }
  if count == 0 { return Paragraph{base:base} }
  if api.log2vis == nil || api.get_bidi_types == nil {
    bidi_failed(status, fail.Kind.InvalidState, "resolve", 0)
    return Paragraph{}
  }
  mark := mem.arena_mark(arena)
  logical := mem.push_array(u32, arena, count)
  visual := mem.push_array(u32, arena, count)
  starts := mem.push_array(usize, arena, count)
  ends := mem.push_array(usize, arena, count)
  logical_to_visual := mem.push_array(i32, arena, count)
  visual_to_logical := mem.push_array(i32, arena, count)
  levels := mem.push_array(i8, arena, count)
  types := mem.push_array(u32, arena, count)
  offset = 0
  for i in 0..count {
    decoded := utf8.decode(text, offset)
    logical[i] = decoded.codepoint
    starts[i] = offset
    offset += decoded.width
    ends[i] = offset
  }
  resolved := base
  if api.log2vis(&logical[0], #cast(i32, count), &resolved, &visual[0], &logical_to_visual[0], &visual_to_logical[0], &levels[0]) == 0 {
    mem.arena_rewind(arena, mark)
    bidi_failed(status, fail.Kind.System, "resolve", 0)
    return Paragraph{}
  }
  if !direction(resolved) {
    mem.arena_rewind(arena, mark)
    bidi_failed(status, fail.Kind.InvalidState, "resolve", 0)
    return Paragraph{}
  }
  api.get_bidi_types(&logical[0], #cast(i32, count), &types[0])
  for i in 0..count {
    v := logical_to_visual[i]
    l := visual_to_logical[i]
    if v < 0 || l < 0 || #cast(usize, v) >= count || #cast(usize, l) >= count || levels[i] < 0 {
      mem.arena_rewind(arena, mark)
      bidi_failed(status, fail.Kind.InvalidState, "resolve", 0)
      return Paragraph{}
    }
  }
  for i in 0..count {
    if visual_to_logical[logical_to_visual[i]] != #cast(i32, i) {
      mem.arena_rewind(arena, mark)
      bidi_failed(status, fail.Kind.InvalidState, "resolve", 0)
      return Paragraph{}
    }
  }
  return Paragraph{logical:logical, visual:visual, starts:starts, ends:ends, logical_to_visual:logical_to_visual, visual_to_logical:visual_to_logical, levels:levels, types:types, base:resolved}
}
// Reorders a wrapped line with native L1/L2 handling. Does not mutate paragraph
// levels/maps. Flags zero leave shaping, mirroring and mark placement to HB.
pub fn reorder(arena: *mem.Arena, status: *fail.Status, api: *const Api, paragraph: *const Paragraph, start, end: usize) Line {
  if status == nil { return reorder(arena, &fail.Status{}, api, paragraph, start, end) }
  if status.failed { return Line{} }
  count := #len(paragraph.logical)
  if start > end || end > count || count > 2147483647 || #len(paragraph.levels) != count || #len(paragraph.types) != count || !direction(paragraph.base) {
    bidi_failed(status, fail.Kind.InvalidInput, "reorder", 0)
    return Line{}
  }
  if start == end { return Line{} }
  if api.reorder_line == nil {
    bidi_failed(status, fail.Kind.InvalidState, "reorder", 0)
    return Line{}
  }
  for i in start..end {
    if paragraph.levels[i] < 0 {
      bidi_failed(status, fail.Kind.InvalidInput, "reorder", 0)
      return Line{}
    }
  }
  mark := mem.arena_mark(arena)
  levels := mem.push_array(i8, arena, end-start)
  map := mem.push_array(i32, arena, end-start)
  for i in 0..end-start {
    levels[i] = paragraph.levels[start+i]
    map[i] = #cast(i32, start+i)
  }
  if api.reorder_line(0, &paragraph.types[start], #cast(i32, end-start), 0, paragraph.base, &levels[0], nil, &map[0]) == 0 {
    mem.arena_rewind(arena, mark)
    bidi_failed(status, fail.Kind.System, "reorder", 0)
    return Line{}
  }
  scratch := mem.arena_mark(arena)
  seen := mem.push_array(u8, arena, #len(map))
  for i in 0..#len(map) {
    if map[i] < 0 || #cast(usize, map[i]) < start || #cast(usize, map[i]) >= end || levels[i] < 0 {
      mem.arena_rewind(arena, mark)
      bidi_failed(status, fail.Kind.InvalidState, "reorder", 0)
      return Line{}
    }
    index := #cast(usize, map[i]) - start
    if seen[index] != 0 {
      mem.arena_rewind(arena, mark)
      bidi_failed(status, fail.Kind.InvalidState, "reorder", 0)
      return Line{}
    }
    seen[index] = 1
  }
  mem.arena_rewind(arena, scratch)
  return Line{visual_to_logical:map, levels:levels}
}

// Records a FriBidi failure of kind for operation.
fn bidi_failed(status: *fail.Status, kind: fail.Kind, operation: []const u8, code: isize) {
  message: []const u8 = "FriBidi failed"
  if kind == fail.Kind.InvalidInput {
    message = "invalid argument"
  } else if kind == fail.Kind.Overflow {
    message = "too large"
  } else if kind == fail.Kind.Capacity {
    message = "out of memory"
  }
  failure := fail.make(kind, operation, "", message)
  failure.native = code
  fail.set(status, failure)
}
