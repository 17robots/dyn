use "std/c"
use "std/fail"
#link("archive")
pub type Reader = rawptr
pub type Entry = rawptr
pub const Ok: i32 = 0
pub const End: i32 = 1
pub const Warn: i32 = -20
// An entry header, found false at the end of the archive.
pub struct Header { entry: Entry, found: bool }

// Records libarchive's failure: its message for reader, native keeps code.
fn provider_failed(status: *fail.Status, reader: Reader, operation: []const u8, code: isize) {
  message := error_message(reader, 160)
  if #len(message) == 0 {
    message = "libarchive failed"
  }
  failure := fail.make(fail.Kind.InvalidInput, operation, "", message)
  failure.native = code
  fail.set(status, failure)
}
// Reader retains source until destroy. Decoding is streaming; entry/data access
// advances the reader. No filesystem extraction or path interpretation is done.
// An unreadable archive fails with InvalidInput and libarchive's message.
pub fn open_memory_owned(status: *fail.Status, source: []const u8) Reader {
  if status.failed { return nil }
  if #len(source) == 0 {
    fail.invalid(status, "open archive", "", "empty archive")
    return nil
  }
  reader := native_new()
  if reader == nil {
    fail.set(status, fail.make(fail.Kind.Capacity, "open archive", "", "no memory for a reader"))
    return nil
  }
  code := native_filters(reader)
  if code >= Warn {
    code = native_formats(reader)
  }
  if code >= Warn {
    code = native_open(reader, #cast(rawptr, &source[0]), #len(source))
  }
  if code != Ok {
    provider_failed(status, reader, "open archive", code)
    _ = native_free(reader)
    return nil
  }
  return reader
}
pub fn destroy_owned(reader: Reader) {
  if reader != nil {
    _ = native_free(reader)
  }
}
// Entry and its strings expire at next header/read mutation or reader destruction.
pub fn next(status: *fail.Status, reader: Reader) Header {
  if status.failed { return Header{} }
  if reader == nil {
    fail.invalid(status, "read archive", "", "no reader")
    return Header{}
  }
  entry: Entry = nil
  code := native_next(reader, &entry)
  if code == End { return Header{} }
  if code != Ok {
    provider_failed(status, reader, "read archive", code)
    return Header{}
  }
  return Header{ entry: entry, found: true }
}
pub fn entry_name(status: *fail.Status, entry: Entry, maximum: usize) []const u8 {
  if status.failed { return "" }
  if entry == nil {
    fail.invalid(status, "read archive", "", "no entry")
    return ""
  }
  return c.bytes_from_string(status, native_name(entry), maximum)
}
pub fn entry_size(entry: Entry) i64 {
  if entry == nil { return -1 }
  return native_size(entry)
}
// Reads the current entry's data; zero at its end.
pub fn read(status: *fail.Status, reader: Reader, destination: []u8) usize {
  if status.failed || #len(destination) == 0 { return 0 }
  if reader == nil {
    fail.invalid(status, "read archive", "", "no reader")
    return 0
  }
  count := native_read(reader, #cast(rawptr, &destination[0]), #len(destination))
  if count < 0 {
    provider_failed(status, reader, "read archive", count)
    return 0
  }
  return #cast(usize, count)
}
pub fn error_message(reader: Reader, maximum: usize) []const u8 {
  if reader == nil { return "" }
  reading: fail.Status
  return c.bytes_from_string(&reading, native_error(reader), maximum)
}
extern fn native_new "archive_read_new"() Reader
extern fn native_filters "archive_read_support_filter_all"(reader: Reader) i32
extern fn native_formats "archive_read_support_format_all"(reader: Reader) i32
extern fn native_open "archive_read_open_memory"(reader: Reader, source: rawptr, size: usize) i32
extern fn native_free "archive_read_free"(reader: Reader) i32
extern fn native_next "archive_read_next_header"(reader: Reader, entry: *Entry) i32
extern fn native_name "archive_entry_pathname"(entry: Entry) c.string
extern fn native_size "archive_entry_size"(entry: Entry) i64
extern fn native_read "archive_read_data"(reader: Reader, destination: rawptr, capacity: usize) isize
extern fn native_error "archive_error_string"(reader: Reader) c.string
