use "std/fail"
#target(kernel: linux)
use "std/c"
use "std/mem"
#link("ssl")
#link("crypto")

// OpenSSL 3 TLS adapter. OpenSSL owns Context/Connection allocations;
// every successful create_owned call requires its matching free_owned call.
// Network descriptors and all byte/name buffers remain caller-owned.
//
// Calls that can fail take a *fail.Status: a bad argument fails with
// InvalidInput, a failed certificate check with PermissionDenied, anything
// else OpenSSL reports with System and its error code in failure.native.
// Waiting for the socket is not a failure: the call returns a Want instead.
pub type Context = rawptr
pub type Connection = rawptr
pub type Certificate = rawptr

// What a nonblocking connection waits for before the call can go on.
// Blocking connections never report a want.
pub enum Want { Nothing, Read, Write }
// A read or write: the bytes moved, or what the connection waits for.
pub struct Attempt { count: usize, want: Want }

const VerifyPeer: i32 = 1
const SetTlsExtensionHostname: i32 = 55
const HostnameNameType: i64 = 0
const FileTypePem: i32 = 1
const ErrorWantRead: i32 = 2
const ErrorWantWrite: i32 = 3

// Records OpenSSL's pending error for operation as a System failure, with its
// text as the message.
fn provider_failed(status: *fail.Status, operation: []const u8) {
  code := provider_error()
  text: [160]u8
  message: []const u8 = "OpenSSL failed"
  if code != 0 {
    message = error_string(text[..], code)
  }
  failure := fail.make(fail.Kind.System, operation, "", message)
  failure.native = #bitcast(isize, #cast(usize, code))
  fail.set(status, failure)
}

// The result of an SSL_* call that returned status: a want when the socket
// is not ready, else a failure.
fn stalled(status: *fail.Status, operation: []const u8, connection: Connection, result: i32) Want {
  code := ssl_error(connection, result)
  if code == ErrorWantRead { return Want.Read }
  if code == ErrorWantWrite { return Want.Write }
  provider_failed(status, operation)
  return Want.Nothing
}

// Loads provider-default trust roots and enables peer-certificate verification.
pub fn context_create_owned(status: *fail.Status) Context {
  if status == nil { return context_create_owned(&fail.Status{}) }
  if status.failed { return nil }
  provider_clear_error()
  method := tls_client_method()
  if method == nil {
    provider_failed(status, "create TLS client")
    return nil
  }
  context := ssl_context_new(method)
  if context == nil {
    provider_failed(status, "create TLS client")
    return nil
  }
  if ssl_context_default_roots(context) != 1 {
    provider_failed(status, "create TLS client")
    ssl_context_free(context)
    return nil
  }
  ssl_context_set_verify(context, VerifyPeer, nil)
  return context
}

pub fn context_free_owned(context: Context) {
  if context != nil {
    ssl_context_free(context)
  }
}

// Creates a server context and loads PEM certificate chain/private key.
pub fn server_context_create_owned(status: *fail.Status, certificate: []const u8, key: []const u8,
  certificate_buffer: []u8, key_buffer: []u8) Context {
  if status == nil { return server_context_create_owned(&fail.Status{}, certificate, key, certificate_buffer, key_buffer) }
  certificate_path := c.string_into(status, certificate_buffer, certificate)
  key_path := c.string_into(status, key_buffer, key)
  if status.failed { return nil }
  return server_context_from_paths(status, certificate_path, key_path)
}

fn server_context_from_paths(status: *fail.Status, certificate: *const u8, key: *const u8) Context {
  provider_clear_error()
  method := tls_server_method()
  if method == nil {
    provider_failed(status, "create TLS server")
    return nil
  }
  context := ssl_context_new(method)
  if context == nil {
    provider_failed(status, "create TLS server")
    return nil
  }
  if context_use_certificate(context, certificate) != 1 ||
    context_use_key(context, key, FileTypePem) != 1 || context_check_key(context) != 1 {
    provider_failed(status, "create TLS server")
    ssl_context_free(context)
    return nil
  }
  return context
}

// The arena supplies temporary C strings only; OpenSSL owns the result.
pub fn server_context_create(arena: *mem.Arena, status: *fail.Status, certificate: []const u8, key: []const u8) Context {
  if status == nil { return server_context_create(arena, &fail.Status{}, certificate, key) }
  if status.failed { return nil }
  mark := mem.arena_mark(arena)
  defer mem.arena_rewind(arena, mark)
  certificate_path := c.string_from_bytes(arena, status, certificate)
  key_path := c.string_from_bytes(arena, status, key)
  if status.failed { return nil }
  return server_context_from_paths(status, certificate_path, key_path)
}

pub fn server_connection_create_owned(status: *fail.Status, context: Context, descriptor: i32) Connection {
  if status == nil { return server_connection_create_owned(&fail.Status{}, context, descriptor) }
  if status.failed { return nil }
  if context == nil || descriptor < 0 {
    fail.invalid(status, "create TLS connection", "", "no context, or a negative descriptor")
    return nil
  }
  provider_clear_error()
  connection := ssl_new(context)
  if connection == nil {
    provider_failed(status, "create TLS connection")
    return nil
  }
  if ssl_set_fd(connection, descriptor) != 1 {
    provider_failed(status, "create TLS connection")
    ssl_free(connection)
    return nil
  }
  return connection
}

// protocols is OpenSSL wire format: one length byte followed by each protocol.
// OpenSSL copies the bytes; the caller retains ownership.
pub fn set_alpn_protocols(status: *fail.Status, connection: Connection, protocols: []const u8) {
  if status == nil {
    set_alpn_protocols(&fail.Status{}, connection, protocols)
    return
  }
  if status.failed { return }
  valid := connection != nil && protocols.len != 0 && protocols.len <= 4294967295
  index: usize = 0
  for valid && index < protocols.len {
    length := #cast(usize, protocols[index])
    index += 1
    if length == 0 || length > protocols.len - index {
      valid = false
    }
    index += length
  }
  if !valid {
    fail.invalid(status, "set ALPN", "", "no connection, or protocols not in ALPN wire format")
    return
  }
  provider_clear_error()
  if ssl_set_alpn(connection, &protocols[0], #cast(u32, protocols.len)) != 0 {
    provider_failed(status, "set ALPN")
  }
}

// Server side: during each handshake, picks the first protocol of
// preference that the client offers, in wire format like set_alpn_protocols.
// preference must outlive the context (a string literal does). No common
// protocol continues without ALPN.
pub fn set_server_alpn(status: *fail.Status, context: Context, preference: *const []const u8) {
  if status == nil {
    set_server_alpn(&fail.Status{}, context, preference)
    return
  }
  if status.failed { return }
  if context == nil || preference == nil || preference.*.len == 0 {
    fail.invalid(status, "set server ALPN", "", "no context or no protocols")
    return
  }
  ssl_context_alpn_select(context, alpn_select, #cast(rawptr, preference))
}

// SSL_CTX_alpn_select_cb_func: SSL_TLSEXT_ERR_OK (0) with out pointing into
// the client's list, or SSL_TLSEXT_ERR_NOACK (3).
fn alpn_select(connection: rawptr, out: *rawptr, out_length: *u8, offered: *const u8, offered_length: u32, argument: rawptr) i32 {
  _ = connection
  preference := #cast(*const []const u8, argument).*
  if offered == nil || offered_length == 0 { return 3 }
  client := #slice(offered, offered_length)
  at: usize = 0
  for at < preference.len {
    length := #cast(usize, preference[at])
    if length == 0 || length > preference.len - at - 1 { return 3 }
    wanted := preference[at + 1..at + 1 + length]
    at += 1 + length
    index: usize = 0
    for index < client.len {
      size := #cast(usize, client[index])
      if size > client.len - index - 1 { break }
      candidate := client[index + 1..index + 1 + size]
      if size == length && bytes_equal(candidate, wanted) {
        out.* = #cast(rawptr, &client[index + 1])
        out_length.* = #cast(u8, size)
        return 0
      }
      index += 1 + size
    }
  }
  return 3
}

fn bytes_equal(left: []const u8, right: []const u8) bool {
  for i in 0..left.len {
    if left[i] != right[i] { return false }
  }
  return true
}

// Returned selection borrows the connection and dies when it is freed or renegotiated.
pub fn selected_alpn(connection: Connection) []const u8 {
  if connection == nil { return "" }
  selected: rawptr = nil
  length: u32 = 0
  ssl_get_alpn(connection, &selected, &length)
  if selected == nil || length == 0 { return "" }
  bytes := #cast(*const u8, selected)
  return #slice(bytes, length)
}

// Caller owns the returned reference and must call certificate_free_owned.
// nil when the peer sent none.
pub fn peer_certificate_owned(connection: Connection) Certificate {
  if connection == nil { return nil }
  return ssl_peer_certificate(connection)
}
pub fn certificate_free_owned(certificate: Certificate) {
  if certificate != nil {
    certificate_free(certificate)
  }
}

// Configures both certificate hostname verification and SNI. name_buffer must
// fit hostname plus NUL and is only borrowed during this call.
pub fn connection_create_owned(status: *fail.Status, context: Context, descriptor: i32, hostname: []const u8, name_buffer: []u8) Connection {
  if status == nil { return connection_create_owned(&fail.Status{}, context, descriptor, hostname, name_buffer) }
  if status.failed { return nil }
  if context == nil || descriptor < 0 || hostname.len == 0 {
    fail.invalid(status, "create TLS connection", hostname, "no context or hostname, or a negative descriptor")
    return nil
  }
  name := c.string_into(status, name_buffer, hostname)
  if status.failed { return nil }
  return connection_from_name(status, context, descriptor, name, hostname.len)
}

fn connection_from_name(status: *fail.Status, context: Context, descriptor: i32, name: *const u8, length: usize) Connection {
  provider_clear_error()
  connection := ssl_new(context)
  if connection == nil {
    provider_failed(status, "create TLS connection")
    return nil
  }
  parameters := ssl_get_parameters(connection)
  configured := ssl_set_fd(connection, descriptor) == 1 && parameters != nil
  if configured {
    configured = parameters_set_host(parameters, name, length) == 1
  }
  if configured {
    configured = ssl_control(connection, SetTlsExtensionHostname, HostnameNameType, #cast(rawptr, name)) == 1
  }
  if !configured {
    provider_failed(status, "create TLS connection")
    ssl_free(connection)
    return nil
  }
  return connection
}

pub fn connection_create(arena: *mem.Arena, status: *fail.Status, context: Context, descriptor: i32, hostname: []const u8) Connection {
  if status == nil { return connection_create(arena, &fail.Status{}, context, descriptor, hostname) }
  if status.failed { return nil }
  if context == nil || descriptor < 0 || hostname.len == 0 {
    fail.invalid(status, "create TLS connection", hostname, "no context or hostname, or a negative descriptor")
    return nil
  }
  mark := mem.arena_mark(arena)
  defer mem.arena_rewind(arena, mark)
  name := c.string_from_bytes(arena, status, hostname)
  if status.failed { return nil }
  return connection_from_name(status, context, descriptor, name, hostname.len)
}

pub fn connection_free_owned(connection: Connection) {
  if connection != nil {
    ssl_free(connection)
  }
}

fn no_connection(status: *fail.Status, operation: []const u8) {
  fail.invalid(status, operation, "", "no connection")
}

// Runs the client handshake. On a nonblocking socket it may stop with a want;
// call it again once the socket is ready. Want.Nothing means it completed.
// A certificate that does not verify fails with PermissionDenied, the
// verification code in native.
pub fn handshake(status: *fail.Status, connection: Connection) Want {
  if status == nil { return handshake(&fail.Status{}, connection) }
  if status.failed { return Want.Nothing }
  if connection == nil {
    no_connection(status, "handshake")
    return Want.Nothing
  }
  provider_clear_error()
  connected := ssl_connect(connection)
  verified := ssl_verify_result(connection)
  if verified != 0 {
    failure := fail.make(fail.Kind.PermissionDenied, "handshake", "", "certificate verification failed")
    failure.native = #cast(isize, verified)
    fail.set(status, failure)
    return Want.Nothing
  }
  if connected != 1 { return stalled(status, "handshake", connection, connected) }
  return Want.Nothing
}

pub fn server_handshake(status: *fail.Status, connection: Connection) Want {
  if status == nil { return server_handshake(&fail.Status{}, connection) }
  if status.failed { return Want.Nothing }
  if connection == nil {
    no_connection(status, "handshake")
    return Want.Nothing
  }
  provider_clear_error()
  accepted := ssl_accept(connection)
  if accepted != 1 { return stalled(status, "handshake", connection, accepted) }
  return Want.Nothing
}

// Reads what is available; count 0 with no want is the end of the stream
// (the peer's close_notify).
pub fn read(status: *fail.Status, connection: Connection, destination: []u8) Attempt {
  if status == nil { return read(&fail.Status{}, connection, destination) }
  if status.failed { return Attempt{} }
  if connection == nil {
    no_connection(status, "read")
    return Attempt{}
  }
  if destination.len == 0 { return Attempt{} }
  count: usize = 0
  provider_clear_error()
  result := ssl_read(connection, #cast(rawptr, &destination[0]), destination.len, &count)
  if result != 1 {
    // SSL_ERROR_ZERO_RETURN is an authenticated close, not a truncation.
    if ssl_error(connection, result) == ErrorZeroReturn { return Attempt{} }
    return Attempt{ want: stalled(status, "read", connection, result) }
  }
  return Attempt{ count: count }
}

pub fn write(status: *fail.Status, connection: Connection, source: []const u8) Attempt {
  if status == nil { return write(&fail.Status{}, connection, source) }
  if status.failed { return Attempt{} }
  if connection == nil {
    no_connection(status, "write")
    return Attempt{}
  }
  if source.len == 0 { return Attempt{} }
  count: usize = 0
  provider_clear_error()
  result := ssl_write(connection, #cast(rawptr, &source[0]), source.len, &count)
  if result != 1 { return Attempt{ want: stalled(status, "write", connection, result) } }
  return Attempt{ count: count }
}

// Sends close_notify. Want.Read means it was sent and the peer's is pending;
// call again to finish the exchange, or close the socket.
// https://docs.openssl.org/3.4/man3/SSL_shutdown/
pub fn shutdown(status: *fail.Status, connection: Connection) Want {
  if status == nil { return shutdown(&fail.Status{}, connection) }
  if status.failed { return Want.Nothing }
  if connection == nil {
    no_connection(status, "shutdown")
    return Want.Nothing
  }
  provider_clear_error()
  result := ssl_shutdown(connection)
  if result == 1 { return Want.Nothing }
  if result == 0 { return Want.Read }
  return stalled(status, "shutdown", connection, result)
}

// Writes provider message into caller buffer. Returned slice excludes NUL.
pub fn error_string(destination: []u8, code: u64) []u8 {
  if destination.len == 0 { return destination[..0] }
  provider_error_string(code, &destination[0], destination.len)
  length: usize = 0
  for length < destination.len && destination[length] != 0 {
    length += 1
  }
  return destination[..length]
}

// The complete subject text, allocated by OpenSSL; release it with
// subject_text_free_owned.
extern fn provider_text_free "CRYPTO_free"(pointer: rawptr, file: *const u8, line: i32)
pub fn subject_text_owned(status: *fail.Status, certificate: Certificate) *u8 {
  if status == nil { return subject_text_owned(&fail.Status{}, certificate) }
  if status.failed { return nil }
  if certificate == nil {
    fail.invalid(status, "certificate subject", "", "no certificate")
    return nil
  }
  provider_clear_error()
  name := certificate_subject_name(certificate)
  if name == nil {
    provider_failed(status, "certificate subject")
    return nil
  }
  // A nil buffer asks OpenSSL to allocate the complete representation.
  text := name_text(name, nil, 0)
  if text == nil {
    provider_failed(status, "certificate subject")
  }
  return text
}
pub fn subject_text_free_owned(text: *u8) {
  if text != nil {
    provider_text_free(text, nil, 0)
  }
}
