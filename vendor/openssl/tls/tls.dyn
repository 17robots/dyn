use "std/fail"
#target(kernel: linux)
use "std/c"
use "std/mem"
#link("ssl")
#link("crypto")

// OpenSSL 3 TLS adapter. OpenSSL owns Context/Connection allocations;
// every successful create_owned call requires its matching free_owned call.
// Network descriptors and all byte/name buffers remain caller-owned.
pub type Context = rawptr
pub type Connection = rawptr
pub type Certificate = rawptr

pub enum ErrorKind {
  None,
  InvalidArgument,
  Provider,
  Verification,
  WantRead,
  WantWrite,
}

pub struct ContextResult { value: Context, error: ErrorKind, provider_code: u64 }
pub struct ConnectionResult { value: Connection, error: ErrorKind, provider_code: u64 }
pub struct Result { count: usize, error: ErrorKind, provider_code: u64, provider_status: i32 }

const VerifyPeer: i32 = 1
const SetTlsExtensionHostname: i32 = 55
const HostnameNameType: i64 = 0
const FileTypePem: i32 = 1
const ErrorWantRead: i32 = 2
const ErrorWantWrite: i32 = 3


fn failure(kind: ErrorKind, status: i32) Result {
  if kind == ErrorKind.InvalidArgument { return Result{ error: kind, provider_status: status } }
  return Result{ count: 0, error: kind, provider_code: provider_error(), provider_status: status }
}

fn operation_failure(connection: Connection, status: i32) Result {
  kind := ErrorKind.Provider
  code := ssl_error(connection, status)
  if code == ErrorWantRead {
    kind = ErrorKind.WantRead
  } else if code == ErrorWantWrite {
    kind = ErrorKind.WantWrite
  }
  return Result{ count: 0, error: kind, provider_code: provider_error(), provider_status: code }
}

// Loads provider-default trust roots and enables peer-certificate verification.
pub fn context_create_owned() ContextResult {
  provider_clear_error()
  method := tls_client_method()
  if method == nil {
    return ContextResult{ value: nil, error: ErrorKind.Provider, provider_code: provider_error() }
  }
  context := ssl_context_new(method)
  if context == nil {
    return ContextResult{ value: nil, error: ErrorKind.Provider, provider_code: provider_error() }
  }
  if ssl_context_default_roots(context) != 1 {
    code := provider_error()
    ssl_context_free(context)
    return ContextResult{ value: nil, error: ErrorKind.Provider, provider_code: code }
  }
  ssl_context_set_verify(context, VerifyPeer, nil)
  return ContextResult{ value: context, error: ErrorKind.None, provider_code: 0 }
}

pub fn context_free_owned(context: Context) {
  if context != nil {
    ssl_context_free(context)
  }
}

// Creates a server context and loads PEM certificate chain/private key.
pub fn server_context_create_owned(certificate: []const u8, key: []const u8,
  certificate_buffer: []u8, key_buffer: []u8) ContextResult {
  converting: fail.Status
  certificate_path := c.string_into(&converting, certificate_buffer, certificate)
  key_path := c.string_into(&converting, key_buffer, key)
  if converting.failed { return ContextResult{ error: ErrorKind.InvalidArgument } }
  return server_context_from_paths(certificate_path, key_path)
}

fn server_context_from_paths(certificate: *const u8, key: *const u8) ContextResult {
  provider_clear_error()
  method := tls_server_method()
  if method == nil {
    return ContextResult{ error: ErrorKind.Provider, provider_code: provider_error() }
  }
  context := ssl_context_new(method)
  if context == nil {
    return ContextResult{ error: ErrorKind.Provider, provider_code: provider_error() }
  }
  if context_use_certificate(context, certificate) != 1 ||
    context_use_key(context, key, FileTypePem) != 1 || context_check_key(context) != 1 {
    code := provider_error()
    ssl_context_free(context)
    return ContextResult{ error: ErrorKind.Provider, provider_code: code }
  }
  return ContextResult{ value: context }
}

// The arena supplies temporary C strings only; OpenSSL owns the result.
pub fn server_context_create(arena: *mem.Arena, certificate: []const u8, key: []const u8) ContextResult {
  mark := mem.arena_mark(arena)
  defer mem.arena_rewind(arena, mark)
  converting: fail.Status
  certificate_path := c.string_from_bytes(arena, &converting, certificate)
  key_path := c.string_from_bytes(arena, &converting, key)
  if converting.failed { return ContextResult{ error: ErrorKind.InvalidArgument } }
  return server_context_from_paths(certificate_path, key_path)
}

pub fn server_connection_create_owned(context: Context, descriptor: i32) ConnectionResult {
  if context == nil || descriptor < 0 {
    return ConnectionResult{ error: ErrorKind.InvalidArgument }
  }
  connection := ssl_new(context)
  if connection == nil {
    return ConnectionResult{ error: ErrorKind.Provider, provider_code: provider_error() }
  }
  if ssl_set_fd(connection, descriptor) != 1 {
    code := provider_error()
    ssl_free(connection)
    return ConnectionResult{ error: ErrorKind.Provider, provider_code: code }
  }
  return ConnectionResult{ value: connection, error: ErrorKind.None }
}

// protocols is OpenSSL wire format: one length byte followed by each protocol.
// OpenSSL copies the bytes; the caller retains ownership.
pub fn set_alpn_protocols(connection: Connection, protocols: []const u8) bool {
  if connection == nil || #len(protocols) == 0 || #len(protocols) > 4294967295 { return false }
  index: usize = 0
  for index < #len(protocols) {
    length := #cast(usize, protocols[index])
    index += 1
    if length == 0 || length > #len(protocols) - index { return false }
    index += length
  }
  return ssl_set_alpn(connection, &protocols[0], #cast(u32, #len(protocols))) == 0
}

// Server side: during each handshake, picks the first protocol of
// preference that the client offers, in wire format like set_alpn_protocols.
// preference must outlive the context (a string literal does). No common
// protocol continues without ALPN.
pub fn set_server_alpn(context: Context, preference: *const []const u8) bool {
  if context == nil || preference == nil || #len(preference.*) == 0 { return false }
  ssl_context_alpn_select(context, alpn_select, #cast(rawptr, preference))
  return true
}

// SSL_CTX_alpn_select_cb_func: SSL_TLSEXT_ERR_OK (0) with out pointing into
// the client's list, or SSL_TLSEXT_ERR_NOACK (3).
fn alpn_select(connection: rawptr, out: *rawptr, out_length: *u8, offered: *const u8, offered_length: u32, argument: rawptr) i32 {
  _ = connection
  preference := #cast(*const []const u8, argument).*
  if offered == nil || offered_length == 0 { return 3 }
  client := #slice(offered, offered_length)
  at: usize = 0
  for at < #len(preference) {
    length := #cast(usize, preference[at])
    if length == 0 || length > #len(preference) - at - 1 { return 3 }
    wanted := preference[at + 1..at + 1 + length]
    at += 1 + length
    index: usize = 0
    for index < #len(client) {
      size := #cast(usize, client[index])
      if size > #len(client) - index - 1 { break }
      candidate := client[index + 1..index + 1 + size]
      if size == length && bytes_equal(candidate, wanted) {
        out.* = #cast(rawptr, &client[index + 1])
        out_length.* = #cast(u8, size)
        return 0
      }
      index += 1 + size
    }
  }
  return 3
}

fn bytes_equal(left: []const u8, right: []const u8) bool {
  for i in 0..#len(left) {
    if left[i] != right[i] { return false }
  }
  return true
}

// Returned selection borrows the connection and dies when it is freed or renegotiated.
pub fn selected_alpn(connection: Connection) []const u8 {
  if connection == nil { return "" }
  selected: rawptr = nil
  length: u32 = 0
  ssl_get_alpn(connection, &selected, &length)
  if selected == nil || length == 0 { return "" }
  bytes := #cast(*const u8, selected)
  return #slice(bytes, length)
}

// Caller owns the returned reference and must call certificate_free_owned.
pub fn peer_certificate_owned(connection: Connection) Certificate {
  if connection == nil { return nil }
  return ssl_peer_certificate(connection)
}
pub fn certificate_free_owned(certificate: Certificate) {
  if certificate != nil {
    certificate_free(certificate)
  }
}
pub fn certificate_subject(destination: []u8, certificate: Certificate) []u8 {
  if certificate == nil || #len(destination) == 0 || #len(destination) > 2147483647 {
    return destination[..0]
  }
  name := certificate_subject_name(certificate)
  if name == nil || name_text(name, &destination[0], #cast(i32, #len(destination))) == nil {
    return destination[..0]
  }
  length: usize = 0
  for length < #len(destination) && destination[length] != 0 {
    length += 1
  }
  return destination[..length]
}

// Configures both certificate hostname verification and SNI. name_buffer must
// fit hostname plus NUL and is only borrowed during this call.
pub fn connection_create_owned(context: Context, descriptor: i32, hostname: []const u8, name_buffer: []u8) ConnectionResult {
  if context == nil || descriptor < 0 || #len(hostname) == 0 {
    return ConnectionResult{ value: nil, error: ErrorKind.InvalidArgument, provider_code: 0 }
  }
  converting: fail.Status
  name := c.string_into(&converting, name_buffer, hostname)
  if converting.failed {
    return ConnectionResult{ value: nil, error: ErrorKind.InvalidArgument, provider_code: 0 }
  }
  return connection_from_name(context, descriptor, name, #len(hostname))
}

fn connection_from_name(context: Context, descriptor: i32, name: *const u8, length: usize) ConnectionResult {
  provider_clear_error()
  connection := ssl_new(context)
  if connection == nil {
    return ConnectionResult{ error: ErrorKind.Provider, provider_code: provider_error() }
  }
  parameters := ssl_get_parameters(connection)
  configured := ssl_set_fd(connection, descriptor) == 1 && parameters != nil
  if configured {
    configured = parameters_set_host(parameters, name, length) == 1
  }
  if configured {
    configured = ssl_control(connection, SetTlsExtensionHostname, HostnameNameType, #cast(rawptr, name)) == 1
  }
  if !configured {
    code := provider_error()
    ssl_free(connection)
    return ConnectionResult{ error: ErrorKind.Provider, provider_code: code }
  }
  return ConnectionResult{ value: connection }
}

pub fn connection_create(arena: *mem.Arena, context: Context, descriptor: i32, hostname: []const u8) ConnectionResult {
  if context == nil || descriptor < 0 || #len(hostname) == 0 {
    return ConnectionResult{ error: ErrorKind.InvalidArgument }
  }
  mark := mem.arena_mark(arena)
  defer mem.arena_rewind(arena, mark)
  converting: fail.Status
  name := c.string_from_bytes(arena, &converting, hostname)
  if converting.failed { return ConnectionResult{ error: ErrorKind.InvalidArgument } }
  return connection_from_name(context, descriptor, name, #len(hostname))
}

pub fn connection_free_owned(connection: Connection) {
  if connection != nil {
    ssl_free(connection)
  }
}

pub fn handshake(connection: Connection) Result {
  if connection == nil { return failure(ErrorKind.InvalidArgument, 0) }
  provider_clear_error()
  connected := ssl_connect(connection)
  failed := Result{}
  if connected != 1 {
    failed = operation_failure(connection, connected)
  }
  verified := ssl_verify_result(connection)
  if verified != 0 {
    return Result{ count: 0, error: ErrorKind.Verification, provider_code: #cast(u64, verified), provider_status: connected }
  }
  if connected != 1 { return failed }
  return Result{ count: 0, error: ErrorKind.None, provider_code: 0, provider_status: connected }
}

pub fn server_handshake(connection: Connection) Result {
  if connection == nil { return failure(ErrorKind.InvalidArgument, 0) }
  provider_clear_error()
  status := ssl_accept(connection)
  if status != 1 { return operation_failure(connection, status) }
  return Result{ provider_status: 1 }
}

pub fn read(connection: Connection, destination: []u8) Result {
  if connection == nil { return failure(ErrorKind.InvalidArgument, 0) }
  if #len(destination) == 0 {
    return Result{ count: 0, error: ErrorKind.None, provider_code: 0, provider_status: 1 }
  }
  count: usize = 0
  provider_clear_error()
  status := ssl_read(connection, #cast(rawptr, &destination[0]), #len(destination), &count)
  if status != 1 {
    failed := operation_failure(connection, status)
    // SSL_ERROR_ZERO_RETURN means authenticated close_notify, not truncation.
    if failed.provider_status == 6 { return Result{ provider_status: 6 } }
    return failed
  }
  return Result{ count: count, error: ErrorKind.None, provider_code: 0, provider_status: status }
}

pub fn write(connection: Connection, source: []const u8) Result {
  if connection == nil { return failure(ErrorKind.InvalidArgument, 0) }
  if #len(source) == 0 {
    return Result{ count: 0, error: ErrorKind.None, provider_code: 0, provider_status: 1 }
  }
  count: usize = 0
  provider_clear_error()
  status := ssl_write(connection, #cast(rawptr, &source[0]), #len(source), &count)
  if status != 1 { return operation_failure(connection, status) }
  return Result{ count: count, error: ErrorKind.None, provider_code: 0, provider_status: status }
}

// May return false when provider requires another bidirectional shutdown call.
pub fn shutdown(connection: Connection) bool {
  if connection == nil { return false }
  return ssl_shutdown(connection) == 1
}

pub fn error_code(connection: Connection, provider_result: i32) i32 {
  if connection == nil { return 0 }
  return ssl_error(connection, provider_result)
}

// Writes provider message into caller buffer. Returned slice excludes NUL.
pub fn error_string(destination: []u8, code: u64) []u8 {
  if #len(destination) == 0 { return destination[..0] }
  provider_error_string(code, &destination[0], #len(destination))
  length: usize = 0
  for length < #len(destination) && destination[length] != 0 {
    length += 1
  }
  return destination[..length]
}

// Complete allocated subject text. Release with subject_text_free_owned.
// A nil formatting buffer asks OpenSSL to allocate the complete representation.
pub struct SubjectTextResult { value: *u8, provider_code: u64 }
extern fn provider_text_free "CRYPTO_free"(pointer: rawptr, file: *const u8, line: i32)
pub fn subject_text_owned(certificate: Certificate) SubjectTextResult {
  if certificate == nil { return SubjectTextResult{} }
  provider_clear_error()
  name := certificate_subject_name(certificate)
  if name == nil { return SubjectTextResult{ provider_code: provider_error() } }
  text := name_text(name, nil, 0)
  if text == nil { return SubjectTextResult{ provider_code: provider_error() } }
  return SubjectTextResult{ value: text }
}
pub fn subject_text_free_owned(text: *u8) {
  provider_text_free(text, nil, 0)
}
// Structured variants preserve retry state and diagnostics; bool APIs above
// remain available to raw-provider callers.
pub fn shutdown_result(connection: Connection) Result {
  if connection == nil { return failure(ErrorKind.InvalidArgument, 0) }
  provider_clear_error()
  status := ssl_shutdown(connection)
  if status == 1 { return Result{ provider_status: status } }
  if status == 0 { return Result{ error: ErrorKind.WantRead, provider_status: 0 } }
  return operation_failure(connection, status)
}
pub fn set_alpn_result(connection: Connection, protocols: []const u8) Result {
  if connection == nil || #len(protocols) == 0 || #len(protocols) > 4294967295 {
    return failure(ErrorKind.InvalidArgument, 0)
  }
  index: usize = 0
  for index < #len(protocols) {
    length := #cast(usize, protocols[index])
    index += 1
    if length == 0 || length > #len(protocols) - index {
      return failure(ErrorKind.InvalidArgument, 0)
    }
    index += length
  }
  provider_clear_error()
  status := ssl_set_alpn(connection, &protocols[0], #cast(u32, #len(protocols)))
  if status != 0 { return failure(ErrorKind.Provider, status) }
  return Result{}
}
