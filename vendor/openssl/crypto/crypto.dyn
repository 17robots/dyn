#target(kernel: linux)
#link("crypto")

pub const CipherAes256Gcm: u8 = 1
pub const CipherChacha20Poly1305: u8 = 2
// Each call takes the status first and returns the bytes written. Invalid
// lengths or keys fail with InvalidInput; a provider failure is System with
// OpenSSL's error code in failure.native.
const AeadSetIvLength: i32 = 9
const AeadGetTag: i32 = 16
const AeadSetTag: i32 = 17

fn cipher(kind: u8) rawptr {
  if kind == CipherAes256Gcm { return evp_aes_256_gcm() }
  if kind == CipherChacha20Poly1305 { return evp_chacha20_poly1305() }
  return nil
}
fn pointer(bytes: []const u8) rawptr {
  if #len(bytes) == 0 { return nil }
  return #cast(rawptr, &bytes[0])
}
fn mutable_pointer(bytes: []u8) rawptr {
  if #len(bytes) == 0 { return nil }
  return #cast(rawptr, &bytes[0])
}

// Seals into ciphertext and separate 16-byte tag. All buffers caller-owned.
pub fn aead_seal(status: *fail.Status, kind: u8, ciphertext: []u8, tag: []u8, plaintext: []const u8, additional: []const u8, key: []const u8, nonce: []const u8) usize {
  if status == nil { return aead_seal(&fail.Status{}, kind, ciphertext, tag, plaintext, additional, key, nonce) }
  if status.failed { return 0 }
  provider_clear_error()
  selected := cipher(kind)
  if selected == nil || #len(key) != 32 || #len(nonce) == 0 || #len(tag) < 16 || #len(ciphertext) < #len(plaintext) ||
    #len(plaintext) > 2147483647 || #len(additional) > 2147483647 || #len(nonce) > 2147483647 {
    crypto_failed(status, fail.Kind.InvalidInput, "aead seal", 0)
    return 0
  }
  context := evp_context_new()
  if context == nil {
    crypto_failed(status, fail.Kind.System, "aead seal", provider_error())
    return 0
  }
  success := evp_encrypt_init(context, selected, nil, nil, nil) == 1
  if success {
    success = evp_control(context, AeadSetIvLength, #cast(i32, #len(nonce)), nil) == 1
  }
  if success {
    success = evp_encrypt_init(context, nil, nil, pointer(key), pointer(nonce)) == 1
  }
  ignored: i32 = 0
  if success && #len(additional) > 0 {
    success = evp_encrypt_update(context, nil, &ignored, pointer(additional), #cast(i32, #len(additional))) == 1
  }
  produced: i32 = 0
  if success && #len(plaintext) > 0 {
    success = evp_encrypt_update(context, mutable_pointer(ciphertext), &produced, pointer(plaintext), #cast(i32, #len(plaintext))) == 1
  }
  final_count: i32 = 0
  if success {
    success = evp_encrypt_final(context, mutable_pointer(ciphertext[produced..]), &final_count) == 1
  }
  if success {
    success = evp_control(context, AeadGetTag, 16, mutable_pointer(tag[..16])) == 1
  }
  code: u64 = 0
  if !success {
    code = provider_error()
  }
  evp_context_free(context)
  if !success {
    crypto_failed(status, fail.Kind.System, "aead seal", code)
    return 0
  }
  return #cast(usize, (produced + final_count))
}

// Authentication failure fails the status like any provider failure; discard
// destination then.
pub fn aead_open(status: *fail.Status, kind: u8, plaintext: []u8, ciphertext: []const u8, tag: []const u8, additional: []const u8, key: []const u8, nonce: []const u8) usize {
  if status == nil { return aead_open(&fail.Status{}, kind, plaintext, ciphertext, tag, additional, key, nonce) }
  if status.failed { return 0 }
  provider_clear_error()
  selected := cipher(kind)
  if selected == nil || #len(key) != 32 || #len(nonce) == 0 || #len(tag) != 16 || #len(plaintext) < #len(ciphertext) ||
    #len(ciphertext) > 2147483647 || #len(additional) > 2147483647 || #len(nonce) > 2147483647 {
    crypto_failed(status, fail.Kind.InvalidInput, "aead open", 0)
    return 0
  }
  context := evp_context_new()
  if context == nil {
    crypto_failed(status, fail.Kind.System, "aead open", provider_error())
    return 0
  }
  success := evp_decrypt_init(context, selected, nil, nil, nil) == 1
  if success {
    success = evp_control(context, AeadSetIvLength, #cast(i32, #len(nonce)), nil) == 1
  }
  if success {
    success = evp_decrypt_init(context, nil, nil, pointer(key), pointer(nonce)) == 1
  }
  ignored: i32 = 0
  if success && #len(additional) > 0 {
    success = evp_decrypt_update(context, nil, &ignored, pointer(additional), #cast(i32, #len(additional))) == 1
  }
  produced: i32 = 0
  if success && #len(ciphertext) > 0 {
    success = evp_decrypt_update(context, mutable_pointer(plaintext), &produced, pointer(ciphertext), #cast(i32, #len(ciphertext))) == 1
  }
  if success {
    success = evp_control(context, AeadSetTag, 16, pointer(tag)) == 1
  }
  final_count: i32 = 0
  if success {
    success = evp_decrypt_final(context, mutable_pointer(plaintext[produced..]), &final_count) == 1
  }
  code: u64 = 0
  if !success {
    code = provider_error()
  }
  evp_context_free(context)
  if !success {
    crypto_failed(status, fail.Kind.System, "aead open", code)
    return 0
  }
  return #cast(usize, (produced + final_count))
}

const KeyX25519: i32 = 1034
const KeyEd25519: i32 = 1087

pub fn x25519_public(status: *fail.Status, destination: []u8, private_key: []const u8) usize {
  if status == nil { return x25519_public(&fail.Status{}, destination, private_key) }
  if status.failed { return 0 }
  provider_clear_error()
  if #len(destination) < 32 || #len(private_key) != 32 {
    crypto_failed(status, fail.Kind.InvalidInput, "x25519 public", 0)
    return 0
  }
  key := evp_pkey_raw_private(KeyX25519, nil, pointer(private_key), 32)
  if key == nil {
    crypto_failed(status, fail.Kind.System, "x25519 public", provider_error())
    return 0
  }
  length: usize = 32
  success := evp_pkey_public_bytes(key, mutable_pointer(destination[..32]), &length) == 1 && length == 32
  code: u64 = 0
  if !success {
    code = provider_error()
  }
  evp_pkey_free(key)
  if !success {
    crypto_failed(status, fail.Kind.System, "x25519 public", code)
    return 0
  }
  return length
}
pub fn x25519_shared(status: *fail.Status, destination: []u8, private_key: []const u8, peer_public_key: []const u8) usize {
  if status == nil { return x25519_shared(&fail.Status{}, destination, private_key, peer_public_key) }
  if status.failed { return 0 }
  provider_clear_error()
  if #len(destination) < 32 || #len(private_key) != 32 || #len(peer_public_key) != 32 {
    crypto_failed(status, fail.Kind.InvalidInput, "x25519 shared", 0)
    return 0
  }
  private := evp_pkey_raw_private(KeyX25519, nil, pointer(private_key), 32)
  peer := evp_pkey_raw_public(KeyX25519, nil, pointer(peer_public_key), 32)
  if private == nil || peer == nil {
    failure_code := provider_error()
    if private != nil {
      evp_pkey_free(private)
    }
    if peer != nil {
      evp_pkey_free(peer)
    }
    crypto_failed(status, fail.Kind.System, "x25519 shared", failure_code)
    return 0
  }
  context := evp_pkey_context_new(private, nil)
  success := context != nil
  if success {
    success = evp_pkey_derive_init(context) == 1 && evp_pkey_derive_peer(context, peer) == 1
  }
  length: usize = 32
  if success {
    success = evp_pkey_derive(context, mutable_pointer(destination[..32]), &length) == 1 && length == 32
  }
  code: u64 = 0
  if !success {
    code = provider_error()
  }
  if context != nil {
    evp_pkey_context_free(context)
  }
  evp_pkey_free(peer)
  evp_pkey_free(private)
  if !success {
    crypto_failed(status, fail.Kind.System, "x25519 shared", code)
    return 0
  }
  return length
}
pub fn ed25519_public(status: *fail.Status, destination: []u8, private_key: []const u8) usize {
  if status == nil { return ed25519_public(&fail.Status{}, destination, private_key) }
  if status.failed { return 0 }
  provider_clear_error()
  if #len(destination) < 32 || #len(private_key) != 32 {
    crypto_failed(status, fail.Kind.InvalidInput, "ed25519 public", 0)
    return 0
  }
  key := evp_pkey_raw_private(KeyEd25519, nil, pointer(private_key), 32)
  if key == nil {
    crypto_failed(status, fail.Kind.System, "ed25519 public", provider_error())
    return 0
  }
  length: usize = 32
  success := evp_pkey_public_bytes(key, mutable_pointer(destination[..32]), &length) == 1 && length == 32
  code: u64 = 0
  if !success {
    code = provider_error()
  }
  evp_pkey_free(key)
  if !success {
    crypto_failed(status, fail.Kind.System, "ed25519 public", code)
    return 0
  }
  return length
}
pub fn ed25519_sign(status: *fail.Status, destination: []u8, message: []const u8, private_key: []const u8) usize {
  if status == nil { return ed25519_sign(&fail.Status{}, destination, message, private_key) }
  if status.failed { return 0 }
  provider_clear_error()
  if #len(destination) < 64 || #len(private_key) != 32 {
    crypto_failed(status, fail.Kind.InvalidInput, "ed25519 sign", 0)
    return 0
  }
  key := evp_pkey_raw_private(KeyEd25519, nil, pointer(private_key), 32)
  context := evp_digest_context_new()
  if key == nil || context == nil {
    failure_code := provider_error()
    if key != nil {
      evp_pkey_free(key)
    }
    if context != nil {
      evp_digest_context_free(context)
    }
    crypto_failed(status, fail.Kind.System, "ed25519 sign", failure_code)
    return 0
  }
  length: usize = 64
  success := evp_digest_sign_init(context, nil, nil, nil, key) == 1
  if success {
    success = evp_digest_sign(context, mutable_pointer(destination[..64]), &length, pointer(message), #len(message)) == 1 && length == 64
  }
  code: u64 = 0
  if !success {
    code = provider_error()
  }
  evp_digest_context_free(context)
  evp_pkey_free(key)
  if !success {
    crypto_failed(status, fail.Kind.System, "ed25519 sign", code)
    return 0
  }
  return length
}
pub fn ed25519_verify(signature: []const u8, message: []const u8, public_key: []const u8) bool {
  provider_clear_error()
  if #len(signature) != 64 || #len(public_key) != 32 { return false }
  key := evp_pkey_raw_public(KeyEd25519, nil, pointer(public_key), 32)
  context := evp_digest_context_new()
  if key == nil || context == nil {
    if key != nil {
      evp_pkey_free(key)
    }
    if context != nil {
      evp_digest_context_free(context)
    }
    return false
  }
  success := evp_digest_verify_init(context, nil, nil, nil, key) == 1
  if success {
    success = evp_digest_verify(context, pointer(signature), 64, pointer(message), #len(message)) == 1
  }
  evp_digest_context_free(context)
  evp_pkey_free(key)
  return success
}

fn crypto_failed(status: *fail.Status, kind: fail.Kind, operation: []const u8, code: u64) {
  message: []const u8 = "invalid key, nonce or buffer length"
  if kind == fail.Kind.System {
    message = "OpenSSL failed"
  }
  failure := fail.make(kind, operation, "", message)
  failure.native = #cast(isize, code & 9223372036854775807)
  fail.set(status, failure)
}
