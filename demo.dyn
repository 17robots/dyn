use "std/io"
use "std/os"
use "std/thread"

thread_local global_log: io.Logger

pub struct Point {
  x: f32,
  y: f32
}

pub struct Grid {
  w: i32,
  h: i32
}

pub struct X {
  a: i32, b: i32, c: i32,
  x: f32, y: f32, z: f32,
}

pub struct Counter { n: i32 }
pub fn Counter.new() Counter { return Counter{n: 0} }
pub fn Counter.inc(s: *Counter) Counter { s.n += 1 }
pub fn Counter.dec(s: *Counter) Counter { s.n -= 1 }

pub enum MyEnum {
  Some,
  Thing,
  Here
}

pub struct ThingPayload { info: i32 }
pub enum Partnered {
  Some: i32,
  Thing: ThingPayload,
  Here: f32
}

pub enum ParseError {
  None,
  BadCheckSum,
  InvalidFormat
}

pub struct ParseResult {
  error: ParseError,
  payload: i32
}

pub struct Job {
  task_id: u32,
}

const MAX_BUFFER_SIZE = 4096
const ENGINE_VERSION = "1.0.0"

#expr arena_push() = #cast(*Type, os.arena_alloc(arena_ptr, #sizeof(Type)))

pub fn main() {
  global_log = io.Logger.init_stdout()
  global_log.print("Initializing engine version: {}", ENGINE_VERSION)
  main_arena = os.make_arena(1024 * 1024)
  defer main_arena.release()
  primitives()
  pointers()
  arrays_and_slices()
  if_statements()
  case_statements()
  defer_statements()
  loops()
  functions()
  enums()
  errors(&main_arena)
  structs()
  memory(&main_arena)
  concurrency()
}

fn primitives() {
  x = 0
  y: u32 = 1
  single: f32 = 1.0
  double: f64 = 1.0
  big = 1_000_000
  b = 0b1010
  o = 0o17
  char = 'a'
  boolean = false

  later: i32
  later = 42
  _ = later
}

fn pointers() {
  x: i32 = 1
  p = &x
  io.println("x == p.*", p.* == x)
}

fn arrays_and_slices() {
  fixed_nums: [5]i32 = [5]i32{1,2,3,4,5}
  slice_view: []i32 = fixed_nums
}

fn if_statements() {
  yes = true
  if yes {
    io.println("This should print")
  } else {
    io.println("This should not print")
  }
  x = 1
  y: i32
  if x == 1 {
    y = 12
  } else {
    y = 13
  }
  _ = y
}

fn case_statements() {
  x = 100
  case x {
    1 => { io.println("not this") }
    2 => { io.println("not this") }
    _ => { io.println("not this") }
  }
}
