use "std/bytes"
use "std/strings"
use "std/encoding/json"
use "std/fail"
use "std/fs"
use "std/path"
use "std/process"
use "std/mem"
use "std/fmt"
use "std/io"
use "std/net"
use "std/net/http"
use "std/net/http/evented"
use "std/sync"
use "std/time"

const Maximum: u64 = 9007199254740991
const Services: [16][]const u8 = ["svc00", "svc01", "svc02", "svc03", "svc04", "svc05", "svc06", "svc07", "svc08", "svc09", "svc10", "svc11", "svc12", "svc13", "svc14", "svc15"]
struct Summary { totals: [4]u64, services: [16][4]u64 }
struct Search { files: u64, bytes: u64, lines: u64, matching_lines: u64, matching_files: u64 }
struct Number { value: u64, ok: bool }
fn numeric(root: *const json.Value, key: []const u8) Number {
  node := json.object_get(root, key)
  if node.kind != json.KindNumber { return Number{} }
  // Integer fields normally use the integer reader. Fraction/exponent spellings
  // retain the same binary64 validation semantics as the other DOM ports.
  if strings.valid(u64, node.text) {
    integer := json.as(u64, node)
    return Number{ value: integer, ok: integer <= Maximum }
  }
  value := json.as(f64, node)
  if !(value >= 0.0 && value <= 9007199254740991.0) { return Number{} }
  integer := #cast(u64, value)
  return Number{ value: integer, ok: #cast(f64, integer) == value }
}
fn add_record(summary: *Summary, root: *const json.Value) bool {
  if root.kind != json.KindObject { return false }
  service := json.object_get(root, "service")
  if service.kind != json.KindString { return false }
  index: usize = 16
  for i in 0..16 {
    if bytes.equal(service.text, Services[i]) {
      index = i
      break
    }
  }
  if index == 16 { return false }
  status := numeric(root, "status")
  size := numeric(root, "bytes")
  latency := numeric(root, "latency_us")
  if !status.ok || status.value > 599 || !size.ok || !latency.ok { return false }
  error: u64
  if status.value >= 500 {
    error = 1
  }
  row: [4]u64 = [1, size.value, latency.value, error]
  for i in 0..4 {
    summary.totals[i] += row[i]
    summary.services[index][i] += row[i]
    if summary.totals[i] > Maximum { return false }
  }
  return true
}
fn member(arena: *mem.Arena, root: *json.Value, key: []const u8, value: u64) {
  if !json.add_member(root, key, json.push_number(arena, fmt.u64_decimal(arena, value))) {
    #panic("JSON output")
  }
}
fn encoded_summary(arena: *mem.Arena, summary: *const Summary) []u8 {
  root := json.push_object(arena)
  member(arena, root, "records", summary.totals[0])
  member(arena, root, "bytes", summary.totals[1])
  member(arena, root, "latency_us", summary.totals[2])
  member(arena, root, "errors", summary.totals[3])
  groups := json.push_array(arena)
  for i in 0..16 {
    row := json.push_array(arena)
    for j in 0..4 {
      if !json.add(row, json.push_number(arena, fmt.u64_decimal(arena, summary.services[i][j]))) {
        #panic("JSON output")
      }
    }
    if !json.add(groups, row) {
      #panic("JSON output")
    }
  }
  if !json.add_member(root, "services", groups) {
    #panic("JSON output")
  }
  return json.encode(arena, root)
}
fn print_json(value: []const u8) {
  status := fail.Status{ on_failure: fail.panic_on_failure }
  io.write(&status, io.stdout(), value)
  io.write(&status, io.stdout(), "\n")
}
fn report(file: []const u8) {
  input := mem.arena_alloc(mem.GiB)
  defer mem.arena_release(input)
  status := fail.Status{ on_failure: fail.panic_on_failure }
  read := fs.read_all(input, &status, file, 1024 * mem.MiB)
  scratch := mem.arena_alloc(0)
  defer mem.arena_release(scratch)
  summary: Summary
  at: usize
  for at < #len(read) {
    rest := read[at..]
    length := bytes.find_byte(rest, '\n')
    if length != 0 {
      record := json.parse(scratch, &status, rest[..length])
      if !add_record(&summary, record) {
        #panic("invalid record")
      }
      mem.arena_reset(scratch)
    }
    at += length
    if at < #len(read) {
      at += 1
    }
  }
  print_json(encoded_summary(scratch, &summary))
}
fn search_walk(status: *fail.Status, directory: []const u8, result: *Search) {
  buffer: [32768]u8
  state := fs.open_directory(status, directory, buffer[..])
  defer fs.close_directory(&state)
  scratch := mem.arena_alloc(0)
  defer mem.arena_release(scratch)
  for {
    entry := fs.directory_next(status, &state)
    if !entry.found { break }
    // Linux directory entry types: DT_DIR=4, DT_REG=8
    // Symlinks are skipped.
    if entry.kind == 0 {
      #panic("filesystem does not report entry types")
    }
    if entry.kind != 4 && entry.kind != 8 { continue }
    joined := path.join(scratch, directory, entry.name)
    if entry.kind == 4 {
      search_walk(status, joined, result)
    } else if bytes.ends_with(entry.name, ".txt") {
      read := fs.read_all(scratch, status, joined, 1024 * mem.MiB)
      result.files += 1
      result.bytes += #cast(u64, #len(read))
      at: usize
      matching: bool
      for at < #len(read) {
        rest := read[at..]
        length := bytes.find_byte(rest, '\n')
        result.lines += 1
        if bytes.contains(rest[..length], "ERROR") {
          result.matching_lines += 1
          matching = true
        }
        at += length
        if at < #len(read) {
          at += 1
        }
      }
      if matching {
        result.matching_files += 1
      }
    }
    mem.arena_reset(scratch)
  }
}
fn search(directory: []const u8) {
  result: Search
  // A benchmark: any failure ends it with its description.
  status := fail.Status{ on_failure: fail.panic_on_failure }
  search_walk(&status, directory, &result)
  arena := mem.arena_alloc(0)
  defer mem.arena_release(arena)
  root := json.push_object(arena)
  member(arena, root, "files", result.files)
  member(arena, root, "bytes", result.bytes)
  member(arena, root, "lines", result.lines)
  member(arena, root, "matching_lines", result.matching_lines)
  member(arena, root, "matching_files", result.matching_files)
  print_json(json.encode(arena, root))
}
struct App { quit: sync.AtomicU32 }
fn handle(status: *fail.Status, response: *http.Response, request: *const http.Request) {
  if bytes.equal(request.method, "GET") && bytes.equal(request.target, "/health") {
    http.respond(status, response, "ok\n", http.ResponseOptions{ content_type: "text/plain", close_connection: true })
    return
  }
  if bytes.equal(request.method, "POST") && bytes.equal(request.target, "/quit") {
    http.respond(status, response, "bye\n", http.ResponseOptions{ close_connection: true })
    sync.store_u32(&#cast(*App, request.context).quit, 1)
    return
  }
  if !bytes.equal(request.method, "POST") || !bytes.equal(request.target, "/summarize") {
    http.respond(status, response, "not found\n", http.ResponseOptions{ status: 404, close_connection: true })
    return
  }
  arena := mem.arena_alloc(0)
  defer mem.arena_release(arena)
  if #len(request.body) > mem.MiB {
    http.respond(status, response, "invalid\n", http.ResponseOptions{ status: 400, close_connection: true })
    return
  }
  parsing: fail.Status
  root := json.parse(arena, &parsing, request.body)
  if parsing.failed || root.kind != json.KindArray {
    http.respond(status, response, "invalid\n", http.ResponseOptions{ status: 400, close_connection: true })
    return
  }
  summary: Summary
  child := root.first
  for child != nil {
    if !add_record(&summary, child) {
      http.respond(status, response, "invalid\n", http.ResponseOptions{ status: 400, close_connection: true })
      return
    }
    child = child.next
  }
  http.respond(status, response, encoded_summary(arena, &summary), http.ResponseOptions{ content_type: "application/json", close_connection: true })
}
fn serve() {
  config := evented.default_config()
  // Bodies up to 1 MiB borrow an upload block; one per connection slot in use.
  config.upload_size = mem.MiB + 16384
  config.upload_count = 4
  config.connections_per_worker = 64
  arena := mem.arena_alloc(evented.storage_size(config, 4) + mem.MiB)
  defer mem.arena_release(arena)
  state := mem.push(App, arena)
  workers := mem.push_array(evented.Worker, arena, 4)
  status := fail.Status{ on_failure: fail.panic_on_failure }
  _ = evented.start_shared(arena, &status, workers, net.ipv4(127, 0, 0, 1, 0), 128, config, handle, state)
  io.println("port {}", evented.local_port(workers))
  for sync.load_u32(&state.quit) == 0 {
    time.sleep(time.Millisecond)
  }
  evented.stop(workers)
  evented.join(&status, workers)
}
fn main() {
  arena := mem.arena_alloc(mem.GiB)
  defer mem.arena_release(arena)
  arguments_status: fail.Status
  arguments := process.arguments(arena, &arguments_status)
  if arguments_status.failed {
    #panic("arguments")
  }
  args := arguments
  if #len(args) == 2 && bytes.equal(args[1], "serve") {
    serve()
    return
  }
  if #len(args) != 3 {
    #panic("usage: report FILE | search DIRECTORY | serve")
  }
  if bytes.equal(args[1], "report") {
    report(args[2])
  } else if bytes.equal(args[1], "search") {
    search(args[2])
  } else {
    #panic("unknown mode")
  }
}

