use "std/io"

flags: [8000000]u8

fn main() {
  total: u64 = 0
  for round in 0..10 {
    for i in 0..flags.len {
      flags[i] = 1
    }
    count: u64 = 0
    for i in 2..flags.len {
      if flags[i] == 1 {
        count += 1
        j := i * 2
        for j < flags.len {
          flags[j] = 0
          j += i
        }
      }
    }
    total += count + #cast(u64, round)
  }
  io.println("{}", total)
}
