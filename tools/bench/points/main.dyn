use "std/io"

struct Point {
  x: i64,
  y: i64,
}

points: [4096]Point

fn step(p: Point, d: Point) Point {
  return Point{x: (p.x + d.x) % 1000003, y: (p.y * 3 + d.y) % 1000003}
}

fn main() {
  for i in 0..#len(points) {
    points[i] = Point{x: #cast(i64, i), y: #cast(i64, (i * 7))}
  }
  delta := Point{x: 5, y: 11}
  for round in 0..2000 {
    for *p in points {
      p.* = step(p.*, delta)
    }
  }
  total: i64 = 0
  for p in points {
    total += p.x + p.y
  }
  _ = io.println(io.stdout(), "{}", total)
}
