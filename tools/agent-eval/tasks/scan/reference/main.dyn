use "std/bytes"
use "std/encoding/json"
use "std/fail"
use "std/fs"
use "std/io"
use "std/mem"
use "std/path"
use "std/process"

fn report(name: []const u8, failure: fail.Failure) {
  storage: [512]u8
  text := fail.describe(storage[..], failure)
  if #len(fail.path_text(&failure)) == 0 {
    io.eprintln("scan: {}: {}", name, text)
  } else {
    io.eprintln("scan: {}", text)
  }
}

// The whole-number "port" of the JSON file at path.
fn port(arena: *mem.Arena, status: *fail.Status, file: []const u8) i64 {
  text := fs.read_all(arena, status, file, mem.MiB)
  root := json.parse(arena, status, text)
  return json.get(i64, status, root, "port")
}

fn main() i32 {
  program := process.start()
  if #len(program.args) != 2 {
    io.eprintln("scan: usage: scan DIR")
    return 1
  }
  directory := program.args[1]
  arena := mem.arena_alloc(0)
  defer mem.arena_release(arena)
  listing: fail.Status
  entries := fs.list(arena, &listing, directory)
  if listing.failed {
    report(directory, listing.failure)
    return 1
  }
  good: usize = 0
  bad: usize = 0
  for entry in entries {
    if !bytes.ends_with(entry.name, ".json") { continue }
    mark := mem.arena_mark(arena)
    status: fail.Status
    value := port(arena, &status, path.join(arena, directory, entry.name))
    if status.failed {
      report(entry.name, status.failure)
      bad += 1
    } else {
      io.println("{} port={}", entry.name, value)
      good += 1
    }
    mem.arena_rewind(arena, mark)
  }
  io.println("good {} bad {}", good, bad)
  if bad == 0 { return 0 }
  return 1
}
