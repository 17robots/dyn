use "std/bytes"
use "std/encoding/json"
use "std/fs"
use "std/io"
use "std/mem"
use "std/parse"
use "std/path"
use "std/process"

// Reads the whole-number "port" of the JSON file at path into value. On
// failure prints one line that says why and returns false.
fn port(arena: *mem.Arena, name: []const u8, file: []const u8, value: *i64) bool {
  text := fs.read_all(arena, file, mem.MiB) catch err {
    io.eprintln("scan: {}: {}", name, err)
    return false
  }
  root := json.parse(arena, text) catch err {
    io.eprintln("scan: {}: invalid JSON at byte {}", name, parse.offset(err))
    return false
  }
  value.* = json.get<i64>(root, "port") catch err {
    case err {
      .NotFound => { io.eprintln("scan: {}: \"port\" is missing", name) }
      _ => { io.eprintln("scan: {}: \"port\" is not a whole number", name) }
    }
    return false
  }
  return true
}

fn main() i32 {
  program := process.start()
  if program.args.len != 2 {
    io.eprintln("scan: usage: scan DIR")
    return 1
  }
  directory := program.args[1]
  arena := mem.arena_alloc(0)
  defer mem.arena_release(arena)
  entries := fs.list(arena, directory) catch err {
    io.eprintln("scan: {}: {}", directory, err)
    return 1
  }
  good: usize = 0
  bad: usize = 0
  for entry in entries {
    if !bytes.ends_with(entry.name, ".json") { continue }
    mark := mem.arena_mark(arena)
    value: i64 = 0
    if !port(arena, entry.name, path.join(arena, directory, entry.name), &value) {
      bad += 1
    } else {
      io.println("{} port={}", entry.name, value)
      good += 1
    }
    mem.arena_rewind(arena, mark)
  }
  io.println("good {} bad {}", good, bad)
  if bad == 0 { return 0 }
  return 1
}
