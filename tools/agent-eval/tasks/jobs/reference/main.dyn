use "std/bufio"
use "std/bytes"
use "std/fs"
use "std/io"
use "std/strings"

// Newline characters in path, read a buffer at a time.
fn count(path: []const u8) usize!io.IoErr {
  file := try fs.open(path)
  defer fs.close(&file)
  buffer: [65536]u8
  lines: usize = 0
  for {
    got := try fs.read(&file, buffer[..])
    if got == 0 { break }
    lines += bytes.count_occurrences(buffer[..got], "\n")
  }
  return lines
}

fn copy(from: []const u8, to: []const u8) !io.IoErr {
  input := try fs.open(from)
  defer fs.close(&input)
  output := try fs.create(to)
  defer fs.close(&output)
  buffer: [65536]u8
  for {
    got := try fs.read(&input, buffer[..])
    if got == 0 { break }
    try fs.write(&output, buffer[..got])
  }
}

// Runs one command line. Returns false when it failed or was unknown.
fn run(line: []const u8) bool {
  command := line
  rest: []const u8 = ""
  space := bytes.find_byte(line, ' ')
  if space < line.len {
    command = line[..space]
    rest = strings.trim(line[space + 1..])
  }
  case command {
    "count" => {
      lines := count(rest) catch err {
        io.eprintln("jobs: {}: {}", rest, err)
        return false
      }
      io.println("{} {}", rest, lines)
    }
    "copy" => {
      split := bytes.find_byte(rest, ' ')
      if split == rest.len {
        io.eprintln("jobs: copy needs FROM and TO: {}", line)
        return false
      }
      from := rest[..split]
      to := strings.trim(rest[split + 1..])
      copy(from, to) catch err {
        io.eprintln("jobs: copy {} to {}: {}", from, to, err)
        return false
      }
      io.println("copied {}", from)
    }
    "remove" => {
      fs.remove(rest) catch err {
        io.eprintln("jobs: {}: {}", rest, err)
        return false
      }
      io.println("removed {}", rest)
    }
    _ => {
      io.eprintln("jobs: unknown command: {}", line)
      return false
    }
  }
  return true
}

fn main() i32 {
  storage: [65536]u8
  input := bufio.reader(io.stdin(), storage[..])
  all_good := true
  for {
    line := bufio.read_line(&input) catch err {
      io.eprintln("jobs: {}", err)
      return 1
    }
    if input.ended { break }
    text := strings.trim(line)
    if bytes.equal(text, "quit") { break }
    if text.len != 0 && !run(text) {
      all_good = false
    }
  }
  if all_good { return 0 }
  return 1
}
