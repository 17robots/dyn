use "std/fs"
use "std/io"
use "std/process"

// Appends every byte of path to output, a buffer at a time.
fn append(output: *fs.File, path: []const u8) !io.IoErr {
  input := try fs.open(path)
  defer fs.close(&input)
  buffer: [65536]u8
  for {
    count := try fs.read(&input, buffer[..])
    if count == 0 { break }
    try fs.write(output, buffer[..count])
  }
}

fn main() i32 {
  program := process.start()
  if program.args.len < 3 {
    io.eprintln("concat: usage: concat OUTPUT INPUT...")
    return 1
  }
  target := program.args[1]
  output := fs.create(target) catch err {
    io.eprintln("concat: {}: {}", target, err)
    return 1
  }
  defer fs.close(&output)
  for path in program.args[2..] {
    append(&output, path) catch err {
      io.eprintln("concat: {}: {}", path, err)
      return 1
    }
  }
  return 0
}
