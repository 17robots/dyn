use "std/encoding/json"
use "std/fs"
use "std/io"
use "std/mem"
use "std/parse"
use "std/process"

struct Settings {
  name: []const u8,
  port: i64,
}

// Why a JSON member could not be read.
fn member_problem(err: io.IoErr) []const u8 {
  case err {
    .NotFound => { return "is missing" }
    _ => { return "has the wrong type" }
  }
}

// Reads the settings at path into settings. On failure prints one line and
// returns false.
fn load(arena: *mem.Arena, path: []const u8, settings: *Settings) bool {
  text := fs.read_all(arena, path, mem.MiB) catch err {
    io.eprintln("settings: {}: {}", path, err)
    return false
  }
  root := json.parse(arena, text) catch err {
    io.eprintln("settings: {}: invalid JSON at byte {}", path, parse.offset(err))
    return false
  }
  settings.name = json.get<[]const u8>(root, "name") catch err {
    io.eprintln("settings: {}: \"name\" {}", path, member_problem(err))
    return false
  }
  settings.port = json.get<i64>(root, "port") catch err {
    io.eprintln("settings: {}: \"port\" {}", path, member_problem(err))
    return false
  }
  if settings.port < 1 || settings.port > 65535 {
    io.eprintln("settings: {}: \"port\" is not a whole number from 1 to 65535", path)
    return false
  }
  return true
}

fn missing(path: []const u8) bool {
  _ = fs.metadata(path) catch err {
    case err {
      .NotFound => { return true }
      _ => { return false }
    }
  }
  return false
}

fn main() i32 {
  program := process.start()
  if program.args.len != 3 {
    io.eprintln("settings: usage: settings FIRST SECOND")
    return 1
  }
  arena := mem.arena_alloc(0)
  defer mem.arena_release(arena)
  used := program.args[1]
  // Only a missing FIRST falls back; any other failure of FIRST stands.
  if missing(used) {
    used = program.args[2]
  }
  settings: Settings
  if !load(arena, used, &settings) { return 1 }
  io.println("name={} port={} from={}", settings.name, settings.port, used)
  return 0
}
