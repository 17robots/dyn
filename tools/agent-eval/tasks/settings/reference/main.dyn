use "std/encoding/json"
use "std/fail"
use "std/fs"
use "std/io"
use "std/mem"
use "std/process"

struct Settings {
  name: []const u8,
  port: i64,
}

fn report(path: []const u8, failure: fail.Failure) {
  storage: [512]u8
  text := fail.describe(storage[..], failure)
  if fail.path_text(&failure).len == 0 {
    io.eprintln("settings: {}: {}", path, text)
  } else {
    io.eprintln("settings: {}", text)
  }
}

fn load(arena: *mem.Arena, status: *fail.Status, path: []const u8) Settings {
  text := fs.read_all(arena, path, mem.MiB) catch err {
    fail.set(status, io.failure_of(err, "read", path))
    return Settings{}
  }
  root := json.parse(arena, status, text)
  name := json.get<[]const u8>(status, root, "name")
  port := json.get<i64>(status, root, "port")
  if !status.failed && (port < 1 || port > 65535) {
    fail.invalid(status, "read", path, "\"port\" is not a whole number from 1 to 65535")
  }
  if status.failed { return Settings{} }
  return Settings{ name: name, port: port }
}

fn missing(path: []const u8) bool {
  _ = fs.metadata(path) catch err {
    case err {
      .NotFound => { return true }
      _ => { return false }
    }
  }
  return false
}

fn main() i32 {
  program := process.start()
  if program.args.len != 3 {
    io.eprintln("settings: usage: settings FIRST SECOND")
    return 1
  }
  arena := mem.arena_alloc(0)
  defer mem.arena_release(arena)
  used := program.args[1]
  // Only a missing FIRST falls back; any other failure of FIRST stands.
  if missing(used) {
    used = program.args[2]
  }
  status: fail.Status
  settings := load(arena, &status, used)
  if status.failed {
    report(used, status.failure)
    return 1
  }
  io.println("name={} port={} from={}", settings.name, settings.port, used)
  return 0
}
