use "std/encoding/json"
use "std/fail"
use "std/fs"
use "std/io"
use "std/mem"
use "std/process"

// One line on standard error. A parse failure carries no path, so name it.
fn report(path: []const u8, failure: fail.Failure) {
  storage: [512]u8
  text := fail.describe(storage[..], failure)
  if fail.path_text(&failure).len == 0 {
    io.eprintln("config: {}: {}", path, text)
  } else {
    io.eprintln("config: {}", text)
  }
}

fn main() i32 {
  program := process.start()
  if program.args.len != 2 {
    io.eprintln("config: usage: config PATH")
    return 1
  }
  path := program.args[1]
  arena := mem.arena_alloc(0)
  defer mem.arena_release(arena)
  text := fs.read_all(arena, path, mem.MiB) catch err {
    io.eprintln("config: {}: {}", path, err)
    return 1
  }
  status: fail.Status
  root := json.parse(arena, &status, text)
  name := json.get<[]const u8>(&status, root, "name")
  port := json.get<i64>(&status, root, "port")
  if status.failed {
    report(path, status.failure)
    return 1
  }
  io.println("name={} port={}", name, port)
  return 0
}
