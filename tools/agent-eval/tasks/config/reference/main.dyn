use "std/encoding/json"
use "std/fs"
use "std/io"
use "std/mem"
use "std/parse"
use "std/process"

// Why a JSON member could not be read.
fn member_problem(err: io.IoErr) []const u8 {
  case err {
    .NotFound => { return "is missing" }
    _ => { return "has the wrong type" }
  }
}

fn main() i32 {
  program := process.start()
  if program.args.len != 2 {
    io.eprintln("config: usage: config PATH")
    return 1
  }
  path := program.args[1]
  arena := mem.arena_alloc(0)
  defer mem.arena_release(arena)
  text := fs.read_all(arena, path, mem.MiB) catch err {
    io.eprintln("config: {}: {}", path, err)
    return 1
  }
  root := json.parse(arena, text) catch err {
    io.eprintln("config: {}: invalid JSON at byte {}", path, parse.offset(err))
    return 1
  }
  name := json.get<[]const u8>(root, "name") catch err {
    io.eprintln("config: {}: \"name\" {}", path, member_problem(err))
    return 1
  }
  port := json.get<i64>(root, "port") catch err {
    io.eprintln("config: {}: \"port\" {}", path, member_problem(err))
    return 1
  }
  io.println("name={} port={}", name, port)
  return 0
}
