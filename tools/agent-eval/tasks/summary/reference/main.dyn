use "std/bytes"
use "std/fail"
use "std/fmt"
use "std/fs"
use "std/io"
use "std/mem"
use "std/path"
use "std/process"

fn main() i32 {
  program := process.start()
  if program.args.len != 3 {
    io.eprintln("summary: usage: summary SOURCE OUTPUT")
    return 1
  }
  source := program.args[1]
  output := program.args[2]
  arena := mem.arena_alloc(0)
  defer mem.arena_release(arena)
  entries := fs.list(arena, source) catch err {
    io.eprintln("summary: {}: {}", source, err)
    return 1
  }
  text := mem.push_bytes(arena, 64 * 1024)
  rendering: fail.Status
  lines := fmt.buffer(&rendering, text)
  total: usize = 0
  for entry in entries {
    if !bytes.ends_with(entry.name, ".txt") { continue }
    file := path.join(arena, source, entry.name)
    content := fs.read_all(arena, file, 1 << 30) catch err {
      io.eprintln("summary: {}: {}", file, err)
      return 1
    }
    count := bytes.count_occurrences(content, "\n")
    fmt.print(&lines, "{} {}\n", entry.name, count)
    total += count
  }
  fmt.print(&lines, "total {}\n", total)
  if rendering.failed {
    io.eprintln("summary: the summary does not fit 64 KiB")
    return 1
  }
  fs.make_directory(output) catch err {
    io.eprintln("summary: {}: {}", output, err)
    return 1
  }
  target := path.join(arena, output, "summary.txt")
  fs.write_all(target, fmt.bytes(&lines)) catch err {
    io.eprintln("summary: {}: {}", target, err)
    return 1
  }
  return 0
}
