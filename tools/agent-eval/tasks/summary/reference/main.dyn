use "std/bytes"
use "std/fail"
use "std/fmt"
use "std/fs"
use "std/io"
use "std/mem"
use "std/path"
use "std/process"

fn report(failure: fail.Failure) {
  storage: [512]u8
  io.eprintln("summary: {}", fail.describe(storage[..], failure))
}

fn main() i32 {
  program := process.start()
  if #len(program.args) != 3 {
    io.eprintln("summary: usage: summary SOURCE OUTPUT")
    return 1
  }
  source := program.args[1]
  output := program.args[2]
  arena := mem.arena_alloc(0)
  defer mem.arena_release(arena)
  status: fail.Status
  entries := fs.list(arena, &status, source)
  text := mem.push_bytes(arena, 64 * 1024)
  lines := fmt.buffer(&status, text)
  total: usize = 0
  for entry in entries {
    if status.failed { break }
    if !bytes.ends_with(entry.name, ".txt") { continue }
    content := fs.read_all(arena, &status, path.join(arena, source, entry.name), 1 << 30)
    count := bytes.count_occurrences(content, "\n")
    fmt.print(&lines, "{} {}\n", entry.name, count)
    total += count
  }
  fmt.print(&lines, "total {}\n", total)
  fs.make_directory(&status, output)
  fs.write_all(&status, path.join(arena, output, "summary.txt"), fmt.bytes(&lines))
  if status.failed {
    report(status.failure)
    return 1
  }
  return 0
}
