use "std/fs"
use "std/io"
use "std/mem"
use "std/process"
use "std/strings"

// TO appears only once it is complete: written beside it, then renamed.
fn move(arena: *mem.Arena, from: []const u8, to: []const u8) !io.IoErr {
  input := try fs.open(from)
  defer fs.close(&input)
  output := try fs.atomic_begin(to, strings.format(arena, "{}.move-partial", to))
  defer fs.atomic_abort(&output)
  buffer: [65536]u8
  for {
    count := try fs.read(&input, buffer[..])
    if count == 0 { break }
    try fs.write(&output.file, buffer[..count])
  }
  try fs.atomic_commit(&output)
  try fs.remove(from)
}

fn main() i32 {
  program := process.start()
  if program.args.len != 3 {
    io.eprintln("move: usage: move FROM TO")
    return 1
  }
  from := program.args[1]
  to := program.args[2]
  arena := mem.arena_alloc(0)
  defer mem.arena_release(arena)
  move(arena, from, to) catch err {
    io.eprintln("move: {} to {}: {}", from, to, err)
    return 1
  }
  return 0
}
