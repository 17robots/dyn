
use "std/io"
use "std/mem" mem
use "std/process"
use "std/sort"
use "std/bytes"
fn number(s:[]const u8) usize {v:usize=0
for b in s {v=v*10+#cast(usize,b-48)}
return v}
fn next(x:*u32) u32 {x.*=#wrap(x.* * 1664525 + 1013904223)
return x.*}
fn main(){arena:=mem.arena_create(268435456)
defer mem.arena_release(&arena)
args:=process.arguments(&arena)
if !args.ok {#panic("args")}
mode:=args.value[1]
n:=number(args.value[2])
rounds:=number(args.value[3])
seed:=#cast(u32,number(args.value[4]))
sum:u64=0
if bytes.equal(mode,"sort") {v:=mem.push_array(u32,&arena,n)
for r in 0..rounds {x:=#wrap(seed+#cast(u32,r))
for i in 0..n {v[i]=next(&x)}
sort.sort(v)
for i in 0..n {sum=#wrap(sum+#cast(u64,v[i])*#cast(u64,i+1))}}}
else if bytes.equal(mode,"map") {capacity:usize=1
for capacity<n*2 {capacity*=2}
k:=mem.push_array(u32,&arena,capacity)
v:=mem.push_array(u32,&arena,capacity)
input:=mem.push_array(u32,&arena,n)
for r in 0..rounds {for i in 0..capacity{k[i]=0
v[i]=0}
x:=#wrap(seed+#cast(u32,r))
for i in 0..n {key:=1+(next(&x)>>8)%#cast(u32,n*8)
input[i]=key
p:=#cast(usize,#wrap(key*2654435761))&(capacity-1)
for k[p]!=0 && k[p]!=key {p=(p+1)&(capacity-1)}
k[p]=key
v[p]+=1}
for p in 0..capacity {sum=#wrap(sum+#cast(u64,k[p])*#cast(u64,v[p]))}
for key in input {p:=#cast(usize,#wrap(key*2654435761))&(capacity-1)
for k[p]!=key {p=(p+1)&(capacity-1)}
sum=#wrap(sum+#cast(u64,key)*#cast(u64,v[p]))}}}
else if bytes.equal(mode,"utf8") {v:=mem.push_array(u8,&arena,n*4)
used:usize=0
x:=seed
for j in 0..n {c:=next(&x)%1112064
if c>=55296 {c+=2048}
if c<128 {v[used]=#cast(u8,c)
used+=1}else if c<2048 {v[used]=#cast(u8,192|(c>>6))
v[used+1]=#cast(u8,128|(c&63))
used+=2}else if c<65536 {v[used]=#cast(u8,224|(c>>12))
v[used+1]=#cast(u8,128|((c>>6)&63))
v[used+2]=#cast(u8,128|(c&63))
used+=3}else {v[used]=#cast(u8,240|(c>>18))
v[used+1]=#cast(u8,128|((c>>12)&63))
v[used+2]=#cast(u8,128|((c>>6)&63))
v[used+3]=#cast(u8,128|(c&63))
used+=4}}
for r in 0..rounds {i:usize=0
for i<used {c:=#cast(u32,v[i])
i+=1
more:usize=0
if c>=240 {c&=7
more=3}else if c>=224 {c&=15
more=2}else if c>=192 {c&=31
more=1}
for j in 0..more {c=(c<<6)|#cast(u32,v[i]&63)
i+=1}
sum=#wrap(sum+#cast(u64,c))}}}
else if bytes.equal(mode,"allocate") {blocks:=mem.push_array([]u64,&arena,n)
mark:=mem.arena_mark(&arena)
for r in 0..rounds {x:=#wrap(seed+#cast(u32,r))
for i in 0..n {blocks[i]=mem.push_array(u64,&arena,8)
blocks[i][0]=#cast(u64,next(&x))
blocks[i][7]=#cast(u64,next(&x))}
for b in blocks {sum=#wrap(sum+b[0]+b[7])}
mem.arena_rewind(&arena,mark)}}else {#panic("mode")}
_=io.println(io.stdout(),"{}",sum)}
