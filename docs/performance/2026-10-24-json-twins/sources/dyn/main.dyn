// Experimental matched C/Dyn parser twin; snapshot-derived, not std API.
pub struct Arena { data: *u8, capacity: usize, offset: usize, peak: usize, allocations: u64, bytes: u64, trace: u64, flags: u64 }
pub struct Value { tag: u64, bits: u64 }
pub struct Result { root: *const Value, ok: u64, detail: u64, offset: usize, used: usize, retained: usize }
struct Cursor { source: []const u8, at: usize, error: u64 }
struct ReadParser { cursor: Cursor, buffer: []u8, values: []Value, used: usize, limit: usize, arena: *Arena }
const MaximumDepth: usize = 256
const KindNull: u8 = 1
const KindBool: u8 = 2
const KindNumber: u8 = 3
const KindString: u8 = 4
const KindArray: u8 = 5
const KindObject: u8 = 6
const ReadUnsigned: u64 = 256
const ReadSigned: u64 = 512
const ReadFloat: u64 = 768
const nil_value: Value = Value{}
extern fn lab_push(arena: *Arena, size: usize, alignment: usize) *u8
extern fn lab_rewind(arena: *Arena, mark: usize)
extern fn lab_copy(destination: *u8, source: *const u8, size: usize)
extern fn lab_utf8(source: *const u8, size: usize) u64
extern fn lab_decimal(source: *const u8, size: usize) f64
extern fn lab_ascii(source: *const u8, size: usize) usize
fn read_append(state: *ReadParser, kind: u8, bits: u64) usize {
  if state.used == #len(state.values) {
    old := #len(state.values)
    capacity := old * 2
    if capacity > state.limit {
      capacity = state.limit
    }
    if capacity <= old {
      #panic("JSON compact node bound")
    }
    tail := lab_push(state.arena, (capacity - old) * 16, 8)
    expected := #cast(usize, &state.values[0]) + old * 16
    if #cast(usize, tail) != expected {
      #panic("JSON compact arena moved")
    }
    state.values = (&state.values[0])[..capacity]
  }
  index := state.used
  state.values[index] = Value{ tag: #cast(u64, kind), bits: bits }
  state.used += 1
  return index
}

fn read_skip(cursor: *Cursor) {
  source := cursor.source
  at := cursor.at
  for at < #len(source) {
    byte := source[at]
    if byte != ' ' && byte != 10 && byte != 13 && byte != 9 {
      break
    }
    at += 1
  }
  cursor.at = at
}
fn read_number(state: *ReadParser) bool {
  source := state.cursor.source
  start := state.cursor.at
  at := start
  negative := source[at] == '-'
  if negative {
    at += 1
  }
  if at == #len(source) {
    return false
  }
  integer: u64 = 0
  exact := true
  byte := source[at]
  if byte == '0' {
    at += 1
  }
  else {
    if byte < '1' || byte > '9' {
      return false
    }
    for at < #len(source) {
      byte = source[at]
      if byte < '0' || byte > '9' {
        break
      }
      n := #cast(u64, byte - '0')
      if exact {
        if integer > 1844674407370955161 || (integer == 1844674407370955161 && n > 5) {
          exact = false
        }
        else {
          integer = #wrap(integer * 10 + n)
        }
      }
      at += 1
    }
  }
  if at < #len(source) && source[at] == '.' {
    exact = false
    at += 1
    begin := at
    for at < #len(source) {
      byte = source[at]
      if byte < '0' || byte > '9' {
        break
      }
      at += 1
    }
    if at == begin {
      state.cursor.at = at
      return false
    }
  }
  if at < #len(source) && (source[at] == 'e' || source[at] == 'E') {
    exact = false
    at += 1
    if at < #len(source) && (source[at] == '+' || source[at] == '-') {
      at += 1
    }
    begin := at
    for at < #len(source) {
      byte = source[at]
      if byte < '0' || byte > '9' {
        break
      }
      at += 1
    }
    if at == begin {
      state.cursor.at = at
      return false
    }
  }
  state.cursor.at = at
  if exact && !negative {
    index := read_append(state, KindNumber, integer)
    state.values[index].tag |= ReadUnsigned
    return true
  }
  if exact && negative && integer != 0 && integer <= 9223372036854775808 {
    magnitude := #wrap(0 - integer)
    index := read_append(state, KindNumber, magnitude)
    state.values[index].tag |= ReadSigned
    return true
  }
  value := lab_decimal(&source[start], at - start)
  if value > 1.7976931348623157e308 || value < -1.7976931348623157e308 {
    state.cursor.error = 3
    return false
  }
  index := read_append(state, KindNumber, #bitcast(u64, value))
  state.values[index].tag |= ReadFloat
  return true
}

fn read_value(state: *ReadParser, depth: usize) bool {
  read_skip(&state.cursor)
  if state.cursor.at == #len(state.buffer) {
    return false
  }
  byte := state.buffer[state.cursor.at]
  if byte == '"' {
    value := read_decoded_string(state)
    if state.cursor.error != 0 {
      return false
    }
    pointer: u64 = 0
    if #len(value) != 0 {
      pointer = #cast(u64, #cast(usize, &value[0]))
    }
    index := read_append(state, KindString, pointer)
    state.values[index].tag |= #cast(u64, #len(value)) << 8
    return true
  }
  if byte == 'n' {
    if !literal(&state.cursor, "null") {
      return false
    }
    _ = read_append(state, KindNull, 0)
    return true
  }
  if byte == 't' || byte == 'f' {
    truth := byte == 't'
    if truth {
      if !literal(&state.cursor, "true") {
        return false
      }
    }
    else {
      if !literal(&state.cursor, "false") {
        return false
      }
    }
    bits: u64 = 0
    if truth {
      bits = 1
    }
    _ = read_append(state, KindBool, bits)
    return true
  }
  if byte != '[' && byte != '{' {
    return read_number(state)
  }
  if depth >= MaximumDepth {
    return false
  }
  object := byte == '{'
  kind := KindArray
  close: u8 = ']'
  if object {
    kind = KindObject
    close = '}'
  }
  index := read_append(state, kind, 0)
  state.cursor.at += 1
  read_skip(&state.cursor)
  count: usize = 0
  if state.cursor.at < #len(state.buffer) && state.buffer[state.cursor.at] == close {
    state.cursor.at += 1
    state.values[index].bits = #cast(u64, state.used - index)
    return true
  }
  for {
    if object {
      read_skip(&state.cursor)
      if state.cursor.at == #len(state.buffer) || state.buffer[state.cursor.at] != '"' {
        return false
      }
      if !read_value(state, depth + 1) {
        return false
      }
      read_skip(&state.cursor)
      if state.cursor.at == #len(state.buffer) || state.buffer[state.cursor.at] != ':' {
        return false
      }
      state.cursor.at += 1
    }
    if !read_value(state, depth + 1) {
      return false
    }
    count += 1
    read_skip(&state.cursor)
    if state.cursor.at == #len(state.buffer) {
      return false
    }
    byte = state.buffer[state.cursor.at]
    state.cursor.at += 1
    if byte == close {
      break
    }
    if byte != ',' {
      return false
    }
  }
  state.values[index].tag |= #cast(u64, count) << 8
  state.values[index].bits = #cast(u64, state.used - index)
  return true
}

pub fn twin_parse(arena: *Arena, source_pointer: *const u8, source_length: usize, result: *Result) {
  source := source_pointer[..source_length]
  mark := arena.offset
  result.* = Result{ root: &nil_value }
  if #len(source) == 0 {
    result.detail = 1
    return
  }
  maximum := ~#cast(usize, 0)
  limit := #len(source)
  if limit > maximum / 16 || #cast(u64, #len(source)) > 0x00ffffffffffffff {
    result.detail = 5
    return
  }
  if mark <= arena.capacity {
    available := arena.capacity - mark
    if available != 0 {
      tail := #cast(usize, arena.data) + mark
      input := #cast(usize, source_pointer)
      overlap := false
      if tail <= input {
        overlap = input - tail < available
      } else {
        overlap = tail - input < source_length
      }
      if overlap {
        result.detail = 4
        return
      }
    }
  }
  copy := lab_push(arena, #len(source), 1)
  buffer := copy[..#len(source)]
  lab_copy(copy, source_pointer, #len(source))
  capacity := #len(source) / 2 + 1
  if capacity > 32 {
    capacity = 32
  }
  probe := Cursor{ source: buffer }
  read_skip(&probe)
  if probe.at < #len(buffer) && buffer[probe.at] != '[' && buffer[probe.at] != '{' {
    capacity = 1
  }
  storage := lab_push(arena, capacity * 16, 8)
  values := #cast(*Value, storage)[..capacity]
  state := ReadParser{ cursor: probe, buffer: buffer, values: values, limit: limit, arena: arena }
  ok := read_value(&state, 0)
  read_skip(&state.cursor)
  if !ok || state.cursor.at != #len(source) {
    offset := state.cursor.at
    detail := state.cursor.error
    if detail == 0 {
      detail = 1
    }
    if ok {
      detail = 2
    }
    lab_rewind(arena, mark)
    result.offset = offset
    result.detail = detail
    return
  }
  base := #cast(usize, &state.values[0]) - #cast(usize, arena.data)
  lab_rewind(arena, base + state.used * 16)
  result.* = Result{ root: &state.values[0], ok: 1, used: state.used, retained: arena.offset - mark }
}
fn read_decoded_string(state: *ReadParser) []const u8 {
  cursor := &state.cursor
  source := cursor.source
  if cursor.at >= #len(source) || source[cursor.at] != '"' {
    return failed_string(cursor)
  }
  cursor.at += 1
  start := cursor.at
  end := start
  end += lab_ascii(#cast(*const u8, #cast(usize, &source[0]) + start), #len(source) - start)
  has_escape: bool = false
  ascii: bool = true
  for end < #len(source) {
    byte := source[end]
    if byte == '"' {
      break
    }
    if byte >= 128 {
      ascii = false
    }
    if byte == '\\' {
      has_escape = true
      end += 1
      if end >= #len(source) {
        return failed_string(cursor)
      }
      byte = source[end]
      if byte >= 128 {
        ascii = false
      }
    }
    if byte < 32 {
      return failed_string(cursor)
    }
    end += 1
  }

  if end >= #len(source) {
    return failed_string(cursor)
  }
  if !ascii && lab_utf8(&source[start], end - start) == 0 {
    return failed_string(cursor)
  }
  if end == start {
    cursor.at = end + 1
    return source[start..end]
  }
  output := state.buffer[start..end]
  if !has_escape {
    cursor.at = end + 1
    return output
  }
  source_at := start
  output_at: usize = 0
  for source_at < end {
    byte := source[source_at]
    source_at += 1
    if byte == '\\' {
      if source_at >= end {
        return failed_string(cursor)
      }
      escaped := source[source_at]
      source_at += 1
      if escaped == '"' || escaped == '\\' || escaped == '/' {
        byte = escaped
      }
      else if escaped == 'b' {
        byte = 8
      }
      else if escaped == 'f' {
        byte = 12
      }
      else if escaped == 'n' {
        byte = '\n'
      }
      else if escaped == 'r' {
        byte = '\r'
      }
      else if escaped == 't' {
        byte = '\t'
      }
      else if escaped == 'u' {
        if source_at + 4 > end {
          return failed_string(cursor)
        }
        code: usize = 0
        for digits in 0..4 {
          part := hex_value(source[source_at])
          if part == 16 {
            return failed_string(cursor)
          }
          code = code * 16 + part
          source_at += 1
        }
        if code >= 55296 && code <= 56319 {
          if source_at + 6 > end || source[source_at] != '\\' || source[source_at + 1] != 'u' {
            return failed_string(cursor)
          }
          source_at += 2
          low: usize = 0
          for low_digits in 0..4 {
            low_part := hex_value(source[source_at])
            if low_part == 16 {
              return failed_string(cursor)
            }
            low = low * 16 + low_part
            source_at += 1
          }
          if low < 56320 || low > 57343 {
            return failed_string(cursor)
          }
          code = 65536 + (code - 55296) * 1024 + low - 56320
        } else if code >= 56320 && code <= 57343 {
          return failed_string(cursor)
        }
        if code <= 127 {
          output[output_at] = #cast(u8, code)
          output_at += 1
        } else if code <= 2047 {
          output[output_at] = utf8_byte(code >> 6, 192)
          output[output_at + 1] = utf8_byte(code & 63, 128)
          output_at += 2
        } else if code <= 65535 {
          output[output_at] = utf8_byte(code >> 12, 224)
          output[output_at + 1] = utf8_byte((code >> 6) & 63, 128)
          output[output_at + 2] = utf8_byte(code & 63, 128)
          output_at += 3
        } else {
          output[output_at] = utf8_byte(code >> 18, 240)
          output[output_at + 1] = utf8_byte((code >> 12) & 63, 128)
          output[output_at + 2] = utf8_byte((code >> 6) & 63, 128)
          output[output_at + 3] = utf8_byte(code & 63, 128)
          output_at += 4
        }
        continue
      } else {
        return failed_string(cursor)
      }
    }
    output[output_at] = byte
    output_at += 1
  }
  cursor.at = end + 1
  return output[..output_at]
}


fn hex_value(byte: u8) usize {
  if byte >= '0' && byte <= '9' {
    return #cast(usize, (byte - '0'))
  }
  if byte >= 'a' && byte <= 'f' {
    return #cast(usize, (byte - 'a')) + 10
  }
  if byte >= 'A' && byte <= 'F' {
    return #cast(usize, (byte - 'A')) + 10
  }
  return 16
}

fn utf8_byte(value: usize, marker: u8) u8 {
  converted: u8 = #cast(u8, value)
  return converted | marker
}

fn literal(cursor: *Cursor, text: []const u8) bool {
  if cursor.at + #len(text) > #len(cursor.source) {
    return false
  }
  for i in 0..#len(text) {
    if cursor.source[cursor.at + i] != text[i] {
      return false
    }
  }
  cursor.at += #len(text)
  return true
}

fn failed_string(cursor: *Cursor) []const u8 {
  if cursor.error == 0 {
    cursor.error = 1
  }
  return cursor.source[..0]
}



pub fn twin_layout(which: usize) usize {
  if which == 0 { return #sizeof(Value) }
  if which == 1 { return #sizeof(Arena) }
  if which == 2 { return #sizeof(Cursor) }
  if which == 3 { return #sizeof(ReadParser) }
  return #sizeof(Result)
}
