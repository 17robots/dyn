module "main";synt

use {
  "std:io",
    "std:heap",
    "std:sync",
    "std:math",
    test "testLib"
}

fn main() {
  primitives();
  optionals();
  pointers();
  arrays();
  if_statements();
  match_statements();
  defer_statements();
  loops();
  functions();
  enums();
  errors();
  structs();
  metaprogramming();
  memory();
  concurrency();
}

fn primitives() {
  i2 x = 0;
  u5 y = 1;
  f32 single_precision = 1.0;
  f64 double_precision = 1.00001;
  u8 char = 'a';
  u1 boolean = false;
}

fn optionals() {
  i32? optional_value = 100;
  mut i32? optional_value_2 = null;

  if optional_value != null {
    io.println("Optional value: {optional_value.?}");
  } else {
    io.println("Optional value: null");
  }

  if optional_value_2 |x| {
    io.println("Optional value 2: {x}");
  }
  if optional_value_2 |mut x| {
    x.* = 4;
  } else { optional_value_2 = 4; }

  i32 y = optional_value_2 else 4;
}

fn pointers() {
  i32 x = 1;
  mut i32 y = 1;
  i32* a = &x;
  mut i32* b = a;

  io.println("x == dereferenced a? { x == a.*}");

  b = &y;
  b.* = 5;
}

fn arrays() {
  mut i32[] nums = [1,2,3,4,5];
  nums[0] *= 2;
  mut i32[5] nums2;
  nums[0] = 0;
  nums[1] = 1;
  nums[2] = 2;
  nums[3] = 3;
  nums[4] = 4;
}

fn if_statements() {
  u1 yes = true;
  if yes {
    io.println("This should print");
  } else {
    io.println("If this runs then oops");
  }

  u1 no = false;
  if no { io.println("if this runs then oops"); } else if yes { io.println("This should run"); } else { io.println("This should not run"); }
}

fn match_statements() {
  i32 x = 100;
  match x {
1: { io.println("This shouldnt run"); },
     2: { io.println("This shouldnt run"); },
     4..90: { io.println("This shouldnt run"); },
     _: { io.println("This is the default so this should run"); },
  }
}

fn defer_statements() {
  defer io.println("This executes last");
  defer io.println("This executes second");
  defer {
    io.println("This executes first");
  }
}

fn loops() {
  while true {
    io.println("infinite loop, needs broken");
    break;
  }

  for 1..100 |i| { io.println(i); }

  u8[] items = [1,2,3,4,5];
  for items |i| { io.println(i); }
  for 0..std.arr.len(items) |i| { io.println(items[i]); }
}

fn functions() {
  mut i32 local = 0;
  mut i32 state = 0;
  mut i32 result = undefined;
  fn internal_fn() {
    io.println(local, state);
  }
  internal_fn();
  fn some_number() i32 { return 100; }
  fn some_number_2() i32 => 100;
  fn some_math(i32 x, i32 y) i32 => x + y;
  fn some_math_2(i32 x, i32 y) i32 => x + y;
  fn manipulate_numbers(i32* result, i32 x, i32 y) => result.* = x + y;
  mut i32 y = 5;
  manipulate_numbers(&y, local, state);
  io.println("String interpolated values {some_math(1, 2)}");
}

fn enums() {
  enum MyEnum {
    SOME,
    THING,
    HERE
  }

  enum PartneredEnum {
    i32 SOME,
    struct { i32 info, } THING,
    f32 HERE,
  }

  MyEnum x = .SOME;
  PartneredEnum x = .SOME(4);

  match x {
    .SOME: { io.println("SOME"); },
      .THING: { io.println("THING"); },
      .HERE: { io.println("HERE"); }
  }
  match x {
    .SOME: { io.println("SOME"); },
      _: { io.println("Default"); }
  }
}

fn errors() {
  error DivideErrors {
    DivideByZero
  }

  error PartneredDivideErrors {
    i32 DivideByZero
  }

  fn div(f32 x, f32 y) f32<DivideErrors> {
    if y == 0 { return DivideErrors.DivideByZero; } else { return x / y; }
  }

  fn div(f32 x, f32 y) f32<PartneredDivideErrors> {
    if y == 0 { return PartneredDivideErrors.DivideByZero(4); } else { return x / y; }
  }

  defer |e| {}
  defer {}

  try_me() void<> {
    return DivideErrors.DivideByZero;
  }

  try_me() catch |e| {
    io.println("{e} was thrown");
    return;
  }

  try try_me();
}

fn structs() {
  struct X {
    i32 a,
        i32 b,
        i32 c,
        f32 x,
        f32 y,
        f32 z
  }

  type Y = struct {
    f32 a,
        f32 b,
        f32 c,
        i32 x,
        i32 y,
        i32 z
  }

  X x = .{ a: 1, b: 2, c: 3, x: 1.0, y: 1.0, z: 1.0 };
  Y y = .{ a: 1.0, b: 2.0, c: 3.0, x: 1, y: 1, z: 1 };
  io.println("{x.a}, {x.b}, {x.c}, {x.x}, {x.y}, {x.z}");
  io.println("{y.a}, {y.b}, {y.c}, {y.x}, {y.y}, {y.z}");

  fn printX(X x) => io.println("{x.a}, {x.b}, {x.c}, {x.x}, {x.y}, {x.z}");
  fn printY(Y y) => io.println("{y.a}, {y.b}, {y.c}, {y.x}, {y.y}, {y.z}");

  fn updateX(X* x) => x.*.a = x.*.a + 1;

  i32?! otherExample = null;

  struct MethodExample {
    i32 a = 0,
        fn init(i32 a) MethodExample => .{ a: a },
        fn print(MethodExample s) => io.println("{s.a}"),
        fn setADouble(MethodExample* s) => s.*.a *= 2
  }
}

fn metaprogramming() {
  fn List(comp type T) type => struct {
    T[] members,
      this init() {
        inline for 0..5 |_| {
          io.println("hi");
        }
        return .{ members: [] };
      }
  };

  fn printType(comp type T) {
    std.meta.Type t = $typeOf(T);
    match t.Type {
      .Int: |int| { io.println("integer {t.name}, {int.bits}, {bool(int.signed)}"); },
        _: { $compError("issue here, we need int type"); }
    }
  }
}

fn memory() {
  heap.GeneralPurposeAllocator gpa = heap.GeneralPurposeAllocator.init({});
  mut heap.Allocator alloc = gpa.alloc();
  defer {
    if gpa.deinit() == .leak {
      $panic("we leaked");
    }
  }
  i32* p = try alloc.allocOne(i32);
  defer alloc.free(p);
  i32* p1 = try alloc.allocOne(i32, 1);
  defer gpa.free(p1);
  i32[] p2 = try alloc.allocMany(i32, 2);
  defer alloc.free(p2);

  heap.ArenaAllocator aa = heap.ArenaAllocator.init({});
  defer aa.deinit();
  alloc = aa.alloc();

  i32* p3 = aa.allocOne(i32);
  i32[] p3 = aa.allocMany(i32, 2);
}

fn something_struct() struct { i32 hello, i32 world } {
}

fn something_enum() enum { cool, i32 thing, here } {
}

fn do_a_many_thing(struct { bool do, bool we, bool think } a, enum { we, dont, like, things } b, error { weCant, doThingFailure } c) struct { enum { one, two, three } x } { }

fn SomeFancyThing(comp type t) type {
  return struct {
    type Self = $self(),
         u32 woah,
         u32 there,
  };
}

fn concurrency() {
  fn printStuff() => io.println("thread stuff");
  sync.Thread t1 = sync.spawn(printStuff());
  t1.join();
}

type AddFn = fn(i32,i32)i32;
fn doAddOp(AddFn a, i32 x, i32 y) => a(x,y);
