use "std/io"
use "std/fmt"
use "std/heap"
use "std/thread"
use "std/chan"
use "std/sync"

pub fn main() {
  primitives()
  pointers()
  arrays()
  if_statements()
  case_statements()
  defer_statements()
  loops()
  functions()
  enums()
  errors()
  structs()
