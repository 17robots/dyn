  context()
  concurrency()
}

fn primitives() {
  x = 0
  y: u32 = 1
  single: f32 = 1.0
  double: f64 = 1.0
  big = 1_000_000
  h = 0xFF
  b = 0b1010
  o = 0o17
  char = 'a'
  boolean = false
  later: i32 // undefined
  later = 42
}

fn pointers() {
  x: i32 = 1
  p = &x // *i32
  io.println("x == p.*?: {}", p.* == x)
}

fn arrays() {
  nums: [5]i32 = [1,2,3,4,5]
  nums_alternative = [5]nums{1,2,3,4,5}
  io.println("{} {}", nums[0], nums_alternative[0])
}

fn if_statements() {
  yes = true
  if yes {io.println("This should print")} else { io.println("This should not print")}
  x = 1
  y: i32
  if x == 1 => y = 12 else => y = 13
  z: i32
  if x == 1 {
    // do something
    z = 12
  } else {
    z = 13
  }
  io.println("{} {}", y, z)
}

fn case_statements() {
  x = 100
  case x {
    1 => io.println("not this")
    2 => io.println("not this")
    4..90 => io.println("not this")
    _ => io.println("the default runs")
  }
  c: i32
  case x {
    1 => case = 1,
    2..=99 => case = 2,
    _ {
      // do stuff
      case = 12
    }
  }
  io.println("c: {}", c)
  g = Grid{4,9}
  case g {
    Grid{4, h} => io.println("w is four, h bound as h={}", h)
    _ {}
  }
}

struct Grid { w, h: i32 }

fn defer_statements() {
  defer io.println("function scope exit")
  defer io.println("before function scope exit")
}

fn loops() {
  outer: for {
    io.println("infinite loop, please break")
    break :outer
  }
  for i = 1; i <= 100; i += 1 { _ = i }
  for i in 1..100 { _ = i } // same as above
  items := [5]u8{1,2,3,4,5}
  for item in items => io.println("{}", item)
  for i = 0; i < items.len; i += 1 { _ = i } // gets index
  a = 0
  for a < 10 => a += 1
}

fn add(x: i32, y: i32) i32 {
  return x + y
}
fn add2(x, y: i32) i32 => x + y
fn add3(x: i32 = 0, y: i32 = 0) => x + y

fn functions() {
  val = add(1,2)
  val = add2(1,2)
  val = add3(y: 1)
  fn walk(start: i32) i32 { // functions inside other functions
    cur = start
    for cur < 100 => cur += 2
    return cur
  }
  _ = walk(3)
}

fn enums() {
  x: MyEnum = .some
  y: Partnered = .some(4)
  z: Partnered = .thing(.{9})

  case x {
    .some => io.println("some"),
    .thing => io.println("thing"),
    .here => io.println("here"),
    // no need for _, already exhaustive
  }
  case y {
    .some n => io.println("some, {}", n)           // bind payload: bare identifier, no pipes
    .here f => io.println("here, {}", f)
    _ => io.print("default\n")
  }
  case z {
    .thing {info: 9} => io.print("nested struct pattern hit\n") // trying to figure this one out
    .thing t => io.print("other thing: {}\n", t.info) // thinking about this one
    _ {}
  }
}

enum MyEnum { some, thing, here }
enum MyPartneredEnum {
  some: i32,
  thing: struct { info: i32 }
  here: f32
}

fn errors() {} // trying to figure out how to manage this section

struct Point { x, y: f32 }
struct X {
  a: i32, b: i32, c: i32,
  x,y,z: f32
}
struct Counter { n: i32 = 0 }
fn Counter.new() Counter => {} // this is different because its returning a struct here, the {} are NOT a function body
fn Counter.inc(s: *Counter) {s.n += 1}
fn Counter.dec(s: *Counter) {s.n -= 1}
fn structs() {
  x = X{a: 1, b: 2, c: 3, x: 1.0, y: 2.0, z: 3.0}
  x = X{1, 2, 3, 1.0, 2.0, 3.0}
  x = {1,2,3,1.0,2.0,3.0}
  x = {} // inferrable because x is X
  c = Counter.new()
  c.inc()
  c.inc()
  c.dec()
  io.println("count: {}", c.n)
}

