module cursor

pub CursorPosition := struct { byte: usize, line: usize, col: usize }
pub Cursor := struct { source: []u8, index: usize, line: usize, col: usize }
pub Cursor.init := (source: []u8) Cursor => .{ source, index: 0, line: 1, col: 1 }
pub Cursor.is_eof := (self: Cursor) u1 => self.index >= self.source.len
pub Cursor.position := (self: Cursor) CursorPosition => .{ byte: self.index, line: self.line, col: self.col }
pub Cursor.peek := (self: Cursor) ?u8 {
  if self.index >= self.source.len return null
  return self.source[self.index]
}
pub Cursor.peek_next := (self: Cursor) ?u8 {
  mut next: usize = self.index
  next += 1
  if next >= self.source.len return null
  return self.source[next]
}
pub Cursor.bump := (self: *mut Cursor) ?u8 {
  ch := self.peek() or return null
  self.index += 1
  if ch == '\n' {
    self.line += 1
    self.col = 1
  } else self.col += 1
  return ch
}
pub Cursor.bump_many := (self: *mut Cursor, val: usize) ?[]u8 {
  start := self.index
  for 1..=val: |_| {
    if self.bump() == null return null
  }
  return self.source[start..self.index]
}
pub Cursor.match_char := (self: *mut Cursor, expected: u8) u1 {
  ch := self.peek() or return false
  if ch != expected return false
  _ = self.bump()
  return true
}
pub Cursor.span_from := (self: Cursor, start: CursorPosition) SourceSpan => .{ start_byte: start.byte, start_line: start.line, start_col: start.col, end_byte: self.index, end_line: self.line, end_col: self.col }
