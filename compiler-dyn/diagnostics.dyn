pub DiagnosticPhase := enum { ModuleResolver, Lexer, Parser, Semantic, TypeChecker, Mir, Backend }
pub DiagnosticSeverity := enum { Error, Warning }
pub DiagnosticCode := enum {
    E1001,
    E1002,
    E1003,
    E1004,
    E1005,
    E1006,
    E2001,
    E2002,
    E2003,
    E2004,
    E2005,
    E2006,
    E2007,
    E3001,
    E3002,
    E4001,
    E4002,
    E4003,
    E4004,
    E4005,
    E4006,
    E4007,
    E4008,
    E4009,
    E4010,
    E4011,
    E4012,
    E5001,
    E5002,
    E5003,
}
DiagnosticCode.as_str := (self: DiagnosticCode) []u8 => match self {
  .E1001: "E1001",
  .E1002: "E1002",
  .E1003: "E1003",
  .E1004: "E1004",
  .E1005: "E1005",
  .E1006: "E1006",
  .E2001: "E2001",
  .E2002: "E2002",
  .E2003: "E2003",
  .E2004: "E2004",
  .E2005: "E2005",
  .E2006: "E2006",
  .E2007: "E2007",
  .E3001: "E3001",
  .E3002: "E3002",
  .E4001: "E4001",
  .E4002: "E4002",
  .E4003: "E4003",
  .E4004: "E4004",
  .E4005: "E4005",
  .E4006: "E4006",
  .E4007: "E4007",
  .E4008: "E4008",
  .E4009: "E4009",
  .E4010: "E4010",
  .E4011: "E4011",
  .E4012: "E4012",
  .E5001: "E5001",
  .E5002: "E5002",
  .E5003: "E5003",
}
pub SourceSpan := struct {
  start_byte: usize,
  start_line: usize,
  start_col: usize,
  end_byte: usize,
  end_line: usize,
  end_col: usize,
}
pub DiagnosticLabel := struct {
  file_path: []u8,
  span: ?SourceSpan,
  message: []u8,
  is_primary: u1
}
pub Diagnostic := struct {
  phase: DiagnosticPhase,
  severity: DiagnosticSeverity,
  code: DiagnosticCode,
  message: []u8,
  labels: Vec(DiagnosticLabel),
  notes: Vec([]u8)
}
Diagnostic.error := (phase: DiagnosticPhase, code: DiagnosticCode, message: []u8) Diagnostic => .{
  phaes: phase,
  severity: .Error,
  code: code,
  message: message,
  labels: Vec(DiagnosticLabel).init(),
  notes: Vec([]u8).init()
}

pub sort_diagnostics_by_primary_path := (diagnostics: []mut Diagnostic) {}
pub dedupe_diagnostics_by_primary_span := (diagnostics: *mut Vec(Diagnostic)) {}
pub normalize_diagnostic_path := (path: []u8) []u8 {}

