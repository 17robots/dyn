module main

// ── Severity and Phase ────────────────────────────────────────────────────────

pub DiagnosticSeverity := enum { error, warning, note }

pub DiagnosticPhase := enum { module_resolver, lexer, parser, semantic, type_check, mir, backend }

// ── Diagnostic codes ──────────────────────────────────────────────────────────

pub DiagnosticCode := enum {
    E1001,   // file not found
    E1002,   // circular import
    E1003,   // module name mismatch
    E1004,   // duplicate module declaration
    E1005,   // unresolved import
    E1006,   // ambiguous import
    E2001,   // invalid character
    E2002,   // unterminated string literal
    E2003,   // unterminated block comment
    E2004,   // invalid escape sequence
    E2005,   // integer literal overflow
    E2006,   // invalid numeric literal
    E2007,   // unterminated character literal
    E3001,   // unexpected token
    E3002,   // expected expression
    E4001,   // undeclared identifier
    E4002,   // type mismatch
    E4003,   // cannot assign to immutable binding
    E4004,   // wrong number of arguments
    E4005,   // invalid operand types
    E4006,   // reassignment of immutable binding
    E4007,   // missing return statement
    E4008,   // duplicate field name
    E4009,   // unknown field
    E4010,   // wrong number of capture slots
    E4011,   // if capture requires optional or enum-variant condition
    E4012,   // break outside loop
    E5001,   // unsupported target feature
    E5002,   // code generation failure
    E5003,   // linker error

    to_str := (self: DiagnosticCode) []u8 => match self {
        .E1001: "E1001", .E1002: "E1002", .E1003: "E1003",
        .E1004: "E1004", .E1005: "E1005", .E1006: "E1006",
        .E2001: "E2001", .E2002: "E2002", .E2003: "E2003",
        .E2004: "E2004", .E2005: "E2005", .E2006: "E2006",
        .E2007: "E2007",
        .E3001: "E3001", .E3002: "E3002",
        .E4001: "E4001", .E4002: "E4002", .E4003: "E4003",
        .E4004: "E4004", .E4005: "E4005", .E4006: "E4006",
        .E4007: "E4007", .E4008: "E4008", .E4009: "E4009",
        .E4010: "E4010", .E4011: "E4011", .E4012: "E4012",
        .E5001: "E5001", .E5002: "E5002", .E5003: "E5003",
    }

    description := (self: DiagnosticCode) []u8 => match self {
        .E1001: "file not found",
        .E1002: "circular import",
        .E1003: "module name mismatch",
        .E1004: "duplicate module declaration",
        .E1005: "unresolved import",
        .E1006: "ambiguous import",
        .E2001: "invalid character",
        .E2002: "unterminated string literal",
        .E2003: "unterminated block comment",
        .E2004: "invalid escape sequence",
        .E2005: "integer literal overflow",
        .E2006: "invalid numeric literal",
        .E2007: "unterminated character literal",
        .E3001: "unexpected token",
        .E3002: "expected expression",
        .E4001: "undeclared identifier",
        .E4002: "type mismatch",
        .E4003: "cannot assign to immutable binding",
        .E4004: "wrong number of arguments",
        .E4005: "invalid operand types",
        .E4006: "reassignment of immutable binding",
        .E4007: "missing return statement",
        .E4008: "duplicate field name",
        .E4009: "unknown field",
        .E4010: "wrong number of capture slots",
        .E4011: "if capture requires optional or enum-variant condition",
        .E4012: "break outside loop",
        .E5001: "unsupported target feature",
        .E5002: "code generation failure",
        .E5003: "linker error",
    }
}

// ── Source location ───────────────────────────────────────────────────────────

pub DiagnosticLabel := struct {
    file_path:  []u8,
    start_byte: usize,
    end_byte:   usize,
    message:    []u8,
    is_primary: bool,
}

// ── Diagnostic ────────────────────────────────────────────────────────────────

pub Diagnostic := struct {
    severity: DiagnosticSeverity,
    phase:    DiagnosticPhase,
    code:     DiagnosticCode,
    message:  []u8,
    labels:   Vec(DiagnosticLabel),
    // notes stored as a Vec of byte slices; Vec([]u8) can't be written inline,
    // so we store label count alongside and use a simple array of labels.
    // For notes, use a second Vec(DiagnosticLabel) with is_primary=false.
    notes_count: usize,

    // Construct an error-severity diagnostic.
    error := (alloc: Allocator, phase: DiagnosticPhase, code: DiagnosticCode, msg: []u8) Diagnostic => .{
        severity:    .error,
        phase:       phase,
        code:        code,
        message:     msg,
        labels:      Vec(DiagnosticLabel).init(alloc),
        notes_count: 0,
    }

    // Construct a warning-severity diagnostic.
    warning := (alloc: Allocator, phase: DiagnosticPhase, code: DiagnosticCode, msg: []u8) Diagnostic => .{
        severity:    .warning,
        phase:       phase,
        code:        code,
        message:     msg,
        labels:      Vec(DiagnosticLabel).init(alloc),
        notes_count: 0,
    }

    // Add a labeled source span.
    label := (self: *Diagnostic, file: []u8, start: usize, end: usize, msg: []u8, primary: bool) *Diagnostic {
        self.labels.push(DiagnosticLabel.{
            file_path:  file,
            start_byte: start,
            end_byte:   end,
            message:    msg,
            is_primary: primary,
        })
        return self
    }

    // Emit the diagnostic to stderr in human-readable format.
    emit := (self: Diagnostic, src: []u8) {
        sev := match self.severity {
            .error:   "error",
            .warning: "warning",
            .note:    "note",
        }
        os.eprintf("[{}] {}: {}\n", self.code.to_str(), sev, self.message)

        mut i: usize = 0
        for i < self.labels.len: {
            lp := self.labels.get(i) or { break }
            ln := byte_to_line(src, lp.*.start_byte)
            cl := byte_to_col(src, lp.*.start_byte)
            if lp.*.is_primary
                os.eprintf("  --> {}:{}:{}: {}\n", lp.*.file_path, ln, cl, lp.*.message)
            else
                os.eprintf("  --- {}:{}:{}: {}\n", lp.*.file_path, ln, cl, lp.*.message)
            i += 1
        }
    }

    deinit := (self: *Diagnostic) {
        self.labels.deinit()
    }
}

// ── Source position utilities ─────────────────────────────────────────────────

/// Pre-built line-start table for O(1) byte-offset -> line/col lookup.
/// Build once from source text; query as many times as needed.
pub LineTable := struct {
    // starts[i] = byte offset of the first character on line i+1.
    // starts[0] = 0 always (line 1 starts at byte 0).
    starts: []usize,
    count:  usize,

    // Build a LineTable from source text. Uses alloc for the starts array.
    // Returns null on allocation failure.
    build := (src: []u8, alloc: Allocator) ?LineTable {
        // Count newlines to know how many lines there are.
        mut n: usize = 1
        mut i: usize = 0
        for i < src.len: {
            if src[i] == '\n' n += 1
            i += 1
        }

        buf := alloc.create_many(usize, n) or return null
        buf[0] = 0
        mut idx: usize = 1
        i = 0
        for i < src.len: {
            if src[i] == '\n' and idx < n {
                buf[idx] = i + 1
                idx += 1
            }
            i += 1
        }

        return LineTable.{ starts: buf, count: n }
    }

    // Return 1-based line number for a byte offset.
    line := (self: LineTable, offset: usize) usize {
        // Binary search for the largest start <= offset.
        mut lo: usize = 0
        mut hi := self.count
        for lo + 1 < hi: {
            mid := (lo + hi) / 2
            if self.starts[mid] <= offset lo = mid else hi = mid
        }
        return lo + 1
    }

    // Return 1-based column number for a byte offset.
    col := (self: LineTable, offset: usize) usize {
        line_idx := self.line(offset) - 1
        return offset - self.starts[line_idx] + 1
    }

    deinit := (self: *LineTable, alloc: Allocator) {
        alloc.destroy_many(usize, self.starts)
        self.count = 0
    }
}

// Simple fallback: compute line from byte offset without a pre-built table.
// O(n) — use LineTable.build for repeated queries on the same source.
pub byte_to_line := (src: []u8, offset: usize) usize {
    mut line: usize = 1
    mut i:    usize = 0
    for i < src.len: {
        if i >= offset break
        if src[i] == '\n' line += 1
        i += 1
    }
    return line
}

pub byte_to_col := (src: []u8, offset: usize) usize {
    mut col: usize = 1
    mut i:   usize = 0
    for i < src.len: {
        if i >= offset break
        if src[i] == '\n' col = 1 else col += 1
        i += 1
    }
    return col
}
