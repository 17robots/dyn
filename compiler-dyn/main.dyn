module main

diagnostics := use "diagnostics"
lexer := use "lexer"
mem := use "std/mem"
os := use "std/os"
parser := use "parser"
sema := use "sema"
str := use "std/str"
Vec := (use "std/collections").Vec

pub smoke_diag := () diagnostics.Diagnostic {
  span := diagnostics.SourceSpan.{
    start_byte: 0,
    start_line: 1,
    start_col: 1,
    end_byte: 0,
    end_line: 1,
    end_col: 1,
  }
  diag := diagnostics.Diagnostic.error(.Lexer, .E2001, "smoke")
  return diag.with_primary_file_label("memory", span, "smoke")
}

pub Frontend := struct {
  arena: mem.Arena,
}

pub Frontend.init := () Frontend => .{
  arena: mem.Arena.init(),
}

pub Frontend.deinit := (self: *mut Frontend) {
  self.arena.deinit()
  return
}

pub Frontend.lex_source := (self: *mut Frontend, file_path: []u8, source: []u8) lexer.LexOutput! {
  mut l := lexer.Lexer.init(self.arena.allocator(), source, file_path)
  out := l.lex().!
  return out
}

pub Frontend.parse_source := (self: *mut Frontend, file_path: []u8, source: []u8) parser.ParseOutput! {
  lexed := self.lex_source(file_path, source).!
  mut p := parser.Parser.new(self.arena.allocator(), file_path, lexed.tokens.slice())
  out := p.parse_file()
  return out
}

pub Frontend.analyze_source := (self: *mut Frontend, file_path: []u8, source: []u8) sema.SemanticOutput! {
  parsed := self.parse_source(file_path, source).!
  file := parsed.ast or return .{
    diagnostics: parsed.diagnostics,
    decls: Vec(sema.DeclStub).init(self.arena.allocator()),
  }
  out := sema.analyze_file(self.arena.allocator(), file_path, file)
  mut all_diags := parsed.diagnostics
  mut i: usize = 0
  for i < out.diagnostics.len: {
    all_diags.push(out.diagnostics[i]).!
    i += 1
  }
  return .{
    diagnostics: all_diags,
    decls: out.decls,
  }
}

RunMode := enum { Lex, Parse, Analyze }

usage := () {
  os.ewriteln("usage: compiler-dyn [lex|parse|analyze] <path>")
  return
}

pub Frontend.run_file := (self: *mut Frontend, mode: RunMode, path: []u8) i32 {
  source := os.read_file(path, self.arena.allocator()) or {
    os.ewrite("failed to read file: ")
    os.ewriteln(path)
    return 1
  }

  if mode == .Lex {
    mut lexed := self.lex_source(path, source).!
    if diagnostics.emit_diagnostics(&lexed.diagnostics) != 0 return 1
    return 0
  }

  if mode == .Parse {
    mut parsed := self.parse_source(path, source).!
    if diagnostics.emit_diagnostics(&parsed.diagnostics) != 0 return 1
    return 0
  }

  mut analyzed := self.analyze_source(path, source).!
  if diagnostics.emit_diagnostics(&analyzed.diagnostics) != 0 return 1
  return 0
}

main := () i32 {
  mut frontend := Frontend.init()
  args := os.args(frontend.arena.allocator()) or {
    os.ewriteln("failed to load process args")
    frontend.deinit()
    return 1
  }

  if args.len < 2 {
    usage()
    frontend.deinit()
    return 2
  }

  mut mode := RunMode.Analyze
  mut path_index: usize = 1
  if str.eq(args[1], "lex") {
    mode = .Lex
    path_index = 2
  } else if str.eq(args[1], "parse") {
    mode = .Parse
    path_index = 2
  } else if str.eq(args[1], "analyze") {
    mode = .Analyze
    path_index = 2
  }

  if path_index >= args.len {
    usage()
    frontend.deinit()
    return 2
  }

  status := frontend.run_file(mode, args[path_index])
  frontend.deinit()
  return status
}
