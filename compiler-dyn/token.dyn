module main

/// Every token kind the lexer can produce.
pub TokenKind := enum {
    // Literals
    int_lit,
    float_lit,
    string_lit,
    char_lit,

    // Identifiers
    ident,
    builtin_ident,   // $name

    // Special type identifier
    kw_any,          // any

    // Keywords
    kw_and,
    kw_break,
    kw_comp,
    kw_continue,
    kw_defer,
    kw_else,
    kw_enum,
    kw_extern,
    kw_false,
    kw_for,
    kw_if,
    kw_inline,
    kw_match,
    kw_module,
    kw_mut,
    kw_not,
    kw_null,
    kw_or,
    kw_packed,
    kw_pub,
    kw_return,
    kw_struct,
    kw_true,
    kw_type,
    kw_use,
    kw_void,

    // Delimiters
    lparen,
    rparen,
    lbrace,
    rbrace,
    lbracket,
    rbracket,
    comma,
    semicolon,

    // Operators / punctuation
    colon,         // :
    colon_eq,      // :=
    dot,           // .
    dot_dot,       // ..
    dot_dot_eq,    // ..=
    dot_star,      // .*
    dot_question,  // .?
    dot_bang,      // .!
    question,      // ?
    bang,          // !
    bang_eq,       // !=
    tilde,         // ~
    at,            // @
    eq,            // =
    eq_eq,         // ==
    fat_arrow,     // =>
    thin_arrow,    // ->
    plus,          // +
    plus_eq,       // +=
    minus,         // -
    minus_eq,      // -=
    star,          // *
    star_eq,       // *=
    slash,         // /
    slash_eq,      // /=
    percent,       // %
    percent_eq,    // %=
    amp,           // &
    amp_amp,       // &&
    amp_eq,        // &=
    pipe,          // |
    pipe_eq,       // |=
    caret,         // ^
    caret_eq,      // ^=
    lt,            // <
    lt_eq,         // <=
    lt_lt,         // <<
    lt_lt_eq,      // <<=
    gt,            // >
    gt_eq,         // >=
    gt_gt,         // >>
    gt_gt_eq,      // >>=

    // Trivia (kept in token stream)
    doc_comment,

    // End of input
    eof,
}

/// A single token: its kind and position within the source buffer.
pub Token := struct {
    kind:  TokenKind,
    start: u32,   // byte offset of first character
    len:   u32,   // byte count
}
