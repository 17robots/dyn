module sema

ast := use "ast"
diagnostics := use "diagnostics"
Vec := (use "std/collections").Vec
Allocator := (use "std/mem").Allocator
str := use "std/str"

pub DeclKind := enum { Binding, Extern, TypeBinding }
pub DeclStub := struct { name: ast.Ident, kind: DeclKind }
pub SemanticOutput := struct {
  diagnostics: Vec(diagnostics.Diagnostic),
  decls: Vec(DeclStub),
}

ScopeBinding := struct { name: ast.Ident }
Scope := struct { bindings: Vec(ScopeBinding) }

Analyzer := struct {
  allocator: Allocator,
  file_path: []u8,
  diagnostics: Vec(diagnostics.Diagnostic),
  decls: Vec(DeclStub),
  scopes: Vec(Scope),
  out_of_scope: Vec(ScopeBinding),
  import_aliases: Vec(ast.Ident),
}

pub analyze_file := (allocator: Allocator, file_path: []u8, file: ast.AstFile) SemanticOutput {
  mut analyzer := Analyzer.init(allocator, file_path)
  analyzer.collect_top_level_decls(file)
  analyzer.analyze_ast(file)
  return .{
    diagnostics: analyzer.diagnostics,
    decls: analyzer.decls,
  }
}

Analyzer.init := (allocator: Allocator, file_path: []u8) Analyzer {
  return .{
    allocator: allocator,
    file_path: file_path,
    diagnostics: Vec(diagnostics.Diagnostic).init(allocator),
    decls: Vec(DeclStub).init(allocator),
    scopes: Vec(Scope).init(allocator),
    out_of_scope: Vec(ScopeBinding).init(allocator),
    import_aliases: Vec(ast.Ident).init(allocator),
  }
}

Analyzer.collect_top_level_decls := (self: *mut Analyzer, file: ast.AstFile) {
  mut i: usize = 0
  for i < file.items.len: {
    item := file.items[i]
    match item {
      .Binding: {
        binding := item.Binding[0]
        self.add_top_level_decl(binding.name, .Binding)
        if binding.value.kind == .Use {
          self.import_aliases.push(binding.name).!
        }
      },
      .Extern: {
        external := item.Extern[0]
        self.add_top_level_decl(external.name, .Extern)
      },
      .TypeBinding: {
        decl := item.TypeBinding[0]
        self.add_top_level_decl(decl.member_name, .TypeBinding)
      },
      _: {},
    }
    i += 1
  }
  return
}

Analyzer.add_top_level_decl := (self: *mut Analyzer, name: ast.Ident, kind: DeclKind) {
  if self.find_decl(name.text) != null {
    self.error_at(name.span, .E4002, "duplicate top-level declaration")
    return
  }
  self.decls.push(.{ name: name, kind: kind }).!
  return
}

Analyzer.find_decl := (self: Analyzer, name: []u8) ?DeclStub {
  mut i: usize = 0
  for i < self.decls.len: {
    decl := self.decls[i]
    if str.eq(decl.name.text, name) return decl
    i += 1
  }
  return null
}

Analyzer.analyze_ast := (self: *mut Analyzer, file: ast.AstFile) {
  mut i: usize = 0
  for i < file.items.len: {
    self.analyze_item(file.items[i])
    i += 1
  }
  return
}

Analyzer.analyze_item := (self: *mut Analyzer, item: ast.Item) {
  match item {
    .Binding: {
      binding := item.Binding[0]
      self.analyze_expr(binding.value)
    },
    .Destructure: {
      destructure := item.Destructure[0]
      self.analyze_expr(destructure.value)
    },
    .Extern: {
      external := item.Extern[0]
      self.analyze_type_expr(external.ty)
    },
    .ExprStmt: self.analyze_expr(item.ExprStmt[0]),
    .TypeBinding: {
      decl := item.TypeBinding[0]
      if decl.annotation: |annotation| self.analyze_type_expr(annotation)
      self.analyze_expr(decl.value)
    },
  }
  return
}

Analyzer.analyze_type_expr := (self: *mut Analyzer, ty: ast.TypeExpr) {
  match ty.kind {
    .Named: self.resolve_type_ident(ty.kind.Named),
    .Applied: {
      mut i: usize = 0
      for i < ty.kind.Applied.args.len: {
        self.analyze_type_expr(ty.kind.Applied.args[i])
        i += 1
      }
    },
    .Pointer: self.analyze_type_expr(ty.kind.Pointer.inner[0]),
    .Array: {
      if ty.kind.Array.len: |len_expr| self.analyze_expr(len_expr[0])
      self.analyze_type_expr(ty.kind.Array.inner[0])
    },
    .Slice: self.analyze_type_expr(ty.kind.Slice.element[0]),
    .Optional: self.analyze_type_expr(ty.kind.Optional.inner[0]),
    .Function: {
      mut i: usize = 0
      for i < ty.kind.Function.params.len: {
        param := ty.kind.Function.params[i]
        self.analyze_type_expr(param.ty)
        i += 1
      }
      self.analyze_type_expr(ty.kind.Function.return_type[0])
    },
    .Errorable: {
      self.analyze_type_expr(ty.kind.Errorable.ok[0])
    },
    .Struct: {
      mut i: usize = 0
      for i < ty.kind.Struct.fields.len: {
        field := ty.kind.Struct.fields[i]
        self.analyze_type_expr(field.ty)
        if field.default_value: |value| self.analyze_expr(value)
        i += 1
      }
    },
    .Enum: {
      if ty.kind.Enum.repr: |repr| self.analyze_type_expr(repr[0])
      mut i: usize = 0
      for i < ty.kind.Enum.variants.len: {
        variant := ty.kind.Enum.variants[i]
        if variant.payload: |payload| self.analyze_type_expr(payload)
        i += 1
      }
    },
  }
  return
}

Analyzer.analyze_expr := (self: *mut Analyzer, expr: ast.Expr) {
  match expr.kind {
    .Literal: {},
    .BuiltinIdent: {},
    .Use: {},
    .TypeLiteral: self.analyze_type_expr(expr.kind.TypeLiteral),
    .Ident: self.resolve_ident(expr.kind.Ident),
    .Unary: self.analyze_expr(expr.kind.Unary.expr[0]),
    .Binary: {
      self.analyze_expr(expr.kind.Binary.left[0])
      self.analyze_expr(expr.kind.Binary.right[0])
    },
    .Assign: {
      self.analyze_expr(expr.kind.Assign.target[0])
      self.analyze_expr(expr.kind.Assign.value[0])
    },
    .Call: {
      self.analyze_expr(expr.kind.Call.callee[0])
      mut i: usize = 0
      for i < expr.kind.Call.args.len: {
        arg := expr.kind.Call.args[i]
        self.analyze_expr(arg.value)
        i += 1
      }
    },
    .FieldAccess: self.analyze_expr(expr.kind.FieldAccess.base[0]),
    .DerefAccess: self.analyze_expr(expr.kind.DerefAccess.base[0]),
    .Index: {
      self.analyze_expr(expr.kind.Index.base[0])
      self.analyze_expr(expr.kind.Index.index[0])
    },
    .Slice: {
      self.analyze_expr(expr.kind.Slice.base[0])
      if expr.kind.Slice.start: |start| self.analyze_expr(start[0])
      if expr.kind.Slice.end: |end| self.analyze_expr(end[0])
    },
    .Block: self.analyze_block(expr.kind.Block),
    .If: self.analyze_if_expr(expr.kind.If),
    .Match: self.analyze_match_expr(expr.kind.Match),
    .For: self.analyze_for_expr(expr.kind.For),
    .Break: {
      if expr.kind.Break.value: |value| {
        self.analyze_expr(value[0])
      }
    },
    .Continue: {},
    .Return: {
      if expr.kind.Return.value: |value| {
        self.analyze_expr(value[0])
      }
    },
    .Defer: self.analyze_defer_expr(expr.kind.Defer),
    .OptionalUnwrap: self.analyze_expr(expr.kind.OptionalUnwrap.expr[0]),
    .ErrorUnwrap: self.analyze_expr(expr.kind.ErrorUnwrap.expr[0]),
    .OrElse: self.analyze_or_else_expr(expr.kind.OrElse),
    .StructLiteral: {
      mut i: usize = 0
      for i < expr.kind.StructLiteral.fields.len: {
        field := expr.kind.StructLiteral.fields[i]
        if field.value: |field_value| {
          self.analyze_expr(field_value)
        }
        i += 1
      }
    },
    .TypeConstruct: {
      self.analyze_expr(expr.kind.TypeConstruct.ty_expr[0])
      mut i: usize = 0
      for i < expr.kind.TypeConstruct.fields.len: {
        field := expr.kind.TypeConstruct.fields[i]
        if field.value: |field_value| {
          self.analyze_expr(field_value)
        }
        i += 1
      }
    },
    .ArrayLiteral: {
      mut i: usize = 0
      for i < expr.kind.ArrayLiteral.len: {
        self.analyze_expr(expr.kind.ArrayLiteral[i])
        i += 1
      }
    },
    .TupleLiteral: {
      mut i: usize = 0
      for i < expr.kind.TupleLiteral.len: {
        self.analyze_expr(expr.kind.TupleLiteral[i])
        i += 1
      }
    },
    .EnumVariantConstruct: {
      mut i: usize = 0
      for i < expr.kind.EnumVariantConstruct.payload.len: {
        self.analyze_expr(expr.kind.EnumVariantConstruct.payload[i])
        i += 1
      }
    },
    .Fn: self.analyze_fn_expr(expr.kind.Fn),
    .Comptime: self.analyze_expr(expr.kind.Comptime.expr[0]),
    .Inline: self.analyze_expr(expr.kind.Inline.expr[0]),
  }
  return
}

Analyzer.analyze_block := (self: *mut Analyzer, block: ast.BlockExpr) {
  self.push_scope()
  mut i: usize = 0
  for i < block.statements.len: {
    self.analyze_stmt(block.statements[i])
    i += 1
  }
  if block.tail_expr: |tail| self.analyze_expr(tail[0])
  self.pop_scope()
  return
}

Analyzer.analyze_stmt := (self: *mut Analyzer, stmt: ast.Stmt) {
  match stmt {
    .Binding: {
      binding := stmt.Binding[0]
      if binding.annotation: |annotation| self.analyze_type_expr(annotation)
      self.analyze_expr(binding.value)
      self.bind_name(binding.name)
    },
    .Destructure: {
      destructure := stmt.Destructure[0]
      self.analyze_expr(destructure.value)
      mut i: usize = 0
      for i < destructure.names.len: {
        name := destructure.names[i]
        self.bind_name(name.name)
        i += 1
      }
    },
    .Expr: self.analyze_expr(stmt.Expr[0]),
  }
  return
}

Analyzer.analyze_if_expr := (self: *mut Analyzer, if_expr: ast.IfExpr) {
  self.analyze_expr(if_expr.condition[0])
  if if_expr.capture != null {
    self.push_scope()
    mut i: usize = 0
    capture := if_expr.capture or return
    for i < capture.bindings.len: {
      if capture.bindings[i]: |binding| self.bind_name(binding)
      i += 1
    }
    self.analyze_expr(if_expr.then_branch[0])
    self.pop_scope()
  } else {
    self.analyze_expr(if_expr.then_branch[0])
  }
  if if_expr.else_branch: |else_branch| self.analyze_expr(else_branch[0])
  return
}

Analyzer.analyze_match_expr := (self: *mut Analyzer, match_expr: ast.MatchExpr) {
  self.analyze_expr(match_expr.scrutinee[0])
  mut i: usize = 0
  for i < match_expr.arms.len: {
    arm := match_expr.arms[i]
    self.push_scope()
    self.bind_pattern(arm.pattern)
    if arm.guard: |guard| self.analyze_expr(guard)
    self.analyze_expr(arm.value)
    self.pop_scope()
    i += 1
  }
  return
}

Analyzer.bind_pattern := (self: *mut Analyzer, pattern: ast.Pattern) {
  match pattern.kind {
    .Wildcard: {},
    .Literal: {},
    .IdentBind: self.bind_name(pattern.kind.IdentBind),
    .Range: {
      self.bind_pattern(pattern.kind.Range.start[0])
      self.bind_pattern(pattern.kind.Range.end[0])
    },
    .EnumVariant: {
      mut i: usize = 0
      for i < pattern.kind.EnumVariant.bindings.len: {
        self.bind_name(pattern.kind.EnumVariant.bindings[i])
        i += 1
      }
    },
    .Typed: self.bind_pattern(pattern.kind.Typed.pattern[0]),
    .TypeLiteral: {},
  }
  return
}

Analyzer.analyze_for_expr := (self: *mut Analyzer, for_expr: ast.ForExpr) {
  match for_expr {
    .Infinite: self.analyze_expr(for_expr.Infinite.body[0]),
    .WhileLike: {
      self.analyze_expr(for_expr.WhileLike.condition[0])
      self.push_scope()
      if for_expr.WhileLike.binding: |binding| self.bind_name(binding)
      self.analyze_expr(for_expr.WhileLike.body[0])
      self.pop_scope()
    },
    .Iterate: {
      self.analyze_expr(for_expr.Iterate.iterable[0])
      self.push_scope()
      if for_expr.Iterate.binding: |binding| self.bind_name(binding)
      self.analyze_expr(for_expr.Iterate.body[0])
      self.pop_scope()
    },
    .Range: {
      self.analyze_expr(for_expr.Range.start[0])
      self.analyze_expr(for_expr.Range.end[0])
      self.push_scope()
      if for_expr.Range.binding: |binding| self.bind_name(binding)
      self.analyze_expr(for_expr.Range.body[0])
      self.pop_scope()
    },
  }
  return
}

Analyzer.analyze_defer_expr := (self: *mut Analyzer, defer_expr: ast.DeferExpr) {
  self.push_scope()
  if defer_expr.error_binding: |binding| self.bind_name(binding)
  self.analyze_expr(defer_expr.body[0])
  self.pop_scope()
  return
}

Analyzer.analyze_or_else_expr := (self: *mut Analyzer, expr: ast.OrElseExpr) {
  self.analyze_expr(expr.value[0])
  self.push_scope()
  if expr.error_binding: |binding| self.bind_name(binding)
  self.analyze_expr(expr.fallback[0])
  self.pop_scope()
  return
}

Analyzer.analyze_fn_expr := (self: *mut Analyzer, fn_expr: ast.FnExpr) {
  self.push_scope()
  mut i: usize = 0
  for i < fn_expr.params.len: {
    param := fn_expr.params[i]
    if param.ty: |ty| self.analyze_type_expr(ty)
    if param.default_value: |value| self.analyze_expr(value)
    self.bind_name(param.name)
    i += 1
  }
  if fn_expr.return_type: |ty| self.analyze_type_expr(ty)
  match fn_expr.body {
    .Block: self.analyze_block(fn_expr.body.Block),
    .ArrowExpr: self.analyze_expr(fn_expr.body.ArrowExpr[0]),
  }
  self.pop_scope()
  return
}

Analyzer.resolve_ident := (self: *mut Analyzer, ident: ast.Ident) {
  if str.eq(ident.text, "_") return
  if self.lookup_name(ident.text) return
  if self.find_decl(ident.text) != null return
  if self.lookup_import_alias(ident.text) return
  if is_predeclared_name(ident.text) return
  if looks_like_type_parameter(ident.text) return
  if self.lookup_out_of_scope(ident.text) {
    self.error_at(ident.span, .E4001, "name is out of scope")
    return
  }
  self.error_at(ident.span, .E4001, "cannot resolve name")
  return
}

Analyzer.resolve_type_ident := (self: *mut Analyzer, ident: ast.Ident) {
  if self.find_decl(ident.text) != null return
  if self.lookup_name(ident.text) return
  if self.lookup_import_alias(ident.text) return
  if is_predeclared_name(ident.text) return
  if looks_like_type_parameter(ident.text) return
  self.error_at(ident.span, .E4001, "cannot resolve type name")
  return
}

Analyzer.lookup_name := (self: Analyzer, name: []u8) u1 {
  mut scope_i := self.scopes.len
  for scope_i > 0: {
    scope_i -= 1
    scope := self.scopes[scope_i]
    mut i: usize = 0
    for i < scope.bindings.len: {
      binding := scope.bindings[i]
      if str.eq(binding.name.text, name) return true
      i += 1
    }
  }
  return false
}

Analyzer.lookup_out_of_scope := (self: Analyzer, name: []u8) u1 {
  mut i: usize = 0
  for i < self.out_of_scope.len: {
    binding := self.out_of_scope[i]
    if str.eq(binding.name.text, name) return true
    i += 1
  }
  return false
}

Analyzer.lookup_import_alias := (self: Analyzer, name: []u8) u1 {
  mut i: usize = 0
  for i < self.import_aliases.len: {
    alias := self.import_aliases[i]
    if str.eq(alias.text, name) return true
    i += 1
  }
  return false
}

Analyzer.bind_name := (self: *mut Analyzer, ident: ast.Ident) {
  if str.eq(ident.text, "_") return
  if self.scopes.len == 0 self.push_scope()
  mut scope_index := self.scopes.len
  scope_index -= 1
  binding_count := self.scopes.buf[scope_index].bindings.len
  mut i: usize = 0
  for i < binding_count: {
    binding := self.scopes.buf[scope_index].bindings[i]
    if str.eq(binding.name.text, ident.text) {
      self.error_at(ident.span, .E4002, "duplicate local binding")
      return
    }
    i += 1
  }
  self.scopes.buf[scope_index].bindings.push(.{ name: ident }).!
  return
}

Analyzer.push_scope := (self: *mut Analyzer) {
  self.scopes.push(.{
    bindings: Vec(ScopeBinding).init(self.allocator),
  }).!
  return
}

Analyzer.pop_scope := (self: *mut Analyzer) {
  if self.scopes.len == 0 return
  mut scope_index := self.scopes.len
  scope_index -= 1
  scope := self.scopes.buf[scope_index]
  mut i: usize = 0
  for i < scope.bindings.len: {
    self.out_of_scope.push(scope.bindings[i]).!
    i += 1
  }
  self.scopes.len -= 1
  return
}

Analyzer.error_at := (self: *mut Analyzer, span: diagnostics.SourceSpan, code: diagnostics.DiagnosticCode, message: []u8) {
  diag := diagnostics.Diagnostic.error(.Semantic, code, message)
  self.diagnostics.push(diag.with_primary_file_label(self.file_path, span, message)).!
  return
}

is_predeclared_name := (name: []u8) u1 {
  if str.eq(name, "u1") return true
  if str.eq(name, "u8") return true
  if str.eq(name, "u16") return true
  if str.eq(name, "u32") return true
  if str.eq(name, "u64") return true
  if str.eq(name, "i8") return true
  if str.eq(name, "i16") return true
  if str.eq(name, "i31") return true
  if str.eq(name, "i32") return true
  if str.eq(name, "i64") return true
  if str.eq(name, "f32") return true
  if str.eq(name, "f64") return true
  if str.eq(name, "type") return true
  if str.eq(name, "any") return true
  if str.eq(name, "opaque") return true
  if str.eq(name, "void") return true
  if str.eq(name, "usize") return true
  if str.eq(name, "isize") return true
  if str.eq(name, "_") return true
  return false
}

looks_like_type_parameter := (name: []u8) u1 {
  if name.len != 1 return false
  ch := name[0]
  return ch >= 'A' && ch <= 'Z'
}
