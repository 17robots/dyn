module main

// ── Parser ────────────────────────────────────────────────────────────────────

/// Parse a token stream into a Module.
/// `tokens` must include the trailing EOF produced by the lexer.
/// `alloc` is used for all AST node allocations (use an arena for easy cleanup).
pub parse := (src: []u8, path: []u8, tokens: Vec(Token), alloc: Allocator) Module {
    mut p := Parser.init(src, path, tokens, alloc)
    p.parse_module()
    return p.module_
}

Parser := struct {
    src:     []u8,
    toks:    Vec(Token),
    pos:     usize,    // index into toks
    alloc:   Allocator,
    module_: Module,
    init := (src: []u8, path: []u8, tokens: Vec(Token), alloc: Allocator) Parser {
        return .{
            src:   src,
            toks:  tokens,
            pos:   0,
            alloc: alloc,
            module_: Module.{
                src:    src,
                path:   path,
                tokens: tokens,
                items:  Vec(*Item).init(alloc),
                errors: Vec(ParseError).init(alloc),
            },
        }
    },
    cur := (self: Parser) Token {
        t := self.toks.get(self.pos) or return Token{ kind: .eof, start: 0, len: 0 }
        return t.*
    },
    peek_tok := (self: Parser, offset: usize) Token {
        t := self.toks.get(self.pos + offset) or return Token{ kind: .eof, start: 0, len: 0 }
        return t.*
    },
    advance := (self: *Parser) Token {
        t := self.cur()
        if self.pos + 1 < self.toks.len
            self.pos += 1
        return t
    },
    at := (self: Parser, kind: TokenKind) bool {
        // Compare enum tags via byte-wise equality
        cur_kind := self.cur().kind
        // Use a helper since direct enum comparison should work
        return cur_kind == kind
    },
    eat := (self: *Parser, kind: TokenKind) bool {
        if self.at(kind) {
            self.pos += 1
            return true
        }
        return false
    },
    expect := (self: *Parser, kind: TokenKind) ?Token {
        t := self.cur()
        if t.kind == kind {
            self.pos += 1
            return t
        }
        self.error_at(t, "unexpected token")
        return null
    },
    tok_text := (self: Parser, tok: Token) []u8 => token_text(tok, self.src),
    cur_text := (self: Parser) []u8 => token_text(self.cur(), self.src),
    error_at := (self: *Parser, tok: Token, msg: []u8) {
        self.module_.errors.push(ParseError.{
            msg:   msg,
            start: tok.start,
            end:   tok.start + tok.len,
        })
    },
    skip_doc := (self: *Parser) u32 {
        if self.cur().kind == .doc_comment {
            idx := $as(u32, self.pos)
            self.pos += 1
            return idx
        }
        return 0
    },
    parse_module := (self: *Parser) {
        // Optional doc comment before module declaration
        doc := self.skip_doc()
        // module <name>
        if self.at(.kw_module) {
            start := self.cur().start
            self.pos += 1
            name_tok := self.expect(.ident) or {
                // recovery: just continue
            }
            name_idx: u32 = 0
            if name_tok: |nt| name_idx = $as(u32, self.pos - 1)
            item := alloc_item(self.alloc, .module_decl, start, self.cur().start) or return
            item.name = name_idx
            item.doc  = doc
            self.module_.items.push(item)
        }
        for {
            if self.at(.eof) break
            self.parse_item()
        }
    },
    parse_item := (self: *Parser) {
        doc    := self.skip_doc()
        is_pub := self.eat(.kw_pub)
        start  := self.cur().start
        if self.at(.kw_use) {
            self.parse_use_item(start, is_pub, doc)
            return
        }
        if self.at(.ident) {
            name_tok := self.cur()
            name_pos := $as(u32, self.pos)
            self.pos += 1

            if self.eat(.colon_eq) {
                self.parse_named_binding(start, name_pos, is_pub, doc)
                return
            }

            // name: Type = expr
            if self.eat(.colon) {
                self.parse_typed_binding(start, name_pos, is_pub, doc)
                return
            }

            self.error_at(self.cur(), "expected := or : after name")
            self.recover_to_next_item()
            return
        }
        self.error_at(self.cur(), "expected top-level declaration")
        self.recover_to_next_item()
    },
    parse_use_item := (self: *Parser, start: u32, is_pub: bool, doc: u32) {
        self.pos += 1  // consume 'use'
        path_tok := self.expect(.string_lit) or return
        item := alloc_item(self.alloc, .use_item, start, self.cur().start) or return
        item.is_pub   = is_pub
        item.path_tok = $as(u32, self.pos - 1)
        item.doc      = doc
        self.module_.items.push(item)
    },
    parse_named_binding := (self: *Parser, start: u32, name_pos: u32, is_pub: bool, doc: u32) {
        // After consuming `name :=`, decide what follows
        if self.at(.lparen) or self.at(.kw_extern) {
            // Function: name := (params) RetType { body }
            //        or name := extern (params) RetType = "sym"
            self.parse_fn_item(start, name_pos, is_pub, doc)
            return
        }

        if self.at(.kw_struct) or self.at(.kw_packed) {
            self.parse_struct_item(start, name_pos, is_pub, doc)
            return
        }

        if self.at(.kw_enum) {
            self.parse_enum_item(start, name_pos, is_pub, doc)
            return
        }

        // Generic value binding
        expr := self.parse_expr() or {
            self.error_at(self.cur(), "expected expression")
            return
        }
        item := alloc_item(self.alloc, .let_item, start, expr.end) or return
        item.name   = name_pos
        item.is_pub = is_pub
        item.doc    = doc
        item.value  = expr
        self.module_.items.push(item)
    },
    parse_typed_binding := (self: *Parser, start: u32, name_pos: u32, is_pub: bool, doc: u32) {
        ty := self.parse_type() or return
        self.expect(.eq) or return
        expr := self.parse_expr() or return
        item := alloc_item(self.alloc, .let_item, start, expr.end) or return
        item.name   = name_pos
        item.is_pub = is_pub
        item.doc    = doc
        item.ty     = ty
        item.value  = expr
        self.module_.items.push(item)
    },
    parse_fn_item := (self: *Parser, start: u32, name_pos: u32, is_pub: bool, doc: u32) {
        is_extern := self.eat(.kw_extern)
        sig := self.parse_fn_sig() or return

        mut body: ?*Expr = null

        if is_extern {
            // extern fn: = "symbol"
            self.expect(.eq) or return
            sym_tok := self.expect(.string_lit) or return
            // Store symbol as a string-literal expr in body.tok for now
            sym_expr := alloc_expr(self.alloc, .str_lit, sym_tok.start, sym_tok.start + sym_tok.len) or return
            sym_expr.tok = $as(u32, self.pos - 1)
            body = sym_expr
        } else if self.at(.fat_arrow) {
            // Arrow body: => expr
            self.pos += 1
            e := self.parse_expr() or return
            body = e
        } else if self.at(.lbrace) {
            // Block body
            e := self.parse_block() or return
            body = e
        }

        item := alloc_item(self.alloc, .fn_item, start, self.cur().start) or return
        item.name   = name_pos
        item.is_pub = is_pub
        item.doc    = doc
        item.sig    = sig
        item.body   = body
        self.module_.items.push(item)
    },
    parse_struct_item := (self: *Parser, start: u32, name_pos: u32, is_pub: bool, doc: u32) {
        // struct { ... } or packed struct { ... }
        if self.eat(.kw_packed) {}
        self.expect(.kw_struct) or return
        // TODO: parse struct body into a TypeExpr
        self.skip_balanced_braces()
        item := alloc_item(self.alloc, .struct_item, start, self.cur().start) or return
        item.name   = name_pos
        item.is_pub = is_pub
        item.doc    = doc
        self.module_.items.push(item)
    },
    parse_enum_item := (self: *Parser, start: u32, name_pos: u32, is_pub: bool, doc: u32) {
        self.expect(.kw_enum) or return
        // Optional explicit tag type: enum(u8) { ... }
        if self.eat(.lparen) {
            self.parse_type() or {}
            self.expect(.rparen) or {}
        }
        self.skip_balanced_braces()
        item := alloc_item(self.alloc, .enum_item, start, self.cur().start) or return
        item.name   = name_pos
        item.is_pub = is_pub
        item.doc    = doc
        self.module_.items.push(item)
    },
    parse_fn_sig := (self: *Parser) ?*FnSig {
        sig := self.alloc.create(FnSig) or return null
        sig.* = FnSig.{
            params:    .{ ptr: $as(**Param, 1), len: 0 },
            ret:       null,
            is_comp:   false,
            errorable: false,
        }
        self.expect(.lparen) or return null
        mut params := Vec(*Param).init(self.alloc)
        for {
            if self.at(.rparen) break
            if self.at(.eof) break
            p := self.parse_param() or break
            params.push(p)
            if !self.eat(.comma) break
        }
        self.expect(.rparen) or return null

        // Optional return type
        if !self.at(.fat_arrow) and !self.at(.lbrace) and !self.at(.eq) and !self.at(.eof) {
            if self.at(.kw_comp) {
                self.pos += 1
                sig.is_comp = true
            }
            ret := self.parse_type() or {}
            sig.ret = ret
            // Check for errorable suffix !
            if self.eat(.bang) sig.errorable = true
        }

        // Convert Vec(*Param) to slice
        if params.len > 0 {
            buf := self.alloc.create_many(*Param, params.len) or return sig
            mut i: usize = 0
            for i < params.len: {
                elem := params.get(i) or break
                buf[i] = elem.*
                i += 1
            }
            sig.params = buf
        }
        params.deinit()
        return sig
    },
    parse_param := (self: *Parser) ?*Param {
        p := self.alloc.create(Param) or return null
        p.* = Param.{ name: 0, ty: null, default_: null, is_comp: false, is_mut: false }
        if self.eat(.kw_comp) p.is_comp = true
        if self.eat(.kw_mut)  p.is_mut  = true
        name_tok := self.expect(.ident) or return null
        p.name = $as(u32, self.pos - 1)
        self.expect(.colon) or return null
        p.ty = self.parse_type()
        if self.eat(.eq) {
            p.default_ = self.parse_expr()
        }
        return p
    },
    parse_type := (self: *Parser) ?*TypeExpr {
        start := self.cur().start
        t := self.alloc.create(TypeExpr) or return null
        t.* = TypeExpr.{
            tag:   .inferred,
            start: start,
            end:   start,
            tok:   0,
            child: null,
            size:  null,
            extra: null,
        }

        // Optional ?T
        if self.eat(.question) {
            inner := self.parse_type() or return null
            t.tag   = .optional
            t.child = inner
            t.end   = inner.end
            return t
        }

        // Pointer *T or *mut T
        if self.eat(.star) {
            if self.eat(.kw_mut) {
                inner := self.parse_type() or return null
                t.tag   = .ptr_mut
                t.child = inner
                t.end   = inner.end
                return t
            }
            if self.eat(.kw_any) {
                t.tag = .any_type
                t.end = self.cur().start
                return t
            }
            inner := self.parse_type() or return null
            t.tag   = .ptr
            t.child = inner
            t.end   = inner.end
            return t
        }

        // Slice []T or Array [N]T
        if self.eat(.lbracket) {
            if self.eat(.rbracket) {
                // []T — slice
                inner := self.parse_type() or return null
                t.tag   = .slice
                t.child = inner
                t.end   = inner.end
                return t
            }
            // [N]T — fixed array; parse N as expression
            size := self.parse_expr() or return null
            self.expect(.rbracket) or return null
            inner := self.parse_type() or return null
            t.tag   = .array
            t.size  = size
            t.child = inner
            t.end   = inner.end
            return t
        }

        // fn(P...) R
        if self.eat(.kw_fn) {
            sig := self.parse_fn_sig() or return null
            fs := self.alloc.create(FnTypeSig) or return null
            fs.* = FnTypeSig.{ params: sig.params, ret: sig.ret }
            t.tag   = .fn_type
            t.extra = fs
            t.end   = self.cur().start
            return t
        }

        // Named type: identifier (possibly qualified a.b.c)
        if self.at(.ident) {
            t.tag = .named
            t.tok = $as(u32, self.pos)
            self.pos += 1
            // Support qualified paths: a.b.c — just advance past them
            for {
                if !self.at(.dot) break
                if !self.peek_tok(1).kind == .ident break
                self.pos += 2
            }
            t.end = self.cur().start
            return t
        }

        return null
    },
    parse_expr := (self: *Parser) ?*Expr => self.parse_pratt(0),
    parse_pratt := (self: *Parser, min_bp: u8) ?*Expr {
        mut lhs := self.parse_prefix() or return null
        for {
            op  := self.cur()
            bp  := infix_binding_power(op.kind)
            if bp == 0 break
            if bp < min_bp break
            self.pos += 1   // consume operator
            if op.kind == .kw_or {
                rhs := self.parse_or_rhs() or break
                node := alloc_expr(self.alloc, .or_expr, lhs.start, rhs.end) or break
                node.a = lhs
                node.b = rhs
                lhs = node
                continue
            }
            if op.kind == .dot_dot or op.kind == .dot_dot_eq {
                rhs := self.parse_pratt(bp + 1) or break
                tag := if op.kind == .dot_dot_eq ExprTag.range_incl else ExprTag.range_excl
                node := alloc_expr(self.alloc, tag, lhs.start, rhs.end) or break
                node.a = lhs
                node.b = rhs
                lhs = node
                continue
            }
            tag := bin_op_tag(op.kind)
            rhs := self.parse_pratt(bp + 1) or break
            node := alloc_expr(self.alloc, tag, lhs.start, rhs.end) or break
            node.a   = lhs
            node.b   = rhs
            node.tok = $as(u32, self.pos - 1)
            lhs = node
        }
        lhs = self.parse_postfix(lhs)
        return lhs
    },
    parse_prefix := (self: *Parser) ?*Expr {
        tok := self.cur()
        start := tok.start

        // Literals
        if tok.kind == .int_lit {
            self.pos += 1
            e := alloc_expr(self.alloc, .int_lit, start, start + tok.len) or return null
            e.tok = $as(u32, self.pos - 1)
            return e
        }
        if tok.kind == .float_lit {
            self.pos += 1
            e := alloc_expr(self.alloc, .float_lit, start, start + tok.len) or return null
            e.tok = $as(u32, self.pos - 1)
            return e
        }
        if tok.kind == .string_lit {
            self.pos += 1
            e := alloc_expr(self.alloc, .str_lit, start, start + tok.len) or return null
            e.tok = $as(u32, self.pos - 1)
            return e
        }
        if tok.kind == .char_lit {
            self.pos += 1
            e := alloc_expr(self.alloc, .char_lit, start, start + tok.len) or return null
            e.tok = $as(u32, self.pos - 1)
            return e
        }
        if tok.kind == .kw_true or tok.kind == .kw_false {
            self.pos += 1
            e := alloc_expr(self.alloc, .bool_lit, start, start + tok.len) or return null
            e.flag = tok.kind == .kw_true
            return e
        }
        if tok.kind == .kw_null {
            self.pos += 1
            return alloc_expr(self.alloc, .null_lit, start, start + tok.len)
        }

        // Identifier
        if tok.kind == .ident {
            self.pos += 1
            e := alloc_expr(self.alloc, .ident, start, start + tok.len) or return null
            e.tok = $as(u32, self.pos - 1)
            return e
        }

        // Builtin $name
        if tok.kind == .builtin_ident {
            self.pos += 1
            e := alloc_expr(self.alloc, .builtin, start, start + tok.len) or return null
            e.tok = $as(u32, self.pos - 1)
            // Consume argument list if present
            if self.at(.lparen) {
                e = self.parse_call_on(e) or return e
            }
            return e
        }

        // use "path"
        if tok.kind == .kw_use {
            self.pos += 1
            path := self.expect(.string_lit) or return null
            e := alloc_expr(self.alloc, .use_expr, start, path.start + path.len) or return null
            e.tok = $as(u32, self.pos - 1)
            return e
        }

        // Unary prefix operators
        if tok.kind == .minus {
            self.pos += 1
            operand := self.parse_pratt(prefix_bp()) or return null
            e := alloc_expr(self.alloc, .unary_neg, start, operand.end) or return null
            e.a = operand
            return e
        }
        if tok.kind == .kw_not {
            self.pos += 1
            operand := self.parse_pratt(prefix_bp()) or return null
            e := alloc_expr(self.alloc, .unary_not, start, operand.end) or return null
            e.a = operand
            return e
        }
        if tok.kind == .tilde {
            self.pos += 1
            operand := self.parse_pratt(prefix_bp()) or return null
            e := alloc_expr(self.alloc, .unary_bit_not, start, operand.end) or return null
            e.a = operand
            return e
        }
        if tok.kind == .amp {
            self.pos += 1
            is_mut := self.eat(.kw_mut)
            operand := self.parse_pratt(prefix_bp()) or return null
            tag := if is_mut ExprTag.addr_of_mut else ExprTag.addr_of
            e := alloc_expr(self.alloc, tag, start, operand.end) or return null
            e.a = operand
            return e
        }
        if tok.kind == .kw_comp {
            self.pos += 1
            operand := self.parse_pratt(prefix_bp()) or return null
            e := alloc_expr(self.alloc, .comp_expr, start, operand.end) or return null
            e.a = operand
            return e
        }

        // Grouped expression or tuple
        if tok.kind == .lparen {
            self.pos += 1
            inner := self.parse_expr() or return null
            self.expect(.rparen) or return inner
            return inner
        }

        // Block expression { ... }
        if tok.kind == .lbrace {
            return self.parse_block()
        }

        // if expression
        if tok.kind == .kw_if {
            return self.parse_if()
        }

        // match expression
        if tok.kind == .kw_match {
            return self.parse_match()
        }

        // for loop
        if tok.kind == .kw_for {
            return self.parse_for()
        }

        // return
        if tok.kind == .kw_return {
            self.pos += 1
            // return with no value if next token starts a new statement boundary
            if self.at_stmt_end() {
                return alloc_expr(self.alloc, .return_expr, start, self.cur().start)
            }
            val := self.parse_expr() or return null
            e := alloc_expr(self.alloc, .return_expr, start, val.end) or return null
            e.a = val
            return e
        }

        // break
        if tok.kind == .kw_break {
            self.pos += 1
            e := alloc_expr(self.alloc, .break_expr, start, self.cur().start) or return null
            // Optional label :name
            if self.at(.colon) and self.peek_tok(1).kind == .ident {
                self.pos += 1
                e.tok = $as(u32, self.pos)
                self.pos += 1
            }
            // Optional value
            if !self.at_stmt_end() {
                val := self.parse_expr() or return e
                e.a  = val
                e.end = val.end
            }
            return e
        }

        // continue
        if tok.kind == .kw_continue {
            self.pos += 1
            e := alloc_expr(self.alloc, .continue_expr, start, self.cur().start) or return null
            if self.at(.colon) and self.peek_tok(1).kind == .ident {
                self.pos += 1
                e.tok = $as(u32, self.pos)
                self.pos += 1
            }
            return e
        }
        if tok.kind == .kw_defer {
            self.pos += 1
            // defer |e| { ... }  or  defer { ... }
            if self.at(.pipe) {
                self.pos += 1
                binding_tok: u32 = 0
                if self.at(.ident) {
                    binding_tok = $as(u32, self.pos)
                    self.pos += 1
                }
                self.expect(.pipe) or return null
                body := self.parse_block() or return null
                node := alloc_expr(self.alloc, .defer_err, start, body.end) or return null
                node.tok = binding_tok
                node.a   = body
                return node
            }
            body := self.parse_block() or return null
            node := alloc_expr(self.alloc, .defer_expr, start, body.end) or return null
            node.a = body
            return node
        }
        if tok.kind == .dot and self.peek_tok(1).kind == .ident {
            self.pos += 2
            e := alloc_expr(self.alloc, .ident, start, self.cur().start) or return null
            e.tok  = $as(u32, self.pos - 1)
            e.flag = true  // flag = true means dot-inferred enum variant
            if self.at(.lparen) {
                e = self.parse_call_on(e) or return e
            }
            return e
        }
        if tok.kind == .lbracket {
            return self.parse_array_lit()
        }
        return null
    },
    parse_postfix := (self: *Parser, mut lhs: *Expr) *Expr {
        for {
          tok := self.cur()
          match tok.kind {
            .dot: {
              self.pos += 1
              next := self.cur()
              match next.kind {
                .star: {
                  self.pos += 1
                  node := alloc_expr(self.alloc, .deref, lhs.start, self.cur().start) or break
                  node.a = lhs
                  lhs = node
                  continue
                },
                .question: {
                  self.pos += 1
                  node := alloc_expr(self.alloc, .unwrap_opt, lhs.start, self.cur().start) or break
                  node.a = lhs
                  lhs = node
                  continue
                },
                .bang: {
                  self.pos += 1
                  node := alloc_expr(self.alloc, .unwrap_err, lhs.start, self.cur().start) or break
                  node.a = lhs
                  lhs = node
                  continue
                },
                .ident: {
                  field_pos := $as(u32, self.pos)
                  self.pos += 1
                  node := alloc_expr(self.alloc, .field, lhs.start, self.cur().start) or break
                  node.a   = lhs
                  node.tok = field_pos
                  lhs = node
                  continue
                },
                _: {},
              }
            },
            .lparen: {
              new_lhs := self.parse_call_on(lhs) or break
              lhs = new_lhs
              continue
            },
            .lbracket: {
              self.pos += 1
              idx := self.parse_expr() or break
              if self.at(.dot_dot) or self.at(.dot_dot_eq) {
                  inclusive := self.at(.dot_dot_eq)
                  self.pos += 1
                  hi := self.parse_expr()
                  self.expect(.rbracket) or break
                  node := alloc_expr(self.alloc, .slice_expr, lhs.start, self.cur().start) or break
                  node.a    = lhs
                  node.b    = idx
                  node.c    = hi
                  node.flag = inclusive
                  lhs = node
              } else {
                  self.expect(.rbracket) or break
                  node := alloc_expr(self.alloc, .index, lhs.start, self.cur().start) or break
                  node.a = lhs
                  node.b = idx
                  lhs = node
              }
              continue
            },
            _: {},
          }
          break
        }
        return lhs
    },
    parse_call_on := (self: *Parser, callee: *Expr) ?*Expr {
        self.expect(.lparen) or return null
        mut args := Vec(*Expr).init(self.alloc)
        for {
            if self.at(.rparen) break
            if self.at(.eof) break
            arg := self.parse_expr() or break
            args.push(arg)
            if !self.eat(.comma) break
        }
        end_tok := self.expect(.rparen) or return null

        node := alloc_expr(self.alloc, .call, callee.start, end_tok.start + end_tok.len) or return null
        node.a = callee
        if args.len > 0 {
            buf := self.alloc.create_many(*Expr, args.len) or return node
            mut i: usize = 0
            for i < args.len: {
                elem := args.get(i) or break
                buf[i] = elem.*
                i += 1
            }
            node.list     = $as(*any, buf.ptr)
            node.list_len = $as(u32, args.len)
        }
        args.deinit()
        return node
    },
    parse_or_rhs := (self: *Parser) ?*Expr {
        if self.at(.pipe) {
            self.pos += 1
            mut binding: u32 = 0
            if self.at(.ident) {
                binding = $as(u32, self.pos)
                self.pos += 1
            } else {
                self.expect(.ident) or return null
            }
            self.expect(.pipe) or return null
            body := self.parse_block() or return null
            body.tok = binding   // stash binding in body's tok field
            return body
        }
        return self.parse_expr()
    },
    parse_block := (self: *Parser) ?*Expr {
        start := self.cur().start
        self.expect(.lbrace) or return null
        mut stmts := Vec(*Stmt).init(self.alloc)
        for {
            if self.at(.rbrace) break
            if self.at(.eof) break
            s := self.parse_stmt() or break
            stmts.push(s)
        }
        end_tok := self.expect(.rbrace) or return null

        node := alloc_expr(self.alloc, .block, start, end_tok.start + end_tok.len) or return null
        if stmts.len > 0 {
            buf := self.alloc.create_many(*Stmt, stmts.len) or return node
            mut i: usize = 0
            for i < stmts.len: {
                elem := stmts.get(i) or break
                buf[i] = elem.*
                i += 1
            }
            node.list     = $as(*any, buf.ptr)
            node.list_len = $as(u32, stmts.len)
        }
        stmts.deinit()
        return node
    },
    parse_stmt := (self: *Parser) ?*Stmt {
        start := self.cur().start
        is_pub := self.eat(.kw_pub)
        is_mut := self.eat(.kw_mut)
        if self.at(.ident) and self.peek_tok(1).kind == .colon_eq {
            name_pos := $as(u32, self.pos)
            self.pos += 2  // name :=
            expr := self.parse_expr() or return null
            s := alloc_stmt(self.alloc, .let_stmt, start, expr.end) or return null
            s.name   = name_pos
            s.is_mut = is_mut
            s.is_pub = is_pub
            s.expr   = expr
            return s
        }
        if self.at(.ident) and self.peek_tok(1).kind == .colon {
            name_pos := $as(u32, self.pos)
            self.pos += 2  // name :
            ty   := self.parse_type()
            self.expect(.eq) or return null
            expr := self.parse_expr() or return null
            s := alloc_stmt(self.alloc, .let_stmt, start, expr.end) or return null
            s.name   = name_pos
            s.is_mut = is_mut
            s.is_pub = is_pub
            s.ty     = ty
            s.expr   = expr
            return s
        }
        expr := self.parse_expr() or return null
        s := alloc_stmt(self.alloc, .expr_stmt, start, expr.end) or return null
        s.expr = expr
        return s
    },
    parse_if := (self: *Parser) ?*Expr {
        start := self.cur().start
        self.expect(.kw_if) or return null

        // Safe unwrap: if expr: |binding| body
        // Regular: if expr body
        cond := self.parse_expr() or return null

        // Optional binding after colon: if optional: |v| { ... }
        if self.eat(.colon) {
            self.expect(.pipe) or return null
            mut binding: u32 = 0
            if self.at(.ident) {
                binding = $as(u32, self.pos)
                self.pos += 1
            } else {
                self.expect(.ident) or return null
            }
            self.expect(.pipe) or return null
            then_body := self.parse_body() or return null
            node := alloc_expr(self.alloc, .if_expr, start, then_body.end) or return null
            node.a   = cond
            node.b   = then_body
            node.tok = binding
            if self.eat(.kw_else) {
                else_body := self.parse_body() or return node
                node.c   = else_body
                node.end = else_body.end
            }
            return node
        }

        then_body := self.parse_body() or return null
        node := alloc_expr(self.alloc, .if_expr, start, then_body.end) or return null
        node.a = cond
        node.b = then_body
        if self.eat(.kw_else) {
            else_body := self.parse_body() or return node
            node.c   = else_body
            node.end = else_body.end
        }
        return node
    },
    parse_match := (self: *Parser) ?*Expr {
        start := self.cur().start
        self.expect(.kw_match) or return null
        subject := self.parse_expr() or return null
        self.expect(.lbrace) or return null
        // TODO: parse match arms into MatchArm list
        self.skip_balanced_braces_inner()
        end_tok := self.expect(.rbrace) or return null
        node := alloc_expr(self.alloc, .match_expr, start, end_tok.start + end_tok.len) or return null
        node.a = subject
        return node
    },
    parse_for := (self: *Parser) ?*Expr {
        start := self.cur().start
        self.expect(.kw_for) or return null
        if self.at(.lbrace) {
            body := self.parse_block() or return null
            node := alloc_expr(self.alloc, .for_inf, start, body.end) or return null
            node.a = body
            return node
        }
        expr := self.parse_expr() or return null
        if expr.tag == .range_excl or expr.tag == .range_incl {
            inclusive := expr.tag == .range_incl
            self.expect(.colon) or return null
            mut binding: u32 = 0
            if self.at(.pipe) {
                self.pos += 1
                if self.at(.ident) {
                    binding = $as(u32, self.pos)
                    self.pos += 1
                }
                self.expect(.pipe) or return null
            }
            body := self.parse_body() or return null
            node := alloc_expr(self.alloc, .for_range, start, body.end) or return null
            node.a    = expr.a   // lo
            node.b    = expr.b   // hi
            node.c    = body
            node.tok  = binding
            node.flag = inclusive
            return node
        }
        self.expect(.colon) or return null
        mut binding: u32 = 0
        if self.at(.pipe) {
            self.pos += 1
            if self.at(.ident) {
                binding = $as(u32, self.pos)
                self.pos += 1
            }
            self.expect(.pipe) or return null
        }
        body := self.parse_body() or return null

        if binding != 0 {
            node := alloc_expr(self.alloc, .for_each, start, body.end) or return null
            node.a   = expr
            node.b   = body
            node.tok = binding
            return node
        }
        node := alloc_expr(self.alloc, .for_while, start, body.end) or return null
        node.a = expr
        node.b = body
        return node
    },
    parse_body := (self: *Parser) ?*Expr {
        if self.at(.lbrace) return self.parse_block()
        return self.parse_expr()
    },
    parse_array_lit := (self: *Parser) ?*Expr {
        start := self.cur().start
        self.expect(.lbracket) or return null
        mut items := Vec(*Expr).init(self.alloc)
        for {
            if self.at(.rbracket) break
            if self.at(.eof) break
            e := self.parse_expr() or break
            items.push(e)
            if !self.eat(.comma) break
        }
        end_tok := self.expect(.rbracket) or return null
        node := alloc_expr(self.alloc, .array_lit, start, end_tok.start + end_tok.len) or return null
        if items.len > 0 {
            buf := self.alloc.create_many(*Expr, items.len) or return node
            mut i: usize = 0
            for i < items.len: {
                elem := items.get(i) or break
                buf[i] = elem.*
                i += 1
            }
            node.list     = $as(*any, buf.ptr)
            node.list_len = $as(u32, items.len)
        }
        items.deinit()
        return node
    },
    at_stmt_end := (self: Parser) bool {
        k := self.cur().kind
        return k == .rbrace
            or k == .eof
            or k == .comma
            or k == .rparen
            or k == .rbracket
    },
    recover_to_next_item := (self: *Parser) {
        for {
            k := self.cur().kind
            if k == .eof return
            if k == .kw_pub return
            if k == .kw_module return
            if k == .doc_comment return
            // Also stop if we see an identifier followed by :=
            if k == .ident and self.peek_tok(1).kind == .colon_eq return
            self.pos += 1
        }
    },
    skip_balanced_braces := (self: *Parser) {
        self.expect(.lbrace) or return
        self.skip_balanced_braces_inner()
        self.expect(.rbrace) or return
    },
    skip_balanced_braces_inner := (self: *Parser) {
        mut depth := 1
        for depth > 0: {
            k := self.cur().kind
            if k == .eof return
            if k == .lbrace depth += 1
            if k == .rbrace {
                depth -= 1
                if depth == 0 return
            }
            self.pos += 1
        }
    }
}

/// Infix binding power for precedence climbing.
/// Returns 0 if the token is not a binary operator.
infix_binding_power := (kind: TokenKind) u8 => match kind {
    .kw_or:      2,
    .kw_and:     4,
    .amp_amp:    4,   // && has same precedence as 'and'
    .eq_eq:      6,
    .bang_eq:    6,
    .lt:         8,
    .lt_eq:      8,
    .gt:         8,
    .gt_eq:      8,
    .dot_dot:    10,
    .dot_dot_eq: 10,
    .pipe:       12,
    .caret:      14,
    .amp:        16,
    .lt_lt:      18,
    .gt_gt:      18,
    .plus:       20,
    .minus:      20,
    .star:       22,
    .slash:      22,
    .percent:    22,
    // Assignment operators — right-associative, lowest precedence
    .eq:         1,
    .plus_eq:    1,
    .minus_eq:   1,
    .star_eq:    1,
    .slash_eq:   1,
    .percent_eq: 1,
    .amp_eq:     1,
    .pipe_eq:    1,
    .caret_eq:   1,
    .lt_lt_eq:   1,
    .gt_gt_eq:   1,
    _:           0,
}

/// Binding power for prefix operators.
prefix_bp := () u8 => 30

/// Map a binary/assignment operator token to its ExprTag.
bin_op_tag := (kind: TokenKind) ExprTag => match kind {
    .plus:       .add,
    .minus:      .sub,
    .star:       .mul,
    .slash:      .div,
    .percent:    .mod_,
    .amp:        .bit_and,
    .pipe:       .bit_or,
    .caret:      .bit_xor,
    .lt_lt:      .shl,
    .gt_gt:      .shr,
    .eq_eq:      .eq_,
    .bang_eq:    .neq,
    .lt:         .lt_,
    .lt_eq:      .lte,
    .gt:         .gt_,
    .gt_eq:      .gte,
    .kw_and:     .logic_and,
    .amp_amp:    .logic_and,
    .kw_or:      .logic_or,
    .eq:         .assign,
    .plus_eq:    .assign_add,
    .minus_eq:   .assign_sub,
    .star_eq:    .assign_mul,
    .slash_eq:   .assign_div,
    .percent_eq: .assign_mod,
    .amp_eq:     .assign_and,
    .pipe_eq:    .assign_or,
    .caret_eq:   .assign_xor,
    .lt_lt_eq:   .assign_shl,
    .gt_gt_eq:   .assign_shr,
    _:           .add,   // should not be reached
}
