module parser

ast := use "ast"
diagnostics := use "diagnostics"
lexer := use "lexer"

pub ParseOutput := struct {
  ast: ?ast.AstFile,
  diagnostics: Vec(diagnostics.Diagnostic)
}

pub Parser := struct {
  allocator: Allocator,
  tokens: []lexer.Token,
  index: usize,
  diagnostics: Vec(diagnostics.Diagnostic),
  file_path: []u8,
}

Parser.new := (alloc: Allocator, file_path: []u8, tokens: []Token) Parser => .{
  allocator: Allocator,
  tokens: tokens,
  index: 0,
  diagnostics: Vec(diagnostics.Diagnostic).init(alloc),
  file_path: file_path
}

Parser.parse_file := (self: *mut Parser) ParseOutput {
  module_decl := self.parse_module_decl()
  mut items := Vec(ast.Item).init(self.allocator)
  for !self.is_eof() {
    if self.peek_kind(.Eof) break
  }
}
