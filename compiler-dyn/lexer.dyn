module lexer

Vec := (use "std/collections").Vec
str := (use "std/str")
Allocator := (use "std/mem").Allocator
diagnostics := use "diagnostics"
SourceSpan := diagnostics.SourceSpan
Diagnostic := diagnostics.Diagnostic
cursor := use "cursor"

pub LexOutput := struct { tokens: Vec(Token), diagnostics: Vec(Diagnostic) }

pub Lexer := struct { cursor: cursor.Cursor, source: []u8, file_path: []u8, diagnostics: Vec(Diagnostic), tokens: Vec(Token) }
pub Lexer.init := (allocator: Allocator, source: []u8, file_path: []u8) Lexer => .{ cursor: cursor.Cursor.init(source), source, file_path, diagnostics: Vec(Diagnostic).init(allocator), tokens: Vec(Token).init(allocator) }
pub Lexer.lex := (self: *mut Lexer) LexOutput! {
  loop: for {
    self.skip_whitespace()
    if self.cursor.is_eof() break :loop
    if self.lex_comment_or_doc_comment() continue :loop
    start := self.cursor.position()
    ch := self.cursor.peek() or break :loop
    if (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || ch == '_' {
      self.lex_identifier(start).!
      continue :loop
    }
    if ch == '$' {
      self.lex_builtin_identifier(start).!
      continue :loop
    }
    if ch >= '0' && ch <= '9' {
      self.lex_number(start).!
      continue :loop
    }
    if ch == '"' {
      self.lex_string_literal(start).!
      continue :loop
    }
    if ch == '\'' {
      self.lex_char_literal(start).!
      continue :loop
    }
    if self.lex_operator_or_delimiter(start).! continue :loop
    self.emit_unexpected_character(start).!
    _ = self.cursor.bump()
  }
  eof_pos := self.cursor.position()
  self.tokens.append(.{ kind: .Eof, lexeme: "", span: self.cursor.span_from(eof_pos), }).!
  return .{ tokens: self.tokens, diagnostics: self.diagnostics }
}
Lexer.skip_whitespace := (self: *mut Lexer) {
  for self.cursor.peek(): |ch| {
    if !str.is_whitespace(ch) break
    _ = self.cursor.bump()
  }
  return
}
Lexer.lex_comment_or_doc_comment := (self: *mut Lexer) u1 {
  first := self.cursor.peek() or return false
  if first != '/' return false

  second := self.cursor.peek_next() or return false
  if second == '/' {
    start := self.cursor.position()
    _ = self.cursor.bump_many(2)

    mut is_doc := false
    if self.cursor.peek(): |third| {
      if third == '/' {
        is_doc = true
        _ = self.cursor.bump()
      }
    }
    for self.cursor.peek(): |ch| {
      if ch == '\n' break
      _ = self.cursor.bump()
    }
    if is_doc {
      span := self.cursor.span_from(start)
      lexeme := self.source[span.start_byte..span.end_byte]
      self.tokens.append(.{ kind: .DocComment, lexeme, span }).!
    }
    return true
  }

  if second == '*' {
    start := self.cursor.position()
    _ = self.cursor.bump_many(2)

    mut closed := false
    for self.cursor.bump(): |ch| {
      if ch == '*' {
        if self.cursor.peek(): |next| {
          if next == '/' {
            _ = self.cursor.bump()
            closed = true
            break
          }
        }
      }
    }
    if !closed {
      span := self.cursor.span_from(start)
      diag := Diagnostic.error(.Lexer, .E2004, "unterminated block comment")
      self.diagnostics.append(diag.with_primary_file_label(self.file_path, span, "block comment starts here")).!
    }
    return true
  }

  return false
}
Lexer.lex_identifier := (self: *mut Lexer, start: cursor.CursorPosition) ! {
  _ = self.cursor.bump()
  for {
    ch := self.cursor.peek() or break
    if !is_identifier_continue(ch) break
    _ = self.cursor.bump()
  }
  span := self.cursor.span_from(start)
  lexeme := self.source[span.start_byte..span.end_byte]
  self.tokens.append(.{ kind: keyword_from_identifier(lexeme), lexeme, span }).!
  return
}

Lexer.lex_builtin_identifier := (self: *mut Lexer, start: cursor.CursorPosition) ! {
  _ = self.cursor.bump()
  if self.cursor.peek(): |ch| {
    if is_identifier_start(ch) {
      _ = self.cursor.bump()
      for {
        next := self.cursor.peek() or break
        if !is_identifier_continue(next) break
        _ = self.cursor.bump()
      }
    } else {
      span := self.cursor.span_from(start)
      diag := Diagnostic.error(.Lexer, .E2006, "invalid builtin identifier")
      self.diagnostics.append(diag.with_primary_file_label(self.file_path, span, "expected identifier after $")).!
    }
  } else {
    span := self.cursor.span_from(start)
    diag := Diagnostic.error(.Lexer, .E2006, "invalid builtin identifier")
    self.diagnostics.append(diag.with_primary_file_label(self.file_path, span, "expected identifier after $")).!
  }
  span := self.cursor.span_from(start)
  lexeme := self.source[span.start_byte..span.end_byte]
  self.tokens.append(.{ kind: .BuiltinIdentifier, lexeme, span }).!
  return
}

Lexer.lex_string_literal := (self: *mut Lexer, start: cursor.CursorPosition) ! {
  _ = self.cursor.bump()
  mut terminated := false

  for {
    ch := self.cursor.peek() or break
    _ = self.cursor.bump()

    if ch == '"' {
      terminated = true
      break
    }

    if ch == '\n' break

    if ch == '\\' {
      if self.cursor.peek(): |escape| {
        if escape == 'x' {
          _ = self.cursor.bump()
          self.consume_hex_digits(2)
        } else _ = self.cursor.bump()
      }
    }
  }
  span := self.cursor.span_from(start)
  lexeme := self.source[span.start_byte..span.end_byte]
  if !terminated {
    diag := Diagnostic.error(.Lexer, .E2002, "unterminated string literal")
    self.diagnostics.append(diag.with_primary_file_label(self.file_path, span, "string literal starts here")).!
  }
  self.tokens.append(.{ kind: .StringLiteral, lexeme, span }).!
  return
}

Lexer.lex_char_literal := (self: *mut Lexer, start: cursor.CursorPosition) ! {
  _ = self.cursor.bump()
  mut valid := true
  mut terminated := false

  if self.cursor.peek(): |ch| {
    if ch == '\\' {
      _ = self.cursor.bump()
      if self.cursor.peek(): |escape| {
        if escape == 'x' {
          _ = self.cursor.bump()
          self.consume_hex_digits(2)
        } else {
          _ = self.cursor.bump()
        }
      } else {
        valid = false
      }
    } else if ch == '\'' || ch == '\n' {
      valid = false
    } else {
      _ = self.cursor.bump()
    }
  } else {
    valid = false
  }

  if self.cursor.peek(): |end| {
    if end == '\'' {
      _ = self.cursor.bump()
      terminated = true
    }
  }

  if !terminated valid = false

  span := self.cursor.span_from(start)
  lexeme := self.source[span.start_byte..span.end_byte]
  if !valid {
    diag := Diagnostic.error(.Lexer, .E2003, "invalid char literal")
    self.diagnostics.append(diag.with_primary_file_label(self.file_path, span, "char literal must contain one character")).!
  }
  self.tokens.append(.{ kind: .CharLiteral, lexeme, span }).!
  return
}

Lexer.lex_number := (self: *mut Lexer, start: cursor.CursorPosition) ! {
  mut is_float := false
  _ = self.cursor.bump()

  if self.source[start.byte] == '0' {
    if self.cursor.peek(): |prefix| {
      if prefix == 'x' || prefix == 'X' {
        _ = self.cursor.bump()
        self.consume_hex_or_underscore()
        span := self.cursor.span_from(start)
        lexeme := self.source[span.start_byte..span.end_byte]
        self.tokens.append(.{ kind: .IntLiteral, lexeme, span }).!
        return
      }
      if prefix == 'b' || prefix == 'B' {
        _ = self.cursor.bump()
        self.consume_binary_or_underscore()
        span := self.cursor.span_from(start)
        lexeme := self.source[span.start_byte..span.end_byte]
        self.tokens.append(.{ kind: .IntLiteral, lexeme, span }).!
        return
      }
      if prefix == 'o' || prefix == 'O' {
        _ = self.cursor.bump()
        self.consume_octal_or_underscore()
        span := self.cursor.span_from(start)
        lexeme := self.source[span.start_byte..span.end_byte]
        self.tokens.append(.{ kind: .IntLiteral, lexeme, span }).!
        return
      }
    }
  }

  self.consume_decimal_or_underscore()

  if self.cursor.peek(): |dot| if dot == '.' if self.cursor.peek_next(): |next| if is_ascii_digit(next) {
    is_float = true
    _ = self.cursor.bump()
    self.consume_decimal_or_underscore()
  }
  if self.cursor.peek(): |exp| if exp == 'e' || exp == 'E' {
    is_float = true
    _ = self.cursor.bump()
    if self.cursor.peek(): |sign| if sign == '+' || sign == '-' _ = self.cursor.bump()
    self.consume_decimal_or_underscore()
  }
  span := self.cursor.span_from(start)
  lexeme := self.source[span.start_byte..span.end_byte]
  self.tokens.append(.{ kind: if is_float .FloatLiteral else .IntLiteral, lexeme, span }).!
  return
}

Lexer.consume_decimal_or_underscore := (self: *mut Lexer) {
  for {
    ch := self.cursor.peek() or break
    if is_ascii_digit(ch) {
      _ = self.cursor.bump()
      continue
    }
    if ch == '_' {
      _ = self.cursor.bump()
      continue
    }
    break
  }
  return
}

Lexer.consume_binary_or_underscore := (self: *mut Lexer) {
  for {
    ch := self.cursor.peek() or break
    if ch == '0' || ch == '1' {
      _ = self.cursor.bump()
      continue
    }
    if ch == '_' {
      _ = self.cursor.bump()
      continue
    }
    break
  }
  return
}

Lexer.consume_octal_or_underscore := (self: *mut Lexer) {
  for {
    ch := self.cursor.peek() or break
    if ch >= '0' && ch <= '7' {
      _ = self.cursor.bump()
      continue
    }
    if ch == '_' {
      _ = self.cursor.bump()
      continue
    }
    break
  }
  return
}

Lexer.consume_hex_or_underscore := (self: *mut Lexer) {
  for {
    ch := self.cursor.peek() or break
    if is_ascii_hexdigit(ch) {
      _ = self.cursor.bump()
      continue
    }
    if ch == '_' {
      _ = self.cursor.bump()
      continue
    }
    break
  }
  return
}

Lexer.consume_hex_digits := (self: *mut Lexer, max: usize) {
  mut count: usize = 0
  for count < max: {
    ch := self.cursor.peek() or break
    if !is_ascii_hexdigit(ch) break
    _ = self.cursor.bump()
    count += 1
  }
  return
}

Lexer.lex_operator_or_delimiter := (self: *mut Lexer, start: cursor.CursorPosition) u1! {
  ch := self.cursor.bump() or return false
  mut kind: TokenKind = .Eof
  if ch == '(' kind = .LParen
  else if ch == ')' kind = .RParen
  else if ch == '{' kind = .LBrace
  else if ch == '}' kind = .RBrace
  else if ch == '[' kind = .LBracket
  else if ch == ']' kind = .RBracket
  else if ch == ',' kind = .Comma
  else if ch == ';' kind = .Semicolon
  else if ch == ':' kind = .Colon
  else if ch == '=' {
    if self.cursor.match_char('>') kind = .FatArrow
    else if self.cursor.match_char('=') kind = .EqualEqual
    else kind = .Equal
  } else if ch == '+' {
    if self.cursor.match_char('=') kind = .PlusEqual
    else kind = .Plus
  } else if ch == '-' {
    if self.cursor.match_char('=') kind = .MinusEqual
    else kind = .Minus
  } else if ch == '*' {
    if self.cursor.match_char('=') kind = .StarEqual
    else kind = .Star
  } else if ch == '/' {
    if self.cursor.match_char('=') kind = .SlashEqual
    else kind = .Slash
  } else if ch == '%' {
    if self.cursor.match_char('=') kind = .PercentEqual
    else kind = .Percent
  } else if ch == '.' {
    if self.cursor.match_char('.') {
      if self.cursor.match_char('=') kind = .DotDotEq
      else kind = .DotDot
    } else if self.cursor.match_char('*') kind = .DotStar
    else if self.cursor.match_char('!') kind = .DotBang
    else if self.cursor.match_char('?') kind = .DotQuestion
    else kind = .Dot
  } else if ch == '<' {
    if self.cursor.match_char('<') {
      if self.cursor.match_char('=') kind = .LeftShiftEqual
      else kind = .LeftShift
    } else if self.cursor.match_char('=') kind = .LessEqual
    else kind = .Less
  } else if ch == '>' {
    if self.cursor.match_char('>') {
      if self.cursor.match_char('=') kind = .RightShiftEqual
      else kind = .RightShift
    } else if self.cursor.match_char('=') kind = .GreaterEqual
    else kind = .Greater
  } else if ch == '!' {
    if self.cursor.match_char('=') kind = .BangEqual
    else kind = .Bang
  } else if ch == '&' {
    if self.cursor.match_char('&') kind = .AndAnd
    else if self.cursor.match_char('=') kind = .AmpersandEqual
    else kind = .Ampersand
  } else if ch == '|' {
    if self.cursor.match_char('|') kind = .OrOr
    else if self.cursor.match_char('=') kind = .PipeEqual
    else kind = .Pipe
  } else if ch == '^' {
    if self.cursor.match_char('=') kind = .CaretEqual
    else kind = .Caret
  } else if ch == '~' kind = .Tilde
  else if ch == '?' kind = .Question
  else return false
  span := self.cursor.span_from(start)
  lexeme := self.source[span.start_byte..span.end_byte]
  self.tokens.append(.{ kind: kind, lexeme: lexeme, span: span }).!
  return true
}

Lexer.emit_unexpected_character := (self: *mut Lexer, start: cursor.CursorPosition) ! {
  span := self.cursor.span_from(start)
  diag := Diagnostic.error(.Lexer, .E2001, "unexpected character")
  self.diagnostics.append(diag.with_primary_file_label(self.file_path, span, "remove or replace this character")).!
  return
}

is_identifier_start := (ch: u8) u1 => (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || ch == '_'
is_identifier_continue := (ch: u8) u1 => is_identifier_start(ch) || (ch >= '0' && ch <= '9')
is_ascii_digit := (ch: u8) u1 => ch >= '0' && ch <= '9'
is_ascii_hexdigit := (ch: u8) u1 => (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F')

keyword_from_identifier := (identifier: []u8) TokenKind {
  if str.eq(identifier, "if") return .KwIf
  if str.eq(identifier, "or") return .KwOr
  if str.eq(identifier, "pub") return .KwPub
  if str.eq(identifier, "mut") return .KwMut
  if str.eq(identifier, "use") return .KwUse
  if str.eq(identifier, "for") return .KwFor
  if str.eq(identifier, "else") return .KwElse
  if str.eq(identifier, "enum") return .KwEnum
  if str.eq(identifier, "type") return .KwType
  if str.eq(identifier, "comp") return .KwComp
  if str.eq(identifier, "true") return .TrueLiteral
  if str.eq(identifier, "null") return .NullLiteral
  if str.eq(identifier, "false") return .FalseLiteral
  if str.eq(identifier, "match") return .KwMatch
  if str.eq(identifier, "break") return .KwBreak
  if str.eq(identifier, "defer") return .KwDefer
  if str.eq(identifier, "module") return .KwModule
  if str.eq(identifier, "extern") return .KwExtern
  if str.eq(identifier, "packed") return .KwPacked
  if str.eq(identifier, "struct") return .KwStruct
  if str.eq(identifier, "return") return .KwReturn
  if str.eq(identifier, "inline") return .KwInline
  if str.eq(identifier, "continue") return .KwContinue
  return .Identifier
}

pub Token := struct { kind: TokenKind, lexeme: []u8, span: SourceSpan }

pub TokenKind := enum {
  Identifier,
  BuiltinIdentifier,
  IntLiteral,
  FloatLiteral,
  StringLiteral,
  CharLiteral,
  TrueLiteral,
  FalseLiteral,
  NullLiteral,
  DocComment,
  KwModule,
  KwExtern,
  KwPacked,
  KwStruct,
  KwEnum,
  KwType,
  KwComp,
  KwPub,
  KwMut,
  KwUse,
  KwIf,
  KwElse,
  KwFor,
  KwMatch,
  KwReturn,
  KwBreak,
  KwContinue,
  KwDefer,
  KwInline,
  KwOr,
  LParen,
  RParen,
  LBrace,
  RBrace,
  LBracket,
  RBracket,
  Comma,
  Semicolon,
  Colon,
  Equal,
  EqualEqual,
  FatArrow,
  Plus,
  PlusEqual,
  Minus,
  MinusEqual,
  Star,
  StarEqual,
  Slash,
  SlashEqual,
  Percent,
  PercentEqual,
  Dot,
  DotDot,
  DotDotEqual,
  DotStar,
  DotQuestion,
  DotBang,
  Less,
  LessEqual,
  LeftShift,
  LeftShiftEqual,
  Greater,
  GreaterEqual,
  RightShift,
  RightShiftEqual,
  Bang,
  BangEqual,
  Ampersand,
  AmpersandEqual,
  AndAnd,
  Pipe,
  PipeEqual,
  OrOr,
  Caret,
  CaretEqual,
  Tilde,
  Question,
  Eof,
}
