struct Point { x, y: i32, }
packed struct Packed { byte: u8, word: u32, }

fn main() {
  point := Point{ x: 1, y: 2 }
  values: [3]i32 = [1, 2, 3]
  if #sizeof(Point) != 8 || #alignof(Point) != 4 { for {} }
  if #sizeof(Packed) != 5 || #alignof(Packed) != 1 { for {} }
  if #sizeof(values) != 12 || #alignof(values) != 4 { for {} }
  if #sizeof(point) != 8 { for {} }
  wide: i64 = 300
  byte := #cast(u8) wide
  fraction: f64 = 42.75
  whole := #cast(i32) fraction
  bits: u32 = 1065353216
  one := #bitcast(f32) bits
  back := #bitcast(u32) one
  raw: rawptr = nil
  typed := #cast(*Point) raw
  pid := #syscall(39)
  if byte != 44 || whole != 42 || one != 1.0 || back != bits || typed != nil || pid <= 0 { for {} }
}
