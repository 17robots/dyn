// vendor/sqlite helpers: the statement cache, run, first, query/next, the
// column readers, constraint, open_schema and transaction.
use "std/fail"
use "std/io"
use "std/mem"
use "std/process"
use "vendor/sqlite"

const Schema: [2][]const u8 = ["PRAGMA journal_mode=WAL", "CREATE TABLE IF NOT EXISTS item(id INTEGER PRIMARY KEY, name TEXT UNIQUE)"]

struct Row { statement: *sqlite.Statement, name: []const u8, stored: bool }

// Each row has its own status: one duplicate does not stop the others.
fn store(row: *Row) {
  status: fail.Status
  sqlite.run(&status, row.statement, row.name)
  row.stored = !status.failed
}

fn close(database: sqlite.Database) {
  closing: fail.Status
  sqlite.close(&closing, database)
}

fn main() {
  arena := mem.arena_alloc(mem.MiB)
  defer mem.arena_release(arena)
  buffer: [256]u8
  status := fail.Status{ on_failure: fail.panic_on_failure }
  database := sqlite.open(&status, ":memory:", buffer[..])
  defer close(database)
  sqlite.execute(&status, database, "CREATE TABLE user(id INTEGER PRIMARY KEY, name TEXT UNIQUE, score INTEGER)", buffer[..])
  statements := sqlite.cache(database)
  defer sqlite.cache_close(&statements)
  insert := "INSERT INTO user(name, score) VALUES(?1, ?2)"
  for i in 0..5 {
    names: [5][]const u8 = ["ada", "bob", "cy", "di", "ed"]
    sqlite.run(&status, sqlite.cached(&status, &statements, insert), names[i], i * 10)
  }
  again := sqlite.cached(&status, &statements, insert)
  io.println("cached once {}", again == sqlite.cached(&status, &statements, "INSERT INTO user(name, score) VALUES(?1, ?2)"))
  duplicate: fail.Status
  sqlite.run(&duplicate, again, "bob", 1)
  io.println("duplicate {} constraint {}", !duplicate.failed, sqlite.constraint(&duplicate.failure))
  lookup := sqlite.cached(&status, &statements, "SELECT id, name, score FROM user WHERE name = ?1")
  if sqlite.first(&status, lookup, "cy") {
    id := sqlite.integer(lookup, 0)
    // Copied text outlives the row.
    name := sqlite.text(arena, lookup, 1)
    sqlite.done(lookup)
    io.println("first {} {} {}", id, name, name.len)
  }
  io.println("missing {}", sqlite.first(&status, lookup, "zed"))
  sqlite.done(lookup)
  list := sqlite.cached(&status, &statements, "SELECT name, score FROM user WHERE score >= ?1 ORDER BY score")
  total: i64 = 0
  sqlite.query(&status, list, 20)
  for sqlite.next(&status, list) {
    io.println("row {} {}", sqlite.bytes(list, 0), sqlite.integer(list, 1))
    total += sqlite.integer(list, 1)
  }
  sqlite.done(list)
  bad: fail.Status
  io.println("total {} bad sql {}", total, sqlite.cached(&bad, &statements, "SELEKT 1") == nil)
  // open_schema: a ready connection; transaction: rows in one commit.
  path := process.environment_or(arena, "SQLITE_HELPERS_DB", "")
  ready := sqlite.open_schema(&status, path, Schema[..])
  items := sqlite.cache(ready)
  add := sqlite.cached(&status, &items, "INSERT INTO item(name) VALUES(?1)")
  rows: [3]Row = [Row{ statement: add, name: "a" }, Row{ statement: add, name: "b" }, Row{ statement: add, name: "a" }]
  committing: fail.Status
  sqlite.transaction(&committing, ready, rows[..], store)
  count := sqlite.cached(&status, &items, "SELECT count(*) FROM item")
  _ = sqlite.first(&status, count)
  io.println("transaction {} stored {} {} {} rows {}", !committing.failed, rows[0].stored, rows[1].stored, rows[2].stored, sqlite.integer(count, 0))
  sqlite.done(count)
  sqlite.cache_close(&items)
  sqlite.close(&status, ready)
  broken: [1][]const u8 = ["CREATE TABL item(id)"]
  schema: fail.Status
  _ = sqlite.open_schema(&schema, path, broken[..])
  io.println("bad schema {}", schema.failed)
}
