use "std/container/slot_map" slot_map
use "std/text/scanner" scanner
use "std/unicode/utf16" utf16

fn equal(left: []const u8, right: []const u8) bool {
  if #len(left) != #len(right) { return false }
  i: usize = 0
  for i < #len(left) { if left[i] != right[i] { return false } i += 1 }
  return true
}

fn main() {
  data: [16]u8 = []
  generations: [4]u32 = []
  occupied: [1]u64 = []
  slots := slot_map.init(data[..], generations[..], occupied[..], 4)
  source: [4]u8 = [1, 2, 3, 4]
  handle := slot_map.insert(&slots, source[..])
  value := slot_map.get(&slots, handle)
  if !value.ok || value.data[2] != 3 { #panic("slot map insert") }
  if !slot_map.remove(&slots, handle) || slot_map.get(&slots, handle).ok {
    #panic("slot map stale handle")
  }

  state := scanner.scanner("one two\nthree")
  field: []const u8 = ""
  if !scanner.next_field(&state, &field) || !equal(field, "one") { #panic("scanner field") }
  line: []const u8 = ""
  if !scanner.next_line(&state, &line) || !equal(line, " two") { #panic("scanner line") }

  encoded: [2]u16 = []
  width := utf16.encode(encoded[..], 128512)
  decoded := utf16.decode(encoded[..width], 0)
  if width != 2 || !decoded.ok || decoded.codepoint != 128512 { #panic("UTF-16") }
}
