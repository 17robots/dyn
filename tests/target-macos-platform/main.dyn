use "std/mem" mem
use "std/fail"
use "std/os/macos" platform

#target(arch: aarch64, kernel: darwin, abi: aapcs)

fn main() {
  arena := mem.arena_alloc(4096)
  memory := mem.push_bytes(arena, 4096)
  memory[0] = 42
  mem.arena_release(arena)
  status: fail.Status
  descriptor := platform.file_open(&status, "/dev/null", false, false)
  if !status.failed {
    platform.file_close(&status, descriptor)
  }
  opening: fail.Status
  socket := platform.socket_open(&opening, 2, 1, 6)
  if !opening.failed { _ = platform.socket_close(#cast(usize, socket)) }
  events: [1]platform.PollDescriptor
  _ = platform.event_poll(events[..0], 0)
}
