use "std/io" stream
use "std/bufio" buffered

fn equal(left: []const u8, right: []const u8) bool {
  if #len(left) != #len(right) { return false }
  i: usize = 0
  for i < #len(left) {
    if left[i] != right[i] { return false }
    i += 1
  }
  return true
}

fn main() {
  storage: [3]u8 = []
  output_storage: [32]u8 = []
  output := stream.buffer_writer(output_storage[..])
  writer := buffered.writer(stream.buffer_writer_adapter(&output), storage[..])
  result := stream.write_all(buffered.writer_adapter(&writer), "buffered output")
  if result.status != stream.Status.Complete ||
    buffered.writer_flush(&writer).status != stream.Status.Complete ||
    !equal(stream.buffer_writer_bytes(&output), "buffered output") {
    #panic("buffered writer")
  }

  input := stream.cursor("buffered input")
  input_storage: [2]u8 = []
  reader := buffered.reader(stream.cursor_reader(&input), input_storage[..])
  decoded: [14]u8 = []
  read := stream.read_exact(buffered.reader_adapter(&reader), decoded[..])
  if read.status != stream.Status.Complete || !equal(decoded[..], "buffered input") {
    #panic("buffered reader")
  }
}
