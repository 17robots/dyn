use "std/mem"
use "std/bytes"
use "std/bytes/builder"
use "std/container/string_map" maps
use "std/fmt"

fn main() {
  fixed: [4]u8 = []
  text := builder.from_buffer(fixed[..])
  if builder.append(&text, "ab") != builder.ErrorKind.None { #panic("builder append") }
  if builder.append(&text, builder.bytes(&text)) != builder.ErrorKind.None || !bytes.equal(builder.bytes(&text), "abab") { #panic("builder self append") }
  if builder.append(&text, "x") != builder.ErrorKind.Capacity || text.length != 4 { #panic("bounded builder capacity") }
  backing: [65536]u8 = [] arena := mem.arena_from_buffer(backing[..])
  if builder.append_grow(&text, &arena, builder.bytes(&text)) != builder.ErrorKind.None || !bytes.equal(builder.bytes(&text), "abababab") { #panic("growing self append") }
  mark := mem.arena_mark(&arena)
  if builder.reserve(&text, &arena, 100000) != builder.ErrorKind.Capacity || mem.arena_mark(&arena) != mark || text.length != 8 { #panic("failed reserve transaction") }
  builder.clear(&text)
  if #len(builder.bytes(&text)) != 0 { #panic("builder clear") }
  tiny: [3]u8 = [] small := mem.arena_from_buffer(tiny[..])
  fallback := builder.Builder{}
  if builder.append_grow(&fallback, &small, "abc") != builder.ErrorKind.None || mem.arena_used(&small) != 3 { #panic("builder exact capacity fallback") }
  if builder.append_grow(&fallback, &small, "d") != builder.ErrorKind.Capacity || !bytes.equal(builder.bytes(&fallback), "abc") { #panic("builder failed growth preserves value") }

  map := maps.Map{}
  if maps.get(&map, "absent").found || maps.remove(&map, "absent") { #panic("empty map") }
  mutable: [3]u8 = ['k', 'e', 'y']
  if maps.put(&map, &arena, mutable[..], 0) != maps.ErrorKind.None { #panic("map put") }
  mutable[0] = 'x'
  zero := maps.get(&map, "key")
  if !zero.found || zero.value != 0 { #panic("map copies keys and distinguishes zero") }
  index: usize = 0
  retained := maps.next(&map, &index).key
  buffer: [32]u8 = []
  i: usize = 0
  for i < 200 {
    key := fmt.u64_decimal(buffer[..], #cast(u64) i)
    if maps.put(&map, &arena, key, i + 1) != maps.ErrorKind.None { #panic("map growth") }
    i += 1
  }
  if !bytes.equal(retained, "key") { #panic("rehash preserves key bytes") }
  i = 0
  for i < 200 {
    lookup_key := fmt.u64_decimal(buffer[..], #cast(u64) i)
    found_first := maps.get(&map, lookup_key)
    if !found_first.found || found_first.value != i + 1 { #panic("map lookup after growth") }
    if i % 2 == 0 && !maps.remove(&map, lookup_key) { #panic("map removal") }
    i += 1
  }
  i = 0
  for i < 200 {
    reinsert_key := fmt.u64_decimal(buffer[..], #cast(u64) i)
    found_second := maps.get(&map, reinsert_key)
    if found_second.found != (i % 2 != 0) { #panic("map lookup across tombstones") }
    if maps.put(&map, &arena, reinsert_key, i + 2) != maps.ErrorKind.None { #panic("map reinsertion") }
    i += 1
  }
  if maps.put(&map, &arena, "", 42) != maps.ErrorKind.None || maps.get(&map, "").value != 42 { #panic("empty map key") }
  empty: [0]u8 = [] exhausted := mem.arena_from_buffer(empty[..])
  if maps.put(&map, &exhausted, "key", 9) != maps.ErrorKind.None || maps.get(&map, "key").value != 9 { #panic("existing key update needs no allocation") }
  before := map.length
  if maps.put(&map, &exhausted, "new", 2) != maps.ErrorKind.Capacity || map.length != before || maps.get(&map, "new").found { #panic("map insert rollback") }
  cursor: usize = 0 count: usize = 0
  for maps.next(&map, &cursor).found { count += 1 }
  if count != map.length { #panic("map iteration") }

  growth_storage: [1100]u8 = [] growth_arena := mem.arena_from_buffer(growth_storage[..])
  growth_map := maps.Map{} counter: usize = 0
  for counter < 6 {
    growth_key := fmt.u64_decimal(buffer[..], #cast(u64) counter)
    if maps.put(&growth_map, &growth_arena, growth_key, counter) != maps.ErrorKind.None { #panic("growth failure fixture") }
    counter += 1
  }
  growth_mark := mem.arena_mark(&growth_arena)
  long_key: [512]u8 = []
  if maps.put(&growth_map, &growth_arena, long_key[..], 99) != maps.ErrorKind.Capacity || mem.arena_mark(&growth_arena) != growth_mark || growth_map.length != 6 || #len(growth_map.entries) != 8 || maps.get(&growth_map, "5").value != 5 { #panic("failed rehash leaves old table intact") }

  // Room for exactly the first table, but no key: table allocation must rewind.
  table_storage: [512]u8 = []
  failed_arena := mem.arena_from_buffer(table_storage[..])
  _ = mem.arena_push(&failed_arena, 1, 1)
  start := mem.arena_mark(&failed_arena)
  huge_key: [512]u8 = [] empty_map := maps.Map{}
  if maps.put(&empty_map, &failed_arena, huge_key[..], 1) != maps.ErrorKind.Capacity || mem.arena_mark(&failed_arena) != start || #len(empty_map.entries) != 0 || empty_map.length != 0 { #panic("map table and key allocation atomicity") }
}
