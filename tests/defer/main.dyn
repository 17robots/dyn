trace: i32

fn record(value: i32) {
  trace = trace * 10 + value
}

fn returns() i32 {
  defer record(1)
  defer record(2)
  return 7
}

fn block_observes_storage() {
  value := 3
  defer { record(value) }
  value = 4
}

fn call_captures_value() {
  value := 5
  defer record(value)
  value = 6
}

fn loop_cleanup() {
  defer record(9)
  for {
    defer record(8)
    break
  }
  if trace != 21458 {
    for {}
  }
}

fn main() {
  result := returns()
  block_observes_storage()
  call_captures_value()
  loop_cleanup()
  if result != 7 || trace != 214589 {
    for {}
  }
}
