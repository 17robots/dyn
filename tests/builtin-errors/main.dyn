struct Point { value: i32, }
fn main() {
  point := Point{ value: 1 }
  bad_cast := #cast(i32) point
  bad_bits := #bitcast(u64) 1
  bad_size := #sizeof(void)
  bad_syscall := #syscall()
  too_many := #syscall(1, 2, 3, 4, 5, 6, 7, 8)
  bad_argument := #syscall(1, 1.0)
  _ = bad_cast
  _ = bad_bits
  _ = bad_size
  _ = bad_syscall
  _ = too_many
  _ = bad_argument
  #panic(42)
}
