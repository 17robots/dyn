use "std/text/regex"
use "std/crypto/sha2"
use "std/crypto/hmac"
use "std/crypto/random" entropy_source
use "std/encoding/hex" hex_encoding
use "std/compress/deflate" compress
use "std/compress/gzip" gzip_codec

fn hex_bytes(destination: []u8, source: []const u8) []u8 {
  encoded := hex_encoding.encode(destination, source, false)
  if !encoded.ok { #panic("hex capacity") }
  return encoded.data
}

fn equal(a: []const u8, b: []const u8) bool {
  if #len(a) != #len(b) { return false }
  i: usize = 0
  for i < #len(a) { if a[i] != b[i] { return false } i += 1 }
  return true
}

fn main() {
  found := regex.find("^ab+c.?$", "abbbcZ")
  if !found.ok || found.start != 0 || found.end != 6 || regex.matches("^x", "abc") { #panic("regex") }
  escaped := regex.find("a\\.b", "xxa.by")
  if !escaped.ok || escaped.start != 2 || escaped.end != 5 { #panic("regex escape") }
  if !regex.matches("^[a-c]+[^0-9]$", "abcz") || regex.matches("^[a-c]+$", "abd") { #panic("regex class") }
  alternate := regex.find("cat|dog", "a dog and cat")
  if !alternate.ok || alternate.start != 2 || alternate.end != 5 { #panic("regex alternation") }
  matches := regex.iterator("a+", "caa ba")
  first_match := regex.next(&matches) second_match := regex.next(&matches)
  if first_match.start != 1 || first_match.end != 3 || second_match.start != 5 || second_match.end != 6 || regex.next(&matches).ok { #panic("regex iterator") }
  if !regex.matches("^ab{2,4}c$", "abbbc") || regex.matches("^ab{2,4}c$", "abc") || !regex.matches("^x{3}y$", "xxxy") { #panic("regex counted repetition") }
  regex_code: [128]regex.Instruction = [] regex_work: [256]regex.Instruction = [] regex_scratch: [256]usize = []
  compiled := regex.compile("^(ab|c(d+))$", regex_code[..], regex_work[..], regex_scratch[..])
  captures: [4]regex.Match = []
  compiled_match := regex.find_compiled(compiled, "cd", captures[..])
  if !compiled.ok || compiled.groups != 2 || !compiled_match.ok || compiled_match.end != 2 || !captures[0].ok || captures[0].start != 0 || captures[0].end != 2 || !captures[1].ok || captures[1].start != 1 || captures[1].end != 2 { #panic("compiled regex captures") }
  repeated := regex.compile("^(ab){2,3}$", regex_code[..], regex_work[..], regex_scratch[..])
  if !regex.find_compiled(repeated, "ababab", captures[..]).ok { #panic("compiled regex counted repetition") }
  zero_repeat := regex.compile("^a{0}b$", regex_code[..], regex_work[..], regex_scratch[..])
  if !zero_repeat.ok || !regex.find_compiled(zero_repeat, "b", captures[..]).ok || regex.find_compiled(zero_repeat, "ab", captures[..]).ok { #panic("compiled regex zero repetition") }
  nested := regex.compile("^((a|bc)+)(d?)$", regex_code[..], regex_work[..], regex_scratch[..])
  nested_match := regex.find_compiled(nested, "abcad", captures[..])
  if !nested.ok || nested.groups != 3 || !nested_match.ok || captures[0].start != 0 || captures[0].end != 4 || captures[1].start != 3 || captures[1].end != 4 || captures[2].start != 4 || captures[2].end != 5 { #panic("compiled regex nested captures") }
  if regex.compile("(abc", regex_code[..], regex_work[..], regex_scratch[..]).ok { #panic("compiled regex unclosed group") }
  if regex.compile("abc)", regex_code[..], regex_work[..], regex_scratch[..]).ok { #panic("compiled regex unmatched group") }
  if regex.compile("[abc", regex_code[..], regex_work[..], regex_scratch[..]).ok { #panic("compiled regex unclosed class") }
  if regex.compile("abc\\", regex_code[..], regex_work[..], regex_scratch[..]).ok { #panic("compiled regex dangling escape") }
  if regex.compile("*abc", regex_code[..], regex_work[..], regex_scratch[..]).ok { #panic("compiled regex misplaced quantifier") }
  no_code: [0]regex.Instruction = []
  no_scratch: [0]usize = []
  if regex.compile("abc", no_code[..], regex_work[..], regex_scratch[..]).error != regex.CompileError.Capacity || regex.compile("abc", regex_code[..], no_code[..], regex_scratch[..]).error != regex.CompileError.Capacity || regex.compile("abc", regex_code[..], regex_work[..], no_scratch[..]).error != regex.CompileError.Capacity { #panic("compiled regex capacity diagnostic") }
  invalid := regex.compile("(unclosed", regex_code[..], regex_work[..], regex_scratch[..])
  too_small: [1]regex.Instruction = []
  insufficient := regex.compile("abc", too_small[..], regex_work[..], regex_scratch[..])
  pathological := regex.compile("^(a|aa)*b$", regex_code[..], regex_work[..], regex_scratch[..])
  if invalid.ok || invalid.error != regex.CompileError.Syntax { #panic("compiled regex malformed") }
  if insufficient.ok || insufficient.error != regex.CompileError.Capacity { #panic("compiled regex capacity") }
  if regex.find_compiled(pathological, "aaaaaaaaaaaaaaaaaaaaaaaa", captures[..]).ok { #panic("compiled regex bounded search") }

  digest: [32]u8 = []
  hex: [64]u8 = []
  sum := sha2.sum256(digest[..], "abc")
  if !equal(hex_bytes(hex[..], sum), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") { #panic("sha256") }
  if !sha2.equal_constant_time(sum, digest[..]) { #panic("constant compare") }
  streamed: [32]u8 = []
  sha := sha2.Sha256{}
  sha2.init(&sha)
  if !sha2.update(&sha, "a") || !sha2.update(&sha, "bc") { #panic("sha256 stream update") }
  if !equal(hex_bytes(hex[..], sha2.finish(&sha, streamed[..])), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") { #panic("sha256 stream") }
  mac: [32]u8 = []
  _ = hmac.sha256(mac[..], "key", "The quick brown fox jumps over the lazy dog")
  if !equal(hex_bytes(hex[..], mac[..]), "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8") { #panic("hmac sha256") }
  empty_sum: [32]u8 = []
  empty_hex: [64]u8 = []
  if !equal(hex_bytes(empty_hex[..], sha2.sum256(empty_sum[..], "")), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") { #panic("sha256 empty") }
  entropy: [16]u8 = []
  if !entropy_source.fill(entropy[..]) { #panic("secure random") }

  compressed: [11]u8 = [203,72,205,201,201,87,200,64,144,92,0]
  gzip: [29]u8 = [31,139,8,0,0,0,0,0,2,255,203,72,205,201,201,87,200,64,144,92,0,59,124,138,223,18,0,0,0]
  plain: [32]u8 = []
  inflated := compress.inflate(plain[..], compressed[..])
  if !inflated.ok || !equal(plain[..inflated.written], "hello hello hello\n") { #panic("deflate") }
  unpacked := gzip_codec.decompress(plain[..], gzip[..])
  if !unpacked.ok || unpacked.consumed != #len(gzip) || !equal(plain[..unpacked.written], "hello hello hello\n") { #panic("gzip") }
  if gzip_codec.decompress(plain[..], gzip[..28]).ok { #panic("gzip malformed") }
  tiny: [4]u8 = []
  if compress.inflate(tiny[..], compressed[..]).ok { #panic("deflate capacity") }
  stored: [22]u8 = []
  first_block := compress.deflate_stored_chunk(stored[..], "hello ", false)
  second_block := compress.deflate_stored_chunk(stored[first_block.written..], "world", true)
  stored_plain: [11]u8 = []
  stored_result := compress.inflate(stored_plain[..], stored[..first_block.written + second_block.written])
  if !first_block.ok || !second_block.ok || !stored_result.ok || !equal(stored_plain[..], "hello world") { #panic("streaming stored deflate") }
  fixed: [64]u8 = [] hash_scratch: [4096]usize = []
  fixed_result := compress.deflate_fixed_chunk(fixed[..], "hello hello hello\n", true, hash_scratch[..])
  fixed_plain: [18]u8 = []
  fixed_inflated := compress.inflate(fixed_plain[..], fixed[..fixed_result.written])
  if !fixed_result.ok || fixed_result.written >= 23 || !fixed_inflated.ok || !equal(fixed_plain[..], "hello hello hello\n") { #panic("compressed fixed deflate") }
  dynamic_encoded: [512]u8 = []
  dynamic_encoded_result := compress.deflate_dynamic_chunk(dynamic_encoded[..], "hello hello hello\n", true, hash_scratch[..])
  dynamic_plain: [18]u8 = []
  dynamic_roundtrip := compress.inflate(dynamic_plain[..], dynamic_encoded[..dynamic_encoded_result.written])
  if !dynamic_encoded_result.ok || !dynamic_roundtrip.ok || !equal(dynamic_plain[..], "hello hello hello\n") { #panic("dynamic deflate encode") }
  invalid_dynamic: [4]u8 = [5,0,0,0]
  if compress.inflate(plain[..], invalid_dynamic[..]).ok { #panic("invalid dynamic") }

  dynamic: [54]u8 = [237,201,193,9,0,33,12,69,193,187,85,164,181,191,24,116,33,89,5,237,159,181,15,223,109,96,20,179,203,30,223,178,166,76,89,245,56,246,185,222,24,95,17,77,211,52,77,211,52,77,211,119,244,15]
  output: [3100]u8 = []
  result := compress.inflate(output[..], dynamic[..])
  phrase := "alpha beta gamma delta epsilon\n"
  if !result.ok || result.written != 3100 { #panic("dynamic") }
  i: usize = 0
  for i < 3100 { if output[i] != phrase[i % #len(phrase)] { #panic("dynamic content") } i += 1 }
  dynamic_gzip: [72]u8 = [31,139,8,0,0,0,0,0,2,255,237,201,193,9,0,33,12,69,193,187,85,164,181,191,24,116,33,89,5,237,159,181,15,223,109,96,20,179,203,30,223,178,166,76,89,245,56,246,185,222,24,95,17,77,211,52,77,211,52,77,211,119,244,15,106,60,244,108,28,12,0,0]
  gzip_result := gzip_codec.decompress(output[..], dynamic_gzip[..])
  if !gzip_result.ok || gzip_result.written != 3100 || gzip_result.consumed != #len(dynamic_gzip) { #panic("dynamic gzip") }
}
