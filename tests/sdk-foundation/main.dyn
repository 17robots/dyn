use "std/bytes" byteutil
use "std/io" stream
use "std/strings" text
use "std/unicode/utf8" unicode8
use "std/fmt" format
use "std/encoding/binary" binary_codec
use "std/hash" hashing
use "std/rand" random
use "std/math" numbers
use "std/sort" ordering
use "std/encoding/hex" hexadecimal
use "std/encoding/base64" base64_codec
use "std/semver" versions

fn main() {
  if !byteutil.equal("abc", "abc") { #panic("bytes equal") }
  if byteutil.compare("abc", "abd") >= 0 { #panic("bytes compare") }
  if byteutil.find("one two two", "two") != 4 { #panic("bytes find") }
  if byteutil.find_last("one two two", "two") != 8 { #panic("bytes find last") }
  if byteutil.count_occurrences("aaaa", "aa") != 2 { #panic("bytes count") }

  split := byteutil.splitter("a::b::", "::")
  part: []const u8 = ""
  if !byteutil.split_next(&split, &part) || !byteutil.equal(part, "a") { #panic("split first") }
  if !byteutil.split_next(&split, &part) || !byteutil.equal(part, "b") { #panic("split second") }
  if !byteutil.split_next(&split, &part) || #len(part) != 0 { #panic("split trailing") }
  if byteutil.split_next(&split, &part) { #panic("split exhausted") }

  build_storage: [8]u8 = []
  build := byteutil.builder(build_storage[..])
  if !byteutil.builder_write(&build, "abc") { #panic("builder write") }
  if !byteutil.builder_write_byte(&build, '!') { #panic("builder byte") }
  if !byteutil.equal(byteutil.builder_bytes(&build), "abc!") { #panic("builder bytes") }
  if byteutil.builder_write(&build, "overflow") { #panic("builder overflow") }
  if !build.failed { #panic("builder failure state") }
  byteutil.builder_reset(&build)
  if build.failed || build.length != 0 { #panic("builder reset") }

  input := stream.cursor("copy through tiny scratch")
  output_storage: [64]u8 = []
  output := stream.buffer_writer(output_storage[..])
  scratch: [3]u8 = []
  copied := stream.copy(
    stream.buffer_writer_adapter(&output),
    stream.cursor_reader(&input),
    scratch[..],
  )
  if copied.status != stream.Status.Complete { #panic("io copy status") }
  if copied.transferred != 25 { #panic("io copy count") }
  if !byteutil.equal(stream.buffer_writer_bytes(&output), "copy through tiny scratch") {
    #panic("io copy bytes")
  }

  exact_input := stream.cursor("short")
  exact_storage: [8]u8 = []
  exact := stream.read_exact(stream.cursor_reader(&exact_input), exact_storage[..])
  if exact.status != stream.Status.End { #panic("io exact status") }
  if exact.transferred != 5 { #panic("io exact count") }

  small_storage: [2]u8 = []
  small := stream.buffer_writer(small_storage[..])
  overflow := stream.write_all(stream.buffer_writer_adapter(&small), "long")
  if overflow.status != stream.Status.Error { #panic("io capacity status") }
  if overflow.transferred != 2 { #panic("io capacity count") }

  if !text.equal(text.trim(" \tDyn\r\n"), "Dyn") { #panic("string trim") }
  unsigned: u64 = 0
  if !text.parse_u64_base("ffffffffffffffff", 16, &unsigned) || unsigned != 18446744073709551615 {
    #panic("unsigned parse")
  }
  if text.parse_u64("18446744073709551616", &unsigned) { #panic("unsigned overflow") }
  signed: i64 = 0
  if !text.parse_i64("-9223372036854775808", &signed) || signed != -9223372036854775807 - 1 {
    #panic("signed parse")
  }
  fields := text.scanner("  one\ttwo ")
  field: []const u8 = ""
  if !text.scan_field(&fields, &field) || !text.equal(field, "one") { #panic("field one") }
  if !text.scan_field(&fields, &field) || !text.equal(field, "two") { #panic("field two") }
  if text.scan_field(&fields, &field) { #panic("field exhausted") }

  utf_storage: [4]u8 = []
  utf_width := unicode8.encode(utf_storage[..], 128512)
  if utf_width != 4 || !unicode8.valid(utf_storage[..utf_width]) { #panic("utf8 encode") }
  decoded := unicode8.decode(utf_storage[..utf_width], 0)
  if !decoded.ok || decoded.codepoint != 128512 || decoded.width != 4 { #panic("utf8 decode") }
  invalid: [2]u8 = [192, 128]
  if unicode8.valid(invalid[..]) { #panic("utf8 overlong") }
  codepoints: usize = 0
  if !unicode8.codepoint_count("A¢€", &codepoints) || codepoints != 3 { #panic("utf8 count") }

  format_storage: [64]u8 = []
  formatted := format.buffer(format_storage[..])
  if !format.write_values(&formatted, "value=", #cast(i64) -42, ", ok=", true) {
    #panic("format values")
  }
  if !text.equal(format.bytes(&formatted), "value=-42, ok=true") { #panic("format result") }
  format.clear(&formatted)
  if !format.write_quoted(&formatted, "a\n\"b") { #panic("format quote") }
  if !text.equal(format.bytes(&formatted), "\"a\\n\\\"b\"") { #panic("format quoted result") }
  tiny_storage: [3]u8 = []
  tiny := format.buffer(tiny_storage[..])
  if format.write_values(&tiny, "ab", "cd") || tiny.length != 0 { #panic("format rollback") }

  encoded: [16]u8 = []
  binary_codec.store_u64_le(encoded[..], 81985529216486895)
  if binary_codec.load_u64_le(encoded[..]) != 81985529216486895 { #panic("little endian") }
  binary_codec.store_u64_be(encoded[..], 81985529216486895)
  if binary_codec.load_u64_be(encoded[..]) != 81985529216486895 { #panic("big endian") }
  varint := binary_codec.uleb128_encode(encoded[..], 18446744073709551615)
  decoded_varint := binary_codec.uleb128_decode(varint)
  if !decoded_varint.ok || decoded_varint.value != 18446744073709551615 || decoded_varint.consumed != 10 {
    #panic("uleb128")
  }

  if hashing.crc32("123456789") != 3421780262 { #panic("crc32") }
  first_random := random.seeded(42)
  second_random := random.seeded(42)
  i: usize = 0
  for i < 32 {
    if random.next_u64(&first_random) != random.next_u64(&second_random) { #panic("random repeat") }
    i += 1
  }
  bounded: u64 = 0
  if !random.below(&first_random, 7, &bounded) || bounded >= 7 { #panic("random below") }

  if numbers.gcd_u64(54, 24) != 6 { #panic("gcd") }
  if numbers.sqrt_u64(18446744073709551615) != 4294967295 { #panic("sqrt") }
  overflow_product := numbers.checked_mul_u64(18446744073709551615, 2)
  if overflow_product.ok { #panic("checked multiply") }
  values: [6]i64 = [5, -1, 5, 0, 9, 2]
  ordering.i64s(values[..])
  expected: [6]i64 = [-1, 0, 2, 5, 5, 9]
  i = 0
  for i < #len(values) { if values[i] != expected[i] { #panic("sort") } i += 1 }
  found := ordering.search_i64(values[..], 5)
  if !found.found || found.index != 3 { #panic("binary search") }

  codec_storage: [64]u8 = []
  hex_encoded := hexadecimal.encode(codec_storage[..], "Dyn", false)
  if !hex_encoded.ok || !text.equal(hex_encoded.data, "44796e") { #panic("hex encode") }
  hex_decoded := hexadecimal.decode(codec_storage[16..], hex_encoded.data)
  if !hex_decoded.ok || !text.equal(hex_decoded.data, "Dyn") { #panic("hex decode") }
  if hexadecimal.decode(codec_storage[..], "abc").ok { #panic("hex odd input") }
  empty_hex := hexadecimal.decode(codec_storage[..], "")
  if !empty_hex.ok || #len(empty_hex.data) != 0 { #panic("hex empty") }

  base64_encoded := base64_codec.encode(codec_storage[..], "foobar")
  if !base64_encoded.ok || !text.equal(base64_encoded.data, "Zm9vYmFy") { #panic("base64 encode") }
  base64_decoded := base64_codec.decode(codec_storage[16..], base64_encoded.data)
  if !base64_decoded.ok || !text.equal(base64_decoded.data, "foobar") { #panic("base64 decode") }
  if base64_codec.decode(codec_storage[..], "Zh==").ok { #panic("base64 unused bits") }
  if base64_codec.decode(codec_storage[..], "Zg=A").ok { #panic("base64 padding") }

  release := versions.parse("1.2.3+build.7")
  prerelease := versions.parse("1.2.3-alpha.1")
  if !release.ok || !prerelease.ok { #panic("semver parse") }
  if versions.compare(prerelease.version, release.version) >= 0 { #panic("semver precedence") }
  if versions.compare(release.version, versions.parse("1.2.3+other").version) != 0 {
    #panic("semver build precedence")
  }
  if versions.parse("01.2.3").ok || versions.parse("1.2.3-alpha.01").ok ||
    versions.parse("1.2").ok || versions.parse("1.2.3+").ok {
    #panic("invalid semver")
  }
  upper := versions.parse("2.0.0")
  version_range := versions.Range{
    minimum: release.version,
    maximum: upper.version,
    has_minimum: true,
    has_maximum: true,
    include_minimum: true,
    include_maximum: false,
  }
  if !versions.contains(&version_range, release.version) || versions.contains(&version_range, upper.version) {
    #panic("semver range")
  }
}
