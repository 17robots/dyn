use "std/container/map"
use "std/mem"

struct Point { x: i32, y: i32 }

fn point_hash(key: Point) u64 {
  return #cast(u64, key.x) * 31 + #cast(u64, key.y)
}

fn point_equal(left: Point, right: Point) bool {
  return left.x == right.x && left.y == right.y
}

fn colliding_hash(key: u64) u64 {
  return key & 1
}

fn colliding_equal(left: u64, right: u64) bool {
  return left == right
}

fn check(ok: bool) {
  if !ok {
    #panic("map")
  }
}

fn main() {
  arena := mem.arena_create(0)
  ages := map.text(i32)
  check(map.find(&ages, "ada") == nil)
  check(!map.remove(&ages, "ada"))
  _ = map.put(arena, &ages, "ada", 36)
  _ = map.put(arena, &ages, "alan", 41)
  _ = map.put(arena, &ages, "ada", 37)
  check(ages.count == 2 && map.find(&ages, "ada").* == 37)
  map.find(&ages, "alan").* += 1
  check(map.find(&ages, "alan").* == 42)
  check(map.remove(&ages, "ada") && map.find(&ages, "ada") == nil && ages.count == 1)

  numbers := map.integers(u64)
  for i in 0..10000 {
    _ = map.put(arena, &numbers, #cast(u64, i), #cast(u64, i) * 3)
  }
  check(numbers.count == 10000)
  for i in 0..10000 {
    if i % 3 == 0 {
      check(map.remove(&numbers, #cast(u64, i)))
    }
  }
  for i in 0..10000 {
    found := map.find(&numbers, #cast(u64, i))
    if i % 3 == 0 {
      check(found == nil)
    } else {
      check(found != nil && found.* == #cast(u64, i) * 3)
    }
  }
  walked: usize = 0
  for slot in numbers.slots {
    if slot.code != 0 {
      walked += 1
    }
  }
  check(walked == numbers.count)

  /* Every key in two probe runs: removal must keep the rest reachable. */
  crowded := map.create(u64, i32, colliding_hash, colliding_equal)
  for i in 0..200 {
    _ = map.put(arena, &crowded, #cast(u64, i), #cast(i32, i))
  }
  for i in 0..100 {
    check(map.remove(&crowded, #cast(u64, i * 2)))
  }
  for i in 0..100 {
    check(map.find(&crowded, #cast(u64, i * 2)) == nil)
    check(map.find(&crowded, #cast(u64, i * 2 + 1)).* == #cast(i32, i * 2 + 1))
  }

  points := map.create(Point, []const u8, point_hash, point_equal)
  _ = map.put(arena, &points, Point{ x: 1, y: 2 }, "home")
  check(#len(map.find(&points, Point{ x: 1, y: 2 }).*) == 4)
  check(map.find(&points, Point{ x: 2, y: 1 }) == nil)

  unset: map.Map(u64, i32)
  check(map.find(&unset, 1) == nil)
}
