// Port of the bounded lexer in src/parser.c. Token kinds, error messages and
// work charging match the C parser byte for byte so the dumps can be compared.
use "std/bytes"
use "std/mem"

const None: u32 = 0xFFFFFFFF
const MaxDepth: u32 = 1024

enum(u8) TokenKind { End = 0, Name, Number, Text, Character, Punct, Bad }

struct Token {
  start: u32,
  end: u32,
  kind: TokenKind,
}

enum(u8) ErrorKind { Ok = 0, Syntax, Allocation, Limit }

struct Node {
  start: u32,
  end: u32,
  first: u32,
  next: u32,
  parent: u32,
  kind: u16,
  flags: u16,
}

struct Tree {
  nodes: []Node,
  count: usize,
  failed: bool,
  error: []const u8,
  error_offset: u32,
  error_kind: ErrorKind,
}

// Grows a slice with a separate count by doubling into arena, copying when the
// slice is not the arena's newest allocation, like realloc in the C parser.
// Returns the new element's index.
fn append_grow(items: *[]$T, count: *usize, arena: *mem.Arena, value: T) usize {
  if count.* == #len(items.*) {
    capacity := #len(items.*) * 2
    if capacity == 0 {
      capacity = 8
    }
    grown := mem.push_array(T, arena, capacity)
    _ = mem.copy(grown, items.*[..count.*])
    items.* = grown
  }
  items.*[count.*] = value
  count.* += 1
  return count.* - 1
}

struct Parser {
  text: []const u8,
  length: u32,
  offset: u32,
  depth: u32,
  block_brace: u32,
  scan_next: u64,
  work_remaining: *u64,
  token: Token,
  tree: *Tree,
  arena: *mem.Arena,
}

fn alpha(c: u8) bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

fn digit(c: u8) bool {
  return c >= '0' && c <= '9'
}

fn hex(c: u8) bool {
  return digit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}

fn space(c: u8) bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 0x0C || c == 0x0B
}

fn fail(p: *Parser, offset: u32, message: []const u8) {
  if p.tree.failed {
    return
  }
  p.tree.failed = true
  p.tree.error = message
  p.tree.error_offset = offset
  p.tree.error_kind = ErrorKind.Syntax
  if bytes.equal(message, "out of memory") {
    p.tree.error_kind = ErrorKind.Allocation
  } else if bytes.equal(message, "tree too large") || bytes.contains(message, "limit exceeded") {
    p.tree.error_kind = ErrorKind.Limit
  }
}

fn propagate_error(p: *Parser, from: *const Tree) {
  if !p.tree.failed && from.failed {
    p.tree.failed = true
    p.tree.error = from.error
    p.tree.error_offset = from.error_offset
    p.tree.error_kind = from.error_kind
  }
}

fn charge(p: *Parser, units: u64, offset: u32) bool {
  if p.tree.failed {
    return false
  }
  if units > p.work_remaining.* {
    p.work_remaining.* = 0
    fail(p, offset, "parse work limit exceeded")
    return false
  }
  p.work_remaining.* -= units
  return true
}

fn scan_byte(p: *Parser, offset: u32) bool {
  if offset < 1024 || #cast(u64, offset) < p.scan_next {
    return true
  }
  p.scan_next = #cast(u64, offset) + 1024
  return charge(p, 1024, offset)
}

fn at(p: *const Parser, offset: u32, s: []const u8) bool {
  if offset > p.length {
    return false
  }
  n := #len(s)
  if n > #cast(usize, p.length - offset) {
    return false
  }
  return bytes.equal(p.text[offset..#cast(usize, offset) + n], s)
}

fn token_is(p: *const Parser, s: []const u8) bool {
  return #len(s) == #cast(usize, p.token.end - p.token.start) && at(p, p.token.start, s)
}

fn byte_at(p: *const Parser, offset: u32) u8 {
  return p.text[offset]
}

fn escape(p: *Parser, i: *u32) bool {
  if i.* == p.length {
    return false
  }
  c := byte_at(p, i.*)
  i.* += 1
  if c == 'n' || c == 'r' || c == 't' || c == '0' || c == '\\' || c == '"' || c == '\'' {
    return true
  }
  if c == 'x' {
    if p.length - i.* < 2 || !hex(byte_at(p, i.*)) || !hex(byte_at(p, i.* + 1)) {
      return false
    }
    i.* += 2
    return true
  }
  if c == 'u' && i.* < p.length && byte_at(p, i.*) == '{' {
    i.* += 1
    start := i.*
    for i.* < p.length && i.* - start <= 6 && hex(byte_at(p, i.*)) {
      i.* += 1
    }
    if i.* == start || i.* - start > 6 || i.* == p.length || byte_at(p, i.*) != '}' {
      return false
    }
    i.* += 1
    return true
  }
  return false
}

// Skips identifier bytes; false means the work budget ran out.
fn skip_word(p: *Parser, i: *u32) bool {
  for i.* < p.length && (alpha(byte_at(p, i.*)) || digit(byte_at(p, i.*))) {
    if !scan_byte(p, i.*) {
      return false
    }
    i.* += 1
  }
  return true
}

fn skip_digits(p: *Parser, i: *u32) bool {
  for i.* < p.length && (digit(byte_at(p, i.*)) || byte_at(p, i.*) == '_') {
    if !scan_byte(p, i.*) {
      return false
    }
    i.* += 1
  }
  return true
}

fn base_digit(c: u8, base: u8) bool {
  if c == '_' {
    return true
  }
  if base == 'x' {
    return hex(c)
  }
  if base == 'b' {
    return c >= '0' && c <= '1'
  }
  return c >= '0' && c <= '7'
}

fn utf8_extra(c: u8) u32 {
  if c < 0x80 {
    return 0
  }
  if c >= 0xC2 && c <= 0xDF {
    return 1
  }
  if c >= 0xE0 && c <= 0xEF {
    return 2
  }
  if c >= 0xF0 && c <= 0xF4 {
    return 3
  }
  return 4
}

fn pair_operator(c: u8, next: u8) bool {
  if c == '.' && (next == '.' || next == '*') {
    return true
  }
  if (c == '<' || c == '>' || c == '&' || c == '|') && next == c {
    return true
  }
  if next == '=' {
    case c {
      ':', '+', '-', '*', '/', '%', '&', '|', '^', '!', '<', '>', '=' => {
        return true
      },
      _ => {
      },
    }
  }
  return c == '=' && next == '>'
}

fn single_operator(c: u8) bool {
  case c {
    '(', ')', '[', ']', '{', '}', '.', ',', ':', '+', '-', '*', '/', '%', '&', '|', '^', '!', '~', '<', '>', '=' => {
      return true
    },
    _ => {
      return false
    },
  }
}

fn lex(p: *Parser) {
  if !charge(p, 1, p.offset) {
    p.token = Token{ start: p.offset, end: p.offset, kind: TokenKind.End }
    return
  }
  i := p.offset
  external_space := true
  for {
    for i < p.length && space(byte_at(p, i)) {
      if !scan_byte(p, i) {
        return
      }
      if byte_at(p, i) == 0x0B {
        external_space = false
      }
      i += 1
    }
    if at(p, i, "//") {
      i += 2
      for i < p.length && byte_at(p, i) != '\n' {
        if !scan_byte(p, i) {
          return
        }
        i += 1
      }
      external_space = true
    } else if at(p, i, "/*") {
      comment := i
      i += 2
      for i < p.length && !at(p, i, "*/") {
        if !scan_byte(p, i) {
          return
        }
        i += 1
      }
      if i == p.length {
        fail(p, comment, "unterminated comment")
        break
      }
      i += 2
      external_space = true
    } else {
      break
    }
  }
  start := i
  kind := TokenKind.Punct
  if i == p.length {
    kind = TokenKind.End
  } else if alpha(byte_at(p, i)) {
    kind = TokenKind.Name
    i += 1
    if !skip_word(p, &i) {
      return
    }
  } else if digit(byte_at(p, i)) || (byte_at(p, i) == '.' && i + 1 < p.length && digit(byte_at(p, i + 1))) {
    kind = TokenKind.Number
    if at(p, i, "0x") || at(p, i, "0b") || at(p, i, "0o") {
      base := byte_at(p, i + 1)
      i += 2
      digits := i
      for i < p.length && base_digit(byte_at(p, i), base) {
        if !scan_byte(p, i) {
          return
        }
        i += 1
      }
      if i == digits {
        fail(p, start, "missing base digits")
      }
    } else {
      leading_dot := byte_at(p, i) == '.'
      if leading_dot {
        i += 1
      }
      if !skip_digits(p, &i) {
        return
      }
      trailing_dot := false
      if !leading_dot && i < p.length && byte_at(p, i) == '.' && !at(p, i, "..") {
        i += 1
        fraction := i
        // The grammar requires a digit immediately after a decimal point.
        if i < p.length && digit(byte_at(p, i)) {
          i += 1
          if !skip_digits(p, &i) {
            return
          }
        }
        trailing_dot = fraction == i
        if trailing_dot && !external_space {
          fail(p, start, "unsupported trailing float whitespace")
        }
      }
      if !trailing_dot && i < p.length && (byte_at(p, i) == 'e' || byte_at(p, i) == 'E') {
        exponent := i
        i += 1
        if i < p.length && (byte_at(p, i) == '+' || byte_at(p, i) == '-') {
          i += 1
        }
        if i == p.length || !digit(byte_at(p, i)) {
          i = exponent
        } else {
          i += 1
          if !skip_digits(p, &i) {
            return
          }
        }
      }
    }
  } else if byte_at(p, i) == '"' || byte_at(p, i) == '\'' {
    quote := byte_at(p, i)
    i += 1
    kind = TokenKind.Character
    if quote == '"' {
      kind = TokenKind.Text
    }
    characters: u32
    for i < p.length && byte_at(p, i) != quote && byte_at(p, i) != '\n' {
      if !scan_byte(p, i) {
        return
      }
      characters += 1
      if byte_at(p, i) == '\\' {
        i += 1
        if !escape(p, &i) {
          fail(p, i, "invalid escape")
          break
        }
      } else {
        // Count UTF-8 scalar values, rejecting malformed encodings.
        c := byte_at(p, i)
        i += 1
        n := utf8_extra(c)
        if n == 4 || n > p.length - i {
          fail(p, i - 1, "invalid UTF-8")
          break
        }
        if n != 0 {
          second := byte_at(p, i)
          if (c == 0xE0 && second < 0xA0) || (c == 0xED && second >= 0xA0) || (c == 0xF0 && second < 0x90) || (c == 0xF4 && second >= 0x90) {
            fail(p, i - 1, "invalid UTF-8")
          }
        }
        for n != 0 {
          if (byte_at(p, i) & 0xC0) != 0x80 {
            fail(p, i, "invalid UTF-8")
          }
          i += 1
          n -= 1
        }
      }
    }
    if i == p.length || byte_at(p, i) != quote {
      fail(p, start, "unterminated literal")
    } else {
      i += 1
    }
    if kind == TokenKind.Character && characters != 1 {
      fail(p, start, "character literal requires one character")
    }
  } else {
    c := byte_at(p, i)
    i += 1
    if c == '$' {
      if i == p.length || !alpha(byte_at(p, i)) {
        fail(p, start, "expected type parameter")
      }
      if !skip_word(p, &i) {
        return
      }
    } else if c == '#' {
      for i < p.length && alpha(byte_at(p, i)) {
        if !scan_byte(p, i) {
          return
        }
        i += 1
      }
    } else {
      next: u8
      if i < p.length {
        next = byte_at(p, i)
      }
      if pair_operator(c, next) {
        i += 1
        if ((c == '.' && next == '.') || ((c == '<' || c == '>') && next == c)) && i < p.length && byte_at(p, i) == '=' {
          i += 1
        }
      } else if c == 0 || !single_operator(c) {
        kind = TokenKind.Bad
        fail(p, start, "unexpected character")
      }
    }
  }
  p.token = Token{ start: start, end: i, kind: kind }
  p.offset = i
}

fn take(p: *Parser, s: []const u8) bool {
  if !token_is(p, s) {
    return false
  }
  lex(p)
  return true
}

fn expect(p: *Parser, s: []const u8) {
  if take(p, s) || p.tree.failed {
    return
  }
  fail(p, p.token.start, "unexpected token")
}
