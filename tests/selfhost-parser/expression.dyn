// Port of the expression and type parser in src/parser.c.
const ExpName: u16 = 0
const ExpNumber: u16 = 1
const ExpBool: u16 = 2
const ExpNil: u16 = 3
const ExpString: u16 = 4
const ExpChar: u16 = 5
const ExpGroup: u16 = 6
const ExpPrefix: u16 = 7
const ExpBinary: u16 = 8
const ExpDeref: u16 = 9
const ExpField: u16 = 10
const ExpCall: u16 = 11
const ExpIndex: u16 = 12
const ExpSlice: u16 = 13
const ExpPointerOp: u16 = 14
const ExpLen: u16 = 15
const ExpType: u16 = 16
const ExpTypeArgument: u16 = 17
const ExpPrimitive: u16 = 18
const ExpTypeParameter: u16 = 19
const ExpFieldType: u16 = 20
const ExpPointerType: u16 = 21
const ExpArrayType: u16 = 22
const ExpFnType: u16 = 23
const ExpCast: u16 = 24
const ExpSize: u16 = 25
const ExpAlign: u16 = 26
const ExpOffset: u16 = 27
const ExpTypeof: u16 = 28
const ExpLoad: u16 = 29
const ExpSyscall: u16 = 30
const ExpStruct: u16 = 31
const ExpMember: u16 = 32
const ExpArray: u16 = 33
const ExpGenericType: u16 = 34
const ExpDotName: u16 = 35
const ExpUnionType: u16 = 36
const ExpFallibleType: u16 = 37
const ExpTry: u16 = 38
const ExpCatch: u16 = 39
const ExpTake: u16 = 40

const FlagConst: u16 = 1
const FlagPublic: u16 = 2
const FlagPacked: u16 = 4
const FlagDistinct: u16 = 8
const FlagPointerBinding: u16 = 16
const FlagInclusive: u16 = 32
const FlagIteration: u16 = 64
const FlagPrimary: u16 = 128
const FlagBitcast: u16 = 256
const FlagWildcard: u16 = 512
const FlagFallibleVoid: u16 = 1024
const FlagInstance: u16 = 2048
const FlagIndexed: u16 = 4096
const FlagWrapping: u16 = 8192
const FlagNocopy: u16 = 16384

fn add_node(p: *Parser, kind: u16, start: u32, end: u32, first: u32) u32 {
  if p.tree.failed { return None }
  if p.tree.count >= 0xFFFFFFFE {
    fail(p, start, "tree too large")
    return None
  }
  value := Node{ start: start, end: end, first: first, next: None, parent: None, kind: kind }
  return #cast(u32, append_grow(&p.tree.nodes, &p.tree.count, p.arena, value))
}

fn mark(p: *Parser, id: u32, flags: u16) u32 {
  if id != None {
    p.tree.nodes[id].flags |= flags
  }
  return id
}

fn node_end(p: *const Parser, id: u32) u32 {
  return p.tree.nodes[id].end
}

fn precedence(p: *const Parser) i32 {
  n := p.token.end - p.token.start
  if n == 0 || n > 2 { return 0 }
  c := byte_at(p, p.token.start)
  if n == 2 {
    next := byte_at(p, p.token.start + 1)
    if next == c {
      if c == '|' { return 2 }
      if c == '&' { return 3 }
      if c == '<' || c == '>' { return 9 }
    }
    if next == '=' {
      if c == '=' || c == '!' { return 4 }
      if c == '<' || c == '>' { return 5 }
    }
    return 0
  }
  case c {
    '<', '>' => {
      return 5
    }
    '|' => {
      return 6
    }
    '^' => {
      return 7
    }
    '&' => {
      return 8
    }
    '+', '-' => {
      return 10
    }
    '*', '/', '%' => {
      return 11
    }
    _ => {
      return 0
    }
  }
}

fn primitive(p: *const Parser) bool {
  names: [16][]const u8 = ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64", "isize", "usize", "bool", "str", "rawptr", "any"]
  for candidate in names {
    if token_is(p, candidate) { return true }
  }
  return false
}

fn fn_type_start(p: *Parser) bool {
  return token_is(p, "fn") && src_next_is(p, "(")
}

fn optional_type_start(p: *Parser) bool {
  if p.token.newline { return false }
  if fn_type_start(p) { return true }
  if src_distinct(p) || src_packed(p) { return false }
  declarations: [8][]const u8 = ["fn", "pub", "use", "const", "type", "struct", "enum", "extern"]
  for candidate in declarations {
    if token_is(p, candidate) { return false }
  }
  return p.token.kind == TokenKind.Name || token_is(p, "*") || token_is(p, "[") || at(p, p.token.start, "$")
}

fn chain(p: *Parser, first: *u32, last: *u32, child: u32) {
  if child == None || p.tree.failed { return }
  if first.* == None {
    first.* = child
  } else {
    p.tree.nodes[last.*].next = child
  }
  last.* = child
}

fn parse_name(p: *Parser) u32 {
  token := p.token
  if token.kind != TokenKind.Name {
    fail(p, token.start, "expected identifier")
    return None
  }
  if token_is(p, "distinct") || token_is(p, "packed") || token_is(p, "union") {
    fail(p, token.start, "reserved keyword cannot be a name")
    return None
  }
  lex(p)
  return add_node(p, ExpName, token.start, token.end, None)
}

fn type_body(p: *Parser) u32 {
  if p.tree.failed { return None }
  token := p.token
  first := None
  last := None
  end := token.end
  kind: u16
  flags: u16
  if fn_type_start(p) {
    // A function value is a code pointer: fn(A, B) R is *fn in the tree.
    kind = ExpPointerType
    fn_start := p.token.start
    lex(p)
    expect(p, "(")
    p.bracket_depth += 1
    for !token_is(p, ")") && !p.tree.failed {
      // Parameter names are documentation only.
      if p.token.kind == TokenKind.Name && src_next_is(p, ":") {
        lex(p)
        lex(p)
      }
      chain(p, &first, &last, parse_type(p))
      if !take(p, ",") { break }
    }
    p.bracket_depth -= 1
    end = p.token.end
    expect(p, ")")
    // A function type's result may be fallible: fn(A) R!E.
    if !p.token.newline && (token_is(p, "!") || optional_type_start(p)) {
      chain(p, &first, &last, parse_return_type(p, false))
      if last != None {
        end = node_end(p, last)
      }
    }
    first = add_node(p, ExpFnType, fn_start, end, first)
  } else if take(p, "*") {
    kind = ExpPointerType
    if take(p, "const") {
      flags |= FlagConst
    }
    inner := type_body(p)
    if inner != None {
      first = add_node(p, ExpType, p.tree.nodes[inner].start, node_end(p, inner), inner)
      if first != None { end = node_end(p, first) }
    }
  } else if take(p, "[") {
    kind = ExpArrayType
    p.bracket_depth += 1
    prev_no_struct := p.no_struct_literal
    p.no_struct_literal = false
    if !token_is(p, "]") {
      chain(p, &first, &last, expression(p, 0))
    }
    p.no_struct_literal = prev_no_struct
    p.bracket_depth -= 1
    expect(p, "]")
    if take(p, "const") {
      flags |= FlagConst
    }
    inner := type_body(p)
    if inner != None {
      elem := add_node(p, ExpType, p.tree.nodes[inner].start, node_end(p, inner), inner)
      chain(p, &first, &last, elem)
    }
    if last != None {
      end = node_end(p, last)
    }
  } else if primitive(p) {
    kind = ExpPrimitive
    lex(p)
  } else if at(p, token.start, "$") {
    fail(p, token.start, "$T generics were removed: declare type parameters with <T>, as in fn f<T>(x: T)")
    return None
  } else if token.kind == TokenKind.Name {
    kind = ExpFieldType
    chain(p, &first, &last, parse_name(p))
    for take(p, ".") && !p.tree.failed {
      chain(p, &first, &last, parse_name(p))
    }
    if last != None {
      end = node_end(p, last)
    }
    if take(p, "<") {
      path := add_node(p, ExpFieldType, token.start, end, first)
      first = None
      last = None
      chain(p, &first, &last, path)
      p.bracket_depth += 1
      for !token_is(p, ">") && !(p.token.kind == TokenKind.Punct && p.token.start < p.length && p.text[p.token.start] == '>') && !p.tree.failed {
        chain(p, &first, &last, parse_type(p))
        if !take(p, ",") { break }
      }
      p.bracket_depth -= 1
      end = expect_gt(p)
      kind = ExpGenericType
    }
  } else if take(p, "(") {
    p.bracket_depth += 1
    first = parse_type(p)
    p.bracket_depth -= 1
    expect(p, ")")
    return first
  } else if token_is(p, "!") {
    fail(p, token.start, "error union 'T!E' is only allowed as a function return type")
    return None
  } else {
    fail(p, token.start, "expected type")
    return None
  }
  return mark(p, add_node(p, kind, token.start, end, first), flags)
}

fn parse_type_no_bang(p: *Parser) u32 {
  if p.tree.failed { return None }
  p.depth += 1
  if p.depth > MaxDepth {
    fail(p, p.token.start, "expression nesting limit exceeded")
    p.depth -= 1
    return None
  }
  start := p.token.start
  child := type_body(p)
  if child != None && !p.tree.failed && token_is(p, "|") {
    uf := child
    ul := child
    for take(p, "|") && !p.tree.failed {
      member_node := type_body(p)
      if member_node == None { break }
      chain(p, &uf, &ul, member_node)
    }
    if !p.tree.failed {
      child = add_node(p, ExpUnionType, start, node_end(p, ul), uf)
    }
  }
  p.depth -= 1
  if child == None { return None }
  return add_node(p, ExpType, start, node_end(p, child), child)
}

fn parse_type(p: *Parser) u32 {
  t := parse_type_no_bang(p)
  if t != None && !p.tree.failed && token_is(p, "!") {
    fail(p, p.token.start, "error union 'T!E' is only allowed as a function return type")
    return None
  }
  return t
}

fn parse_return_type(p: *Parser, stop_at_brace: bool) u32 {
  if p.tree.failed { return None }
  start := p.token.start
  if take(p, "!") {
    bang_end := start + 1
    err := None
    if !(stop_at_brace && token_is(p, "{")) && (optional_type_start(p) || token_is(p, "(")) {
      err = parse_type(p)
    }
    end := bang_end
    if err != None { end = node_end(p, err) }
    fallible := mark(p, add_node(p, ExpFallibleType, start, end, err), FlagFallibleVoid)
    return add_node(p, ExpType, start, end, fallible)
  }
  ok := parse_type_no_bang(p)
  if ok == None || p.tree.failed { return ok }
  if !p.token.newline && take(p, "!") {
    bang_end := node_end(p, ok) + 1
    err := None
    if !(stop_at_brace && token_is(p, "{")) && (optional_type_start(p) || token_is(p, "(")) {
      err = parse_type(p)
      if err != None { p.tree.nodes[ok].next = err }
    }
    end := bang_end
    if err != None { end = node_end(p, err) }
    fallible := add_node(p, ExpFallibleType, start, end, ok)
    return add_node(p, ExpType, start, end, fallible)
  }
  return ok
}

// Ambiguous array literals and names are resolved at the enclosing delimiter.
fn resource_error(p: *const Parser) bool {
  return p.tree.error_kind == ErrorKind.Allocation || p.tree.error_kind == ErrorKind.Limit
}

// Rewinds a failed speculation: lexer state, node count and error.
fn restore(p: *Parser, saved: *const Parser, count: usize) {
  p.* = saved.*
  p.tree.count = count
  p.tree.failed = false
  p.tree.error = ""
  p.tree.error_kind = ErrorKind.Ok
  p.tree.error_offset = 0
}

fn type_or_expr(p: *Parser) u32 {
  if p.tree.failed { return None }
  if token_is(p, "true") || token_is(p, "false") || token_is(p, "nil") { return expression(p, 0) }
  if token_is(p, "[") {
    array := aggregate(p)
    if array == None { return None }
    saved := p.*
    count := p.tree.count
    first := p.tree.nodes[array].first
    sibling := None
    if first != None {
      sibling = p.tree.nodes[first].next
    }
    ok := true
    if first != None {
      if p.tree.nodes[first].next != None {
        ok = false
      } else {
        closing := p.*
        closing.offset = node_end(p, first)
        closing.scan_next = 0
        lex(&closing)
        if !token_is(&closing, "]") {
          ok = false
        }
      }
    }
    if ok {
      is_const := take(p, "const")
      element := parse_type(p)
      if !p.tree.failed && element != None && (token_is(p, ")") || token_is(p, ",")) {
        if first != None {
          p.tree.nodes[first].next = element
        } else {
          first = element
        }
        start := p.tree.nodes[array].start
        end := node_end(p, element)
        flags: u16
        if is_const {
          flags = FlagConst
        }
        child := mark(p, add_node(p, ExpArrayType, start, end, first), flags)
        return add_node(p, ExpType, start, end, child)
      }
      if resource_error(p) { return None }
      restore(p, &saved, count)
      if first != None {
        p.tree.nodes[first].next = sibling
      }
    }
    return expression_tail(p, array, false, 0)
  }
  committed := primitive(p) || fn_type_start(p) || token_is(p, "*")
  saved := p.*
  count := p.tree.count
  child := parse_type(p)
  if !p.tree.failed && (committed || token_is(p, ")") || token_is(p, ",")) { return child }
  if resource_error(p) { return None }
  restore(p, &saved, count)
  return expression(p, 0)
}

fn aggregate(p: *Parser) u32 {
  start := p.token.start
  first := None
  last := None
  array := take(p, "[")
  if !array {
    if !take(p, ".") {
      probe := p.*
      scratch := Tree{}
      probe.tree = &scratch
      lex(&probe)
      for take(&probe, ".") && probe.token.kind == TokenKind.Name {
        lex(&probe)
      }
      if token_is(&probe, "<") {
        chain(p, &first, &last, type_body(p))
      } else {
        chain(p, &first, &last, parse_name(p))
        for take(p, ".") && !p.tree.failed {
          chain(p, &first, &last, parse_name(p))
        }
      }
    } else {
      fail(p, p.token.start - 1, "a struct literal needs its type: write Type{...}, not .{...}")
      return None
    }
    expect(p, "{")
  }
  close := "}"
  if array {
    close = "]"
  }
  prev_no_struct := p.no_struct_literal
  p.no_struct_literal = false
  if array {
    p.bracket_depth += 1
  }
  for !token_is(p, close) && !p.tree.failed {
    child := None
    if array {
      child = expression(p, 0)
    } else {
      member_start := p.token.start
      field := parse_name(p)
      expect(p, ":")
      value := expression(p, 0)
      if p.tree.failed { break }
      p.tree.nodes[field].next = value
      child = add_node(p, ExpMember, member_start, node_end(p, value), field)
    }
    chain(p, &first, &last, child)
    if !take(p, ",") { break }
  }
  if array {
    p.bracket_depth -= 1
  }
  p.no_struct_literal = prev_no_struct
  end := p.token.end
  expect(p, close)
  kind := ExpStruct
  if array {
    kind = ExpArray
  }
  return add_node(p, kind, start, end, first)
}

fn struct_start(p: *Parser) bool {
  if p.tree.failed { return false }
  if token_is(p, ".") { return src_next_is(p, "{") }
  if p.no_struct_literal { return false }
  if token_is(p, "true") || token_is(p, "false") || token_is(p, "nil") { return false }
  if p.token.kind != TokenKind.Name { return false }
  probe := p.*
  scratch := Tree{}
  probe.tree = &scratch
  lex(&probe)
  for take(&probe, ".") && !scratch.failed {
    if probe.token.kind != TokenKind.Name { return false }
    lex(&probe)
  }
  // Box<i32>{...}: type arguments in angle brackets, then the brace.
  if token_is(&probe, "<") {
    typed := p.*
    types := Tree{}
    typed.tree = &types
    _ = type_body(&typed)
    ok := !types.failed && token_is(&typed, "{")
    if resource_error(&typed) {
      propagate_error(p, &types)
    }
    return ok
  }
  propagate_error(p, &scratch)
  return !scratch.failed && token_is(&probe, "{")
}

fn parse_operand(p: *Parser, minimum: i32) u32 {
  token := p.token
  left := None
  primary := false
  if token_is(p, "[") || struct_start(p) {
    left = aggregate(p)
  } else if take(p, "try") {
    operand := expression(p, 12)
    if operand != None {
      left = add_node(p, ExpTry, token.start, node_end(p, operand), operand)
    }
  } else if take(p, ".") {
    field := parse_name(p)
    if field != None {
      left = add_node(p, ExpDotName, token.start, node_end(p, field), field)
      primary = true
    }
  } else if take(p, "(") {
    prev_no_struct := p.no_struct_literal
    p.no_struct_literal = false
    p.bracket_depth += 1
    child := expression(p, 0)
    p.bracket_depth -= 1
    p.no_struct_literal = prev_no_struct
    end := p.token.end
    expect(p, ")")
    left = add_node(p, ExpGroup, token.start, end, child)
    primary = true
  } else if token_is(p, "#wrapping") {
    lex(p)
    expect(p, "(")
    prev_no_struct := p.no_struct_literal
    p.no_struct_literal = false
    p.bracket_depth += 1
    child := expression(p, 0)
    p.bracket_depth -= 1
    p.no_struct_literal = prev_no_struct
    end := p.token.end
    expect(p, ")")
    if child != None && !p.tree.failed {
      left = mark(p, add_node(p, ExpGroup, token.start, end, child), FlagWrapping)
      primary = true
    }
  } else if token_is(p, "-") || token_is(p, "&") || token_is(p, "!") || token_is(p, "~") {
    lex(p)
    child := expression(p, 12)
    if child != None {
      left = add_node(p, ExpPrefix, token.start, node_end(p, child), child)
    }
  } else if token_is(p, "#instance") {
    fail(p, token.start, "#instance was removed: write f<T> instead")
    return None
  } else if token_is(p, "#cast") || token_is(p, "#bitcast") {
    lex(p)
    expect(p, "(")
    prev_no_struct := p.no_struct_literal
    p.no_struct_literal = false
    p.bracket_depth += 1
    target := parse_type(p)
    if token_is(p, ")") {
      fail(p, p.token.start, "use #cast(type, value) or #bitcast(type, value); prefix cast syntax is no longer supported")
    }
    expect(p, ",")
    value := expression(p, 0)
    p.bracket_depth -= 1
    p.no_struct_literal = prev_no_struct
    end := p.token.end
    expect(p, ")")
    if !p.tree.failed {
      p.tree.nodes[target].next = value
      flags: u16
      if at(p, token.start, "#bitcast") {
        flags = FlagBitcast
      }
      left = mark(p, add_node(p, ExpCast, token.start, end, target), flags)
      primary = true
    }
  } else if token_is(p, "#sizeof") || token_is(p, "#alignof") || token_is(p, "#typeof") || token_is(p, "#offsetof") ||
    token_is(p, "#max") || token_is(p, "#min") {
    kind := ExpOffset
    // #max and #min share #sizeof's node.
    if token_is(p, "#sizeof") || token_is(p, "#max") || token_is(p, "#min") {
      kind = ExpSize
    } else if token_is(p, "#alignof") {
      kind = ExpAlign
    } else if token_is(p, "#typeof") {
      kind = ExpTypeof
    }
    lex(p)
    expect(p, "(")
    prev_no_struct := p.no_struct_literal
    p.no_struct_literal = false
    p.bracket_depth += 1
    child := None
    if kind == ExpOffset {
      child = parse_type(p)
      expect(p, ",")
      field := parse_name(p)
      if !p.tree.failed {
        p.tree.nodes[child].next = field
      }
    } else {
      child = type_or_expr(p)
    }
    p.bracket_depth -= 1
    p.no_struct_literal = prev_no_struct
    end := p.token.end
    expect(p, ")")
    left = add_node(p, kind, token.start, end, child)
    if kind == ExpTypeof {
      primary = true
    }
  } else if token_is(p, "#load") || token_is(p, "#syscall") {
    load := token_is(p, "#load")
    lex(p)
    expect(p, "(")
    prev_no_struct := p.no_struct_literal
    p.no_struct_literal = false
    p.bracket_depth += 1
    first := None
    last := None
    if load {
      literal := p.token
      if literal.kind != TokenKind.Text {
        fail(p, literal.start, "expected string literal")
      } else {
        lex(p)
        first = add_node(p, ExpString, literal.start, literal.end, None)
      }
    } else {
      for !token_is(p, ")") && !p.tree.failed {
        chain(p, &first, &last, expression(p, 0))
        if !take(p, ",") { break }
      }
    }
    p.bracket_depth -= 1
    p.no_struct_literal = prev_no_struct
    end := p.token.end
    expect(p, ")")
    kind := ExpSyscall
    if load {
      kind = ExpLoad
    }
    left = add_node(p, kind, token.start, end, first)
  } else if token_is(p, "#offset") {
    fail(p, token.start, "#offset was removed: index a pointer range with #slice(pointer, count)[i]")
    return None
  } else if token_is(p, "#slice") {
    flags: u16 = 0
    lex(p)
    expect(p, "(")
    prev_no_struct := p.no_struct_literal
    p.no_struct_literal = false
    p.bracket_depth += 1
    child := expression(p, 0)
    expect(p, ",")
    count := expression(p, 0)
    p.bracket_depth -= 1
    p.no_struct_literal = prev_no_struct
    end := p.token.end
    expect(p, ")")
    if child != None && !p.tree.failed {
      p.tree.nodes[child].next = count
    }
    left = mark(p, add_node(p, ExpPointerOp, token.start, end, child), flags)
    primary = true
  } else if token_is(p, "#sqrt") || token_is(p, "#floor") || token_is(p, "#ceil") || token_is(p, "#trunc") ||
    token_is(p, "#round") || token_is(p, "#fma") {
    // A math builtin names a function of the compiler's prelude, so
    // #sqrt(x) parses as a call.
    lex(p)
    if !token_is(p, "(") {
      fail(p, p.token.start, "expected '(' after a math builtin, as in #sqrt(x)")
      return None
    }
    left = add_node(p, ExpName, token.start, token.end, None)
    primary = true
  } else if token_is(p, "#len") {
    fail(p, token.start, "#len was removed: use xs.len instead")
    return None
  } else if token_is(p, "#init") {
    kind := ExpLen
    lex(p)
    expect(p, "(")
    prev_no_struct := p.no_struct_literal
    p.no_struct_literal = false
    p.bracket_depth += 1
    child := expression(p, 0)
    p.bracket_depth -= 1
    p.no_struct_literal = prev_no_struct
    end := p.token.end
    expect(p, ")")
    left = add_node(p, kind, token.start, end, child)
  } else if token_is(p, "#take") {
    lex(p)
    expect(p, "(")
    prev_no_struct := p.no_struct_literal
    p.no_struct_literal = false
    p.bracket_depth += 1
    child := expression(p, 0)
    p.bracket_depth -= 1
    p.no_struct_literal = prev_no_struct
    end := p.token.end
    expect(p, ")")
    left = add_node(p, ExpTake, token.start, end, child)
    primary = true
  } else {
    kind := ExpName
    if token.kind == TokenKind.Number {
      kind = ExpNumber
    } else if token.kind == TokenKind.Text {
      kind = ExpString
    } else if token.kind == TokenKind.Character {
      kind = ExpChar
    } else if token.kind == TokenKind.Name && (token_is(p, "true") || token_is(p, "false")) {
      kind = ExpBool
    } else if token.kind == TokenKind.Name && token_is(p, "nil") {
      kind = ExpNil
    } else if token.kind == TokenKind.Name {
      if token_is(p, "distinct") || token_is(p, "packed") || token_is(p, "union") {
        fail(p, token.start, "reserved keyword cannot be a name")
        return None
      }
      primary = true
    } else if token_is(p, "#reverse") {
      fail(p, token.start, "#reverse is valid only as a for-loop iterable")
      return None
    } else {
      fail(p, token.start, "expected expression")
      return None
    }
    lex(p)
    left = add_node(p, kind, token.start, token.end, None)
  }
  if primary {
    _ = mark(p, left, FlagPrimary)
  }
  return expression_tail(p, left, primary, minimum)
}

fn expression_tail(p: *Parser, operand: u32, primary_operand: bool, minimum: i32) u32 {
  left := operand
  primary := primary_operand
  for left != None && !p.tree.failed {
    if p.token.newline && p.bracket_depth == 0 { break }
    token := p.token
    start := p.tree.nodes[left].start
    if take(p, ".*") {
      left = mark(p, add_node(p, ExpDeref, start, token.end, left), FlagPrimary)
      primary = true
    } else if (primary || p.tree.nodes[left].kind == ExpString || p.tree.nodes[left].kind == ExpArray) && take(p, ".") {
      if p.token.kind != TokenKind.Name {
        fail(p, p.token.start, "expected field name")
        break
      }
      field := p.token
      lex(p)
      field_name := add_node(p, ExpName, field.start, field.end, None)
      if field_name == None { break }
      p.tree.nodes[left].next = field_name
      left = mark(p, add_node(p, ExpField, start, field.end, left), FlagPrimary)
      primary = true
    } else if primary && token_is(p, "<") &&
      (p.tree.nodes[left].kind == ExpName || p.tree.nodes[left].kind == ExpField) {
      saved := p.*
      count := p.tree.count
      lex(p)
      p.bracket_depth += 1
      last := left
      parsed := false
      for !token_is(p, ">") && !(p.token.kind == TokenKind.Punct && p.token.start < p.length && p.text[p.token.start] == '>') && !p.tree.failed {
        arg := parse_type(p)
        if arg == None { break }
        p.tree.nodes[last].next = arg
        last = arg
        parsed = true
        if !take(p, ",") { break }
      }
      p.bracket_depth -= 1
      gt_end := p.token.start + 1
      closed := parsed && !p.tree.failed && take_gt(p)
      follow := closed && (
        (token_is(p, "(") && p.token.start == gt_end) ||
        token_is(p, ".") || token_is(p, ",") || token_is(p, ")") || token_is(p, "]") || token_is(p, "}") ||
        token_is(p, "=>") || token_is(p, "==") || token_is(p, "!=") ||
        p.token.newline || p.token.kind == TokenKind.End)
      if follow {
        left = mark(p, add_node(p, ExpGenericType, start, gt_end, left), FlagPrimary)
        primary = true
      } else {
        if resource_error(p) { break }
        restore(p, &saved, count)
        p.tree.nodes[left].next = None
        level := precedence(p)
        if level == 0 || level < minimum { break }
        lex(p)
        right := expression(p, level + 1)
        if right == None { break }
        p.tree.nodes[left].next = right
        left = add_node(p, ExpBinary, start, node_end(p, right), left)
        primary = false
      }
    } else if primary && take(p, "(") {
      prev_no_struct := p.no_struct_literal
      p.no_struct_literal = false
      p.bracket_depth += 1
      last := left
      for !token_is(p, ")") && !p.tree.failed {
        value := None
        if p.in_case_pattern && token_is(p, "*") {
          star := p.token
          lex(p)
          bound := parse_name(p)
          if bound != None {
            value = add_node(p, ExpPrefix, star.start, node_end(p, bound), bound)
          }
        } else {
          value = expression(p, 0)
        }
        if value == None { break }
        p.tree.nodes[last].next = value
        last = value
        if !take(p, ",") { break }
      }
      p.bracket_depth -= 1
      p.no_struct_literal = prev_no_struct
      end := p.token.end
      expect(p, ")")
      left = mark(p, add_node(p, ExpCall, start, end, left), FlagPrimary)
    } else if primary && take(p, "[") {
      prev_no_struct := p.no_struct_literal
      p.no_struct_literal = false
      p.bracket_depth += 1
      low := None
      high := None
      if !token_is(p, "..") {
        low = expression(p, 0)
      }
      slice := take(p, "..")
      if slice && !token_is(p, "]") {
        high = expression(p, 0)
      }
      p.bracket_depth -= 1
      p.no_struct_literal = prev_no_struct
      end := p.token.end
      expect(p, "]")
      if p.tree.failed { break }
      // Missing slice endpoints are represented by zero-width empty groups.
      if slice && low == None {
        low = add_node(p, ExpGroup, token.end, token.end, None)
      }
      if slice && high == None {
        high = add_node(p, ExpGroup, end - 1, end - 1, None)
      }
      if p.tree.failed { break }
      p.tree.nodes[left].next = low
      kind := ExpIndex
      if slice {
        p.tree.nodes[low].next = high
        kind = ExpSlice
      }
      left = mark(p, add_node(p, kind, start, end, left), FlagPrimary)
    } else if minimum <= 1 && take(p, "catch") {
      if token_is(p, "{") {
        blk := src_block(p)
        if blk == None { break }
        p.tree.nodes[left].next = blk
        left = add_node(p, ExpCatch, start, node_end(p, blk), left)
        primary = false
      } else if p.token.kind == TokenKind.Name && src_next_is(p, "{") {
        ename := parse_name(p)
        blk := src_block(p)
        if ename == None || blk == None { break }
        p.tree.nodes[left].next = ename
        p.tree.nodes[ename].next = blk
        left = add_node(p, ExpCatch, start, node_end(p, blk), left)
        primary = false
      } else {
        fb := expression(p, 1)
        if fb == None { break }
        p.tree.nodes[left].next = fb
        left = add_node(p, ExpCatch, start, node_end(p, fb), left)
        primary = false
      }
    } else {
      level := precedence(p)
      if level == 0 || level < minimum { break }
      lex(p)
      right := expression(p, level + 1)
      if right == None { break }
      p.tree.nodes[left].next = right
      left = add_node(p, ExpBinary, start, node_end(p, right), left)
      primary = false
    }
  }
  return left
}

fn expression(p: *Parser, minimum: i32) u32 {
  if p.tree.failed { return None }
  p.depth += 1
  if p.depth > MaxDepth {
    fail(p, p.token.start, "expression nesting limit exceeded")
    p.depth -= 1
    return None
  }
  result := parse_operand(p, minimum)
  p.depth -= 1
  return result
}
