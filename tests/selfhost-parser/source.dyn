// Port of the fail-fast source parser in src/parser_source.inc.
const SrcFile: u16 = 1000
const SrcDeclaration: u16 = 1001
const SrcTarget: u16 = 1002
const SrcTargetCondition: u16 = 1003
const SrcLink: u16 = 1004
const SrcUse: u16 = 1005
const SrcImport: u16 = 1006
const SrcVariable: u16 = 1007
const SrcConst: u16 = 1008
const SrcAlias: u16 = 1009
const SrcStruct: u16 = 1010
const SrcStructMember: u16 = 1011
const SrcEnum: u16 = 1012
const SrcEnumMember: u16 = 1013
const SrcFn: u16 = 1014
const SrcExternFn: u16 = 1015
const SrcExternVariable: u16 = 1016
const SrcFnParam: u16 = 1017
const SrcVariadicParam: u16 = 1018
const SrcVariadic: u16 = 1019
const SrcBlock: u16 = 1020
const SrcReturn: u16 = 1021
const SrcContinue: u16 = 1022
const SrcBreak: u16 = 1023
const SrcIf: u16 = 1024
const SrcElse: u16 = 1025
const SrcCase: u16 = 1026
const SrcCaseArm: u16 = 1027
const SrcCasePattern: u16 = 1028
const SrcTypePattern: u16 = 1029
const SrcFor: u16 = 1030
const SrcForCondition: u16 = 1031
const SrcDefer: u16 = 1032
const SrcAssignment: u16 = 1033
const SrcAssert: u16 = 1034
const SrcPanic: u16 = 1035
const SrcRange: u16 = 1036
const SrcQualifier: u16 = 1037
const SrcReverse: u16 = 1038
const SrcStep: u16 = 1039
const SrcFail: u16 = 1041
const SrcErrdefer: u16 = 1042

fn src_end(p: *const Parser, id: u32, fallback: u32) u32 {
  if id == None { return fallback }
  return node_end(p, id)
}

fn src_peek(p: *Parser) Token {
  if p.tree.failed { return Token{ start: p.offset, end: p.offset, kind: TokenKind.End } }
  probe := p.*
  scratch := Tree{}
  probe.tree = &scratch
  lex(&probe)
  if scratch.failed {
    propagate_error(p, &scratch)
  }
  return probe.token
}

fn src_next_is(p: *Parser, word: []const u8) bool {
  next := src_peek(p)
  return #cast(usize, next.end - next.start) == word.len && at(p, next.start, word)
}

fn src_distinct(p: *Parser) bool {
  return token_is(p, "distinct")
}

fn src_packed(p: *Parser) bool {
  return token_is(p, "packed") || token_is(p, "union")
}

fn src_nocopy(p: *Parser) bool {
  return token_is(p, "nocopy") && (src_next_is(p, "struct") || src_next_is(p, "packed"))
}

fn src_type_pattern(p: *Parser) bool {
  return primitive(p) || token_is(p, "*") || token_is(p, "[") || fn_type_start(p) || at(p, p.token.start, "$")
}

fn src_literal(p: *Parser, token_kind: TokenKind, kind: u16) u32 {
  token := p.token
  if token.kind != token_kind {
    fail(p, token.start, "expected literal")
    return None
  }
  lex(p)
  return add_node(p, kind, token.start, token.end, None)
}

fn src_qualifier(p: *Parser) u32 {
  start := p.token.start
  expect(p, ":")
  child := parse_type(p)
  return add_node(p, SrcQualifier, start, src_end(p, child, start), child)
}

fn src_dots(p: *Parser) bool {
  if take(p, "...") { return true }
  start := p.token.start
  if !take(p, "..") { return false }
  if p.token.start != start + 2 {
    fail(p, start, "variadic marker must be contiguous")
  }
  expect(p, ".")
  return !p.tree.failed
}

fn src_variadic(p: *Parser) u32 {
  start := p.token.start
  if !src_dots(p) {
    fail(p, start, "expected variadic marker")
  }
  return add_node(p, SrcVariadic, start, start + 3, None)
}

fn src_variable(p: *Parser) u32 {
  start := p.token.start
  first := None
  last := None
  chain(p, &first, &last, parse_name(p))
  if take(p, ":=") {
    chain(p, &first, &last, expression(p, 0))
  } else {
    colon := p.token.start
    expect(p, ":")
    target := parse_type(p)
    if take(p, "=") {
      chain(p, &first, &last, target)
      chain(p, &first, &last, expression(p, 0))
    } else {
      chain(p, &first, &last, add_node(p, SrcQualifier, colon, src_end(p, target, colon), target))
    }
  }
  return add_node(p, SrcVariable, start, src_end(p, last, start), first)
}

fn src_const(p: *Parser) u32 {
  start := p.token.start
  expect(p, "const")
  child := src_variable(p)
  return mark(p, add_node(p, SrcConst, start, src_end(p, child, start), child), FlagConst)
}

fn src_alias(p: *Parser) u32 {
  start := p.token.start
  first := None
  last := None
  is_distinct := take(p, "distinct")
  expect(p, "type")
  chain(p, &first, &last, parse_name(p))
  expect(p, "=")
  chain(p, &first, &last, parse_type(p))
  flags: u16
  if is_distinct {
    flags = FlagDistinct
  }
  return mark(p, add_node(p, SrcAlias, start, src_end(p, last, start), first), flags)
}

// Unparenthesized struct literals are disallowed directly in if/for/case
// headers, so the header's opening '{' is never mistaken for a struct literal.
fn src_condition(p: *Parser) u32 {
  prev := p.no_struct_literal
  p.no_struct_literal = true
  value := expression(p, 0)
  p.no_struct_literal = prev
  return value
}

fn src_range(p: *Parser, condition: bool) u32 {
  first := None
  if condition {
    first = src_condition(p)
  } else {
    first = expression(p, 0)
  }
  if first == None || (!token_is(p, "..") && !token_is(p, "..=")) { return first }
  operator := p.token
  lex(p)
  last := None
  if condition {
    last = src_condition(p)
  } else {
    last = expression(p, 0)
  }
  if last == None { return None }
  p.tree.nodes[first].next = last
  flags: u16
  if operator.end - operator.start == 3 {
    flags = FlagInclusive
  }
  return mark(p, add_node(p, SrcRange, p.tree.nodes[first].start, node_end(p, last), first), flags)
}

fn src_if(p: *Parser) u32 {
  start := p.token.start
  first := None
  last := None
  expect(p, "if")
  chain(p, &first, &last, src_condition(p))
  chain(p, &first, &last, src_block(p))
  if token_is(p, "else") {
    begin := p.token.start
    lex(p)
    child := None
    if token_is(p, "if") {
      child = src_statement(p)
    } else {
      child = src_block(p)
    }
    chain(p, &first, &last, add_node(p, SrcElse, begin, src_end(p, child, begin), child))
  }
  return add_node(p, SrcIf, start, src_end(p, last, start), first)
}

// #step(first..last, n)
fn src_step(p: *Parser) u32 {
  start := p.token.start
  lex(p)
  expect(p, "(")
  prev_no_struct := p.no_struct_literal
  p.no_struct_literal = false
  p.bracket_depth += 1
  range := src_range(p, false)
  expect(p, ",")
  step := expression(p, 0)
  p.bracket_depth -= 1
  p.no_struct_literal = prev_no_struct
  end := p.token.end
  expect(p, ")")
  if range == None || step == None || p.tree.failed { return None }
  p.tree.nodes[range].next = step
  return add_node(p, SrcStep, start, end, range)
}

fn src_for(p: *Parser) u32 {
  start := p.token.start
  first := None
  last := None
  if p.token.kind == TokenKind.Name && !token_is(p, "for") {
    chain(p, &first, &last, parse_name(p))
    expect(p, ":")
  }
  expect(p, "for")
  if !token_is(p, "{") {
    begin := p.token.start
    condition_first := None
    condition_last := None
    saved := p.*
    count := p.tree.count
    pointer := take(p, "*")
    if pointer && token_is(p, "const") {
      fail(p, p.token.start, "write `for *value in`: the pointer is const when the collection is")
      return None
    }
    flags: u16
    binding := None
    if p.token.kind == TokenKind.Name {
      binding = parse_name(p)
    }
    bound_type := None
    index := None
    if binding != None && take(p, ",") {
      if p.token.kind != TokenKind.Name {
        fail(p, p.token.start, "expected the index name after ','")
        return None
      }
      index = parse_name(p)
      if !token_is(p, "in") {
        fail(p, p.token.start, "expected 'in' after the index name")
        return None
      }
    }
    if binding != None && index == None && !pointer && take(p, ":") {
      bound_type = parse_type(p)
    }
    if binding != None && take(p, "in") {
      flags = FlagIteration
      if index != None {
        flags |= FlagIndexed
      }
      if pointer {
        flags |= FlagPointerBinding
      }
      chain(p, &condition_first, &condition_last, binding)
      if index != None {
        chain(p, &condition_first, &condition_last, index)
      }
      if bound_type != None {
        chain(p, &condition_first, &condition_last, bound_type)
      }
      if token_is(p, "#reverse") {
        reverse_start := p.token.start
        lex(p)
        expect(p, "(")
        prev_no_struct := p.no_struct_literal
        p.no_struct_literal = false
        p.bracket_depth += 1
        value := None
        if token_is(p, "#step") {
          value = src_step(p)
        } else {
          value = src_range(p, false)
        }
        p.bracket_depth -= 1
        p.no_struct_literal = prev_no_struct
        end := p.token.end
        expect(p, ")")
        chain(p, &condition_first, &condition_last, add_node(p, SrcReverse, reverse_start, end, value))
      } else if token_is(p, "#step") {
        chain(p, &condition_first, &condition_last, src_step(p))
      } else {
        chain(p, &condition_first, &condition_last, src_range(p, true))
      }
    } else {
      if resource_error(p) { return None }
      restore(p, &saved, count)
      chain(p, &condition_first, &condition_last, src_condition(p))
    }
    chain(p, &first, &last, mark(p, add_node(p, SrcForCondition, begin, src_end(p, condition_last, begin), condition_first), flags))
  }
  chain(p, &first, &last, src_block(p))
  return add_node(p, SrcFor, start, src_end(p, last, start), first)
}

fn src_extract_case_binding(p: *Parser, pattern: *u32, binding: *u32, pointer: *bool) bool {
  id := pattern.*
  if id == None || p.tree.nodes[id].kind != ExpCall { return false }
  callee := p.tree.nodes[id].first
  if callee == None { return false }
  arg := p.tree.nodes[callee].next
  if arg == None || p.tree.nodes[arg].next != None { return false }
  ck := p.tree.nodes[callee].kind
  if ck != ExpField && ck != ExpDotName && ck != ExpName && ck != ExpGenericType { return false }
  if p.tree.nodes[arg].kind == ExpName {
    ignored := p.tree.nodes[arg].end - p.tree.nodes[arg].start == 1 && p.text[p.tree.nodes[arg].start] == '_'
    if !ignored {
      if binding.* != None {
        fail(p, p.tree.nodes[arg].start, "a case arm can bind at most one payload")
        return false
      }
      p.tree.nodes[arg].flags &= ~FlagPrimary
      binding.* = arg
    }
    p.tree.nodes[callee].next = None
    pattern.* = callee
    return true
  }
  if p.tree.nodes[arg].kind == ExpPrefix && p.text[p.tree.nodes[arg].start] == '*' {
    bound := p.tree.nodes[arg].first
    if bound != None && p.tree.nodes[bound].kind == ExpName && p.tree.nodes[bound].next == None {
      if binding.* != None {
        fail(p, p.tree.nodes[bound].start, "a case arm can bind at most one payload")
        return false
      }
      p.tree.nodes[bound].flags &= ~FlagPrimary
      binding.* = bound
      pointer.* = true
      p.tree.nodes[callee].next = None
      pattern.* = callee
      return true
    }
  }
  return false
}

fn src_case(p: *Parser) u32 {
  start := p.token.start
  first := None
  last := None
  expect(p, "case")
  chain(p, &first, &last, src_condition(p))
  expect(p, "{")
  for !token_is(p, "}") && !p.tree.failed {
    begin := p.token.start
    arm_first := None
    arm_last := None
    wildcard := false
    pointer := false
    if token_is(p, "is") {
      fail(p, p.token.start, "type patterns do not use `is`: write `i64(n) =>`")
      break
    }
    if src_type_pattern(p) {
      pattern_first := None
      pattern_last := None
      chain(p, &pattern_first, &pattern_last, parse_type(p))
      if take(p, "(") {
        if take(p, "*") {
          fail(p, p.token.start, "type case binding cannot use '*': write `Type(name) =>`")
          break
        }
        if !take(p, "_") {
          chain(p, &pattern_first, &pattern_last, parse_name(p))
        }
        expect(p, ")")
        chain(p, &arm_first, &arm_last, add_node(p, SrcTypePattern, begin, src_end(p, pattern_last, begin), pattern_first))
      } else if p.token.kind == TokenKind.Name {
        fail(p, p.token.start, "case bindings use parentheses: write `Type(name) =>`, not `Type name =>`")
        break
      } else {
        chain(p, &arm_first, &arm_last, add_node(p, SrcTypePattern, begin, src_end(p, pattern_last, begin), pattern_first))
        for take(p, ",") && !p.tree.failed {
          tbegin := p.token.start
          extra := parse_type(p)
          chain(p, &arm_first, &arm_last, add_node(p, SrcTypePattern, tbegin, src_end(p, extra, tbegin), extra))
        }
      }
    } else {
      wildcard = take(p, "_")
      if !wildcard {
        binding := None
        prev_cp := p.in_case_pattern
        p.in_case_pattern = true
        for {
          if src_type_pattern(p) {
            tbegin := p.token.start
            extra := parse_type(p)
            chain(p, &arm_first, &arm_last, add_node(p, SrcTypePattern, tbegin, src_end(p, extra, tbegin), extra))
            if !take(p, ",") || p.tree.failed { break }
            continue
          }
          pattern := src_range(p, false)
          if pattern == None { break }
          _ = src_extract_case_binding(p, &pattern, &binding, &pointer)
          if p.tree.failed { break }
          chain(p, &arm_first, &arm_last, add_node(p, SrcCasePattern, p.tree.nodes[pattern].start, node_end(p, pattern), pattern))
          if !take(p, ",") || p.tree.failed { break }
        }
        p.in_case_pattern = prev_cp
        if binding != None {
          chain(p, &arm_first, &arm_last, binding)
        }
      }
      if p.token.kind == TokenKind.Name {
        fail(p, p.token.start, "case bindings use parentheses: write `Variant(name) =>`, not `Variant name =>`")
        break
      }
    }
    expect(p, "=>")
    chain(p, &arm_first, &arm_last, src_block(p))
    flags: u16
    if wildcard {
      flags |= FlagWildcard
    }
    if pointer {
      flags |= FlagPointerBinding
    }
    chain(p, &first, &last, mark(p, add_node(p, SrcCaseArm, begin, src_end(p, arm_last, begin), arm_first), flags))
    if token_is(p, ",") {
      fail(p, p.token.start, "case arms are not separated by commas")
    }
  }
  end := p.token.end
  expect(p, "}")
  return add_node(p, SrcCase, start, end, first)
}

fn src_expression_start(p: *Parser) bool {
  if src_distinct(p) { return false }
  keywords: [9][]const u8 = ["return", "break", "continue", "const", "if", "case", "for", "defer", "type"]
  for keyword in keywords {
    if token_is(p, keyword) { return false }
  }
  kind := p.token.kind
  if kind == TokenKind.Name || kind == TokenKind.Number || kind == TokenKind.Text || kind == TokenKind.Character {
    return true
  }
  starts: [30][]const u8 = ["(", "[", ".", "-", "&", "!", "~", "#cast", "#bitcast", "#wrapping", "#sizeof", "#alignof", "#offsetof", "#typeof", "#max", "#min", "#len", "#init", "#take", "#instance", "#slice", "#offset", "#load", "#syscall", "#sqrt", "#floor", "#ceil", "#trunc", "#round", "#fma"]
  for candidate in starts {
    if token_is(p, candidate) { return true }
  }
  return false
}

fn src_panic(p: *Parser) u32 {
  start := p.token.start
  expect(p, "#panic")
  expect(p, "(")
  child := expression(p, 0)
  end := p.token.end
  expect(p, ")")
  return add_node(p, SrcPanic, start, end, child)
}

fn src_assignment_operator(p: *const Parser) bool {
  operators: [11][]const u8 = ["=", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "<<=", ">>="]
  for candidate in operators {
    if token_is(p, candidate) { return true }
  }
  return false
}

fn src_primary_kind(kind: u16) bool {
  return kind == ExpName || kind == ExpGroup || kind == ExpDeref || kind == ExpCall || kind == ExpField || kind == ExpIndex || kind == ExpSlice
}

fn src_deferrable(kind: u16) bool {
  return kind == SrcBlock || kind == ExpCall || kind == ExpCatch || kind == SrcAssignment || kind == SrcIf || kind == SrcCase || kind == SrcFor || kind == SrcPanic || kind == ExpSyscall
}

fn src_is_fail_stmt(p: *Parser) bool {
  if !token_is(p, "fail") { return false }
  next := src_peek(p)
  if next.kind == TokenKind.End || next.newline { return true }
  if next.start == p.token.end && (at(p, next.start, ".") || at(p, next.start, "(")) { return false }
  if #cast(usize, next.end - next.start) == 1 && (at(p, next.start, ":") || at(p, next.start, "=")) { return false }
  if #cast(usize, next.end - next.start) == 2 && at(p, next.start, ":=") { return false }
  return true
}

fn src_statement_body(p: *Parser) u32 {
  if p.tree.failed { return None }
  start := p.token.start
  if token_is(p, "{") { return src_block(p) }
  if token_is(p, "if") { return src_if(p) }
  if token_is(p, "case") { return src_case(p) }
  if token_is(p, "for") { return src_for(p) }
  if token_is(p, "const") { return src_const(p) }
  if token_is(p, "type") || src_distinct(p) { return src_alias(p) }
  if token_is(p, "#panic") { return src_panic(p) }
  if token_is(p, "#assert") { return src_assert(p) }
  if token_is(p, "defer") || token_is(p, "errdefer") {
    is_err := token_is(p, "errdefer")
    lex(p)
    child := None
    if token_is(p, "{") {
      child = src_block(p)
    } else {
      child = src_statement(p)
    }
    if child != None && !src_deferrable(p.tree.nodes[child].kind) {
      fail(p, start, "invalid deferred statement")
    }
    dkind := SrcDefer
    if is_err { dkind = SrcErrdefer }
    return add_node(p, dkind, start, src_end(p, child, start), child)
  }
  if src_is_fail_stmt(p) {
    end := p.token.end
    lex(p)
    child := None
    if !p.token.newline && !token_is(p, "}") && p.token.kind != TokenKind.End && src_expression_start(p) {
      child = expression(p, 0)
    }
    return add_node(p, SrcFail, start, src_end(p, child, end), child)
  }
  if token_is(p, "break") || token_is(p, "continue") {
    kind := SrcContinue
    if token_is(p, "break") {
      kind = SrcBreak
    }
    end := p.token.end
    lex(p)
    child := None
    if !p.token.newline {
      if token_is(p, ":") {
        fail(p, p.token.start, "loop labels do not use a colon: write `break label` or `continue label`")
        return None
      }
      if p.token.kind == TokenKind.Name && !token_is(p, "true") && !token_is(p, "false") && !token_is(p, "nil") {
        child = parse_name(p)
        end = src_end(p, child, end)
      }
    }
    return add_node(p, kind, start, end, child)
  }
  if token_is(p, "return") {
    end := p.token.end
    lex(p)
    child := None
    if !p.token.newline && !token_is(p, "}") && p.token.kind != TokenKind.End && src_expression_start(p) {
      child = expression(p, 0)
    }
    return add_node(p, SrcReturn, start, src_end(p, child, end), child)
  }
  if p.token.kind == TokenKind.Name && !token_is(p, "true") && !token_is(p, "false") && !token_is(p, "nil") && (src_next_is(p, ":") || src_next_is(p, ":=")) {
    probe := p.*
    scratch := Tree{}
    probe.tree = &scratch
    lex(&probe)
    colon := take(&probe, ":")
    if scratch.failed {
      propagate_error(p, &scratch)
      return None
    }
    if colon && token_is(&probe, "for") {
      return src_for(p)
    }
    return src_variable(p)
  }
  value := expression(p, 0)
  if value == None { return None }
  if src_assignment_operator(p) {
    if !src_primary_kind(p.tree.nodes[value].kind) {
      fail(p, start, "assignment target must be primary")
      return None
    }
    lex(p)
    right := expression(p, 0)
    if right == None { return None }
    p.tree.nodes[value].next = right
    return add_node(p, SrcAssignment, start, node_end(p, right), value)
  }
  if p.tree.nodes[value].kind != ExpCall && p.tree.nodes[value].kind != ExpSyscall && p.tree.nodes[value].kind != ExpTry && p.tree.nodes[value].kind != ExpCatch && !(p.tree.nodes[value].kind == ExpLen && at(p, start, "#init")) {
    fail(p, start, "expression is not a statement")
    return None
  }
  p.tree.nodes[value].flags &= ~FlagPrimary
  return value
}

fn src_statement(p: *Parser) u32 {
  if p.tree.failed { return None }
  p.depth += 1
  if p.depth > MaxDepth {
    p.depth -= 1
    fail(p, p.token.start, "source nesting limit exceeded")
    return None
  }
  value := src_statement_body(p)
  p.depth -= 1
  return value
}

// `[3]i32{1, 2, 3}` written as in other languages: an element type name
// right after `]`, then `{`.
fn src_typed_array_literal(p: *Parser) bool {
  at := p.token.start
  for at > 0 && (p.text[at - 1] == ' ' || p.text[at - 1] == '\t') {
    at -= 1
  }
  if at == 0 || p.text[at - 1] != ']' || p.token.kind != TokenKind.Name { return false }
  next := src_peek(p)
  return next.kind != TokenKind.End && #cast(usize, next.start) < p.text.len && p.text[next.start] == '{'
}

fn src_block(p: *Parser) u32 {
  start := p.token.start
  first := None
  last := None
  expect(p, "{")
  for !token_is(p, "}") && !p.tree.failed && p.token.kind != TokenKind.End {
    chain(p, &first, &last, src_statement(p))
    if !p.tree.failed && !token_is(p, "}") && p.token.kind != TokenKind.End && !src_line_start(p, p.token.start) {
      if src_typed_array_literal(p) {
        fail(p, p.token.start, "write an array literal as [a, b, c] and give the type to the name: values: [3]i32 = [1, 2, 3]")
      } else {
        fail(p, p.token.start, "each statement must start on its own line")
      }
    }
  }
  end := p.token.end
  expect(p, "}")
  return add_node(p, SrcBlock, start, end, first)
}
// Whether only spaces and tabs separate offset from the start of its line.
fn src_line_start(p: *Parser, offset: u32) bool {
  at := offset
  for at != 0 && (p.text[at - 1] == ' ' || p.text[at - 1] == '\t') {
    at -= 1
  }
  return at == 0 || p.text[at - 1] == '\n'
}

fn src_param(p: *Parser, variadic_allowed: bool) u32 {
  start := p.token.start
  first := None
  last := None
  if at(p, start, "$") {
    fail(p, start, "$T generics were removed: declare type parameters with <T>, as in fn f<T>(x: T)")
    return None
  }
  chain(p, &first, &last, parse_name(p))
  for take(p, ",") && !p.tree.failed {
    chain(p, &first, &last, parse_name(p))
  }
  colon := p.token.start
  expect(p, ":")
  if variadic_allowed && (token_is(p, "..") || token_is(p, "...")) {
    if first != last || (first != None && p.tree.nodes[first].kind != ExpName) {
      fail(p, start, "variadic parameter requires one identifier")
    }
    chain(p, &first, &last, src_variadic(p))
    chain(p, &first, &last, parse_type(p))
    return add_node(p, SrcVariadicParam, start, src_end(p, last, start), first)
  }
  if token_is(p, "type") {
    fail(p, p.token.start, "`T: type` was removed: declare type parameters with <T>, as in fn f<T>(...)")
    return None
  }
  target := parse_type(p)
  chain(p, &first, &last, add_node(p, SrcQualifier, colon, src_end(p, target, colon), target))
  return add_node(p, SrcFnParam, start, src_end(p, last, start), first)
}

fn src_function(p: *Parser, external: bool) u32 {
  start := p.token.start
  first := None
  last := None
  if external {
    expect(p, "extern")
  }
  expect(p, "fn")
  chain(p, &first, &last, parse_name(p))
  if !external {
    src_type_parameters(p, &first, &last)
  }
  if external && p.token.kind == TokenKind.Text {
    chain(p, &first, &last, src_literal(p, TokenKind.Text, ExpString))
  }
  expect(p, "(")
  p.bracket_depth += 1
  for !token_is(p, ")") && !p.tree.failed {
    if external && (token_is(p, "..") || token_is(p, "...")) {
      chain(p, &first, &last, src_variadic(p))
      break
    }
    chain(p, &first, &last, src_param(p, !external))
    if !take(p, ",") { break }
  }
  p.bracket_depth -= 1
  end := p.token.end
  expect(p, ")")
  if external {
    if optional_type_start(p) {
      chain(p, &first, &last, parse_type(p))
      end = src_end(p, last, end)
    }
  } else {
    if !token_is(p, "{") {
      chain(p, &first, &last, parse_return_type(p, true))
    }
    chain(p, &first, &last, src_block(p))
    end = src_end(p, last, end)
  }
  kind := SrcFn
  if external {
    kind = SrcExternFn
  }
  return add_node(p, kind, start, end, first)
}

fn src_type_parameters(p: *Parser, first: *u32, last: *u32) {
  if !take(p, "<") { return }
  p.bracket_depth += 1
  for !token_is(p, ">") && !(p.token.kind == TokenKind.Punct && p.token.start < p.length && p.text[p.token.start] == '>') && !p.tree.failed {
    token := p.token
    if at(p, token.start, "$") {
      fail(p, token.start, "write `<T>`, not `<$T>`")
      break
    }
    if token.kind != TokenKind.Name {
      fail(p, token.start, "expected a type parameter name, as in `List<T>`")
      break
    }
    lex(p)
    chain(p, first, last, add_node(p, ExpTypeParameter, token.start, token.end, None))
    if token_is(p, ":") {
      fail(p, p.token.start, "write `<T>`, not `<T: type>`")
      break
    }
    if !take(p, ",") { break }
  }
  p.bracket_depth -= 1
  _ = expect_gt(p)
}

fn src_struct(p: *Parser) u32 {
  start := p.token.start
  first := None
  last := None
  if token_is(p, "union") {
    fail(p, start, "union types were removed; use #bitcast or a payload enum")
    return None
  }
  is_packed := false
  is_nocopy := false
  for {
    if !is_packed && take(p, "packed") {
      is_packed = true
    } else if !is_nocopy && take(p, "nocopy") {
      is_nocopy = true
    } else {
      break
    }
  }
  expect(p, "struct")
  chain(p, &first, &last, parse_name(p))
  src_type_parameters(p, &first, &last)
  expect(p, "{")
  for !token_is(p, "}") && !p.tree.failed {
    begin := p.token.start
    member_first := None
    member_last := None
    chain(p, &member_first, &member_last, parse_name(p))
    for take(p, ",") && !p.tree.failed {
      chain(p, &member_first, &member_last, parse_name(p))
    }
    chain(p, &member_first, &member_last, src_qualifier(p))
    if take(p, "=") {
      chain(p, &member_first, &member_last, expression(p, 0))
    }
    chain(p, &first, &last, add_node(p, SrcStructMember, begin, src_end(p, member_last, begin), member_first))
    if !take(p, ",") { break }
  }
  end := p.token.end
  expect(p, "}")
  flags: u16
  if is_packed {
    flags |= FlagPacked
  }
  if is_nocopy {
    flags |= FlagNocopy
  }
  return mark(p, add_node(p, SrcStruct, start, end, first), flags)
}

fn src_enum(p: *Parser) u32 {
  start := p.token.start
  first := None
  last := None
  expect(p, "enum")
  if take(p, "(") {
    if !primitive(p) && p.token.kind != TokenKind.Name {
      fail(p, p.token.start, "invalid enum tag type")
    }
    chain(p, &first, &last, type_body(p))
    expect(p, ")")
  }
  chain(p, &first, &last, parse_name(p))
  src_type_parameters(p, &first, &last)
  expect(p, "{")
  for !token_is(p, "}") && !p.tree.failed {
    begin := p.token.start
    member_first := None
    member_last := None
    chain(p, &member_first, &member_last, parse_name(p))
    if take(p, "(") {
      qstart := p.token.start
      p.bracket_depth += 1
      payload := parse_type(p)
      p.bracket_depth -= 1
      qend := p.token.end
      expect(p, ")")
      chain(p, &member_first, &member_last, add_node(p, SrcQualifier, qstart, qend, payload))
    } else if token_is(p, ":") {
      fail(p, p.token.start, "enum payload uses parentheses: write `Variant(Type)`, not `Variant: Type`")
      return None
    }
    if take(p, "=") {
      chain(p, &member_first, &member_last, expression(p, 0))
    }
    chain(p, &first, &last, add_node(p, SrcEnumMember, begin, src_end(p, member_last, begin), member_first))
    if !take(p, ",") { break }
  }
  end := p.token.end
  expect(p, "}")
  return add_node(p, SrcEnum, start, end, first)
}

fn src_declaration_keyword(p: *Parser) bool {
  if src_distinct(p) || src_packed(p) || src_nocopy(p) { return true }
  keywords: [8][]const u8 = ["fn", "pub", "const", "extern", "struct", "enum", "type", "use"]
  for keyword in keywords {
    if token_is(p, keyword) { return true }
  }
  return false
}

fn src_use(p: *Parser) u32 {
  start := p.token.start
  first := None
  last := None
  expect(p, "use")
  for {
    begin := p.token.start
    item_first := None
    item_last := None
    if p.token.kind == TokenKind.Name {
      chain(p, &item_first, &item_last, parse_name(p))
    }
    chain(p, &item_first, &item_last, src_literal(p, TokenKind.Text, ExpString))
    if !p.tree.failed && p.token.kind == TokenKind.Name && !p.token.newline && !src_declaration_keyword(p) {
      fail(p, p.token.start, "import alias comes before the path: write `use alias \"path\"`")
      return None
    }
    chain(p, &first, &last, add_node(p, SrcImport, begin, src_end(p, item_last, begin), item_first))
    if !take(p, ",") || p.tree.failed { break }
  }
  return add_node(p, SrcUse, start, src_end(p, last, start), first)
}

fn src_assert(p: *Parser) u32 {
  start := p.token.start
  first := None
  last := None
  expect(p, "#assert")
  expect(p, "(")
  chain(p, &first, &last, expression(p, 0))
  if take(p, ",") {
    chain(p, &first, &last, src_literal(p, TokenKind.Text, ExpString))
  }
  end := p.token.end
  expect(p, ")")
  return add_node(p, SrcAssert, start, end, first)
}

fn src_directive(p: *Parser) u32 {
  target := token_is(p, "#target")
  start := p.token.start
  first := None
  last := None
  lex(p)
  expect(p, "(")
  if target {
    for {
      begin := p.token.start
      condition_first := None
      condition_last := None
      chain(p, &condition_first, &condition_last, parse_name(p))
      expect(p, ":")
      if p.token.kind == TokenKind.Number {
        chain(p, &condition_first, &condition_last, src_literal(p, TokenKind.Number, ExpNumber))
      } else {
        chain(p, &condition_first, &condition_last, parse_name(p))
      }
      chain(p, &first, &last, add_node(p, SrcTargetCondition, begin, src_end(p, condition_last, begin), condition_first))
      if !take(p, ",") || p.tree.failed { break }
    }
  } else {
    chain(p, &first, &last, src_literal(p, TokenKind.Text, ExpString))
  }
  end := p.token.end
  expect(p, ")")
  kind := SrcLink
  if target {
    kind = SrcTarget
  }
  return add_node(p, kind, start, end, first)
}

fn src_declaration(p: *Parser) u32 {
  if token_is(p, "#target") || token_is(p, "#link") { return src_directive(p) }
  start := p.token.start
  child := None
  public := take(p, "pub")
  if token_is(p, "fn") {
    child = src_function(p, false)
  } else if token_is(p, "extern") {
    if src_next_is(p, "fn") {
      child = src_function(p, true)
    } else {
      begin := p.token.start
      first := None
      last := None
      lex(p)
      chain(p, &first, &last, parse_name(p))
      if p.token.kind == TokenKind.Text {
        chain(p, &first, &last, src_literal(p, TokenKind.Text, ExpString))
      }
      chain(p, &first, &last, src_qualifier(p))
      child = add_node(p, SrcExternVariable, begin, src_end(p, last, begin), first)
    }
  } else if token_is(p, "struct") || src_packed(p) || src_nocopy(p) {
    child = src_struct(p)
  } else if token_is(p, "enum") {
    child = src_enum(p)
  } else if token_is(p, "const") {
    child = src_const(p)
  } else if token_is(p, "type") || src_distinct(p) {
    child = src_alias(p)
  } else if !public && token_is(p, "use") {
    child = src_use(p)
  } else if !public && token_is(p, "#assert") {
    child = src_assert(p)
  } else if !public && (token_is(p, "import") || token_is(p, "package")) &&
    (src_peek(p).kind == TokenKind.Name || src_peek(p).kind == TokenKind.Text) {
    fail(p, p.token.start, "Dyn imports a module with use, as in use \"std/io\"")
  } else if p.token.kind == TokenKind.Name && src_peek(p).kind == TokenKind.End {
    // A dangling declaration name is the offending token, not the empty
    // position after its trailing newline. Editors need a visible range.
    fail(p, p.token.start, "incomplete or invalid syntax")
  } else {
    child = src_variable(p)
  }
  flags: u16
  if public {
    flags = FlagPublic
  }
  return mark(p, add_node(p, SrcDeclaration, start, src_end(p, child, start), child), flags)
}

// Links parents over reachable nodes, charging the same work as finish_tree.
fn finish_tree(p: *Parser, root: u32) bool {
  id := root
  p.tree.nodes[root].parent = None
  for {
    if !charge(p, 1, p.tree.nodes[id].start) { return false }
    child := p.tree.nodes[id].first
    for child != None {
      if !charge(p, 1, p.tree.nodes[child].start) { return false }
      p.tree.nodes[child].parent = id
      child = p.tree.nodes[child].next
    }
    if p.tree.nodes[id].first != None {
      id = p.tree.nodes[id].first
      continue
    }
    for id != root && p.tree.nodes[id].next == None {
      if !charge(p, 1, p.tree.nodes[id].start) { return false }
      id = p.tree.nodes[id].parent
    }
    if id == root { break }
    id = p.tree.nodes[id].next
  }
  return true
}

// Fail-fast equivalent of exp_parse_source. Returns the root or None.
fn parse_source(source: []const u8, tree: *Tree, arena: *mem.Arena) u32 {
  tree.* = Tree{}
  if source.len >= 0xFFFFFFFF {
    tree.failed = true
    tree.error = "invalid source or source too large"
    tree.error_kind = ErrorKind.Limit
    return None
  }
  length := #cast(u32, source.len)
  work_remaining := #cast(u64, length) * 128 + 1024
  p := Parser{ text: source, length: length, work_remaining: &work_remaining, tree: tree, arena: arena }
  if !charge(&p, #cast(u64, length), 0) { return None }
  // Sources are text: NUL is never valid, even in comments or literals.
  nul := bytes.find_byte(source, 0)
  if nul < source.len {
    fail(&p, #cast(u32, nul), "unexpected character")
    return None
  }
  lex(&p)
  first := None
  last := None
  for p.token.kind != TokenKind.End && !tree.failed {
    offset := p.token.start
    chain(&p, &first, &last, src_declaration(&p))
    if !tree.failed && p.token.start == offset {
      fail(&p, offset, "source parser made no progress")
    }
  }
  p.scan_next = 0
  if tree.failed { return None }
  start: u32
  for start < length && space(source[start]) {
    if !scan_byte(&p, start) { return None }
    start += 1
  }
  root := add_node(&p, SrcFile, start, length, first)
  if tree.failed { return None }
  if !finish_tree(&p, root) { return None }
  return root
}
