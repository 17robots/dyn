use "std/fail"
use "std/fs" fs
use "std/bytes" bytes

fn check(ok: bool, message: []const u8) {
  if !ok {
    #panic(message)
  }
}

// Removes what main makes. Cleanup: each step has its own status, so a
// missing entry does not stop the rest.
fn clean() {
  paths: [3][]const u8 = ["listing/alpha.txt", "listing/βeta.txt", "listing/renamed.txt"]
  for path in paths {
    status: fail.Status
    fs.remove(&status, path)
  }
  inner: fail.Status
  fs.remove_directory(&inner, "listing/inner")
  outer: fail.Status
  fs.remove_directory(&outer, "listing")
}

fn main() {
  clean()
  status: fail.Status
  fs.make_directory_exclusive(&status, "listing", 493)
  fs.make_directory_exclusive(&status, "listing/inner", 493)
  fs.make_directory(&status, "listing/inner")
  fs.write_all(&status, "listing/alpha.txt", "a")
  fs.write_all(&status, "listing/βeta.txt", "b")
  check(!status.failed, "make and write")
  storage: [4096]u8
  directory := fs.open_directory(&status, "listing", storage[..])
  seen_alpha := false
  seen_beta := false
  seen_inner := false
  count := 0
  for true {
    entry := fs.directory_next(&status, &directory)
    if directory.ended { break }
    count += 1
    if bytes.equal(entry.name, "alpha.txt") {
      seen_alpha = entry.kind == 8
    }
    if bytes.equal(entry.name, "βeta.txt") {
      seen_beta = entry.kind == 8
    }
    if bytes.equal(entry.name, "inner") {
      seen_inner = entry.kind == 4
    }
  }
  check(!status.failed, "listing error")
  check(count == 3 && seen_alpha && seen_beta && seen_inner, "entries")
  fs.close_directory(&directory)
  inner := fs.open_directory(&status, "listing/inner", storage[..])
  _ = fs.directory_next(&status, &inner)
  check(inner.ended && !status.failed, "empty directory")
  fs.close_directory(&inner)
  missing: fail.Status
  _ = fs.open_directory(&missing, "missing-directory", storage[..])
  check(missing.failed && missing.failure.kind == fail.Kind.NotFound, "missing")
  info := fs.metadata(&status, "listing/alpha.txt")
  check(!status.failed && info.size == 1 && fs.is_file(info), "file metadata")
  folder := fs.metadata(&status, "listing/inner")
  check(!status.failed && fs.is_directory(folder), "directory metadata")
  fs.rename(&status, "listing/alpha.txt", "listing/renamed.txt")
  _ = fs.metadata(&status, "listing/renamed.txt")
  check(!status.failed, "rename")
  gone: fail.Status
  _ = fs.metadata(&gone, "listing/alpha.txt")
  check(gone.failed, "renamed away")
  existing: fail.Status
  fs.make_directory_exclusive(&existing, "listing", 493)
  check(existing.failed && existing.failure.kind == fail.Kind.AlreadyExists, "exclusive")
  clean()
  cleaned: fail.Status
  _ = fs.metadata(&cleaned, "listing")
  check(cleaned.failed, "cleaned up")
}
