use "std/io" io
use "std/fs" fs
use "std/bytes" bytes

fn check(ok: bool, message: []const u8) {
  if !ok {
    #panic(message)
  }
}

fn clean() {
  _ = fs.remove("listing/alpha.txt")
  _ = fs.remove("listing/βeta.txt")
  _ = fs.remove("listing/renamed.txt")
  _ = fs.remove_directory("listing/inner")
  _ = fs.remove_directory("listing")
}

fn main() {
  clean()
  check(!io.failed(fs.make_directory("listing", 493).failure), "make directory")
  check(!io.failed(fs.make_directory("listing/inner", 493).failure), "make inner")
  check(!io.failed(fs.write_all("listing/alpha.txt", "a").failure), "alpha")
  check(!io.failed(fs.write_all("listing/βeta.txt", "b").failure), "beta")
  storage: [4096]u8
  opened := fs.open_directory("listing", storage[..])
  check(!io.failed(opened.failure), "open directory")
  directory := opened.value
  seen_alpha := false
  seen_beta := false
  seen_inner := false
  count := 0
  for true {
    entry := fs.directory_next(&directory)
    if !entry.found {
      check(entry.failure.native == 0, "listing error")
      break
    }
    count += 1
    if bytes.equal(entry.name, "alpha.txt") {
      seen_alpha = entry.kind == 8
    }
    if bytes.equal(entry.name, "βeta.txt") {
      seen_beta = entry.kind == 8
    }
    if bytes.equal(entry.name, "inner") {
      seen_inner = entry.kind == 4
    }
  }
  check(count == 3 && seen_alpha && seen_beta && seen_inner, "entries")
  fs.close_directory(&directory)
  empty := fs.open_directory("listing/inner", storage[..])
  check(!io.failed(empty.failure), "open empty")
  inner := empty.value
  check(!fs.directory_next(&inner).found, "empty directory")
  fs.close_directory(&inner)
  check(io.failed(fs.open_directory("missing-directory", storage[..]).failure), "missing")
  info := fs.metadata("listing/alpha.txt")
  check(!io.failed(info.failure) && info.size == 1 && (info.mode & 0o170000) == 0o100000, "file metadata")
  folder := fs.metadata("listing/inner")
  check(!io.failed(folder.failure) && (folder.mode & 0o170000) == 0o040000, "directory metadata")
  check(!io.failed(fs.rename("listing/alpha.txt", "listing/renamed.txt").failure), "rename")
  check(io.failed(fs.metadata("listing/alpha.txt").failure) && !io.failed(fs.metadata("listing/renamed.txt").failure), "renamed")
  clean()
  check(io.failed(fs.metadata("listing").failure), "cleaned up")
}
