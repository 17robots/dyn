use fs "std/fs"
use io "std/io"
use bytes "std/bytes"

fn check(ok: bool, message: []const u8) {
  if !ok {
    #panic(message)
  }
}

// Removes what main makes. Cleanup: a missing entry does not stop the rest.
fn clean() {
  paths: [3][]const u8 = ["listing/alpha.txt", "listing/βeta.txt", "listing/renamed.txt"]
  for path in paths {
    fs.remove(path) catch {}
  }
  fs.remove_directory("listing/inner") catch {}
  fs.remove_directory("listing") catch {}
}

fn is_not_found(err: io.IoErr) bool {
  case err {
    .NotFound => { return true }
    _ => { return false }
  }
}

fn is_already_exists(err: io.IoErr) bool {
  case err {
    .AlreadyExists => { return true }
    _ => { return false }
  }
}

fn exists(path: []const u8) bool {
  _ = fs.metadata(path) catch { return false }
  return true
}

fn open_fails_not_found(path: []const u8, storage: []u8) bool {
  directory := fs.open_directory(path, storage) catch err { return is_not_found(err) }
  fs.close_directory(&directory)
  return false
}

fn run() !io.IoErr {
  try fs.make_directory_exclusive("listing", 493)
  try fs.make_directory_exclusive("listing/inner", 493)
  try fs.make_directory("listing/inner")
  try fs.write_all("listing/alpha.txt", "a")
  try fs.write_all("listing/βeta.txt", "b")
  storage: [4096]u8
  directory := try fs.open_directory("listing", storage[..])
  seen_alpha := false
  seen_beta := false
  seen_inner := false
  count := 0
  for true {
    entry := try fs.directory_next(&directory)
    if directory.ended { break }
    count += 1
    if bytes.equal(entry.name, "alpha.txt") {
      seen_alpha = entry.kind == .File
    }
    if bytes.equal(entry.name, "βeta.txt") {
      seen_beta = entry.kind == .File
    }
    if bytes.equal(entry.name, "inner") {
      seen_inner = entry.kind == .Directory
    }
  }
  check(count == 3 && seen_alpha && seen_beta && seen_inner, "entries")
  fs.close_directory(&directory)
  inner := try fs.open_directory("listing/inner", storage[..])
  _ = try fs.directory_next(&inner)
  check(inner.ended, "empty directory")
  fs.close_directory(&inner)
  check(open_fails_not_found("missing-directory", storage[..]), "missing")
  info := try fs.metadata("listing/alpha.txt")
  check(info.size == 1 && fs.is_file(info), "file metadata")
  folder := try fs.metadata("listing/inner")
  check(fs.is_directory(folder), "directory metadata")
  try fs.rename("listing/alpha.txt", "listing/renamed.txt")
  _ = try fs.metadata("listing/renamed.txt")
  check(!exists("listing/alpha.txt"), "renamed away")
  existing := false
  fs.make_directory_exclusive("listing", 493) catch err { existing = is_already_exists(err) }
  check(existing, "exclusive")
}

fn main() {
  clean()
  run() catch { #panic("directory operations") }
  clean()
  check(!exists("listing"), "cleaned up")
}
