use "std/terminal" terminal
use "std/io" errors
fn check(ok: bool) {
  if !ok {
    #panic("terminal")
  }
}

pub fn main() {
  zero: terminal.State
  check(zero.bytes[0] == 0)
  check(!terminal.is_attached(-1))
  bad := terminal.raw(-1)
  check(bad.failure.kind != errors.Kind.Ok)
  check(terminal.restore(0, nil).failure.kind == errors.Kind.InvalidInput)
  key := terminal.key_decode("\x1b[A")
  check(key.kind == terminal.KeyKind.Up && key.consumed == 3)
  if terminal.is_attached(0) {
    saved := terminal.raw(0)
    check(saved.failure.kind == errors.Kind.Ok)
    check(terminal.restore(0, &saved.value).failure.kind == errors.Kind.Ok)
    again := terminal.read_state(0)
    check(again.failure.kind == errors.Kind.Ok)
    shown := terminal.size(1)
    check(shown.failure.kind == errors.Kind.Ok && shown.columns == 91 && shown.rows == 37)
  }
}
