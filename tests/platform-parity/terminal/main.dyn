use terminal "std/terminal"
fn check(ok: bool) {
  if !ok {
    #panic("terminal")
  }
}

fn raw_fails(descriptor: isize) bool {
  _ = terminal.raw(descriptor) catch { return true }
  return false
}

// Whether restoring with no saved state fails with InvalidInput.
fn restore_invalid() bool {
  terminal.restore(0, nil) catch err {
    case err {
      .InvalidInput => { return true }
      _ => { return false }
    }
  }
  return false
}

pub fn main() {
  zero: terminal.State
  check(zero.bytes[0] == 0)
  check(!terminal.is_attached(-1))
  check(raw_fails(-1))
  check(restore_invalid())
  key := terminal.key_decode("\x1b[A")
  check(key.kind == terminal.KeyKind.Up && key.consumed == 3)
  if terminal.is_attached(0) {
    saved := terminal.raw(0) catch { #panic("raw") }
    terminal.restore(0, &saved) catch { #panic("restore") }
    _ = terminal.read_state(0) catch { #panic("read state") }
    shown := terminal.size(1) catch { #panic("size") }
    check(shown.columns == 91 && shown.rows == 37)
  }
}
