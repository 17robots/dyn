use pool "std/thread/pool"
use sync "std/sync"
use mem "std/mem"
fn check(ok: bool) {
  if !ok {
    #panic("thread pool")
  }
}

total: sync.AtomicU64
gate: sync.Semaphore
group: pool.Group
shared: *pool.Pool

values: [1001]u64

fn add(value: *u64) {
  _ = sync.fetch_add_u64(&total, value.*)
}

fn blocked(unused: *u8) {
  _ = unused
  sync.semaphore_wait(&gate)
  _ = sync.fetch_add_u64(&total, 1)
}

// Submits two more tasks from inside a running task.
fn spread(unused: *u8) {
  _ = unused
  check(pool.submit(shared, add, &values[10]))
  check(pool.submit(shared, add, &values[20]))
}

fn grouped(unused: *u8) {
  _ = unused
  _ = sync.fetch_add_u64(&total, 1)
  pool.group_done(&group)
}

// Whether starting a pool of no workers fails with InvalidInput.
fn start_invalid(arena: *mem.Arena) bool {
  _ = pool.start(arena, 0, 8, 65536) catch err {
    case err {
      .InvalidInput => { return true }
      _ => { return false }
    }
  }
  return false
}

fn main() {
  arena := mem.arena_alloc(16777216)
  defer {
    mem.arena_release(arena)
  }
  check(start_invalid(arena))
  workers := pool.start(arena, 4, 64, 65536) catch { #panic("start") }
  shared = workers
  for i in 0..1001 {
    values[i] = #cast(u64, i)
  }
  for i in 1..1001 {
    for !pool.submit(workers, add, &values[i]) {
      pool.wait(workers)
    }
  }
  pool.wait(workers)
  check(sync.load_u64(&total) == 500500)
  // A full queue refuses work instead of growing.
  sync.store_u64(&total, 0)
  gate = sync.semaphore(0)
  filled: usize = 0
  for pool.submit<u8>(workers, blocked, nil) {
    filled += 1
  }
  check(filled >= 64 && filled <= 68)
  for i in 0..filled {
    sync.semaphore_post(&gate)
  }
  pool.wait(workers)
  check(sync.load_u64(&total) == #cast(u64, filled))
  sync.store_u64(&total, 0)
  check(pool.submit<u8>(workers, spread, nil))
  pool.wait(workers)
  check(sync.load_u64(&total) == 30)
  sync.store_u64(&total, 0)
  pool.group_add(&group, 50)
  for i in 0..50 {
    check(pool.submit<u8>(workers, grouped, nil))
  }
  pool.group_wait(&group)
  check(sync.load_u64(&total) == 50)
  pool.stop(workers) catch { #panic("stop") }
  check(!pool.submit(workers, add, &values[1]))
}
