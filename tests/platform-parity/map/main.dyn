use "std/fs" fs
use "std/bytes" bytes
use "std/io" errors
fn check(ok: bool) {
  if !ok {
    #panic("fs map")
  }
}

fn main() {
  zero: fs.Mapping
  check(!errors.failed(zero.failure) && #len(zero.value) == 0)
  check(!errors.failed(fs.unmap(&zero).failure))
  closed: fs.File
  check(fs.map(&closed).failure.kind == errors.Kind.InvalidState)
  content: [5000]u8
  for i in 0..#len(content) {
    content[i] = #cast(u8, (i * 7) & 255)
  }
  check(!errors.failed(fs.write_all("map-fixture.bin", content[..]).failure))
  opened := fs.open("map-fixture.bin")
  check(!errors.failed(opened.failure))
  file := opened.value
  head: [3]u8
  check(!errors.failed(fs.read(&file, head[..]).failure))
  mapping := fs.map(&file)
  check(!errors.failed(mapping.failure) && bytes.equal(mapping.value, content[..]))
  check(fs.seek(&file, 0, 1).value == 3)
  fs.close(&file)
  // The view stays valid after its file closes.
  check(mapping.value[4999] == content[4999])
  check(!errors.failed(fs.unmap(&mapping).failure) && #len(mapping.value) == 0 && !errors.failed(mapping.failure))
  check(!errors.failed(fs.write_all("map-empty.bin", "").failure))
  empty_file := fs.open("map-empty.bin")
  check(!errors.failed(empty_file.failure))
  empty_handle := empty_file.value
  empty := fs.map(&empty_handle)
  check(!errors.failed(empty.failure) && #len(empty.value) == 0)
  check(!errors.failed(fs.unmap(&empty).failure))
  fs.close(&empty_handle)
}
