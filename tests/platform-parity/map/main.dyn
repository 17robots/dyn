use "std/fs" fs
use "std/bytes" bytes
use "std/io" errors
fn check(ok: bool) {
  if !ok {
    #panic("fs map")
  }
}

fn main() {
  zero: fs.Mapping
  check(zero.failure.kind == errors.Kind.Ok && #len(zero.value) == 0)
  check(fs.unmap(&zero).failure.kind == errors.Kind.Ok)
  closed: fs.File
  check(fs.map(&closed).failure.kind == errors.Kind.InvalidState)
  content: [5000]u8
  for i in 0..#len(content) {
    content[i] = #cast(u8, (i * 7) & 255)
  }
  check(fs.write_all("map-fixture.bin", content[..]).failure.kind == errors.Kind.Ok)
  opened := fs.open("map-fixture.bin")
  check(opened.failure.kind == errors.Kind.Ok)
  file := opened.value
  head: [3]u8
  check(fs.read(&file, head[..]).failure.kind == errors.Kind.Ok)
  mapping := fs.map(&file)
  check(mapping.failure.kind == errors.Kind.Ok && bytes.equal(mapping.value, content[..]))
  check(fs.seek(&file, 0, 1).value == 3)
  fs.close(&file)
  // The view stays valid after its file closes.
  check(mapping.value[4999] == content[4999])
  check(fs.unmap(&mapping).failure.kind == errors.Kind.Ok && #len(mapping.value) == 0 && mapping.failure.kind == errors.Kind.Ok)
  check(fs.write_all("map-empty.bin", "").failure.kind == errors.Kind.Ok)
  empty_file := fs.open("map-empty.bin")
  check(empty_file.failure.kind == errors.Kind.Ok)
  empty_handle := empty_file.value
  empty := fs.map(&empty_handle)
  check(empty.failure.kind == errors.Kind.Ok && #len(empty.value) == 0)
  check(fs.unmap(&empty).failure.kind == errors.Kind.Ok)
  fs.close(&empty_handle)
}
