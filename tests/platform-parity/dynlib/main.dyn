use "std/fail"
use "std/dynlib" dl

fn check(ok: bool) {
  if !ok {
    #panic("dynlib")
  }
}

pub fn main() {
  missing: fail.Status
  _ = dl.open(&missing, "missing-library-xyz", dl.Now)
  check(missing.failed)
  status: fail.Status
  library := dl.open(&status, library_path, dl.Now)
  found := dl.symbol(&status, library, symbol_name)
  check(!status.failed && found != nil)
  absent: fail.Status
  _ = dl.symbol(&absent, library, "no_such_symbol_xyz")
  check(absent.failed)
  handle := library
  dl.close(&status, &handle)
  check(!status.failed && handle == nil)
}
