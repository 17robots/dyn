use "std/io" io
use "std/dynlib" dl

fn check(ok: bool) {
  if !ok {
    #panic("dynlib")
  }
}

pub fn main() {
  missing := dl.open("missing-library-xyz", dl.Now)
  check(io.failed(missing.failure))
  library := dl.open(library_path, dl.Now)
  check(!io.failed(library.failure))
  found := dl.symbol(library.value, symbol_name)
  check(!io.failed(found.failure) && found.value != nil)
  absent := dl.symbol(library.value, "no_such_symbol_xyz")
  check(io.failed(absent.failure))
  handle := library.value
  check(!io.failed(dl.close(&handle).failure))
  check(handle == nil)
}
