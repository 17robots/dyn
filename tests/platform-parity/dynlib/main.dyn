use dl "std/dynlib"

fn check(ok: bool) {
  if !ok {
    #panic("dynlib")
  }
}

fn open_fails(path: []const u8) bool {
  _ = dl.open(path, dl.Now) catch { return true }
  return false
}

pub fn main() {
  check(open_fails("missing-library-xyz"))
  library := dl.open(library_path, dl.Now) catch { #panic("open") }
  found := dl.symbol(library, symbol_name) catch { #panic("symbol") }
  check(found != nil)
  absent := dl.symbol(library, "no_such_symbol_xyz") catch nil
  check(absent == nil)
  handle := library
  dl.close(&handle) catch { #panic("close") }
  check(handle == nil)
}
