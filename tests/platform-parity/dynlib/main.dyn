use "std/io" io
use "std/dynlib" dl

fn check(ok: bool) {
  if !ok {
    #panic("dynlib")
  }
}

pub fn main() {
  missing := dl.open("missing-library-xyz", dl.Now)
  check(missing.failure.kind != io.Kind.Ok)
  library := dl.open(library_path, dl.Now)
  check(library.failure.kind == io.Kind.Ok)
  found := dl.symbol(library.value, symbol_name)
  check(found.failure.kind == io.Kind.Ok && found.value != nil)
  absent := dl.symbol(library.value, "no_such_symbol_xyz")
  check(absent.failure.kind != io.Kind.Ok)
  handle := library.value
  check(dl.close(&handle).failure.kind == io.Kind.Ok)
  check(handle == nil)
}
