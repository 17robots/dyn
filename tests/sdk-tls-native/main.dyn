use "std/net/tls"
use "std/mem"
fn main() {
  context := tls.client_config_create()
  if !context.ok { #panic("native TLS trust configuration") }
  defer tls.config_destroy(context.value)
  backing: [256]u8 = []
  arena := mem.arena_from_buffer(backing[..])
  held := mem.arena_push(&arena, 1, 1) held.* = 42
  mark := mem.arena_mark(&arena)
  failed := tls.client_connection_create(&arena, context.value, -1, "example.test")
  if failed.ok || failed.value != nil || failed.error != tls.ErrorKind.InvalidArgument { #panic("native TLS invalid descriptor") }
  server := tls.server_config_create(&arena, "/dyn/nonexistent/certificate.pem", "/dyn/nonexistent/key.pem")
  if server.ok || server.value != nil || mem.arena_mark(&arena) != mark || held.* != 42 { #panic("native TLS failed setup rollback") }
  tiny: [1]u8 = []
  exhausted := mem.arena_from_buffer(tiny[..])
  missing := tls.client_connection_create(&exhausted, context.value, 7, "example.test")
  if missing.ok || mem.arena_used(&exhausted) != 0 { #panic("native TLS scratch exhaustion") }
}
