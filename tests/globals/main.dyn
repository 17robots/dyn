struct Pair { left: i32, right: i32 }

counter: i32 = seed()
const Next: i32 = Answer + 1
const Answer: i32 = 40 + 2
const Product: i32 = 6 * 7
const Origin: Pair = Pair{ left: 20, right: 22 }
const Values: [2]i32 = [20, 22]
zero: i32

fn seed() i32 { return Answer }

fn main() {
  if counter != 42 { for {} }
  if zero != 0 { for {} }
  counter += 1
  if counter != 43 { for {} }
  if Next != 43 { for {} }
  if Product != 42 { for {} }
  if Origin.left + Origin.right != 42 { for {} }
  if Values[0] + Values[1] != 42 { for {} }
}
