// Prints the results of std/net/http and std/encoding/json helpers, one per
// line, for tests/http-helpers.py to compare.
use "std/encoding/json"
use "std/fail"
use "std/io"
use "std/net"
use "std/net/http"
use "std/parse"

fn request(raw: []const u8) http.Request {
  framed := http.frame_request(raw, 8192)
  if framed.status != http.FrameStatus.Ready {
    #panic("frame")
  }
  return framed.request
}

// Decodes message one byte at a time, then whole: the data, and where it ends.
fn chunk_pieces(message: []const u8) {
  output: [64]u8
  length: usize = 0
  reader := http.chunk_reader()
  at: usize = 0
  state := "more"
  for at < message.len {
    step := http.chunk_step(&reader, message[at..at + 1]) catch {
      state = "failed"
      break
    }
    for byte in step.data {
      output[length] = byte
      length += 1
    }
    at += step.consumed
    if step.done {
      state = "done"
      break
    }
  }
  io.println("chunks {} {} {} {}", output[..length], state, at, whole_consumed(message))
}

// How far one step over the whole message gets: where it failed, or what it
// consumed.
fn whole_consumed(message: []const u8) usize {
  whole := http.chunk_reader()
  first := http.chunk_step(&whole, message) catch err { return parse.offset(err) }
  return first.consumed
}

fn kind(err: io.IoErr) []const u8 {
  case err {
    .NotFound => { return "NotFound" }
    .InvalidInput => { return "InvalidInput" }
    .Capacity => { return "Capacity" }
    _ => { return "Other" }
  }
}

fn cookie_kind(storage: []u8, item: http.Cookie) []const u8 {
  _ = http.set_cookie(storage, item) catch err { return kind(err) }
  return "Ok"
}

fn event_kind(storage: []u8, event: []const u8, id: []const u8, data: []const u8) []const u8 {
  _ = http.sse_event(storage, event, id, data) catch err { return kind(err) }
  return "Ok"
}

fn date_kind(text: []const u8) []const u8 {
  _ = http.parse_date(text) catch { return "InvalidInput" }
  return "Ok"
}

fn cookie_missing(request: *const http.Request, name: []const u8) bool {
  _ = http.cookie(request, name) catch err {
    case err {
      .NotFound => { return true }
      _ => { return false }
    }
  }
  return false
}

fn main() {
  chunk_pieces("3\r\nabc\r\n4;x=y\r\ndefg\r\n0\r\nX-Sum: 1\r\n\r\nrest")
  chunk_pieces("1\r\nz\r\n0\r\n\r\n")
  chunk_pieces("2\r\nab\r\n0\r\nContent-Length: 2\r\n\r\n")
  chunk_pieces("2\r\nabX\n")
  chunk_pieces("\r\n")
  chunk_pieces("fffffffffffffffff\r\n")
  storage: [512]u8
  io.println("{}", http.format_date(storage[..], 784111777))
  io.println("{}", http.format_date(storage[..], 951782400))
  io.println("{}", http.parse_date("Tue, 29 Feb 2000 00:00:00 GMT") catch 0)
  io.println("{}", date_kind("Sunday, 06-Nov-94 08:49:37 GMT"))
  io.println("{}", http.status_reason(304))
  io.println("{}", http.status_reason(599))
  io.println("{}", http.set_cookie(storage[..], http.Cookie{ name: "sid", value: "abc", path: "/", max_age: 60, http_only: true, secure: true, same_site: http.SameSite.Strict }) catch storage[..0])
  io.println("{}", http.set_cookie(storage[..], http.Cookie{ name: "sid", value: "", max_age: -1 }) catch storage[..0])
  io.println("{}", cookie_kind(storage[..], http.Cookie{ name: "x", value: "a;b" }))
  io.println("{}", cookie_kind(storage[..], http.Cookie{ name: "x", value: "1", same_site: http.SameSite.None }))
  with_cookies := request("GET / HTTP/1.1\r\nHost: x\r\nCookie: a=1; theme=\"dark\"\r\nCookie: sid=s3\r\n\r\n")
  theme := http.cookie(&with_cookies, "theme") catch "?"
  sid := http.cookie(&with_cookies, "sid") catch "?"
  io.println("{} {} {}", theme, sid, cookie_missing(&with_cookies, "nope"))
  event := http.sse_event(storage[..], "update", "42", "one\r\ntwo\nthree") catch storage[..0]
  io.print("{}", event)
  io.println("{}", event_kind(storage[..], "bad\nname", "", "x"))
  io.println("{} {} {}", http.content_type("app.JS"), http.content_type("dir.v1/file"), http.content_type("logo.svg"))
  encodings := request("GET / HTTP/1.1\r\nHost: x\r\nAccept-Encoding: br;q=1.0, gzip;q=0, *;q=0.5\r\n\r\n")
  io.println("{} {} {}", http.accepts_encoding(&encodings, "gzip"), http.accepts_encoding(&encodings, "br"), http.accepts_encoding(&encodings, "zstd"))
  conditional := request("GET / HTTP/1.1\r\nHost: x\r\nIf-None-Match: \"a\", W/\"b\"\r\n\r\n")
  io.println("{} {} {}", http.etag_matches(&conditional, "\"b\""), http.etag_matches(&conditional, "W/\"a\""), http.etag_matches(&conditional, "\"c\""))
  form := request("POST /up HTTP/1.1\r\nHost: x\r\nContent-Type: multipart/form-data; boundary=B\r\nContent-Length: 163\r\n\r\n--B\r\nContent-Disposition: form-data; name=\"title\"\r\n\r\nhi\r\n--B\r\nContent-Disposition: form-data; name=\"f\"; filename=\"a.txt\"\r\nContent-Type: text/plain\r\n\r\nx\r\ny\r\n--B--\r\n")
  parts := http.multipart(&form) catch { #panic("multipart") }
  for true {
    part := http.next_part(&parts) catch err {
      io.println("parts end {}", kind(err))
      break
    }
    if parts.ended {
      io.println("parts end Ok")
      break
    }
    io.println("part {} {} {} {}", part.name, part.filename, part.content_type, part.body.len)
  }
  out_status: fail.Status
  out := json.writer(&out_status, storage[..])
  json.object_begin(&out)
  json.key(&out, "a")
  json.array_begin(&out)
  json.integer(&out, -1)
  json.unsigned(&out, 18446744073709551615)
  json.float(&out, 0.1)
  json.boolean(&out, false)
  json.null(&out)
  json.text(&out, "q\"\\\n ")
  json.raw(&out, "{\"x\":1}")
  json.array_end(&out)
  json.key(&out, "b")
  json.object_begin(&out)
  json.object_end(&out)
  json.object_end(&out)
  io.println("{}", json.output(&out))
  unfinished_status: fail.Status
  unfinished := json.writer(&unfinished_status, storage[..])
  json.array_begin(&unfinished)
  io.println("{} {}", unfinished_status.failed, json.output(&unfinished).len)
  wrong_status: fail.Status
  wrong := json.writer(&wrong_status, storage[..])
  json.object_begin(&wrong)
  json.integer(&wrong, 1)
  io.println("{}", wrong_status.failed)
  buckets: [16]http.Bucket
  limit := http.limiter(buckets[..], 3, 1, 1000)
  allowed: usize = 0
  for i in 0..10 {
    if http.allow_at(&limit, 7, 0) {
      allowed += 1
    }
  }
  io.println("limit {} {} {} {}", allowed, http.allow_at(&limit, 7, 500), http.allow_at(&limit, 7, 1000), http.allow_at(&limit, 8, 1000))
  six := net.Ip{ length: 16 }
  six.bytes[0] = 0x20
  six.bytes[1] = 0x01
  six.bytes[2] = 0x0d
  six.bytes[3] = 0xb8
  six.bytes[11] = 1
  six.bytes[15] = 1
  address_text: [64]u8
  io.println("{}", net.ip_text(address_text[..], six))
  tiny: [4]u8
  small_status: fail.Status
  small := json.writer(&small_status, tiny[..])
  json.text(&small, "too long")
  io.println("{}", small_status.failed)
}
