// Prints the results of std/net/http and std/encoding/json helpers, one per
// line, for tests/http-helpers.py to compare.
use "std/encoding/json"
use "std/fail"
use "std/io"
use "std/net"
use "std/net/http"

fn request(raw: []const u8) http.Request {
  framed := http.frame_request(raw, 8192)
  if framed.status != http.FrameStatus.Ready {
    #panic("frame")
  }
  return framed.request
}

// Decodes message one byte at a time, then whole: the data, and where it ends.
fn chunk_pieces(message: []const u8) {
  output: [64]u8
  length: usize = 0
  reader := http.chunk_reader()
  at: usize = 0
  state := "more"
  status: fail.Status
  for at < #len(message) {
    step := http.chunk_step(&status, &reader, message[at..at + 1])
    for byte in step.data {
      output[length] = byte
      length += 1
    }
    at += step.consumed
    if status.failed {
      state = "failed"
      break
    }
    if step.done {
      state = "done"
      break
    }
  }
  whole := http.chunk_reader()
  whole_status: fail.Status
  first := http.chunk_step(&whole_status, &whole, message)
  io.println("chunks {} {} {} {}", output[..length], state, at, first.consumed)
}

fn main() {
  chunk_pieces("3\r\nabc\r\n4;x=y\r\ndefg\r\n0\r\nX-Sum: 1\r\n\r\nrest")
  chunk_pieces("1\r\nz\r\n0\r\n\r\n")
  chunk_pieces("2\r\nab\r\n0\r\nContent-Length: 2\r\n\r\n")
  chunk_pieces("2\r\nabX\n")
  chunk_pieces("\r\n")
  chunk_pieces("fffffffffffffffff\r\n")
  storage: [512]u8
  io.println("{}", http.format_date(storage[..], 784111777))
  io.println("{}", http.format_date(storage[..], 951782400))
  date: fail.Status
  io.println("{}", http.parse_date(&date, "Tue, 29 Feb 2000 00:00:00 GMT"))
  _ = http.parse_date(&date, "Sunday, 06-Nov-94 08:49:37 GMT")
  io.println("{}", date.failure.kind)
  io.println("{}", http.status_reason(304))
  io.println("{}", http.status_reason(599))
  cookies: fail.Status
  io.println("{}", http.set_cookie(&cookies, storage[..], http.Cookie{ name: "sid", value: "abc", path: "/", max_age: 60, http_only: true, secure: true, same_site: http.SameSite.Strict }))
  io.println("{}", http.set_cookie(&cookies, storage[..], http.Cookie{ name: "sid", value: "", max_age: -1 }))
  bad_value: fail.Status
  _ = http.set_cookie(&bad_value, storage[..], http.Cookie{ name: "x", value: "a;b" })
  io.println("{}", bad_value.failure.kind)
  insecure: fail.Status
  _ = http.set_cookie(&insecure, storage[..], http.Cookie{ name: "x", value: "1", same_site: http.SameSite.None })
  io.println("{}", insecure.failure.kind)
  with_cookies := request("GET / HTTP/1.1\r\nHost: x\r\nCookie: a=1; theme=\"dark\"\r\nCookie: sid=s3\r\n\r\n")
  cookie_reads: fail.Status
  theme := http.cookie(&cookie_reads, &with_cookies, "theme")
  sid := http.cookie(&cookie_reads, &with_cookies, "sid")
  absent: fail.Status
  _ = http.cookie(&absent, &with_cookies, "nope")
  io.println("{} {} {}", theme, sid, absent.failure.kind == fail.Kind.NotFound && !cookie_reads.failed)
  events: fail.Status
  event := http.sse_event(&events, storage[..], "update", "42", "one\r\ntwo\nthree")
  io.print("{}", event)
  bad_event: fail.Status
  _ = http.sse_event(&bad_event, storage[..], "bad\nname", "", "x")
  io.println("{}", bad_event.failure.kind)
  io.println("{} {} {}", http.content_type("app.JS"), http.content_type("dir.v1/file"), http.content_type("logo.svg"))
  encodings := request("GET / HTTP/1.1\r\nHost: x\r\nAccept-Encoding: br;q=1.0, gzip;q=0, *;q=0.5\r\n\r\n")
  io.println("{} {} {}", http.accepts_encoding(&encodings, "gzip"), http.accepts_encoding(&encodings, "br"), http.accepts_encoding(&encodings, "zstd"))
  conditional := request("GET / HTTP/1.1\r\nHost: x\r\nIf-None-Match: \"a\", W/\"b\"\r\n\r\n")
  io.println("{} {} {}", http.etag_matches(&conditional, "\"b\""), http.etag_matches(&conditional, "W/\"a\""), http.etag_matches(&conditional, "\"c\""))
  form := request("POST /up HTTP/1.1\r\nHost: x\r\nContent-Type: multipart/form-data; boundary=B\r\nContent-Length: 163\r\n\r\n--B\r\nContent-Disposition: form-data; name=\"title\"\r\n\r\nhi\r\n--B\r\nContent-Disposition: form-data; name=\"f\"; filename=\"a.txt\"\r\nContent-Type: text/plain\r\n\r\nx\r\ny\r\n--B--\r\n")
  reading: fail.Status
  parts := http.multipart(&reading, &form)
  for true {
    part := http.next_part(&reading, &parts)
    if !part.found {
      io.println("parts end {}", reading.failure.kind)
      break
    }
    io.println("part {} {} {} {}", part.value.name, part.value.filename, part.value.content_type, #len(part.value.body))
  }
  out_status: fail.Status
  out := json.writer(&out_status, storage[..])
  json.object_begin(&out)
  json.key(&out, "a")
  json.array_begin(&out)
  json.integer(&out, -1)
  json.unsigned(&out, 18446744073709551615)
  json.float(&out, 0.1)
  json.boolean(&out, false)
  json.null(&out)
  json.text(&out, "q\"\\\n ")
  json.raw(&out, "{\"x\":1}")
  json.array_end(&out)
  json.key(&out, "b")
  json.object_begin(&out)
  json.object_end(&out)
  json.object_end(&out)
  io.println("{}", json.output(&out))
  unfinished_status: fail.Status
  unfinished := json.writer(&unfinished_status, storage[..])
  json.array_begin(&unfinished)
  io.println("{} {}", unfinished_status.failed, #len(json.output(&unfinished)))
  wrong_status: fail.Status
  wrong := json.writer(&wrong_status, storage[..])
  json.object_begin(&wrong)
  json.integer(&wrong, 1)
  io.println("{}", wrong_status.failed)
  buckets: [16]http.Bucket
  limit := http.limiter(buckets[..], 3, 1, 1000)
  allowed: usize = 0
  for i in 0..10 {
    if http.allow_at(&limit, 7, 0) {
      allowed += 1
    }
  }
  io.println("limit {} {} {} {}", allowed, http.allow_at(&limit, 7, 500), http.allow_at(&limit, 7, 1000), http.allow_at(&limit, 8, 1000))
  six := net.Ip{ length: 16 }
  six.bytes[0] = 0x20
  six.bytes[1] = 0x01
  six.bytes[2] = 0x0d
  six.bytes[3] = 0xb8
  six.bytes[11] = 1
  six.bytes[15] = 1
  address_text: [64]u8
  io.println("{}", net.ip_text(address_text[..], six))
  tiny: [4]u8
  small_status: fail.Status
  small := json.writer(&small_status, tiny[..])
  json.text(&small, "too long")
  io.println("{}", small_status.failed)
}
