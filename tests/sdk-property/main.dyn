use "std/testing" testing
fn property(context: rawptr, input: []const u8) bool {
  _ = context
  for byte in input { if byte >= 100 { return false } }
  return true
}
fn main() {
  generator := testing.random(7)
  if testing.random_next(&generator) != 7575888327 { #panic("random sequence") }
  if testing.random_next(&generator) != 8070950887952051652 { #panic("random sequence") }
  if testing.random_next(&generator) != 13931920357059763743 { #panic("random sequence") }
  if testing.random_next(&generator) != 8698583309276795107 { #panic("random sequence") }
  if testing.random_next(&generator) != 8474076621961470850 { #panic("random sequence") }
  work: [128]u8 = []
  result := testing.check_property(testing.PropertyOptions{ seed: 7, cases: 100, shrink_checks: 1000 },work[..],&property,nil)
  if result.passed || #len(result.example) != 1 || result.example[0] != 100 || result.shrink_exhausted { #panic("property shrinking") }
}
