fn main() {
  temporaries()
  i: usize = 0
  total: usize = 0
  for i < 2000000 {
    if i == 0 || i < 2000000 { total += 1 }
    i += 1
  }
  if total != 2000000 { #panic("loop result") }
}

enum Payload { Value: usize, Empty }
fn pair(value: usize) [2]usize { return [value, value + 1] }
fn take(values: ...any) usize {
  case values[0] { is usize value => { return value }, _ => { #panic("any type") } }
}
fn increment(value: *usize) { value.* += 1 }
fn temporaries() {
  i: usize = 0 calls: usize = 0 total: usize = 0
  for i < 200000 {
    defer increment(&calls)
    case Payload.Value(i) { Payload.Value value => { total += value }, _ => { #panic("enum") } }
    for element in pair(i) { total += element }
    total += take(i)
    i += 1
  }
  if calls != 200000 || total != 79999800000 { #panic("temporary loop result") }
}
