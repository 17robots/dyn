use "std/process" process
use "std/mem" mem
use "std/bytes" bytes
fn main() {
  backing: [32768]u8 = [] arena := mem.arena_from_buffer(backing[..])
  output: [65536]u8 = [] errors: [65536]u8 = []
  args: [3][]const u8 = ["sh","-c","printf hello; printf error >&2; exit 7"]
  result := process.capture(&arena,"/bin/sh",args[..],process.options(),output[..],errors[..],2000)
  if !result.ok || result.exit.code != 7 || !bytes.equal(result.output,"hello") || !bytes.equal(result.errors,"error") || arena.offset != 0 { #panic("capture") }
  missing := process.spawn(&arena,"/no/such/dyn-program",args[..],process.options())
  if missing.ok || missing.error != -2 { #panic("exec failure") }
  limited: [1]u8 = []
  overflow := process.capture(&arena,"/bin/sh",args[..],process.options(),limited[..],errors[..],2000)
  if overflow.ok || !overflow.limit_reached { #panic("limit") }
  args[2] = "while :; do :; done"
  timeout := process.capture(&arena,"/bin/sh",args[..],process.options(),output[..],errors[..],20)
  if timeout.ok || !timeout.timed_out { #panic("timeout") }
}
