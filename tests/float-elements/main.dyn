fn add64(c: []f64, b: []f64, v: f64, p: usize, q: usize, n: usize) {
  for j in 0..n {
    c[p + j] += v * b[q + j]
  }
}
fn sub32(c: []f32, b: []f32, v: f32, n: usize) {
  for j in 0..n {
    c[j] -= b[j] * v
  }
}
fn check(ok: bool) {
  if !ok {
    #panic("float elements")
  }
}
fn fill(values: []f64) {
  for i in 0..#len(values) {
    values[i] = 1.0 + #cast(f64, i) * 0.25
  }
}
fn main() {
  a: [40]f64
  b: [40]f64
  expect: [40]f64
  for n in 0..17 {
    for shift in 0..4 {
      /* Separate arrays. */
      fill(a[0..40])
      fill(b[0..40])
      fill(expect[0..40])
      add64(a[0..40], b[0..40], 3.0, shift, 2, n)
      for j in 0..n {
        expect[shift + j] = expect[shift + j] + 3.0 * b[2 + j]
      }
      for i in 0..40 {
        check(a[i] == expect[i])
      }
      /* One array overlapped at every small distance, both directions. */
      fill(a[0..40])
      fill(expect[0..40])
      add64(a[0..40], a[0..40], 0.5, shift, 2, n)
      for j in 0..n {
        expect[shift + j] = expect[shift + j] + 0.5 * expect[2 + j]
      }
      for i in 0..40 {
        check(a[i] == expect[i])
      }
    }
  }
  c: [9]f32
  d: [9]f32
  for i in 0..9 {
    c[i] = 10.0
    d[i] = #cast(f32, i)
  }
  sub32(c[0..9], d[0..9], 2.0, 9)
  for i in 0..9 {
    check(c[i] == 10.0 - #cast(f32, i) * 2.0)
  }
}
