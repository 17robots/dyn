use "std/net/websocket" websocket
use "std/net/http" http
use "std/io" stream
fn equal(a: []const u8, b: []const u8) bool { if #len(a) != #len(b) { return false } i: usize = 0 for i < #len(a) { if a[i] != b[i] { return false } i += 1 } return true }
fn main() {
  request_storage: [256]u8 = []
  request_bytes := http.write_request(request_storage[..], "POST", "/items", "example.test", "body")
  request_head := http.parse_request(request_bytes)
  if !request_head.ok || request_head.content_length != 4 { #panic("http request") }
  host := http.header(request_bytes, "Host")
  if !host.ok || !equal(host.value, "example.test") { #panic("http header") }
  chunked: []const u8 = "4\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n"
  chunk_storage: [16]u8 = []
  chunks := http.decode_chunked(chunked, chunk_storage[..])
  if !chunks.ok || !equal(chunk_storage[..chunks.count], "Wikipedia") { #panic("http chunked") }
  encoded: [256]u8 = [] decoded: [128]u8 = []
  bytes := websocket.write_frame(encoded[..], 1, "hello", true, true, 287454020)
  frame := websocket.parse_frame(bytes) text := websocket.decode_frame(decoded[..], frame)
  if !frame.ok || frame.opcode != 1 || !frame.final || !frame.masked || frame.consumed != #len(bytes) || !equal(text, "hello") { #panic("websocket roundtrip") }
  fragmented: [2]u8 = [9, 0]
  noncanonical: [4]u8 = [129, 126, 0, 1]
  if websocket.parse_frame(fragmented[..]).ok { #panic("fragmented control accepted") }
  if websocket.parse_frame(noncanonical[..]).ok { #panic("noncanonical length accepted") }
  if #len(websocket.write_frame(encoded[..], 9, decoded[..126], true, false, 0)) != 0 { #panic("large control accepted") }
  accept: [28]u8 = []
  if !equal(websocket.accept(accept[..], "dGhlIHNhbXBsZSBub25jZQ=="), "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=") { #panic("websocket accept") }
  request: []const u8 = "GET /chat HTTP/1.1\r\nHost: server.example.com\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n"
  upgrade := websocket.validate_upgrade_request(request)
  if !upgrade.ok || !equal(upgrade.key, "dGhlIHNhbXBsZSBub25jZQ==") { #panic("upgrade request") }
  response_storage: [256]u8 = [] response := websocket.write_upgrade_response(response_storage[..], upgrade.key)
  if #len(response) == 0 || !websocket.validate_upgrade_response(response, upgrade.key) { #panic("upgrade response") }
  if websocket.validate_upgrade_request("POST / HTTP/1.1\r\n\r\n").ok { #panic("bad upgrade accepted") }

  message: [32]u8 = [] control: [125]u8 = [] state := websocket.WebSocketMessageState{}
  first_bytes := websocket.write_frame(encoded[..], 1, "hel", false, true, 16909060)
  first := websocket.receive(&state, message[..], control[..], websocket.parse_frame(first_bytes))
  if !first.ok || first.kind != websocket.WebSocketEventKind.None { #panic("first fragment") }
  ping_bytes := websocket.write_frame(encoded[..], 9, "?", true, true, 84281096)
  ping := websocket.receive(&state, message[..], control[..], websocket.parse_frame(ping_bytes))
  if ping.kind != websocket.WebSocketEventKind.Ping || !equal(ping.payload, "?") { #panic("interleaved ping") }
  last_bytes := websocket.write_frame(encoded[..], 0, "lo", true, true, 151653132)
  complete := websocket.receive(&state, message[..], control[..], websocket.parse_frame(last_bytes))
  if complete.kind != websocket.WebSocketEventKind.Ready || complete.opcode != 1 || !equal(complete.payload, "hello") { #panic("fragment assembly") }
  if websocket.receive(&state, message[..], control[..], websocket.parse_frame(last_bytes)).kind != websocket.WebSocketEventKind.Error { #panic("orphan continuation") }
  bad_close: [1]u8 = [1]
  close_bytes := websocket.write_frame(encoded[..], 8, bad_close[..], true, false, 0)
  if websocket.receive(&state, message[..], control[..], websocket.parse_frame(close_bytes)).kind != websocket.WebSocketEventKind.Error { #panic("bad close") }
  server := websocket.message_state(true)
  unmasked := websocket.write_frame(encoded[..], 1, "no", true, false, 0)
  if websocket.receive(&server, message[..], control[..], websocket.parse_frame(unmasked)).kind != websocket.WebSocketEventKind.Error { #panic("mask role") }
  invalid_utf8: [2]u8 = [195, 40]
  invalid_text := websocket.write_frame(encoded[..], 1, invalid_utf8[..], true, true, 1)
  if websocket.receive(&server, message[..], control[..], websocket.parse_frame(invalid_text)).kind != websocket.WebSocketEventKind.Error { #panic("text utf8") }
  close_state := websocket.message_state(false) invalid_code: [2]u8 = [3, 237]
  invalid_close := websocket.write_frame(encoded[..], 8, invalid_code[..], true, false, 0)
  if websocket.receive(&close_state, message[..], control[..], websocket.parse_frame(invalid_close)).kind != websocket.WebSocketEventKind.Error { #panic("close code") }

  server_input := stream.cursor("GET /hello HTTP/1.1\r\nHost: example.test\r\n\r\n")
  server_output_storage: [512]u8 = []
  server_output := stream.buffer_writer(server_output_storage[..])
  server_storage: [256]u8 = []
  connection_server := http.server(
    stream.cursor_reader(&server_input),
    stream.buffer_writer_adapter(&server_output),
    server_storage[..],
  )
  received := http.receive(&connection_server)
  if !received.ok || !equal(received.request.method, "GET") || !equal(received.request.target, "/hello") {
    #panic("HTTP server receive")
  }
  sent := http.respond(&received.response, "hello", http.ResponseOptions{ content_type: "text/plain" })
  if !sent.ok || !http.parse_response(stream.buffer_writer_bytes(&server_output)).ok {
    #panic("HTTP server respond")
  }

  stream_output_storage: [512]u8 = []
  stream_output := stream.buffer_writer(stream_output_storage[..])
  response_state := http.Response{ output: stream.buffer_writer_adapter(&stream_output) }
  body_result := http.respond_stream(&response_state, http.ResponseOptions{ content_type: "text/plain" })
  if !body_result.ok { #panic("HTTP stream begin") }
  body_output := http.body_writer(&body_result.body)
  if stream.write_all(body_output, "hello").status != stream.Status.Complete ||
    !http.body_finish(&body_result.body).ok {
    #panic("HTTP stream body")
  }
  streamed := stream.buffer_writer_bytes(&stream_output)
  transfer := http.header(streamed, "Transfer-Encoding")
  if !transfer.ok || !equal(transfer.value, "chunked") { #panic("HTTP stream header") }
}
