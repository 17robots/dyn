// HTTPS through std/net/http/evented with the OpenSSL transport.
//   main CERT.pem KEY.pem
// Prints "port N" once listening on 127.0.0.1; POST /quit stops it.
use "std/bytes"
use "std/fmt"
use "std/fail"
use "std/io"
use "std/mem"
use "std/net"
use "std/net/http"
use "std/net/http/evented"
use "std/net/http/evented/tls" https
use "std/net/tls"
use "std/process"
use "std/thread/posix"
use "std/sync"
use "std/time"

const BigSize: usize = 200 * mem.KiB

struct App {
  quit: sync.AtomicU32,
  big: []u8,
}

fn text(status: *fail.Status, response: *http.Response, body: []const u8) {
  http.respond(status, response, body, http.ResponseOptions{ content_type: "text/plain" })
}

fn handle(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  if bytes.equal(request.path, "/buffered") || bytes.equal(request.path, "/buffered-empty") {
    if #len(http.body_buffer(response, 0)) != 0 || #len(http.body_buffer(response, 0xffffffffffffffff)) != 0 {
      #panic("invalid reservation succeeded")
    }
    body := http.body_buffer(response, BigSize)
    if #len(body) == 0 {
      if bytes.equal(request.path, "/buffered-empty") {
        text(status, response, "")
        return
      }
      text(status, response, app.big)
      return
    }
    if #len(http.body_buffer(response, 1)) != 0 { #panic("second reservation succeeded") }
    oversize: fail.Status
    http.respond_buffered(&oversize, response, BigSize + 1, http.ResponseOptions{})
    if !oversize.failed { #panic("oversize commit succeeded") }
    bad_headers: [1]http.Header = [http.Header{ name: "X-Test", value: "bad\r\nheader" }]
    invalid: fail.Status
    http.respond_buffered(&invalid, response, 1, http.ResponseOptions{ headers: bad_headers[..] })
    if !invalid.failed { #panic("invalid header succeeded") }
    _ = mem.copy(body, app.big)
    length := BigSize
    if bytes.equal(request.path, "/buffered-empty") { length = 0 }
    http.respond_buffered(status, response, length, http.ResponseOptions{ content_type: "text/plain" })
    if status.failed { return }
    second: fail.Status
    http.respond_buffered(&second, response, 1, http.ResponseOptions{})
    if !second.failed { #panic("second commit succeeded") }
    return
  }
  if bytes.equal(request.path, "/health") {
    text(status, response, "ok\n")
    return
  }
  if bytes.equal(request.path, "/echo") {
    text(status, response, request.body)
    return
  }
  if bytes.equal(request.path, "/big") {
    text(status, response, app.big)
    return
  }
  if bytes.equal(request.path, "/quit") {
    sync.store_u32(&app.quit, 1)
    http.respond(status, response, "bye\n", http.ResponseOptions{ content_type: "text/plain", close_connection: true })
    return
  }
  http.respond(status, response, "not found\n", http.ResponseOptions{ status: http.StatusNotFound, content_type: "text/plain" })
}

fn main() i32 {
  arena := mem.arena_alloc(64 * mem.MiB)
  defer mem.arena_release(arena)
  arguments_status: fail.Status
  arguments := process.arguments(arena, &arguments_status)
  if arguments_status.failed || #len(arguments) < 3 || #len(arguments) > 4 {
    io.eprintln("usage: main CERT.pem KEY.pem [h2]")
    return 2
  }
  status: fail.Status
  context := tls.server_config_create(arena, &status, arguments[1], arguments[2])
  if status.failed {
    io.eprintln("cannot load certificate and key")
    return 1
  }
  app := mem.push(App, arena)
  app.big = mem.push_bytes(arena, BigSize)
  for i in 0..BigSize {
    app.big[i] = #cast(u8, 'a' + i % 26)
  }
  typed := http.Typed(App){ state: app, handler: handle }
  binding := http.bind(&typed)
  transport := https.transport(context)
  config := evented.default_config()
  config.connections_per_worker = 16
  config.receive_size = 4 * mem.KiB
  config.send_size = 4 * mem.KiB
  config.overflow_send_size = 256 * mem.KiB
  config.overflow_send_count = 1
  config.idle_timeout_milliseconds = 500
  config.transport = &transport
  h3 := #len(arguments) == 4 && bytes.equal(arguments[3], "h3")
  quic_stack := evented.Quic{}
  if h3 {
    // HTTP/3 needs its own QUIC context with the same certificate.
    quic_context := https.quic_context(arena, &status, arguments[1], arguments[2])
    if status.failed {
      io.eprintln("cannot create the QUIC context")
      return 1
    }
    quic_stack = https.quic(quic_context)
    config.http3 = evented.http3()
    config.quic = &quic_stack
  }
  if #len(arguments) == 4 && (bytes.equal(arguments[3], "h2") || h3) {
    // HTTP/2 through ALPN; frames need 16 KiB of receive buffer.
    offering: fail.Status
    https.offer_http2(&offering, context)
    if offering.failed {
      io.eprintln("cannot offer h2")
      return 1
    }
    config.http2 = evented.http2()
    config.receive_size = 32 * mem.KiB
    config.http2_connections = 8
    config.http2_slots = 8
  }
  // Without a libc-thread spawner, start refuses the OpenSSL transport.
  refused: fail.Status
  _ = evented.start_shared(arena, &refused, mem.push_array(evented.Worker, arena, 1), net.ipv4(127, 0, 0, 1, 0), 1,
    config, binding.handler, binding.context)
  if refused.failure.kind != fail.Kind.InvalidInput {
    io.eprintln("TLS transport started on raw threads")
    return 1
  }
  spawner := posix.spawner()
  config.spawner = &spawner
  workers := mem.push_array(evented.Worker, arena, 2)
  _ = evented.start_shared(arena, &status, workers, net.ipv4(127, 0, 0, 1, 0), 128, config, binding.handler, binding.context)
  if status.failed {
    io.eprintln("cannot start workers")
    return 1
  }
  io.println("port {}", evented.local_port(workers))
  for sync.load_u32(&app.quit) == 0 {
    time.sleep(10 * time.Millisecond)
  }
  evented.stop(workers)
  joined: fail.Status
  evented.join(&joined, workers)
  for worker in workers {
    if worker.send_pool.free_count != config.overflow_send_count { #panic("overflow block leaked") }
  }
  tls.config_release(&context)
  if joined.failed { return 1 }
  return 0
}
