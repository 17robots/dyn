// HTTPS through std/net/http/evented with the OpenSSL transport.
//   main CERT.pem KEY.pem
// Prints "port N" once listening on 127.0.0.1; POST /quit stops it.
use "std/bytes"
use "std/fmt"
use "std/io"
use "std/mem"
use "std/net"
use "std/net/http"
use "std/net/http/evented"
use "std/net/http/evented/tls" https
use "std/net/tls"
use "std/process"
use "std/thread/posix"
use "std/sync"
use "std/time"

const BigSize: usize = 200 * mem.KiB

struct App {
  quit: sync.AtomicU32,
  big: []u8,
}

fn text(response: *http.Response, body: []const u8) http.Result {
  return http.respond(response, body, http.ResponseOptions{ content_type: "text/plain" })
}

fn handle(response: *http.Response, request: *const http.Request, app: *App) http.Result {
  if bytes.equal(request.path, "/health") {
    return text(response, "ok\n")
  }
  if bytes.equal(request.path, "/echo") {
    return text(response, request.body)
  }
  if bytes.equal(request.path, "/big") {
    return text(response, app.big)
  }
  if bytes.equal(request.path, "/quit") {
    sync.store_u32(&app.quit, 1)
    return http.respond(response, "bye\n", http.ResponseOptions{ content_type: "text/plain", close_connection: true })
  }
  return http.respond(response, "not found\n", http.ResponseOptions{ status: http.StatusNotFound, content_type: "text/plain" })
}

fn main() i32 {
  arena := mem.arena_create(64 * mem.MiB)
  defer mem.arena_release(arena)
  arguments := process.arguments(arena)
  if arguments.failure.kind != io.Kind.Ok || #len(arguments.value) != 3 {
    io.eprintln("usage: main CERT.pem KEY.pem")
    return 2
  }
  context := tls.server_config_create(arena, arguments.value[1], arguments.value[2])
  if context.failure.kind != io.Kind.Ok {
    io.eprintln("cannot load certificate and key")
    return 1
  }
  app := mem.push(App, arena)
  app.big = mem.push_bytes_uninit(arena, BigSize)
  for i in 0..BigSize {
    app.big[i] = #cast(u8, 'a' + i % 26)
  }
  typed := http.Typed(App){ state: app, handler: handle }
  binding := http.bind(&typed)
  transport := https.transport(context.value)
  config := evented.default_config()
  config.connections_per_worker = 16
  config.receive_size = 4 * mem.KiB
  config.send_size = 4 * mem.KiB
  config.idle_timeout_milliseconds = 500
  config.transport = &transport
  // Without a libc-thread spawner, start refuses the OpenSSL transport.
  refused := evented.start_shared(arena, mem.push_array(evented.Worker, arena, 1), net.ipv4(127, 0, 0, 1, 0), 1,
    config, binding.handler, binding.context)
  if refused.failure.kind != io.Kind.InvalidInput {
    io.eprintln("TLS transport started on raw threads")
    return 1
  }
  spawner := posix.spawner()
  config.spawner = &spawner
  workers := mem.push_array(evented.Worker, arena, 2)
  started := evented.start_shared(arena, workers, net.ipv4(127, 0, 0, 1, 0), 128, config, binding.handler, binding.context)
  if started.failure.kind != io.Kind.Ok {
    io.eprintln("cannot start workers")
    return 1
  }
  digits: [20 + mem.ArenaBufferOverhead]u8
  scratch := mem.arena_from_buffer(digits[..])
  _ = io.write_all(io.stdout(), "port ")
  _ = io.write_all(io.stdout(), fmt.u64_decimal(scratch, #cast(u64, evented.local_port(workers))))
  _ = io.write_all(io.stdout(), "\n")
  for sync.load_u32(&app.quit) == 0 {
    _ = time.sleep(10 * time.Millisecond)
  }
  evented.stop(workers)
  joined := evented.join(workers)
  tls.config_release(&context.value)
  if joined.failure.kind != io.Kind.Ok {
    return 1
  }
  return 0
}
