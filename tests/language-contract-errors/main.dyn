struct Wrapped { value: any }

global_any: any = 1
fn return_any() any { return 1 }

fn main() {
  raw: rawptr = nil
  invalid := raw.*
  indexed := raw[0]
  arithmetic := raw + 1
  value: any = 1
  case value {
    is i32 number => { _ = number }
  }
  shifted := #cast(u8) 1 << 8
  _ = invalid
  _ = indexed
  _ = arithmetic
  _ = shifted
}

