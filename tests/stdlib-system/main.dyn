use "std/flags" cli
use "std/net"
use "std/os/linux" os
use "std/fs"
use "std/terminal"

fn main() {
  path: []const u8 = "/tmp/dyn-stdlib-system.tmp"
  renamed: []const u8 = "/tmp/dyn-stdlib-system-renamed.tmp"
  _ = fs.remove(path)
  _ = fs.remove(renamed)
  file := fs.create(path)
  if !file.ok { #panic("create") }
  descriptor := file.file
  written := fs.write(&descriptor, "dyn")
  _ = fs.close(&descriptor)
  if !written.ok || written.transferred != 3 { #panic("write") }
  info := fs.metadata(path)
  if !info.ok || info.size != 3 { #panic("metadata") }
  if !fs.rename(path, renamed).ok { #panic("rename") }
  if !fs.remove(renamed).ok { #panic("remove") }

  socket_result := net.socket(net.AddressFamilyIpv4, net.SocketDatagram, 0)
  if !socket_result.ok { #panic("udp socket") }
  socket_descriptor := net.result_value(&socket_result)
  if !net.nonblocking(socket_descriptor, true).ok { #panic("nonblocking") }
  if !net.receive_timeout(socket_descriptor, 5).ok { #panic("receive timeout") }
  if !net.send_timeout(socket_descriptor, 5).ok { #panic("send timeout") }
  _ = net.close(socket_descriptor)

  options: [2]cli.Option = [cli.bool_option("verbose", 'v'), cli.required_string_option("output", 'o')]
  usage_storage: [128]u8 = []
  rendered := cli.usage(usage_storage[..], "tool", options[..])
  if !rendered.ok || #len(rendered.value) == 0 { #panic("usage") }

  state: terminal.State = terminal.State{ bytes: [] }
  _ = terminal.read_state(1, &state)
  _ = terminal.size(1)
  if !os.signal_ignore(13).ok || !os.signal_default(13).ok { #panic("signal") }
}
