use "std/debug" debug
use "std/container/ring" ring
use "std/container/bit_set" bit_set
use "std/testing" testing
use "std/reflect" reflection
use "std/sync" synchronization

fn main() {
  dump_storage: [64]u8 = []
  dumped := debug.hexdump(dump_storage[..], "Dyn", 16)
  testing.expect(dumped.complete && dumped.consumed == 3, "hexdump")
  poisoned: [8]u8 = [] debug.poison(poisoned[..], 165)
  testing.expect(debug.all_equal(poisoned[..], 165), "poison")

  ring_storage: [3]u8 = [] queue := ring.init(ring_storage[..])
  testing.expect(ring.push(&queue, 1) && ring.push(&queue, 2), "ring push")
  byte: u8 = 0 testing.expect(ring.pop(&queue, &byte) && byte == 1, "ring pop")
  words: [1]u64 = []
  testing.expect(bit_set.set(words[..], 42, true) && bit_set.get(words[..], 42), "bitset")

  testing.expect(reflection.category(#typeof([2]u8)) == reflection.Kind.Array, "reflection category")
  testing.expect(reflection.element_is(#typeof([2]u8), #typeof(u8)), "reflection element")

  atomic := synchronization.atomic_u64(40)
  testing.expect(synchronization.fetch_add_u64(&atomic, 2) == 40 && synchronization.load_u64(&atomic) == 42, "atomic")
  lock := synchronization.mutex()
  synchronization.lock(&lock) synchronization.unlock(&lock)
  once := synchronization.once()
  testing.expect(synchronization.once_begin(&once), "once begin")
  synchronization.once_complete(&once)
}
