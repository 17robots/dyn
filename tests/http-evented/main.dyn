// Evented HTTP server under a deliberately small configuration so tests reach
// buffer limits, synchronous large flushes and idle timeouts. Prints "port N"
// once listening on 127.0.0.1; POST /quit stops it. With argument "shared",
// every worker owns an SO_REUSEPORT listener (evented.start_shared).
use "std/bytes"
use "std/fmt"
use "std/html"
use "std/fail"
use "std/io"
use "std/mem"
use "std/net"
use "std/net/http"
use "std/net/http/evented"
use "std/process"
use "std/sync"
use "std/time"

const WorkerCount: usize = 2
const BigSize: usize = 200 * mem.KiB

struct App {
  quit: sync.AtomicU32,
  big: []u8,
  router: http.Routes<App>,
  route_storage: [4]http.TypedRoute<App>,
}

// Test-only plain transport limits kernel buffering so a slow client keeps an
// overflow lease while another connection exercises pool exhaustion.
fn limited_open(data: rawptr, descriptor: isize) rawptr {
  _ = data
  size: i32 = 4096
  if #syscall(54, descriptor, 1, 7, &size, 4) < 0 { return nil }
  return #cast(rawptr, descriptor)
}
fn limited_handshake(session: rawptr) evented.TransportIo {
  _ = session
  return evented.TransportIo{}
}
fn limited_read(session: rawptr, output: []u8) evented.TransportIo {
  result := net.try_receive(#cast(isize, session), output, 0) catch { return evented.TransportIo{ status: evented.TransportStatus.Failed } }
  if result.blocked { return evented.TransportIo{ status: evented.TransportStatus.WouldRead } }
  if result.count == 0 { return evented.TransportIo{ status: evented.TransportStatus.End } }
  return evented.TransportIo{ count: result.count }
}
fn limited_write(session: rawptr, source: []const u8) evented.TransportIo {
  result := net.try_send(#cast(isize, session), source, 0) catch { return evented.TransportIo{ status: evented.TransportStatus.Failed } }
  if result.blocked { return evented.TransportIo{ status: evented.TransportStatus.WouldWrite } }
  return evented.TransportIo{ count: result.count }
}
fn limited_close(session: rawptr) { _ = session }

fn user_post(response: *http.Response, request: *const http.Request, app: *App) !io.IoErr {
  storage: [128]u8
  page := html.writer(nil, storage[..])
  html.markup(&page, html.trusted("user="))
  html.text(&page, try http.param(request, "id"))
  html.markup(&page, html.trusted(" post="))
  html.text(&page, try http.param(request, "post"))
  try text(response, http.StatusOk, html.output(&page).bytes)
}

fn user_create(response: *http.Response, request: *const http.Request, app: *App) !io.IoErr {
  try text(response, http.StatusCreated, "created\n")
}


fn text(response: *http.Response, code: u16, body: []const u8) !io.IoErr {
  try http.respond(response, body, http.ResponseOptions{ status: code, content_type: "text/plain" })
}

// Echoes q, escaped into HTML, with x-tag (or q) as the HX-Trigger header.
fn answer_query(response: *http.Response, request: *const http.Request, q: []const u8) !io.IoErr {
  page_storage: [1024]u8
  page := fmt.buffer(nil, page_storage[..])
  fmt.write(&page, "<p>")
  html.write_escaped(&page, q)
  fmt.write(&page, "</p>")
  trigger := http.request_header(request, "x-tag") catch q
  headers: [1]http.Header = [http.Header{ name: "HX-Trigger", value: trigger }]
  // An invalid header is rejected before anything is written: answer 400.
  http.respond(response, fmt.bytes(&page), http.ResponseOptions{ content_type: "text/html", headers: headers[..] }) catch err {
    case err {
      .InvalidInput => { try text(response, http.StatusBadRequest, "bad header\n") }
      _ => { fail err }
    }
  }
}

fn handle(response: *http.Response, request: *const http.Request, app: *App) !io.IoErr {
  if bytes.equal(request.path, "/buffered") || bytes.equal(request.path, "/buffered-empty") {
    if http.body_buffer(response, 0).len != 0 || http.body_buffer(response, 0xffffffffffffffff).len != 0 {
      #panic("invalid reservation succeeded")
    }
    body := http.body_buffer(response, BigSize)
    if body.len == 0 {
      if bytes.equal(request.path, "/buffered-empty") {
        try text(response, http.StatusOk, "")
        return
      }
      try text(response, http.StatusOk, app.big)
      return
    }
    if http.body_buffer(response, 1).len != 0 { #panic("second reservation succeeded") }
    oversize := false
    http.respond_buffered(response, BigSize + 1, http.ResponseOptions{}) catch { oversize = true }
    if !oversize { #panic("oversize commit succeeded") }
    bad_headers: [1]http.Header = [http.Header{ name: "X-Test", value: "bad\r\nheader" }]
    invalid := false
    http.respond_buffered(response, 1, http.ResponseOptions{ headers: bad_headers[..] }) catch { invalid = true }
    if !invalid { #panic("invalid header succeeded") }
    _ = mem.copy(body, app.big)
    length := BigSize
    if bytes.equal(request.path, "/buffered-empty") { length = 0 }
    good_headers: [1]http.Header = [http.Header{ name: "X-Buffered", value: "yes" }]
    try http.respond_buffered(response, length, http.ResponseOptions{ content_type: "text/plain", headers: good_headers[..] })
    second := false
    http.respond_buffered(response, 1, http.ResponseOptions{}) catch { second = true }
    if !second { #panic("second commit succeeded") }
    return
  }
  if bytes.equal(request.target, "/health") {
    try text(response, http.StatusOk, "ok\n")
    return
  }
  if bytes.equal(request.target, "/echo") {
    try text(response, http.StatusOk, request.body)
    return
  }
  if bytes.equal(request.target, "/big") {
    try text(response, http.StatusOk, app.big)
    return
  }
  if bytes.equal(request.target, "/stream") {
    body := try http.respond_stream(response, http.ResponseOptions{ content_type: "text/plain" })
    writer := http.body_writer(&body)
    for i in 0..3 {
      try io.write(writer, "chunk\n")
    }
    try http.body_finish(&body)
    return
  }
  if bytes.equal(request.path, "/query") {
    // ?q= decoded, escaped into HTML, echoed with a request header as a response header.
    storage: [256]u8
    // No q is an empty search; bad percent-encoding is a bad request.
    q := http.query_value(request, "q", storage[..]) catch err {
      case err {
        .NotFound => {
          try answer_query(response, request, storage[..0])
          return
        }
        _ => {
          try text(response, http.StatusBadRequest, "bad query\n")
          return
        }
      }
    }
    try answer_query(response, request, q)
    return
  }
  if bytes.equal(request.path, "/form") {
    storage: [64]u8
    name := http.form_value(request, "name", storage[..]) catch err {
      case err {
        .NotFound => { try text(response, http.StatusBadRequest, "missing\n") }
        _ => { try text(response, http.StatusBadRequest, "bad form\n") }
      }
      return
    }
    try text(response, http.StatusOk, name)
    return
  }
  if bytes.equal(request.path, "/fail") {
    // Fails before responding: the server answers 500 and closes.
    fail .InvalidInput
  }
  if bytes.equal(request.path, "/twice") {
    try text(response, http.StatusOk, "once\n")
    refused := false
    text(response, http.StatusOk, "twice\n") catch err {
      case err {
        .InvalidInput => { refused = true }
        _ => {}
      }
    }
    if !refused { #panic("a second response was not refused") }
    return
  }
  if bytes.equal(request.path, "/cookies") {
    cookies: [2]http.Cookie = [
      http.Cookie{ name: "theme", value: "dark", path: "/" },
      http.Cookie{ name: "sid", value: "abc", http_only: true, same_site: http.SameSite.Lax },
    ]
    body: []const u8 = "plain\n"
    if http.query_has(request, "debug") {
      body = "debug\n"
    }
    try http.respond(response, body, http.ResponseOptions{ content_type: "text/plain", cookies: cookies[..] })
    return
  }
  if bytes.equal(request.target, "/quit") {
    sync.store_u32(&app.quit, 1)
    try http.respond(response, "bye\n", http.ResponseOptions{ content_type: "text/plain", close_connection: true })
    return
  }
  try text(response, http.StatusNotFound, "not found\n")
}

// The server's 413 replaced by a JSON body.
fn too_large(response: *http.Response, request: *const http.Request) !io.IoErr {
  _ = request
  try http.respond(response, "{\"error\":\"too large\"}", http.ResponseOptions{ status: http.StatusPayloadTooLarge,
    content_type: "application/json" })
}

fn main() {
  arena := mem.arena_alloc(64 * mem.MiB)
  defer mem.arena_release(arena)
  state := mem.push<App>(arena)
  state.big = mem.push_bytes(arena, BigSize)
  for i in 0..BigSize {
    state.big[i] = #cast(u8, 'a' + i % 26)
  }
  state.router = http.typed_routes(state.route_storage[..], state)
  state.router.fallback = handle
  routes := fail.Status{ on_failure: fail.panic_on_failure }
  http.add(&state.router, "GET", "/users/:id/posts/:post", user_post) catch { #panic("add route") }
  http.add(&state.router, "POST", "/users", user_create) catch { #panic("add route") }
  binding := http.bind_routes(&state.router)
  config := evented.default_config()
  config.connections_per_worker = 16
  config.receive_size = 4 * mem.KiB
  config.send_size = 4 * mem.KiB
  config.idle_timeout_milliseconds = 500
  config.on_too_large = too_large
  arguments := process.arguments(arena) catch { #panic("cannot read arguments") }
  shared := arguments.len > 1 && bytes.equal(arguments[1], "shared")
  pooled := arguments.len > 1 && bytes.equal(arguments[1], "pooled")
  transport := evented.Transport{ open: limited_open, handshake: limited_handshake, read: limited_read, write: limited_write, close: limited_close }
  worker_count := WorkerCount
  if pooled {
    config.overflow_send_size = 256 * mem.KiB
    config.overflow_send_count = 1
    config.idle_timeout_milliseconds = 30000
    config.transport = &transport
    worker_count = 1
  }
  workers := mem.push_array<evented.Worker>(arena, worker_count)
  listener := net.Listener{}
  status := fail.Status{ on_failure: fail.panic_on_failure }
  if shared {
    evented.start_shared(arena, workers, net.ipv4(127, 0, 0, 1, 0), 128, config, binding.handler, binding.context) catch { #panic("start server") }
  } else {
    address := net.ipv4(127, 0, 0, 1, 0)
    listener = net.tcp_listen_ipv4(&address, 128) catch { #panic("listen") }
    evented.start(arena, workers, &listener, config, binding.handler, binding.context) catch { #panic("start server") }
  }
  io.println("port {}", evented.local_port(workers))
  for sync.load_u32(&state.quit) == 0 {
    time.sleep(10 * time.Millisecond)
  }
  evented.stop(workers)
  joined: fail.Status
  evented.join(workers) catch { #panic("join server") }
  if listener.active {
    net.listener_close(&listener)
  }
  for worker in workers {
    if worker.send_pool.free_count != config.overflow_send_count { #panic("overflow block leaked") }
  }
  if joined.failed {
    #panic("worker failed")
  }
}
