// Evented HTTP server under a deliberately small configuration so tests reach
// buffer limits, synchronous large flushes and idle timeouts. Prints "port N"
// once listening on 127.0.0.1; POST /quit stops it. With argument "shared",
// every worker owns an SO_REUSEPORT listener (evented.start_shared).
use "std/bytes"
use "std/fmt"
use "std/html"
use "std/fail"
use "std/io"
use "std/mem"
use "std/net"
use "std/net/http"
use "std/net/http/evented"
use "std/process"
use "std/sync"
use "std/time"

const WorkerCount: usize = 2
const BigSize: usize = 200 * mem.KiB

struct App {
  quit: sync.AtomicU32,
  big: []u8,
  router: http.Routes<App>,
  route_storage: [4]http.TypedRoute<App>,
}

// Test-only plain transport limits kernel buffering so a slow client keeps an
// overflow lease while another connection exercises pool exhaustion.
fn limited_open(data: rawptr, descriptor: isize) rawptr {
  _ = data
  size: i32 = 4096
  if #syscall(54, descriptor, 1, 7, &size, 4) < 0 { return nil }
  return #cast(rawptr, descriptor)
}
fn limited_handshake(session: rawptr) evented.TransportIo {
  _ = session
  return evented.TransportIo{}
}
fn limited_read(session: rawptr, output: []u8) evented.TransportIo {
  status: fail.Status
  result := net.try_receive(&status, #cast(isize, session), output, 0)
  if status.failed { return evented.TransportIo{ status: evented.TransportStatus.Failed } }
  if result.blocked { return evented.TransportIo{ status: evented.TransportStatus.WouldRead } }
  if result.count == 0 { return evented.TransportIo{ status: evented.TransportStatus.End } }
  return evented.TransportIo{ count: result.count }
}
fn limited_write(session: rawptr, source: []const u8) evented.TransportIo {
  status: fail.Status
  result := net.try_send(&status, #cast(isize, session), source, 0)
  if status.failed { return evented.TransportIo{ status: evented.TransportStatus.Failed } }
  if result.blocked { return evented.TransportIo{ status: evented.TransportStatus.WouldWrite } }
  return evented.TransportIo{ count: result.count }
}
fn limited_close(session: rawptr) { _ = session }

fn user_post(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  storage: [128]u8
  page := html.writer(status, storage[..])
  html.markup(&page, html.trusted("user="))
  html.text(&page, http.param(status, request, "id"))
  html.markup(&page, html.trusted(" post="))
  html.text(&page, http.param(status, request, "post"))
  text(status, response, http.StatusOk, html.output(&page).bytes)
}

fn user_create(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  text(status, response, http.StatusCreated, "created\n")
}


fn text(status: *fail.Status, response: *http.Response, code: u16, body: []const u8) {
  http.respond(status, response, body, http.ResponseOptions{ status: code, content_type: "text/plain" })
}

fn handle(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  if bytes.equal(request.path, "/buffered") || bytes.equal(request.path, "/buffered-empty") {
    if http.body_buffer(response, 0).len != 0 || http.body_buffer(response, 0xffffffffffffffff).len != 0 {
      #panic("invalid reservation succeeded")
    }
    body := http.body_buffer(response, BigSize)
    if body.len == 0 {
      if bytes.equal(request.path, "/buffered-empty") {
        text(status, response, http.StatusOk, "")
        return
      }
      text(status, response, http.StatusOk, app.big)
      return
    }
    if http.body_buffer(response, 1).len != 0 { #panic("second reservation succeeded") }
    oversize: fail.Status
    http.respond_buffered(&oversize, response, BigSize + 1, http.ResponseOptions{})
    if !oversize.failed { #panic("oversize commit succeeded") }
    bad_headers: [1]http.Header = [http.Header{ name: "X-Test", value: "bad\r\nheader" }]
    invalid: fail.Status
    http.respond_buffered(&invalid, response, 1, http.ResponseOptions{ headers: bad_headers[..] })
    if !invalid.failed { #panic("invalid header succeeded") }
    _ = mem.copy(body, app.big)
    length := BigSize
    if bytes.equal(request.path, "/buffered-empty") { length = 0 }
    good_headers: [1]http.Header = [http.Header{ name: "X-Buffered", value: "yes" }]
    http.respond_buffered(status, response, length, http.ResponseOptions{ content_type: "text/plain", headers: good_headers[..] })
    if status.failed { return }
    second: fail.Status
    http.respond_buffered(&second, response, 1, http.ResponseOptions{})
    if !second.failed { #panic("second commit succeeded") }
    return
  }
  if bytes.equal(request.target, "/health") {
    text(status, response, http.StatusOk, "ok\n")
    return
  }
  if bytes.equal(request.target, "/echo") {
    text(status, response, http.StatusOk, request.body)
    return
  }
  if bytes.equal(request.target, "/big") {
    text(status, response, http.StatusOk, app.big)
    return
  }
  if bytes.equal(request.target, "/stream") {
    body := http.respond_stream(status, response, http.ResponseOptions{ content_type: "text/plain" })
    writer := http.body_writer(&body)
    for i in 0..3 {
      io.write_status(status, writer, "chunk\n")
    }
    http.body_finish(status, &body)
    return
  }
  if bytes.equal(request.path, "/query") {
    // ?q= decoded, escaped into HTML, echoed with a request header as a response header.
    storage: [256]u8
    query: fail.Status
    q := http.query_value(&query, request, "q", storage[..])
    // No q is an empty search; bad percent-encoding is a bad request.
    if query.failed && query.failure.kind != fail.Kind.NotFound {
      text(status, response, http.StatusBadRequest, "bad query\n")
      return
    }
    page_storage: [1024]u8
    page := fmt.buffer(status, page_storage[..])
    fmt.write(&page, "<p>")
    html.write_escaped(&page, q)
    fmt.write(&page, "</p>")
    tagged: fail.Status
    tag := http.request_header(&tagged, request, "x-tag")
    trigger: []const u8 = q
    if !tagged.failed {
      trigger = tag
    }
    headers: [1]http.Header = [http.Header{ name: "HX-Trigger", value: trigger }]
    // An invalid header is rejected before anything is written: answer 400.
    sent: fail.Status
    http.respond(&sent, response, fmt.bytes(&page), http.ResponseOptions{ content_type: "text/html", headers: headers[..] })
    if sent.failed && sent.failure.kind == fail.Kind.InvalidInput {
      text(status, response, http.StatusBadRequest, "bad header\n")
      return
    }
    fail.set(status, sent.failure)
    return
  }
  if bytes.equal(request.path, "/form") {
    storage: [64]u8
    form: fail.Status
    name := http.form_value(&form, request, "name", storage[..])
    if form.failed && form.failure.kind == fail.Kind.NotFound {
      text(status, response, http.StatusBadRequest, "missing\n")
      return
    }
    if form.failed {
      text(status, response, http.StatusBadRequest, "bad form\n")
      return
    }
    text(status, response, http.StatusOk, name)
    return
  }
  if bytes.equal(request.path, "/fail") {
    // Fails before responding: the server answers 500 and closes.
    fail.invalid(status, "fail route", "", "failing on purpose")
    return
  }
  if bytes.equal(request.path, "/twice") {
    text(status, response, http.StatusOk, "once\n")
    second: fail.Status
    text(&second, response, http.StatusOk, "twice\n")
    if second.failure.kind != fail.Kind.InvalidState || !bytes.equal(fail.message_text(&second.failure), "already responded") {
      #panic("a second response was not refused")
    }
    return
  }
  if bytes.equal(request.path, "/cookies") {
    cookies: [2]http.Cookie = [
      http.Cookie{ name: "theme", value: "dark", path: "/" },
      http.Cookie{ name: "sid", value: "abc", http_only: true, same_site: http.SameSite.Lax },
    ]
    body: []const u8 = "plain\n"
    if http.query_has(request, "debug") {
      body = "debug\n"
    }
    http.respond(status, response, body, http.ResponseOptions{ content_type: "text/plain", cookies: cookies[..] })
    return
  }
  if bytes.equal(request.target, "/quit") {
    sync.store_u32(&app.quit, 1)
    http.respond(status, response, "bye\n", http.ResponseOptions{ content_type: "text/plain", close_connection: true })
    return
  }
  text(status, response, http.StatusNotFound, "not found\n")
}

// The server's 413 replaced by a JSON body.
fn too_large(status: *fail.Status, response: *http.Response, request: *const http.Request) {
  _ = request
  http.respond(status, response, "{\"error\":\"too large\"}", http.ResponseOptions{ status: http.StatusPayloadTooLarge,
    content_type: "application/json" })
}

fn main() {
  arena := mem.arena_alloc(64 * mem.MiB)
  defer mem.arena_release(arena)
  state := mem.push<App>(arena)
  state.big = mem.push_bytes(arena, BigSize)
  for i in 0..BigSize {
    state.big[i] = #cast(u8, 'a' + i % 26)
  }
  state.router = http.typed_routes(state.route_storage[..], state)
  state.router.fallback = handle
  routes := fail.Status{ on_failure: fail.panic_on_failure }
  http.add(&routes, &state.router, "GET", "/users/:id/posts/:post", user_post)
  http.add(&routes, &state.router, "POST", "/users", user_create)
  binding := http.bind_routes(&state.router)
  config := evented.default_config()
  config.connections_per_worker = 16
  config.receive_size = 4 * mem.KiB
  config.send_size = 4 * mem.KiB
  config.idle_timeout_milliseconds = 500
  config.on_too_large = too_large
  arguments := process.arguments(arena) catch { #panic("cannot read arguments") }
  shared := arguments.len > 1 && bytes.equal(arguments[1], "shared")
  pooled := arguments.len > 1 && bytes.equal(arguments[1], "pooled")
  transport := evented.Transport{ open: limited_open, handshake: limited_handshake, read: limited_read, write: limited_write, close: limited_close }
  worker_count := WorkerCount
  if pooled {
    config.overflow_send_size = 256 * mem.KiB
    config.overflow_send_count = 1
    config.idle_timeout_milliseconds = 30000
    config.transport = &transport
    worker_count = 1
  }
  workers := mem.push_array<evented.Worker>(arena, worker_count)
  listener := net.Listener{}
  status := fail.Status{ on_failure: fail.panic_on_failure }
  if shared {
    _ = evented.start_shared(arena, &status, workers, net.ipv4(127, 0, 0, 1, 0), 128, config, binding.handler, binding.context)
  } else {
    address := net.ipv4(127, 0, 0, 1, 0)
    listener = net.tcp_listen_ipv4(&status, &address, 128)
    _ = evented.start(arena, &status, workers, &listener, config, binding.handler, binding.context)
  }
  io.println("port {}", evented.local_port(workers))
  for sync.load_u32(&state.quit) == 0 {
    time.sleep(10 * time.Millisecond)
  }
  evented.stop(workers)
  joined: fail.Status
  evented.join(&joined, workers)
  if listener.active {
    net.listener_close(&listener)
  }
  for worker in workers {
    if worker.send_pool.free_count != config.overflow_send_count { #panic("overflow block leaked") }
  }
  if joined.failed {
    #panic("worker failed")
  }
}
