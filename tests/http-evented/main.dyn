// Evented HTTP server under a deliberately small configuration so tests reach
// buffer limits, synchronous large flushes and idle timeouts. Prints "port N"
// once listening on 127.0.0.1; POST /quit stops it. With argument "shared",
// every worker owns an SO_REUSEPORT listener (evented.start_shared).
use "std/bytes"
use "std/fmt"
use "std/html"
use "std/io"
use "std/mem"
use "std/net"
use "std/net/http"
use "std/net/http/evented"
use "std/parse"
use "std/process"
use "std/sync"
use "std/time"

const WorkerCount: usize = 2
const BigSize: usize = 200 * mem.KiB

struct App {
  quit: sync.AtomicU32,
  big: []u8,
  router: http.Routes(App),
  route_storage: [4]http.TypedRoute(App),
}

fn user_post(response: *http.Response, request: *const http.Request, app: *App) http.Result {
  storage: [128]u8
  page := html.writer(storage[..])
  html.markup(&page, html.trusted("user="))
  html.text(&page, http.param(request, "id").value)
  html.markup(&page, html.trusted(" post="))
  html.text(&page, http.param(request, "post").value)
  return text(response, http.StatusOk, html.output(&page).bytes)
}

fn user_create(response: *http.Response, request: *const http.Request, app: *App) http.Result {
  return text(response, http.StatusCreated, "created\n")
}


fn text(response: *http.Response, status: u16, body: []const u8) http.Result {
  return http.respond(response, body, http.ResponseOptions{ status: status, content_type: "text/plain" })
}

fn handle(response: *http.Response, request: *const http.Request, app: *App) http.Result {
  if bytes.equal(request.target, "/health") {
    return text(response, http.StatusOk, "ok\n")
  }
  if bytes.equal(request.target, "/echo") {
    return text(response, http.StatusOk, request.body)
  }
  if bytes.equal(request.target, "/big") {
    return text(response, http.StatusOk, app.big)
  }
  if bytes.equal(request.target, "/stream") {
    opened := http.respond_stream(response, http.ResponseOptions{ content_type: "text/plain" })
    if opened.failure.kind != io.Kind.Ok {
      return opened.result
    }
    writer := http.body_writer(&opened.body)
    for i in 0..3 {
      _ = writer.write(writer.data, "chunk\n")
    }
    return http.body_finish(&opened.body)
  }
  if bytes.equal(request.path, "/query") {
    // ?q= decoded, escaped into HTML, echoed with a request header as a response header.
    storage: [256]u8
    q := http.query_value(request, "q", storage[..])
    if q.failure.kind != parse.Kind.Ok {
      return text(response, http.StatusBadRequest, "bad query\n")
    }
    page_storage: [1024]u8
    page := fmt.buffer(page_storage[..])
    _ = fmt.write(&page, "<p>")
    _ = html.write_escaped(&page, q.value)
    _ = fmt.write(&page, "</p>")
    tag := http.request_header(request, "x-tag")
    trigger: []const u8 = q.value
    if tag.found {
      trigger = tag.value
    }
    headers: [1]http.Header = [http.Header{ name: "HX-Trigger", value: trigger }]
    sent := http.respond(response, fmt.bytes(&page), http.ResponseOptions{ content_type: "text/html", headers: headers[..] })
    if sent.detail == http.ErrorKind.Invalid {
      return text(response, http.StatusBadRequest, "bad header\n")
    }
    return sent
  }
  if bytes.equal(request.path, "/form") {
    storage: [64]u8
    name := http.form_value(request, "name", storage[..])
    if !name.found {
      return text(response, http.StatusBadRequest, "missing\n")
    }
    if name.failure.kind != parse.Kind.Ok {
      return text(response, http.StatusBadRequest, "bad form\n")
    }
    return text(response, http.StatusOk, name.value)
  }
  if bytes.equal(request.target, "/quit") {
    sync.store_u32(&app.quit, 1)
    return http.respond(response, "bye\n", http.ResponseOptions{ content_type: "text/plain", close_connection: true })
  }
  return text(response, http.StatusNotFound, "not found\n")
}

fn main() {
  arena := mem.arena_create(64 * mem.MiB)
  defer mem.arena_release(arena)
  state := mem.push(App, arena)
  state.big = mem.push_bytes_uninit(arena, BigSize)
  for i in 0..BigSize {
    state.big[i] = #cast(u8, 'a' + i % 26)
  }
  state.router = http.typed_routes(state.route_storage[..], state)
  state.router.fallback = handle
  if http.add(&state.router, "GET", "/users/:id/posts/:post", user_post).failure.kind != io.Kind.Ok ||
    http.add(&state.router, "POST", "/users", user_create).failure.kind != io.Kind.Ok {
    #panic("cannot add routes")
  }
  binding := http.bind_routes(&state.router)
  config := evented.default_config()
  config.connections_per_worker = 16
  config.receive_size = 4 * mem.KiB
  config.send_size = 4 * mem.KiB
  config.idle_timeout_milliseconds = 500
  arguments := process.arguments(arena)
  shared := arguments.failure.kind == io.Kind.Ok && #len(arguments.value) > 1 && bytes.equal(arguments.value[1], "shared")
  workers := mem.push_array(evented.Worker, arena, WorkerCount)
  listener := net.Listener{}
  started := evented.Result{}
  if shared {
    started = evented.start_shared(arena, workers, net.ipv4(127, 0, 0, 1, 0), 128, config, binding.handler, binding.context)
  } else {
    address := net.ipv4(127, 0, 0, 1, 0)
    listened := net.tcp_listen_ipv4(&address, 128)
    if listened.failure.kind != io.Kind.Ok {
      #panic("cannot listen")
    }
    listener = net.listener_take(&listened.value)
    started = evented.start(arena, workers, &listener, config, binding.handler, binding.context)
  }
  if started.failure.kind != io.Kind.Ok {
    #panic("cannot start workers")
  }
  port := #cast(u64, evented.local_port(workers))
  digits: [20 + mem.ArenaBufferOverhead]u8
  scratch := mem.arena_from_buffer(digits[..])
  _ = io.write_all(io.stdout(), "port ")
  _ = io.write_all(io.stdout(), fmt.u64_decimal(scratch, port))
  _ = io.write_all(io.stdout(), "\n")
  for sync.load_u32(&state.quit) == 0 {
    _ = time.sleep(10 * time.Millisecond)
  }
  evented.stop(workers)
  joined := evented.join(workers)
  if listener.active {
    net.listener_close(&listener)
  }
  if joined.failure.kind != io.Kind.Ok {
    #panic("worker failed")
  }
}
