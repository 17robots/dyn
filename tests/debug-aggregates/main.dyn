struct Point {
  x: i32,
  y: i32,
}

enum(u8) Mode {
  Idle,
  Busy,
}

struct Node {
  value: i32,
  next: *Node,
}

enum Result {
  Ok: i32,
  Error,
}

debug_global: i64 = 77

fn inspect() {
  point := Point{ x: 20, y: 22 }
  values: [3]i32 = [3, 5, 8]
  mode := Mode.Busy
  node := Node{ value: 9, next: nil }
  result := Result.Ok(42)
  marker := point.x + point.y + values[1]
  _ = marker
  _ = mode
  _ = node
  _ = result
}

fn main() { inspect() }
