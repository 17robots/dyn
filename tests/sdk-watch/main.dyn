use "std/fs/watch" watch
use "std/fs" fs
use "std/testing" testing
use "std/fmt" fmt
use "std/bytes" bytes
fn main() {
  name: [256]u8 = [] dir := testing.temporary_directory(name[..],"dyn-watch")
  if !dir.ok { #panic("dir") }
  frames: [2]fs.RemovalFrame = [] scratch: [1024]u8 = []
  defer _ = testing.remove_temporary(&dir.directory,frames[..],scratch[..])
  events: [4096]u8 = [] opened := watch.open(events[..]) if !opened.ok { #panic("watch open") }
  defer _ = watch.close(&opened.watcher)
  added := watch.add(&opened.watcher,dir.directory.path,watch.Changes) if !added.ok { #panic("watch add") }
  path: [512]u8 = [] buffer := fmt.buffer(path[..])
  if !fmt.write_values(&buffer,dir.directory.path,"/file") || !fs.write_all(path[..buffer.length],"x").ok { #panic("file") }
  seen: bool = false
  for {
    item := watch.next(&opened.watcher)
    if item.status == watch.Status.Empty { break }
    if item.status != watch.Status.Event { #panic("event") }
    if item.event.watch == added.value && (item.event.mask & watch.Create) != 0 && bytes.equal(item.event.name,"file") { seen = true }
  }
  if !seen { #panic("missing create") }
  if !watch.remove(&opened.watcher,added.value).ok { #panic("remove watch") }
}
