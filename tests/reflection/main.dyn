struct Point { x, y: i32 }
enum State { Idle, Busy }
struct Node { value: i32, next: *Node }
enum Result { Ok: i32, Error }

fn add(left, right: i32) i32 { return left + right }
fn point_info() TypeInfo { return #typeof(Point) }

fn main() {
  integer := #typeof(i32)
  point := #typeof(Point)
  state := #typeof(State)
  array := #typeof([4]u8)
  byte := #typeof(u8)
  function := #typeof(add)

  if integer.kind != TypeKind.Integer || integer.size != 4 || integer.alignment != 4 { for {} }
  if #len(integer.name) != 3 || integer.name[0] != 'i' { for {} }
  if point.kind != TypeKind.Struct || point.size != 8 || #len(point.name) != 5 { for {} }
  if state.kind != TypeKind.Enum || array.kind != TypeKind.Array { for {} }
  if function.kind != TypeKind.Function || function.size != 0 || function.alignment != 1 { for {} }
  if array.element_id != byte.id { for {} }
  if array.length != 4 || point.member_count != 2 || state.member_count != 2 { for {} }
  if function.parameter_count != 2 || function.result_id != integer.id { for {} }
  if integer.id == point.id { for {} }
  if #len(point.fields) != 2 || point.fields[0].name[0] != 'x' ||
      point.fields[0].type_id != integer.id || point.fields[1].name[0] != 'y' { for {} }
  if #len(state.variants) != 2 || state.variants[0].name[0] != 'I' ||
      state.variants[0].type_id != 0 { for {} }
  if #len(function.arguments) != 2 || function.arguments[0].name[0] != 'l' ||
      function.arguments[1].name[0] != 'r' || function.arguments[0].type_id != integer.id { for {} }
  node := #typeof(Node)
  node_pointer := #typeof(*Node)
  if #len(node.fields) != 2 || node.fields[1].type_id != node_pointer.id { for {} }
  result := #typeof(Result)
  if #len(result.variants) != 2 || result.variants[0].type_id != integer.id ||
      result.variants[1].type_id != 0 { for {} }
  returned := point_info()
  if returned.fields[1].name[0] != 'y' { for {} }
}
