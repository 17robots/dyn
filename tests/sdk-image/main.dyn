use "std/image/qoi" qoi
use "std/image/png" png
use "std/image" image
use "std/image/color" color

fn equal(left: []const u8, right: []const u8) bool {
  if #len(left) != #len(right) { return false }
  i: usize = 0 for i < #len(left) { if left[i] != right[i] { return false } i += 1 }
  return true
}

fn main() {
  pixels: [8]u8 = [255,0,0,255,0,255,0,128]
  encoded_storage: [64]u8 = []
  encoded := qoi.encode(encoded_storage[..], pixels[..], 2, 1, 4, true)
  decoded_storage: [8]u8 = []
  decoded := qoi.decode(decoded_storage[..], encoded.data)
  if !encoded.ok || !decoded.ok || decoded.info.width != 2 || decoded.info.height != 1 ||
    !equal(decoded.pixels, pixels[..]) { #panic("QOI roundtrip") }

  png_bytes: [70]u8 = [137,80,78,71,13,10,26,10,0,0,0,13,73,72,68,82,0,0,0,1,0,0,0,1,8,6,0,0,0,31,21,196,137,0,0,0,13,73,68,65,84,120,156,99,248,207,192,240,31,0,5,0,1,255,137,153,61,29,0,0,0,0,73,69,78,68,174,66,96,130]
  png_pixels: [4]u8 = []
  compressed: [32]u8 = []
  scanlines: [5]u8 = []
  png_result := png.decode(png_pixels[..], compressed[..], scanlines[..], png_bytes[..])
  expected: [4]u8 = [255,0,0,255]
  if !png_result.ok || !equal(png_result.pixels, expected[..]) { #panic("PNG decode") }
  png_encoded: [128]u8 = [] png_encode_scanlines: [5]u8 = [] png_deflated: [32]u8 = []
  png_encoded_result := png.encode(png_encoded[..], png_encode_scanlines[..], png_deflated[..], expected[..], 1, 1, 4)
  roundtrip_pixels: [4]u8 = [] roundtrip_compressed: [32]u8 = [] roundtrip_scanlines: [5]u8 = []
  png_roundtrip := png.decode(roundtrip_pixels[..], roundtrip_compressed[..], roundtrip_scanlines[..], png_encoded_result.data)
  if !png_encoded_result.ok || !png_roundtrip.ok || !equal(png_roundtrip.pixels, expected[..]) { #panic("PNG roundtrip") }

  view := image.view(png_pixels[..], 1, 1, 4, image.Format.Rgba8)
  if view.width != 1 || #len(image.row(&view, 0)) != 4 { #panic("image view") }
  red := color.rgba(255, 0, 0, 128)
  if color.premultiply(red).r != 128 || color.luminance(red) < 53 { #panic("color") }
}
