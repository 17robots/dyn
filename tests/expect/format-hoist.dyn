// A struct argument prints at run time like any other value, from any
// expression and in any position.
use "std/io"
use "std/mem"
use "std/strings"

struct Vec2 { x: i32, y: i32 }

fn spot() Vec2 {
  return Vec2{x: 1, y: 2}
}

fn main() {
  arena := mem.arena_alloc(0)
  ready := true
  if ready && #len(strings.format(arena, "{}", spot())) > 0 {
    io.println("ready")
  }
  defer io.println("{}", spot())
  io.println("{}", spot())
}
