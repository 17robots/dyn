// Templates are ordinary arguments: the compiler checks nothing in them
// (dyn vet does), and a mismatch prints {?} or {+value} at run time.
use "std/io"

fn main() {
  io.println("{} and {}", 1)
  io.println("{}", 1, 2)
  io.println("{:x}", 255)
  io.println("{{}} {}", 3)
  text := "{}"
  io.println(text, 1, 2)
}
