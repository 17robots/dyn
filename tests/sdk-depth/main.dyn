use "std/text/regex" regex
use "std/crypto/sha2" sha2
use "std/crypto/hmac" hmac
use "std/encoding/hex" hexadecimal
use "std/compress/deflate" deflate
use "std/compress/gzip" gzip
use "std/archive/tar" tar
use "std/strings" text
use "std/profile" profile
use "std/io" stream

fn tar_checksum(header: []u8) {
  checksum: u64 = 0 i: usize = 0
  for i < 512 { if i >= 148 && i < 156 { checksum += 32 } else { checksum += #cast(u64) header[i] } i += 1 }
  i = 154 for i > 148 { i -= 1 header[i] = #cast(u8) (checksum % 8) + '0' checksum /= 8 }
  header[154] = 0 header[155] = ' '
}
fn main() {
  found := regex.find("^ab+c.?$", "abbbcZ")
  if !found.ok || found.end != 6 || !regex.matches("^[a-c]+[^0-9]$", "abcz") { #panic("regex") }
  code: [128]regex.Instruction = []
  work: [256]regex.Instruction = []
  scratch: [256]usize = []
  compiled := regex.compile("^(ab|c(d+))$", code[..], work[..], scratch[..])
  captures: [4]regex.Match = []
  if !compiled.ok || !regex.find_compiled(compiled, "cd", captures[..]).ok { #panic("compiled regex") }

  digest: [32]u8 = []
  hex: [64]u8 = []
  sum := sha2.sum256(digest[..], "abc")
  encoded := hexadecimal.encode(hex[..], sum, false)
  if !encoded.ok || !text.equal(encoded.data, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") { #panic("sha256") }
  mac: [32]u8 = []
  if #len(hmac.sha256(mac[..], "key", "message")) != 32 { #panic("hmac") }

  compressed: [11]u8 = [203,72,205,201,201,87,200,64,144,92,0]
  compressed_gzip: [29]u8 = [31,139,8,0,0,0,0,0,2,255,203,72,205,201,201,87,200,64,144,92,0,59,124,138,223,18,0,0,0]
  plain: [32]u8 = []
  inflated := deflate.inflate(plain[..], compressed[..])
  if !inflated.ok || !text.equal(plain[..inflated.written], "hello hello hello\n") { #panic("deflate") }
  unpacked := gzip.decompress(plain[..], compressed_gzip[..])
  if !unpacked.ok || !text.equal(plain[..unpacked.written], "hello hello hello\n") { #panic("gzip") }
  deflate_cursor := stream.cursor(compressed[..])
  deflate_input: [16]u8 = [] deflate_output: [32]u8 = [] deflate_result: [18]u8 = []
  deflate_decoder := deflate.decoder(stream.cursor_reader(&deflate_cursor), deflate_input[..], deflate_output[..])
  deflate_read := stream.read_exact(deflate.decoder_reader(&deflate_decoder), deflate_result[..])
  if deflate_read.status != stream.Status.Complete || !text.equal(deflate_result[..], "hello hello hello\n") { #panic("deflate reader") }
  gzip_cursor := stream.cursor(compressed_gzip[..])
  gzip_input: [32]u8 = [] gzip_output: [32]u8 = [] gzip_result: [18]u8 = []
  gzip_decoder := gzip.decoder(stream.cursor_reader(&gzip_cursor), gzip_input[..], gzip_output[..])
  gzip_read := stream.read_exact(gzip.decoder_reader(&gzip_decoder), gzip_result[..])
  if gzip_read.status != stream.Status.Complete || !text.equal(gzip_result[..], "hello hello hello\n") { #panic("gzip reader") }

  archive: [1024]u8 = []
  archive[0] = 'x' archive[124] = '0' archive[125] = '0' archive[126] = '0' archive[127] = '0'
  archive[128] = '0' archive[129] = '0' archive[130] = '0' archive[131] = '0' archive[132] = '0' archive[133] = '0' archive[134] = '0' archive[156] = '0'
  tar_checksum(archive[..512])
  archive_at := tar.reader(archive[..])
  tar_result := tar.next(&archive_at)
  entry := tar_result.entry
  if tar_result.status != tar.Status.Entry || !text.equal(entry.name, "x") { #panic("tar") }

  events: [1]profile.Event = []
  trace := profile.trace(events[..])
  span := profile.begin("work")
  if !profile.finish(&trace, span) || #len(profile.recorded(&trace)) != 1 { #panic("profile") }
}
