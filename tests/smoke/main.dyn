use "std/mem"
use "std/strings"
fn main() {
  // Buffer arena: this file is also built by the installed preview in CI.
  backing: [4096]u8 = []
  created := mem.arena_from_buffer(backing[..])
  copied := strings.clone(&created, "compiler SDK smoke")
  if !copied.ok || !strings.equal(copied.value, "compiler SDK smoke") { #panic("SDK copy") }
  values: [3]i16 = [10, 20, 12]
  total: i32 = 0
  for value in values { total += #cast(i32) value }
  if total != 42 { #panic("code generation") }
}
