struct Point {
  x, y: i32,
}

packed struct Header {
  tag: u8,
  length: u32,
}

struct Counter {
  n: i32 = 7,
  enabled: bool,
}

struct Wrapper {
  point: Point,
}

struct PointerNode {
  next: *PointerNode,
}

struct SliceNode {
  children: []SliceNode,
}

type NodePointer = *AliasNode

struct AliasNode {
  next: NodePointer,
}

struct MutualLeft {
  right: *MutualRight,
}

struct MutualRight {
  left: MutualLeft,
}

fn main() {
  point := Point{ x: 2, y: 3 }
  other: Point = point
  inferred: Point = .{ x: 4, y: 5 }
  other.x = other.x + other.y
  counter := Counter{ enabled: true }
  header: Header
  wrapper := Wrapper{ point: point }
  wrapper.point.y = 9
  _ = other.x
  _ = inferred.y
  _ = counter.n
  _ = header.tag
  _ = wrapper.point.y
  ok := other.x == 5 && counter.n == 7 && wrapper.point.y == 9
  if !ok {
    divisor := 0
    failure := 1
    failure /= divisor
  }
}
