use "std/mem"
use "std/os/linux" os

fn main() {
  backing: [32768]u8 = []
  arena := mem.arena_from_buffer(backing[..])
  arguments := os.process_arguments(&arena)
  if #len(arguments) != 3 { #panic("argument count mismatch") }
  if #len(arguments[1]) != 5 || arguments[1][0] != 'a' || arguments[1][4] != 'a' {
    #panic("first argument mismatch")
  }
  if #len(arguments[2]) != 4 || arguments[2][0] != 'b' || arguments[2][3] != 'a' {
    #panic("second argument mismatch")
  }
}
