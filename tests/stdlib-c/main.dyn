use "std/c" c

fn main() {
  if #sizeof(c.int) != 4 || #sizeof(c.long) != #sizeof(isize) {
    #panic("C scalar ABI")
  }
  if #sizeof(c.intptr) != #sizeof(rawptr) || #sizeof(c.uintptr) != #sizeof(rawptr) ||
      #sizeof(c.intmax) != 8 || #sizeof(c.uintmax) != 8 {
    #panic("C pointer-width ABI")
  }

  storage: [8]u8 = []
  result := c.string_from_bytes(storage[..], "dyn")
  if !result.ok || result.value == nil || storage[0] != 'd' || storage[1] != 'y' ||
      storage[2] != 'n' || storage[3] != 0 {
    #panic("C string conversion")
  }

  too_small: [3]u8 = []
  if c.string_from_bytes(too_small[..], "dyn").ok {
    #panic("C string capacity")
  }
  view := c.bytes_from_string(result.value, 8)
  if !view.ok || #len(view.value) != 3 || c.errno_from_result(-22) != 22 || !c.succeeded(0) {
    #panic("C views and errno")
  }
}
