use "std/mem" mem
use "std/archive/tar" tar
use "std/encoding/xml" xml
use "std/io" io
use "std/bytes" bytes
fn main() {
  backing: [32]u8 = [] independent: [32]u8 = []
  arena := mem.arena_from_buffer(backing[..]) arena.poison_on_rewind = true
  held := mem.arena_push(&arena, 4, 1) held.* = 42
  mark := mem.arena_mark(&arena)
  _ = mem.arena_push(&arena, 8, 1)
  mem.arena_rewind(&arena, mark)
  if held.* != 42 || backing[4] != 221 || backing[11] != 221 || backing[12] != 0 { #panic("rewind poison range") }
  parent := mem.arena_from_buffer(backing[..])
  alias := mem.arena_from_buffer(backing[8..])
  other := mem.arena_from_buffer(independent[..])
  scratch := mem.scratch_begin(&alias, &other, &parent)
  if scratch.arena != &other { #panic("overlapping scratch backing") }
  mem.scratch_end(&scratch)
  mem.arena_reset(&arena)
  if backing[0] != 221 || mem.arena_used(&arena) != 0 { #panic("reset poison") }
  created := mem.arena_create(64)
  if !created.ok { #panic("owned create") }
  _ = mem.arena_push(&created.arena, 64, 1)
  if !mem.arena_release(&created.arena).ok || !mem.arena_release(&created.arena).ok { #panic("arena release") }
  if #len(created.arena.data) != 0 || created.arena.owns_memory { #panic("release clears arena") }
  chain := mem.growing_create(32)
  value := mem.growing_push(&chain, 1, 1) value.* = 42
  if value.* != 42 || !mem.growing_release(&chain).ok { #panic("growing release") }
  borrowed := mem.arena_from_buffer(independent[..])
  if !mem.arena_release(&borrowed).ok { #panic("borrowed release") }
  independent[0] = 42
  if independent[0] != 42 || #len(borrowed.data) != 0 { #panic("borrowed backing remains alive") }

  archive: [512]u8 = [] tar_reader := tar.reader(archive[..])
  short_reader := tar.reader(archive[..511])
  if tar.next(&tar_reader).status != tar.Status.End || tar_reader.offset != 0 { #panic("tar end") }
  archive[0] = 'x'
  malformed := tar.next(&tar_reader)
  if malformed.status != tar.Status.Error || malformed.error != tar.ErrorKind.Header || tar_reader.offset != 0 { #panic("tar malformed") }
  if tar.next(&short_reader).error != tar.ErrorKind.Truncated { #panic("tar truncated") }
  tar_reader.offset = 513
  if tar.next(&tar_reader).error != tar.ErrorKind.InvalidOffset { #panic("tar invalid offset") }

  document: []const u8 = "<r><![CDATA[<tag>&unescaped; \" >]]></r>"
  stack: [4][]const u8 = []
  if !xml.valid(document, stack[..]) || xml.valid("<![CDATA[ ]]><r/>", stack[..]) || xml.valid("<r><![CDATA[unfinished</r>", stack[..]) { #panic("CDATA validity") }
  scan := xml.scanner(document) _ = xml.next(&scan)
  item := xml.next(&scan)
  if item.event.kind != xml.Kind.Cdata || !bytes.equal(item.event.text, "<tag>&unescaped; \" >") { #panic("CDATA text") }
  chunk: usize = 1
  for chunk <= #len(document) {
    input := Split{ source: document, chunk: chunk }
    storage: [64]u8 = []
    streamed := xml.stream_scanner(io.Reader{ data: #cast(rawptr) &input, read: &read }, storage[..])
    if xml.next_stream(&streamed).event.kind != xml.Kind.Start { #panic("XML start") }
    event := xml.next_stream(&streamed)
    if !event.ok || event.event.kind != xml.Kind.Cdata || !bytes.equal(event.event.text, "<tag>&unescaped; \" >") { #panic("split CDATA") }
    if xml.next_stream(&streamed).event.kind != xml.Kind.End || xml.next_stream(&streamed).ok { #panic("XML end") }
    chunk += 1
  }
}
struct Split { source: []const u8, at: usize, chunk: usize }
fn read(data: rawptr, destination: []u8) io.Result {
  input := #cast(*Split) data
  count := #len(input.source) - input.at
  if count > input.chunk { count = input.chunk }
  if count > #len(destination) { count = #len(destination) }
  _ = mem.copy(destination[..count], input.source[input.at..input.at + count]) input.at += count
  status := io.Status.Complete if input.at == #len(input.source) { status = io.Status.End }
  return io.Result{ transferred: count, status: status }
}
