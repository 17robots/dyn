use "std/io" log

pub struct Point {
  x, y: f32 = 0.0,
}

enum(u8) Result {
  Ok: i32,
  Error,
}

fn syntax(values: []i32, p: *u8) {
  view := values[1..3]
  raw_view := p[0..4]
  for *const item in view {
    if !false {
      case item.* {
        0..=254 => {},
        255 => {},
      }
    }
  }
  bits := #bitcast(f32) 0
  byte := #cast(u8) bits
  defer { _ = byte }
}
