// for x, i and text cases: the forms added by the 2026-11-13 standardization.
use "std/enums"
use "std/io"
use "std/mem"
use "std/strings"

struct Pair { a: i32, b: i32 }
struct Player { health: i32 = 100, armor: i32 }

// A callback and its context: C is inferred through the function's type.
fn run(entry: fn(*$C) i32, context: *$C) i32 {
  if context == nil {
    return -1
  }
  return entry(context)
}

fn armor_of(player: *Player) i32 {
  return player.armor
}

// T{} in a generic body is the instance's own struct literal.
fn fresh(T: type) T {
  return T{}
}
enum(u8) Op { Nop, Add, Sub }
enum(i32) Errno { Ok = 0, NoEnt = 2 }
struct Vec2 { x: f32, y: f32 }
struct Unit { name: []const u8, at: Vec2, op: Op }

fn weighted(values: []const i32) usize {
  sum: usize = 0
  for value, i in values { sum += i * #cast(usize, value) }
  return sum
}

fn kind(word: []const u8) i32 {
  case word {
    "go", "run" => { return 1 }
    "" => { return 2 }
    "stop" => { return 3 }
    _ => { return 0 }
  }
}

fn next(calls: *i32) []const u8 {
  calls.* += 1
  return "edit"
}

fn spot(calls: *i32) Vec2 {
  calls.* += 1
  return Vec2{x: #cast(f32, calls.*), y: 0.5}
}

fn pick(calls: *i32) Op {
  calls.* += 10
  return Op.Add
}

fn where_now(arena: *mem.Arena, calls: *i32) []u8 {
  return strings.format(arena, "at {} after {}", spot(calls), calls.*)
}

fn main() {
  values: [4]i32 = [10, 20, 30, 40]
  for value, i in values { io.println("{} {}", i, value) }
  for *value, i in values { value.* += #cast(i32, i) }
  for value, i in #reverse(values[..]) { io.println("r {} {}", i, value) }
  pairs: [2]Pair = [Pair{a: 1, b: 2}, Pair{a: 3, b: 4}]
  for pair, i in pairs { io.println("p {} {} {}", i, pair.a, pair.b) }
  io.println("weighted {}", weighted(values[..]))
  for byte, i in "hey" { io.println("{} {}", i, byte) }
  for word in ["go", "run", "", "stop", "sto", "stops", "x"] { io.println("{} {}", word, kind(word)) }
  calls: i32 = 0
  case next(&calls) {
    _ => { io.println("only wildcard") }
  }
  case next(&calls) {
    "edit" => { io.println("edit once") }
    _ => { io.println("bad") }
  }
  io.println("calls {}", calls)
  player := fresh(Player)
  io.println("fresh {} {}", player.health, player.armor)
  player.armor = 4
  io.println("run {} {}", run(armor_of, &player), run(armor_of, nil))
  unit := Unit{name: "ada", at: Vec2{x: 1.5, y: 2}, op: Op.Sub}
  // A struct or enum in a literal template prints its contents.
  io.println("unit {} at {} op {} errno {}", unit, unit.at, unit.op, Errno.NoEnt)
  io.println("op {} {}", enums.from_int(Op, 2) == Op.Sub, enums.from_int(Op, 9) == Op.Nop)
  // Any struct or enum expression prints; each argument is evaluated once, in order.
  arena := mem.arena_alloc(0)
  made: i32 = 0
  io.println("spot {} {} {} {}", made, spot(&made), pick(&made), made)
  line := strings.format(arena, "{}", spot(&made))
  io.println("{} made {}", line, made)
  line = strings.format(arena, "{} {}", pairs[made - 11], spot(&made))
  io.println("{}", line)
  io.println("{}", where_now(arena, &made))
  first := &pairs[0]
  io.println("deref {}", first.*)
}
