// distinct, packed and union are reserved keywords; is is an ordinary name.
use "std/io"

distinct type Meters = i64
packed struct Header { tag: u8, size: u32 }

fn describe(value: any) i64 {
  case value {
    i64 number => {
      return number
    }
    bool => {
      return 1
    }
    _ => {
      return 0
    }
  }
}

fn main() {
  length: Meters = #cast(Meters, 4)
  header := Header{tag: 1, size: 2}
  total := 6 + #cast(i64, length) + #cast(i64, header.size)
  total += describe(#cast(i64, 10)) + describe(true)
  case total {
    23 => {
      _ = io.write_all(io.stdout(), "ok\n")
    }
    _ => {
      #panic("contextual keywords")
    }
  }
}
