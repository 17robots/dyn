use "std/io"
use "std/mem"

struct V {
  x: f32,
  y: f32
}

struct W {
  x: f32,
  y: f32,
  z: f32
}

struct P {
  x: f64,
  y: f64
}

struct Q {
  x: f64,
  y: f64,
  z: f64
}

fn wide(f: f64) u64 {
  return #bitcast(u64, f)
}

// Two f64 fields and a running sum.
fn drift(ps: []P, vs: []P, k: f64) f64 {
  e: f64 = 0.25
  for i in 0..#len(ps) {
    ps[i] = P{ x: ps[i].x + vs[i].x * k, y: ps[i].y / (vs[i].y + 2.0) }
    e += ps[i].x * vs[i].y - ps[i].y
  }
  return e
}

// Three f64 fields.
fn twist(qs: []Q, rs: []Q) f64 {
  e: f64 = 0.0
  for i in 0..#len(qs) {
    qs[i] = Q{ x: qs[i].y * rs[i].z, y: qs[i].z - rs[i].x, z: qs[i].x + rs[i].y }
    e -= qs[i].x * rs[i].x + qs[i].y * rs[i].y + qs[i].z * rs[i].z
  }
  return e
}

// One f64 per element.
fn scale(a: []f64, b: []f64, k: f64) f64 {
  t: f64 = 0.0
  for i in 0..#len(a) {
    a[i] = a[i] * k + b[i]
    t += a[i]
  }
  return t
}

// Wrapping i32 lanes without a multiply, and a subtracted sum.
fn blend(a: []i32, b: []i32, k: i32) i32 {
  t: i32 = 7
  for i in 0..#len(a) {
    a[i] = (a[i] + k) ^ (b[i] - 3) | 1
    t -= a[i] & 255
  }
  return t
}

// A multiply, and a u32 sum that wraps.
fn churn(a: []u32, b: []u32) u32 {
  t: u32 = 4000000000
  for i in 0..#len(a) {
    a[i] = a[i] * 2654435761 + b[i]
    t += a[i]
  }
  return t
}

fn bits(f: f32) u32 {
  return #bitcast(u32, f)
}

// Two fields, a running sum, a division and checked indices from start.
fn step(ps: []V, vs: []V, start: usize, end: usize, k: f32) f32 {
  e: f32 = 0.5
  for i in start..end {
    ps[i] = V{ x: ps[i].x + vs[i].x * k, y: ps[i].y / (vs[i].y + 3.0) }
    e += ps[i].x * vs[i].y - ps[i].y
  }
  return e
}

// One field per element and a subtracted sum.
fn flat(a: []f32, b: []f32, n: usize, k: f32) f32 {
  t: f32 = 1.0
  for i in 0..n {
    a[i] = a[i] * k - b[i]
    t -= a[i]
  }
  return t
}

// Three fields per element.
fn spin(ws: []W, us: []W, k: f32) f32 {
  e: f32 = 0.0
  for i in 0..#len(ws) {
    ws[i] = W{ x: ws[i].x + us[i].z * k, y: ws[i].y - us[i].x, z: ws[i].z * us[i].y }
    e += ws[i].x * us[i].x + ws[i].y * us[i].y + ws[i].z * us[i].z
  }
  return e
}

fn main() {
  arena := mem.arena_create(0)
  buffer := mem.push_array(V, arena, 64)
  other := mem.push_array(V, arena, 64)
  for i in 0..64 {
    f := #cast(f32, i)
    buffer[i] = V{ x: f * 0.37, y: 1.0 / (f + 1.0) }
    other[i] = V{ x: 2.0 - f, y: f * f * 0.01 }
  }
  other[9].y = 0.0 / 0.0
  ends: [9]usize = [0, 1, 3, 4, 5, 7, 8, 13, 64]
  for end in ends {
    for first in 0..3 {
      start := #cast(usize, first)
      if start <= end {
        e := step(buffer, other, start, end, 0.25)
        io.println("{} {} {} {} {}", start, end, bits(e), bits(buffer[end / 2].x), bits(buffer[end / 2].y))
      }
    }
  }
  // Overlapping arrays take the scalar loop.
  e := step(buffer[1..], buffer[..63], 0, 63, 1.5)
  io.println("overlap {} {} {}", bits(e), bits(buffer[30].x), bits(buffer[62].y))
  floats := mem.push_array(f32, arena, 41)
  more := mem.push_array(f32, arena, 41)
  for i in 0..41 {
    floats[i] = #cast(f32, i) * 1.1
    more[i] = 0.3 * #cast(f32, i)
  }
  counts: [5]usize = [0, 3, 4, 9, 41]
  for n in counts {
    t := flat(floats, more, n, 1.0001)
    io.println("flat {} {} {}", n, bits(t), bits(floats[n / 2]))
  }
  t := flat(floats[2..], floats, 39, 0.5)
  io.println("flat overlap {} {}", bits(t), bits(floats[20]))
  ws := mem.push_array(W, arena, 40)
  us := mem.push_array(W, arena, 40)
  sizes: [6]usize = [0, 1, 4, 6, 9, 40]
  for n in sizes {
    for i in 0..40 {
      f := #cast(f32, i)
      ws[i] = W{ x: f, y: 1.0 / (f + 2.0), z: f * 0.5 - 3.0 }
      us[i] = W{ x: 0.25 * f, y: 3.0 - f, z: f * f * 0.001 }
    }
    s := spin(ws[..n], us[..n], 0.75)
    io.println("spin {} {} {} {}", n, bits(s), bits(ws[n / 2].y), bits(ws[n / 2].z))
  }
  s := spin(ws[1..], ws[..39], 2.0)
  io.println("spin overlap {} {}", bits(s), bits(ws[20].x))
  ps := mem.push_array(P, arena, 33)
  pv := mem.push_array(P, arena, 33)
  qs := mem.push_array(Q, arena, 33)
  qr := mem.push_array(Q, arena, 33)
  ds := mem.push_array(f64, arena, 33)
  dr := mem.push_array(f64, arena, 33)
  wides: [6]usize = [0, 1, 2, 3, 8, 33]
  for n in wides {
    for i in 0..33 {
      f := #cast(f64, i)
      ps[i] = P{ x: f * 0.1, y: 1.0 / (f + 1.0) }
      pv[i] = P{ x: 3.0 - f, y: f * f * 0.002 }
      qs[i] = Q{ x: f, y: f * 0.5 - 7.0, z: 1.0 / (f + 3.0) }
      qr[i] = Q{ x: 0.75 * f, y: 2.0 - f, z: f * 0.03 }
      ds[i] = f * 1.25
      dr[i] = 0.5 - f
    }
    pv[5].y = 0.0 / 0.0
    a := drift(ps[..n], pv[..n], 0.125)
    b := twist(qs[..n], qr[..n])
    c := scale(ds[..n], dr[..n], 1.0000001)
    io.println("f64 {} {} {} {} {} {}", n, wide(a), wide(b), wide(c), wide(ps[n / 2].y), wide(qs[n / 2].z))
  }
  io.println("f64 overlap {} {}", wide(scale(ds[1..], ds[..32], 0.5)), wide(drift(ps[1..], ps[..32], 2.0)))
  ia := mem.push_array(i32, arena, 37)
  ib := mem.push_array(i32, arena, 37)
  ua := mem.push_array(u32, arena, 37)
  ub := mem.push_array(u32, arena, 37)
  for n in wides {
    for i in 0..37 {
      ia[i] = #cast(i32, i) * 1000003 - 2147483000
      ib[i] = 77 - #cast(i32, i) * 9
      ua[i] = #cast(u32, i) * 123456789
      ub[i] = 4294967295 - #cast(u32, i)
    }
    io.println("int {} {} {} {} {}", n, blend(ia[..n], ib[..n], 2147483647), churn(ua[..n], ub[..n]), ia[n / 2], ua[n / 2])
  }
  io.println("int overlap {} {}", blend(ia[1..], ia[..36], 5), churn(ua[2..], ua[..35]))
  // An index past the end panics after the earlier iterations' writes.
  short := buffer[..5]
  io.println("last {}", bits(step(buffer, short, 0, 5, 1.0)))
  io.println("past {}", bits(step(buffer, short, 0, 9, 1.0)))
}
