fn unsigned(value: u32) usize { return value }
fn signed(value: i32) isize { return value }

fn take_unsigned(value: usize) usize { return value }
fn take_signed(value: isize) isize { return value }

fn main() {
  small_u: u32 = 42
  small_i: i32 = -7
  wide_u: usize = small_u
  wide_i: isize = small_i
  if unsigned(small_u) != 42 || signed(small_i) != -7 { #panic("return widening") }
  if take_unsigned(small_u) != 42 || take_signed(small_i) != -7 { #panic("argument widening") }
  if wide_u != 42 || wide_i != -7 { #panic("initializer widening") }
}
