use "std/net/tls"
use "std/fail"
use "std/mem"
fn main() {
  status: fail.Status
  context := tls.client_config_create(&status)
  if status.failed { #panic("native TLS trust configuration") }
  defer tls.config_release(&context)
  backing: [256]u8
  arena := mem.arena_from_buffer(backing[..])
  held := mem.push(u8, arena)
  held.* = 42
  mark := mem.arena_mark(arena)
  invalid: fail.Status
  failed := tls.client_connection_create(arena, &invalid, context, -1, "example.test")
  if !invalid.failed || failed != nil || invalid.failure.kind != fail.Kind.InvalidInput || invalid.failure.native != 0 { #panic("native TLS invalid descriptor") }
  missing: fail.Status
  server := tls.server_config_create(arena, &missing, "/dyn/nonexistent/certificate.pem", "/dyn/nonexistent/key.pem")
  if !missing.failed || server != nil || mem.arena_mark(arena) != mark || held.* != 42 { #panic("native TLS failed setup rollback") }
}
