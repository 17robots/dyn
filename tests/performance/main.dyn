use "std/bytes" bytes
use "std/bytes/search" search
use "std/container/hash" hash
use "std/bytes/builder" builder
use "std/mem" memory
use "std/testing" testing
use "std/io" io
use "std/unicode/utf8" utf8

struct Entry { key: []const u8, hash: u64, hash_next: *Entry, bytes: [1]u8, value: usize }
const nil_entry: Entry = Entry{}

fn main() {
  haystack: [32768]u8 = []
  needle: [128]u8 = []
  table: [128]usize = []
  for i in 0..#len(haystack) { haystack[i] = 'a' }
  for i in 0..#len(needle) { needle[i] = 'a' }
  needle[127] = 'b'
  pattern := search.prepare(needle[..], table[..])
  copied: [128]u8 = []
  encoded: [4]u8 = [240,159,152,128]
  checksum: i64 = 0
  for iteration in 0..2000 {
    haystack[32767] = #cast(u8, (97 + iteration % 2))
    checksum += #cast(i64, search.find(pattern.pattern, haystack[..]))
    checksum += #cast(i64, bytes.find(haystack[..], needle[..]))
    _ = memory.copy(copied[..], haystack[..128])
    copied[iteration % 128] = #cast(u8, (96 + iteration % 3))
    checksum += #cast(i64, bytes.compare(copied[..], haystack[..128]))
    encoded[3] = #cast(u8, (128 + iteration % 64))
    checksum += #cast(i64, utf8.decode(encoded[..], 0).codepoint)
  }
  backing: [65536]u8 = []
  arena := memory.arena_from_buffer(backing[..])
  names := hash.slots(Entry, arena, 128)
  entries := memory.push_array(Entry, arena, 128)
  for i in 0..128 {
    entry := &entries[i]
    entry.bytes[0] = #cast(u8, i)
    entry.key = entry.bytes[..]
    entry.hash = hash.hash_bytes(7, entry.key)
    entry.value = i
    hash.insert(names, entry)
  }
  key: [1]u8 = []
  for i in 0..128 {
    key[0] = #cast(u8, i)
    found := hash.find(names, hash.hash_bytes(7, key[..]), key[..], &nil_entry)
    checksum += #cast(i64, found.value)
    testing.expect(hash.remove(names, found), "remove")
  }
  built := builder.from_buffer(backing[..0])
  for i in 0..1024 { _ = builder.append_grow(&built, arena, "x") }
  snapshot := memory.arena_snapshot(arena)
  _ = io.println(io.stdout(), "checksum={} arena_used={} arena_peak={} allocation_failures={}", checksum, snapshot.used, snapshot.peak_used, snapshot.allocation_failures)
}
