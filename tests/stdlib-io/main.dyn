use "std/terminal"
use "std/log"
use "std/fs"
use "std/bufio"
use "std/fmt"
use "std/io"

fn main() {
  _ = io.write_all(terminal.stdout(), "")
  _ = io.write_all(terminal.stdout(), "std/io ")
  _ = io.println(terminal.stdout(), "ok")

  storage: [16]u8 = []
  state := fmt.buffer(storage[..])
  if !fmt.write(&state, "buffer") { #panic("buffer append failed") }
  bytes := fmt.bytes(&state)
  if #len(bytes) != 6 || bytes[0] != 'b' || bytes[5] != 'r' { #panic("buffer writer content failed") }

  state = fmt.buffer(storage[..])
  if !fmt.write_values(&state, "n=", 42, " ", true) { #panic("variadic format failed") }
  bytes = fmt.bytes(&state)
  if #len(bytes) != 9 || bytes[2] != '4' || bytes[8] != 'e' { #panic("variadic format content failed") }

  float_storage: [128]u8 = []
  float_state := fmt.buffer(float_storage[..])
  small: f32 = 1.25
  _ = fmt.write_values(&float_state, -12.5, " ", small, " ")
  _ = fmt.write_f64(&float_state, 0.00000025)
  _ = fmt.write_byte(&float_state, '!')
  floats := fmt.bytes(&float_state)
  if #len(floats) != 18 || floats[0] != '-' || floats[5] != ' ' || floats[10] != ' ' || floats[11] != '2' || floats[16] != '7' || floats[17] != '!' {
    #panic("float and char formatting failed")
  }


  io_storage: [8]u8 = []
  buffered := bufio.writer(terminal.stdout(), io_storage[..])
  if io.write(bufio.writer_adapter(&buffered), "bytes").status != io.Status.Complete || bufio.writer_buffered(&buffered) != 5 {
    #panic("caller-backed io writer failed")
  }
  invalid_writer := bufio.Writer{ destination: terminal.stdout(), storage: io_storage[..], used: 9 }
  if io.write(bufio.writer_adapter(&invalid_writer), "x").status != io.Status.Error || bufio.writer_flush(&invalid_writer).status != io.Status.Error { #panic("writer invariant") }
  invalid_buffer := fmt.Buffer{ data: storage[..], length: 17 }
  if fmt.remaining(&invalid_buffer) != 0 || fmt.write(&invalid_buffer, "x") { #panic("format buffer invariant") }
  state = fmt.buffer(storage[..])
  if !fmt.write_u64_width(&state, 42, 5, '0') || fmt.bytes(&state)[0] != '0' { #panic("format width") }

  descriptors: [2]i32 = []
  if #syscall(293, &descriptors[0], 0) != 0 { #panic("pipe failed") }
  pipe_read: isize = #cast(isize) descriptors[0]
  pipe_write: isize = #cast(isize) descriptors[1]
  read_file := fs.File{ descriptor: pipe_read }
  write_file := fs.File{ descriptor: pipe_write }
  if io.write_all(fs.writer(&write_file), "alpha\nb").transferred != 7 { #panic("pipe write failed") }
  _ = fs.close(&write_file)
  read_storage: [3]u8 = []
  line_storage: [8]u8 = []
  reader := bufio.reader(fs.reader(&read_file), read_storage[..])
  first := bufio.read_line(&reader, line_storage[..])
  if first.status != io.Status.Complete || first.transferred != 5 { #panic("buffered line failed") }
  second := bufio.read_line(&reader, line_storage[..])
  if second.status != io.Status.End || second.transferred != 1 { #panic("buffered final line failed") }
  _ = fs.close(&read_file)

  if #syscall(293, &descriptors[0], 0) != 0 { #panic("pipe failed") }
  pipe_read = #cast(isize) descriptors[0]
  pipe_write = #cast(isize) descriptors[1]
  read_file = fs.File{ descriptor: pipe_read }
  write_file = fs.File{ descriptor: pipe_write }
  if io.write_all(fs.writer(&write_file), "a,bc").transferred != 4 { #panic("pipe write failed") }
  _ = fs.close(&write_file)
  reader = bufio.reader(fs.reader(&read_file), read_storage[..])
  until := bufio.read_until(&reader, line_storage[..], ',')
  exact := io.read_exact(bufio.reader_adapter(&reader), line_storage[..2])
  if until.status != io.Status.Complete || until.transferred != 1 || exact.status != io.Status.Complete || exact.transferred != 2 { #panic("exact/delimiter read") }
  _ = fs.close(&read_file)

  logger := log.logger(terminal.stdout(), log.Level.Info)
  fields: [1]log.Field = [log.Field{ name: "count", value: "3" }]
  if log.write(&logger, log.Level.Debug, "hidden", fields[..0]).transferred != 0 { #panic("log filtering failed") }
  if log.write(&logger, log.Level.Warning, "event", fields[..]).status != io.Status.Complete { #panic("log write failed") }
}
