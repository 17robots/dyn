// Compresses a file with std/compress/gzip: deflate-encode LEVEL INPUT OUTPUT.
use "std/compress/gzip"
use "std/fs"
use "std/io"
use "std/mem"
use "std/process"
use "std/time"

// gz LEVEL INPUT OUTPUT
fn main() {
  arena := mem.arena_alloc(0)
  defer mem.arena_release(arena)
  arguments := process.arguments(arena) catch { #panic("cannot read arguments") }
  level := arguments[1][0] - '0'
  read := fs_read_file(arena, arguments[2], 1 << 30)
  started := time.monotonic_now()
  encoded := gzip.compress(arena, read, level)
  ended := time.monotonic_now()
  elapsed := time.elapsed(started, ended)
  _ = fs_write_file(arguments[3], encoded)
  io.println("{} -> {} in {} us", read.len, encoded.len, elapsed / 1000)
}

// Writes data to path; whether it worked.
fn fs_write_file(path: []const u8, data: []const u8) bool {
  fs.write_all(path, data) catch { return false }
  return true
}

// The whole file at path; empty when it cannot be read.
fn fs_read_file(arena: *mem.Arena, path: []const u8, maximum: usize) []u8 {
  empty: []u8
  data := fs.read_all(arena, path, maximum) catch { return empty }
  return data
}
