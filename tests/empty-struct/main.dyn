struct Marker {}

fn main() {
  first := Marker{}
  values: [3]Marker = []
  values[1] = first
  if #sizeof(Marker) != 1 || #alignof(Marker) != 1 { #panic("empty struct layout") }
  second_address: usize = #cast(usize) &values[1]
  first_address: usize = #cast(usize) &values[0]
  if second_address - first_address != 1 { #panic("empty struct stride") }
}
