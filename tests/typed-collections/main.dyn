// Generic append and typed slot-map helpers.
use "std/mem"
use "std/container/slot_map" slots

struct Node {
  value: i64,
  tag: u8,
}

struct Ast {
  nodes: []Node,
  node_count: usize,
  queue: []u32,
  queue_count: usize,
}

fn main() {
  arena := mem.arena_create(mem.MiB)
  defer mem.arena_release(&arena)
  ast := Ast{}
  for i in 0..20 {
    _ = mem.append(&ast.nodes, &ast.node_count, &arena, Node{value: #cast(i64, i)})
    _ = mem.append(&ast.queue, &ast.queue_count, &arena, #cast(u32, i))
  }
  if ast.node_count != 20 || ast.nodes[19].value != 19 || ast.queue[7] != 7 { #panic("append") }
  // The newest array grows in place: 64 u32 values use 256 bytes, not 4 + 8 + ... + 256.
  grow := mem.arena_create(mem.KiB)
  defer mem.arena_release(&grow)
  values: []u32
  value_count: usize = 0
  for i in 0..64 {
    _ = mem.append(&values, &value_count, &grow, #cast(u32, i))
  }
  if values[63] != 63 || mem.arena_used(&grow) != 256 { #panic("append in place") }
  pool := mem.pool_for(Node, &arena, 2)
  first := mem.acquire(Node, &pool)
  first.value = 7
  second := mem.acquire(Node, &pool)
  if second.value != 0 || mem.pool_available(&pool) != 0 { #panic("pool acquire") }
  mem.release(&pool, first)
  again := mem.acquire(Node, &pool)
  if again != first || again.value != 0 { #panic("pool reuse") }
  table := slots.init_for(Node, &arena, 4)
  node := Node{value: 42}
  handle := slots.insert_value(&table, &node)
  found := slots.get_value(Node, &table, handle)
  if found == nil || found.value != 42 { #panic("slot") }
  _ = slots.remove(&table, handle)
  if slots.get_value(Node, &table, handle) != nil { #panic("stale") }
}
