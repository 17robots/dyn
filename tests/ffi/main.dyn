use "./native"

fn add_context(value: i64, context: rawptr) i64 {
  amount := #cast(*i64) context
  return value + amount.*
}

fn main() {
  result := native.add(19, 23)
  if result != 42 { #panic("foreign call returned wrong value") }
  small: i8 = 10
  medium: i16 = 20
  if native.variadic_sum(3, small, medium, 12) != 42 {
    #panic("foreign integer variadic call failed")
  }
  fraction: f32 = 1.5
  if native.variadic_double(2, fraction, 2.5) != 4.0 {
    #panic("foreign float variadic call failed")
  }
  sum := &native.variadic_sum
  if sum(3, small, medium, 12) != 42 {
    #panic("foreign variadic function pointer failed")
  }
  sum_double := &native.variadic_double
  if sum_double(2, fraction, 2.5) != 4.0 {
    #panic("foreign float variadic function pointer failed")
  }
  pair := native.Pair{ integer: 40, real: 1.5 }
  native.pair(&pair)
  if pair.integer != 42 || pair.real != 2.0 { #panic("foreign struct pointer adapter failed") }
  nested := native.Nested{ pair: native.Pair{ integer: 30, real: 3.0 }, values: [1, 2, 6] }
  if native.nested(&nested) != 42 { #panic("foreign nested/array ABI failed") }
  if native.pair_size() != 16 || native.pair_align() != 8 ||
      native.nested_size() != 32 || native.nested_align() != 8 ||
      native.nested_values_offset() != 16 {
    #panic("foreign struct layout ABI failed")
  }
  amount: i64 = 2
  if native.callback(&add_context, #cast(rawptr) &amount) != 42 { #panic("C to Dyn callback failed") }
  if native.nullable(nil) != 1 || native.nullable(#cast(rawptr) &amount) != 0 { #panic("nullable pointer ABI failed") }
  foreign := native.global_address()
  if foreign.* != 41 { #panic("foreign global read failed") }
  foreign.* += 1
  if foreign.* != 42 { #panic("foreign global write failed") }
  if native.foreign_global != 42 { #panic("direct foreign global read failed") }
  native.foreign_global += 1
  if native.foreign_global != 43 { #panic("direct foreign global write failed") }
}
