// Evented server push and offload: run (pool jobs), open_stream (SSE),
// upgrade (WebSocket), publish, send, close_peer, overflow eviction and 503.
// Prints "port N" once listening; POST /quit stops it.
use "std/bytes"
use "std/crypto/password"
use "std/encoding/json"
use "std/fmt"
use "std/fail"
use "std/io"
use "std/mem"
use "std/net"
use "std/net/http"
use "std/net/http/evented"
use https "std/net/http/evented/tls"
use "std/parse"
use "std/process"
use "std/sync"
use "std/thread/pool"
use "std/thread/posix"
use "std/time"

const WorkerCount: usize = 2
const EventsTopic: u64 = 1
const ChatTopic: u64 = 2

struct App {
  quit: sync.AtomicU32,
  // Large bodies whose client left mid-upload.
  abandoned: sync.AtomicU32,
  workers: []evented.Worker,
  assets: http.Assets,
  router: http.Routes<App>,
  route_storage: [19]http.TypedRoute<App>,
  // Requests deferred with later on each worker in the current pass, and the
  // size of the batch the last finish closed.
  pending: [WorkerCount]usize,
  batch: [WorkerCount]usize,
  big: [300 * 1024]u8,
}

struct Hash { input: [64]u8, length: usize, digest: [32]u8, ok: bool }

fn text(response: *http.Response, code: u16, body: []const u8) !io.IoErr {
  try http.respond(response, body, http.ResponseOptions{ status: code, content_type: "text/plain" })
}

fn health(response: *http.Response, request: *const http.Request, app: *App) !io.IoErr {
  try text(response, 200, "ok\n")
}

// The request arena: 4 KiB per call, never freed; the server empties it
// before each handler, so thousands of calls fit a 1 MiB arena.
fn scratch(response: *http.Response, request: *const http.Request, app: *App) !io.IoErr {
  arena := evented.arena(response)
  if arena == nil {
    try text(response, 500, "no arena")
    return
  }
  block := mem.push_bytes(arena, 4096)
  out := json.writer(nil, block)
  json.object_begin(&out)
  json.field(&out, "worker", evented.worker_index(response))
  json.field(&out, "path", request.path)
  json.field(&out, "ok", true)
  json.object_end(&out)
  try http.json(response, 200, json.output(&out))
}

// Larger than a 64 KiB HTTP/2 window: the handler waits for WINDOW_UPDATE.
fn big(response: *http.Response, request: *const http.Request, app: *App) !io.IoErr {
  try text(response, 200, app.big[..])
}

// A dynamic JSON body, gzipped when the client accepts it; ?n= sets its rows.
fn report(response: *http.Response, request: *const http.Request, app: *App) !io.IoErr {
  storage: [64 * mem.KiB]u8
  page := fmt.buffer(nil, storage[..])
  count_storage: [8]u8
  count := http.query_value(request, "n", count_storage[..]) catch count_storage[..0]
  rows := 400
  if bytes.equal(count, "2") {
    rows = 2
  }
  fmt.write(&page, "[")
  for i in 0..rows {
    if i > 0 {
      fmt.write(&page, ",")
    }
    fmt.print(&page, "{{\"id\":{},\"name\":\"row {}\"}}", i, i)
  }
  fmt.write(&page, "]")
  cache: [1]http.Header = [http.Header{ name: "Cache-Control", value: "no-store" }]
  try evented.respond_compressed(response, request, fmt.bytes(&page), http.ResponseOptions{ content_type: "application/json", headers: cache[..] })
}

fn hash_work(job: *Hash) {
  scratch: [20]u8
  salt: [16]u8
  hashing: fail.Status
  password.pbkdf2_sha256(&hashing, job.digest[..], job.input[..job.length], salt[..], 20000, scratch[..])
  job.ok = !hashing.failed
}

fn hash_finish(response: *http.Response, request: *const http.Request, job: *Hash) !io.IoErr {
  if !job.ok {
    try text(response, 500, "hash failed\n")
    return
  }
  storage: [80]u8
  out := fmt.buffer(nil, storage[..])
  digits := "0123456789abcdef"
  for byte in job.digest {
    fmt.write_byte(&out, digits[byte >> 4])
    fmt.write_byte(&out, digits[byte & 15])
  }
  fmt.write_byte(&out, '\n')
  try text(response, 200, fmt.bytes(&out))
}

struct Tally { app: *App, worker: usize, number: usize }

// The first finish of a pass closes the batch; every reply names its size.
fn later_finish(response: *http.Response, request: *const http.Request, job: *Tally) !io.IoErr {
  app := job.app
  if app.pending[job.worker] > 0 {
    app.batch[job.worker] = app.pending[job.worker]
    app.pending[job.worker] = 0
  }
  storage: [64]u8
  out := fmt.buffer(nil, storage[..])
  fmt.print(&out, "later {} of {}\n", job.number, app.batch[job.worker])
  try text(response, 200, fmt.bytes(&out))
}

fn deferred(response: *http.Response, request: *const http.Request, app: *App) !io.IoErr {
  job := evented.job<Tally>(response)
  if job == nil {
    try text(response, 500, "no job storage\n")
    return
  }
  worker := evented.worker_index(response)
  app.pending[worker] += 1
  job.* = Tally{ app: app, worker: worker, number: app.pending[worker] }
  evented.later(response, job, later_finish) catch { try text(response, 500, "later failed\n") }
}

fn hash(response: *http.Response, request: *const http.Request, app: *App) !io.IoErr {
  job := evented.job<Hash>(response)
  if job == nil || request.body.len > job.input.len {
    try text(response, 500, "no job storage\n")
    return
  }
  job.length = mem.copy(job.input[..], request.body)
  evented.run(response, job, hash_work, hash_finish) catch { try text(response, 503, "pool busy\n") }
}

fn events(response: *http.Response, request: *const http.Request, app: *App) !io.IoErr {
  headers: [1]http.Header = [http.Header{ name: "Cache-Control", value: "no-store" }]
  opened := evented.open_stream(response, http.ResponseOptions{ content_type: "text/event-stream", headers: headers[..] }, EventsTopic) catch {
    try text(response, 500, "stream failed\n")
    return
  }
  storage: [128]u8
  hello := try http.sse_event(storage[..], "hello", "", "connected")
  try evented.send(app.workers, opened, hello, false)
}

fn chat(response: *http.Response, request: *const http.Request, app: *App) !io.IoErr {
  _ = evented.upgrade(response, request, ChatTopic) catch {
    try text(response, 400, "not a websocket upgrade\n")
    return
  }
}

// POST body goes to every SSE stream as an event and every socket as text.
fn broadcast(response: *http.Response, request: *const http.Request, app: *App) !io.IoErr {
  storage: [1024]u8
  event := try http.sse_event(storage[..], "message", "7", request.body)
  publish_both(app, event, request.body) catch {
    try text(response, 503, "inbox full\n")
    return
  }
  try text(response, 200, "sent\n")
}

fn publish_both(app: *App, event: []const u8, text: []const u8) !io.IoErr {
  try evented.publish(app.workers, EventsTopic, event, false)
  try evented.publish(app.workers, ChatTopic, text, false)
}

fn asset(response: *http.Response, request: *const http.Request, app: *App) !io.IoErr {
  found := http.find_asset(&app.assets, try http.param(request, "name"))
  if found == nil {
    try text(response, 404, "no asset\n")
    return
  }
  try http.serve_asset(response, request, found, "public, max-age=60")
}

fn client(response: *http.Response, request: *const http.Request, app: *App) !io.IoErr {
  storage: [64]u8
  try text(response, 200, net.ip_text(storage[..], evented.client_ip(response)))
}

// Upload: answers the body's length and byte sum.
fn upload(response: *http.Response, request: *const http.Request, app: *App) !io.IoErr {
  sum: u64 = 0
  for byte in request.body {
    sum += byte
  }
  storage: [64]u8
  out := fmt.buffer(nil, storage[..])
  fmt.write_u64(&out, request.body.len)
  fmt.write_byte(&out, ' ')
  fmt.write_u64(&out, sum)
  try text(response, 200, fmt.bytes(&out))
}

fn quit(response: *http.Response, request: *const http.Request, app: *App) !io.IoErr {
  sync.store_u32(&app.quit, 1)
  try text(response, 200, "bye\n")
}

// Echo each message to its sender, with a prefix; "all:" messages go to every
// socket.

fn on_message(message: *const evented.Message) {
  app := #cast(*App, message.context)
  if message.kind == evented.MessageKind.Closed { return }
  if bytes.starts_with(message.payload, "all:") {
    evented.publish(app.workers, ChatTopic, message.payload[4..], false) catch {}
    return
  }
  if bytes.equal(message.payload, "bye") {
    evented.close_peer(app.workers, message.peer) catch {}
    return
  }
  storage: [8 * 1024]u8
  out_status: fail.Status
  out := fmt.buffer(&out_status, storage[..])
  fmt.write(&out, "echo:")
  fmt.write(&out, message.payload)
  evented.send(app.workers, message.peer, fmt.bytes(&out), message.kind == evented.MessageKind.Binary) catch {}
}

// Bodies larger than any upload block, read as they arrive: POST /large
// answers with the byte count and sum, ?limit=N stops after N bytes, and
// anything else is refused from the head alone.
struct Upload { app: *App, count: usize, sum: u64, limit: usize }

fn large_chunk(job: *Upload, piece: []const u8) bool {
  for byte in piece {
    job.sum += #cast(u64, byte)
  }
  job.count += piece.len
  return job.limit == 0 || job.count <= job.limit
}

fn large_finish(response: *http.Response, request: *const http.Request, job: *Upload, end: evented.BodyEnd) !io.IoErr {
  storage: [64]u8
  line := fmt.buffer(nil, storage[..])
  case end {
    evented.BodyEnd.Complete => {
      fmt.print(&line, "{} {}", job.count, job.sum)
      try text(response, 200, fmt.bytes(&line))
      return
    }
    evented.BodyEnd.Stopped => {
      fmt.print(&line, "stopped after {}", job.count)
      try text(response, http.StatusPayloadTooLarge, fmt.bytes(&line))
      return
    }
    evented.BodyEnd.Invalid => {
      try text(response, http.StatusBadRequest, "bad chunks\n")
      return
    }
    evented.BodyEnd.Closed => {
      _ = sync.fetch_add_u32(&job.app.abandoned, 1)
      return
    }
  }
}

fn large_body(response: *http.Response, request: *const http.Request) !io.IoErr {
  typed := #cast(*http.Typed<App>, request.context)
  if !bytes.equal(request.path, "/large") {
    try text(response, http.StatusPayloadTooLarge, "too large\n")
    return
  }
  job := evented.job<Upload>(response)
  if job == nil {
    try text(response, http.StatusServiceUnavailable, "busy\n")
    return
  }
  job.app = typed.state
  storage: [16]u8
  limit := http.query_value(request, "limit", storage[..]) catch storage[..0]
  if limit.len > 0 {
    job.limit = #cast(usize, parse.u64_decimal(limit) catch 0)
  }
  evented.receive_body(response, job, large_chunk, large_finish) catch {
    try text(response, http.StatusInternalServerError, "cannot read\n")
  }
}

fn abandoned(response: *http.Response, request: *const http.Request, app: *App) !io.IoErr {
  storage: [16]u8
  line := fmt.buffer(nil, storage[..])
  fmt.print(&line, "{}", sync.load_u32(&app.abandoned))
  try text(response, 200, fmt.bytes(&line))
}

// Fails before responding: the server answers 500.
fn failing(response: *http.Response, request: *const http.Request, app: *App) !io.IoErr {
  _ = response
  _ = request
  _ = app
  fail .InvalidInput
}

// Cookies from ResponseOptions; query_has picks the body.
fn cookies(response: *http.Response, request: *const http.Request, app: *App) !io.IoErr {
  _ = app
  set: [1]http.Cookie = [http.Cookie{ name: "theme", value: "dark", path: "/" }]
  body: []const u8 = "plain\n"
  if http.query_has(request, "debug") {
    body = "debug\n"
  }
  try http.respond(response, body, http.ResponseOptions{ content_type: "text/plain", cookies: set[..] })
}

fn handle(response: *http.Response, request: *const http.Request, app: *App) !io.IoErr {
  try http.serve_routes(&app.router, response, request)
}

// The server's 503 replaced: a client turned away gets this instead.
fn busy(response: *http.Response, request: *const http.Request) !io.IoErr {
  _ = request
  retry: [1]http.Header = [http.Header{ name: "Retry-After", value: "2" }]
  try http.respond(response, "busy, try again\n", http.ResponseOptions{ status: http.StatusServiceUnavailable,
    content_type: "text/plain", headers: retry[..] })
}

fn main() {
  arena := mem.arena_alloc(64 * mem.MiB)
  defer mem.arena_release(arena)
  spawner := posix.spawner()
  setup := fail.Status{ on_failure: fail.panic_on_failure }
  jobs := pool.start_spawned(arena, &setup, 2, 64, 256 * mem.KiB, &spawner)
  workers: [WorkerCount]evented.Worker
  app := App{ workers: workers[..] }
  asset_storage: [2]http.Asset
  style: [4096]u8
  rule := "body { color: red; } "
  for i in 0..style.len {
    style[i] = rule[i % rule.len]
  }
  asset_storage[0] = http.make_asset(arena, "style.css", style[..])
  asset_storage[0].modified = 784111777
  asset_storage[1] = http.make_asset(arena, "logo.png", "\x89PNG not really")
  app.assets = http.Assets{ items: asset_storage[..], count: 2 }
  http.sort_assets(&app.assets)
  for i in 0..app.big.len {
    app.big[i] = #cast(u8, 'a' + i % 26)
  }
  app.router = http.typed_routes(app.route_storage[..], &app)
  http.add(&app.router, "GET", "/health", health) catch { #panic("add route") }
  http.add(&app.router, "GET", "/fail", failing) catch { #panic("add route") }
  http.add(&app.router, "GET", "/cookies", cookies) catch { #panic("add route") }
  http.add(&app.router, "GET", "/report", report) catch { #panic("add route") }
  http.add(&app.router, "GET", "/abandoned", abandoned) catch { #panic("add route") }
  http.add(&app.router, "GET", "/big", big) catch { #panic("add route") }
  http.add(&app.router, "GET", "/scratch", scratch) catch { #panic("add route") }
  http.add(&app.router, "GET", "/later", deferred) catch { #panic("add route") }
  http.add(&app.router, "POST", "/hash", hash) catch { #panic("add route") }
  http.add(&app.router, "GET", "/events", events) catch { #panic("add route") }
  http.add(&app.router, "GET", "/chat", chat) catch { #panic("add route") }
  http.add(&app.router, "POST", "/broadcast", broadcast) catch { #panic("add route") }
  http.add(&app.router, "POST", "/quit", quit) catch { #panic("add route") }
  http.add(&app.router, "GET", "/static/:name", asset) catch { #panic("add route") }
  http.add(&app.router, "GET", "/ip", client) catch { #panic("add route") }
  http.add(&app.router, "POST", "/upload", upload) catch { #panic("add route") }
  typed := http.Typed<App>{ state: &app, handler: handle }
  binding := http.bind(&typed)
  config := evented.default_config()
  config.connections_per_worker = 8
  config.receive_size = 4 * mem.KiB
  config.send_size = 4 * mem.KiB
  config.overflow_send_size = 64 * mem.KiB
  config.overflow_send_count = 8
  config.upload_size = mem.MiB
  config.upload_count = 2
  config.spawner = &spawner
  config.pool = jobs
  config.on_message = on_message
  config.message_context = &app
  config.idle_timeout_milliseconds = 60000
  config.overflow = evented.Overflow.Reject
  config.on_busy = busy
  arguments := process.arguments(arena) catch { #panic("cannot read arguments") }
  if arguments.len > 1 && bytes.equal(arguments[1], "wait") {
    config.overflow = evented.Overflow.Wait
  }
  quic_stack := evented.Quic{}
  if arguments.len == 4 && bytes.equal(arguments[1], "h3") {
    // HTTP/3 over QUIC, which brings its own TLS; TCP stays cleartext.
    quic_context := https.quic_context(arena, arguments[2], arguments[3]) catch { #panic("QUIC context") }
    quic_stack = https.quic(quic_context)
    config.http3 = evented.http3()
    config.quic = &quic_stack
  }
  if arguments.len > 1 && (bytes.equal(arguments[1], "h2") || bytes.equal(arguments[1], "h3")) {
    // HTTP/2 needs room for a whole 16 KiB frame.
    config.http2 = evented.http2()
    config.receive_size = 32 * mem.KiB
    config.http2_connections = 8
    config.http2_slots = 16
  }
  config.evict_idle_milliseconds = 200
  config.compress_level = 6
  config.large_body = evented.large_bodies(large_body)
  storage := mem.arena_from_source(mem.within(arena, evented.storage_size(config, WorkerCount) + mem.MiB))
  address := net.ipv4(127, 0, 0, 1, 0)
  listener := net.tcp_listen_ipv4(&address, 64) catch { #panic("listen") }
  evented.start(storage, workers[..], &listener, config, binding.handler, binding.context) catch { #panic("start server") }
  io.println("port {}", evented.local_port(workers[..]))
  for sync.load_u32(&app.quit) == 0 {
    time.sleep(20 * time.Millisecond)
  }
  evented.stop(workers[..])
  evented.join(workers[..]) catch { #panic("join server") }
  net.listener_close(&listener)
  pool.stop(&setup, jobs)
  evicted: u64 = 0
  refused: u64 = 0
  for *worker in workers {
    evicted += worker.evicted
    refused += worker.refused
  }
  io.println("evicted {} refused {}", evicted, refused)
}
