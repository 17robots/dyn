// Evented server push and offload: run (pool jobs), open_stream (SSE),
// upgrade (WebSocket), publish, send, close_peer, overflow eviction and 503.
// Prints "port N" once listening; POST /quit stops it.
use "std/bytes"
use "std/crypto/password"
use "std/encoding/json"
use "std/fmt"
use "std/fail"
use "std/io"
use "std/mem"
use "std/net"
use "std/net/http"
use "std/net/http/evented"
use "std/net/http/evented/tls" https
use "std/parse"
use "std/process"
use "std/sync"
use "std/thread/pool"
use "std/thread/posix"
use "std/time"

const WorkerCount: usize = 2
const EventsTopic: u64 = 1
const ChatTopic: u64 = 2

struct App {
  quit: sync.AtomicU32,
  // Large bodies whose client left mid-upload.
  abandoned: sync.AtomicU32,
  workers: []evented.Worker,
  assets: http.Assets,
  router: http.Routes(App),
  route_storage: [19]http.TypedRoute(App),
  // Requests deferred with later on each worker in the current pass, and the
  // size of the batch the last finish closed.
  pending: [WorkerCount]usize,
  batch: [WorkerCount]usize,
  big: [300 * 1024]u8,
}

struct Hash { input: [64]u8, length: usize, digest: [32]u8, ok: bool }

fn text(status: *fail.Status, response: *http.Response, code: u16, body: []const u8) {
  http.respond(status, response, body, http.ResponseOptions{ status: code, content_type: "text/plain" })
}

fn health(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  text(status, response, 200, "ok\n")
}

// The request arena: 4 KiB per call, never freed; the server empties it
// before each handler, so thousands of calls fit a 1 MiB arena.
fn scratch(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  arena := evented.arena(response)
  if arena == nil {
    text(status, response, 500, "no arena")
    return
  }
  block := mem.push_bytes(arena, 4096)
  out := json.writer(status, block)
  json.object_begin(&out)
  json.field(&out, "worker", evented.worker_index(response))
  json.field(&out, "path", request.path)
  json.field(&out, "ok", true)
  json.object_end(&out)
  http.json(status, response, 200, json.output(&out))
}

// Larger than a 64 KiB HTTP/2 window: the handler waits for WINDOW_UPDATE.
fn big(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  text(status, response, 200, app.big[..])
}

// A dynamic JSON body, gzipped when the client accepts it; ?n= sets its rows.
fn report(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  storage: [64 * mem.KiB]u8
  page := fmt.buffer(status, storage[..])
  count_storage: [8]u8
  optional: fail.Status
  count := http.query_value(&optional, request, "n", count_storage[..])
  rows := 400
  if bytes.equal(count, "2") {
    rows = 2
  }
  fmt.write(&page, "[")
  for i in 0..rows {
    if i > 0 {
      fmt.write(&page, ",")
    }
    fmt.print(&page, "{{\"id\":{},\"name\":\"row {}\"}}", i, i)
  }
  fmt.write(&page, "]")
  cache: [1]http.Header = [http.Header{ name: "Cache-Control", value: "no-store" }]
  evented.respond_compressed(status, response, request, fmt.bytes(&page), http.ResponseOptions{ content_type: "application/json", headers: cache[..] })
}

fn hash_work(job: *Hash) {
  scratch: [20]u8
  salt: [16]u8
  hashing: fail.Status
  password.pbkdf2_sha256(&hashing, job.digest[..], job.input[..job.length], salt[..], 20000, scratch[..])
  job.ok = !hashing.failed
}

fn hash_finish(status: *fail.Status, response: *http.Response, request: *const http.Request, job: *Hash) {
  if !job.ok {
    text(status, response, 500, "hash failed\n")
    return
  }
  storage: [80]u8
  out := fmt.buffer(status, storage[..])
  digits := "0123456789abcdef"
  for byte in job.digest {
    fmt.write_byte(&out, digits[byte >> 4])
    fmt.write_byte(&out, digits[byte & 15])
  }
  fmt.write_byte(&out, '\n')
  text(status, response, 200, fmt.bytes(&out))
}

struct Tally { app: *App, worker: usize, number: usize }

// The first finish of a pass closes the batch; every reply names its size.
fn later_finish(status: *fail.Status, response: *http.Response, request: *const http.Request, job: *Tally) {
  app := job.app
  if app.pending[job.worker] > 0 {
    app.batch[job.worker] = app.pending[job.worker]
    app.pending[job.worker] = 0
  }
  storage: [64]u8
  out := fmt.buffer(status, storage[..])
  fmt.print(&out, "later {} of {}\n", job.number, app.batch[job.worker])
  text(status, response, 200, fmt.bytes(&out))
}

fn deferred(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  job := evented.job(Tally, response)
  if job == nil {
    text(status, response, 500, "no job storage\n")
    return
  }
  worker := evented.worker_index(response)
  app.pending[worker] += 1
  job.* = Tally{ app: app, worker: worker, number: app.pending[worker] }
  deferring: fail.Status
  evented.later(&deferring, response, job, later_finish)
  if deferring.failed {
    text(status, response, 500, "later failed\n")
  }
}

fn hash(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  job := evented.job(Hash, response)
  if job == nil || #len(request.body) > #len(job.input) {
    text(status, response, 500, "no job storage\n")
    return
  }
  job.length = mem.copy(job.input[..], request.body)
  ran: fail.Status
  evented.run(&ran, response, job, hash_work, hash_finish)
  if ran.failed {
    text(status, response, 503, "pool busy\n")
  }
}

fn events(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  headers: [1]http.Header = [http.Header{ name: "Cache-Control", value: "no-store" }]
  opening: fail.Status
  opened := evented.open_stream(&opening, response, http.ResponseOptions{ content_type: "text/event-stream", headers: headers[..] }, EventsTopic)
  if opening.failed {
    text(status, response, 500, "stream failed\n")
    return
  }
  storage: [128]u8
  hello := http.sse_event(status, storage[..], "hello", "", "connected")
  evented.send(status, app.workers, opened, hello, false)
}

fn chat(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  upgrading: fail.Status
  _ = evented.upgrade(&upgrading, response, request, ChatTopic)
  if upgrading.failed {
    text(status, response, 400, "not a websocket upgrade\n")
  }
}

// POST body goes to every SSE stream as an event and every socket as text.
fn broadcast(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  storage: [1024]u8
  event := http.sse_event(status, storage[..], "message", "7", request.body)
  posting: fail.Status
  evented.publish(&posting, app.workers, EventsTopic, event, false)
  evented.publish(&posting, app.workers, ChatTopic, request.body, false)
  if posting.failed {
    text(status, response, 503, "inbox full\n")
    return
  }
  text(status, response, 200, "sent\n")
}

fn asset(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  found := http.find_asset(&app.assets, http.param(status, request, "name"))
  if found == nil {
    text(status, response, 404, "no asset\n")
    return
  }
  http.serve_asset(status, response, request, found, "public, max-age=60")
}

fn client(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  storage: [64]u8
  text(status, response, 200, net.ip_text(storage[..], evented.client_ip(response)))
}

// Upload: answers the body's length and byte sum.
fn upload(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  sum: u64 = 0
  for byte in request.body {
    sum += byte
  }
  storage: [64]u8
  out := fmt.buffer(status, storage[..])
  fmt.write_u64(&out, #len(request.body))
  fmt.write_byte(&out, ' ')
  fmt.write_u64(&out, sum)
  text(status, response, 200, fmt.bytes(&out))
}

fn quit(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  sync.store_u32(&app.quit, 1)
  text(status, response, 200, "bye\n")
}

// Echo each message to its sender, with a prefix; "all:" messages go to every
// socket.

fn on_message(message: *const evented.Message) {
  app := #cast(*App, message.context)
  if message.kind == evented.MessageKind.Closed { return }
  if bytes.starts_with(message.payload, "all:") {
    posting: fail.Status
    evented.publish(&posting, app.workers, ChatTopic, message.payload[4..], false)
    return
  }
  if bytes.equal(message.payload, "bye") {
    closing: fail.Status
    evented.close_peer(&closing, app.workers, message.peer)
    return
  }
  storage: [8 * 1024]u8
  out_status: fail.Status
  out := fmt.buffer(&out_status, storage[..])
  fmt.write(&out, "echo:")
  fmt.write(&out, message.payload)
  sending: fail.Status
  evented.send(&sending, app.workers, message.peer, fmt.bytes(&out), message.kind == evented.MessageKind.Binary)
}

// Bodies larger than any upload block, read as they arrive: POST /large
// answers with the byte count and sum, ?limit=N stops after N bytes, and
// anything else is refused from the head alone.
struct Upload { app: *App, count: usize, sum: u64, limit: usize }

fn large_chunk(job: *Upload, piece: []const u8) bool {
  for byte in piece {
    job.sum += #cast(u64, byte)
  }
  job.count += #len(piece)
  return job.limit == 0 || job.count <= job.limit
}

fn large_finish(status: *fail.Status, response: *http.Response, request: *const http.Request, job: *Upload, end: evented.BodyEnd) {
  storage: [64]u8
  line := fmt.buffer(status, storage[..])
  case end {
    evented.BodyEnd.Complete => {
      fmt.print(&line, "{} {}", job.count, job.sum)
      text(status, response, 200, fmt.bytes(&line))
      return
    }
    evented.BodyEnd.Stopped => {
      fmt.print(&line, "stopped after {}", job.count)
      text(status, response, http.StatusPayloadTooLarge, fmt.bytes(&line))
      return
    }
    evented.BodyEnd.Invalid => {
      text(status, response, http.StatusBadRequest, "bad chunks\n")
      return
    }
    evented.BodyEnd.Closed => {
      _ = sync.fetch_add_u32(&job.app.abandoned, 1)
      return
    }
  }
}

fn large_body(status: *fail.Status, response: *http.Response, request: *const http.Request) {
  typed := #cast(*http.Typed(App), request.context)
  if !bytes.equal(request.path, "/large") {
    text(status, response, http.StatusPayloadTooLarge, "too large\n")
    return
  }
  job := evented.job(Upload, response)
  if job == nil {
    text(status, response, http.StatusServiceUnavailable, "busy\n")
    return
  }
  job.app = typed.state
  storage: [16]u8
  optional: fail.Status
  limit := http.query_value(&optional, request, "limit", storage[..])
  if !optional.failed {
    parsing: fail.Status
    job.limit = #cast(usize, parse.u64_decimal(&parsing, limit))
  }
  reading: fail.Status
  evented.receive_body(&reading, response, job, large_chunk, large_finish)
  if reading.failed {
    text(status, response, http.StatusInternalServerError, "cannot read\n")
  }
}

fn abandoned(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  storage: [16]u8
  line := fmt.buffer(status, storage[..])
  fmt.print(&line, "{}", sync.load_u32(&app.abandoned))
  text(status, response, 200, fmt.bytes(&line))
}

// Fails before responding: the server answers 500.
fn failing(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  _ = response
  _ = request
  _ = app
  fail.invalid(status, "failing route", "", "on purpose")
}

// Cookies from ResponseOptions; query_has picks the body.
fn cookies(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  _ = app
  set: [1]http.Cookie = [http.Cookie{ name: "theme", value: "dark", path: "/" }]
  body: []const u8 = "plain\n"
  if http.query_has(request, "debug") {
    body = "debug\n"
  }
  http.respond(status, response, body, http.ResponseOptions{ content_type: "text/plain", cookies: set[..] })
}

fn handle(status: *fail.Status, response: *http.Response, request: *const http.Request, app: *App) {
  http.serve_routes(status, &app.router, response, request)
}

// The server's 503 replaced: a client turned away gets this instead.
fn busy(status: *fail.Status, response: *http.Response, request: *const http.Request) {
  _ = request
  retry: [1]http.Header = [http.Header{ name: "Retry-After", value: "2" }]
  http.respond(status, response, "busy, try again\n", http.ResponseOptions{ status: http.StatusServiceUnavailable,
    content_type: "text/plain", headers: retry[..] })
}

fn main() {
  arena := mem.arena_alloc(64 * mem.MiB)
  defer mem.arena_release(arena)
  spawner := posix.spawner()
  setup := fail.Status{ on_failure: fail.panic_on_failure }
  jobs := pool.start_spawned(arena, &setup, 2, 64, 256 * mem.KiB, &spawner)
  workers: [WorkerCount]evented.Worker
  app := App{ workers: workers[..] }
  asset_storage: [2]http.Asset
  style: [4096]u8
  rule := "body { color: red; } "
  for i in 0..#len(style) {
    style[i] = rule[i % #len(rule)]
  }
  asset_storage[0] = http.make_asset(arena, "style.css", style[..])
  asset_storage[0].modified = 784111777
  asset_storage[1] = http.make_asset(arena, "logo.png", "\x89PNG not really")
  app.assets = http.Assets{ items: asset_storage[..], count: 2 }
  http.sort_assets(&app.assets)
  for i in 0..#len(app.big) {
    app.big[i] = #cast(u8, 'a' + i % 26)
  }
  app.router = http.typed_routes(app.route_storage[..], &app)
  http.add(&setup, &app.router, "GET", "/health", health)
  http.add(&setup, &app.router, "GET", "/fail", failing)
  http.add(&setup, &app.router, "GET", "/cookies", cookies)
  http.add(&setup, &app.router, "GET", "/report", report)
  http.add(&setup, &app.router, "GET", "/abandoned", abandoned)
  http.add(&setup, &app.router, "GET", "/big", big)
  http.add(&setup, &app.router, "GET", "/scratch", scratch)
  http.add(&setup, &app.router, "GET", "/later", deferred)
  http.add(&setup, &app.router, "POST", "/hash", hash)
  http.add(&setup, &app.router, "GET", "/events", events)
  http.add(&setup, &app.router, "GET", "/chat", chat)
  http.add(&setup, &app.router, "POST", "/broadcast", broadcast)
  http.add(&setup, &app.router, "POST", "/quit", quit)
  http.add(&setup, &app.router, "GET", "/static/:name", asset)
  http.add(&setup, &app.router, "GET", "/ip", client)
  http.add(&setup, &app.router, "POST", "/upload", upload)
  typed := http.Typed(App){ state: &app, handler: handle }
  binding := http.bind(&typed)
  config := evented.default_config()
  config.connections_per_worker = 8
  config.receive_size = 4 * mem.KiB
  config.send_size = 4 * mem.KiB
  config.overflow_send_size = 64 * mem.KiB
  config.overflow_send_count = 8
  config.upload_size = mem.MiB
  config.upload_count = 2
  config.spawner = &spawner
  config.pool = jobs
  config.on_message = on_message
  config.message_context = &app
  config.idle_timeout_milliseconds = 60000
  config.overflow = evented.Overflow.Reject
  config.on_busy = busy
  arguments_status: fail.Status
  arguments := process.arguments(arena, &arguments_status)
  if #len(arguments) > 1 && bytes.equal(arguments[1], "wait") {
    config.overflow = evented.Overflow.Wait
  }
  quic_stack := evented.Quic{}
  if #len(arguments) == 4 && bytes.equal(arguments[1], "h3") {
    // HTTP/3 over QUIC, which brings its own TLS; TCP stays cleartext.
    quic_context := https.quic_context(arena, &setup, arguments[2], arguments[3])
    quic_stack = https.quic(quic_context)
    config.http3 = evented.http3()
    config.quic = &quic_stack
  }
  if #len(arguments) > 1 && (bytes.equal(arguments[1], "h2") || bytes.equal(arguments[1], "h3")) {
    // HTTP/2 needs room for a whole 16 KiB frame.
    config.http2 = evented.http2()
    config.receive_size = 32 * mem.KiB
    config.http2_connections = 8
    config.http2_slots = 16
  }
  config.evict_idle_milliseconds = 200
  config.compress_level = 6
  config.on_large_body = large_body
  storage := mem.arena_from_source(mem.within(arena, evented.storage_size(config, WorkerCount) + mem.MiB))
  address := net.ipv4(127, 0, 0, 1, 0)
  listener := net.tcp_listen_ipv4(&setup, &address, 64)
  _ = evented.start(storage, &setup, workers[..], &listener, config, binding.handler, binding.context)
  io.println("port {}", evented.local_port(workers[..]))
  for sync.load_u32(&app.quit) == 0 {
    time.sleep(20 * time.Millisecond)
  }
  evented.stop(workers[..])
  evented.join(&setup, workers[..])
  net.listener_close(&listener)
  pool.stop(&setup, jobs)
  evicted: u64 = 0
  refused: u64 = 0
  for *worker in workers {
    evicted += worker.evicted
    refused += worker.refused
  }
  io.println("evicted {} refused {}", evicted, refused)
}
