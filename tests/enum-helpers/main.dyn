use "std/bytes"
use "std/enums"
use "std/math"
use "std/mem"

enum Key { Null, Space, Shift }

fn main() {
  if enums.count(Key) != 3 || enums.from_int(Key, 2) != Key.Shift || enums.from_int(Key, 9) != Key.Null {
    #panic("enums")
  }
  if !bytes.equal(enums.name(Key.Space), "Space") {
    #panic("name")
  }
  if math.div_or_zero(7, 0) != 0 || math.rem_or_zero(7, 2) != 1 {
    #panic("or zero")
  }
  arena := mem.arena_alloc(0)
  defer mem.arena_release(arena)
  items: []u32
  stub: u32 = 99
  first := mem.try_append(arena, &items, 1, &stub)
  other := mem.push(u32, arena)
  second := mem.try_append(arena, &items, 2, &stub)
  if first.* != 1 || second != &stub || other.* != 0 {
    #panic("try_append")
  }
}
