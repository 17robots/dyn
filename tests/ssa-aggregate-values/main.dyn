use "std/io"

struct Pair { a: i32, b: i32 }
enum Shape { Dot, Circle: f64, Box: Pair, Count: i64 }
enum Wide { Empty, Text: []const u8, Value: i64 }

fn make(kind: i64, x: f64) Shape {
  case kind {
    1 => { return Shape.Circle(x) }
    2 => { return Shape.Box(Pair{ a: #cast(i32, x), b: 7 }) }
    3 => { return Shape.Count(#cast(i64, x) * 10) }
    _ => { return Shape.Dot }
  }
}

fn measure(s: Shape) f64 {
  case s {
    Shape.Dot => { return 0.5 }
    Shape.Circle r => { return r * 2.0 }
    Shape.Box p => { return #cast(f64, p.a * p.b) }
    Shape.Count n => { return #cast(f64, n) }
  }
}

// Three integer leaves: returned in RAX, RDX and RCX on x86-64, which keeps
// this function on the tree emitter there.
fn widen(w: Wide, s: Shape) Wide {
  case w {
    Wide.Empty => { return Wide.Value(#cast(i64, measure(s))) }
    Wide.Text t => { return Wide.Value(#cast(i64, #len(t)) + #cast(i64, measure(s))) }
    Wide.Value v => { return Wide.Value(v + 1) }
  }
}

fn wide_value(w: Wide) i64 {
  case w {
    Wide.Value v => { return v }
    Wide.Text t => { return #cast(i64, #len(t)) }
    _ => { return -1 }
  }
}

// Eleven integer leaves: the last five go on the stack.
fn sum_ints(a: [8]i64, b: [3]i64) [3]i64 {
  out: [3]i64
  for i in 0..8 {
    out[i % 3] += a[i] * #cast(i64, i + 1)
  }
  for i in 0..3 {
    out[i] += b[i]
  }
  return out
}

// Twelve float leaves: four go on the stack. Two doubles return in XMM0/1.
fn sum_floats(a: [10]f32, b: [2]f64) [2]f64 {
  out: [2]f64
  for i in 0..10 {
    out[i % 2] += #cast(f64, a[i]) * #cast(f64, i + 1)
  }
  out[0] += b[0]
  out[1] -= b[1]
  return out
}

fn mixed(n: i64, s: Shape, a: [4]i32, w: Wide, f: [3]f64, t: Shape) f64 {
  total := #cast(f64, n) + measure(s) + measure(t) + #cast(f64, wide_value(w))
  for i in 0..4 {
    total += #cast(f64, a[i]) * 0.25
  }
  return total + f[0] - f[1] * f[2]
}

// Returns three integers, so a tree-emitter caller on x86-64 of the SSA
// functions above.
fn via_tree(s: Shape, k: i64) [3]i64 {
  ints: [8]i64
  for i in 0..8 {
    ints[i] = k + #cast(i64, i)
  }
  floats: [10]f32
  for i in 0..10 {
    floats[i] = #cast(f32, i) * 0.5
  }
  extra: [3]i64 = [1, 2, 3]
  sums := sum_ints(ints, extra)
  halves: [2]f64 = [1.5, 2.5]
  pair := sum_floats(floats, halves)
  made := make(k % 4, 3.0)
  out: [3]i64 = [sums[0] + #cast(i64, measure(s)), sums[1] + #cast(i64, pair[0] + pair[1]), sums[2] + #cast(i64, measure(made))]
  return out
}

// Calls widen, so stays on the tree emitter on x86-64; its array and enum
// parameters arrive from the SSA caller below, some on the stack.
fn tree_take(a: [8]i64, s: Shape, f: [10]f32, w: Wide) i64 {
  total := wide_value(widen(w, s))
  for i in 0..8 {
    total += a[i] * #cast(i64, i)
  }
  for i in 0..10 {
    total += #cast(i64, f[i] * 4.0)
  }
  return total
}

fn ssa_call(k: i64) i64 {
  ints: [8]i64
  floats: [10]f32
  for i in 0..8 {
    ints[i] = k * #cast(i64, i + 2)
  }
  for i in 0..10 {
    floats[i] = #cast(f32, k) + #cast(f32, i) * 0.25
  }
  return tree_take(ints, make(k % 4, 2.0), floats, Wide.Text("abc")) + tree_take(ints, Shape.Count(k), floats, Wide.Value(k))
}

fn main() {
  shapes: [4]Shape = [make(0, 0.0), make(1, 1.25), make(2, 3.0), make(3, 4.0)]
  for i in 0..4 {
    io.print("{} ", measure(shapes[i]))
  }
  io.println("")
  words := Wide.Text("hello")
  w := widen(words, shapes[1])
  io.println("{} {} {}", wide_value(w), wide_value(widen(Wide.Empty, shapes[2])), wide_value(widen(Wide.Value(41), shapes[0])))
  for k in 0..4 {
    r := via_tree(shapes[#cast(usize, k)], #cast(i64, k))
    io.println("{} {} {}", r[0], r[1], r[2])
  }
  io.println("{} {}", ssa_call(3), ssa_call(6))
  quarter: [4]i32 = [4, 8, 12, 16]
  thirds: [3]f64 = [1.0, 2.0, 3.0]
  io.println("{}", mixed(5, shapes[1], quarter, Wide.Value(100), thirds, shapes[3]))
}
