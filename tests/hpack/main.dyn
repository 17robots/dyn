// HPACK against Go's encoder: vectors.txt holds 300 header blocks written by
// golang.org/x/net/http2/hpack with a 256-byte table, size updates, sensitive
// fields and Huffman strings, each with the fields it encodes (both hex).
// Decodes every block in order with one decoder, then round-trips each field
// list through encode_field. Prints the counts and the first mismatch.
use "std/bytes"
use "std/encoding/hex"
use "std/io"
use "std/mem"
use "std/net/http/hpack"
use "std/net/http/qpack"

const Vectors: []const u8 = #load("vectors.txt")

// Decodes block, joining fields as name=value|...; empty on failure.
fn decode_all(decoder: *hpack.Decoder, block: []const u8, output: []u8) []const u8 {
  scratch: [1024]u8
  used: usize = 0
  at: usize = 0
  hpack.decode_begin(decoder)
  for at < block.len {
    field := hpack.decode_field(decoder, block[at..], scratch[..]) catch { return "error" }
    at += field.consumed
    if field.update { continue }
    if used > 0 {
      output[used] = '|'
      used += 1
    }
    used += mem.copy(output[used..], field.name)
    output[used] = '='
    used += 1
    used += mem.copy(output[used..], field.value)
  }
  return output[..used]
}

// A QPACK section decoded as name=value|...; "error" on failure.
fn qpack_all(section: []const u8, output: []u8) []const u8 {
  prefix := qpack.decode_prefix(section)
  if !prefix.valid { return "error" }
  scratch: [1024]u8
  used: usize = 0
  at := prefix.consumed
  for at < section.len {
    field := qpack.decode_field(section[at..], scratch[..]) catch { return "error" }
    at += field.consumed
    if used > 0 {
      output[used] = '|'
      used += 1
    }
    used += mem.copy(output[used..], field.name)
    output[used] = '='
    used += 1
    used += mem.copy(output[used..], field.value)
  }
  return output[..used]
}

fn main() {
  arena := mem.arena_alloc(4 * mem.MiB)
  defer mem.arena_release(arena)
  storage: [hpack.DefaultTableSize]u8
  entries: [hpack.DefaultTableSize / hpack.EntryOverhead]hpack.Entry
  decoder := hpack.decoder(storage[..], entries[..])
  decoded: usize = 0
  encoded: usize = 0
  lines := bytes.splitter(Vectors, "\n")
  for {
    piece := bytes.split_next(&lines)
    if lines.ended { break }
    if piece.len == 0 { continue }
    tab := bytes.find_byte(piece, '\t')
    block := hex.decode(arena, piece[..tab]) catch { #panic("hex vector") }
    want := hex.decode(arena, piece[tab + 1..]) catch { #panic("hex vector") }
    output: [4096]u8
    got := decode_all(&decoder, block, output[..])
    if !bytes.equal(got, want) {
      io.println("decode mismatch {}: {} != {}", decoded, got, want)
      return
    }
    decoded += 1
    // Round trip: encode the same fields, decode with a fresh table.
    wire: [4096]u8
    length: usize = 0
    fields := bytes.splitter(want, "|")
    for {
      item := bytes.split_next(&fields)
      if fields.ended { break }
      equals := bytes.find_byte(item, '=')
      written := hpack.encode_field(wire[length..], item[..equals], item[equals + 1..])
      if written == 0 {
        io.println("encode failed {}", encoded)
        return
      }
      length += written
    }
    fresh_storage: [hpack.DefaultTableSize]u8
    fresh_entries: [hpack.DefaultTableSize / hpack.EntryOverhead]hpack.Entry
    fresh := hpack.decoder(fresh_storage[..], fresh_entries[..])
    again: [4096]u8
    round := decode_all(&fresh, wire[..length], again[..])
    if !bytes.equal(round, want) {
      io.println("round trip mismatch {}: {}", encoded, round)
      return
    }
    encoded += 1
    // The same fields through QPACK, which has no dynamic table here.
    section: [4096]u8
    section_length := qpack.encode_prefix(section[..])
    items := bytes.splitter(want, "|")
    for {
      item := bytes.split_next(&items)
      if items.ended { break }
      equals := bytes.find_byte(item, '=')
      section_length += qpack.encode_field(section[section_length..], item[..equals], item[equals + 1..])
    }
    qpack_out: [4096]u8
    if !bytes.equal(qpack_all(section[..section_length], qpack_out[..]), want) {
      io.println("qpack mismatch {}", encoded)
      return
    }
  }
  // RFC 9204 B.1, and dynamic references refused.
  rfc: [64]u8
  if !bytes.equal(qpack_all("\x00\x00\x51\x0b/index.html", rfc[..]), ":path=/index.html") ||
    !bytes.equal(qpack_all("\x00\x00\x80", rfc[..]), "error") || !bytes.equal(qpack_all("\x02\x00", rfc[..]), "error") {
    io.println("qpack examples failed")
    return
  }
  io.println("decoded {} encoded {} size {}", decoded, encoded, decoder.table.size)
}
