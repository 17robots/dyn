// parse.u64_decimal and parse.i64_decimal edges: limits, overflow, offsets.
use "std/io"
use "std/parse"

fn check(ok: bool, label: []const u8) {
  if !ok {
    #panic(label)
  }
}

fn u64_failure(text: []const u8) parse.ParseErr {
  _ = parse.u64_decimal(text) catch err { return err }
  #panic("u64 should fail")
}

fn i64_failure(text: []const u8) parse.ParseErr {
  _ = parse.i64_decimal(text) catch err { return err }
  #panic("i64 should fail")
}

fn too_large(err: parse.ParseErr) bool {
  case err {
    .TooLarge(_) => { return true }
    _ => { return false }
  }
}

fn u64(text: []const u8) u64 {
  return parse.u64_decimal(text) catch { #panic("u64") }
}

fn i64(text: []const u8) i64 {
  return parse.i64_decimal(text) catch { #panic("i64") }
}

fn main() {
  check(u64("0") == 0, "zero")
  check(u64("18446744073709551615") == 18446744073709551615, "max")
  check(too_large(u64_failure("18446744073709551616")), "over")
  check(!too_large(u64_failure("")) && parse.offset(u64_failure("")) == 0, "empty")
  check(parse.offset(u64_failure("12a")) == 2, "offset")
  check(i64("-9223372036854775808") == -9223372036854775807 - 1, "min")
  check(too_large(i64_failure("-9223372036854775809")), "under")
  check(too_large(i64_failure("9223372036854775808")), "i64 over")
  check(parse.offset(i64_failure("-")) == 1, "dash")
  check(i64("-42") == -42, "neg")
  io.println("ok")
}
