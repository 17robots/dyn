use "std/io" stream
use "std/mem" memory
use "std/text/template" text_template
use "std/html/template" html_template

fn equal(left: []const u8, right: []const u8) bool {
  if #len(left) != #len(right) { return false }
  i: usize = 0
  for i < #len(left) { if left[i] != right[i] { return false } i += 1 }
  return true
}

fn main() {
  arena_storage: [1024]u8 = []
  arena := memory.arena_from_buffer(arena_storage[..])

  parsed := text_template.parse(&arena, "Hello, {{ name }}!")
  if !parsed.ok { #panic("text template parse") }
  fields: [1]text_template.Field = [text_template.Field{ name: "name", value: "Dyn" }]
  output_storage: [64]u8 = []
  output := stream.buffer_writer(output_storage[..])
  rendered := text_template.render(stream.buffer_writer_adapter(&output), &parsed.template, fields[..])
  if !rendered.ok || !equal(stream.buffer_writer_bytes(&output), "Hello, Dyn!") {
    #panic("text template render")
  }

  html_parsed := html_template.parse(&arena, "<p>{{ value }}</p>")
  html_fields: [1]html_template.Field = [html_template.Field{ name: "value", value: "<Dyn & friends>" }]
  html_storage: [128]u8 = []
  html_output := stream.buffer_writer(html_storage[..])
  html_rendered := html_template.render(
    stream.buffer_writer_adapter(&html_output),
    &html_parsed.template,
    html_fields[..],
  )
  if !html_rendered.ok ||
    !equal(stream.buffer_writer_bytes(&html_output), "<p>&lt;Dyn &amp; friends&gt;</p>") {
    #panic("HTML template escaping")
  }
}
