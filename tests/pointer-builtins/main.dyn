struct Pair { a: u32, b: u64 }

fn sum(first: *const u32, count: usize) u32 {
  total: u32 = 0
  for value in #slice(first, count) {
    total += value
  }
  return total
}

fn main() {
  values: [4]u32 = [1, 2, 3, 4]
  if sum(&values[0], 4) != 10 {
    #panic("walk")
  }
  view := #slice(&values[1], 2)
  if view.len != 2 || view[1] != 3 {
    #panic("slice")
  }
  if &values[2] >= &values[3] {
    #panic("pointer order")
  }
  pairs: [2]Pair = [Pair{ a: 1 }, Pair{ a: 2 }]
  run := #slice(&pairs[0], 2)
  if run[1].a != 2 {
    #panic("stride")
  }
}
