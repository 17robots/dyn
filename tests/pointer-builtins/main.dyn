struct Pair { a: u32, b: u64 }

fn sum(first: *const u32, count: usize) u32 {
  total: u32 = 0
  at := first
  end := #offset(first, count)
  for at < end {
    total += at.*
    at = #offset(at, 1)
  }
  return total
}

fn main() {
  values: [4]u32 = [1, 2, 3, 4]
  if sum(&values[0], 4) != 10 {
    #panic("walk")
  }
  view := #slice(&values[1], 2)
  if #len(view) != 2 || view[1] != 3 {
    #panic("slice")
  }
  last := #offset(&values[3], -1)
  if last.* != 3 || last >= &values[3] {
    #panic("negative offset")
  }
  pairs: [2]Pair = [Pair{ a: 1 }, Pair{ a: 2 }]
  second := #offset(&pairs[0], 1)
  if second.a != 2 {
    #panic("stride")
  }
}
