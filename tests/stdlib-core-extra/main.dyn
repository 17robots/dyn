use "std/math" math
use "std/sort" sort

fn main() {
  if math.min_i64(4, 2) != 2 { #panic("min failed") }
  if math.max_u64(4, 2) != 4 { #panic("max failed") }
  if math.clamp_i64(9, 1, 5) != 5 { #panic("clamp failed") }
  if math.abs_i64(-9) != 9 { #panic("abs failed") }
  if math.gcd_u64(54, 24) != 6 { #panic("gcd failed") }
  if math.sign_i64(-4) != -1 || math.sign_i64(0) != 0 || math.sqrt_u64(80) != 8 {
    #panic("extended math failed")
  }
  sum := math.checked_add_u64(40, 2)
  product := math.checked_mul_u64(6, 7)
  power := math.pow_u64(3, 4)
  multiple := math.lcm_u64(21, 6)
  if !sum.ok || sum.value != 42 || !product.ok || product.value != 42 ||
      !power.ok || power.value != 81 || !multiple.ok || multiple.value != 42 {
    #panic("checked math failed")
  }
  maximum: u64 = 18446744073709551615
  if math.checked_add_u64(maximum, 1).ok || math.checked_mul_u64(maximum, 2).ok ||
      math.pow_u64(2, 64).ok || math.lcm_u64(maximum, 2).ok ||
      math.sqrt_u64(maximum) != 4294967295 || math.pow_u64(0, 0).value != 1 {
    #panic("math overflow failed")
  }

  signed: [7]i64 = [4, -1, 4, 0, 9, -8, 2]
  sort.i64s(signed[..])
  if signed[0] != -8 || signed[1] != -1 || signed[2] != 0 || signed[6] != 9 {
    #panic("i64 sort failed")
  }
  found := sort.search_i64(signed[..], 4)
  absent := sort.search_i64(signed[..], 3)
  if !found.found || found.index != 4 || absent.found || absent.index != 4 {
    #panic("i64 search failed")
  }
  unsigned: [5]u64 = [5, 1, 3, 1, 2]
  sort.u64s(unsigned[..])
  first := sort.search_u64(unsigned[..], 1)
  after := sort.search_u64(unsigned[..], 6)
  if unsigned[0] != 1 || unsigned[1] != 1 || unsigned[4] != 5 ||
      !first.found || first.index != 0 || after.found || after.index != 5 {
    #panic("u64 sort/search failed")
  }
  empty: [0]i64 = []
  singleton: [1]u64 = [7]
  sort.i64s(empty[..])
  sort.u64s(singleton[..])
  if sort.search_i64(empty[..], 0).found || singleton[0] != 7 {
    #panic("sort boundary failed")
  }
}
