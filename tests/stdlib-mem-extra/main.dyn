use "std/mem" mem
use "std/bytes" byte_ops
use "std/encoding/binary"
use "std/container/ring" ring_ops
use "std/container/bit_set"
fn main() {
  storage: [32]u8 = []
  arena := mem.arena_from_buffer(storage[..])
  failed := mem.arena_try_push(&arena, 64, 1)
  if failed.ok { #panic("try push") }
  zero := mem.arena_try_push(&arena, 0, 8)
  if !zero.ok || mem.arena_mark(&arena) != 0 { #panic("zero allocation") }
  bad_align := mem.arena_try_push(&arena, 1, 3)
  if bad_align.ok || mem.arena_mark(&arena) != 0 { #panic("invalid alignment changed arena") }
  buffer := byte_ops.builder(mem.arena_push(&arena, 8, 1)[..8])
  if !byte_ops.builder_write(&buffer, "dyn") { #panic("buffer") }
  if #len(byte_ops.builder_bytes(&buffer)) != 3 { #panic("written") }

  parent_storage: [32]u8 = []
  parent := mem.arena_from_buffer(parent_storage[..])
  child := mem.arena_sub(&parent, 8)
  if mem.arena_capacity(&child) != 8 || mem.arena_mark(&parent) != 8 { #panic("sub arena") }
  child_allocation := mem.arena_try_push(&child, 8, 1)
  if !child_allocation.ok || mem.arena_remaining(&child) != 0 || mem.arena_mark(&parent) != 8 {
    #panic("child allocation changed parent")
  }
  scratch_a := mem.arena_sub(&parent, 8)
  scratch_b := mem.arena_sub(&parent, 8)
  conflicted := mem.scratch_begin(&scratch_a, &scratch_b, &scratch_a)
  unconstrained := mem.scratch_begin(&scratch_a, &scratch_b, nil)
  if conflicted.arena != &scratch_b || unconstrained.arena != &scratch_a { #panic("scratch select") }
  mem.scratch_end(&unconstrained)
  mem.scratch_end(&conflicted)

  bytes: [8]u8 = []
  bytes[0] = 1
  bytes[1] = 2
  bytes[2] = 3
  bytes[3] = 4
  _ = mem.move(bytes[2..], bytes[..4])
  if bytes[2] != 1 || bytes[5] != 4 { #panic("overlap move") }
  if mem.compare("abc", "abd") >= 0 || mem.compare("abc", "abc") != 0 { #panic("compare") }

  encoded: [8]u8 = []
  binary.store_u64_le(encoded[..], 72623859790382856)
  if binary.load_u64_le(encoded[..]) != 72623859790382856 { #panic("little endian") }
  binary.store_u32_be(encoded[..], 16909060)
  if binary.load_u32_be(encoded[..]) != 16909060 { #panic("big endian") }
  binary.store_u64_be(encoded[..], 72623859790382856)
  if binary.load_u64_be(encoded[..]) != 72623859790382856 { #panic("big endian u64") }
  ring_storage: [2]u8 = []
  ring := ring_ops.init(ring_storage[..])
  popped: u8 = 0
  if !ring_ops.push(&ring, 7) || !ring_ops.push(&ring, 8) || ring_ops.push(&ring, 9) ||
     !ring_ops.pop(&ring, &popped) || popped != 7 { #panic("ring") }
  words: [2]u64 = []
  if !bit_set.set(words[..], 65, true) || !bit_set.get(words[..], 65) || bit_set.get(words[..], 130) {
    #panic("bitset")
  }
  bit_set.clear(words[..])
  if bit_set.get(words[..], 65) { #panic("bitset clear") }
}
