use "std/container/slot_map" slots
use "std/mem"
use "std/profile"
use "std/strings"

fn expect(value: bool) { if !value { #panic("memory observation contract") } }

fn handles() {
  data: [8]u8 = []
  generations: [2]u32 = []
  occupied: [1]u64 = []
  map := slots.init(data[..], generations[..], occupied[..], 4)
  other_data: [8]u8 = []
  other_generations: [2]u32 = []
  other_occupied: [1]u64 = []
  other := slots.init(other_data[..], other_generations[..], other_occupied[..], 4)
  source: [4]u8 = [1, 2, 3, 4]
  first := slots.insert(&map, source[..])
  foreign := slots.insert(&other, source[..])
  expect(first.index == foreign.index && first.generation == foreign.generation)
  expect(!slots.get(&map, foreign).ok && !slots.remove(&map, foreign))
  expect(!slots.get(&map, slots.Handle{}).ok)
  invalid := first
  invalid.index = 99
  expect(!slots.get(&map, invalid).ok)
  expect(slots.insert(&map, source[..3]).generation == 0 && slots.length(&map) == 1)
  saved: [5]u8 = [9, 9, 9, 9, 9]
  expect(slots.copy_into(&map, first, saved[..3]) == slots.CopyStatus.Capacity)
  expect(saved[0] == 9 && saved[2] == 9)
  expect(slots.copy_into(&map, first, saved[..]) == slots.CopyStatus.Complete)
  expect(saved[0] == 1 && saved[3] == 4 && saved[4] == 9)
  second := slots.insert(&map, source[..])
  expect(slots.insert(&map, source[..]).generation == 0)
  full := slots.snapshot(&map)
  expect(full.capacity == 2 && full.live == 2 && full.available == 0 && full.retired == 0)
  expect(slots.remove(&map, first) && !slots.remove(&map, first))
  source[0] = 7
  replacement := slots.insert(&map, source[..])
  expect(replacement.index == first.index && replacement.generation != first.generation)
  expect(!slots.get(&map, first).ok && slots.get(&map, replacement).data[0] == 7)
  expect(saved[0] == 1 && saved[3] == 4)
  expect(slots.copy_into(&map, first, saved[..]) == slots.CopyStatus.Missing && saved[0] == 1)
  expect(slots.get(&map, second).data[0] == 1)
  // Reinitialization preserves generation history, not existing values or handles.
  map = slots.init(data[..], generations[..], occupied[..], 4)
  expect(!slots.get(&map, replacement).ok && !slots.get(&map, second).ok)
  expect(slots.snapshot(&map).available == 2 && full.live == 2)

  // Only this fixture seeds near-saturation metadata before initialization.
  // Application code must initialize generation backing to zero, once.
  retired_data: [4]u8 = []
  retired_generations: [1]u32 = [4294967293]
  retired_words: [1]u64 = []
  retiring := slots.init(retired_data[..], retired_generations[..], retired_words[..], 4)
  last := slots.insert(&retiring, source[..])
  expect(last.generation == 4294967294 && slots.remove(&retiring, last))
  state := slots.snapshot(&retiring)
  expect(state.capacity == 1 && state.live == 0 && state.available == 0 && state.retired == 1)
  expect(slots.insert(&retiring, source[..]).generation == 0 && !slots.get(&retiring, last).ok)
  retiring = slots.init(retired_data[..], retired_generations[..], retired_words[..], 4)
  expect(slots.snapshot(&retiring).retired == 1)
  // Both copy operations preserve memmove semantics for overlapping data.
  overlap_data: [8]u8 = [0, 1, 2, 3, 4, 5, 6, 7]
  overlap_generations: [2]u32 = []
  overlap_words: [1]u64 = []
  overlap := slots.init(overlap_data[..], overlap_generations[..], overlap_words[..], 4)
  overlap_handle := slots.insert(&overlap, overlap_data[2..6])
  expect(slots.get(&overlap, overlap_handle).data[0] == 2 && overlap_data[3] == 5)
  expect(slots.copy_into(&overlap, overlap_handle, overlap_data[1..5]) == slots.CopyStatus.Complete)
  expect(overlap_data[1] == 2 && overlap_data[2] == 3 && overlap_data[4] == 5)
  empty := slots.SlotMap{}
  expect(!slots.get(&empty, first).ok && slots.snapshot(&empty).capacity == 0)
}

fn memory_and_trace() {
  backing: [64]u8 = []
  arena := mem.arena_from_buffer(backing[..])
  arena.poison_on_rewind = true
  allocated := mem.arena_try_push(&arena, 12, 1)
  expect(allocated.ok)
  before := mem.arena_snapshot(&arena)
  expect(before.capacity == 64 && before.used == 12 && before.remaining == 52)
  expect(!before.owns_memory && before.poison_on_rewind)
  failed := mem.arena_try_push(&arena, 65, 1)
  expect(!failed.ok && mem.arena_snapshot(&arena).used == 12)
  mem.arena_reset(&arena)
  expect(mem.arena_snapshot(&arena).used == 0 && before.used == 12)
  expect(mem.arena_release(&arena).ok && mem.arena_snapshot(&arena).capacity == 0)

  // Retained output survives actual scratch overwrite, not merely a cursor reset.
  output_backing: [64]u8 = []
  scratch_backing: [64]u8 = []
  output := mem.arena_from_buffer(output_backing[..])
  scratch := mem.arena_from_buffer(scratch_backing[..])
  transient := strings.clone(&scratch, "saved")
  expect(transient.ok)
  retained := strings.clone(&output, transient.value)
  expect(retained.ok)
  mem.arena_reset(&scratch)
  reused := mem.arena_push(&scratch, 64, 1)[..64]
  for *byte in reused { byte.* = 88 }
  expect(strings.equal(retained.value, "saved"))

  events: [1]profile.Event = []
  trace := profile.trace(events[..])
  expect(profile.finish(&trace, profile.begin("first")))
  expect(!profile.finish(&trace, profile.begin("overflow")))
  expect(#len(profile.recorded(&trace)) == 1 && trace.dropped == 1)
  expect(strings.equal(profile.recorded(&trace)[0].name, "first"))
  profile.clear(&trace)
  expect(#len(profile.recorded(&trace)) == 0 && trace.dropped == 0)
}

fn main() { handles() memory_and_trace() }
