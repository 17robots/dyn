use "std/mem"
use "std/io"
use "std/bytes"
use "std/strings"
use "std/encoding/json"

fn main() {
  storage: [4096]u8 = []
  arena := mem.arena_from_buffer(storage[..])
  first := mem.arena_try_push_uninit(&arena, 7, 16)
  if !first.ok || #cast(usize) first.memory % 16 != 0 { #panic("uninit alignment") }
  mark := mem.arena_mark(&arena)
  failed := mem.arena_try_push_uninit(&arena, #cast(usize) -1, 16)
  if failed.ok || mem.arena_mark(&arena) != mark { #panic("uninit overflow rollback") }
  if mem.arena_push_uninit(&arena, 8, 8) == nil { #panic("uninit push") }
  pool := mem.pool_init(&arena, 2, 16, 8)
  a := mem.pool_try_acquire(&pool) b := mem.pool_try_acquire(&pool)
  if a == nil || b == nil || a == b || mem.pool_try_acquire(&pool) != nil || mem.pool_available(&pool) != 0 { #panic("pool exhaustion") }
  mem.pool_release(&pool, a)
  if mem.pool_try_acquire(&pool) != a || mem.pool_available(&pool) != 0 { #panic("pool reuse") }

  root := json.make_array(&arena)
  nothing := json.make_null(&arena)
  if !json.is_array(root) || !json.is_null(nothing) || json.is_null(nil) { #panic("JSON makers") }
  if !json.add(root,nothing) || json.add(root,nothing) || json.array_length(root) != 1 { #panic("JSON duplicate attachment") }
  child := json.make_array(&arena)
  if !json.add(root,child) || json.add(child,root) || json.add(root,root) { #panic("JSON cycle") }
  other := json.make_object(&arena)
  if json.add_member(other,"changed",nothing) || #len(nothing.key) != 0 || json.array_length(root) != 2 { #panic("JSON reparent rollback") }
  mark = mem.arena_mark(&arena)
  if json.make_number(&arena,"01") != nil || json.make_number(&arena,"1e") != nil || mem.arena_mark(&arena) != mark { #panic("JSON invalid number rollback") }
  number_text: [2]u8 = ['4','2']
  number := json.make_number(&arena,number_text[..])
  text := json.make_string(&arena,number_text[..])
  if !json.is_number(number) || !json.is_string(text) || !json.add(child,number) || !json.add(child,text) { #panic("JSON child constructors") }
  number_text[0] = '3'
  if !bytes.equal(number.text,"32") || !bytes.equal(text.text,"32") { #panic("JSON documented borrow") }
  exhausted := mem.arena_from_buffer(storage[..0])
  if json.make_null(&exhausted) != nil || json.make_array(&exhausted) != nil || json.make_string(&exhausted,"x") != nil || exhausted.offset != 0 { #panic("JSON capacity") }

  scratch: [3]u8 = [] out: [8]u8 = []
  cursor := io.cursor("abcdef") writer := io.buffer_writer(out[..])
  copied := io.copy_n(io.buffer_writer_adapter(&writer),io.cursor_reader(&cursor),4,scratch[..])
  if copied.status != io.Status.Complete || copied.transferred != 4 || cursor.offset != 4 || !bytes.equal(io.buffer_writer_bytes(&writer),"abcd") { #panic("copy_n bounded") }
  copied = io.copy_n(io.buffer_writer_adapter(&writer),io.cursor_reader(&cursor),4,scratch[..])
  if copied.status != io.Status.End || copied.transferred != 2 || !bytes.equal(io.buffer_writer_bytes(&writer),"abcdef") { #panic("copy_n EOF progress") }
  cursor = io.cursor("abcdef") writer = io.buffer_writer(out[..2])
  copied = io.copy_n(io.buffer_writer_adapter(&writer),io.cursor_reader(&cursor),4,scratch[..])
  if copied.status != io.Status.Error || copied.error != -28 || copied.transferred != 2 || !bytes.equal(io.buffer_writer_bytes(&writer),"ab") { #panic("copy_n writer partial") }
  cursor = io.cursor("abc")
  copied = io.copy_n(io.buffer_writer_adapter(&writer),io.cursor_reader(&cursor),1,scratch[..0])
  if copied.status != io.Status.Error || cursor.offset != 0 { #panic("copy_n scratch preflight") }
  if io.copy_n(io.Writer{},io.Reader{},0,scratch[..0]).status != io.Status.Complete { #panic("copy_n zero") }

  view := strings.strip_prefix(number_text[..],"3")
  number_text[1] = '7'
  if !bytes.equal(view,"7") || !bytes.equal(strings.strip_suffix(number_text[..],"7"),"3") || !strings.contains(number_text[..],"7") { #panic("string borrowed views") }
  if strings.split_count("a,,b,",",").value != 4 || strings.split_count("abc","").ok { #panic("split count") }
  if !strings.ascii_is_digit('9') || strings.ascii_is_digit('x') || !strings.ascii_is_alpha('Z') || !strings.ascii_is_whitespace('\n') || strings.ascii_to_lower('A') != 'a' || strings.ascii_to_upper('z') != 'Z' { #panic("ASCII predicates") }
}
