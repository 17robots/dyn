use "std/thread"
use "std/sync"

fn run(raw: rawptr) isize {
  count := #cast(*sync.AtomicU64) raw
  i: usize = 0
  for i < 1000 {
    _ = sync.fetch_add_u64(count, 1)
    i += 1
  }
  return 0
}

fn main() {
  value := sync.atomic_u32(7)
  if sync.load_u32(&value) != 7 { #panic("atomic load failed") }
  if sync.fetch_add_u32(&value, 2) != 7 || sync.load_u32(&value) != 9 { #panic("atomic add failed") }
  if !sync.compare_exchange_u32(&value, 9, 3) { #panic("atomic compare exchange failed") }

  lock := sync.mutex()
  if !sync.try_lock(&lock) { #panic("mutex try lock failed") }
  sync.unlock(&lock)
  gate := sync.semaphore(1)
  if !sync.semaphore_try_wait(&gate) || sync.semaphore_try_wait(&gate) { #panic("semaphore") }
  sync.semaphore_post(&gate)
  initializer := sync.once()
  if !sync.once_begin(&initializer) { #panic("once winner") }
  sync.once_complete(&initializer)
  if sync.once_begin(&initializer) { #panic("once repeat") }
  count := sync.atomic_u64(0)
  stack: [65536]u8 = []
  worker := thread.Thread{}
  if thread.spawn(&worker, stack[..], &run, #cast(rawptr) &count) < 0 { #panic("thread spawn failed") }
  _ = run(#cast(rawptr) &count)
  if thread.join(&worker) != 0 { #panic("thread join failed") }
  if sync.load_u64(&count) != 2000 { #panic("thread result mismatch") }
}
