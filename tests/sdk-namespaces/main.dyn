use "std/encoding/xml" xml
use "std/bytes" bytes
fn main() {
  names: [8][]const u8 = []
  if !xml.valid("<é名 属性='ok'><𐀀/></é名>", names[..]) { #panic("Unicode XML names") }
  if xml.valid("<́bad/>", names[..]) { #panic("combining initial") }
  bindings: [8]xml.NamespaceBinding = [] frames: [8]xml.NamespaceFrame = [] storage: [1024]u8 = []
  context := xml.namespaces(bindings[..],frames[..],storage[..])
  scanner := xml.scanner("<root xmlns='urn:default' xmlns:p='urn:a&amp;b'><p:child plain='x' p:attr='y'/></root>")
  root := xml.next(&scanner) expanded := xml.namespace_enter(&context,root.event)
  if !expanded.ok || !bytes.equal(expanded.uri,"urn:default") { #panic("default") }
  child := xml.next(&scanner) other := xml.namespace_enter(&context,child.event)
  if !other.ok || !bytes.equal(other.uri,"urn:a&b") || !bytes.equal(other.local,"child") { #panic("prefix") }
  plain := xml.namespace_resolve(&context,"plain",true)
  if !plain.ok || #len(plain.uri) != 0 { #panic("unprefixed attribute") }
  if !xml.namespace_leave(&context,child.event.name) || !xml.namespace_leave(&context,root.event.name) || context.used != 0 { #panic("scope") }
  bad := xml.scanner("<x xmlns:a='u' xmlns:b='u' a:v='1' b:v='2'/>")
  if xml.namespace_enter(&context,xml.next(&bad).event).ok || context.depth != 0 || context.used != 0 { #panic("duplicate expanded attribute") }
  unbound := xml.scanner("<p:x/>")
  if xml.namespace_enter(&context,xml.next(&unbound).event).ok { #panic("unbound") }
}
