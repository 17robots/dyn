module main

{ add, add2, add3, DivideError1, DivideError2, divide } := use "other"

List := (T: comp type) type {
  Thing := struct {}
  Thing.init := () Thing => .{}
  return Thing
}
List2 := (T: comp type) type => struct {}
IntList := List(i32)
inline_fn := inline () i32 => 1
hmm_type := get_type(){}
hmm := hmm_type.vals.?.*.current_val or hmm_type.vals.?.*.other_vals[1]
get_type := () type => struct {
  vals: ?*struct {
    current_val: ?*type,
    other_vals: []*type
  }
}

other_stuff := () {
  { Point } := use "other"
  what := Point{ x: 0, y: 0 }
  { x, y } := what
  with_tup := (x: { i32, i32 }) {}
  with_tup(.{x,y})
}
