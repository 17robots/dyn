module other

pub add := (x: i32, y: i32) i32 { return x + y }
pub add2 := (x: i32, y: i32) i32 => x + y
pub add3 := (x: i32 = 0, y: i32 = 0) i32 => x + y
pub DivideError1 := enum { UhOh }
pub DivideError2 := enum { DivideByZero }
pub divide := (x: f32, y: f32) f32!DivideError1|DivideError2 => if y == 0 DivideError2.DivideByZero else x / y
pub usable_outside: u2 = 2
Point := struct { x: i32, y: i32 }
