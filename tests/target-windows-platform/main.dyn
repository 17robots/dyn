use mem "std/mem"
use platform "std/os/windows"

#target(arch: x86_64, kernel: windows, abi: win64)

fn main() {
  arena := mem.arena_alloc(4096)
  memory := mem.push_bytes(arena, 4096)
  memory[0] = 42
  mem.arena_release(arena)
  descriptor := platform.file_open("dyn-platform-probe", false, false) catch -1
  if descriptor >= 0 {
    platform.file_close(descriptor) catch {}
  }
  socket := platform.socket_open(2, 1, 6)
  if socket >= 0 { _ = platform.socket_close(#cast(usize, socket)) }
  events: [1]platform.PollDescriptor
  _ = platform.event_poll(events[..0], 0)
}
