use "std/mem" mem
use "std/os/windows" platform

#target(arch: x86_64, kernel: windows, abi: win64)

fn main() {
  arena := mem.arena_create(4096)
  if !arena.ok { #panic("arena allocation") }
  memory := mem.arena_push(&arena.arena, 4096, 1)[..4096]
  memory[0] = 42
  if !mem.arena_release(&arena.arena).ok { #panic("arena release") }
  opened := platform.file_open("dyn-platform-probe", false, false)
  descriptor := platform.io_value(&opened)
  if descriptor >= 0 { _ = platform.file_close(descriptor) }
  socket := platform.socket_open(2, 1, 6)
  socket_value := platform.io_value(&socket)
  if socket_value >= 0 { _ = platform.socket_close(#cast(usize) socket_value) }
  events: [1]platform.PollDescriptor = []
  _ = platform.event_poll(events[..0], 0)
}
