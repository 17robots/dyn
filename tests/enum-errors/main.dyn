enum(f32) BadTag { A }
enum Duplicate { A, A }
enum Explicit { A = 3 }
enum Payload { Some: i32, None }

fn make_payload() Payload { return Payload.Some(1) }

fn main() {
  wrong := Payload.Some(true)
  missing := Payload.Some
  called := Payload.None()
  case make_payload() {
    Payload.Some *value => { value = 2 },
    _ => {},
  }
}
