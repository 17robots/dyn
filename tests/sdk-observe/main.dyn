use "std/observe"
use slots "std/container/slot_map"
struct Record { generation: u32, name: []const u8 }
const nil_record: Record = Record{}
fn expect(ok: bool) { if !ok { #panic("observe contract") } }
fn main() {
  events:[2]observe.Event
  log:=observe.log(events[..])
  observe.record(&log,observe.Event{kind:observe.Kind.Allocated,resource:42,value:16})
  observe.record(&log,observe.Event{kind:observe.Kind.Released,resource:42})
  observed:=observe.recorded(&log)
  expect(observed.len==2 && observed[0].kind==observe.Kind.Allocated)
  expect(observed[0].resource==42 && observed[0].value==16)
  expect(observed[1].kind==observe.Kind.Released)
  observe.record(&log,observe.Event{kind:observe.Kind.Checkpoint})
  expect(log.count==2 && log.dropped==1)
  observe.clear(&log)
  expect(log.count==0 && log.dropped==0)
  records:[1]Record
  live:=&records[0]
  slots.reset(live)
  live.name="live"
  handle:=slots.handle_of(records[..],live)
  expect(slots.resolve(records[..],handle,&nil_record).name[0]=='l')
  slots.retire(live)
  expect(slots.resolve(records[..],handle,&nil_record)==&nil_record)
}
