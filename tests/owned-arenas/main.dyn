use "std/mem"
fn expect(condition: bool, message: []const u8) { if !condition { #panic(message) } }

fn main() {
  expect(!mem.arena_create(0).ok, "zero owned capacity")
  created := mem.arena_create(128)
  expect(created.ok, "owned allocation")
  arena := &created.arena
  allocation := mem.arena_try_push(arena, 128, 1)
  expect(allocation.ok, "owned capacity")
  allocated_bytes := allocation.memory[..128]
  expect(allocated_bytes[0] == 0 && allocated_bytes[127] == 0, "owned zeroed storage")
  allocation.memory.* = 42
  expect(!mem.arena_try_push(arena, 1, 1).ok, "fixed owned arena must not grow")
  expect(mem.arena_used(arena) == 128, "failed fixed push preserves offset")
  mem.arena_reset(arena)
  repeated := mem.arena_try_push(arena, 128, 1)
  expect(repeated.memory == allocation.memory && repeated.memory.* == 0, "owned reset reuse and zero")
  expect(mem.arena_release(arena).ok && mem.arena_release(arena).ok, "owned release is repeatable")
  expect(mem.arena_capacity(arena) == 0, "release clears borrowed buffer")

  chain := mem.growing_create(32)
  a := mem.growing_push(&chain, 24, 8)
  b := mem.growing_push(&chain, 24, 8)
  a.* = 20 b.* = 22
  expect(a != b && a.* + b.* == 42, "growing pointer stability")
  huge := mem.growing_try_push(&chain, #cast(usize) -1, 8)
  expect(!huge.ok && a.* == 20 && b.* == 22, "overflow leaves allocations intact")
  expect(!mem.growing_try_push(&chain, 1, 3).ok, "invalid alignment")
  aligned := mem.growing_try_push(&chain, 1, 8192)
  expect(aligned.ok && (#cast(usize) aligned.memory & 8191) == 0, "large alignment")
  mem.growing_reset(&chain)
  reused_a := mem.growing_push(&chain, 24, 8)
  reused_b := mem.growing_push(&chain, 24, 8)
  expect(reused_a == a && reused_b == b && reused_a.* == 0 && reused_b.* == 0, "reuse all retained blocks")
  expect(mem.growing_release(&chain).ok && mem.growing_release(&chain).ok, "release all blocks")
  expect(chain.first == nil && chain.current == nil, "release clears chain")
  expect(mem.growing_try_push(&chain, 0, 1).ok, "empty allocation")
  expect(mem.growing_try_push(&chain, 1, 1).ok, "reuse released handle")
  expect(mem.growing_release(&chain).ok, "release reused handle")
}
