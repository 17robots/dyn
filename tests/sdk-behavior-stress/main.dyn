use "std/mem"
use "std/strings"
use "std/bytes"
use "std/io"
use "std/encoding/hex"

struct Stream { source: []const u8, output: []u8, offset: usize, chunk: usize, fail_at: usize, terminal: io.Status }
fn read_chunk(context: rawptr, destination: []u8) io.Result {
  state := #cast(*Stream) context
  n := #len(destination)
  if n > state.chunk { n = state.chunk }
  if n > #len(state.source) - state.offset { n = #len(state.source) - state.offset }
  if n > state.fail_at - state.offset { n = state.fail_at - state.offset }
  _ = mem.copy(destination[..n], state.source[state.offset..state.offset + n])
  state.offset += n
  if state.offset == state.fail_at { return io.Result{ transferred: n, status: state.terminal, error: -17 } }
  if state.offset == #len(state.source) { return io.Result{ transferred: n, status: io.Status.End } }
  return io.Result{ transferred: n }
}
fn write_chunk(context: rawptr, source: []const u8) io.Result {
  state := #cast(*Stream) context
  n := #len(source)
  if n > state.chunk { n = state.chunk }
  if n > state.fail_at - state.offset { n = state.fail_at - state.offset }
  _ = mem.copy(state.output[state.offset..state.offset + n], source[..n])
  state.offset += n
  if state.offset == state.fail_at { return io.Result{ transferred: n, status: state.terminal, error: -17 } }
  return io.Result{ transferred: n }
}
fn overreported(context: rawptr, output: []u8) io.Result { _ = context return io.Result{ transferred: #len(output) + 1 } }
fn stalled(context: rawptr, output: []u8) io.Result { _ = context _ = output return io.Result{} }

fn main() {
  source: [64]u8 = []
  i: usize = 0 for i < #len(source) { source[i] = #cast(u8) i i += 1 }
  output: [64]u8 = []
  // Every short-read/write size and every failure prefix, including zero progress.
  chunk: usize = 1
  for chunk <= 16 {
    stop: usize = 0
    for stop <= #len(source) {
      reader := Stream{ source: source[..], chunk: chunk, fail_at: stop, terminal: io.Status.Error }
      result := io.read_exact(io.Reader{ data: #cast(rawptr) &reader, read: &read_chunk }, output[..])
      if result.status != io.Status.Error || result.error != -17 || result.transferred != stop || !bytes.equal(output[..stop], source[..stop]) { #panic("partial read failure") }
      writer := Stream{ output: output[..], chunk: chunk, fail_at: stop, terminal: io.Status.Error }
      result = io.write_all(io.Writer{ data: #cast(rawptr) &writer, write: &write_chunk }, source[..])
      if result.status != io.Status.Error || result.error != -17 || result.transferred != stop || !bytes.equal(output[..stop], source[..stop]) { #panic("partial write failure") }
      stop += 1
    }
    final_reader := Stream{ source: source[..], chunk: chunk, fail_at: #len(source), terminal: io.Status.End }
    final_result := io.read_exact(io.Reader{ data: #cast(rawptr) &final_reader, read: &read_chunk }, output[..])
    if final_result.status != io.Status.Complete || final_result.transferred != #len(source) || !bytes.equal(output[..], source[..]) { #panic("exact read with EOF") }
    chunk += 1
  }
  if io.read_exact(io.Reader{ read: &overreported }, output[..]).status != io.Status.Error { #panic("untrusted count") }
  if io.read_exact(io.Reader{ read: &stalled }, output[..]).status != io.Status.Error { #panic("stalled reader") }
  ended := Stream{ source: source[..], chunk: 3, fail_at: 7, terminal: io.Status.End }
  ended_result := io.read_exact(io.Reader{ data: #cast(rawptr) &ended, read: &read_chunk }, output[..])
  if ended_result.status != io.Status.End || ended_result.transferred != 7 || !bytes.equal(output[..7], source[..7]) { #panic("short EOF prefix") }
  ended_writer := Stream{ output: output[..], chunk: 3, fail_at: 7, terminal: io.Status.End }
  write_end := io.write_all(io.Writer{ data: #cast(rawptr) &ended_writer, write: &write_chunk }, source[..])
  if write_end.status != io.Status.Error || write_end.transferred != 7 || write_end.error == 0 { #panic("writer EOF conversion") }

  // Failure leaves the arena cursor and already-retained data intact.
  storage: [128]u8 = []
  capacity: usize = 8
  for capacity <= #len(storage) {
    arena := mem.arena_from_buffer(storage[..capacity])
    saved := strings.clone(&arena, "keep")
    if !saved.ok { #panic("retained allocation") }
    mark := mem.arena_mark(&arena)
    failed := strings.clone(&arena, storage[..])
    if failed.ok || mem.arena_mark(&arena) != mark || !bytes.equal(saved.value, "keep") { #panic("arena failure rollback") }
    capacity += 1
  }
  // Malformation anywhere in the encoded input must leave every output byte alone.
  encoded: [128]u8 = []
  if !hex.encode(encoded[..], source[..], false).ok { #panic("encode") }
  i = 0 for i < #len(encoded) {
    original := encoded[i] encoded[i] = '!'
    j: usize = 0 for j < #len(output) { output[j] = 123 j += 1 }
    bad := hex.decode(output[..], encoded[..])
    if bad.ok || bad.error != hex.ErrorKind.InvalidInput { #panic("malformed hex") }
    for value in output[..] { if value != 123 { #panic("decode modified output on failure") } }
    encoded[i] = original i += 1
  }
}
