use "std/container/map"
use "std/io"
use "std/mem"
fn main() {
  arena := mem.arena_alloc(0)
  m: map.Map(u64, u64)
  map.init(&m, arena)
  t: u64 = 0
  for r in 0..20 {
    for i in 0..1000000 {
      map.insert(&m, #cast(u64, i) * 7, #cast(u64, i))
    }
    for i in 0..1000000 {
      t += map.get(&m, #cast(u64, i) * 7).*
    }
  }
  io.println("{}", t)
}
