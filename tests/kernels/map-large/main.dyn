use "std/container/map"
use "std/io"
use "std/mem"
fn main() {
  arena := mem.arena_create(0)
  m: map.Map(u64, u64)
  map.init(&m, arena, map.integer_hash, map.integer_equal)
  t: u64 = 0
  for r in 0..20 {
    for i in 0..1000000 {
      _ = map.insert(&m, #cast(u64, i) * 7, #cast(u64, i))
    }
    for i in 0..1000000 {
      t += map.get(&m, #cast(u64, i) * 7).*
    }
  }
  _ = io.println(io.stdout(), "{}", t)
}
