use "std/io"
use "std/mem"
struct V { x: f32, y: f32, z: f32 }
fn add(a: V, b: V) V {
  return V{ x: a.x + b.x, y: a.y + b.y, z: a.z + b.z }
}
fn scale(a: V, s: f32) V {
  return V{ x: a.x * s, y: a.y * s, z: a.z * s }
}
fn dot(a: V, b: V) f32 {
  return a.x * b.x + a.y * b.y + a.z * b.z
}
fn main() {
  arena := mem.arena_alloc(0)
  ps := mem.push_array(V, arena, 10000)
  vs := mem.push_array(V, arena, 10000)
  for i in 0..10000 {
    f := #cast(f32, i)
    ps[i] = V{ x: f, y: 1.0, z: 2.0 }
    vs[i] = V{ x: 1.0, y: f * 0.001, z: 0.5 }
  }
  e: f32 = 0.0
  for r in 0..100000 {
    for i in 0..10000 {
      ps[i] = add(ps[i], scale(vs[i], 0.0001))
      e += dot(ps[i], vs[i]) * 0.000001
    }
  }
  io.println("{}", #cast(i64, e))
}
