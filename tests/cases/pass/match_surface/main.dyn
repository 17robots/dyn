module main

Token := enum {
    number: i32,
    eof,
}

score := (tok: Token) i32 {
    return match tok {
        .number(n) if n > 9: n,
        .number: |n| n,
        .eof: 0,
        _: 0,
    }
}

bucket := (n: i32) i32 {
    return match n {
        0, 1: 1,
        2..=4: 2,
        _: 3,
    }
}

main := () i32 {
    if score(Token.number(12)) != 12 return 1
    if score(Token.number(5)) != 5 return 2
    if score(Token.eof) != 0 return 3
    if bucket(0) != 1 return 4
    if bucket(3) != 2 return 5
    if bucket(8) != 3 return 6
    return 0
}
