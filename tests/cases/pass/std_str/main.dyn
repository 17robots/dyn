module main

mem := use "std/mem"
str := use "std/str"

main := () i32 {
    mut arena := mem.Arena.init()
    a: []u8 = "alpha"
    b: []u8 = "alpha"
    c: []u8 = "beta"

    _ = str.eq(a, b)
    _ = str.is_empty("")
    _ = str.is_whitespace(' ')
    _ = str.starts_with(a, "al")
    _ = str.ends_with(a, "ha")
    _ = str.find_byte(a, 'p')
    _ = str.find(a, "ph")
    _ = str.contains(a, "lp")
    _ = str.rfind_byte(a, 'a')
    _ = str.rfind(a, "a")
    _ = str.trim("  hi \n")
    _ = str.trim_start("  hi")
    _ = str.trim_end("hi  ")
    _ = str.split_once("left:right", ':')
    _ = str.parse_uint("123")
    _ = str.parse_int("-45")
    _ = str.parse_hex_uint("ff")
    _ = str.parse_float("3.5")
    parts := str.split("a:b:c", ':', arena.allocator()) or return 1
    _ = parts.len
    repeated := str.repeat("xy", 3, arena.allocator()) or return 2
    _ = repeated.len

    _ = c
    arena.deinit()
    return 0
}
