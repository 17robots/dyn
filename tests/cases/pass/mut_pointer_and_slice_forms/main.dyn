module main

take_array := (buf: *[8]i32) usize => buf.*.len
take_slice := (buf: []i32) usize => buf.len
take_mut_slice := (buf: []mut i32) usize => buf.len
take_mut_array_ptr := (buf: *mut [8]i32) usize => buf.*.len
advance_slice := (buf: *mut []i32) usize {
    buf.* = buf.*[1..]
    return buf.*.len
}

main := () i32 {
    mut arr := [0, 0, 0, 0, 0, 0, 0, 0]
    view: []i32 = arr[..]
    mut view2: []i32 = arr[..]

    if take_array(&arr) != 8 {
        return 1
    }
    if take_slice(arr) != 8 {
        return 2
    }
    if take_mut_slice(arr[..]) != 8 {
        return 3
    }
    if take_mut_array_ptr(&mut arr) != 8 {
        return 4
    }
    if advance_slice(&mut view2) != 7 {
        return 5
    }
    if view.len != 8 {
        return 6
    }
    return 0
}
