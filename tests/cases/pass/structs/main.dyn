module main

Point := struct {
    x: i32,
    y: i32,
}

Point.origin := () Point => .{ x: 0, y: 0 }

Point.x_val := (self: Point) i32 => self.x

Config := struct {
    width: u32,
    height: u32,
}

Config.default := () Config => .{ width: 80, height: 24 }

main := () i32 {
    p := Point.origin()
    _ = p.x_val()
    q := .{ x: 3, y: 4 }
    _ = q.x
    cfg := Config.default()
    _ = cfg.width
    return 0
}
