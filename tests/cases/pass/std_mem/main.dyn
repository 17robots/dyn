module main

mem := use "std/mem"

Empty := struct {}
Pair := struct {
    a: i32,
    b: i32,
}

main := () i32 {
    mut arena := mem.Arena.init()
    alloc := arena.allocator()

    empty := alloc.create(Empty) or return 1
    alloc.destroy(Empty, empty)

    empties := alloc.create_many(Empty, 4) or return 2
    alloc.destroy_many(Empty, empties)

    mark0 := arena.save()
    pair0 := alloc.create(Pair) or return 3
    _ = pair0
    mark1 := arena.save()
    many := alloc.create_many(Pair, 2) or return 4
    _ = many.len

    bytes_a := "dyn"
    bytes_b := "dyn"
    bytes_c := "dun"
    if !mem.eql(u8, bytes_a, bytes_b) {
        return 5
    }
    if mem.eql(u8, bytes_a, bytes_c) {
        return 6
    }

    pair_a := Pair.{ a: 1, b: 2 }
    pair_b := Pair.{ a: 1, b: 2 }
    pair_c := Pair.{ a: 9, b: 4 }

    if !mem.eql_value(Pair, &pair_a, &pair_b) {
        return 7
    }
    if mem.eql_value(Pair, &pair_a, &pair_c) {
        return 8
    }

    arena.restore(mark1)
    arena.restore(mark0)
    arena.reset()
    arena.deinit()
    return 0
}
