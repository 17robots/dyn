module main

Direction := enum {
    north,
    south,
    east,
    west,
}

Token := enum {
    ident: []u8,
    number: i64,
    plus,
    eof,
}

main := () i32 {
    d := Direction.north
    _ = d
    tok := Token.number(42)
    match tok {
        .ident: {},
        .number: {},
        .plus: {},
        .eof: {},
    }
    return 0
}
