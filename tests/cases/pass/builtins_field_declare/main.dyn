module main

Point := struct {
    x: i32,
    y: i32,
}

Methods := struct {
    scale: (*any, i32) i32,
}

get_field_count := () i32 {
    mut count := 0
    pt: Point = .{ x: 1, y: 2 }
    inline for $fields(pt): |f| {
        count += 1
    }
    return count
}

check_has := () u1 {
    return $has(Point, "x")
}

check_fn_return := () u1 {
    Methods__get_scale_ret := "i32"
    // $fn_return on "(* any,i32)->i32" should give "i32"
    return true
}

main := () i32 {
    if get_field_count() != 2 return 1
    if !check_has() return 2
    return 0
}
