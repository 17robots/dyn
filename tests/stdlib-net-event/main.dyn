use "std/net"
use "std/os/linux" os
use "std/fs"
use "std/testing"

fn main() {
  queue := net.event_queue()
  testing.expect(queue.ok, "create event queue")
  value := net.event(net.EventReadable | net.EventEdgeTriggered, 0x1234)
  testing.expect(net.event_events(&value) == (net.EventReadable | net.EventEdgeTriggered), "event flags")
  testing.expect(net.event_data(&value) == 0x1234, "event data")
  empty: [0]net.Event = []
  failure := net.event_wait(queue.value, empty[..], 0)
  testing.expect(!failure.ok, "empty event storage rejected")

  channel := os.pipe()
  testing.expect(channel.ok, "create event pipe")
  testing.expect(net.nonblocking(channel.input, true).ok, "make event source nonblocking")
  testing.expect(net.event_add(queue.value, channel.input, net.EventReadable, 0x1234).ok, "register event source")

  events: [2]net.Event = []
  idle := net.event_wait(queue.value, events[..], 0)
  testing.expect(idle.ok && idle.value == 0, "zero-timeout wait")
  output := fs.File{ descriptor: channel.output }
  written := fs.write(&output, "x")
  testing.expect(written.ok && written.transferred == 1, "signal event source")
  ready := net.event_wait(queue.value, events[..], 1000)
  testing.expect(ready.ok && ready.value == 1, "wait for readable descriptor")
  testing.expect((net.event_events(&events[0]) & net.EventReadable) != 0, "readable event delivered")
  testing.expect(net.event_data(&events[0]) == 0x1234, "registered event data delivered")

  testing.expect(net.event_modify(queue.value, channel.input, net.EventReadable, 0x5678).ok, "modify event source")
  bytes: [1]u8 = []
  input := fs.File{ descriptor: channel.input }
  read := fs.read(&input, bytes[..])
  testing.expect(read.ok && read.transferred == 1 && bytes[0] == 'x', "consume event source")
  testing.expect(net.event_remove(queue.value, channel.input).ok, "remove event source")
  _ = os.close_descriptor(channel.input)
  _ = os.close_descriptor(channel.output)
  _ = net.close(queue.value)
}
