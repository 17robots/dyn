fn main() {
  zero: i32
  zero = 10
  two := 2
  sum := zero + two * 3
  difference := sum - two
  quotient := difference / two
  remainder := difference % two
  sum += two
  flag := sum > zero
  both := flag && true
  either := both || false
  equal := quotient == quotient
  unequal := quotient != remainder
  negative := -two
  inverted := !false
  complement := ~two
  masked := two | 4
  masked ^= 1
  small: u8 = 255
  small >>= 1
  wide: i64 = 9
  ratio: f64 = 1.5
  ratio = ratio / 2.0
  _ = both
  _ = either
  _ = equal
  _ = unequal
  _ = negative
  _ = inverted
  _ = complement
  _ = masked
  return
}
