enum(u8) State {
  Idle,
  Busy,
}

enum Result {
  Ok: i32,
  Error,
}

struct Envelope {
  state: State,
  code: i32,
}

enum Box {
  Value: Envelope,
  Empty,
}

fn unwrap(value: Result) Result {
  return value
}

fn main() {
  state := State.Busy
  if state != State.Busy { for {} }
  state_code: i32 = 0
  case state {
    State.Idle => { state_code = 1 },
    State.Busy => {
      case state_code {
        0 => { state_code = 2 },
        _ => { state_code = 3 },
      }
    },
  }
  if state_code != 2 { for {} }
  result := Result.Ok(42)
  case result {
    Result.Ok *mutable_payload => { mutable_payload += 8 },
    _ => {},
  }
  copy := unwrap(result)
  payload: i32 = 0
  case copy {
    _ => { payload = -1 },
    Result.Ok value => { payload = value },
  }
  if payload != 50 { for {} }
  failure := Result.Error
  _ = failure
  boxed := Box.Value(Envelope{ state: State.Idle, code: 11 })
  boxed_code: i32 = 0
  case boxed {
    Box.Value envelope => { boxed_code = envelope.code },
    _ => {},
  }
  if boxed_code != 11 { for {} }
  bucket: i32 = 0
  input: i32 = 7
  case input {
    0 => { bucket = 1 },
    1..10 => { bucket = 2 },
    _ => { bucket = 3 },
  }
  if bucket != 2 { for {} }
  byte: u8 = 9
  case byte {
    0..=255 => { bucket = 4 },
  }
  signed_byte: i8 = -9
  case signed_byte {
    -128..=127 => { bucket = 5 },
  }
  wide: u64 = 18446744073709551615
  case wide {
    0..=18446744073709551615 => { bucket = 6 },
  }
  if bucket != 6 { for {} }
}
