use "std/io" io

fn equal(left: []const u8, right: []const u8) bool {
  if #len(left) != #len(right) { return false }
  i: usize = 0
  for i < #len(left) {
    if left[i] != right[i] { return false }
    i += 1
  }
  return true
}

fn main() {
  storage: [64]u8 = []
  state := io.buffer_writer(storage[..])
  writer := io.buffer_writer_adapter(&state)

  result := io.println(writer, "count={} ready={} braces={{}}", 42, true)
  if result.status != io.Status.Complete { #panic("io print failed") }
  if !equal(io.buffer_writer_bytes(&state), "count=42 ready=true braces={}\n") {
    #panic("io print output")
  }

  before := state.length
  invalid := io.print(writer, "missing={}")
  if invalid.status != io.Status.Error || invalid.error != -22 || state.length != before {
    #panic("io print validation")
  }
}
