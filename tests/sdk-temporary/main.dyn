use "std/testing" testing
use "std/fs" fs
use "std/fmt" fmt
fn main() {
  name: [256]u8 = [] created := testing.temporary_directory(name[..],"dyn-cleanup")
  if !created.ok { #panic("temporary create") }
  frames: [8]fs.RemovalFrame = [] scratch: [4096]u8 = []
  path: [512]u8 = [] buffer := fmt.buffer(path[..])
  if !fmt.write_values(&buffer,created.directory.path,"/child") { #panic("path") }
  if !fs.make_directory(path[..buffer.length],448).ok { #panic("child") }
  buffer.length = 0
  if !fmt.write_values(&buffer,created.directory.path,"/child/link") { #panic("path") }
  if !fs.symbolic_link("/",path[..buffer.length]).ok { #panic("symlink") }
  if !testing.remove_temporary(&created.directory,frames[..],scratch[..]).ok || created.directory.active { #panic("cleanup") }
  if !testing.remove_temporary(&created.directory,frames[..],scratch[..]).ok { #panic("repeat") }
}
