use "std/flags" flags
use "std/log" logging
use "std/progress" progress
use "std/io" stream

fn equal(a: []const u8, b: []const u8) bool {
  if #len(a) != #len(b) { return false }
  i: usize = 0
  for i < #len(a) { if a[i] != b[i] { return false } i += 1 }
  return true
}

fn main() {
  options: [3]flags.Option = [
    flags.bool_option("verbose", 'v'),
    flags.bool_option("force", 'f'),
    flags.string_option("output", 'o'),
  ]
  arguments: [5][]const u8 = ["-vf", "--output=result", "input", "--", "-v"]
  values: [3]flags.Value = []
  positionals: [3][]const u8 = []
  parsed := flags.parse(options[..], arguments[..], values[..], positionals[..])
  if !parsed.ok || !parsed.values[0].present || !parsed.values[1].present { #panic("flags bool") }
  if !equal(parsed.values[2].text, "result") { #panic("flags string") }
  if #len(parsed.positionals) != 2 || !equal(parsed.positionals[0], "input") || !equal(parsed.positionals[1], "-v") { #panic("flags positional") }
  usage_storage: [128]u8 = []
  if !flags.usage(usage_storage[..], "tool", options[..]).ok { #panic("usage") }

  choices: [2][]const u8 = ["fast", "slow"]
  typed: [4]flags.Option = [flags.bool_option("verbose", 'v'), flags.integer_option("count", 'n'), flags.float_option("ratio", 'r'), flags.choice_option("mode", 'm', choices[..])]
  typed_storage: [4]flags.Value = []
  short_args: [5][]const u8 = ["-vn-42", "-r", "1.5", "-m", "fast"]
  typed_result := flags.parse(typed[..], short_args[..], typed_storage[..], positionals[..])
  if !typed_result.ok || !typed_result.values[0].present || !equal(typed_result.values[1].text, "-42") || !equal(typed_result.values[2].text, "1.5") || !equal(typed_result.values[3].text, "fast") { #panic("typed short flags") }
  missing: [1][]const u8 = ["-n"]
  if flags.parse(typed[..], missing[..], typed_storage[..], positionals[..]).error.kind != flags.ErrorKind.MissingValue { #panic("typed short missing value") }
  invalid: [1][]const u8 = ["-nnope"]
  if flags.parse(typed[..], invalid[..], typed_storage[..], positionals[..]).error.kind != flags.ErrorKind.InvalidValue { #panic("typed short invalid value") }

  output_storage: [128]u8 = []
  output := stream.buffer_writer(output_storage[..])
  logger := logging.logger(stream.buffer_writer_adapter(&output), logging.Level.Info)
  fields: [1]logging.Field = [logging.Field{ name: "file", value: "main.dyn" }]
  ignored := logging.write(&logger, logging.Level.Debug, "hidden", fields[..])
  if ignored.transferred != 0 { #panic("log filter") }
  written := logging.write(&logger, logging.Level.Info, "built", fields[..])
  if written.status != stream.Status.Complete || !equal(stream.buffer_writer_bytes(&output), "info: built file=main.dyn\n") { #panic("log") }

  nodes: [2]progress.Node = []
  state := progress.progress(nodes[..])
  parent := progress.begin(&state, "all", 10)
  child := progress.begin(&state, "part", 2)
  overflow := progress.begin(&state, "extra", 1)
  if overflow != 2 || state.dropped != 1 { #panic("progress capacity") }
  if !progress.advance(&state, parent, 20) || state.nodes[parent].completed != 10 { #panic("progress clamp") }
  if !progress.end(&state, child) || progress.advance(&state, child, 1) { #panic("progress end") }
}
