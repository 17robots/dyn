use "std/mem"
use "std/strings" str
use "std/unicode/utf8" unicode
use "std/fmt"
use "std/time"

fn main() {
  if !str.equal("dyn", "dyn") || str.equal("dyn", "den") { #panic("equal failed") }
  if !str.starts_with("compiler", "com") { #panic("starts_with failed") }
  if !str.ends_with("main.dyn", ".dyn") { #panic("ends_with failed") }
  if str.find("abcde", "cd") != 2 || str.find("abc", "z") != -1 { #panic("find failed") }
  trimmed := str.trim("  value  ")
  if #len(trimmed) != 5 { #panic("trim length failed") }
  if trimmed[0] != 'v' || trimmed[4] != 'e' { #panic("trim content failed") }
  if !str.equal(str.trim_left("  left"), "left") || !str.equal(str.trim_right("right  "), "right") {
    #panic("directional trim failed")
  }
  if str.find_byte("abc", 'b') != 1 || str.find_byte("abc", 'z') != -1 { #panic("find byte failed") }
  if str.find_last("ababa", "ba") != 3 || str.find_last_byte("abca", 'a') != 3 { #panic("reverse find failed") }
  parsed_base: u64 = 0
  if !str.parse_u64_base("deadBEEF", 16, &parsed_base) || parsed_base != 3735928559 { #panic("base parse failed") }
  replaced_storage: [16]u8 = []
  if !str.equal(str.replace(replaced_storage[..], "one one", "one", "two").value, "two two") { #panic("replace failed") }
  cursor := str.scanner("a\r\nb")
  item: []const u8 = ""
  if !str.scan_line(&cursor, &item) || !str.equal(item, "a") ||
     !str.scan_line(&cursor, &item) || !str.equal(item, "b") { #panic("line iterator failed") }
  cursor = str.scanner("  one\ttwo")
  if !str.scan_field(&cursor, &item) || !str.equal(item, "one") ||
     !str.scan_field(&cursor, &item) || !str.equal(item, "two") { #panic("field iterator failed") }

  value: u64 = 0
  if !str.parse_u64("18446744073709551615", &value) || value != 18446744073709551615 {
    #panic("parse_u64 failed")
  }
  if str.parse_u64("18446744073709551616", &value) || str.parse_u64("12x", &value) {
    #panic("parse_u64 accepted invalid input")
  }

  backing: [1024]u8 = []
  arena := mem.arena_from_buffer(backing[..])
  copy := str.clone(&arena, "slice").value
  if !str.equal(copy, "slice") { #panic("clone failed") }
  parts := str.split(&arena, "one/two/three", "/").values
  if #len(parts) != 3 || !str.equal(parts[1], "two") { #panic("split failed") }
  joined := str.join(&arena, parts, "-").value
  if !str.equal(joined, "one-two-three") { #panic("join failed") }

  buffer: [32]u8 = []
  unsigned := fmt.u64_decimal(buffer[..], 18446744073709551615)
  if #len(unsigned) != 20 || unsigned[0] != '1' || unsigned[19] != '5' { #panic("unsigned format failed") }
  signed := fmt.i64_decimal(buffer[..], -9223372036854775807 - 1)
  if #len(signed) != 20 || signed[0] != '-' || signed[19] != '8' { #panic("signed format failed") }
  duration: i64 = 400 * time.Nanosecond
  if duration != 400 || time.Millisecond != 1000000 { #panic("time units failed") }

  output: [64]u8 = []
  state := fmt.buffer(output[..])
  negative: i64 = -42
  positive: u64 = 99
  _ = fmt.write_i64(&state, negative)
  _ = fmt.write(&state, " ")
  _ = fmt.write_u64(&state, positive)
  _ = fmt.write(&state, " ")
  _ = fmt.write_bool(&state, true)
  written := fmt.bytes(&state)
  if #len(written) != 11 || written[0] != '-' || written[10] != 'e' { #panic("writer formatting failed") }

  hex := fmt.u64_base(buffer[..], 3735928559, 16, true)
  if !str.equal(hex, "DEADBEEF") { #panic("base formatting failed") }

  float_buffer: [48]u8 = []
  if !str.equal(fmt.f64_decimal(float_buffer[..], 12.34567, 3), "12.346") {
    #panic("fixed float formatting failed")
  }
  if !str.equal(fmt.f64_decimal(float_buffer[..], 0.00000025, 6), "2.5e-7") {
    #panic("scientific float formatting failed")
  }
  infinity_bits: u64 = 9218868437227405312
  not_number_bits: u64 = 9221120237041090560
  negative_zero_bits: u64 = 9223372036854775808
  infinity := #bitcast(f64) infinity_bits
  not_number := #bitcast(f64) not_number_bits
  negative_zero := #bitcast(f64) negative_zero_bits
  if !str.equal(fmt.f64_decimal(float_buffer[..], infinity, 6), "inf") ||
     !str.equal(fmt.f64_decimal(float_buffer[..], not_number, 6), "nan") ||
     !str.equal(fmt.f64_decimal(float_buffer[..], negative_zero, 6), "-0") {
    #panic("special float formatting failed")
  }

  utf8_bytes: [10]u8 = []
  utf8_bytes[0] = 65
  utf8_bytes[1] = 194
  utf8_bytes[2] = 162
  utf8_bytes[3] = 226
  utf8_bytes[4] = 130
  utf8_bytes[5] = 172
  utf8_bytes[6] = 240
  utf8_bytes[7] = 144
  utf8_bytes[8] = 141
  utf8_bytes[9] = 136
  utf8 := utf8_bytes[..]
  codepoints: usize = 0
  if !unicode.valid(utf8) || !unicode.codepoint_count(utf8, &codepoints) || codepoints != 4 {
    #panic("utf8 count failed")
  }
  decoded := unicode.decode(utf8, 3)
  if !decoded.ok || decoded.codepoint != 8364 || decoded.width != 3 { #panic("utf8 decode failed") }
  utf8_storage: [4]u8 = []
  if unicode.encode(utf8_storage[..], 66376) != 4 || !unicode.valid(utf8_storage[..]) {
    #panic("utf8 encode failed")
  }
  invalid_overlong: [2]u8 = [192, 128]
  invalid_surrogate: [3]u8 = [237, 160, 128]
  invalid_large: [4]u8 = [244, 144, 128, 128]
  if unicode.valid(invalid_overlong[..]) || unicode.valid(invalid_surrogate[..]) ||
     unicode.valid(invalid_large[..]) || unicode.encode(utf8_storage[..], 55296) != 0 {
    #panic("invalid utf8 accepted")
  }
  hostile_float: f64 = 0.0
  if !str.parse_f64("1e10000", &hostile_float) { #panic("large exponent parse failed") }

  quoted_storage: [32]u8 = []
  quoted_buffer := fmt.buffer(quoted_storage[..])
  if !fmt.write_quoted(&quoted_buffer, "a\n\"b") ||
     !str.equal(fmt.bytes(&quoted_buffer), "\"a\\n\\\"b\"") {
    #panic("quoted format failed")
  }
}
