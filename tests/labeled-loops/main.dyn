cleanup: u32 = 0

fn main() {
  i: u32 = 0
  total: u32 = 0
  outer: for i < 4 {
    i += 1
    j: u32 = 0
    for j < 4 {
      j += 1
      if j == 2 { continue: outer }
      total += 1
    }
  }
  if total != 4 { for {} }

  exits: u32 = 0
  done: for {
    for {
      exits += 1
      break: done
    }
  }
  if exits != 1 { for {} }

  once: u32 = 0
  cleanup_loop: for once < 1 {
    once += 1
    defer { cleanup += 1 }
    for {
      defer { cleanup += 2 }
      continue: cleanup_loop
    }
  }
  if cleanup != 3 { for {} }
}
