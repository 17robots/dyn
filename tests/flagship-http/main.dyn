// Flagship HTTP service: a small notes server on four evented worker threads.
// Handlers get application state from the typed router, not module globals.
// GET /health, GET /notes, POST /notes and POST /quit. Prints "port N" once
// listening on 127.0.0.1, then serves until a client posts /quit.
use "std/bytes"
use "std/fmt"
use "std/io"
use "std/mem"
use "std/net"
use "std/net/http"
use "std/net/http/evented"
use "std/sync"
use "std/time"

const WorkerCount: usize = 4
const NoteCapacity: usize = 64 * mem.KiB

// Application state, shared by every worker through Request.context.
struct App {
  router: http.Routes<App>,
  routes: [4]http.TypedRoute<App>,
  notes: [NoteCapacity]u8,
  notes_used: usize,
  notes_count: usize,
  notes_lock: sync.Mutex,
  quit: sync.AtomicU32,
}

fn text(response: *http.Response, code: u16, body: []const u8) !io.IoErr {
  try http.respond(response, body, http.ResponseOptions{ status: code, content_type: "text/plain; charset=utf-8" })
}

fn handle_health(response: *http.Response, request: *const http.Request, state: *App) !io.IoErr {
  try text(response, http.StatusOk, "ok\n")
}

fn handle_list(response: *http.Response, request: *const http.Request, state: *App) !io.IoErr {
  // Copy under the lock, respond outside it: a slow client must not block writers.
  copy: [NoteCapacity]u8
  sync.lock(&state.notes_lock)
  used := state.notes_used
  _ = mem.copy(copy[..used], state.notes[..used])
  sync.unlock(&state.notes_lock)
  try text(response, http.StatusOk, copy[..used])
}

fn handle_add(response: *http.Response, request: *const http.Request, state: *App) !io.IoErr {
  body := request.body
  if body.len == 0 || bytes.find_byte(body, '\n') < body.len {
    try text(response, http.StatusBadRequest, "note must be one nonempty line\n")
    return
  }
  sync.lock(&state.notes_lock)
  stored := state.notes_used + body.len + 1 <= NoteCapacity
  count: usize
  if stored {
    used := state.notes_used
    _ = mem.copy(state.notes[used..used + body.len], body)
    state.notes[used + body.len] = '\n'
    state.notes_used += body.len + 1
    state.notes_count += 1
    count = state.notes_count
  }
  sync.unlock(&state.notes_lock)
  if !stored {
    try text(response, http.StatusPayloadTooLarge, "notes full\n")
    return
  }
  digits: [21 + mem.ArenaBufferOverhead]u8
  scratch := mem.arena_from_buffer(digits[..])
  number := fmt.u64_decimal(scratch, #cast(u64, count))
  payload := #slice(#cast(*u8, &number[0]), number.len + 1)
  payload[number.len] = '\n'
  try text(response, http.StatusOk, payload)
}

fn handle_quit(response: *http.Response, request: *const http.Request, state: *App) !io.IoErr {
  sync.store_u32(&state.quit, 1)
  try http.respond(response, "bye\n", http.ResponseOptions{ content_type: "text/plain; charset=utf-8", close_connection: true })
}

fn main() {
  config := evented.default_config()
  arena := mem.arena_alloc(evented.storage_size(config, WorkerCount) + mem.MiB)
  defer mem.arena_release(arena)
  state := mem.push<App>(arena)
  // Setup and shutdown failures end the program.
  state.router = http.typed_routes(state.routes[..], state)
  http.add(&state.router, "GET", "/health", handle_health) catch { #panic("add route") }
  http.add(&state.router, "GET", "/notes", handle_list) catch { #panic("add route") }
  http.add(&state.router, "POST", "/notes", handle_add) catch { #panic("add route") }
  http.add(&state.router, "POST", "/quit", handle_quit) catch { #panic("add route") }
  binding := http.bind_routes(&state.router)

  workers := mem.push_array<evented.Worker>(arena, WorkerCount)
  evented.start_shared(arena, workers, net.ipv4(127, 0, 0, 1, 0), 64, config, binding.handler, binding.context) catch { #panic("start server") }
  io.println("port {}", evented.local_port(workers))

  for sync.load_u32(&state.quit) == 0 {
    time.sleep(10 * time.Millisecond)
  }
  evented.stop(workers)
  evented.join(workers) catch { #panic("join server") }
}
