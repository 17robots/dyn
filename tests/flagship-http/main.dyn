// Flagship HTTP service: a small notes server on four evented worker threads.
// Handlers get application state from the typed router, not module globals.
// GET /health, GET /notes, POST /notes and POST /quit. Prints "port N" once
// listening on 127.0.0.1, then serves until a client posts /quit.
use "std/bytes"
use "std/fmt"
use "std/io"
use "std/mem"
use "std/net"
use "std/net/http"
use "std/net/http/evented"
use "std/sync"
use "std/time"

const WorkerCount: usize = 4
const NoteCapacity: usize = 64 * mem.KiB

// Application state, shared by every worker through Request.context.
struct App {
  router: http.Routes(App),
  routes: [4]http.TypedRoute(App),
  notes: [NoteCapacity]u8,
  notes_used: usize,
  notes_count: usize,
  notes_lock: sync.Mutex,
  quit: sync.AtomicU32,
}

fn text(response: *http.Response, status: u16, body: []const u8) http.Result {
  return http.respond(response, body, http.ResponseOptions{ status: status, content_type: "text/plain; charset=utf-8" })
}

fn handle_health(response: *http.Response, request: *const http.Request, state: *App) http.Result {
  return text(response, http.StatusOk, "ok\n")
}

fn handle_list(response: *http.Response, request: *const http.Request, state: *App) http.Result {
  // Copy under the lock, respond outside it: a slow client must not block writers.
  copy: [NoteCapacity]u8
  sync.lock(&state.notes_lock)
  used := state.notes_used
  _ = mem.copy(copy[..used], state.notes[..used])
  sync.unlock(&state.notes_lock)
  return text(response, http.StatusOk, copy[..used])
}

fn handle_add(response: *http.Response, request: *const http.Request, state: *App) http.Result {
  body := request.body
  if #len(body) == 0 || bytes.find_byte(body, '\n') < #len(body) {
    return text(response, http.StatusBadRequest, "note must be one nonempty line\n")
  }
  sync.lock(&state.notes_lock)
  stored := state.notes_used + #len(body) + 1 <= NoteCapacity
  count: usize
  if stored {
    used := state.notes_used
    _ = mem.copy(state.notes[used..used + #len(body)], body)
    state.notes[used + #len(body)] = '\n'
    state.notes_used += #len(body) + 1
    state.notes_count += 1
    count = state.notes_count
  }
  sync.unlock(&state.notes_lock)
  if !stored {
    return text(response, http.StatusPayloadTooLarge, "notes full\n")
  }
  digits: [21 + mem.ArenaBufferOverhead]u8
  scratch := mem.arena_from_buffer(digits[..])
  number := fmt.u64_decimal(scratch, #cast(u64, count))
  payload := #slice(#cast(*u8, &number[0]), #len(number) + 1)
  payload[#len(number)] = '\n'
  return text(response, http.StatusOk, payload)
}

fn handle_quit(response: *http.Response, request: *const http.Request, state: *App) http.Result {
  sync.store_u32(&state.quit, 1)
  return http.respond(response, "bye\n", http.ResponseOptions{ content_type: "text/plain; charset=utf-8", close_connection: true })
}

fn main() {
  config := evented.default_config()
  arena := mem.arena_alloc(evented.storage_size(config, WorkerCount) + mem.MiB)
  defer mem.arena_release(arena)
  state := mem.push(App, arena)
  state.router = http.typed_routes(state.routes[..], state)
  _ = http.add(&state.router, "GET", "/health", handle_health)
  _ = http.add(&state.router, "GET", "/notes", handle_list)
  _ = http.add(&state.router, "POST", "/notes", handle_add)
  _ = http.add(&state.router, "POST", "/quit", handle_quit)
  binding := http.bind_routes(&state.router)

  workers := mem.push_array(evented.Worker, arena, WorkerCount)
  started := evented.start_shared(arena, workers, net.ipv4(127, 0, 0, 1, 0), 64, config, binding.handler, binding.context)
  if io.failed(started.failure) {
    #panic("cannot start workers")
  }

  digits: [20 + mem.ArenaBufferOverhead]u8
  scratch := mem.arena_from_buffer(digits[..])
  _ = io.write_all(io.stdout(), "port ")
  _ = io.write_all(io.stdout(), fmt.u64_decimal(scratch, #cast(u64, evented.local_port(workers))))
  _ = io.write_all(io.stdout(), "\n")

  for sync.load_u32(&state.quit) == 0 {
    _ = time.sleep(10 * time.Millisecond)
  }
  evented.stop(workers)
  if io.failed(evented.join(workers).failure) {
    #panic("worker failed")
  }
}
