use "std/encoding/json" json
use "std/mem" memory
use "std/strings" text
use "std/net/url" url
use "std/encoding/base32" base32
use "std/encoding/csv" csv
use "std/encoding/ini" ini
use "std/encoding/xml" xml
use "std/io" stream

fn main() {
  source: []const u8 = "{\"name\":\"Dyn\",\"values\":[1,true,null],\"unicode\":\"\\u263a\"}"
  if !json.valid(source) || json.valid("[1,]") { #panic("json validation") }
  backing: [4096]u8 = []
  arena := memory.arena_from_buffer(backing[..])
  parsed := json.parse(&arena, source)
  if !parsed.ok || !json.is_object(parsed.root) { #panic("json parse") }
  name := json.object_get(parsed.root, "name")
  if !json.is_string(name) || !text.equal(name.text, "Dyn") { #panic("json member") }
  values := json.object_get(parsed.root, "values")
  if json.array_length(values) != 3 || !json.is_bool(json.array_get(values, 1)) { #panic("json array") }
  encoded_storage: [256]u8 = []
  encoded := json.encode(encoded_storage[..], parsed.root)
  if #len(encoded) == 0 || !json.valid(encoded) { #panic("json encode") }
  streamed_storage: [256]u8 = []
  streamed_writer := stream.buffer_writer(streamed_storage[..])
  streamed := json.write(stream.buffer_writer_adapter(&streamed_writer), parsed.root)
  if streamed.status != stream.Status.Complete ||
    !json.valid(stream.buffer_writer_bytes(&streamed_writer)) {
    #panic("json stream")
  }

  parsed_url := url.parse("https://example.com/a/b?q=yes#part")
  if !parsed_url.ok || !text.equal(parsed_url.value.scheme, "https") ||
    !text.equal(parsed_url.value.authority, "example.com") ||
    !text.equal(parsed_url.value.path, "/a/b") || !text.equal(parsed_url.value.query, "q=yes") ||
    !text.equal(parsed_url.value.fragment, "part") { #panic("url parse") }

  codec_storage: [64]u8 = []
  base32_encoded := base32.encode(codec_storage[..], "foobar")
  if !base32_encoded.ok || !text.equal(base32_encoded.data, "MZXW6YTBOI======") { #panic("base32 encode") }
  base32_decoded := base32.decode(codec_storage[32..], base32_encoded.data)
  if !base32_decoded.ok || !text.equal(base32_decoded.data, "foobar") { #panic("base32 decode") }
  if base32.decode(codec_storage[..], "MZ======").ok { #panic("base32 unused bits") }

  csv_state := csv.scanner("name,note\r\nDyn,\"fast, \"\"small\"\"\"\r\n")
  field_storage: [64]u8 = []
  csv_name := csv.next(&csv_state, field_storage[..])
  if !csv_name.ok || !text.equal(csv_name.text, "name") || csv_name.end_record { #panic("csv name") }
  csv_note := csv.next(&csv_state, field_storage[..])
  if !csv_note.ok || !text.equal(csv_note.text, "note") || !csv_note.end_record { #panic("csv record") }
  csv_dyn := csv.next(&csv_state, field_storage[..])
  if !csv_dyn.ok || !text.equal(csv_dyn.text, "Dyn") { #panic("csv dyn") }
  csv_quoted := csv.next(&csv_state, field_storage[..])
  if !csv_quoted.ok || !text.equal(csv_quoted.text, "fast, \"small\"") || !csv_quoted.end_input { #panic("csv quote") }
  csv_output: [64]u8 = []
  csv_buffer := stream.buffer_writer(csv_output[..])
  csv_writer := csv.writer(stream.buffer_writer_adapter(&csv_buffer))
  if !csv.write_field(&csv_writer, "Dyn", false) || !csv.write_field(&csv_writer, "fast, \"small\"", true) ||
    !text.equal(stream.buffer_writer_bytes(&csv_buffer), "Dyn,\"fast, \"\"small\"\"\"\r\n") { #panic("csv writer") }
  csv_cursor := stream.cursor("one,\"two,2\"\r\n")
  csv_stream := csv.stream_scanner(stream.cursor_reader(&csv_cursor))
  streamed_one := csv.next_stream(&csv_stream, field_storage[..])
  if !streamed_one.ok || !text.equal(streamed_one.text, "one") { #panic("csv stream one") }
  streamed_two := csv.next_stream(&csv_stream, field_storage[..])
  if !streamed_two.ok || !streamed_two.end_record || !text.equal(streamed_two.text, "two,2") { #panic("csv stream two") }
  if !csv.next_stream(&csv_stream, field_storage[..]).end_input { #panic("csv stream end") }

  configuration: []const u8 = "; comment\n[server]\n host = example.test \nport=443\n"
  if !text.equal(ini.find(configuration, "server", "host"), "example.test") ||
    !text.equal(ini.find(configuration, "server", "port"), "443") { #panic("ini find") }
  ini_state := ini.scanner("[broken\n")
  if ini.next(&ini_state).error != ini.ErrorKind.Syntax { #panic("ini syntax") }

  xml_source: []const u8 = "<?xml version=\"1.0\"?><root id=\"7\"><child/>text<!-- note --></root>"
  xml_stack: [8][]const u8 = []
  if !xml.valid(xml_source, xml_stack[..]) || xml.valid("<a><b></a>", xml_stack[..]) { #panic("xml validation") }
  xml_state := xml.scanner(xml_source)
  declaration := xml.next(&xml_state) root := xml.next(&xml_state)
  if !declaration.ok || declaration.event.kind != xml.Kind.Processing || !root.ok || !text.equal(root.event.name, "root") { #panic("xml events") }
  attribute_state := xml.attributes(root.event)
  attribute := xml.next_attribute(&attribute_state)
  if !attribute.ok || !text.equal(attribute.name, "id") || !text.equal(attribute.value, "7") { #panic("xml attribute") }
  xml_output: [96]u8 = []
  xml_buffer := stream.buffer_writer(xml_output[..])
  xml_writer := xml.writer(stream.buffer_writer_adapter(&xml_buffer))
  if !xml.write_start(&xml_writer, "root") || !xml.write_attribute(&xml_writer, "id", "a&b") ||
    !xml.write_start_end(&xml_writer, false) || !xml.write_text(&xml_writer, "<Dyn>") ||
    !xml.write_end(&xml_writer, "root") ||
    !text.equal(stream.buffer_writer_bytes(&xml_buffer), "<root id=\"a&amp;b\">&lt;Dyn&gt;</root>") { #panic("xml writer") }
  xml_cursor := stream.cursor("<root>hi</root>")
  xml_stream_storage: [32]u8 = []
  xml_stream := xml.stream_scanner(stream.cursor_reader(&xml_cursor), xml_stream_storage[..])
  xml_stream_root := xml.next_stream(&xml_stream)
  if !xml_stream_root.ok || xml_stream_root.event.kind != xml.Kind.Start { #panic("xml stream root") }
  xml_stream_text := xml.next_stream(&xml_stream)
  if !xml_stream_text.ok || !text.equal(xml_stream_text.event.text, "hi") { #panic("xml stream text") }
  xml_stream_end := xml.next_stream(&xml_stream)
  if !xml_stream_end.ok || xml_stream_end.event.kind != xml.Kind.End { #panic("xml stream end") }
}
