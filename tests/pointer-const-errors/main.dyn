struct Child {
  value: i32,
}

struct Outer {
  value: i32,
  child: *Child,
}

fn main() {
  child := Child{ value: 1 }
  outer := Outer{ child: &child }
  pointer: *const Outer = &outer
  pointer.value = 2
  pointer.child = nil
  mutable: *Outer = pointer
  field_pointer := &pointer.value
  field_pointer.* = 3
  pointer.child.value = 4
  _ = mutable
}
