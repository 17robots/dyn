use "std/rand" random
use "std/net/url"
use "std/archive/tar"
use "std/strings" str

fn tar_checksum(header: []u8) {
  checksum: u64 = 0 i: usize = 0
  for i < 512 { if i >= 148 && i < 156 { checksum += 32 } else { checksum += #cast(u64) header[i] } i += 1 }
  i = 154 for i > 148 { i -= 1 header[i] = #cast(u8) (checksum % 8) + '0' checksum /= 8 }
  header[154] = 0 header[155] = ' '
}
fn main() {
  state := random.seeded(1)
  if random.next_u64(&state) != 48271 { #panic("random sequence") }
  bounded: u64 = 0
  if !random.below(&state, 10, &bounded) || bounded >= 10 { #panic("random bounds") }
  parsed := url.parse("https://example.test/a?q=1#f")
  if !parsed.ok || !str.equal(parsed.value.scheme, "https") ||
     !str.equal(parsed.value.authority, "example.test") || !str.equal(parsed.value.path, "/a") ||
     !str.equal(parsed.value.query, "q=1") || !str.equal(parsed.value.fragment, "f") { #panic("url") }

  archive: [1024]u8 = []
  archive[0] = 'x'
  archive[124] = '0'
  archive[125] = '0'
  archive[126] = '0'
  archive[127] = '0'
  archive[128] = '0'
  archive[129] = '0'
  archive[130] = '0'
  archive[131] = '0'
  archive[132] = '0'
  archive[133] = '0'
  archive[134] = '0'
  archive[156] = '0'
  tar_checksum(archive[..512])
  archive_cursor := tar.reader(archive[..])
  tar_result := tar.next(&archive_cursor)
  entry := tar_result.entry
  if tar_result.status != tar.Status.Entry || !str.equal(entry.name, "x") || entry.size != 0 || archive_cursor.offset != 512 {
    #panic("tar")
  }
}
