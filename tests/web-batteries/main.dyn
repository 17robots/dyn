use "std/fail"
// std pieces that keep web apps short: json.object_of/array_of, html.print,
// std/net/http/session, http.assets_of, process.environment_or and one-write
// log lines.
use "std/encoding/json"
use "std/html"
use "std/io"
use "std/log"
use "std/mem"
use "std/net/http"
use sessions "std/net/http/session"
use "std/process"

struct Post { id: i64, author: []const u8, body: []const u8, created: i64, ok: bool, score: f64, small: u8, count: usize }

struct Nested { inner: Post }

fn main() {
  arena := mem.arena_alloc(mem.MiB)
  defer mem.arena_release(arena)
  storage: [1024]u8
  posts: [2]Post = [
    Post{ id: 1, author: "ann", body: "hi \"there\"", created: 99, ok: true, score: 1.5, small: 7, count: 3 },
    Post{ id: -2, author: "bo", body: "x\n", score: -0.25 },
  ]
  out_status: fail.Status
  out := json.writer(&out_status, storage[..])
  json.array_of(&out, posts[..])
  io.println("{}", json.output(&out))
  single_status: fail.Status
  single := json.writer(&single_status, storage[..])
  json.object_of(&single, posts[1])
  io.println("{}", json.output(&single))
  nested_status: fail.Status
  nested := json.writer(&nested_status, storage[..])
  json.object_of(&nested, Nested{})
  io.println("nested fails {}", nested_status.failed)

  inner_storage: [128]u8
  inner_status: fail.Status
  inner := html.writer(&inner_status, inner_storage[..])
  html.print(&inner, "<i>{}</i>", "a&b")
  page_status: fail.Status
  page := html.writer(&page_status, storage[..])
  html.print(&page, "<p id=\"{}\" class=\"{}\">{} {} {}</p><style>p {{ color: red }}</style>{} [{}] {}", 42, "x\"y", "<b>", true,
    html.output(&inner), -7, html.trusted("<br>"))
  io.println("{}", html.output(&page).bytes)

  cache: sessions.Cache
  shared := sessions.Shared{}
  random: fail.Status
  started := sessions.start(arena, &random, 3600)
  io.println("start {} {} {} {}", !random.failed, started.token.len, started.csrf.len, started.cookie.name)
  cold: fail.Status
  _ = sessions.cached(&cold, &cache, &shared, started.token, 100)
  io.println("cold {}", !cold.failed)
  remembering: fail.Status
  kept := sessions.remember(&remembering, &cache, started.token, 7, started.csrf, "ann", 200)
  looking: fail.Status
  hit := sessions.cached(&looking, &cache, &shared, started.token, 100)
  io.println("remembered {} hit {} user {} data {} csrf {} {}", !remembering.failed && kept.user == 7, !looking.failed, hit.user,
    hit.data, sessions.csrf_ok(&hit, started.csrf), sessions.csrf_ok(&hit, "nope"))
  expired: fail.Status
  _ = sessions.cached(&expired, &cache, &shared, started.token, 200)
  io.println("expired {}", !expired.failed)
  cleared := sessions.forget(&shared)
  cookie_text: [128]u8
  formatting: fail.Status
  io.println("forget {}", http.set_cookie(&formatting, cookie_text[..], cleared))
  forgotten: fail.Status
  _ = sessions.cached(&forgotten, &cache, &shared, started.token, 100)
  io.println("after forget {}", !forgotten.failed)

  assets := http.assets_of(arena, "app.js", "let x = 1", "app.css", "p { }", "dangling")
  js := http.find_asset(&assets, "app.js")
  css := http.find_asset(&assets, "app.css")
  io.println("assets {} {} {}", assets.count, js.content_type, css.content_type)

  io.println("env {} {}", process.environment_or(arena, "WEB_BATTERIES_SET", "unset"), process.environment_or(arena, "WEB_BATTERIES_NONE", "fallback"))
  logger := log.logger(io.stdout(), log.Level.Info)
  fields: [2]log.Field = [log.Field{ name: "a", value: "1" }, log.Field{ name: "b", value: "two" }]
  status: fail.Status
  log.write(&status, &logger, log.Level.Info, "hello", fields[..])
  if status.failed {
    #panic("log write")
  }
}
