// std pieces that keep web apps short: json.object_of/array_of, html.print,
// std/net/http/session, http.assets_of, process.environment_or and one-write
// log lines.
use "std/encoding/json"
use "std/html"
use "std/io"
use "std/log"
use "std/mem"
use "std/net/http"
use sessions "std/net/http/session"
use "std/process"

struct Post { id: i64, author: []const u8, body: []const u8, created: i64, ok: bool, score: f64, small: u8, count: usize }

struct Nested { inner: Post }

// Whether the cache holds token at now.
// The JSON a writer finished, or "" when it failed.
fn finished(w: *const json.Writer) []const u8 {
  return json.finish(w) catch ""
}
// Whether finishing the writer fails.
fn finish_failed(w: *const json.Writer) bool {
  _ = json.finish(w) catch { return true }
  return false
}
fn cached(cache: *sessions.Cache, shared: *sessions.Shared, token: []const u8, now: i64) bool {
  _ = sessions.cached(cache, shared, token, now) catch { return false }
  return true
}

fn main() {
  arena := mem.arena_alloc(mem.MiB)
  defer mem.arena_release(arena)
  storage: [1024]u8
  posts: [2]Post = [
    Post{ id: 1, author: "ann", body: "hi \"there\"", created: 99, ok: true, score: 1.5, small: 7, count: 3 },
    Post{ id: -2, author: "bo", body: "x\n", score: -0.25 },
  ]
  out := json.writer(storage[..])
  json.array_of(&out, posts[..])
  io.println("{}", finished(&out))
  single := json.writer(storage[..])
  json.object_of(&single, posts[1])
  io.println("{}", finished(&single))
  nested := json.writer(storage[..])
  json.object_of(&nested, Nested{})
  io.println("nested fails {}", finish_failed(&nested))

  inner_storage: [128]u8
  inner := html.writer(inner_storage[..])
  html.print(&inner, "<i>{}</i>", "a&b")
  page := html.writer(storage[..])
  html.print(&page, "<p id=\"{}\" class=\"{}\">{} {} {}</p><style>p {{ color: red }}</style>{} [{}] {}", 42, "x\"y", "<b>", true,
    html.output(&inner), -7, html.trusted("<br>"))
  io.println("{}", html.output(&page).bytes)

  cache: sessions.Cache
  shared := sessions.Shared{}
  started := sessions.start(arena, 3600) catch { #panic("session start") }
  io.println("start {} {} {} {}", true, started.token.len, started.csrf.len, started.cookie.name)
  io.println("cold {}", cached(&cache, &shared, started.token, 100))
  kept := sessions.remember(&cache, started.token, 7, started.csrf, "ann", 200) catch { #panic("remember") }
  hit := sessions.cached(&cache, &shared, started.token, 100) catch { #panic("cached") }
  io.println("remembered {} hit {} user {} data {} csrf {} {}", kept.user == 7, true, hit.user,
    hit.data, sessions.csrf_ok(&hit, started.csrf), sessions.csrf_ok(&hit, "nope"))
  io.println("expired {}", cached(&cache, &shared, started.token, 200))
  cleared := sessions.forget(&shared)
  cookie_text: [128]u8
  io.println("forget {}", http.set_cookie(cookie_text[..], cleared) catch cookie_text[..0])
  io.println("after forget {}", cached(&cache, &shared, started.token, 100))

  assets := http.assets_of(arena, "app.js", "let x = 1", "app.css", "p { }", "dangling")
  js := http.find_asset(&assets, "app.js")
  css := http.find_asset(&assets, "app.css")
  io.println("assets {} {} {}", assets.count, js.content_type, css.content_type)

  io.println("env {} {}", process.environment_or(arena, "WEB_BATTERIES_SET", "unset"), process.environment_or(arena, "WEB_BATTERIES_NONE", "fallback"))
  logger := log.logger(io.stdout(), log.Level.Info)
  fields: [2]log.Field = [log.Field{ name: "a", value: "1" }, log.Field{ name: "b", value: "two" }]
  log.write(&logger, log.Level.Info, "hello", fields[..]) catch { #panic("log write") }
}
