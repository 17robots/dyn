fn choose(value: i32) i32 {
  if value == 1 {
    return 10
  } else if value == 2 {
    return 20
  } else {
    return 30
  }
}

fn explode(value: bool) bool {
  if value { #panic("short-circuit operand executed") }
  return value
}

fn identity(value: bool) bool { return value }

fn stop_at_missing(value: u32) bool {
  if value == 4294967295 { return false }
  return stop_at_missing(4294967295)
}

fn main() {
  if stop_at_missing(4294967295) { #panic("early return branch failed") }
  if choose(1) != 10 { #panic("if branch failed") }
  if choose(2) != 20 { #panic("else-if branch failed") }
  if choose(3) != 30 { #panic("else branch failed") }

  if false && explode(true) { #panic("false && rhs failed") }
  if true || explode(true) {
    _ = 0
  } else {
    #panic("true || rhs failed")
  }
  if !(true && identity(true)) { #panic("true && rhs failed") }
  if false || identity(false) { #panic("false || rhs failed") }

  i: i32 = 0
  for i < 3 && i != 2 { i += 1 }
  if i != 2 { #panic("logical loop condition failed") }

  j: i32 = 3
  total: i32 = 0
  for j > 0 {
    j -= 1
    if j == 2 { total += 100 }
    else if j == 1 { total += 10 }
    else { total += 1 }
  }
  if total != 111 { #panic("loop else-if failed") }

  reverse: usize = 6
  visited: usize = 0
  inner_total: usize = 0
  for reverse > 0 {
    reverse -= 1
    if reverse == 5 { visited += 1 }
    else if reverse == 3 {
      child: usize = 0
      for child < 2 {
        inner_total += 1
        child += 1
      }
      visited += 1
    } else if reverse == 1 { visited += 1 }
    visited += 1
  }
  if reverse != 0 || visited != 9 || inner_total != 2 { #panic("nested loop else-if continuation failed") }
}
