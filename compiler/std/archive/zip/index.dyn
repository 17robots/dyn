// Central-directory reader for complete ZIP32 archives. All slices borrow source.
// Stored and DEFLATE payloads, with signed or unsigned ZIP32 data descriptors.
// ZIP64, encryption, multi-disk and self-extracting offset correction are unsupported.
use "std/bytes" bytes

pub struct OpenResult { reader: ArchiveReader, error: ErrorKind, ok: bool }
struct Central { entry: Entry, next: usize, error: ErrorKind, ok: bool }
fn central_entry(source: []const u8, at: usize, limit: usize, data_limit: usize) Central {
  if at > limit || limit > #len(source) || limit - at < 46 || u32le(source, at) != 33639248 { return Central{ error: ErrorKind.Syntax } }
  flags := u16le(source, at + 8) method := u16le(source, at + 10)
  compressed := #cast(usize) u32le(source, at + 20) size := #cast(usize) u32le(source, at + 24)
  local := #cast(usize) u32le(source, at + 42)
  if (flags & 8257) != 0 || compressed == 4294967295 || size == 4294967295 || local == 4294967295 || u16le(source, at + 34) != 0 { return Central{ error: ErrorKind.Unsupported } }
  name_length := #cast(usize) u16le(source, at + 28)
  tail := name_length + #cast(usize) u16le(source, at + 30) + #cast(usize) u16le(source, at + 32)
  if tail > limit - at - 46 { return Central{ error: ErrorKind.Syntax } }
  name := source[at + 46..at + 46 + name_length]
  if local > data_limit || data_limit - local < 30 || u32le(source, local) != 67324752 { return Central{ error: ErrorKind.Syntax } }
  local_name := #cast(usize) u16le(source, local + 26)
  extra := #cast(usize) u16le(source, local + 28)
  if local_name + extra > data_limit - local - 30 { return Central{ error: ErrorKind.Syntax } }
  if flags != u16le(source, local + 6) || method != u16le(source, local + 8) || !bytes.equal(name, source[local + 30..local + 30 + local_name]) { return Central{ error: ErrorKind.Syntax } }
  payload := local + 30 + local_name + extra
  if compressed > data_limit - payload { return Central{ error: ErrorKind.Syntax } }
  checksum := u32le(source, at + 16)
  if (flags & 8) == 0 {
    if checksum != u32le(source, local + 14) || compressed != #cast(usize) u32le(source, local + 18) || size != #cast(usize) u32le(source, local + 22) { return Central{ error: ErrorKind.Syntax } }
  } else {
    descriptor := payload + compressed
    if data_limit - descriptor < 12 { return Central{ error: ErrorKind.Syntax } }
    // A CRC may itself equal the optional signature: try the unsigned form first.
    unsigned := u32le(source, descriptor) == checksum && #cast(usize) u32le(source, descriptor + 4) == compressed && #cast(usize) u32le(source, descriptor + 8) == size
    if !unsigned {
      if data_limit - descriptor < 16 || u32le(source, descriptor) != 134695760 || u32le(source, descriptor + 4) != checksum || #cast(usize) u32le(source, descriptor + 8) != compressed || #cast(usize) u32le(source, descriptor + 12) != size { return Central{ error: ErrorKind.Syntax } }
    }
  }
  return Central{ entry: Entry{ name: name, payload: source[payload..payload + compressed],
    method: method, flags: flags, checksum: checksum, compressed_size: compressed,
    uncompressed_size: size, directory: name_length > 0 && name[name_length - 1] == '/' }, next: at + 46 + tail, ok: true }
}

// Checks directory framing and every local-header/descriptor relationship up front.
// Payload CRCs are verified by extract, without allocating or decompressing here.
pub fn open_checked(source: []const u8) OpenResult {
  if #len(source) < 22 { return OpenResult{ error: ErrorKind.Syntax } }
  end := #len(source) - 22 floor: usize = 0
  if end > 65535 { floor = end - 65535 }
  found: bool = false
  for {
    if u32le(source, end) == 101010256 && #cast(usize) u16le(source, end + 20) == #len(source) - end - 22 { found = true break }
    if end == floor { break }
    end -= 1
  }
  if !found { return OpenResult{ error: ErrorKind.Syntax } }
  error := end_record(source[end..]) if error != ErrorKind.None { return OpenResult{ error: error } }
  start := #cast(usize) u32le(source, end + 16) size := #cast(usize) u32le(source, end + 12)
  if start == 4294967295 || size == 4294967295 { return OpenResult{ error: ErrorKind.Unsupported } }
  if start > end || size != end - start { return OpenResult{ error: ErrorKind.Syntax } }
  count := #cast(usize) u16le(source, end + 10) cursor := start i: usize = 0
  for i < count {
    entry := central_entry(source, cursor, end, start)
    if !entry.ok { return OpenResult{ error: entry.error } }
    cursor = entry.next i += 1
  }
  if cursor != end { return OpenResult{ error: ErrorKind.Syntax } }
  return OpenResult{ reader: ArchiveReader{ source: source, offset: start, indexed: true,
    directory_start: start, directory_end: end, remaining: count }, ok: true }
}
fn next_indexed(state: *ArchiveReader) EntryResult {
  if state.remaining == 0 { return EntryResult{ error: ErrorKind.End } }
  item := central_entry(state.source, state.offset, state.directory_end, state.directory_start)
  if !item.ok { return EntryResult{ error: item.error } }
  state.offset = item.next state.remaining -= 1
  return EntryResult{ entry: item.entry, ok: true }
}
