#target(kernel: linux)

use "std/net/http" http
use "std/net" network
use "std/thread" threading
use "std/sync" sync

pub struct Worker {
  thread: threading.Thread,
  listener: *http.Listener,
  handler: http.Handler,
  storage: []u8,
  error: http.Result,
  stopping: sync.AtomicU32,
  control: sync.Mutex,
  active_descriptor: isize,
  request_errors: usize,
}
pub struct Result { started: usize, error: isize, ok: bool }

fn worker_main(context: rawptr) isize {
  worker := #cast(*Worker) context
  for sync.load_u32(&worker.stopping) == 0 {
    accepted := http.accept(worker.listener)
    if !accepted.ok {
      if sync.load_u32(&worker.stopping) != 0 { return 0 }
      if accepted.error == -4 { continue }
      worker.error = http.Result{ error: http.ErrorKind.Io, system_error: accepted.error }
      return accepted.error
    }
    socket := accepted.connection
    sync.lock(&worker.control)
    if sync.load_u32(&worker.stopping) != 0 {
      _ = http.close(&socket) sync.unlock(&worker.control) return 0
    }
    worker.active_descriptor = socket.descriptor
    sync.unlock(&worker.control)
    handled := http.serve_connection(&socket, worker.storage, worker.handler)
    // Serialize shutdown and close so stop cannot act on a recycled descriptor.
    sync.lock(&worker.control)
    close_error := http.close(&socket)
    worker.active_descriptor = -1
    sync.unlock(&worker.control)
    if !handled.ok || close_error != 0 { worker.request_errors += 1 }
  }
  return 0
}

// Call stop, then join, then close the listener. Never close it while workers run.
// stop interrupts blocked accept/read/write, but cannot cancel arbitrary handler code.
pub fn stop(workers: []Worker) {
  for *worker in workers { sync.store_u32(&worker.stopping, 1) }
  for *active_worker in workers {
    if active_worker.listener != nil && active_worker.listener.descriptor >= 0 {
      _ = network.shutdown(active_worker.listener.descriptor, network.ShutdownBoth)
    }
    sync.lock(&active_worker.control)
    if active_worker.active_descriptor >= 0 { _ = network.shutdown(active_worker.active_descriptor, network.ShutdownBoth) }
    sync.unlock(&active_worker.control)
  }
}

// Backing storage/stacks must be disjoint and live through join. Workers must be
// zero-initialized or already joined. Partial startup is stopped and drained.
pub fn start(workers: []Worker, listener: *http.Listener, receive_storage: []u8,
  worker_storage_size: usize, stacks: []u8, stack_size: usize, handler: http.Handler) Result {
  if #len(workers) == 0 || listener == nil || handler == nil || worker_storage_size == 0 || stack_size < 256 ||
    worker_storage_size > #len(receive_storage) / #len(workers) || stack_size > #len(stacks) / #len(workers) {
    return Result{ error: -22 }
  }
  for *worker in workers { if threading.id(&worker.thread) != 0 { return Result{ error: -16 } } }
  i: usize = 0
  for i < #len(workers) {
    workers[i] = Worker{ listener: listener, handler: handler,
      storage: receive_storage[i * worker_storage_size..(i + 1) * worker_storage_size], active_descriptor: -1 }
    spawned := threading.spawn(&workers[i].thread, stacks[i * stack_size..(i + 1) * stack_size],
      &worker_main, #cast(rawptr) &workers[i])
    if spawned < 0 {
      stop(workers[..i]) _ = join(workers[..i])
      return Result{ started: i, error: spawned }
    }
    i += 1
  }
  return Result{ started: #len(workers), ok: true }
}

// Always attempts every join; a worker error never strands later live workers.
pub fn join(workers: []Worker) Result {
  error: isize = 0 joined_count: usize = 0
  for *worker in workers {
    joined := threading.join(&worker.thread)
    if joined == 0 { joined_count += 1 }
    if error == 0 && joined != 0 { error = joined }
    if error == 0 && worker.error.error != http.ErrorKind.None {
      error = worker.error.system_error if error == 0 { error = -5 }
    }
  }
  return Result{ started: joined_count, error: error, ok: error == 0 }
}
