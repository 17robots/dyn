use "std/io"

pub struct Writer {
  destination: io.Writer,
  storage: []u8,
  used: usize,
  error: isize,
}

pub fn writer(destination: io.Writer, storage: []u8) Writer {
  return Writer{ destination: destination, storage: storage }
}

pub fn writer_buffered(state: *const Writer) usize { return state.used }

pub fn writer_flush(state: *Writer) io.Result {
  if state.used > #len(state.storage) { state.error = -22 }
  if state.error != 0 {
    return io.Result{ transferred: 0, error: state.error, status: io.Status.Error }
  }
  if state.used == 0 {
    return io.Result{ transferred: 0, error: 0, status: io.Status.Complete }
  }
  result := io.write_all(state.destination, state.storage[..state.used])
  if result.status == io.Status.Error {
    state.error = result.error
    pending := state.used - result.transferred
    i: usize = 0
    for i < pending { state.storage[i] = state.storage[result.transferred + i] i += 1 }
    state.used = pending
    return result
  }
  state.used = 0
  return result
}

fn writer_write(data: rawptr, source: []const u8) io.Result {
  state := #cast(*Writer) data
  if state.used > #len(state.storage) { state.error = -22 }
  if state.error != 0 {
    return io.Result{ transferred: 0, error: state.error, status: io.Status.Error }
  }
  if #len(state.storage) == 0 { return io.write_all(state.destination, source) }
  total: usize = 0
  for total < #len(source) {
    if state.used == #len(state.storage) {
      flushed := writer_flush(state)
      if flushed.status == io.Status.Error {
        return io.Result{ transferred: total, error: flushed.error, status: io.Status.Error }
      }
    }
    available := #len(state.storage) - state.used
    amount := #len(source) - total
    if amount > available { amount = available }
    i: usize = 0
    for i < amount {
      state.storage[state.used + i] = source[total + i]
      i += 1
    }
    state.used += amount
    total += amount
  }
  return io.Result{ transferred: total, error: 0, status: io.Status.Complete }
}

pub fn writer_adapter(state: *Writer) io.Writer {
  return io.Writer{ data: #cast(rawptr) state, write: &writer_write }
}

pub struct Reader {
  source: io.Reader,
  storage: []u8,
  start: usize,
  end: usize,
  ended: bool,
  error: isize,
}

pub fn reader(source: io.Reader, storage: []u8) Reader {
  return Reader{ source: source, storage: storage }
}

fn reader_read(data: rawptr, destination: []u8) io.Result {
  state := #cast(*Reader) data
  if state.start > state.end || state.end > #len(state.storage) {
    return io.Result{ error: -22, status: io.Status.Error }
  }
  total: usize = 0
  for total < #len(destination) {
    if state.start == state.end {
      if state.error != 0 { return io.Result{ transferred: total, error: state.error, status: io.Status.Error } }
      if state.ended { return io.Result{ transferred: total, error: 0, status: io.Status.End } }
      if #len(state.storage) == 0 {
        direct := io.read(state.source, destination)
        if direct.transferred > #len(destination) {
          state.error = -5
          return io.Result{ error: state.error, status: io.Status.Error }
        }
        if direct.status == io.Status.Complete && direct.transferred == 0 {
          direct.status = io.Status.Error
          direct.error = -5
        }
        if direct.status == io.Status.Error {
          if direct.error == 0 { direct.error = -5 }
          state.error = direct.error
        }
        if direct.status == io.Status.End { state.ended = true }
        return direct
      }
      input := io.read(state.source, state.storage)
      if input.transferred > #len(state.storage) {
        state.error = -5
        return io.Result{ transferred: total, error: state.error, status: io.Status.Error }
      }
      state.start = 0
      state.end = input.transferred
      if input.status == io.Status.Error {
        state.error = input.error
        if state.error == 0 { state.error = -5 }
      }
      if input.status == io.Status.End { state.ended = true }
      if input.transferred == 0 {
        if state.error != 0 { return io.Result{ transferred: total, error: state.error, status: io.Status.Error } }
        if state.ended { return io.Result{ transferred: total, status: io.Status.End } }
        state.error = -5
        return io.Result{ transferred: total, error: state.error, status: io.Status.Error }
      }
    }
    available := state.end - state.start
    amount := #len(destination) - total
    if amount > available { amount = available }
    i: usize = 0
    for i < amount {
      destination[total + i] = state.storage[state.start + i]
      i += 1
    }
    state.start += amount
    total += amount
  }
  if total > 0 && state.start == state.end && state.error != 0 {
    return io.Result{ transferred: total, error: state.error, status: io.Status.Error }
  }
  return io.Result{ transferred: total, error: 0, status: io.Status.Complete }
}

pub fn reader_adapter(state: *Reader) io.Reader {
  return io.Reader{ data: #cast(rawptr) state, read: &reader_read }
}

// Delimiter is consumed but excluded from output. End may accompany a final
// unterminated fragment. Capacity failure preserves unread input for the next call.
pub fn read_until(state: *Reader, destination: []u8, delimiter: u8) io.Result {
  total: usize = 0
  byte: [1]u8 = []
  for total < #len(destination) {
    input := io.read(reader_adapter(state), byte[..])
    if input.transferred != 0 {
      if byte[0] == delimiter { return io.Result{ transferred: total, error: input.error, status: input.status } }
      destination[total] = byte[0]
      total += 1
    }
    if input.status != io.Status.Complete {
      return io.Result{ transferred: total, error: input.error, status: input.status }
    }
    if input.transferred == 0 { return io.Result{ transferred: total, error: -5, status: io.Status.Error } }
  }
  return io.Result{ transferred: total, error: -28, status: io.Status.Error }
}

pub fn read_line(state: *Reader, destination: []u8) io.Result {
  return read_until(state, destination, 10)
}
