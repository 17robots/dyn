#target(kernel: darwin)
fn mapping_allocate(size: usize) Mapping {
  address := #syscall(197, 0, size, 3, 4098, -1, 0)
  if address < 0 { return Mapping{ error: address } }
  return Mapping{ bytes: (#cast(*u8) address)[..size], ok: true }
}
fn mapping_release(bytes: []u8) isize { return #syscall(73, &bytes[0], #len(bytes)) }
