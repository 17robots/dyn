use "std/unicode/utf8"

// A statement owns its provider handle. Do not copy live statements or access
// fields directly. Database must remain open until every statement is finalized.
pub enum State { Ready, Row, Done, Failed }
pub struct Statement { handle: rawptr, state: State, code: i32 }
pub struct PrepareResult { statement: Statement, consumed: usize, empty: bool, code: i32, ok: bool }
pub struct StepResult { state: State, code: i32, ok: bool }
pub enum ColumnKind { Null, Integer, Float, Text, Blob }
pub struct Column { kind: ColumnKind, integer: i64, real: f64, bytes: []const u8, code: i32, ok: bool }

// Negative codes are wrapper failures; positive codes are unchanged SQLite codes.
pub const InvalidArgument: i32 = -1
pub const Capacity: i32 = -2
pub const Overflow: i32 = -3

// Compiles the first statement, reporting bytes consumed. Call again with the
// remaining SQL to process a script. Empty/comment-only input succeeds with empty=true.
// SQL is borrowed only during this call and needs no terminating NUL or scratch.
pub fn prepare(database: Database, sql: []const u8) PrepareResult {
  if database == nil { return PrepareResult{ code: InvalidArgument } }
  if #len(sql) > 2147483647 { return PrepareResult{ code: Overflow } }
  for byte in sql { if byte == 0 { return PrepareResult{ code: InvalidArgument } } }
  if #len(sql) == 0 { return PrepareResult{ empty: true, ok: true } }
  handle: rawptr = nil tail: c.string = nil
  code := sqlite_prepare(database, &sql[0], #cast(i32) #len(sql), &handle, &tail)
  if code != 0 {
    if handle != nil { _ = sqlite_finalize(handle) }
    return PrepareResult{ code: code }
  }
  consumed := #cast(usize) tail - #cast(usize) &sql[0]
  return PrepareResult{ statement: Statement{ handle: handle }, consumed: consumed, empty: handle == nil, ok: true }
}

// Row and Done are successful, distinct outcomes. Repeated calls after Done or
// failure do not implicitly re-execute SQL. reset is required before reuse.
pub fn step(statement: *Statement) StepResult {
  if statement.handle == nil { return StepResult{ state: State.Failed, code: InvalidArgument } }
  if statement.state == State.Done { return StepResult{ state: State.Done, code: statement.code, ok: true } }
  if statement.state == State.Failed { return StepResult{ state: State.Failed, code: statement.code } }
  statement.code = sqlite_step(statement.handle)
  if statement.code == 100 { statement.state = State.Row }
  else if statement.code == 101 { statement.state = State.Done }
  else { statement.state = State.Failed }
  return StepResult{ state: statement.state, code: statement.code, ok: statement.state != State.Failed }
}

// Always resets execution state, even when reporting the preceding execution's
// error. Parameter values survive reset; use clear_bindings to release them.
pub fn reset(statement: *Statement) i32 {
  if statement.handle == nil { return InvalidArgument }
  code := sqlite_reset(statement.handle)
  statement.state = State.Ready statement.code = 0
  return code
}

// Releases ownership and zeros the caller's slot even if SQLite reports a prior
// execution error. Finalizing the same slot again succeeds without provider access.
pub fn finalize(statement: *Statement) i32 {
  handle := statement.handle
  statement.* = Statement{}
  if handle == nil { return 0 }
  return sqlite_finalize(handle)
}

fn can_bind(statement: *const Statement) bool { return statement.handle != nil && statement.state == State.Ready }
pub fn clear_bindings(statement: *Statement) i32 {
  if !can_bind(statement) { return InvalidArgument }
  return sqlite_clear_bindings(statement.handle)
}
pub fn bind_null(statement: *Statement, index: i32) i32 {
  if !can_bind(statement) { return InvalidArgument }
  return sqlite_bind_null(statement.handle, index)
}
pub fn bind_i64(statement: *Statement, index: i32, value: i64) i32 {
  if !can_bind(statement) { return InvalidArgument }
  return sqlite_bind_integer(statement.handle, index, value)
}
pub fn bind_f64(statement: *Statement, index: i32, value: f64) i32 {
  if !can_bind(statement) { return InvalidArgument }
  return sqlite_bind_float(statement.handle, index, value)
}
fn bind_bytes(statement: *Statement, index: i32, value: []const u8, text: bool) i32 {
  if !can_bind(statement) { return InvalidArgument }
  if #len(value) > 2147483647 { return Overflow }
  // Empty data must have a non-null pointer so it is not bound as SQL NULL.
  empty: [1]u8 = []
  pointer := #cast(rawptr) &empty[0]
  if #len(value) > 0 { pointer = #cast(rawptr) &value[0] }
  transient := #cast(rawptr) #cast(isize) -1
  if text { return sqlite_bind_text(statement.handle, index, pointer, #cast(i32) #len(value), transient) }
  return sqlite_bind_blob(statement.handle, index, pointer, #cast(i32) #len(value), transient)
}
// SQLite copies bindings before return. Text must be valid UTF-8 without NUL;
// use blobs for arbitrary bytes. Inputs may be changed immediately after binding.
pub fn bind_text(statement: *Statement, index: i32, value: []const u8) i32 {
  if !utf8.valid(value) { return InvalidArgument }
  for byte in value { if byte == 0 { return InvalidArgument } }
  return bind_bytes(statement, index, value, true)
}
pub fn bind_blob(statement: *Statement, index: i32, value: []const u8) i32 { return bind_bytes(statement, index, value, false) }

pub fn column_count(statement: *const Statement) i32 {
  if statement.handle == nil { return 0 }
  return sqlite_column_count(statement.handle)
}
// Columns are zero-based and available only after Row. No implicit conversions:
// kind distinguishes NULL, empty text, empty blob and numeric zero. Returned bytes
// borrow SQLite storage until step/reset/finalize; clone them into an arena to retain.
pub fn column(statement: *const Statement, index: i32) Column {
  if statement.handle == nil || statement.state != State.Row || index < 0 || index >= sqlite_column_count(statement.handle) {
    return Column{ code: InvalidArgument }
  }
  kind := sqlite_column_type(statement.handle, index)
  if kind == 5 { return Column{ kind: ColumnKind.Null, ok: true } }
  if kind == 1 { return Column{ kind: ColumnKind.Integer, integer: sqlite_column_integer(statement.handle, index), ok: true } }
  if kind == 2 { return Column{ kind: ColumnKind.Float, real: sqlite_column_float(statement.handle, index), ok: true } }
  pointer: *const u8 = nil
  result_kind := ColumnKind.Text
  if kind == 3 { pointer = sqlite_column_text(statement.handle, index) }
  else if kind == 4 { pointer = sqlite_column_blob(statement.handle, index) result_kind = ColumnKind.Blob }
  else { return Column{ code: InvalidArgument } }
  length := sqlite_column_bytes(statement.handle, index)
  if pointer == nil && (length != 0 || kind == 3) { return Column{ code: 7 } }
  if length == 0 { return Column{ kind: result_kind, bytes: "", ok: true } }
  return Column{ kind: result_kind, bytes: pointer[..#cast(usize) length], ok: true }
}
