from "std" use { Error, Option, Result, io, math, heap };
from "std" use { * as std };

// comment
/*
	multi
	line
	comment
*/

void main() {
	// variables
	primitives();
	arrays();
	// statements
	if_statements();
	match_statements();
	defer_statements();
	loops();
	// functions
	functions();
	// declarations
	enums();
	structs();
	unions_and_intersections();
	errors();
	generics();
	alias();
	// advanced
	memory();
	concurrency();

  mut *mut i3 x;
}

void primitives() {
	// vars immutable by default
	// use mut before type to declare var that can change
	i2 x = 0; // ints can be any size (signed will always be size + 1 for sign bits)
	u5 y = 1; // unsigned
	// floats cannot be nonstandard
	f32 single_precision = 1.0;
	f64 double_precision = 1.000001;
	u8 character = 'a';
	u1 boolean = false;
}
void arrays() {
	// arrs are fixed sizes of similarly typed pieces of data
    mut i32[] nums = [1,2,3,4,5]; // size known at comptime
    nums[0] *= 2;
    mut i32[5] nums2; // uninitialized values
    nums[0] = 0;
    nums[1] = 1;
    nums[2] = 2;
    nums[3] = 3;
    nums[4] = 4;
}

void if_statements() {
    u1 yes = true;
    if yes {
        io.println("This should print");
    } else {
        io.println("If this runs then oops");
    }

    u1 no = false;
    if no {
        io.println("If this runs then oops");
    } else if yes {
        io.println("This should print");
    } else {
        io.println("If this runs then we really messed up");
    }
}
void match_statements() {
    i32 x = 100;
    match x {
        1: {
            io.println("This shouldnt run");
        },
        2: {
            io.println("This shouldnt run");
        },
        4..90: {
            io.println("This shouldnt run");
        },
        _ if x > 90: {
            io.println("This shouldnt run");
        },
        _: {
            io.println("This is the default and also shouldnt run");
        }
    }
}
void defer_statements() {
    defer io.println("This executes last");
    defer io.println("This executes second");
    defer {
		// can be done in a block
		io.println("This executes first");
	}
}
void loops() {
    loop {
        io.println("This is an infinite loop");
        break;
    }

    for i : 1..100 {
        io.println(i);
    }

    u8[] items = [1,2,3,4,5];

    for i32 i : 0..arr.len(items): (i += 2) { // shorthand and with custom trigger condition
        io.println(arr[i]);
    }
}

void functions() {
    // function syntax <type> <name>(<args>) { <stuff> }
    i32 local, state = 0;
    mut i32 result;
    void internal_fn() {
        // we can access local state here
        io.println(local, state);
        do_something();
        io.println(some_number());
        io.println(some_number_2());
        io.println(some_math(1,2));
        io.println(some_more_math(1,2));
        manipulate_numbers(&mut result, &local, &state);
    }
    internal_fn();
	i32 some_number() { return 100; }
	i32 some_number_2() => 100; // other way to return one liners
	i32 some_math(i32 x, i32 y) => x + y;
	i32 some_more_math(i32 x, y) => x * y; // can omit if same type
	i32 math_with_pointers(*i32 x, y) => *x * *y; // pass by pointers instead of copy
	void manipulate_numbers(mut *i32 result, i32 x, y) { result = x + y; } // can pass by mutable pointer to manipulate params
    io.println(result); // gets set with the manipulate_numbers fn

    // fns can also return any type including user-defined types
}

void do_something() {
    io.println("This function doesnt return anything");
}

void unions_and_intersections() {
    // unions represented by <type>|<type>
    // usable in fns and structs and type declarations and constants
    struct Red {}
    struct Orange {}
    struct Yellow {}
    struct Green {}
    struct Blue {}
    struct Indigo {}
    struct Violet {}
    struct Rainbow {
        Red|Orange|Yellow|Green|Blue|Indigo|Violet color;
    }

    // works with constants too
    fn print_role("user"|"admin"|"manager" x) { // this wont take variables only constants
        io.println("role");
    }
    print_role("user"); // works but wont work with a var named role
}
void enums() {
    enum CLike {
        SOME,
        THING,
        HERE
    }
    enum Partnered {
        COOL(i32),
        THING(u1),
        HERE(u8)
    }
    CLike example = .SOME;
    Partnered example2 = .THING(false);

    if example == .SOME {} else {}
    if example2 == .THING(v) {
        io.println(v);
    } else {} 
    match example2 { // pattern matching
        .COOL(v): { io.println(v); },
        .THING(v): { io.println(v); },
        .HERE(v): { io.println(v); },
    }
}
void alias() {
    // use the type alias to assign a value over any type
    type EitherOr = i32|f32;
    type SortFn = u1(f32 x,y);
    struct Earth {}
    struct Mars {}
    type Planet = Earth|Mars;
    void use_alias(Planet[] x, SortFn y) {} // use them in args
    // can be used for constants
    type PlanetTypes = "Earth"|"Mars";
    Planet get_planet(PlanetTypes name) {
       return if name == "Earth" { Earth{} } else { Mars{} };
    }

    // theres 2 ways to use type definitions for structs that implement a struct and have a superClass
    // 1
    struct Something {}
    struct SuperClass {}
    type AnonStruct = struct: Something { SuperClass; }; // define a type as an anon struct that implements Something and is a subclass of SuperClass, this method allows overriding method implementation Something

    // 2
    struct SuperClass2: Something {}
    type AnonStruct2 = struct { SuperClass; }; // define a type as an anon struct that is a subclass of SuperClass2, which implements Something, this method does not allow overriding method implementation from Something
}
void errors() {
   // no errs specifically but std provides Option and Result types like rust
   Result<i32> x = .Ok(5);
   Result<i32> y = .Err(Error.new("Wow we broke"));
   Option<f32> a = .Some(5.0);
   Option<f32> b = .None;
   if a == .Some(x) {
        io.println(x);
   } else {}
   Option<i32> do_a_thing() => None; // can be used as return vals
}
void generics() {
    // use <> for syntax, mainly used for fns and structs
    void print_val<T>(T x) { io.println(x); }
    void print_val2<T, U>(T x, U y) {
        io.println(x);
        io.println(y);
    }
    void print_stuff<T: i32|f32, U: u8[]|i32[]>(T x,y, U z) {
       // this can be used to be more readable and more concise instead of doing union type defs
    }
    struct Node<T> { // this is better when not needing any specific restrictions
        T data;
        &Node next;
    }
    // if you want to be inclusive then type defs could be helpful, but generics are better for exclusive stuff or just any
}
void structs() {
    struct A {
        u8 age;
        f32 weight;
        u8[] name;
    }
    A a = { age: 22, weight: 100.5, name: "Bob" };
    mut A b = { age: 22, weight: 100.5, name = "Bob" };
    b.name = "Joe";
    b.age = 23;
    b.weight = 150.4;
    struct B {
        *A[] parents;
        u8[] home_city;
    }
    B new_b = { parents: &A, home_city: "New York City" };
    io.println(new_b.home_city);
    struct C {
        A;
        B;
        C new(u8[] name, u8 age, f32 weight, u8[] home_city, Option<*A[]> parents) => .{
            name,
            age,
            weight,
            home_city,
            parents: if parents == None { [] } else { parents },
        };
        void print(*self) {
            io.println(self.name, ", age: ", self.age);
            io.println("weight: ", self.weight);
            io.println("home city: ", self.home_city);
            io.println("parents: ");
            for i in parents {
                io.println("- ", i.name);
            }
        }
    }
    C something_else = C.new("Joe", 50, 200.45, "Cleveland", [&a, &b]);
    something_else.print(); // prints just for this instance

    struct Shape {
        u8 num_sides;
        f64 area(*self);
    }
    struct Triangle: Shape {
        u8 num_sides = 3;
        f64 b,h;
        f64 area(*self) => self.b * self.h * (1/2);
        Triangle new(f64 b, h) => Triangle { b, h };
    }
    struct Circle: Shape {
        u8 num_sides = 0; // define a default val
        f64 r;
        f64 area(*self) => math.PI * self.r * self.r;
        Circle new(f64 r) => Circle { r };
    }
    struct Rectangle: Shape {
        u8 num_sides = 4;
        f64 l,w;
        f64 area(*self) => self.l * self.w;
        Rectangle new(f64 l, Options<f64> w) => Rectangle { l, h: if h == Some(x) { x } else { l } };
    }
    void print_area(Shape x) {
       io.println(x.area()); 
    }
    print_area(struct{ 
        u8 num_sides = 6;
        f64 l = 5;
        f64 area(*self) => 3 * self.l * self.l;
    }); // anon struct
}

void memory() {
	// memory is easy but also not
	mut heap.GeneralAllocator gpa = heap.GeneralAllocator.new();
	defer aa.delete();
	mut Result(*mut i32) x = aa.alloc(i32,1);
	if x == .Error(v) {}
	defer aa.free(x);
	mut *mut i32 = x;

	// also works with arena, each do the same thing but with arena, no need to free memory individually
}
