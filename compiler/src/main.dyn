// example functions
void immutable_copy(i32 x) {}
void immutable_borrow(*i32 x) {}
void mutable_value_borrow(*mut i32 x) {}
void mutable_pointer_borrow(mut *i32 x) {}
void mutable_pointer_value_borrow(mut *mut i32 x) {}

void calling_above() {
  mut i32 x = 4;
  immutable_copy(3); // works because it doesnt require a reference 
  immutable_copy(x); // also works
  immutable_borrow(&x); // works 
  mutable_value_borrow(&mut x);
}
