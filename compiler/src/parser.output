Terminals unused in grammar

    WHITESPACE


Grammar

    0 $accept: decls $end

    1 decls: "pub" decl
    2      | decl
    3      | decls decl

    4 decl: var_decl SEMICOLON
    5     | fn_decl
    6     | enum_decl
    7     | struct_decl

    8 struct_decl: "struct" ident R_BRACE struct_members L_BRACE
    9            | "struct" ident COLON traits R_BRACE struct_members L_BRACE

   10 traits: %empty

   11 struct_members: %empty
   12               | var SEMICOLON
   13               | var EQUAL expr SEMICOLON
   14               | fn_decl

   15 enum_decl: "enum" ident L_BRACE enum_members R_BRACE

   16 enum_members: %empty
   17             | ident
   18             | ident L_PAREN partners R_PAREN
   19             | enum_members COMMA ident COMMA
   20             | enum_members COMMA ident L_PAREN partners R_PAREN

   21 partners: ident
   22         | partners COMMA ident

   23 fn_sig: var L_PAREN fn_args R_PAREN

   24 fn_decl: fn_sig block
   25        | fn_sig SEMICOLON
   26        | fn_sig ARROW expr

   27 fn_args: %empty
   28        | var
   29        | "mut" var
   30        | fn_args COMMA var
   31        | fn_args COMMA "mut" var

   32 var: ident ident

   33 var_decl: "mut" var SEMICOLON
   34         | "mut" var EQUAL expr SEMICOLON
   35         | "con" var EQUAL expr SEMICOLON
   36         | var EQUAL expr SEMICOLON

   37 stmts: stmt SEMICOLON
   38      | stmts SEMICOLON stmt

   39 stmt: %empty
   40     | decl
   41     | fn_call SEMICOLON

   42 block: L_BRACE stmts R_BRACE

   43 expr: ident
   44     | number
   45     | fn_call

   46 fn_call: ident L_PAREN call_args R_PAREN

   47 call_args: %empty
   48          | expr
   49          | call_args COMMA expr

   50 ident: IDENT

   51 number: INT
   52       | DOUB


