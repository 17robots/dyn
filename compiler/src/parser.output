Grammar

    0 $accept: decls $end

    1 decls: decl
    2      | "pub" decl
    3      | decls decl
    4      | decls "pub" decl
    5      | %empty

    6 decl: var_decl
    7     | func_decl
    8     | enum_decl
    9     | struct_decl
   10     | type_decl

   11 var_decl: ident ident EQUAL expr SEMICOLON
   12         | "mut" ident ident SEMICOLON
   13         | "con" ident ident EQUAL expr SEMICOLON
   14         | "mut" ident ident EQUAL expr SEMICOLON

   15 func_decl: ident ident L_PAREN func_decl_args R_PAREN block
   16          | ident ident L_PAREN func_decl_args R_PAREN

   17 func_decl_args: %empty
   18               | var_decl
   19               | func_decl_args COMMA var_decl

   20 enum_decl: "enum" ident L_BRACE enum_fields R_BRACE

   21 enum_fields: ident
   22            | enum_fields ident
   23            | ident L_PAREN enum_partners R_PAREN
   24            | enum_fields ident enum_partners

   25 enum_partners: ident
   26              | enum_partners COMMA ident

   27 struct_decl: "struct" ident L_BRACE struct_fields R_BRACE
   28            | "struct" ident COLON struct_inherits L_BRACE struct_fields R_BRACE

   29 struct_fields: %empty
   30              | var_decl
   31              | func_decl
   32              | struct_fields var_decl
   33              | struct_fields func_decl

   34 struct_inherits: ident
   35                | struct_inherits COMMA ident

   36 type_decl: "type" type_list

   37 type_list: ident
   38          | type_list PIPE ident

   39 stmts: stmt
   40      | stmts stmt
   41      | %empty

   42 stmt: decl
   43     | "if" boolean_expr L_BRACE block R_BRACE
   44     | "loop" block
   45     | "for" ident COLON expr L_BRACE block R_BRACE
   46     | "match" ident L_BRACE match_branches R_BRACE
   47     | "return" expr SEMICOLON
   48     | "return" SEMICOLON
   49     | "defer" expr SEMICOLON
   50     | "break" SEMICOLON
   51     | "continue" SEMICOLON

   52 match_branches: %empty
   53               | match_branch
   54               | match_branches match_branch

   55 match_branch: expr COLON L_BRACE block R_BRACE
   56             | "_" COLON L_BRACE block R_BRACE

   57 block: L_BRACE stmts R_BRACE
   58      | L_BRACE R_BRACE

   59 ident: IDENTIFIER

   60 numeric: INTEGER
   61        | DOUBLE

   62 expr: ident EQUAL ident
   63     | ident L_PAREN call_args R_PAREN
   64     | ident
   65     | numeric
   66     | boolean_expr
   67     | crement expr
   68     | expr crement
   69     | uop expr
   70     | L_PAREN expr R_PAREN
   71     | expr mop expr
   72     | func_literal
   73     | struct_literal

   74 call_args: %empty
   75          | ident
   76          | call_args COMMA ident

   77 boolean_expr: boolean
   78             | boolean_expr lop boolean

   79 boolean: expr comparison expr
   80        | L_PAREN expr comparison expr R_PAREN
   81        | BANG boolean

   82 lop: AMPERSAND_AMPERSAND
   83    | PIPE_PIPE

   84 mop: PLUS
   85    | MINUS
   86    | ASTERISK
   87    | SLASH
   88    | PERCENT
   89    | AMPERSAND
   90    | PIPE

   91 crement: PLUS_PLUS
   92        | MINUS_MINUS

   93 uop: ASTERISK
   94    | AMPERSAND

   95 comparison: EQUAL_EQUAL
   96           | BANG_EQUAL
   97           | LT
   98           | LT_EQUAL
   99           | GT
  100           | GT_EQUAL

  101 func_literal: ident L_PAREN func_decl_args R_PAREN block

  102 struct_literal: "struct" L_BRACE struct_fields R_BRACE
  103               | "struct" COLON struct_inherits L_BRACE struct_fields R_BRACE


