module unix

O_RDONLY := 0

read_raw := extern (fd: i32, buf: *any, len: usize) isize = "read"
write_raw := extern (fd: i32, buf: *any, len: usize) isize = "write"
open_raw := extern (path: *any, flags: i32, mode: i32) i32 = "open"
close_raw := extern (fd: i32) i32 = "close"
getenv_raw := extern (name: *any) ?*any = "getenv"
execvp_raw := extern (file: *any, argv: *any) i32 = "execvp"
fork_raw := extern () i32 = "fork"
waitpid_raw := extern (pid: i32, status: *i32, options: i32) i32 = "waitpid"
exit_raw := extern (code: i32) = "exit"

pub open_readonly := (path: *any) i32 {
    return open_raw(path, O_RDONLY, 0)
}

pub close := (fd: i32) i32 {
    return close_raw(fd)
}

pub read := (fd: i32, buf: *any, len: usize) isize {
    return read_raw(fd, buf, len)
}

pub write := (fd: i32, buf: *any, len: usize) isize {
    return write_raw(fd, buf, len)
}

pub getenv := (name: *any) ?*any {
    return getenv_raw(name)
}

pub fork := () i32 {
    return fork_raw()
}

pub execvp := (file: *any, argv: *any) i32 {
    return execvp_raw(file, argv)
}

pub waitpid := (pid: i32, status: *i32, options: i32) i32 {
    return waitpid_raw(pid, status, options)
}

pub exit := (code: i32) {
    exit_raw(code)
    return
}

pub wexitstatus := (status: i32) i32 {
    return (status >> 8) & 255
}
