module windows

Allocator := (use "std/mem").Allocator
O_RDONLY := 0
P_WAIT := 0
open_raw := extern (path: *any, flags: i32, mode: i32) i32 = "_open"
close_raw := extern (fd: i32) i32 = "_close"
read_raw := extern (fd: i32, buf: *any, len: u32) i32 = "_read"
write_raw := extern (fd: i32, buf: *any, len: u32) i32 = "_write"
exit_raw := extern (code: i32) = "exit"
getenv_raw := extern (name: *any) ?*any = "getenv"
spawnvp_raw := extern (mode: i32, file: *any, argv: *any) i32 = "_spawnvp"
argc_ptr_raw := extern () *i32 = "__p___argc"
argv_ptr_raw := extern () ***u8 = "__p___argv"

pub open_readonly := (path: *any) i32 { return open_raw(path, O_RDONLY, 0) }
pub close := (fd: i32) i32 { return close_raw(fd) }
pub read := (fd: i32, buf: *any, len: usize) isize { return $as(isize, read_raw(fd, buf, $as(u32, len))) }
pub write := (fd: i32, buf: *any, len: usize) isize { return $as(isize, write_raw(fd, buf, $as(u32, len))) }
pub getenv := (name: *any) ?*any { return getenv_raw(name) }
pub fork := () i32 => -1
pub execvp := (file: *any, argv: *any) i32 { _file := file; _argv := argv; return -1 }
pub waitpid := (pid: i32, status: *i32, options: i32) i32 { _pid := pid; _status := status; _options := options; return -1 }
pub exit := (code: i32) { exit_raw(code); return }
pub wexitstatus := (status: i32) i32 => status
pub spawn_process := (file: *any, argv: *any) i32 { return spawnvp_raw(P_WAIT, file, argv) }
pub path_sep := () u8 => '\\'
pub path_is_abs := (path: []u8) u1 {
    if path.len >= 3 {
        if path[1] == ':' {
            if path[2] == '\\' || path[2] == '/' return true
        }
    }
    if path.len >= 2 {
        if path[0] == '\\' && path[1] == '\\' return true
    }
    return false
}
pub path_dirname := (path: []u8) []u8 {
    if path.len == 0 return "."
    mut i := path.len
    for i > 0: {
        i -= 1
        if path[i] == '\\' || path[i] == '/' {
            if i == 0 return "\\"
            return path[0..i]
        }
    }
    return "."
}
pub path_basename := (path: []u8) []u8 {
    if path.len == 0 return path
    mut i := path.len
    for i > 0: {
        i -= 1
        if path[i] == '\\' || path[i] == '/' return path[i + 1..]
    }
    return path
}
pub path_join := (base: []u8, part: []u8, alloc: Allocator) ?[]u8 {
    if part.len == 0 {
        return clone_bytes(base, alloc)
    }
    if path_is_abs(part) {
        return clone_bytes(part, alloc)
    }
    if base.len == 0 {
        return clone_bytes(part, alloc)
    }

    mut needs_sep: u1 = true
    last := base[base.len - 1]
    if last == '\\' || last == '/' {
        needs_sep = false
    }

    mut total := base.len
    if needs_sep {
        total += 1
    }
    total += part.len
    raw := alloc.alloc(total, $as(usize, $alignof(u8))) or return null
    out: []u8 = .{ ptr: $as(*u8, raw), len: total }

    mut at: usize = 0
    mut i: usize = 0
    for i < base.len: {
        out[at] = base[i]
        at += 1
        i += 1
    }
    if needs_sep {
        out[at] = '\\'
        at += 1
    }
    i = 0
    for i < part.len: {
        out[at] = part[i]
        at += 1
        i += 1
    }
    return out
}
pub process_args := (alloc: Allocator) ?[][]u8 {
    argc_ptr := argc_ptr_raw()
    argv_ptr_ptr := argv_ptr_raw()
    argc := argc_ptr.*
    if argc <= 0 {
        return .{ ptr: $as(*[]u8, $as(usize, 1)), len: 0 }
    }

    argv := argv_ptr_ptr.*
    count := $as(usize, argc)
    bytes := count * $as(usize, $sizeof([]u8))
    raw_parts := alloc.alloc(bytes, $as(usize, $alignof([]u8))) or return null
    out: [][]u8 = .{ ptr: $as(*[]u8, raw_parts), len: count }

    mut i: usize = 0
    for i < count: {
        arg_ptr := argv[i]
        mut len: usize = 0
        for arg_ptr[len] != 0: {
            len += 1
        }
        raw := alloc.alloc(len, $as(usize, $alignof(u8))) or return null
        part: []u8 = .{ ptr: $as(*u8, raw), len: len }
        mut j: usize = 0
        for j < len: {
            part[j] = arg_ptr[j]
            j += 1
        }
        out[i] = part
        i += 1
    }
    return out
}

clone_bytes := (src: []u8, alloc: Allocator) ?[]u8 {
    raw := alloc.alloc(src.len, $as(usize, $alignof(u8))) or return null
    out: []u8 = .{ ptr: $as(*u8, raw), len: src.len }
    mut i: usize = 0
    for i < src.len: {
        out[i] = src[i]
        i += 1
    }
    return out
}
