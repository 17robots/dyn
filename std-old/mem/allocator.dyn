module mem

pub Allocator := struct {
    ctx: *any,
    impl_alloc: (ctx: *any, size: usize, align: usize) ?*any,
    impl_free: (ctx: *any, ptr: *any, size: usize),
    impl_realloc: ?(ctx: *any, ptr: *any, old_size: usize, new_size: usize, align: usize) ?*any = null,
}

pub Allocator.alloc := (self: Allocator, size: usize, align: usize) ?*any {
    ptr := self.impl_alloc(self.ctx, size, align) or return null
    return ptr
}

pub Allocator.free := (self: Allocator, ptr: *any, size: usize) {
    self.impl_free(self.ctx, ptr, size)
    return
}

pub Allocator.realloc := (self: Allocator, ptr: *any, old_size: usize, new_size: usize, align: usize) ?*any {
    if self.impl_realloc: |r| {
        resized := r(self.ctx, ptr, old_size, new_size, align) or return null
        return resized
    }
    if new_size == 0 {
        self.free(ptr, old_size)
        return $as(*any, $as(usize, 1))
    }
    fresh := self.alloc(new_size, align) or return null
    copy_size := if old_size < new_size old_size else new_size
    if copy_size != 0 {
        $memcpy(fresh, ptr, copy_size)
    }
    if old_size != 0 {
        self.free(ptr, old_size)
    }
    return fresh
}

pub Allocator.create := (self: Allocator, T: comp type) ?*T {
    one := self.create_many(T, 1) or return null
    return one.ptr
}

pub Allocator.destroy := (self: Allocator, T: comp type, ptr: *T) {
    size := $sizeof(T)
    if size == 0 return
    self.free($as(*any, ptr), size)
    return
}

pub Allocator.create_many := (self: Allocator, T: comp type, n: usize) ?[]T {
    elem_size := $as(usize, $sizeof(T))
    if n == 0 || elem_size == 0 {
        return .{ ptr: $as(*T, $as(usize, 1)), len: n }
    }
    mut size := n
    size *= elem_size
    raw := self.alloc(size, $as(usize, $alignof(T))) or return null
    return .{ ptr: $as(*T, raw), len: n }
}

pub Allocator.destroy_many := (self: Allocator, T: comp type, slice: []T) {
    elem_size := $as(usize, $sizeof(T))
    if slice.len == 0 || elem_size == 0 {
        return
    }
    mut size := slice.len
    size *= elem_size
    self.free($as(*any, slice.ptr), size)
    return
}

pub Allocator.resize_many := (self: Allocator, T: comp type, slice: []T, new_n: usize) ?[]T {
    elem_size := $as(usize, $sizeof(T))
    if elem_size == 0 {
        return .{ ptr: $as(*T, $as(usize, 1)), len: new_n }
    }

    mut old_size := slice.len
    old_size *= elem_size
    mut new_size := new_n
    new_size *= elem_size

    if new_size == 0 {
        if old_size != 0 {
            self.free($as(*any, slice.ptr), old_size)
        }
        return .{ ptr: $as(*T, $as(usize, 1)), len: 0 }
    }

    raw := self.realloc(
        $as(*any, slice.ptr),
        old_size,
        new_size,
        $as(usize, $alignof(T)),
    ) or return null
    return .{ ptr: $as(*T, raw), len: new_n }
}

pub eql := (T: comp type, a: []T, b: []T) u1 {
    if a.len != b.len return false

    elem_size := $as(usize, $sizeof(T))
    if elem_size == 0 return true

    mut bytes := a.len
    bytes *= elem_size
    return eql_bytes($as(*u8, a.ptr), $as(*u8, b.ptr), bytes)
}

pub eql_value := (T: comp type, a: *T, b: *T) u1 {
    elem_size := $as(usize, $sizeof(T))
    if elem_size == 0 return true
    return eql_bytes($as(*u8, a), $as(*u8, b), elem_size)
}

eql_bytes := (a: *u8, b: *u8, len: usize) u1 {
    mut i: usize = 0
    for i < len: {
        if a[i] != b[i] return false
        i += 1
    }
    return true
}
