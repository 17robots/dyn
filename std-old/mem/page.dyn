module mem

malloc := extern (size: usize) ?*any = "malloc"
free_raw := extern (ptr: *any) = "free"
realloc_raw := extern (ptr: *any, size: usize) ?*any = "realloc"

pub PageAllocator := struct {}

pub PageAllocator.init := () PageAllocator {
    return .{}
}

pub PageAllocator.allocator := (self: *PageAllocator) Allocator {
    return .{
        ctx: $as(*any, self),
        impl_alloc: page_alloc,
        impl_free: page_free,
        impl_realloc: page_realloc,
    }
}

page_alloc := (ctx: *any, size: usize, align: usize) ?*any {
    _ctx := ctx
    _align := align
    if size == 0 return malloc(1)
    return malloc(size)
}

page_free := (ctx: *any, ptr: *any, size: usize) {
    _ctx := ctx
    _size := size
    if $as(usize, ptr) == 1 return
    free_raw(ptr)
    return
}

page_realloc := (ctx: *any, ptr: *any, old_size: usize, new_size: usize, align: usize) ?*any {
    _ctx := ctx
    _old_size := old_size
    _align := align
    if new_size == 0 {
        if $as(usize, ptr) != 1 {
            free_raw(ptr)
        }
        return malloc(1)
    }
    if $as(usize, ptr) == 1 {
        return malloc(new_size)
    }
    return realloc_raw(ptr, new_size)
}
