module os

host_proc_platform := use "std/platform/host"
host_exit_fn := host_proc_platform.exit
host_getenv_fn := host_proc_platform.getenv
host_spawn_process_fn := host_proc_platform.spawn_process
host_args_fn := host_proc_platform.process_args

pub exit := (code: i32) {
    host_exit_fn(code)
    return
}

pub getenv_str := (name: []u8, alloc: Allocator) ?[]u8 {
    raw_name := alloc.alloc(name.len + 1, $as(usize, $alignof(u8))) or return null
    c_name: []u8 = .{ ptr: $as(*u8, raw_name), len: name.len + 1 }
    mut i: usize = 0
    for i < name.len: {
        c_name[i] = name[i]
        i += 1
    }
    c_name[name.len] = 0

    raw := host_getenv_fn($as(*any, c_name.ptr))
    alloc.destroy_many(u8, c_name)
    if raw == null return null

    ptr := $as(*u8, raw)
    mut len: usize = 0
    for ptr[len] != 0: {
        len += 1
    }

    raw_out := alloc.alloc(len, $as(usize, $alignof(u8))) or return null
    out: []u8 = .{ ptr: $as(*u8, raw_out), len: len }
    i = 0
    for i < len: {
        out[i] = ptr[i]
        i += 1
    }
    return out
}

pub spawn := (path: []u8, argv: [][]u8, alloc: Allocator) i32 {
    raw_path := alloc.alloc(path.len + 1, $as(usize, $alignof(u8))) or return -1
    c_path: []u8 = .{ ptr: $as(*u8, raw_path), len: path.len + 1 }
    mut i: usize = 0
    for i < path.len: {
        c_path[i] = path[i]
        i += 1
    }
    c_path[path.len] = 0

    mut ptr_count: usize = argv.len
    ptr_count += 2
    ptr_bytes := ptr_count * $as(usize, $sizeof(*u8))
    raw_argv := alloc.alloc(ptr_bytes, $as(usize, $alignof(*u8))) or return -1
    c_argv: []*u8 = .{ ptr: $as(**u8, raw_argv), len: ptr_count }
    c_argv[0] = c_path.ptr

    i = 0
    for i < argv.len: {
        arg := argv[i]
        raw_arg := alloc.alloc(arg.len + 1, $as(usize, $alignof(u8))) or return -1
        c_arg: []u8 = .{ ptr: $as(*u8, raw_arg), len: arg.len + 1 }
        mut j: usize = 0
        for j < arg.len: {
            c_arg[j] = arg[j]
            j += 1
        }
        c_arg[arg.len] = 0
        c_argv[i + 1] = c_arg.ptr
        i += 1
    }
    c_argv[ptr_count - 1] = $as(*u8, $as(usize, 0))

    status := host_spawn_process_fn($as(*any, c_path.ptr), $as(*any, c_argv.ptr))

    alloc.destroy_many(u8, c_path)
    i = 0
    for i < argv.len: {
        arg_ptr := c_argv[i + 1]
        if $as(usize, arg_ptr) != 0 {
            mut arg_len: usize = 0
            for arg_ptr[arg_len] != 0: {
                arg_len += 1
            }
            arg_buf: []u8 = .{ ptr: arg_ptr, len: arg_len + 1 }
            alloc.destroy_many(u8, arg_buf)
        }
        i += 1
    }
    alloc.free(raw_argv, ptr_bytes)
    return status
}

pub args := (alloc: Allocator) ?[][]u8 {
    return host_args_fn(alloc)
}
