module os

Allocator := (use "std/mem").Allocator
host_path_platform := use "std/platform/host"
host_path_is_abs_fn := host_path_platform.path_is_abs
host_path_dirname_fn := host_path_platform.path_dirname
host_path_basename_fn := host_path_platform.path_basename
host_path_join_fn := host_path_platform.path_join

pub is_abs := (path: []u8) u1 {
    return host_path_is_abs_fn(path)
}

pub dirname := (path: []u8) []u8 {
    return host_path_dirname_fn(path)
}

pub basename := (path: []u8) []u8 {
    return host_path_basename_fn(path)
}

pub join := (base: []u8, part: []u8, alloc: Allocator) ?[]u8 {
    return host_path_join_fn(base, part, alloc)
}
