use "std/fmt"
use "std/io" io
use "std/terminal" terminal

fn main() {
  storage: [32]u8 = []
  checksum: u64 = 0
  i: u64 = 0
  for i < 5000000 {
    bytes := fmt.u64_decimal(storage[..], i * 1000003)
    length := #len(bytes)
    first := bytes[0]
    checksum += #cast(u64) length
    checksum += #cast(u64) first
    i += 1
  }
  _ = io.println(terminal.stdout(), "{}", checksum)
}
