use "std/mem" mem

fn main() {
  capacity: usize = 67108864
  mapping := mem.arena_create(capacity)
  if !mapping.ok { #panic("mapping failed") }
  bytes := mem.arena_push_uninit(&mapping.arena, capacity, 1)[..capacity]
  defer { _ = mem.arena_release(&mapping.arena) }

  checksum: u64 = 0
  i: usize = 0
  for i < capacity {
    fill_value := #cast(u8) (i & 255)
    bytes[i] = fill_value
    i += 1
  }

  i = 0
  for i < capacity {
    checksum += #cast(u64) bytes[i]
    i += 1
  }

  if checksum != 8556380160 { #panic("benchmark checksum failed") }
}
