use "std/io"
use "std/terminal" terminal

fn main() {
  storage: [4096]u8 = []
  total: usize = 0
  input := terminal.stdin()
  read := io.read(input, storage[..])
  for read.transferred > 0 {
    total += read.transferred
    read = io.read(input, storage[..])
  }
  output: [1]u8 = []
  output[0] = #cast(u8) total
  _ = io.write_all(terminal.stdout(), output[..])
}
