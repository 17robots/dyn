use "std/mem"
use "std/io" io
use "std/terminal" terminal

fn main() {
  backing: [65536]u8 = []
  arena := mem.arena_from_buffer(backing[..])
  checksum: u64 = 0
  i: usize = 0
  for i < 2000000 {
    if mem.arena_remaining(&arena) < 32 { mem.arena_reset(&arena) }
    bytes := mem.arena_push(&arena, 32, 8)[..32]
    bytes[0] = #cast(u8) i
    checksum += #cast(u64) bytes[0]
    i += 1
  }
  _ = io.println(terminal.stdout(), "{}", checksum)
}
