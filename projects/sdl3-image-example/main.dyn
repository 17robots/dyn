use "vendor/sdl3"
use "vendor/sdl3/image" image
use "std/mem"
use "std/fs"
use "std/os/linux"
use "std/io"
use "std/terminal"
fn main() {
  storage := mem.arena_create(16 * 1024 * 1024) if !storage.ok { #panic("arena") }
  defer { _ = mem.arena_release(&storage.arena) }
  args := linux.process_arguments(&storage.arena)
  if #len(args) != 2 { _ = io.println(terminal.stdout(), "usage: sdl3-image-example IMAGE") return }
  path: [4096]u8 = []
  surface := image.load_owned(args[1], path[..]) if !surface.ok { #panic("image load") }
  defer sdl3.surface_destroy_owned(surface.value)
  bytes := fs.read_all(&storage.arena, args[1], 8 * 1024 * 1024) if !bytes.ok { #panic("image read") }
  decoded := image.decode_owned(bytes.data) if !decoded.ok { #panic("image decode") }
  defer sdl3.surface_destroy_owned(decoded.value)
  if image.decode_owned("not an image").ok { #panic("malformed image accepted") }
  _ = io.println(terminal.stdout(), "SDL_image: loaded file and decoded caller buffer")
}
