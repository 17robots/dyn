use "std/mem" mem
use "std/encoding/json" json
use "std/fs" fs
use "std/io" io
use "std/os/linux" linux
use "std/terminal" terminal

fn main() {
  mapping := mem.arena_create(16 * 1024 * 1024)
  if !mapping.ok { #panic("arena mapping failed") }
  defer { _ = mem.arena_release(&mapping.arena) }
  arena := &mapping.arena
  arguments := linux.process_arguments(arena)
  if #len(arguments) != 2 {
    _ = io.print(terminal.stderr(), "usage: json-check FILE\n")
    return
  }
  loaded := fs.read_all(arena, arguments[1], 16 * 1024 * 1024)
  if !loaded.ok { _ = io.println(terminal.stderr(), "could not read {}", arguments[1]) return }
  if json.valid(loaded.data) { _ = io.println(terminal.stdout(), "valid") }
  else { _ = io.println(terminal.stdout(), "invalid") }
}
