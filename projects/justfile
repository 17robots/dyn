# Standalone examples. Override configuration with environment variables.
set positional-arguments
set shell := ["bash", "-euo", "pipefail", "-c"]
export PROJECTS_DIR := justfile_directory()
export BUILD := absolute_path(env('BUILD', PROJECTS_DIR / 'build'))
export DYN := env('DYN', if path_exists(PROJECTS_DIR / '../build/dyn') == 'true' { PROJECTS_DIR / '../build/dyn' } else if path_exists(PROJECTS_DIR / '../compiler/build/dyn') == 'true' { PROJECTS_DIR / '../compiler/build/dyn' } else { 'dyn' })
export MODE := env('MODE', '--release')
export PROJECT := env('PROJECT', 'memory-tour')

all:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "$BUILD"
    for project in memory-tour example multi-module field-notes panic json-check recursive-search process-supervisor http-server http-client websocket-server websocket-client tar-inspect raw-terminal; do
        "$DYN" build "$PROJECTS_DIR/$project" $MODE --output "$BUILD/project-$project" --quiet
    done

build:
    test -f "$PROJECTS_DIR/$PROJECT/main.dyn" || { echo 'PROJECT must name an example directory' >&2; exit 2; }
    mkdir -p "$BUILD"
    "$DYN" build "$PROJECTS_DIR/$PROJECT" $MODE --output "$BUILD/project-$(basename "$PROJECT")"

# Example: PROJECT=memory-tour just run --help
run *args: build
    "$BUILD/project-$(basename "$PROJECT")" "$@"

check:
    python3 tools/check.py

test:
    sh validate.sh

release: all package

package:
    python3 tools/package.py --dist "$BUILD/dist"

clean:
    python3 -c 'import os,pathlib,shutil,sys; p=pathlib.Path(os.environ["BUILD"]).resolve(); root=pathlib.Path.cwd(); (p != pathlib.Path("/") and not root.is_relative_to(p)) or sys.exit("Refusing unsafe BUILD for clean"); shutil.rmtree(p) if p.exists() else None'

browser:
    mkdir -p "$BUILD/browser-canvas"
    "$DYN" build browser-canvas --target wasm32-browser --shared $MODE --output "$BUILD/browser-canvas/canvas.wasm"
    cp browser-canvas/index.html browser-canvas/main.js "$BUILD/browser-canvas/"

browser-video:
    #!/usr/bin/env bash
    set -euo pipefail
    if test -n "${BROWSER_FFMPEG_TOOL:-}"; then
        $BROWSER_FFMPEG_TOOL --output "$BUILD/browser-video"
    elif test -f "$PROJECTS_DIR/../compiler/tools/setup-browser-ffmpeg.py"; then
        python3 "$PROJECTS_DIR/../compiler/tools/setup-browser-ffmpeg.py" --output "$BUILD/browser-video"
    else
        dyn-browser-ffmpeg --output "$BUILD/browser-video"
    fi
    "$DYN" build browser-video --target wasm32-browser --shared $MODE --output "$BUILD/browser-video/filter.wasm"
    cp browser-video/index.html browser-video/main.js "$BUILD/browser-video/"

wasi:
    mkdir -p "$BUILD"
    "$DYN" build wasi-hello --target wasm32-wasi $MODE --output "$BUILD/wasi-hello.wasm"

help:
    @just --list
