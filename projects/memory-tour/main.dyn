use "std/mem"
use "std/strings"
use "std/io"
use "std/terminal"
use "std/container/slot_map" slots
use "std/profile"

struct Player { health: i32 }

fn expect(condition: bool) {
  if !condition { #panic("memory tour invariant failed") }
}

fn say(message: []const u8) {
  result := io.println(terminal.stdout(), message)
  if result.status != io.Status.Complete { #panic("tutorial output failed") }
}

// Return a pointer into CALLER storage, never into a local array.
fn player_create(arena: *mem.Arena, health: i32) *Player {
  player := #cast(*Player) mem.arena_push(arena, #sizeof(Player), #alignof(Player))
  player.* = Player{ health: health }
  return player
}

fn buffers_and_objects() {
  say("1. Buffers, one object, and one allocation containing an array")
  backing: [4096]u8 = []
  arena := mem.arena_from_buffer(backing[..])
  player := player_create(&arena, 100)
  expect(player.health == 100)

  // This small constant cannot overflow. Validate count * sizeof for external counts.
  count: usize = 3
  memory := mem.arena_push(&arena, count * #sizeof(Player), #alignof(Player))
  players := (#cast(*Player) memory)[..count]
  expect(players[0].health == 0) // arena_push zeroes storage.
  for *item in players { item.health = 50 }
  players[1].health = 75
  expect(players[0].health == 50 && players[1].health == 75)
  view := players[1..]
  view[0].health = 80
  expect(players[1].health == 80) // Slicing borrows, it does not copy.
  say("   One pointer and three contiguous players; slice mutation shares storage.")
  // No release needed for this local backing. Nothing may escape this function.
}

fn release_fixed(arena: *mem.Arena) {
  released := mem.arena_release(arena)
  if !released.ok { #panic("heap arena release failed") }
}

fn release_growing(arena: *mem.GrowingArena) {
  released := mem.growing_release(arena)
  if !released.ok { #panic("growing arena release failed") }
}

fn heap_and_failure() {
  say("2. Heap backing and checked capacity failure")
  created := mem.arena_create(4096)
  if !created.ok { #panic("heap arena creation failed") }
  defer release_fixed(&created.arena)
  player := player_create(&created.arena, 200)
  expect(player.health == 200) // Same helper works with stack or heap backing.
  before := mem.arena_used(&created.arena)
  failed := mem.arena_try_push(&created.arena, 8192, 1)
  expect(!failed.ok && mem.arena_used(&created.arena) == before)
  expect(player.health == 200)

  raw := mem.arena_push_uninit(&created.arena, 4, 1)
  bytes := raw[..4]
  // Uninitialized allocation: write every byte before reading it.
  for *byte in bytes { byte.* = 7 }
  expect(bytes[3] == 7)
  say("   Fixed arena stays bounded; failed allocation preserves existing objects.")
}

fn rewind_and_reset() {
  say("3. Rewind preserves older objects; reset reclaims everything")
  backing: [256]u8 = []
  arena := mem.arena_from_buffer(backing[..])
  arena.poison_on_rewind = true // Diagnostic scribble, not lifetime protection.
  player := player_create(&arena, 90)
  mark := mem.arena_mark(&arena)
  temporary := mem.arena_push(&arena, 32, 1)
  temporary.* = 12
  expect(temporary.* == 12)
  mem.arena_rewind(&arena, mark)
  // temporary is expired; even reading it to inspect poison would be invalid.
  expect(mem.arena_used(&arena) == mark && player.health == 90)
  mem.arena_reset(&arena)
  // player is now expired too. Only inspect arena bookkeeping.
  expect(mem.arena_used(&arena) == 0 && mem.arena_capacity(&arena) == 256)
  say("   Reclaimed addresses may be reused; old pointers never become valid again.")
}

// Work borrows disjoint scratch storage. Only a COPY into output may escape.
fn save_name(output: *mem.Arena, scratch: *mem.Arena, input: []const u8) []const u8 {
  mark := mem.arena_mark(scratch)
  defer mem.arena_rewind(scratch, mark)
  working := strings.clone(scratch, input)
  if !working.ok { #panic("scratch full") }
  trimmed := strings.trim(working.value) // A view, still backed by scratch.
  saved := strings.clone(output, trimmed)
  if !saved.ok { #panic("output full") }
  return saved.value
}

fn scratch_example(output: *mem.Arena, temporary: *mem.Arena) {
  // First candidate conflicts with output; scratch_begin selects the second.
  scope := mem.scratch_begin(output, temporary, output)
  defer mem.scratch_end(&scope)
  _ = mem.arena_push(scope.arena, 64, 1)
  expect(mem.arena_used(temporary) == 64)
}

fn children_and_scratch() {
  say("4. Subarenas and separate output/scratch lifetimes")
  backing: [4096]u8 = []
  root := mem.arena_from_buffer(backing[..])
  permanent := mem.arena_sub(&root, 1024)
  scratch_a := mem.arena_sub(&root, 1024)
  scratch_b := mem.arena_sub(&root, 1024)
  name := save_name(&permanent, &scratch_a, "  Ada  ")
  expect(strings.equal(name, "Ada") && mem.arena_used(&scratch_a) == 0)

  scratch_example(&permanent, &scratch_b)
  expect(mem.arena_used(&scratch_b) == 0 && strings.equal(name, "Ada"))
  say("   Output survives scratch rewind. Parent storage must outlive every child.")
  // Resetting root here would invalidate all children and name.
}

fn pools_and_free_lists() {
  say("5. Pools recycle individual fixed-size slots")
  backing: [4096]u8 = []
  arena := mem.arena_from_buffer(backing[..])
  pool := mem.pool_init(&arena, 2, #sizeof(Player), #alignof(Player))
  reserved := mem.arena_used(&arena)
  first := #cast(*Player) mem.pool_acquire(&pool)
  second := #cast(*Player) mem.pool_acquire(&pool)
  // Slots contain free-list links before acquisition. Initialize the whole object.
  first.* = Player{ health: 10 }
  second.* = Player{ health: 20 }
  expect(mem.pool_try_acquire(&pool) == nil && mem.pool_available(&pool) == 0)
  mem.pool_release(&pool, #cast(rawptr) first)
  // first is expired. Never read it or return it a second time.
  replacement := #cast(*Player) mem.pool_acquire(&pool)
  replacement.* = Player{ health: 30 }
  expect(second.health == 20 && replacement.health == 30)
  mem.pool_release(&pool, #cast(rawptr) second)
  mem.pool_release(&pool, #cast(rawptr) replacement)
  expect(mem.pool_available(&pool) == 2 && mem.arena_used(&arena) == reserved)
  say("   Returning slots restores pool capacity, not parent arena capacity.")

  say("6. FreeList is the lower-level mechanism behind Pool")
  list := mem.free_list_from_arena(&arena, 2, #sizeof(Player), #alignof(Player))
  slot := mem.free_list_try_alloc(&list)
  expect(slot != nil)
  object := #cast(*Player) slot
  object.* = Player{ health: 40 }
  expect(object.health == 40)
  mem.free_list_free(&list, slot)
  expect(list.free_count == list.slot_count)
  // Slots include pointer links and alignment padding: size may exceed sizeof(Player).
  say("   Free slots store next pointers. Prefer Pool for ordinary object reuse.")
}

fn growing_arenas() {
  say("7. Growing arenas add blocks without moving earlier allocations")
  arena := mem.growing_create(128)
  defer release_growing(&arena)
  first := mem.growing_push(&arena, 16, 1)
  first.* = 42
  larger := mem.growing_push(&arena, 4096, 1)
  larger.* = 9
  expect(first.* == 42 && larger.* == 9)
  mem.growing_reset(&arena)
  // Both pointers have expired; reset retains the blocks for future allocations.
  fresh := mem.growing_push(&arena, 16, 1)
  expect(fresh.* == 0)
  say("   Growth preserves live addresses; reset expires them and retains blocks.")
}

// The application decides lifetime. Arena choice follows that decision.
fn application_lifetimes() {
  say("8. Separate persistent state from request/frame scratch")
  persistent_bytes: [1024]u8 = [] request_bytes: [128]u8 = []
  persistent := mem.arena_from_buffer(persistent_bytes[..])
  request := mem.arena_from_buffer(request_bytes[..])
  players := mem.pool_init(&persistent, 2, #sizeof(Player), #alignof(Player))
  live := #cast(*Player) mem.pool_acquire(&players)
  live.* = Player{ health: 100 }
  retained: []const u8 = ""
  frame: usize = 0
  for frame < 16 {
    temporary := strings.clone(&request, "request result")
    expect(temporary.ok)
    if frame == 0 {
      saved := strings.clone(&persistent, temporary.value)
      expect(saved.ok)
      retained = saved.value
    }
    // Retain only the copied result. The temporary view expires at reset.
    mem.arena_reset(&request)
    expect(mem.arena_used(&request) == 0)
    expect(strings.equal(retained, "request result") && live.health == 100)
    frame += 1
  }
  mem.pool_release(&players, #cast(rawptr) live)
  // All users are finished. No pool slots, retained slices or native objects
  // may survive resetting their persistent backing storage.
  mem.arena_reset(&persistent)
  say("   Copy escaping data into persistent storage; reset scratch each request.")
  say("   Close native resources before resetting the arena containing their state.")
}

// Retained references use handles; retained values use caller-owned copies.
fn handles_and_observation() {
  say("9. Handles reject deleted objects; copies survive slot reuse")
  data: [8]u8 = []
  generations: [2]u32 = []
  occupied: [1]u64 = []
  objects := slots.init(data[..], generations[..], occupied[..], 4)
  first := slots.insert(&objects, "Ada!")
  saved: [4]u8 = []
  copied := slots.copy_into(&objects, first, saved[..])
  case copied {
    slots.CopyStatus.Complete => {},
    slots.CopyStatus.Missing => { #panic("object missing") },
    slots.CopyStatus.Capacity => { #panic("destination too small") },
  }
  expect(slots.remove(&objects, first))
  replacement := slots.insert(&objects, "Eve!")
  expect(!slots.get(&objects, first).ok)
  expect(strings.equal(slots.get(&objects, replacement).data, "Eve!"))
  expect(strings.equal(saved[..], "Ada!"))
  state := slots.snapshot(&objects)
  expect(state.live == 1 && state.available == 1)
  _ = io.println(terminal.stdout(), "   slots: live={}, available={}, retired={}",
    state.live, state.available, state.retired)

  say("10. Observe memory and timing using bounded caller storage")
  backing: [128]u8 = []
  arena := mem.arena_from_buffer(backing[..])
  events: [1]profile.Event = []
  trace := profile.trace(events[..])
  span := profile.begin("frame") // Static name outlives the trace.
  _ = mem.arena_push(&arena, 32, 1)
  snapshot := mem.arena_snapshot(&arena)
  expect(profile.finish(&trace, span))
  mem.arena_reset(&arena)
  // Snapshot contains values, not arena pointers. It still describes the earlier point.
  expect(snapshot.used == 32 && mem.arena_snapshot(&arena).used == 0)
  expect(!profile.finish(&trace, profile.begin("overflow")) && trace.dropped == 1)
  _ = io.println(terminal.stdout(), "   arena: used={}, remaining={}; trace events={}, dropped={}",
    snapshot.used, snapshot.remaining, #len(profile.recorded(&trace)), trace.dropped)
  say("   Inspect snapshots and profile events in debugger; no automatic heap allocation.")
}

fn main() {
  buffers_and_objects()
  heap_and_failure()
  rewind_and_reset()
  children_and_scratch()
  pools_and_free_lists()
  growing_arenas()
  application_lifetimes()
  handles_and_observation()
  say("Memory tour passed. Read projects/memory-tour/README.md for lifetimes and exercises.")
}
