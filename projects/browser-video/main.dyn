use "std/mem" mem
arena: mem.Arena
pub fn allocate(size: usize) rawptr {
  if size == 0 || size > 160 * 90 * 4 * 8 { return nil }
  if #len(arena.data) != 0 { return nil }
  created := mem.arena_create(size)
  if !created.ok { return nil }
  arena = created.arena
  return #cast(rawptr) mem.arena_push(&arena, size, 4)
}
pub fn release() { _ = mem.arena_release(&arena) }
pub fn grayscale(data: *u8, count: usize) {
  if count > mem.arena_used(&arena) / 4 { #panic("invalid frame size") }
  if data != #cast(*u8) &arena.data[0] { #panic("invalid frame buffer") }
  pixels := data[..count * 4]
  i: usize = 0
  for i < #len(pixels) {
    light := (#cast(u32) pixels[i] * 77 + #cast(u32) pixels[i + 1] * 150 + #cast(u32) pixels[i + 2] * 29) >> 8
    pixels[i] = #cast(u8) light pixels[i + 1] = #cast(u8) light pixels[i + 2] = #cast(u8) light
    i += 4
  }
}
