use "vendor/sdl3" sdl3
use "std/io" io
use "std/terminal" terminal
use "std/time"
fn main() {
  if !sdl3.init_audio() { #panic("SDL3 audio initialization failed") }
  defer { sdl3.quit() }
  spec := sdl3.AudioSpec{ format: sdl3.AudioU8, channels: 1, frequency: 8000 }
  stream := sdl3.stream_open_playback_owned(&spec)
  if !stream.ok { #panic("SDL3 audio stream creation failed") }
  defer { sdl3.stream_destroy_owned(stream.value) }
  // A quarter-second, quiet square wave. Unsigned PCM is centered on 128.
  samples: [2000]u8 = []
  i: usize = 0
  for i < #len(samples) {
    samples[i] = 116
    if i % 20 < 10 { samples[i] = 140 }
    i += 1
  }
  if !sdl3.stream_put(stream.value, samples[..]) ||
    !sdl3.stream_flush(stream.value) || !sdl3.stream_resume(stream.value) {
    #panic("SDL3 audio failed")
  }
  deadline := time.deadline_after(5 * time.Second)
  for {
    available := sdl3.stream_available(stream.value)
    if available < 0 { #panic("SDL3 audio status failed") }
    if available == 0 { break }
    if time.deadline_expired(&deadline) { #panic("SDL3 audio drain timed out") }
    if !time.sleep(10 * time.Millisecond) { #panic("audio wait failed") }
  }
  // Stream drain is not a hardware playback fence. Allow the device tail to play.
  if !time.sleep(250 * time.Millisecond) { #panic("audio tail wait failed") }
  _ = io.println(terminal.stdout(), "SDL3 audio drained")
}
