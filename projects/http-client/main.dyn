use "std/io" io
use "std/net" net
use "std/net/http" http
use "std/terminal" terminal

fn main() {
  address := net.ipv4(127, 0, 0, 1, 18080)
  connected := net.tcp_connect_ipv4(&address)
  if !connected.ok { _ = io.print(terminal.stderr(), "connect failed\n") return }
  connection := connected.connection
  defer { _ = net.connection_close(&connection) }
  request_storage: [512]u8 = []
  response_storage: [8192]u8 = []
  received_response := http.client_do_connection(
    &connection, request_storage[..], response_storage[..], "GET", "/", "127.0.0.1", "",
  )
  if !received_response.ok {
    _ = io.print(terminal.stderr(), "HTTP failed\n")
    return
  }
  response_bytes := received_response.raw
  _ = io.write_all(terminal.stdout(), response_bytes)
}
