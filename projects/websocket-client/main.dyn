use "std/io" io
use "std/net" net
use "std/net/websocket" websocket
use "std/terminal" terminal

fn main() {
  address := net.ipv4(127, 0, 0, 1, 18081)
  opened := net.tcp_connect_ipv4(&address)
  if !opened.ok { #panic("connect") }
  connection := net.connection_result_value(&opened)
  defer { _ = net.connection_close(&connection) }
  key: []const u8 = "dGhlIHNhbXBsZSBub25jZQ=="
  request: []const u8 = "GET /echo HTTP/1.1\r\nHost: 127.0.0.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n"
  if !net.connection_write(&connection, request).ok { #panic("upgrade write") }
  input: [4096]u8 = []
  received := net.connection_read(&connection, input[..])
  if !received.ok || !websocket.validate_upgrade_response(input[..#cast(usize) received.value], key) { #panic("upgrade") }
  output: [4096]u8 = []
  frame := websocket.write_frame(output[..], 1, "hello websocket", true, true, 16909060)
  if !net.connection_write(&connection, frame).ok { #panic("frame write") }
  received = net.connection_read(&connection, input[..])
  if !received.ok { #panic("frame read") }
  message: [2048]u8 = []
  control: [125]u8 = []
  state := websocket.message_state(false)
  event := websocket.receive(&state, message[..], control[..], websocket.parse_frame(input[..#cast(usize) received.value]))
  if event.kind != websocket.WebSocketEventKind.Ready { #panic("echo") }
  _ = io.println(terminal.stdout(), "{}", event.payload)
}
