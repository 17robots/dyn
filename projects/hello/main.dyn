use "std/io"
use "std/terminal"
use "std/mem"

fn main() {
  total := add(4,2)
  if total > 5 {
    _ = io.println(terminal.stdout(), "total: {}", total)
  }
  // small := #cast(u8) total
  i: usize = 0
  for i < 3 {
    _ = io.println(terminal.stdout(), "i: {}", i)
    i += 1
  }
  values: [3]i32 = [10, 20, 30]
  for value in values { _ = io.println(terminal.stdout(), "value: {}", value) }
  for *elem in values { elem.* += 1 }
  prefix := values[..2]
  prefix[0] = 99
  for v in values { _ = io.println(terminal.stdout(), "value: {}", v) }
  name := "Ada"
  player := Player{name: name}
  damage(&player, 1001)
  _ = io.println(terminal.stdout(), "player health: {}", player.health)
  show(State.Finished(90))

  storage: [1024]u8 = []
  arena := mem.arena_from_buffer(storage[..])
  allocation := mem.arena_try_push(&arena, 64, 1)
  if !allocation.ok { #panic("Arena full") }
  bytes := allocation.memory[..allocation.size]
  bytes[0] = 42
  mem.arena_reset(&arena)
  root := mem.arena_create(1024)
  if !root.ok { #panic("Arena allocation failed") }
  defer _ = mem.arena_release(&root.arena)
  allocation2 := mem.arena_try_push(&root.arena, 64, 1)
  bytes2 := allocation2.memory[..allocation2.size]
  for *byte in bytes2 { byte.* = '*' }
  _ = io.println(terminal.stdout(), "Bytes: {}", bytes2)
}
const DefaultHealth: u32 = 100

fn add(a: i32, b: i32) i32 {
  return a + b
}

struct Player { name: []const u8, health: u32 = DefaultHealth }

fn damage(player: *Player, amount: u32) {
  if amount > player.health { player.health = 0 } else { player.health -= amount }
}

enum State {
  Waiting,
  Finished: i32
}

fn show(state: State) {
  case state {
    State.Waiting => {
      _ = io.println(terminal.stdout(), "Waiting")
    },
    State.Finished score => {
      _ = io.println(terminal.stdout(), "Finished, score: {}", score)
    }
  }
}

