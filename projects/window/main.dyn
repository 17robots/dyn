use "std/io"
use "std/terminal"
use "vendor/sdl3"

fn main() {
  if !sdl3.init_video() { #panic("Failed to initialize video") }
  defer sdl3.quit()

  backing: [64]u8 = []
  window := sdl3.window_create("Dyn SDL3", backing[..], 640, 360, sdl3.WindowResizable)
  if !window.ok { #panic("window creation failed") }
  defer sdl3.window_destroy_owned(window.value)
  renderer := sdl3.renderer_create_default_owned(window.value)
  if !renderer.ok { #panic("renderer creation failed") }
  defer sdl3.renderer_destroy_owned(renderer.value)
  if !sdl3.clear(renderer.value, 20, 28, 48, 255) { #panic("clear failed") }
  if !sdl3.present(renderer.value) { #panic("present failed") }
  _ = io.println(terminal.stdout(), "SDL3 window open; close it to exit")
  event := sdl3.Event{}
  for {
    if !sdl3.wait_event(&event) { #panic("SDL3 event wait failed") }
    if sdl3.event_requests_close(&event) { break }
    if !sdl3.clear(renderer.value, 20, 28, 48, 255) || !sdl3.present(renderer.value) { #panic("SDL3 redraw failed") }
  }
}
