use "vendor/sqlite" sqlite
use "std/io" io
use "std/terminal" terminal

fn main() {
  backing: [128]u8 = []

  opened := sqlite.open(":memory:", backing[..])
  if !opened.ok { #panic("sqlite open failed") }
  defer { _ = sqlite.close(opened.database) }
  if sqlite.execute(opened.database, "create table task(id integer);", backing[..]) != 0 { #panic("sqlite exec failed") }
  prepared := sqlite.prepare(opened.database, "insert into task(id) values(?1)")
  if !prepared.ok || prepared.empty { #panic("sqlite prepare failed") }
  insert := prepared.statement
  defer _ = sqlite.finalize(&insert)
  if sqlite.bind_i64(&insert, 1, 42) != 0 || sqlite.step(&insert).state != sqlite.State.Done { #panic("sqlite bound insert failed") }
  queried := sqlite.prepare(opened.database, "select id from task")
  if !queried.ok || queried.empty { #panic("sqlite query prepare failed") }
  query := queried.statement
  defer _ = sqlite.finalize(&query)
  if sqlite.step(&query).state != sqlite.State.Row || sqlite.column(&query, 0).integer != 42 { #panic("sqlite row failed") }
  _ = io.println(terminal.stdout(), "sqlite ok")
}
