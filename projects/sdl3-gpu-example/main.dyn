use "vendor/sdl3" sdl3
use "std/io" io
use "std/terminal" terminal
use "std/mem"
use "std/os/linux"
use "std/strings"

fn main() {
  output := terminal.stdout()
  args_buffer: [65536]u8 = []
  arena := mem.arena_from_buffer(args_buffer[..])
  args := linux.process_arguments(&arena)
  smoke := #len(args) == 2 && strings.equal(args[1], "--smoke")
  if !sdl3.init_video() { #panic("SDL3 GPU unavailable") }
  defer { sdl3.quit() }
  backing: [64]u8 = []
  window := sdl3.window_create("Dyn GPU", backing[..], 320, 200, sdl3.WindowResizable)
  if !window.ok { #panic("SDL3 GPU unavailable") }
  defer { sdl3.window_destroy_owned(window.value) }
  formats := sdl3.ShaderSpirv | sdl3.ShaderDxil | sdl3.ShaderMsl | sdl3.ShaderMetallib
  device := sdl3.gpu_create_default_owned(formats, false)
  if !device.ok { #panic("SDL3 GPU unavailable") }
  defer { sdl3.gpu_destroy_owned(device.value) }
  if !sdl3.gpu_claim_window(device.value, window.value) { #panic("SDL3 GPU unavailable") }
  defer { sdl3.gpu_release_window(device.value, window.value) }
  color := sdl3.FColor{ red: 0.08, green: 0.20, blue: 0.38, alpha: 1.0 }
  event := sdl3.Event{}
  running := true
  frames: u32 = 0
  for running {
    for sdl3.poll_event(&event) {
      if sdl3.event_requests_close(&event) { running = false }
    }
    if !running { break }
    // A submitted buffer is consumed. Acquire a fresh buffer for each frame.
    commands := sdl3.gpu_commands(device.value)
    if !sdl3.gpu_clear_swapchain(commands, window.value, color) {
      error := sdl3.last_error(4096)
      if error.ok { _ = io.println(output, error.value) }
      #panic("SDL3 GPU frame failed")
    }
    frames += 1
    if smoke && frames == 3 { break }
  }
  _ = io.println(output, "SDL3 GPU loop finished")
}
