use "std/fs" fs
use "std/io" io
use "std/mem" mem
use "std/os/linux" linux
use "std/path" path
use "std/strings" strings
use "std/terminal" terminal

fn walk(arena: *mem.Arena, output: io.Writer, directory: []const u8, needle: []const u8) {
  mark := mem.arena_mark(arena)
  directory_storage: [4096]u8 = []
  opened := fs.open_directory(directory, directory_storage[..])
  if !opened.ok { return }
  for {
    entry := fs.directory_next(&opened.directory)
    if !entry.ok { break }
    child_storage: [4096]u8 = []
    joined := path.join(child_storage[..], directory, entry.name)
    if !joined.ok { continue }
    child := joined.value
    if entry.kind == 4 { walk(arena, output, child, needle) }
    else if entry.kind == 8 {
      file_mark := mem.arena_mark(arena)
      loaded := fs.read_all(arena, child, 64 * 1024 * 1024)
      if loaded.ok && strings.contains(loaded.data, needle) {
        printable: []const u8 = child
        _ = io.println(output, "{}", printable)
      }
      mem.arena_rewind(arena, file_mark)
    }
  }
  _ = fs.close_directory(&opened.directory)
  mem.arena_rewind(arena, mark)
}

fn main() {
  mapping := mem.arena_create(64 * 1024 * 1024)
  if !mapping.ok { #panic("arena mapping failed") }
  defer { _ = mem.arena_release(&mapping.arena) }
  arena := &mapping.arena
  arguments := linux.process_arguments(arena)
  if #len(arguments) != 3 {
    _ = io.print(terminal.stderr(), "usage: recursive-search DIRECTORY TEXT\n")
    return
  }
  walk(arena, terminal.stdout(), arguments[1], arguments[2])
}
